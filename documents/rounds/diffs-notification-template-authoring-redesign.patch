diff --git a/src/Settings/SchoolCollab.Settings.Application/Components/Pages/NotificationTemplates/TemplateLandingFilter.cs b/src/Settings/SchoolCollab.Settings.Application/Components/Pages/NotificationTemplates/TemplateLandingFilter.cs
new file mode 100644
