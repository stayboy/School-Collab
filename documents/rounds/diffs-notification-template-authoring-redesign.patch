+@using Microsoft.FluentUI.AspNetCore.Components
+@using SchoolCollab.Admin.Shared.Components
+@using SchoolCollab.Admin.Shared.Components.Dialogs
+@inherits DialogShellBase<ConstraintEditModel, ConstraintEditResult>
+@*
+   Add-constraint dialog (redesign spec §3.6). The editor''s Constraints kebab opens it PRESET to one
+   dimension — the dialog never asks which dimension, exactly as the Targets &amp; Audience dialog hides its
+   category selector when the page''s kebab already chose one. Several values of that dimension can be
+   picked in one visit; each becomes its own constraint row when the editor merges the result. Nothing is
+   persisted here: the picks ride the editor''s draft until Save.
+*@
+<DialogShellBody>
+    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
+        <DataAnnotationsValidator />
+
+        <p class="constraint-edit__subject">@Model.TemplateLabel</p>
+
+        <p class="constraint-edit__dimension" id="constraint-edit-dimension">
+            @TemplateConstraintLookups.DimensionLabel(Model.Dimension)
+        </p>
+
+        <div class="picked-targets">
+            <span class="picked-targets__caption">Picked values</span>
+            @if (Model.Picked.Count == 0)
+            {
+                <span class="picked-targets__hint" id="constraint-edit-empty">No values picked yet.</span>
+            }
+            else
+            {
+                <div class="entity-grid-chips" id="constraint-edit-chips">
+                    @foreach (var pick in Model.Picked)
+                    {
+                        <Chip Label="@pick.Text"
+                              DismissTitle="Remove this value"
+                              OnDismiss="@(() => OnDismissPick(pick))" />
+                    }
+                </div>
+            }
+        </div>
+
+        <FormRow Label="Value" Required For="constraint-edit-value">
+            <DropdownComponent TItem="ConstraintOption" TValue="string"
+                               Items="@_available"
+                               SelectedValue="@_selectedValue"
+                               SelectedValueChanged="OnValuePicked"
+                               OptionText="@(o => o.Text)"
+                               OptionValue="@(o => o.Value)"
+                               Placeholder="@(_available.Length == 0 ? "Every value is already used" : "Pick a value")"
+                               Disabled="@(_available.Length == 0)"
+                               Width="FieldWidth.W9" />
+        </FormRow>
+
+        @if (_available.Length == 0 && Model.Picked.Count == 0)
+        {
+            <FluentMessageBar Intent="MessageBarIntent.Info" class="mt-2">
+                Every value of this dimension is already on the template.
+            </FluentMessageBar>
+        }
+
+        <DialogShellFooter SubmitText="Add" SavingText="Adding…" />
+    </EditForm>
+</DialogShellBody>
+
+@code {
+    private string? _selectedValue;
+    private ConstraintOption[] _available = [];
+
+    protected override void OnModelInitialized(ConstraintEditModel model) => _available = model.Available;
+
+    /// <summary>Appends the pick, then clears the control so the next pick is a fresh choice.</summary>
+    private void OnValuePicked(string? value)
+    {
+        _selectedValue = null;
+        if (value is null)
+            return;
+
+        var option = Model.Options.FirstOrDefault(o => string.Equals(o.Value, value, StringComparison.Ordinal));
+        if (option is null)
+            return;
+
+        Model.Append(option);
+        _available = Model.Available;
+    }
+
+    private void OnDismissPick(ConstraintOption option)
+    {
+        Model.Remove(option);
+        _available = Model.Available;
+    }
+
+    protected override Task<ConstraintEditResult?> SubmitAsync(ConstraintEditModel model)
+    {
+        if (model.Picked.Count == 0)
+        {
+            Error = "Pick at least one value.";
+            return Task.FromResult<ConstraintEditResult?>(null);
+        }
+
+        return Task.FromResult<ConstraintEditResult?>(
+            new ConstraintEditResult(model.Picked.Select(p => p.Value).ToList()));
+    }
+}
