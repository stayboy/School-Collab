+using FluentAssertions;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Commands.RemoveSubjectBlock;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments.Queries.ListActivityGroupTopicAssignments;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments.Queries.ListGradeTopicAssignments;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments.Queries.ListGradeTopicCurriculumByGrade;
+using SchoolCollab.Students.Core.Data.Repositories;
+using SchoolCollab.Students.Core.Domain;
+
+namespace SchoolCollab.Students.Tests.Unit;
+
+/// <summary>
+/// AC-8: the HybridCache keys of the three cached availability readers must carry
+/// the <b>active period</b>, not only the effective date. Availability is now
+/// period-scoped ("no block on the active period"), so a date-only key would serve
+/// one period's array after a period switch inside the same date window.
+///
+/// <para>Mutation note (M2 → AC-8): removing the <c>:period:{...}</c> segment from
+/// any of the three keys must fail these tests.</para>
+/// </summary>
+[TestClass]
+public class ListGradeTopicAssignmentsCacheKeyTests
+{
+    private static DateOnly Today() => DateOnly.FromDateTime(DateTime.UtcNow);
+
+    private static DateOnly D(int y, int m, int d) => new(y, m, d);
+
+    private static Guid CurrentTenantId(StudentsTestScope s) => s.Tenants.GetTenantContext().TenantId;
+
+    private static Period SeedPeriod(
+        StudentsTestScope s, string name, DateOnly start, DateOnly end,
+        AcademicYearDivision division, Guid? parent = null)
+    {
+        var period = Period.Create(name, start, end, division, parent);
+        ((ITenantEntity)period).TenantId = CurrentTenantId(s);
+        s.Db.Periods.Add(period);
+        return period;
+    }
+
+    private static SubjectEnrollmentBlock SeedGradeBlock(
+        StudentsTestScope s, Guid gradeId, Guid topicId, Guid periodId)
+    {
+        var block = SubjectEnrollmentBlock.Create(CurrentTenantId(s), gradeId, null, topicId, periodId);
+        s.Db.SubjectEnrollmentBlocks.Add(block);
+        return block;
+    }
+
+    /// <summary>Grade + topic + a period-less bridge row (the post-round normal state).</summary>
+    private static async Task<(Guid gradeId, Guid topicId)> SeedAvailableGradeTopicAsync(StudentsTestScope s)
+    {
+        var gradeLevel = GradeLevel.Create(Guid.NewGuid(), 1, "Grade 1", 1);
+        s.Db.GradeLevels.Add(gradeLevel);
+        var topic = Topic.Create(Guid.NewGuid(), "MATH", "Mathematics", 1);
+        s.Db.Topics.Add(topic);
+        s.Db.GradeTopicAssignments.Add(GradeTopicAssignment.Create(gradeLevel.Id, topic.Id, Today()));
+        await s.Db.SaveChangesAsync();
+        return (gradeLevel.Id, topic.Id);
+    }
+
+    [TestMethod]
+    public async Task GradeReader_SameEffectiveDate_DifferentActivePeriod_DoesNotServeTheStaleArray()
+    {
+        using var s = new StudentsTestScope("cachekey-grade-period");
+        var (gradeId, topicId) = await SeedAvailableGradeTopicAsync(s);
+        var year2026 = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        var year2027 = SeedPeriod(s, "AY2027", D(2027, 9, 1), D(2028, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year2026) };
+        var handler = new ListGradeTopicAssignmentsHandler(s.Db, s.Cache, periods);
+
+        (await handler.HandleAsync(new ListGradeTopicAssignments(gradeId, Today())))
+            .Select(a => a.TopicId).Should().Contain(topicId);
+
+        // Same effective date, DIFFERENT active period, and the topic is blocked in
+        // it. Only a key that carries the active period can recompute here.
+        periods.ActiveYear = StubActivePeriodProvider.For(year2027);
+        SeedGradeBlock(s, gradeId, topicId, year2027.Id);
+        await s.Db.SaveChangesAsync();
+
+        var after = await handler.HandleAsync(new ListGradeTopicAssignments(gradeId, Today()));
+
+        after.Should().BeEmpty(
+            "M2: a date-only HybridCache key would have served the AY2026 array (AC-8)");
+    }
+
+    [TestMethod]
+    public async Task GradeReader_DifferentActiveSubPeriod_IsAlsoPartOfTheKey()
+    {
+        using var s = new StudentsTestScope("cachekey-grade-subperiod");
+        var (gradeId, topicId) = await SeedAvailableGradeTopicAsync(s);
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term1 = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        var term2 = SeedPeriod(s, "T2", D(2027, 1, 1), D(2027, 4, 30), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+
+        var periods = new StubActivePeriodProvider
+        {
+            ActiveYear = StubActivePeriodProvider.For(year),
+            ActiveSubPeriod = StubActivePeriodProvider.For(term1),
+        };
+        var handler = new ListGradeTopicAssignmentsHandler(s.Db, s.Cache, periods);
+
+        (await handler.HandleAsync(new ListGradeTopicAssignments(gradeId, Today())))
+            .Select(a => a.TopicId).Should().Contain(topicId);
+
+        periods.ActiveSubPeriod = StubActivePeriodProvider.For(term2);
+        SeedGradeBlock(s, gradeId, topicId, term2.Id);
+        await s.Db.SaveChangesAsync();
+
+        (await handler.HandleAsync(new ListGradeTopicAssignments(gradeId, Today()))).Should().BeEmpty(
+            "the active Term/Semester is part of the key too — a term block must take effect immediately");
+    }
+
+    [TestMethod]
+    public async Task GroupReader_SameEffectiveDate_DifferentActivePeriod_DoesNotServeTheStaleArray()
+    {
+        using var s = new StudentsTestScope("cachekey-group-period");
+        var group = ActivityGroup.Create("Term Club", span: EnrollmentSpan.Termly);
+        s.Db.ActivityGroups.Add(group);
+        var topic = Topic.Create(Guid.NewGuid(), "ART", "Art", 1);
+        s.Db.Topics.Add(topic);
+        s.Db.ActivityGroupTopicAssignments.Add(ActivityGroupTopicAssignment.Create(group.Id, topic.Id, Today()));
+        var year2026 = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        var year2027 = SeedPeriod(s, "AY2027", D(2027, 9, 1), D(2028, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year2026) };
+        var handler = new ListActivityGroupTopicAssignmentsHandler(s.Db, s.Cache, periods);
+
+        (await handler.HandleAsync(new ListActivityGroupTopicAssignments(group.Id, Today())))
+            .Select(a => a.TopicId).Should().Contain(topic.Id);
+
+        periods.ActiveYear = StubActivePeriodProvider.For(year2027);
+        s.Db.SubjectEnrollmentBlocks.Add(
+            SubjectEnrollmentBlock.Create(CurrentTenantId(s), null, group.Id, topic.Id, year2027.Id));
+        await s.Db.SaveChangesAsync();
+
+        (await handler.HandleAsync(new ListActivityGroupTopicAssignments(group.Id, Today()))).Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task CurriculumReader_SameEffectiveDate_DifferentActivePeriod_DoesNotServeTheStaleArray()
+    {
+        using var s = new StudentsTestScope("cachekey-curriculum-period");
+        var (gradeId, topicId) = await SeedAvailableGradeTopicAsync(s);
+        var year2026 = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        var year2027 = SeedPeriod(s, "AY2027", D(2027, 9, 1), D(2028, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year2026) };
+        var handler = new ListGradeTopicCurriculumByGradeHandler(s.Db, s.Cache, periods);
+
+        (await handler.HandleAsync(new ListGradeTopicCurriculumByGrade(gradeId, Today())))
+            .Select(x => x.TopicId).Should().Contain(topicId);
+
+        periods.ActiveYear = StubActivePeriodProvider.For(year2027);
+        SeedGradeBlock(s, gradeId, topicId, year2027.Id);
+        await s.Db.SaveChangesAsync();
+
+        (await handler.HandleAsync(new ListGradeTopicCurriculumByGrade(gradeId, Today()))).Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task RemovingABlock_Recomputes_TheInvalidationPathStillWorks()
+    {
+        // Sanity guard for the other side of the key change: the write paths evict
+        // the "students" tag, so a block removal must not leave a stale exclusion.
+        using var s = new StudentsTestScope("cachekey-unblock");
+        var (gradeId, topicId) = await SeedAvailableGradeTopicAsync(s);
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year) };
+        var handler = new ListGradeTopicAssignmentsHandler(s.Db, s.Cache, periods);
+        var block = SeedGradeBlock(s, gradeId, topicId, year.Id);
+        await s.Db.SaveChangesAsync();
+
+        (await handler.HandleAsync(new ListGradeTopicAssignments(gradeId, Today()))).Should().BeEmpty();
+
+        await new RemoveSubjectBlockHandler(
+                new SubjectEnrollmentBlockRepository(s.Db), s.Cache, NullLogger<RemoveSubjectBlockHandler>.Instance)
+            .HandleAsync(new RemoveSubjectBlock(block.Id));
+
+        (await handler.HandleAsync(new ListGradeTopicAssignments(gradeId, Today())))
+            .Select(a => a.TopicId).Should().Contain(topicId);
+    }
+}
