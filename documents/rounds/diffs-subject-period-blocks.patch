+using System.Net;
+using System.Net.Http;
+using System.Text;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using Bunit;
+using FluentAssertions;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.FluentUI.AspNetCore.Components;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Admin.Shared.Services;
+using SchoolCollab.Students.Application.Components.Students;
+using SchoolCollab.Students.Application.Services;
+
+namespace SchoolCollab.Admin.Tests.Unit;
+
+/// <summary>
+/// bUnit tests for <see cref="SubjectBlocksDialog"/> — the subject's enrollment
+/// exceptions (the periods it is NOT offered in) for one grade
+/// (subject-period-exception-model.md §5).
+///
+/// <para>Moved here from <c>TopicEditDialogTests</c> when the exceptions editor
+/// left the grade-detail surfaces for the Subjects landing. Rendered directly
+/// with its Content DialogParameters (no FluentDialog host), the same shape as
+/// <c>TopicDialogsBunitTests</c> — the dialog reads its inputs from the
+/// <c>DialogParameters</c> indexer, not from separate [Parameter]s.</para>
+///
+/// <para>Coverage: the empty state is normal, the picker excludes retired and
+/// already-blocked periods, an archived-period block renders WITH a working
+/// delete, add-with-no-selection posts nothing, a server 409 shows the server's
+/// own message, the header names the subject and grade, and the footer offers no
+/// submit control (add/remove write immediately).</para>
+/// </summary>
+[TestClass]
+public class SubjectBlocksDialogTests : BunitContext
+{
+    public SubjectBlocksDialogTests()
+    {
+        JSInterop.Mode = JSRuntimeMode.Loose;
+        Services.AddFluentUIComponents();
+    }
+
+    private sealed class ScriptedHandler : HttpMessageHandler
+    {
+        public readonly List<(string Method, string Url, string? Body)> Calls = new();
+        private readonly Dictionary<(string Method, string Url), (HttpStatusCode Status, string Body)> _responses = new();
+        private readonly Dictionary<(string Method, string Url), (HttpStatusCode Status, Func<string> Body)> _dynamic = new();
+
+        public ScriptedHandler Map(string method, string url, HttpStatusCode status, string body)
+        {
+            _responses[(method.ToUpperInvariant(), url)] = (status, body);
+            return this;
+        }
+
+        /// <summary>
+        /// A response whose body is produced when the request arrives — used where a
+        /// test must model a server-side mutation (e.g. the block list changes after a
+        /// DELETE, so the dialog's re-read returns the new list).
+        /// </summary>
+        public ScriptedHandler MapDynamic(string method, string url, HttpStatusCode status, Func<string> body)
+        {
+            _dynamic[(method.ToUpperInvariant(), url)] = (status, body);
+            return this;
+        }
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            var body = request.Content is null ? null : await request.Content.ReadAsStringAsync(cancellationToken);
+            Calls.Add((request.Method.Method, request.RequestUri!.PathAndQuery, body));
+
+            var url = request.RequestUri.PathAndQuery;
+            if (_dynamic.TryGetValue((request.Method.Method.ToUpperInvariant(), url), out var dynamicResponse))
+                return new HttpResponseMessage(dynamicResponse.Status) { Content = new StringContent(dynamicResponse.Body(), Encoding.UTF8, "application/json") };
+
+            if (_responses.TryGetValue((request.Method.Method.ToUpperInvariant(), url), out var exact))
+                return new HttpResponseMessage(exact.Status) { Content = new StringContent(exact.Body, Encoding.UTF8, "application/json") };
+
+            return new HttpResponseMessage(HttpStatusCode.NotFound) { Content = new StringContent($"Unexpected {url}", Encoding.UTF8, "application/json") };
+        }
+    }
+
+    private void Register(ScriptedHandler handler)
+    {
+        var http = new HttpClient(handler) { BaseAddress = new Uri("https://localhost:1234") };
+        var cv = new CodedValuesApiClient(http);
+        Services.AddSingleton(cv);
+        Services.AddSingleton(new StudentsApiClient(http, NullLogger<StudentsApiClient>.Instance, cv));
+    }
+
+    private static readonly Guid GradeId = Guid.Parse("4a000000-0000-0000-0000-000000000001");
+    private static readonly Guid ActiveYearId = Guid.Parse("4a000000-0000-0000-0000-000000000003");
+    private static readonly Guid Term1Id = Guid.Parse("4a000000-0000-0000-0000-000000000004");
+    private static readonly Guid Term2Id = Guid.Parse("4a000000-0000-0000-0000-000000000005");
+    private static readonly Guid RetiredYearId = Guid.Parse("4a000000-0000-0000-0000-000000000006");
+
+    private static string BlocksUrl(Guid topicId) =>
+        $"/students/subject-blocks?gradeLevelId={GradeId:D}&topicId={topicId:D}";
+
+    private static Dictionary<string, object?> BlockJson(
+        Guid id, Guid topicId, Guid periodId, string periodName, string periodStatus) => new()
+    {
+        ["id"] = id,
+        ["gradeLevelId"] = GradeId,
+        ["activityGroupId"] = (Guid?)null,
+        ["topicId"] = topicId,
+        ["periodId"] = periodId,
+        ["periodName"] = periodName,
+        ["periodStatus"] = periodStatus,
+        ["reason"] = (string?)null,
+        ["createdAt"] = DateTimeOffset.UnixEpoch,
+        ["updatedAt"] = DateTimeOffset.UnixEpoch,
+    };
+
+    private static Dictionary<string, object?> PeriodJson(
+        Guid id, string name, Guid? parentPeriodId, string status) => new()
+    {
+        ["id"] = id,
+        ["name"] = name,
+        ["startDate"] = "2026-01-01",
+        ["endDate"] = "2026-12-31",
+        ["status"] = status,
+        ["parentPeriodId"] = parentPeriodId,
+        ["nextPeriodId"] = (Guid?)null,
+        ["division"] = parentPeriodId is null ? "None" : "Terms",
+        ["activationToleranceDays"] = (int?)null,
+        ["createdAt"] = DateTimeOffset.UnixEpoch,
+        ["updatedAt"] = DateTimeOffset.UnixEpoch,
+    };
+
+    /// <summary>The tenant's periods: one active year + two terms, one ARCHIVED year.</summary>
+    private static string PeriodsJson() => JsonSerializer.Serialize(new[]
+    {
+        PeriodJson(ActiveYearId, "2026 Academic Year", null, "Active"),
+        PeriodJson(Term1Id, "Term 1", ActiveYearId, "Active"),
+        PeriodJson(Term2Id, "Term 2", ActiveYearId, "Active"),
+        PeriodJson(RetiredYearId, "2019 Academic Year", null, "Archived"),
+    });
+
+    /// <summary>Maps the endpoints the dialog needs on open.
+    /// <paramref name="blocksJson"/> is skipped when a test supplies the block list
+    /// dynamically (e.g. one that changes after a delete).</summary>
+    private ScriptedHandler RegisterDialog(ScriptedHandler handler, Guid topicId, string? blocksJson)
+    {
+        handler.Map("GET", "/students/periods", HttpStatusCode.OK, PeriodsJson());
+        handler.Map("GET", "/students/periods/active-academic-year", HttpStatusCode.OK,
+            JsonSerializer.Serialize(PeriodJson(ActiveYearId, "2026 Academic Year", null, "Active")));
+        if (blocksJson is not null)
+            handler.Map("GET", BlocksUrl(topicId), HttpStatusCode.OK, blocksJson);
+        Register(handler);
+        return handler;
+    }
+
+    private IRenderedComponent<SubjectBlocksDialog> RenderDialog(Guid topicId) =>
+        Render<SubjectBlocksDialog>(p => p.Add(x => x.Content, new DialogParameters
+        {
+            [SubjectBlocksDialog.TopicIdKey] = topicId,
+            [SubjectBlocksDialog.SubjectNameKey] = "Mathematics",
+            [SubjectBlocksDialog.GradeLevelIdKey] = GradeId,
+            [SubjectBlocksDialog.GradeNameKey] = "Grade 5",
+        }));
+
+    private static string[] BlockablePeriodIds(IRenderedComponent<SubjectBlocksDialog> cut) =>
+        cut.FindComponent<FluentSelect<PeriodDto>>().Instance.Items!
+            .Select(p => p.Id.ToString())
+            .ToArray();
+
+    /// <summary>
+    /// FR-ED-14 inverted: with no blocks the dialog shows a plain empty state —
+    /// having zero exceptions is the NORMAL state, not a gap to warn about, and
+    /// there is nothing to delete.
+    /// </summary>
+    [TestMethod]
+    public void EmptyList_IsTheNormalState_WithNoDeleteControls()
+    {
+        var topicId = Guid.NewGuid();
+        var handler = RegisterDialog(new ScriptedHandler(), topicId, "[]");
+        var cut = RenderDialog(topicId);
+
+        cut.WaitForAssertion(() => cut.Markup.Should()
+            .Contain("No exceptions — this subject is offered in every period."));
+        cut.FindAll("fluent-button[aria-label^='Remove exception']").Should().BeEmpty(
+            "an empty exception list has no rows to delete");
+        handler.Calls.Should().Contain(c => c.Method == "GET" && c.Url == BlocksUrl(topicId),
+            "the dialog reads the blocks for its grade+topic");
+    }
+
+    /// <summary>
+    /// The picker offers only periods the subject CAN be blocked in: the active
+    /// academic year and its Term/Semester sub-periods (FR-57), never an archived
+    /// one, and never a period the subject is already blocked in (FR-ED-13 — a
+    /// duplicate cannot be selected at all).
+    /// </summary>
+    [TestMethod]
+    public void Picker_ExcludesRetiredAndAlreadyBlockedPeriods()
+    {
+        var topicId = Guid.NewGuid();
+        var blocksJson = JsonSerializer.Serialize(new[]
+        {
+            BlockJson(Guid.NewGuid(), topicId, Term1Id, "Term 1", "Active"),
+        });
+        RegisterDialog(new ScriptedHandler(), topicId, blocksJson);
+        var cut = RenderDialog(topicId);
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("Term 1"));
+
+        // FluentSelect does not materialise its option children while closed, so
+        // assert the bound Items — what the user actually picks from.
+        var items = BlockablePeriodIds(cut);
+        items.Should().Contain(ActiveYearId.ToString(), "the whole academic year may be blocked");
+        items.Should().Contain(Term2Id.ToString(), "a term of the active year may be blocked");
+        items.Should().NotContain(RetiredYearId.ToString(),
+            "an archived period is no longer live and must not be blockable");
+        items.Should().NotContain(Term1Id.ToString(),
+            "the subject is already blocked in Term 1 — a duplicate must be impossible to pick");
+    }
+
+    /// <summary>
+    /// FR-ED-13: with no period selected the add affordance is disabled and posts
+    /// nothing — a duplicate/codeless click can never create a second block.
+    /// </summary>
+    [TestMethod]
+    public void AddWithNoPeriodSelected_PostsNothing()
+    {
+        var topicId = Guid.NewGuid();
+        var handler = RegisterDialog(new ScriptedHandler(), topicId, "[]");
+        var cut = RenderDialog(topicId);
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("No exceptions"));
+
+        var blockButton = cut.FindAll("fluent-button")
+            .Single(b => b.TextContent.Contains("Block period"));
+        blockButton.Click();
+
+        handler.Calls.Should().NotContain(c => c.Method == "POST" && c.Url.Contains("/students/subject-blocks"),
+            "the add affordance is disabled until a period is picked");
+    }
+
+    /// <summary>
+    /// AC-2 / mutation M3: a block whose period has since been ARCHIVED still
+    /// renders (read-only, with the retired-period marker) and its delete control
+    /// still works — otherwise the tenant accumulates uncleanable blocks and the
+    /// section becomes a dead end.
+    /// </summary>
+    [TestMethod]
+    public void BlockOnArchivedPeriod_RendersMarker_AndStaysDeletable()
+    {
+        var topicId = Guid.NewGuid();
+        var blockId = Guid.NewGuid();
+        var live = new List<Dictionary<string, object?>>
+        {
+            BlockJson(blockId, topicId, RetiredYearId, "2019 Academic Year", "Archived"),
+        };
+
+        var handler = RegisterDialog(new ScriptedHandler(), topicId, null);
+        // The block list and the delete are stateful: removing the block changes the
+        // next read, which is what proves the delete went through.
+        handler.MapDynamic("GET", BlocksUrl(topicId), HttpStatusCode.OK,
+            () => JsonSerializer.Serialize(live.ToArray()));
+        handler.MapDynamic("DELETE", $"/students/subject-blocks/{blockId}", HttpStatusCode.NoContent,
+            () => { live.Clear(); return ""; });
+
+        var cut = RenderDialog(topicId);
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("2019 Academic Year"));
+        cut.Markup.Should().Contain("Archived", "a block on a retired period is marked");
+
+        var removeButton = cut.Find("fluent-button[aria-label='Remove exception for 2019 Academic Year']");
+        removeButton.GetAttribute("disabled").Should().BeNull(
+            "an archived-period block must stay deletable");
+        removeButton.Click();
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("No exceptions"));
+        handler.Calls.Should().Contain(c => c.Method == "DELETE" && c.Url == $"/students/subject-blocks/{blockId}",
+            "deleting an archived-period block must reach the API");
+    }
+
+    /// <summary>
+    /// Blocking a period the subject is NOT yet blocked in sends the owner, the
+    /// topic and the period, and the list re-reads the server's answer.
+    /// </summary>
+    [TestMethod]
+    public async Task BlockPeriod_PostsTheBlock_AndReloadsTheList()
+    {
+        var topicId = Guid.NewGuid();
+        var newBlockId = Guid.NewGuid();
+        var live = new List<Dictionary<string, object?>>();
+
+        var handler = RegisterDialog(new ScriptedHandler(), topicId, null);
+        handler.MapDynamic("GET", BlocksUrl(topicId), HttpStatusCode.OK,
+            () => JsonSerializer.Serialize(live.ToArray()));
+        handler.MapDynamic("POST", "/students/subject-blocks", HttpStatusCode.Created, () =>
+        {
+            live.Add(BlockJson(newBlockId, topicId, Term2Id, "Term 2", "Active"));
+            return $"{{\"id\":\"{newBlockId}\"}}";
+        });
+
+        var cut = RenderDialog(topicId);
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("No exceptions"));
+
+        // Pick Term 2 by driving the bound callback (FluentUI web components do not
+        // materialise their options while closed, so a click on an option is not an
+        // option here).
+        var select = cut.FindComponent<FluentSelect<PeriodDto>>();
+        var term2 = select.Instance.Items!.Single(p => p.Id == Term2Id);
+        await cut.InvokeAsync(() => select.Instance.SelectedOptionChanged.InvokeAsync(term2));
+
+        cut.FindAll("fluent-button").Single(b => b.TextContent.Contains("Block period")).Click();
+
+        cut.WaitForAssertion(() =>
+            handler.Calls.Should().Contain(c => c.Method == "POST" && c.Url == "/students/subject-blocks"));
+        var post = handler.Calls.Single(c => c.Method == "POST" && c.Url == "/students/subject-blocks");
+        post.Body.Should().Contain($"\"gradeLevelId\":\"{GradeId:D}\"");
+        post.Body.Should().Contain($"\"topicId\":\"{topicId:D}\"");
+        post.Body.Should().Contain($"\"periodId\":\"{Term2Id:D}\"");
+        post.Body.Should().Contain("\"activityGroupId\":null", "a grade-owned block names no group");
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("Term 2",
+            "the list re-reads the server after the block is created"));
+    }
+
+    /// <summary>
+    /// The server's own 409 message must surface in the dialog instead of being
+    /// swallowed — the picker filter is a courtesy, the server is the gate.
+    /// </summary>
+    [TestMethod]
+    public async Task DuplicateRejectedByTheServer_ShowsTheServerMessage()
+    {
+        var topicId = Guid.NewGuid();
+        var handler = RegisterDialog(new ScriptedHandler(), topicId, "[]");
+        handler.Map("POST", "/students/subject-blocks", HttpStatusCode.Conflict,
+            "{\"message\":\"This subject is already blocked in that period.\"}");
+
+        var cut = RenderDialog(topicId);
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("No exceptions"));
+
+        var select = cut.FindComponent<FluentSelect<PeriodDto>>();
+        var term2 = select.Instance.Items!.Single(p => p.Id == Term2Id);
+        await cut.InvokeAsync(() => select.Instance.SelectedOptionChanged.InvokeAsync(term2));
+        cut.FindAll("fluent-button").Single(b => b.TextContent.Contains("Block period")).Click();
+
+        cut.WaitForAssertion(() => cut.Markup.Should()
+            .Contain("This subject is already blocked in that period."));
+    }
+
+    /// <summary>
+    /// The dialog is opened from a landing that lists many subjects, so its
+    /// read-only header names the subject AND the owning grade — and every block
+    /// read is scoped to that grade, never to a grade-less or foreign scope.
+    /// </summary>
+    [TestMethod]
+    public void Header_IdentifiesSubjectAndOwner_AndReadsOnlyThatGrade()
+    {
+        var topicId = Guid.NewGuid();
+        var handler = RegisterDialog(new ScriptedHandler(), topicId, "[]");
+        var cut = RenderDialog(topicId);
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("Mathematics — Grade 5",
+            "the dialog must not be context-free"));
+
+        cut.WaitForAssertion(() => handler.Calls.Should().Contain(c => c.Url == BlocksUrl(topicId)));
+        handler.Calls
+            .Where(c => c.Url.Contains("subject-blocks", StringComparison.Ordinal))
+            .Should().OnlyContain(c => c.Url.Contains($"gradeLevelId={GradeId:D}", StringComparison.Ordinal),
+                "the dialog manages exactly the grade it was opened for");
+    }
+
+    /// <summary>
+    /// No-submit dialog: add/remove write through the API client the moment they
+    /// are invoked, so the body offers exactly one control — Close — and there is
+    /// no form whose submit could pretend to save anything.
+    /// </summary>
+    [TestMethod]
+    public void Footer_OffersOnlyClose_WithNoSubmitControl()
+    {
+        var topicId = Guid.NewGuid();
+        RegisterDialog(new ScriptedHandler(), topicId, "[]");
+        var cut = RenderDialog(topicId);
+
+        cut.WaitForAssertion(() => cut.Markup.Should().Contain("No exceptions"));
+
+        // The body legitimately holds other buttons (per-row delete, "Block period"), so
+        // the no-submit guarantee is about the FOOTER: the host sets PrimaryAction and
+        // SecondaryAction to null, so the body owns the single Close affordance and nothing else.
+        cut.FindAll(".dialog-footer fluent-button").Select(b => b.TextContent.Trim()).Should()
+            .BeEquivalentTo(new[] { "Close" },
+                "the footer has no Save/Submit action — there is nothing to submit");
+        cut.FindAll("form").Should().BeEmpty("the dialog is not a form dialog");
+        cut.Markup.Should().NotContain("Save");
+    }
+}
