+++ b/src/Students/SchoolCollab.Students.Core/CQRS/TopicAssignments/SubjectAvailability.cs
@@ -0,0 +1,90 @@
+using System.Linq.Expressions;
+using Microsoft.EntityFrameworkCore;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.Data;
+
+namespace SchoolCollab.Students.Core.CQRS.TopicAssignments;
+
+/// <summary>
+/// The single source of truth for subject availability
+/// (subject-period-exception-model.md §2 "Availability semantics"):
+/// <c>available(owner, topic) = EXISTS bridge AND NOT EXISTS block(owner, topic, activePeriod)</c>.
+///
+/// <para>Shared by the three cached availability readers so the block predicate and
+/// the cache-key segment cannot drift apart: a query that excludes blocks must be
+/// keyed by the same active period, or a period switch inside one date window would
+/// serve the previous period's array.</para>
+/// </summary>
+internal static class SubjectAvailability
+{
+    /// <summary>
+    /// The tenant's active period ids, as an exact-match set: the active academic
+    /// year first, then the active Term/Semester when one is open. Both are exact id
+    /// comparisons — never a date-range containment test — because a block always
+    /// names one concrete period. A block on the year therefore hides the subject
+    /// for the whole year, and a block on the term hides it for that term.
+    /// Empty when the tenant has no active period (availability then stays
+    /// period-blind, matching the pre-round behaviour).
+    /// </summary>
+    public static async Task<Guid[]> ResolveActivePeriodIdsAsync(
+        IActivePeriodProvider activePeriodProvider,
+        CancellationToken cancellationToken)
+    {
+        var activeYear = await activePeriodProvider.GetActivePeriodAsync(cancellationToken);
+        if (activeYear is null)
+            return [];
+
+        var activeSubPeriod = await activePeriodProvider.GetActiveSubPeriodAsync(cancellationToken);
+        return activeSubPeriod is null ? [activeYear.Id] : [activeYear.Id, activeSubPeriod.Id];
+    }
+
+    /// <summary>
+    /// Cache-key segment for <paramref name="activePeriodIds"/>. Stable and
+    /// order-preserving, so the same tenant state always produces the same key and
+    /// any period switch produces a different one.
+    /// </summary>
+    public static string CacheKeySegment(Guid[] activePeriodIds) =>
+        activePeriodIds.Length == 0 ? "none" : string.Join('+', activePeriodIds);
+
+    /// <summary>
+    /// Topic ids blocked for a grade in any of <paramref name="activePeriodIds"/>.
+    /// The tenant filter is applied explicitly because the active tenant context is
+    /// lost inside a HybridCache factory; the "SoftDelete" filter stays on, so an
+    /// un-blocked (soft-deleted) row no longer excludes anything.
+    /// </summary>
+    public static Task<Guid[]> BlockedTopicIdsForGradeAsync(
+        StudentsDbContext db,
+        Guid tenantId,
+        Guid gradeLevelId,
+        Guid[] activePeriodIds,
+        CancellationToken cancellationToken) =>
+        BlockedTopicIdsAsync(db, tenantId, activePeriodIds, b => b.GradeLevelId == gradeLevelId, cancellationToken);
+
+    /// <summary>Topic ids blocked for an activity group in any of <paramref name="activePeriodIds"/>.</summary>
+    public static Task<Guid[]> BlockedTopicIdsForGroupAsync(
+        StudentsDbContext db,
+        Guid tenantId,
+        Guid activityGroupId,
+        Guid[] activePeriodIds,
+        CancellationToken cancellationToken) =>
+        BlockedTopicIdsAsync(db, tenantId, activePeriodIds, b => b.ActivityGroupId == activityGroupId, cancellationToken);
+
+    private static async Task<Guid[]> BlockedTopicIdsAsync(
+        StudentsDbContext db,
+        Guid tenantId,
+        Guid[] activePeriodIds,
+        Expression<Func<Domain.SubjectEnrollmentBlock, bool>> ownerFilter,
+        CancellationToken cancellationToken)
+    {
+        if (activePeriodIds.Length == 0)
+            return [];
+
+        return await db.SubjectEnrollmentBlocks
+            .IgnoreQueryFilters(["Tenant"])
+            .Where(ownerFilter)
+            .Where(b => b.TenantId == tenantId && activePeriodIds.Contains(b.PeriodId))
+            .Select(b => b.TopicId)
+            .Distinct()
+            .ToArrayAsync(cancellationToken);
+    }
+}
