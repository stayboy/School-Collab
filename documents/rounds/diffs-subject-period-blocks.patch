@@ -0,0 +1,227 @@
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Json;
+using FluentAssertions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Caching.Hybrid;
+using Microsoft.Extensions.DependencyInjection;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.Data;
+using SchoolCollab.Students.Core.Domain;
+using SchoolCollab.Students.Core.DTOs;
+
+namespace SchoolCollab.Students.Tests.Integration;
+
+/// <summary>
+/// Real-Postgres coverage for the subject-period-exception model at the two seams
+/// the EF InMemory unit suite structurally cannot reach
+/// (subject-period-exception-model.md §2/§6, round AC-6 + AC-4):
+///
+/// <list type="number">
+///   <item><b>The FR-58 feed point (AC-6).</b>
+///         <c>GET /students/topic-assignments/by-grade/{id}</c> is the exact array
+///         <c>TopicAssignmentLookupHttpClient</c> reduces with
+///         <c>Any(d => d.TopicId == topicId)</c> for the Assignments publish gate, so a
+///         block on the active period must remove the topic from this response. No test
+///         that stubs <c>ITopicAssignmentLookup</c> can see that — only the endpoint can.</item>
+///   <item><b>The merged unique-index filter (AC-4).</b> Removing a block soft-deletes it,
+///         and re-adding the same (owner, topic, period) is only legal because
+///         <c>ix_subject_enrollment_blocks_tenant_grade_topic_period</c> is filtered with
+///         <c>grade_level_id IS NOT NULL AND is_deleted = false</c>. EF InMemory enforces
+///         neither unique indexes nor <c>HasFilter</c>, so Postgres is the only witness.</item>
+/// </list>
+/// </summary>
+[TestClass]
+[DoNotParallelize]
+public class SubjectBlockAvailabilityEndpointTests
+{
+    private static ApiFactory _factory = default!;
+    private static HttpClient _client = default!;
+
+    [ClassInitialize]
+    public static async Task ClassInitialize(TestContext _)
+    {
+        _factory = new ApiFactory();
+        await _factory.InitializeAsync();
+        _client = _factory.CreateClient();
+    }
+
+    [ClassCleanup]
+    public static async Task ClassCleanup()
+    {
+        _client?.Dispose();
+        if (_factory is not null)
+        {
+            await _factory.DisposeAsync();
+        }
+    }
+
+    [TestInitialize]
+    public async Task TestInitialize()
+    {
+        using var scope = _factory.Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<StudentsDbContext>();
+        var cache = scope.ServiceProvider.GetRequiredService<HybridCache>();
+
+        await db.Database.ExecuteSqlRawAsync(
+            "TRUNCATE TABLE subject_enrollment_blocks, topic_assignments, grade_levels, subjects, periods CASCADE;");
+
+        // ActivePeriodProvider resolves (and caches) the active academic year per
+        // tenant; clear it so each test sees the period it just seeded rather than
+        // the previous test's — the availability predicate keys off that id.
+        await cache.RemoveByTagAsync("students");
+    }
+
+    // ── AC-6 / FR-58: the by-grade feed the unchanged Assignments lookup consumes ──
+
+    [TestMethod]
+    public async Task ByGradeFeed_BlockOnActiveAcademicYear_ExcludesTopic()
+    {
+        // Arrange: a grade + topic + a PERIOD-LESS bridge row (the round's inverted
+        // default) + an Active academic year to block.
+        var tenantId = ApiFactory.TestTenantA;
+        var gradeLevelId = await SeedGradeLevelAsync(tenantId, "Grade 1");
+        var topicId = await SeedTopicAsync(tenantId, "MATH", "Mathematics");
+        await SeedPeriodLessBridgeRowAsync(tenantId, gradeLevelId, topicId);
+        var periodId = await SeedActiveAcademicYearAsync(tenantId, "Year 2026");
+
+        var effectiveDate = DateOnly.FromDateTime(DateTime.UtcNow);
+
+        // Control: with no block the topic MUST be in the array. This is today's
+        // (pre-round) behaviour, so it also proves the seed is live — a broken seed
+        // would make the "absent" assertion below vacuous.
+        var unblocked = await GetGradeTopicAssignmentsAsync(tenantId, gradeLevelId, effectiveDate);
+        unblocked.Should().ContainSingle(a => a.TopicId == topicId,
+            "the by-grade array is the exact feed the Assignments lookup port reduces with Any(d => d.TopicId == topicId)");
+
+        // Act: block the subject for that period through the real endpoint.
+        // (Pre-round this POST is a 404 — no block surface exists — which is the
+        // test's pre-round failure mode.)
+        var created = await PostAsync("/students/subject-blocks", tenantId,
+            new { gradeLevelId, topicId, periodId });
+        created.StatusCode.Should().Be(HttpStatusCode.Created,
+            "a grade-owned block on the active academic year is admissible (AC-3)");
+
+        // Assert: the block removes the topic from that array. FR-58's publish
+        // rejection is exactly this exclusion plus the unmodified lookup client —
+        // no Assignments-side change is required or permitted.
+        var blocked = await GetGradeTopicAssignmentsAsync(tenantId, gradeLevelId, effectiveDate);
+        blocked.Should().NotContain(a => a.TopicId == topicId,
+            "a block on the active period makes the subject unavailable; dropping the NOT EXISTS block(...) predicate from the availability readers must break this");
+    }
+
+    // ── the merged unique-index filter: re-adding after a soft delete is legal ──
+
+    [TestMethod]
+    public async Task RemovedBlock_CanBeReAdded_ForTheSameOwnerTopicPeriod()
+    {
+        // Arrange: grade + topic + Active academic year, then one live block.
+        var tenantId = ApiFactory.TestTenantA;
+        var gradeLevelId = await SeedGradeLevelAsync(tenantId, "Grade 1");
+        var topicId = await SeedTopicAsync(tenantId, "MATH", "Mathematics");
+        var periodId = await SeedActiveAcademicYearAsync(tenantId, "Year 2026");
+        var body = new { gradeLevelId, topicId, periodId };
+
+        var first = await PostAsync("/students/subject-blocks", tenantId, body);
+        first.StatusCode.Should().Be(HttpStatusCode.Created);
+        var firstId = (await first.Content.ReadFromJsonAsync<CreatedId>())!.Id;
+
+        var removed = await SendAsync(HttpMethod.Delete, $"/students/subject-blocks/{firstId}", tenantId);
+        removed.StatusCode.Should().Be(HttpStatusCode.NoContent,
+            "un-blocking soft-deletes the row so the audit trail survives");
+
+        // Act
+        var second = await PostAsync("/students/subject-blocks", tenantId, body);
+
+        // Assert: a fresh 201. Without the merged
+        // "grade_level_id IS NOT NULL AND is_deleted = false" HasFilter the soft-deleted
+        // row would still occupy ix_subject_enrollment_blocks_tenant_grade_topic_period
+        // and this INSERT would fail (a raw 23505, surfacing as a 500) — precisely the
+        // failure EF InMemory can never show.
+        second.StatusCode.Should().Be(HttpStatusCode.Created,
+            "the unique index excludes soft-deleted rows, so the same (owner, topic, period) block may be re-added after a removal");
+        var secondId = (await second.Content.ReadFromJsonAsync<CreatedId>())!.Id;
+        secondId.Should().NotBe(firstId, "the re-add must insert a new row, not resurrect the deleted one");
+    }
+
+    // ────── seed helpers (each runs under an explicit tenant) ──────
+
+    private async Task<T> InTenantAsync<T>(Guid tenantId, Func<StudentsDbContext, Task<T>> work)
+    {
+        using var scope = _factory.Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<StudentsDbContext>();
+        var accessor = scope.ServiceProvider.GetRequiredService<ITenantContextAccessor>();
+        return await accessor.RunWithExplicitTenantAsync(tenantId, _ => work(db));
+    }
+
+    private Task<Guid> SeedGradeLevelAsync(Guid tenantId, string name) =>
+        InTenantAsync(tenantId, async db =>
+        {
+            var gradeLevel = GradeLevel.Create(Guid.NewGuid(), 1, name, 1);
+            db.GradeLevels.Add(gradeLevel);
+            await db.SaveChangesAsync();
+            return gradeLevel.Id;
+        });
+
+    private Task<Guid> SeedTopicAsync(Guid tenantId, string code, string name) =>
+        InTenantAsync(tenantId, async db =>
+        {
+            var topic = Topic.Create(Guid.NewGuid(), code, name, 1);
+            db.Topics.Add(topic);
+            await db.SaveChangesAsync();
+            return topic.Id;
+        });
+
+    /// <summary>Bridge row with NO period — the period meaning left the bridge this round.</summary>
+    private Task SeedPeriodLessBridgeRowAsync(Guid tenantId, Guid gradeLevelId, Guid topicId) =>
+        InTenantAsync(tenantId, async db =>
+        {
+            db.GradeTopicAssignments.Add(
+                GradeTopicAssignment.Create(gradeLevelId, topicId, DateOnly.FromDateTime(DateTime.UtcNow)));
+            await db.SaveChangesAsync();
+            return true;
+        });
+
+    /// <summary>An Active, top-level (period-less parent) academic year — the tenant's
+    /// active period, so it lands in the availability predicate's id set.</summary>
+    private Task<Guid> SeedActiveAcademicYearAsync(Guid tenantId, string name) =>
+        InTenantAsync(tenantId, async db =>
+        {
+            var today = DateOnly.FromDateTime(DateTime.UtcNow);
+            var year = Period.Create(name, today.AddDays(-30), today.AddDays(30), AcademicYearDivision.None);
+            year.Activate();
+            db.Periods.Add(year);
+            await db.SaveChangesAsync();
+            return year.Id;
+        });
+
+    // ────── request helpers ──────
+
+    private async Task<TopicAssignmentDto[]> GetGradeTopicAssignmentsAsync(
+        Guid tenantId, Guid gradeLevelId, DateOnly effectiveDate)
+    {
+        var response = await SendAsync(HttpMethod.Get,
+            $"/students/topic-assignments/by-grade/{gradeLevelId}?effectiveDate={effectiveDate:yyyy-MM-dd}",
+            tenantId);
+        response.StatusCode.Should().Be(HttpStatusCode.OK);
+        return (await response.Content.ReadFromJsonAsync<TopicAssignmentDto[]>())!;
+    }
+
+    private Task<HttpResponseMessage> PostAsync(string path, Guid tenantId, object body) =>
+        SendAsync(HttpMethod.Post, path, tenantId, body);
+
+    private Task<HttpResponseMessage> SendAsync(
+        HttpMethod method, string path, Guid tenantId, object? body = null)
+    {
+        var request = new HttpRequestMessage(method, path);
+        request.Headers.Add("x-tenant-id", tenantId.ToString());
+        if (body is not null)
+        {
+            request.Content = JsonContent.Create(body);
+        }
+        return _client.SendAsync(request);
+    }
+
+    /// <summary>Shape of the <c>POST /students/subject-blocks</c> 201 body (<c>new { id }</c>).</summary>
+    private sealed record CreatedId(Guid Id);
+}
diff --git a/tests/SchoolCollab.Students.Tests.Unit/BlockSubjectHandlerTests.cs b/tests/SchoolCollab.Students.Tests.Unit/BlockSubjectHandlerTests.cs
new file mode 100644
index 00000000..abc5546e
--- /dev/null
+++ b/tests/SchoolCollab.Students.Tests.Unit/BlockSubjectHandlerTests.cs
@@ -0,0 +1,357 @@
+using FluentAssertions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Commands.BlockSubject;
+using SchoolCollab.Students.Core.Data.Repositories;
+using SchoolCollab.Students.Core.Domain;
+using SchoolCollab.Students.Core.Domain.Exceptions;
+
+namespace SchoolCollab.Students.Tests.Unit;
+
+/// <summary>
+/// <see cref="BlockSubjectHandler"/> — the block validator matrix
+/// (subject-period-exception-model.md §4.2/§6, AC-3/AC-4):
+/// retired periods are not blockable (Draft/Active/Completed are), the FR-57
+/// active-year rule applies to grade-owned blocks, the FR-56 span rule to
+/// group-owned ones, and a duplicate (owner, topic, period) is a 409.
+/// </summary>
+[TestClass]
+public class BlockSubjectHandlerTests
+{
+    private static DateOnly D(int y, int m, int d) => new(y, m, d);
+
+    private static readonly Guid TopicId = Guid.Parse("aaaaaaa2-2222-2222-2222-222222222222");
+
+    private static Guid CurrentTenantId(StudentsTestScope s) => s.Tenants.GetTenantContext().TenantId;
+
+    private static BlockSubjectHandler NewHandler(StudentsTestScope s) => new(
+        new SubjectEnrollmentBlockRepository(s.Db),
+        s.Periods,
+        s.GradeLevels,
+        s.ActivityGroups,
+        s.Tenants,
+        s.Cache,
+        NullLogger<BlockSubjectHandler>.Instance);
+
+    private static Period SeedPeriod(
+        StudentsTestScope s, string name, DateOnly start, DateOnly end,
+        AcademicYearDivision division, Guid? parent = null)
+    {
+        var period = Period.Create(name, start, end, division, parent);
+        ((ITenantEntity)period).TenantId = CurrentTenantId(s);
+        s.Db.Periods.Add(period);
+        return period;
+    }
+
+    /// <summary>Seeds the active academic year (AY2026, Terms), one Active Term inside
+    /// it, and a GradeLevel row — returning the grade's real id for FR-57 lookups.</summary>
+    private static async Task<(Period year, Period term, Guid gradeId)> SeedActiveYearAndTermAsync(StudentsTestScope s)
+    {
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        var gradeLevel = GradeLevel.Create(Guid.NewGuid(), 1, "Grade 1", 1);
+        s.Db.GradeLevels.Add(gradeLevel);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        term.Activate();
+        await s.Db.SaveChangesAsync();
+        return (year, term, gradeLevel.Id);
+    }
+
+    private static async Task<ActivityGroup> SeedGroupAsync(StudentsTestScope s, EnrollmentSpan span)
+    {
+        var group = ActivityGroup.Create(span + " Club", span: span);
+        s.Db.ActivityGroups.Add(group);
+        await s.Db.SaveChangesAsync();
+        return group;
+    }
+
+    // ── AC-3: submittable periods are blockable ───────────────────────────────
+
+    [TestMethod]
+    public async Task Block_GradeDraftTerm_IsAllowed()
+    {
+        using var s = new StudentsTestScope("blk-grade-draft");
+        var (year, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var draft = SeedPeriod(s, "T2", D(2027, 1, 1), D(2027, 4, 30), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+
+        var id = await NewHandler(s).HandleAsync(new BlockSubject(gradeId, null, TopicId, draft.Id, "teacher on leave"));
+
+        id.Should().NotBeEmpty("Draft is a submittable status (AC-3)");
+    }
+
+    [TestMethod]
+    public async Task Block_GradeActiveTerm_IsAllowed()
+    {
+        using var s = new StudentsTestScope("blk-grade-active");
+        var (_, term, gradeId) = await SeedActiveYearAndTermAsync(s);
+
+        var id = await NewHandler(s).HandleAsync(new BlockSubject(gradeId, null, TopicId, term.Id));
+
+        id.Should().NotBeEmpty();
+    }
+
+    [TestMethod]
+    public async Task Block_GradeCompletedTerm_IsAllowed()
+    {
+        using var s = new StudentsTestScope("blk-grade-completed");
+        var (year, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var done = SeedPeriod(s, "T0", D(2026, 5, 1), D(2026, 8, 31), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        done.Activate();
+        done.Complete();
+        await s.Db.SaveChangesAsync();
+
+        var id = await NewHandler(s).HandleAsync(new BlockSubject(gradeId, null, TopicId, done.Id));
+
+        id.Should().NotBeEmpty("a just-closed term can still have its block corrected");
+    }
+
+    [TestMethod]
+    public async Task Block_GradeArchivedPeriod_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-grade-archived");
+        var (_, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var archived = SeedPeriod(s, "AY2025", D(2025, 9, 1), D(2026, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        archived.Activate();
+        archived.Archive();
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(gradeId, null, TopicId, archived.Id));
+
+        (await act.Should().ThrowAsync<TopicAssignmentPeriodException>())
+            .And.Message.Should().Contain("Archived");
+    }
+
+    [TestMethod]
+    public async Task Block_GradeDeactivatedPeriod_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-grade-deactivated");
+        var (_, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var deactivated = SeedPeriod(s, "AY2025", D(2025, 9, 1), D(2026, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        deactivated.Activate();
+        deactivated.Deactivate();
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(gradeId, null, TopicId, deactivated.Id));
+
+        (await act.Should().ThrowAsync<TopicAssignmentPeriodException>())
+            .And.Message.Should().Contain("Deactivated");
+    }
+
+    // ── FR-57 for grade-owned blocks ──────────────────────────────────────────
+
+    [TestMethod]
+    public async Task Block_GradeTermOutsideActiveAcademicYear_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-grade-fr57");
+        var (_, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var otherYear = SeedPeriod(s, "AY2027", D(2027, 9, 1), D(2028, 8, 31), AcademicYearDivision.Terms);
+        var otherTerm = SeedPeriod(s, "T9", D(2027, 9, 1), D(2027, 12, 31), AcademicYearDivision.Terms, otherYear.Id);
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(gradeId, null, TopicId, otherTerm.Id));
+
+        (await act.Should().ThrowAsync<TopicAssignmentPeriodException>())
+            .And.Message.Should().Contain("active academic year");
+    }
+
+    [TestMethod]
+    public async Task Block_GradeAcademicYearPeriod_IsAllowedEvenWhenNotTheActiveYear()
+    {
+        using var s = new StudentsTestScope("blk-grade-fr57-year");
+        var (_, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var otherYear = SeedPeriod(s, "AY2027", D(2027, 9, 1), D(2028, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+
+        var id = await NewHandler(s).HandleAsync(new BlockSubject(gradeId, null, TopicId, otherYear.Id));
+
+        id.Should().NotBeEmpty("any top-level academic year is a valid grade-topic block period (FR-57)");
+    }
+
+    // ── FR-56 for group-owned blocks ──────────────────────────────────────────
+
+    [TestMethod]
+    public async Task Block_TermlyGroup_TermPeriod_IsAllowed()
+    {
+        using var s = new StudentsTestScope("blk-group-term");
+        var (_, term, _) = await SeedActiveYearAndTermAsync(s);
+        var group = await SeedGroupAsync(s, EnrollmentSpan.Termly);
+
+        var id = await NewHandler(s).HandleAsync(new BlockSubject(null, group.Id, TopicId, term.Id));
+
+        id.Should().NotBeEmpty();
+    }
+
+    [TestMethod]
+    public async Task Block_TermlyGroup_SemesterPeriod_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-group-span-mismatch");
+        var (year, _, _) = await SeedActiveYearAndTermAsync(s);
+        var semester = SeedPeriod(s, "S1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Semesters, year.Id);
+        await s.Db.SaveChangesAsync();
+        var group = await SeedGroupAsync(s, EnrollmentSpan.Termly);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(null, group.Id, TopicId, semester.Id));
+
+        await act.Should().ThrowAsync<TopicAssignmentPeriodException>();
+    }
+
+    [TestMethod]
+    public async Task Block_WholeAcademicYearGroup_AcademicYear_IsAllowed()
+    {
+        using var s = new StudentsTestScope("blk-group-year");
+        var (year, _, _) = await SeedActiveYearAndTermAsync(s);
+        var group = await SeedGroupAsync(s, EnrollmentSpan.WholeAcademicYear);
+
+        var id = await NewHandler(s).HandleAsync(new BlockSubject(null, group.Id, TopicId, year.Id));
+
+        id.Should().NotBeEmpty();
+    }
+
+    [TestMethod]
+    public async Task Block_OpenEndedGroup_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-group-openended");
+        var (year, _, _) = await SeedActiveYearAndTermAsync(s);
+        var group = await SeedGroupAsync(s, EnrollmentSpan.OpenEnded);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(null, group.Id, TopicId, year.Id));
+
+        (await act.Should().ThrowAsync<TopicAssignmentPeriodException>())
+            .And.Message.Should().Contain("no period to block");
+    }
+
+    [TestMethod]
+    public async Task Block_DateRangeGroup_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-group-daterange");
+        var (year, _, _) = await SeedActiveYearAndTermAsync(s);
+        // A DateRange span requires its window bounds (FR-47/48).
+        var group = ActivityGroup.Create("DateRange Club", span: EnrollmentSpan.DateRange,
+            enrollmentStartDate: D(2026, 9, 1), enrollmentEndDate: D(2027, 8, 31));
+        s.Db.ActivityGroups.Add(group);
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(null, group.Id, TopicId, year.Id));
+
+        await act.Should().ThrowAsync<TopicAssignmentPeriodException>();
+    }
+
+    // ── AC-4: duplicate → 409, not a second row ───────────────────────────────
+
+    [TestMethod]
+    public async Task Block_Duplicate_ThrowsDuplicateSubjectBlock()
+    {
+        using var s = new StudentsTestScope("blk-duplicate");
+        var (_, term, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var handler = NewHandler(s);
+
+        await handler.HandleAsync(new BlockSubject(gradeId, null, TopicId, term.Id));
+
+        await FluentActions.Awaiting(() => handler.HandleAsync(
+            new BlockSubject(gradeId, null, TopicId, term.Id)))
+            .Should().ThrowAsync<DuplicateSubjectBlockException>();
+
+        s.Db.SubjectEnrollmentBlocks.Should().HaveCount(1, "no silent second row");
+    }
+
+    [TestMethod]
+    public async Task Block_AfterRemove_CanBeReAdded_DuplicateGuardIgnoresSoftDeletedRows()
+    {
+        // Proves the HANDLER half only: ExistsAsync runs through the soft-delete query
+        // filter, so a soft-deleted row no longer trips the 409 duplicate guard. This
+        // suite is EF InMemory, which enforces neither unique indexes nor HasFilter, so
+        // it CANNOT prove the merged index filter ("... AND is_deleted = false") that
+        // makes the re-add legal against Postgres — that half is proven in
+        // SubjectBlockAvailabilityEndpointTests.RemovedBlock_CanBeReAdded_ForTheSameOwnerTopicPeriod.
+        using var s = new StudentsTestScope("blk-readd");
+        var (_, term, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var handler = NewHandler(s);
+        var first = await handler.HandleAsync(new BlockSubject(gradeId, null, TopicId, term.Id));
+
+        var block = await s.Db.SubjectEnrollmentBlocks.SingleAsync(x => x.Id == first);
+        block.MarkAsDeleted();
+        await s.Db.SaveChangesAsync();
+
+        var second = await handler.HandleAsync(new BlockSubject(gradeId, null, TopicId, term.Id));
+
+        second.Should().NotBe(first);
+    }
+
+    // ── Owner shape / not-found guards ────────────────────────────────────────
+
+    [TestMethod]
+    public async Task Block_WithBothOwners_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-two-owners");
+        var (_, term, gradeId) = await SeedActiveYearAndTermAsync(s);
+        var group = await SeedGroupAsync(s, EnrollmentSpan.Termly);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(gradeId, group.Id, TopicId, term.Id));
+
+        (await act.Should().ThrowAsync<TopicAssignmentPeriodException>())
+            .And.Message.Should().Contain("exactly one owner");
+    }
+
+    [TestMethod]
+    public async Task Block_WithNeitherOwner_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-no-owner");
+        var (_, term, _) = await SeedActiveYearAndTermAsync(s);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(null, null, TopicId, term.Id));
+
+        await act.Should().ThrowAsync<TopicAssignmentPeriodException>();
+    }
+
+    [TestMethod]
+    public async Task Block_UnknownGrade_ThrowsGradeLevelNotFound()
+    {
+        using var s = new StudentsTestScope("blk-unknown-grade");
+        var (_, term, _) = await SeedActiveYearAndTermAsync(s);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(Guid.NewGuid(), null, TopicId, term.Id));
+
+        await act.Should().ThrowAsync<GradeLevelNotFoundException>();
+    }
+
+    [TestMethod]
+    public async Task Block_UnknownPeriod_Throws422()
+    {
+        using var s = new StudentsTestScope("blk-unknown-period");
+        var (_, _, gradeId) = await SeedActiveYearAndTermAsync(s);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(gradeId, null, TopicId, Guid.NewGuid()));
+
+        (await act.Should().ThrowAsync<TopicAssignmentPeriodException>())
+            .And.Message.Should().Contain("does not exist");
+    }
+
+    [TestMethod]
+    public async Task Block_UnknownGroup_ThrowsActivityGroupNotFound()
+    {
+        using var s = new StudentsTestScope("blk-unknown-group");
+        var (_, term, _) = await SeedActiveYearAndTermAsync(s);
+
+        var act = async () => await NewHandler(s).HandleAsync(
+            new BlockSubject(null, Guid.NewGuid(), TopicId, term.Id));
+
+        await act.Should().ThrowAsync<ActivityGroupNotFoundException>();
+    }
+}
