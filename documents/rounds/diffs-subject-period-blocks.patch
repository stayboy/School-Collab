--- /dev/null
+++ b/src/Students/SchoolCollab.Students.Application/Components/Students/SubjectBlockLabels.cs
@@ -0,0 +1,51 @@
+using SchoolCollab.Students.Core.DTOs;
+
+namespace SchoolCollab.Students.Application.Components.Students;
+
+/// <summary>
+/// Display rules for subject enrollment blocks (subject-period-exception-model.md §5),
+/// shared by the grade-detail Subjects card, the "View all subjects" dialog and the
+/// <see cref="TopicEditDialog"/> exceptions section so the wording is spelled once.
+///
+/// <para>A subject with no blocks is <b>offered in every period</b> — the normal
+/// state since the period whitelist was retired (an empty exception list is not a
+/// gap to warn about). A block whose period has since been archived still renders,
+/// with an "(archived)" marker, and stays deletable: otherwise a tenant could never
+/// clean up a block on a retired period.</para>
+/// </summary>
+public static class SubjectBlockLabels
+{
+    /// <summary>Meta text for a subject with no blocks — the normal state.</summary>
+    public const string NoExceptions = "Offered in every period";
+
+    /// <summary>
+    /// True for a period status that is no longer live (<c>Archived</c> /
+    /// <c>Deactivated</c>). Those periods cannot be *blocked* (the picker excludes
+    /// them), but a block already pointing at one stays visible and removable.
+    /// </summary>
+    public static bool IsRetiredPeriod(string? status) =>
+        string.Equals(status, "Archived", StringComparison.OrdinalIgnoreCase)
+        || string.Equals(status, "Deactivated", StringComparison.OrdinalIgnoreCase);
+
+    /// <summary>
+    /// One-line summary of a subject's exceptions: <see cref="NoExceptions"/> when
+    /// there are none, otherwise "Blocked in Term 1 · Term 3 (archived)". Period
+    /// names are always used — never a GUID prefix.
+    /// </summary>
+    public static string Describe(IEnumerable<SubjectEnrollmentBlockDto> blocks)
+    {
+        var labels = DescribePeriods(blocks);
+        return labels.Length == 0 ? NoExceptions : $"Blocked in {string.Join(" · ", labels)}";
+    }
+
+    /// <summary>
+    /// The blocked periods as display names, each marked "(archived)" when its
+    /// period is retired. Order follows the caller's sequence (the API returns
+    /// blocks by period start date).
+    /// </summary>
+    public static string[] DescribePeriods(IEnumerable<SubjectEnrollmentBlockDto> blocks) =>
+        blocks
+            .Select(b => IsRetiredPeriod(b.PeriodStatus) ? $"{b.PeriodName} (archived)" : b.PeriodName)
+            .Distinct()
+            .ToArray();
+}
