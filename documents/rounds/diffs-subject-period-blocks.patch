@@ -0,0 +1,87 @@
+using Microsoft.Extensions.Caching.Hybrid;
+using Microsoft.Extensions.Logging;
+using SchoolCollab.Core.CQRS;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments;
+using SchoolCollab.Students.Core.Data.Repositories;
+using SchoolCollab.Students.Core.Domain;
+using SchoolCollab.Students.Core.Domain.Exceptions;
+
+namespace SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Commands.BlockSubject;
+
+/// <summary>
+/// Creates a subject enrollment block (subject-period-exception-model.md §4.2).
+/// Validates the owner and the period admissibility through
+/// <see cref="TopicAssignmentPeriodValidator"/> (the block rules live beside the
+/// FR-56/57 rules they mirror), and rejects a duplicate
+/// <c>(owner, topic, period)</c> with a 409 rather than letting the filtered unique
+/// index raise a raw <c>23505</c>.
+/// </summary>
+public sealed class BlockSubjectHandler(
+    ISubjectEnrollmentBlockRepository repository,
+    IPeriodRepository periodRepository,
+    IGradeLevelRepository gradeLevelRepository,
+    IActivityGroupRepository activityGroupRepository,
+    ITenantProvider tenantProvider,
+    HybridCache cache,
+    ILogger<BlockSubjectHandler> logger) : ICommandHandler<BlockSubject, Guid>
+{
+    public async Task<Guid> HandleAsync(BlockSubject command, CancellationToken cancellationToken = default)
+    {
+        logger.LogDebug(
+            "Handling BlockSubject for grade {GradeLevelId} / group {ActivityGroupId}, topic {TopicId}, period {PeriodId}",
+            command.GradeLevelId, command.ActivityGroupId, command.TopicId, command.PeriodId);
+
+        // FR-4: no strict entity may be created with an empty tenant.
+        var tenantId = tenantProvider.RequireTenantContext(nameof(BlockSubject), typeof(SubjectEnrollmentBlock));
+
+        var hasGrade = command.GradeLevelId is not null;
+        var hasGroup = command.ActivityGroupId is not null;
+        if (hasGrade == hasGroup)
+        {
+            throw new TopicAssignmentPeriodException(
+                "A subject block must target exactly one owner: either a grade level or an activity group.",
+                command.PeriodId);
+        }
+
+        if (hasGrade)
+        {
+            var gradeLevelId = command.GradeLevelId!.Value;
+            if (await gradeLevelRepository.GetAsync(gradeLevelId, cancellationToken) is null)
+                throw new GradeLevelNotFoundException(gradeLevelId);
+
+            await TopicAssignmentPeriodValidator.ValidateGradeBlockPeriodAsync(
+                command.PeriodId, periodRepository, cancellationToken);
+        }
+        else
+        {
+            await TopicAssignmentPeriodValidator.ValidateGroupBlockPeriodAsync(
+                command.ActivityGroupId!.Value, command.PeriodId,
+                activityGroupRepository, periodRepository, cancellationToken);
+        }
+
+        if (await repository.ExistsAsync(
+                command.GradeLevelId, command.ActivityGroupId, command.TopicId, command.PeriodId, cancellationToken))
+        {
+            throw new DuplicateSubjectBlockException(
+                command.GradeLevelId, command.ActivityGroupId, command.TopicId, command.PeriodId);
+        }
+
+        var block = SubjectEnrollmentBlock.Create(
+            tenantId,
+            command.GradeLevelId,
+            command.ActivityGroupId,
+            command.TopicId,
+            command.PeriodId,
+            command.Reason);
+
+        await repository.AddAsync(block, cancellationToken);
+        await cache.RemoveByTagAsync("students", cancellationToken);
+
+        logger.LogInformation(
+            "SubjectEnrollmentBlock {Id} created (topic {TopicId}, period {PeriodId})",
+            block.Id, block.TopicId, block.PeriodId);
+
+        return block.Id;
+    }
+}
