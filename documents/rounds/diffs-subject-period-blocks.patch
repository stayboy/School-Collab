@@ -0,0 +1,281 @@
+@*
+    SubjectBlocksDialog — one subject's enrollment exceptions (the periods it is
+    NOT offered in) for ONE grade (subject-period-exception-model.md §5).
+
+    Moved off the grade-detail surfaces onto the Subjects landing, where the owner
+    picks the subject: the grade page keeps only the read-only block label, and
+    this dialog owns the add/remove. Grade-owned scope only — the landing's
+    affordance is grade-only, so every block here names a GradeLevelId and no
+    activity group.
+
+    No-submit dialog, mirroring SubPeriodsListDialog: add and remove write through
+    StudentsApiClient immediately, so there is no form, no model and no OK/Cancel
+    result. Opened via IDialogService.ShowReadonlyDialogAsync, whose
+    BuildShellParameters sets PrimaryAction and SecondaryAction to null — FluentUI
+    renders no built-in footer button at all and the body owns the single Close
+    affordance (dialog-ui §2 separator). Reads its inputs from the Content
+    DialogParameters indexer (FluentUI does not spread indexer entries onto
+    [Parameter]s — documents/solution/dialog-parameter-binding.md).
+*@
+@implements IDialogContentComponent<DialogParameters>
+@using Microsoft.FluentUI.AspNetCore.Components
+@using SubjectEnrollmentBlockDto = SchoolCollab.Students.Core.DTOs.SubjectEnrollmentBlockDto
+@inject StudentsApiClient Api
+@inject ILogger<SubjectBlocksDialog> Logger
+
+<div class="subject-blocks-dialog">
+    @* Read-only header: the dialog is opened from a landing that lists many
+       subjects, so it must name the subject AND the grade that owns this
+       exception list. Never an editable field — the owner comes from the row. *@
+    <h3 class="subject-blocks-header">@HeaderText</h3>
+    <p class="hint">A subject is offered in every period unless it is blocked below — blocking is the exception (staffing, a curriculum clash, a subject that only runs in one term).</p>
+
+    @if (_error is not null)
+    {
+        <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
+    }
+
+    <section aria-label="Enrollment exceptions">
+        @if (_blocks is null)
+        {
+            <FluentProgressRing />
+        }
+        else if (_blocks.Length == 0)
+        {
+            @* An empty exception list is the NORMAL state (FR-ED-14): no warning. *@
+            <p class="subject-blocks-empty">No exceptions — this subject is offered in every period.</p>
+        }
+        else
+        {
+            <div class="subject-blocks-list">
+                @foreach (var block in _blocks)
+                {
+                    <div class="subject-blocks-row" @key="block.Id">
+                        <span class="subject-blocks-period">@block.PeriodName</span>
+                        @if (SubjectBlockLabels.IsRetiredPeriod(block.PeriodStatus))
+                        {
+                            @* The period has been retired since the block was made:
+                               read-only marker, but the delete control stays so the
+                               block can still be cleaned up (spec §5 trap). *@
+                            <FluentBadge Appearance="Appearance.Neutral"
+                                         Title="This period is no longer live. The exception still applies until you remove it.">
+                                @block.PeriodStatus
+                            </FluentBadge>
+                        }
+                        <FluentButton Appearance="Appearance.Stealth"
+                                      Class="subject-blocks-icon-button"
+                                      IconStart="@FluentIcons.Delete"
+                                      Title="Remove this exception"
+                                      aria-label="@($"Remove exception for {block.PeriodName}")"
+                                      Disabled="@_blockBusy"
+                                      OnClick="@(() => RemoveBlockAsync(block))" />
+                    </div>
+                }
+            </div>
+        }
+
+        @* Add affordance. Raw FluentSelect (not a wrapper) because the options
+           are filtered per render from the tenant's periods AND the subject's
+           existing blocks — see dropdown-ui §1 "document why". *@
+        <div class="subject-blocks-add-row">
+            <FluentSelect TOption="PeriodDto"
+                          Id="subject-blocks-period"
+                          Items="_blockablePeriods"
+                          OptionText="@(p => p.Name)"
+                          OptionValue="@(p => p.Id.ToString())"
+                          @bind-SelectedOption="_blockPeriod"
+                          Placeholder="Pick a period to block…"
+                          aria-label="Period to block" />
+            <FluentButton Appearance="Appearance.Accent"
+                          IconStart="@FluentIcons.Add"
+                          OnClick="AddBlockAsync"
+                          Disabled="@(_blockBusy || _blockPeriod is null)">
+                Block period
+            </FluentButton>
+        </div>
+    </section>
+
+    @* The dialog host has no PrimaryAction/SecondaryAction (BuildShellParameters
+       sets both null), so the body owns the close affordance. The top border is
+       the content/actions separator mandated by the dialog-ui skill. *@
+    <div class="dialog-footer">
+        <FluentButton Appearance="Appearance.Accent" Title="Close" OnClick="CloseAsync">Close</FluentButton>
+    </div>
+</div>
+
+@code {
+    /// <summary>Keys used in <see cref="Content"/> (the DialogParameters
+    /// indexer). Exposed so callers set the same keys they read here.</summary>
+    public const string TopicIdKey = nameof(TopicId);
+    public const string SubjectNameKey = nameof(SubjectName);
+    public const string GradeLevelIdKey = nameof(GradeLevelId);
+    public const string GradeNameKey = nameof(GradeName);
+
+    // Read from Content (the DialogParameters indexer) — FluentUI renders dialog
+    // content via DynamicComponent with only { "Content": <DialogParameters> } and
+    // does NOT spread indexer entries onto separate [Parameter]s
+    // (documents/solution/dialog-parameter-binding.md). TryGet, not the indexer:
+    // the latter throws KeyNotFoundException for a missing key.
+    private T? Get<T>(string key) => Content is { } c ? c.TryGet<T>(key) : default;
+
+    /// <summary>The subject whose exceptions are managed. Required.</summary>
+    private Guid TopicId => Get<Guid>(TopicIdKey);
+
+    /// <summary>The subject's display name, for the header.</summary>
+    private string? SubjectName => Get<string>(SubjectNameKey);
+
+    /// <summary>The grade that owns the exception list. Required — the picker
+    /// offers that grade's blockable periods (FR-57).</summary>
+    private Guid GradeLevelId => Get<Guid>(GradeLevelIdKey);
+
+    /// <summary>The grade's display name, for the header.</summary>
+    private string? GradeName => Get<string>(GradeNameKey);
+
+    /// <summary>The hosting <see cref="FluentDialog"/> reference provided by the
+    /// dialog host as a cascading parameter. Nullable so unit tests that render
+    /// the component without a host do not NRE.</summary>
+    [CascadingParameter] public FluentDialog? Dialog { get; set; }
+
+    /// <summary>Required by <c>IDialogContentComponent&lt;DialogParameters&gt;</c>
+    /// for the two-type-arg <c>IDialogService.ShowDialogAsync</c> overload used
+    /// by <c>ShowReadonlyDialogAsync</c>.</summary>
+    [Parameter] public DialogParameters Content { get; set; } = default!;
+
+    /// <summary>Header line: "Mathematics — Grade 5".</summary>
+    private string HeaderText
+    {
+        get
+        {
+            var subject = string.IsNullOrWhiteSpace(SubjectName) ? "This subject" : SubjectName;
+            return string.IsNullOrWhiteSpace(GradeName) ? subject : $"{subject} — {GradeName}";
+        }
+    }
+
+    /// <summary>The subject's blocks for this grade — null while loading.</summary>
+    private SubjectEnrollmentBlockDto[]? _blocks;
+    private string? _error;
+
+    /// <summary>Every period this grade may block (active-year scope, no retired periods).</summary>
+    private PeriodDto[] _periods = [];
+    private Guid? _activeYearId;
+
+    /// <summary>The period picked in the add affordance.</summary>
+    private PeriodDto? _blockPeriod;
+    private bool _blockBusy;
+
+    /// <summary>The topic whose blocks are loaded, so a reused instance reloads.</summary>
+    private Guid? _loadedFor;
+
+    /// <summary>
+    /// The periods offered for blocking: the tenant's live periods, and — for a
+    /// grade-owned block (FR-57) — either a top-level academic year or a
+    /// Term/Semester of the ACTIVE academic year. Retired periods (Archived /
+    /// Deactivated) are excluded, and so is any period this subject is already
+    /// blocked in: a duplicate is impossible to create (FR-ED-13), and the server
+    /// answers 409 if one races past this filter.
+    /// </summary>
+    private PeriodDto[] _blockablePeriods =>
+        _periods
+            .Where(p => !SubjectBlockLabels.IsRetiredPeriod(p.Status))
+            .Where(p => p.ParentPeriodId is null
+                || (_activeYearId.HasValue && p.ParentPeriodId == _activeYearId.Value))
+            .Where(p => _blocks is null || _blocks.All(b => b.PeriodId != p.Id))
+            .OrderBy(p => p.ParentPeriodId is null ? 0 : 1)
+            .ThenBy(p => p.StartDate)
+            .ToArray();
+
+    protected override async Task OnParametersSetAsync()
+    {
+        if (_loadedFor == TopicId) return;
+        _loadedFor = TopicId;
+        await LoadBlockPeriodsAsync();
+        await LoadBlocksAsync();
+    }
+
+    /// <summary>
+    /// Loads the periods a grade-owned block may target. Best-effort: a failure
+    /// leaves the picker empty (the server validator is the final gate) instead of
+    /// taking down a dialog whose whole job is managing the exceptions.
+    /// </summary>
+    private async Task LoadBlockPeriodsAsync()
+    {
+        try
+        {
+            var periodsTask = Api.ListPeriodsAsync();
+            var activeYearTask = Api.GetActiveAcademicYearAsync();
+            await Task.WhenAll(periodsTask, activeYearTask);
+            _periods = periodsTask.Result ?? [];
+            _activeYearId = activeYearTask.Result?.Id;
+        }
+        catch (Exception ex)
+        {
+            Logger.LogWarning(ex, "Failed to load periods for the enrollment exceptions dialog");
+            _periods = [];
+            _activeYearId = null;
+        }
+    }
+
+    /// <summary>
+    /// Loads this subject's blocks for the grade. Not cached server-side, and
+    /// re-read after every add/remove so the list always reflects the server.
+    /// </summary>
+    private async Task LoadBlocksAsync()
+    {
+        try
+        {
+            _blocks = await Api.ListSubjectBlocksAsync(gradeLevelId: GradeLevelId, topicId: TopicId) ?? [];
+        }
+        catch (Exception ex)
+        {
+            _blocks = [];
+            _error = $"Could not load enrollment exceptions: {ex.Message}";
+        }
+    }
+
+    private async Task AddBlockAsync()
+    {
+        if (_blockBusy || _blockPeriod is not { } period) return;
+        _blockBusy = true;
+        _error = null;
+        try
+        {
+            await Api.BlockSubjectAsync(new BlockSubjectRequest(
+                GradeLevelId, ActivityGroupId: null, TopicId, period.Id));
+            _blockPeriod = null;
+            await LoadBlocksAsync();
+        }
+        catch (Exception ex)
+        {
+            // 422 (period not admissible) / 409 (already blocked) carry the
+            // server's own message — surface it instead of dropping it.
+            _error = ex.Message;
+        }
+        finally
+        {
+            _blockBusy = false;
+        }
+    }
+
+    private async Task RemoveBlockAsync(SubjectEnrollmentBlockDto block)
+    {
+        if (_blockBusy) return;
+        _blockBusy = true;
+        _error = null;
+        try
+        {
+            await Api.RemoveSubjectBlockAsync(block.Id);
+            await LoadBlocksAsync();
+        }
+        catch (Exception ex)
+        {
+            _error = ex.Message;
+        }
+        finally
+        {
+            _blockBusy = false;
+        }
+    }
+
+    private Task CloseAsync()
+        => Dialog is null ? Task.CompletedTask : Dialog.CloseAsync();
+}
