@@ -0,0 +1,109 @@
+using FluentAssertions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Students.Core.Domain;
+
+namespace SchoolCollab.Students.Tests.Unit.Domain;
+
+/// <summary>
+/// Entity invariants for <see cref="SubjectEnrollmentBlock"/>
+/// (subject-period-exception-model.md §2, AC-3/AC-4). The block is the period
+/// <b>exception</b>: exactly one owner, a REQUIRED period, no status column.
+/// </summary>
+[TestClass]
+public class SubjectEnrollmentBlockTests
+{
+    private static readonly Guid TenantId = Guid.Parse("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa");
+    private static readonly Guid GradeId = Guid.Parse("dddddddd-dddd-dddd-dddd-dddddddddddd");
+    private static readonly Guid GroupId = Guid.Parse("eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee");
+    private static readonly Guid TopicId = Guid.Parse("ffffffff-ffff-ffff-ffff-ffffffffffff");
+    private static readonly Guid PeriodId = Guid.Parse("11111111-1111-1111-1111-111111111111");
+
+    [TestMethod]
+    public void Create_WithGradeOwner_SetsOwnerPeriodAndAuditStamps()
+    {
+        var block = SubjectEnrollmentBlock.Create(TenantId, GradeId, null, TopicId, PeriodId);
+
+        block.Id.Should().NotBeEmpty();
+        block.TenantId.Should().Be(TenantId);
+        block.GradeLevelId.Should().Be(GradeId);
+        block.ActivityGroupId.Should().BeNull();
+        block.TopicId.Should().Be(TopicId);
+        block.PeriodId.Should().Be(PeriodId);
+        block.Reason.Should().BeNull();
+        block.CreatedAt.Should().NotBe(default);
+        block.UpdatedAt.Should().NotBe(default);
+        block.IsDeleted.Should().BeFalse("a fresh block is live");
+    }
+
+    [TestMethod]
+    public void Create_WithGroupOwner_SetsGroupOwner()
+    {
+        var block = SubjectEnrollmentBlock.Create(TenantId, null, GroupId, TopicId, PeriodId);
+
+        block.ActivityGroupId.Should().Be(GroupId);
+        block.GradeLevelId.Should().BeNull();
+    }
+
+    [TestMethod]
+    public void Create_WithBothOwners_Throws()
+    {
+        var act = () => SubjectEnrollmentBlock.Create(TenantId, GradeId, GroupId, TopicId, PeriodId);
+
+        act.Should().Throw<ArgumentException>()
+            .WithMessage("*exactly one owner*");
+    }
+
+    [TestMethod]
+    public void Create_WithNeitherOwner_Throws()
+    {
+        var act = () => SubjectEnrollmentBlock.Create(TenantId, null, null, TopicId, PeriodId);
+
+        act.Should().Throw<ArgumentException>()
+            .WithMessage("*exactly one owner*");
+    }
+
+    [TestMethod]
+    public void Create_WithEmptyPeriod_Throws_NoPeriodIsTheAvailableState()
+    {
+        // The whole point of the inversion: a block with no period is meaningless
+        // ("no period" IS the default, available state), so the period is required.
+        var act = () => SubjectEnrollmentBlock.Create(TenantId, GradeId, null, TopicId, Guid.Empty);
+
+        act.Should().Throw<ArgumentException>()
+            .WithMessage("*requires a period*");
+    }
+
+    [TestMethod]
+    public void Create_WithEmptyTopic_Throws()
+    {
+        var act = () => SubjectEnrollmentBlock.Create(TenantId, GradeId, null, Guid.Empty, PeriodId);
+
+        act.Should().Throw<ArgumentException>()
+            .WithMessage("*requires a topic*");
+    }
+
+    [TestMethod]
+    public void Create_TrimsReason_AndNormalisesBlankToNull()
+    {
+        SubjectEnrollmentBlock.Create(TenantId, GradeId, null, TopicId, PeriodId, "  teacher on leave  ")
+            .Reason.Should().Be("teacher on leave");
+
+        SubjectEnrollmentBlock.Create(TenantId, GradeId, null, TopicId, PeriodId, "   ")
+            .Reason.Should().BeNull();
+    }
+
+    [TestMethod]
+    public void MarkAsDeleted_SoftDeletes_TheAuditBaseSuppliesTheFlag()
+    {
+        // There is deliberately no status column: un-blocking is a soft delete, and
+        // the is_deleted column comes from BaseTenantEntityWithAudit.
+        var block = SubjectEnrollmentBlock.Create(TenantId, GradeId, null, TopicId, PeriodId);
+        var before = block.UpdatedAt;
+
+        block.MarkAsDeleted();
+
+        block.IsDeleted.Should().BeTrue();
+        block.DeletedAt.Should().NotBeNull();
+        block.UpdatedAt.Should().BeOnOrAfter(before);
+    }
+}
