@@ -0,0 +1,54 @@
+using SchoolCollab.Students.Core.Domain;
+using SchoolCollab.Students.Core.DTOs;
+
+namespace SchoolCollab.Students.Core.Data.Repositories;
+
+/// <summary>
+/// Repository for <see cref="SubjectEnrollmentBlock"/> — the period exception that
+/// hides an otherwise-assigned subject for one period
+/// (subject-period-exception-model.md §2). Blocks are written rarely and read
+/// rarely; nothing here is cached.
+/// </summary>
+public interface ISubjectEnrollmentBlockRepository
+{
+    Task<SubjectEnrollmentBlock?> GetAsync(Guid id, CancellationToken cancellationToken = default);
+
+    Task AddAsync(SubjectEnrollmentBlock block, CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Soft-deletes the block (un-blocking is a delete, never a status change).
+    /// The row is retained as audit: "who blocked Math in Term 3, and when".
+    /// </summary>
+    Task SoftDeleteAsync(SubjectEnrollmentBlock block, CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Lists blocks for an owner, optionally narrowed to one topic and/or one
+    /// period. Both owner filters null lists every block of the current tenant.
+    /// </summary>
+    Task<SubjectEnrollmentBlockDto[]> ListDtosAsync(
+        Guid? gradeLevelId,
+        Guid? activityGroupId,
+        Guid? topicId = null,
+        Guid? periodId = null,
+        CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// True when a live block already exists for the exact
+    /// <c>(owner, topic, period)</c> — backs the 409 duplicate guard.
+    /// </summary>
+    Task<bool> ExistsAsync(
+        Guid? gradeLevelId,
+        Guid? activityGroupId,
+        Guid topicId,
+        Guid periodId,
+        CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Every live block whose period is in <paramref name="periodIds"/>. Used by
+    /// <c>DeletePeriodHandler</c> to turn the period FK RESTRICT into a 422
+    /// (P2-10) instead of a raw Postgres FK violation — the set covers the period
+    /// being deleted plus, for a top-level year, the sub-periods the cascade removes.
+    /// </summary>
+    Task<SubjectEnrollmentBlock[]> ListByPeriodsAsync(
+        IReadOnlyCollection<Guid> periodIds, CancellationToken cancellationToken = default);
+}
diff --git a/src/Students/SchoolCollab.Students.Core/Data/Repositories/SubjectEnrollmentBlockRepository.cs b/src/Students/SchoolCollab.Students.Core/Data/Repositories/SubjectEnrollmentBlockRepository.cs
new file mode 100644
index 00000000..3421212e
--- /dev/null
+++ b/src/Students/SchoolCollab.Students.Core/Data/Repositories/SubjectEnrollmentBlockRepository.cs
@@ -0,0 +1,88 @@
+using Microsoft.EntityFrameworkCore;
+using SchoolCollab.Core.Data.Repositories;
+using SchoolCollab.Students.Core.Domain;
+using SchoolCollab.Students.Core.DTOs;
+
+namespace SchoolCollab.Students.Core.Data.Repositories;
+
+internal sealed class SubjectEnrollmentBlockRepository(StudentsDbContext db)
+    : RepositoryBase<SubjectEnrollmentBlock, StudentsDbContext>(db), ISubjectEnrollmentBlockRepository
+{
+    /// <summary>
+    /// Un-blocking soft-deletes the row (the "SoftDelete" query filter hides it from
+    /// every subsequent read), so the reason a subject was unavailable is retained.
+    /// </summary>
+    public async Task SoftDeleteAsync(SubjectEnrollmentBlock block, CancellationToken cancellationToken = default)
+    {
+        block.MarkAsDeleted();
+        await UpdateAsync(block, cancellationToken);
+    }
+
+    public async Task<SubjectEnrollmentBlockDto[]> ListDtosAsync(
+        Guid? gradeLevelId,
+        Guid? activityGroupId,
+        Guid? topicId = null,
+        Guid? periodId = null,
+        CancellationToken cancellationToken = default)
+    {
+        var rows = await (from b in Db.SubjectEnrollmentBlocks.AsNoTracking()
+                          join p in Db.Periods.AsNoTracking() on b.PeriodId equals p.Id
+                          where (gradeLevelId == null || b.GradeLevelId == gradeLevelId)
+                                && (activityGroupId == null || b.ActivityGroupId == activityGroupId)
+                                && (topicId == null || b.TopicId == topicId)
+                                && (periodId == null || b.PeriodId == periodId)
+                          orderby p.StartDate, b.CreatedAt
+                          select new
+                          {
+                              b.Id,
+                              b.GradeLevelId,
+                              b.ActivityGroupId,
+                              b.TopicId,
+                              b.PeriodId,
+                              p.Name,
+                              p.Status,
+                              b.Reason,
+                              b.CreatedAt,
+                              b.UpdatedAt,
+                          }).ToArrayAsync(cancellationToken);
+
+        return rows.Select(r => new SubjectEnrollmentBlockDto(
+                r.Id,
+                r.GradeLevelId,
+                r.ActivityGroupId,
+                r.TopicId,
+                r.PeriodId,
+                r.Name,
+                r.Status.ToString(),
+                r.Reason,
+                r.CreatedAt,
+                r.UpdatedAt))
+            .ToArray();
+    }
+
+    public Task<bool> ExistsAsync(
+        Guid? gradeLevelId,
+        Guid? activityGroupId,
+        Guid topicId,
+        Guid periodId,
+        CancellationToken cancellationToken = default) =>
+        Db.SubjectEnrollmentBlocks.AnyAsync(
+            x => x.GradeLevelId == gradeLevelId
+                && x.ActivityGroupId == activityGroupId
+                && x.TopicId == topicId
+                && x.PeriodId == periodId,
+            cancellationToken);
+
+    public async Task<SubjectEnrollmentBlock[]> ListByPeriodsAsync(
+        IReadOnlyCollection<Guid> periodIds, CancellationToken cancellationToken = default)
+    {
+        if (periodIds.Count == 0)
+            return [];
+
+        var ids = periodIds as Guid[] ?? periodIds.ToArray();
+        return await Db.SubjectEnrollmentBlocks
+            .AsNoTracking()
+            .Where(x => ids.Contains(x.PeriodId))
+            .ToArrayAsync(cancellationToken);
+    }
+}
