--- /dev/null
+++ b/tests/SchoolCollab.Students.Tests.Unit/DeletePeriodBlockGuardTests.cs
@@ -0,0 +1,139 @@
+using FluentAssertions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.CQRS.Periods.Commands.DeletePeriod;
+using SchoolCollab.Students.Core.Data.Repositories;
+using SchoolCollab.Students.Core.Domain;
+using SchoolCollab.Students.Core.Domain.Exceptions;
+
+namespace SchoolCollab.Students.Tests.Unit;
+
+/// <summary>
+/// P2-10 (subject-period-exception-model.md §4.2/§8 Q3): a subject block references
+/// its period with <c>ON DELETE RESTRICT</c> and a <b>Draft</b> period MAY carry a
+/// block (AC-3), so the Draft-only delete rule alone would let the delete reach
+/// SaveChanges and surface a raw Postgres FK violation as a 500. The handler's
+/// pre-mutation guard must answer 422 (<see cref="PeriodNotDeletableException"/>)
+/// and name the blocking row instead.
+/// </summary>
+[TestClass]
+public class DeletePeriodBlockGuardTests
+{
+    private static DateOnly D(int y, int m, int d) => new(y, m, d);
+
+    private static readonly Guid GradeId = Guid.Parse("aaaaaaa1-1111-1111-1111-111111111111");
+
+    private static Guid CurrentTenantId(StudentsTestScope s) => s.Tenants.GetTenantContext().TenantId;
+
+    private static DeletePeriodHandler NewDelete(StudentsTestScope s) =>
+        new(s.Periods, new SubjectEnrollmentBlockRepository(s.Db), s.Cache, NullLogger<DeletePeriodHandler>.Instance);
+
+    private static Period SeedPeriod(
+        StudentsTestScope s, string name, DateOnly start, DateOnly end,
+        AcademicYearDivision division, Guid? parent = null)
+    {
+        var period = Period.Create(name, start, end, division, parent);
+        ((ITenantEntity)period).TenantId = CurrentTenantId(s);
+        s.Db.Periods.Add(period);
+        return period;
+    }
+
+    /// <summary>Seeds a GradeLevel row so the block's owner FK points at a real grade.</summary>
+    private static async Task SeedGradeLevelAsync(StudentsTestScope s)
+    {
+        s.Db.GradeLevels.Add(GradeLevel.Create(GradeId, 1, "Grade 1", 1));
+        await s.Db.SaveChangesAsync();
+    }
+
+    private static SubjectEnrollmentBlock SeedGradeBlock(StudentsTestScope s, Guid topicId, Guid periodId)
+    {
+        var block = SubjectEnrollmentBlock.Create(CurrentTenantId(s), GradeId, null, topicId, periodId, "teacher on leave");
+        s.Db.SubjectEnrollmentBlocks.Add(block);
+        return block;
+    }
+
+    [TestMethod]
+    public async Task Delete_DraftSubPeriodCarryingABlock_Throws422_NamingTheBlock()
+    {
+        using var s = new StudentsTestScope("delguard-subperiod");
+        await SeedGradeLevelAsync(s);
+        var topicId = Guid.NewGuid();
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        var block = SeedGradeBlock(s, topicId, term.Id);
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewDelete(s).HandleAsync(new DeletePeriod(term.Id));
+
+        var ex = await act.Should().ThrowAsync<PeriodNotDeletableException>(
+            "the FK RESTRICT must surface as a 422, never as a raw Postgres 500");
+        ex.And.Message.Should().Contain(block.Id.ToString(), "the blocking row is named");
+        ex.And.Message.Should().Contain(topicId.ToString());
+        ex.And.Message.Should().Contain("T1");
+
+        (await s.Db.Periods.AnyAsync(p => p.Id == term.Id)).Should().BeTrue("nothing was deleted");
+    }
+
+    [TestMethod]
+    public async Task Delete_DraftYearWhoseSubPeriodCarriesABlock_Throws422_NamingTheBlock()
+    {
+        // The year delete cascades to its sub-periods, so the same RESTRICT fires for
+        // a block on a sub-period — the guard covers the cascade's target set too.
+        using var s = new StudentsTestScope("delguard-year");
+        await SeedGradeLevelAsync(s);
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        var block = SeedGradeBlock(s, Guid.NewGuid(), term.Id);
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewDelete(s).HandleAsync(new DeletePeriod(year.Id));
+
+        var ex = await act.Should().ThrowAsync<PeriodNotDeletableException>();
+        ex.And.Message.Should().Contain(block.Id.ToString());
+
+        (await s.Db.Periods.CountAsync()).Should().Be(2, "no partial deletion (NFR-D1)");
+    }
+
+    [TestMethod]
+    public async Task Delete_DraftPeriodWithoutBlocks_StillDeletes()
+    {
+        using var s = new StudentsTestScope("delguard-no-blocks");
+        await SeedGradeLevelAsync(s);
+        var topicId = Guid.NewGuid();
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        var otherTerm = SeedPeriod(s, "T2", D(2027, 1, 1), D(2027, 4, 30), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        // A block exists, but on a DIFFERENT period — the guard must not over-trigger.
+        SeedGradeBlock(s, topicId, otherTerm.Id);
+        await s.Db.SaveChangesAsync();
+
+        await NewDelete(s).HandleAsync(new DeletePeriod(term.Id));
+
+        (await s.Db.Periods.AnyAsync(p => p.Id == term.Id)).Should().BeFalse();
+        (await s.Db.SubjectEnrollmentBlocks.CountAsync()).Should().Be(1, "the other period's block is untouched");
+    }
+
+    [TestMethod]
+    public async Task Delete_NonDraftPeriodCarryingABlock_StillFailsTheDraftRule()
+    {
+        // Ordering: the Draft-only domain guard still wins — status is the primary rule.
+        using var s = new StudentsTestScope("delguard-nondraft");
+        await SeedGradeLevelAsync(s);
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        await s.Db.SaveChangesAsync();
+        SeedGradeBlock(s, Guid.NewGuid(), year.Id);
+        await s.Db.SaveChangesAsync();
+
+        var act = async () => await NewDelete(s).HandleAsync(new DeletePeriod(year.Id));
+
+        (await act.Should().ThrowAsync<PeriodNotDeletableException>())
+            .And.Message.Should().Contain("Only Draft periods can be deleted");
+    }
+}
