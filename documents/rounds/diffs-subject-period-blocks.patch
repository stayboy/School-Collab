+namespace SchoolCollab.Students.Core.DTOs;
+
+/// <summary>
+/// A subject enrollment block (subject-period-exception-model.md §2): the subject
+/// is <b>not</b> offered for <see cref="PeriodId"/>. <c>PeriodName</c>/<c>PeriodStatus</c>
+/// are projected alongside the ids because the UI must render period names (never
+/// GUID prefixes) and must mark a block whose period has since been archived while
+/// keeping it deletable (spec §5, AC-2).
+/// </summary>
+public sealed record SubjectEnrollmentBlockDto(
+    Guid Id,
+    Guid? GradeLevelId,
+    Guid? ActivityGroupId,
+    Guid TopicId,
+    Guid PeriodId,
+    string PeriodName,
+    string PeriodStatus,
+    string? Reason,
+    DateTimeOffset CreatedAt,
+    DateTimeOffset UpdatedAt);
diff --git a/src/Students/SchoolCollab.Students.Core/Data/Configurations/SubjectEnrollmentBlockConfiguration.cs b/src/Students/SchoolCollab.Students.Core/Data/Configurations/SubjectEnrollmentBlockConfiguration.cs
new file mode 100644
index 00000000..0b64b510
--- /dev/null
+++ b/src/Students/SchoolCollab.Students.Core/Data/Configurations/SubjectEnrollmentBlockConfiguration.cs
@@ -0,0 +1,79 @@
+using System.Linq.Expressions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+using SchoolCollab.Core.Data;
+using SchoolCollab.Students.Core.Domain;
+
+namespace SchoolCollab.Students.Core.Data.Configurations;
+
+/// <summary>
+/// Strict tenant-scoped subject enrollment block (subject-period-exception-model.md
+/// §2/§8 Q3). Soft-deleted (so the reason a subject was unavailable survives) and
+/// carrying the PostgreSQL <c>xmin</c> row version.
+///
+/// <para>Two composite filtered unique indexes enforce one block per
+/// (tenant, owner, topic, period). Each filter merges the owner-not-null predicate
+/// with the soft-delete exclusion into ONE string — without the
+/// <c>is_deleted = false</c> half, removing a block and re-adding the same one
+/// collides on the unique index (merged-filter precedent:
+/// <c>20260826180912_AddActivePeriodUniqueIndexes.cs</c>).</para>
+/// </summary>
+internal sealed class SubjectEnrollmentBlockConfiguration
+    : TenantEntityTypeConfigurationBase<SubjectEnrollmentBlock>
+{
+    public SubjectEnrollmentBlockConfiguration(Expression<Func<Guid>> tenantIdAccessor)
+        : base(tenantIdAccessor) { }
+
+    protected override void ConfigureTenantEntity(EntityTypeBuilder<SubjectEnrollmentBlock> builder)
+    {
+        builder.ToTable("subject_enrollment_blocks");
+
+        builder.ConfigureAuditProperties();
+        builder.ConfigureSoftDeleteProperties();
+        builder.ConfigureSoftDeleteQueryFilter();
+        builder.ConfigurePostgresRowVersion();
+
+        builder.Property(x => x.GradeLevelId);
+        builder.Property(x => x.ActivityGroupId);
+        builder.Property(x => x.TopicId).IsRequired();
+        builder.Property(x => x.PeriodId).IsRequired();
+        builder.Property(x => x.Reason);
+
+        // A block dies with its grade / activity group / topic.
+        builder.HasOne<GradeLevel>()
+            .WithMany()
+            .HasForeignKey(x => x.GradeLevelId)
+            .IsRequired(false)
+            .OnDelete(DeleteBehavior.Cascade);
+
+        builder.HasOne<ActivityGroup>()
+            .WithMany()
+            .HasForeignKey(x => x.ActivityGroupId)
+            .IsRequired(false)
+            .OnDelete(DeleteBehavior.Cascade);
+
+        builder.HasOne<Topic>()
+            .WithMany()
+            .HasForeignKey(x => x.TopicId)
+            .OnDelete(DeleteBehavior.Cascade);
+
+        // RESTRICT: a block must never be orphaned by deleting its period. The
+        // Draft-only delete rule alone would not suffice — see the §4.2 note in the
+        // spec (a Draft period MAY carry a block), and DeletePeriodHandler raises
+        // the 422 before this FK can fire (P2-10).
+        builder.HasOne<Period>()
+            .WithMany()
+            .HasForeignKey(x => x.PeriodId)
+            .OnDelete(DeleteBehavior.Restrict);
+
+        builder.HasIndex(x => new { x.TenantId, x.GradeLevelId, x.TopicId, x.PeriodId })
+            .IsUnique()
+            .HasDatabaseName("ix_subject_enrollment_blocks_tenant_grade_topic_period")
+            .HasFilter("grade_level_id IS NOT NULL AND is_deleted = false");
+
+        builder.HasIndex(x => new { x.TenantId, x.ActivityGroupId, x.TopicId, x.PeriodId })
+            .IsUnique()
+            .HasDatabaseName("ix_subject_enrollment_blocks_tenant_group_topic_period")
+            .HasFilter("activity_group_id IS NOT NULL AND is_deleted = false");
+    }
+}
