@@ -0,0 +1,94 @@
+using SchoolCollab.Core.Data;
+using SchoolCollab.Core.Tenancy;
+
+namespace SchoolCollab.Students.Core.Domain;
+
+/// <summary>
+/// A subject (topic) is <b>blocked</b> from enrollment/assignment for <b>ONE</b>
+/// specific period (subject-period-exception-model.md §2). The absence of a block
+/// is the normal, expected state: a bridge row
+/// (<see cref="GradeTopicAssignment"/> / <see cref="ActivityGroupTopicAssignment"/>)
+/// means the subject is offered, and a block is the explicit exception
+/// ("teacher on leave in Term 3").
+///
+/// <para>This replaces the retired <see cref="TopicAssignment.PeriodId"/>
+/// whitelist: the bridge carries no period meaning any more, so year rollover and
+/// period archival are inert — nothing on the bridge goes stale.</para>
+///
+/// <para>There is deliberately <b>no</b> status/lifecycle column: a block is
+/// immutable history. Un-blocking soft-deletes the row (this type derives from
+/// <see cref="BaseTenantEntityWithAudit"/>, which supplies <c>is_deleted</c> plus
+/// the audit stamps, and implements <see cref="IHasRowVersion"/> for PostgreSQL
+/// <c>xmin</c>). A block whose period is later archived is inert, never invalid —
+/// it stays visible for reporting and remains deletable.</para>
+/// </summary>
+public sealed class SubjectEnrollmentBlock : BaseTenantEntityWithAudit, IHasRowVersion
+{
+    private SubjectEnrollmentBlock() { }
+
+    /// <summary>Grade-owned block. Mutually exclusive with <see cref="ActivityGroupId"/>.</summary>
+    public Guid? GradeLevelId { get; private set; }
+
+    /// <summary>Group-owned block. Mutually exclusive with <see cref="GradeLevelId"/>.</summary>
+    public Guid? ActivityGroupId { get; private set; }
+
+    /// <summary>The shared, global topic (subject) this block applies to.</summary>
+    public Guid TopicId { get; private set; }
+
+    /// <summary>
+    /// REQUIRED. A block with no period is meaningless — "no period" <i>is</i> the
+    /// default (available) state, so the nullable whitelist case has no analogue.
+    /// </summary>
+    public Guid PeriodId { get; private set; }
+
+    /// <summary>Optional free text, e.g. "teacher on leave". Never load-bearing.</summary>
+    public string? Reason { get; private set; }
+
+    /// <summary>PostgreSQL <c>xmin</c> row version (optimistic concurrency).</summary>
+    public uint RowVersion { get; private set; }
+
+    /// <summary>
+    /// Creates a block. Exactly one of <paramref name="gradeLevelId"/> /
+    /// <paramref name="activityGroupId"/> must be supplied (mirrors the bridge
+    /// rule) and <paramref name="periodId"/> is required.
+    /// </summary>
+    public static SubjectEnrollmentBlock Create(
+        Guid tenantId,
+        Guid? gradeLevelId,
+        Guid? activityGroupId,
+        Guid topicId,
+        Guid periodId,
+        string? reason = null)
+    {
+        var hasGrade = gradeLevelId is not null;
+        var hasGroup = activityGroupId is not null;
+        if (hasGrade == hasGroup)
+        {
+            throw new ArgumentException(
+                "A subject enrollment block must target exactly one owner: either a grade level or an activity group.",
+                hasGrade ? nameof(activityGroupId) : nameof(gradeLevelId));
+        }
+
+        if (topicId == Guid.Empty)
+            throw new ArgumentException("A subject enrollment block requires a topic.", nameof(topicId));
+
+        if (periodId == Guid.Empty)
+            throw new ArgumentException(
+                "A subject enrollment block requires a period: a block with no period has no meaning — \"no period\" is the available state.",
+                nameof(periodId));
+
+        var now = DateTimeOffset.UtcNow;
+        return new SubjectEnrollmentBlock
+        {
+            Id = Guid.NewGuid(),
+            TenantId = tenantId,
+            GradeLevelId = gradeLevelId,
+            ActivityGroupId = activityGroupId,
+            TopicId = topicId,
+            PeriodId = periodId,
+            Reason = string.IsNullOrWhiteSpace(reason) ? null : reason.Trim(),
+            CreatedAt = now,
+            UpdatedAt = now,
+        };
+    }
+}
