+using FluentAssertions;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Commands.RemoveSubjectBlock;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Queries.ListSubjectBlocks;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments.Queries.ListActivityGroupTopicAssignments;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments.Queries.ListGradeTopicAssignments;
+using SchoolCollab.Students.Core.CQRS.TopicAssignments.Queries.ListGradeTopicCurriculumByGrade;
+using SchoolCollab.Students.Core.Data.Repositories;
+using SchoolCollab.Students.Core.Domain;
+
+namespace SchoolCollab.Students.Tests.Unit;
+
+/// <summary>
+/// Availability semantics of the block model (subject-period-exception-model.md §2):
+/// <c>available = EXISTS bridge AND NOT EXISTS block(owner, topic, active period)</c>,
+/// plus the AC-1 rollover regression guard and AC-2 (a block on a retired period
+/// stays listable and deletable).
+///
+/// <para>Mutation note (M1 → AC-6): deleting the <c>!blockedTopicIds.Contains(...)</c>
+/// filter from <c>ListGradeTopicAssignmentsHandler</c> /
+/// <c>ListActivityGroupTopicAssignmentsHandler</c> /
+/// <c>ListGradeTopicCurriculumByGradeHandler</c> (or the block query in
+/// <c>SubjectAvailability</c>) must fail the <c>*_IsNotAvailable</c> tests below.</para>
+/// </summary>
+[TestClass]
+public class SubjectAvailabilityTests
+{
+    private static DateOnly Today() => DateOnly.FromDateTime(DateTime.UtcNow);
+
+    private static DateOnly D(int y, int m, int d) => new(y, m, d);
+
+    private static Guid CurrentTenantId(StudentsTestScope s) => s.Tenants.GetTenantContext().TenantId;
+
+    private static ListGradeTopicAssignmentsHandler NewGradeHandler(StudentsTestScope s, StubActivePeriodProvider periods) =>
+        new(s.Db, s.Cache, periods);
+
+    private static ListActivityGroupTopicAssignmentsHandler NewGroupHandler(StudentsTestScope s, StubActivePeriodProvider periods) =>
+        new(s.Db, s.Cache, periods);
+
+    private static ListGradeTopicCurriculumByGradeHandler NewCurriculumHandler(StudentsTestScope s, StubActivePeriodProvider periods) =>
+        new(s.Db, s.Cache, periods);
+
+    private static Period SeedPeriod(
+        StudentsTestScope s, string name, DateOnly start, DateOnly end,
+        AcademicYearDivision division, Guid? parent = null)
+    {
+        var period = Period.Create(name, start, end, division, parent);
+        ((ITenantEntity)period).TenantId = CurrentTenantId(s);
+        s.Db.Periods.Add(period);
+        return period;
+    }
+
+    private static async Task<(Guid gradeId, Guid topicId)> SeedGradeAndTopicAsync(StudentsTestScope s)
+    {
+        var gradeLevel = GradeLevel.Create(Guid.NewGuid(), 1, "Grade 1", 1);
+        s.Db.GradeLevels.Add(gradeLevel);
+        var topic = Topic.Create(Guid.NewGuid(), "MATH", "Mathematics", 1);
+        s.Db.Topics.Add(topic);
+        await s.Db.SaveChangesAsync();
+        return (gradeLevel.Id, topic.Id);
+    }
+
+    private static async Task SeedGradeBridgeAsync(StudentsTestScope s, Guid gradeId, Guid topicId, DateOnly start)
+    {
+        s.Db.GradeTopicAssignments.Add(GradeTopicAssignment.Create(gradeId, topicId, start));
+        await s.Db.SaveChangesAsync();
+    }
+
+    private static async Task SeedGroupBridgeAsync(StudentsTestScope s, Guid groupId, Guid topicId, DateOnly start)
+    {
+        s.Db.ActivityGroupTopicAssignments.Add(ActivityGroupTopicAssignment.Create(groupId, topicId, start));
+        await s.Db.SaveChangesAsync();
+    }
+
+    private static SubjectEnrollmentBlock SeedGradeBlock(
+        StudentsTestScope s, Guid gradeId, Guid topicId, Guid periodId, string? reason = null)
+    {
+        var block = SubjectEnrollmentBlock.Create(CurrentTenantId(s), gradeId, null, topicId, periodId, reason);
+        s.Db.SubjectEnrollmentBlocks.Add(block);
+        return block;
+    }
+
+    private static SubjectEnrollmentBlock SeedGroupBlock(
+        StudentsTestScope s, Guid groupId, Guid topicId, Guid periodId)
+    {
+        var block = SubjectEnrollmentBlock.Create(CurrentTenantId(s), null, groupId, topicId, periodId);
+        s.Db.SubjectEnrollmentBlocks.Add(block);
+        return block;
+    }
+
+    private static async Task<Guid[]> GradeAvailabilityAsync(
+        StudentsTestScope s, StubActivePeriodProvider periods, Guid gradeId) =>
+        (await NewGradeHandler(s, periods).HandleAsync(new ListGradeTopicAssignments(gradeId, Today())))
+        .Select(a => a.TopicId)
+        .ToArray();
+
+    // ── The three availability cases ──────────────────────────────────────────
+
+    [TestMethod]
+    public async Task GradeTopic_BridgeExists_NoBlock_IsAvailable()
+    {
+        using var s = new StudentsTestScope("avail-bridge-only");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        await SeedGradeBridgeAsync(s, gradeId, topicId, Today());
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year) };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().Contain(topicId);
+    }
+
+    [TestMethod]
+    public async Task GradeTopic_BlockedOnActiveAcademicYear_IsNotAvailable()
+    {
+        using var s = new StudentsTestScope("avail-block-year");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        await SeedGradeBridgeAsync(s, gradeId, topicId, Today());
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        SeedGradeBlock(s, gradeId, topicId, year.Id, "teacher on leave");
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year) };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().BeEmpty("M1: a block on the active period hides the subject");
+        (await NewCurriculumHandler(s, periods)
+            .HandleAsync(new ListGradeTopicCurriculumByGrade(gradeId, Today())))
+            .Should().BeEmpty("the curriculum view applies the same block predicate");
+    }
+
+    [TestMethod]
+    public async Task GradeTopic_BlockedOnActiveSubPeriod_IsNotAvailable()
+    {
+        using var s = new StudentsTestScope("avail-block-term");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        await SeedGradeBridgeAsync(s, gradeId, topicId, Today());
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        term.Activate();
+        // A block on the ACTIVE TERM — the "block this subject for Term 3" case.
+        SeedGradeBlock(s, gradeId, topicId, term.Id);
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider
+        {
+            ActiveYear = StubActivePeriodProvider.For(year),
+            ActiveSubPeriod = StubActivePeriodProvider.For(term),
+        };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task GradeTopic_BlockedOnANonActivePeriod_IsStillAvailable()
+    {
+        using var s = new StudentsTestScope("avail-block-other");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        await SeedGradeBridgeAsync(s, gradeId, topicId, Today());
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        var otherTerm = SeedPeriod(s, "T2", D(2027, 1, 1), D(2027, 4, 30), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        term.Activate();
+        SeedGradeBlock(s, gradeId, topicId, otherTerm.Id);
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider
+        {
+            ActiveYear = StubActivePeriodProvider.For(year),
+            ActiveSubPeriod = StubActivePeriodProvider.For(term),
+        };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().Contain(topicId,
+            "a block on a different period does not hide the subject now");
+    }
+
+    [TestMethod]
+    public async Task GradeTopic_NoBridge_IsNotAvailable_RegardlessOfBlocks()
+    {
+        using var s = new StudentsTestScope("avail-no-bridge");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year) };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().BeEmpty("no bridge = not available");
+
+        SeedGradeBlock(s, gradeId, topicId, year.Id);
+        await s.Db.SaveChangesAsync();
+        await s.Cache.RemoveByTagAsync("students");
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().BeEmpty("still not available, with or without a block");
+    }
+
+    [TestMethod]
+    public async Task GroupTopic_BlockedOnActiveSubPeriod_IsNotAvailable()
+    {
+        using var s = new StudentsTestScope("avail-group-term");
+        var (_, topicId) = await SeedGradeAndTopicAsync(s);
+        var group = ActivityGroup.Create("Term Club", span: EnrollmentSpan.Termly);
+        s.Db.ActivityGroups.Add(group);
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var term = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, year.Id);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        term.Activate();
+        await SeedGroupBridgeAsync(s, group.Id, topicId, Today());
+        SeedGroupBlock(s, group.Id, topicId, term.Id);
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider
+        {
+            ActiveYear = StubActivePeriodProvider.For(year),
+            ActiveSubPeriod = StubActivePeriodProvider.For(term),
+        };
+
+        var result = await NewGroupHandler(s, periods)
+            .HandleAsync(new ListActivityGroupTopicAssignments(group.Id, Today()));
+
+        result.Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task GradeTopic_AfterUnblock_IsAvailableAgain()
+    {
+        using var s = new StudentsTestScope("avail-unblock");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        await SeedGradeBridgeAsync(s, gradeId, topicId, Today());
+        var year = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        year.Activate();
+        var block = SeedGradeBlock(s, gradeId, topicId, year.Id);
+        await s.Db.SaveChangesAsync();
+        var periods = new StubActivePeriodProvider { ActiveYear = StubActivePeriodProvider.For(year) };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().BeEmpty();
+
+        await new RemoveSubjectBlockHandler(
+                new SubjectEnrollmentBlockRepository(s.Db), s.Cache, NullLogger<RemoveSubjectBlockHandler>.Instance)
+            .HandleAsync(new RemoveSubjectBlock(block.Id));
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().Contain(topicId);
+    }
+
+    // ── AC-1: post-round rollover regression guard (passes pre-round by design) ──
+
+    [TestMethod]
+    public async Task GradeTopic_WithNoBlockAfterYearRollover_StaysAvailable()
+    {
+        // The prior year's terms are Archived and a NEW academic year is active. The
+        // bridge row is period-less (the whole point of the inversion), so nothing
+        // goes stale: the subject is still offered.
+        using var s = new StudentsTestScope("avail-rollover");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        await SeedGradeBridgeAsync(s, gradeId, topicId, Today());
+
+        var oldYear = SeedPeriod(s, "AY2025", D(2025, 9, 1), D(2026, 8, 31), AcademicYearDivision.Terms);
+        var oldTerm = SeedPeriod(s, "T1", D(2025, 9, 1), D(2025, 12, 31), AcademicYearDivision.Terms, oldYear.Id);
+        var newYear = SeedPeriod(s, "AY2026", D(2026, 9, 1), D(2027, 8, 31), AcademicYearDivision.Terms);
+        var newTerm = SeedPeriod(s, "T1", D(2026, 9, 1), D(2026, 12, 31), AcademicYearDivision.Terms, newYear.Id);
+        await s.Db.SaveChangesAsync();
+
+        oldYear.Activate();
+        oldTerm.Activate();
+        oldTerm.Archive();
+        oldYear.Archive();
+        newYear.Activate();
+        newTerm.Activate();
+        await s.Db.SaveChangesAsync();
+
+        var periods = new StubActivePeriodProvider
+        {
+            ActiveYear = StubActivePeriodProvider.For(newYear),
+            ActiveSubPeriod = StubActivePeriodProvider.For(newTerm),
+        };
+
+        (await GradeAvailabilityAsync(s, periods, gradeId)).Should().Contain(topicId,
+            "AC-1: rollover is a no-op — no period is attached to the subject↔grade link");
+        (await NewCurriculumHandler(s, periods)
+            .HandleAsync(new ListGradeTopicCurriculumByGrade(gradeId, Today())))
+            .Select(x => x.TopicId).Should().Contain(topicId);
+    }
+
+    // ── AC-2: a block on a retired period stays listable AND deletable ────────
+
+    [TestMethod]
+    public async Task BlockOnArchivedPeriod_StaysListable_AndDeletable()
+    {
+        using var s = new StudentsTestScope("avail-archived-block");
+        var (gradeId, topicId) = await SeedGradeAndTopicAsync(s);
+        var archived = SeedPeriod(s, "AY2025", D(2025, 9, 1), D(2026, 8, 31), AcademicYearDivision.None);
+        await s.Db.SaveChangesAsync();
+        archived.Activate();
+        archived.Archive();
+        // Seeded directly: the block predates the archival (BlockSubject would reject
+        // an Archived period — AC-3), and the row must never be invalidated by it.
+        var block = SeedGradeBlock(s, gradeId, topicId, archived.Id, "historical exception");
+        await s.Db.SaveChangesAsync();
+
+        var listed = await new ListSubjectBlocksHandler(new SubjectEnrollmentBlockRepository(s.Db))
+            .HandleAsync(new ListSubjectBlocks(gradeId, null));
+
+        var row = listed.Should().ContainSingle(x => x.Id == block.Id).Which;
+        row.PeriodStatus.Should().Be("Archived", "the UI marks a retired-period block read-only");
+        row.PeriodName.Should().Be("AY2025", "period names, never GUID prefixes (FR-ED-15)");
+        row.Reason.Should().Be("historical exception");
+
+        await new RemoveSubjectBlockHandler(
+                new SubjectEnrollmentBlockRepository(s.Db), s.Cache, NullLogger<RemoveSubjectBlockHandler>.Instance)
+            .HandleAsync(new RemoveSubjectBlock(block.Id));
+
+        (await new ListSubjectBlocksHandler(new SubjectEnrollmentBlockRepository(s.Db))
+            .HandleAsync(new ListSubjectBlocks(gradeId, null)))
+            .Should().BeEmpty("the archived-period block stays deletable (AC-2)");
+    }
+}
