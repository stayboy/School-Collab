diff --git a/src/Students/SchoolCollab.Students.Core/CQRS/TopicAssignments/SubjectAvailability.cs b/src/Students/SchoolCollab.Students.Core/CQRS/TopicAssignments/SubjectAvailability.cs
new file mode 100644
