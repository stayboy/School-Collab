@@ -0,0 +1,40 @@
+using SchoolCollab.Core.Tenancy;
+
+namespace SchoolCollab.Students.Tests.Unit;
+
+/// <summary>
+/// Minimal settable <see cref="IActivePeriodProvider"/> for handler tests. The
+/// three cached availability readers resolve the tenant's active period for their
+/// block predicate and their cache key, and a test must be able to switch the
+/// active period WITHOUT evicting the availability cache (the production cache
+/// invalidation path, <c>RemoveByTagAsync("students")</c>, would wipe the very
+/// entry the cache-key assertion needs to observe).
+/// </summary>
+internal sealed class StubActivePeriodProvider : IActivePeriodProvider
+{
+    public ActivePeriod? ActiveYear { get; set; }
+
+    public ActivePeriod? ActiveSubPeriod { get; set; }
+
+    public static ActivePeriod For(Core.Domain.Period period) => new(
+        period.Id,
+        period.Name,
+        period.StartDate,
+        period.EndDate,
+        period.Status.ToString(),
+        period.ParentPeriodId is null ? "AcademicYear" : "Term",
+        period.ParentPeriodId,
+        period.Division.ToString());
+
+    public Task<ActivePeriod?> GetActivePeriodAsync(CancellationToken ct = default) =>
+        Task.FromResult(ActiveYear);
+
+    public Task<ActivePeriod?> GetActiveAcademicYearAsync(CancellationToken ct = default) =>
+        Task.FromResult(ActiveYear);
+
+    public Task<ActivePeriod?> GetActiveSubPeriodAsync(CancellationToken ct = default) =>
+        Task.FromResult(ActiveSubPeriod);
+
+    public Task<ActivePeriod?> GetCurrentPeriodAsync(CancellationToken ct = default) =>
+        Task.FromResult(ActiveSubPeriod ?? ActiveYear);
+}
