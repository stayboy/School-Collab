@@ -0,0 +1,71 @@
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Routing;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Commands.BlockSubject;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Commands.RemoveSubjectBlock;
+using SchoolCollab.Students.Core.CQRS.SubjectEnrollmentBlocks.Queries.ListSubjectBlocks;
+using SchoolCollab.Students.Core.Domain.Exceptions;
+
+namespace SchoolCollab.Students.Api.Endpoints;
+
+/// <summary>
+/// Subject period exceptions (subject-period-exception-model.md §6): a block makes
+/// an otherwise-assigned subject unavailable for ONE period. Routes are grouped on
+/// the <c>/students</c> group (see <see cref="StudentEndpoints"/>) and therefore
+/// inherit its OIDC-gated <c>RequireAuthorization</c> — never map a fresh
+/// <c>/students</c> group in <c>Program.cs</c>.
+/// </summary>
+public static class SubjectBlockRoutes
+{
+    public static RouteGroupBuilder MapSubjectBlockRoutes(this RouteGroupBuilder group)
+    {
+        // List blocks for one owner. The narrow form (topicId + periodId) answers
+        // "is this subject blocked in this period" for the pickers.
+        group.MapGet("/subject-blocks", async (
+            Guid? gradeLevelId,
+            Guid? activityGroupId,
+            Guid? topicId,
+            Guid? periodId,
+            [FromServices] SchoolCollab.Core.CQRS.IQueryHandler<ListSubjectBlocks, SchoolCollab.Students.Core.DTOs.SubjectEnrollmentBlockDto[]> handler,
+            CancellationToken ct) =>
+        {
+            if ((gradeLevelId is null) == (activityGroupId is null))
+            {
+                return Results.BadRequest(new
+                {
+                    message = "Listing subject blocks requires exactly one owner filter: gradeLevelId or activityGroupId."
+                });
+            }
+
+            return Results.Ok(await handler.HandleAsync(
+                new ListSubjectBlocks(gradeLevelId, activityGroupId, topicId, periodId), ct));
+        });
+
+        group.MapPost("/subject-blocks", async (
+            [FromBody] BlockSubject command,
+            [FromServices] SchoolCollab.Core.CQRS.ICommandHandler<BlockSubject, Guid> handler,
+            CancellationToken ct) =>
+        {
+            try
+            {
+                var id = await handler.HandleAsync(command, ct);
+                return Results.Created($"/students/subject-blocks/{id}", new { id });
+            }
+            catch (GradeLevelNotFoundException) { return Results.NotFound(); }
+            catch (ActivityGroupNotFoundException) { return Results.NotFound(); }
+            catch (TopicAssignmentPeriodException ex) { return Results.Json(new { ex.Message }, statusCode: 422); }
+            catch (DuplicateSubjectBlockException ex) { return Results.Conflict(new { ex.Message }); }
+        });
+
+        // Idempotent removal: an unknown or already-removed id is a 204.
+        group.MapDelete("/subject-blocks/{id:guid}", async (
+            Guid id,
+            [FromServices] SchoolCollab.Core.CQRS.ICommandHandler<RemoveSubjectBlock> handler,
+            CancellationToken ct) =>
+        {
+            await handler.HandleAsync(new RemoveSubjectBlock(id), ct);
+            return Results.NoContent();
+        });
+
+        return group;
+    }
+}
