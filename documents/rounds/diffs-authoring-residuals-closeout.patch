diff --git a/tests/SchoolCollab.Assignments.Tests.Integration/LinkAssignmentGroupsRollbackPostgresTests.cs b/tests/SchoolCollab.Assignments.Tests.Integration/LinkAssignmentGroupsRollbackPostgresTests.cs
