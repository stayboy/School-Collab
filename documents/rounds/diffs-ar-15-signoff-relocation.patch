+                HttpMethod.Post,
+                $"/guardian/assignments/{AssignmentId}/students/{StudentId}/sign-off")
+            {
+                Content = JsonContent.Create(new GuardianSignOffSubmissionRequest(SignatureTypeDto.Click),
