diff --git a/src/Settings/SchoolCollab.Settings.Application/Components/Pages/AssignmentAiPrompt.razor b/src/Settings/SchoolCollab.Settings.Application/Components/Pages/AssignmentAiPrompt.razor
new file mode 100644
