+using FluentAssertions;
+using Microsoft.EntityFrameworkCore;
+using SchoolCollab.Core.Tenancy;
+using SchoolCollab.Settings.Core.CQRS.AssignmentAiPrompts.Commands.UpsertTenantAssignmentAiPrompt;
