diff --git a/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetNotificationFailures/GetNotificationFailures.cs b/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetNotificationFailures/GetNotificationFailures.cs
