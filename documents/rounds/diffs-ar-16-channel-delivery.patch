+
+        return Task.CompletedTask;
+    }
+}
diff --git a/src/Assignments/SchoolCollab.Assignments.Core/Services/Delivery/MailKitEmailSender.cs b/src/Assignments/SchoolCollab.Assignments.Core/Services/Delivery/MailKitEmailSender.cs
new file mode 100644
