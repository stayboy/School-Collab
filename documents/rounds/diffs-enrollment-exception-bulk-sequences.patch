diff --git a/tests/SchoolCollab.Students.Tests.Integration/PeriodSequenceAndExceptionOrdinalEndpointTests.cs b/tests/SchoolCollab.Students.Tests.Integration/PeriodSequenceAndExceptionOrdinalEndpointTests.cs
