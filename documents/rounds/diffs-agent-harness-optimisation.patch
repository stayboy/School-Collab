@@ -0,0 +1,126 @@
+#!/usr/bin/env bash
+# deliver.sh — the mechanical half of a round hand-over: stage an explicitly-named path set,
+# prove nothing else was staged, show the change set, commit, STOP.
+#
+# WHY THIS EXISTS
+#   A round's git leg is ~30 lines of brief repeated every time, and the brief is where the
+#   owner's gates live. This script carries only the mechanical part. It deliberately does
+#   **not** push, open a PR, or merge:
+#
+#     * push  — gated by the owner's word and by `.githooks/pre-push` (SCHOOLCOLLAB_ALLOW_PUSH=1)
+#     * PR    — the body is authored judgement (Summary / Evidence / Merge Danger), not mechanics
+#     * merge — a script cannot know whether the owner authorized it
+#
+#   What it does enforce, because these are the two ways round commits have gone wrong here:
+#     1. **Path allowlist** — nothing outside the named path set may be staged. Policy-layer
+#        files (`.pi/skills/**`, `AGENTS.md`, `documents/specs/**`) never ride a round commit
+#        (AGENTS.md L3), and a stray `git add -A` once pulled them in.
+#     2. **Named set is explicit** — no globs, no `-A`. Every path is expanded and shown.
+#
+# USAGE
+#   scripts/round/deliver.sh --message <file> [--check] -- <path> [<path> ...]
+#
+#   --message <file>  commit message file (subject on line 1)
+#   --check           stage + verify + print, then STOP before committing
+#
+# EXIT: 0 staged/committed cleanly; 2 usage error; 3 forbidden path; 4 nothing to commit.
+
+set -uo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$REPO_ROOT"
+
+RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BLUE=$'\033[0;34m'; NC=$'\033[0m'
+step() { printf '\n%s▶ %s%s\n' "$BLUE" "$1" "$NC"; }
+ok()   { printf '  %s✔ %s%s\n' "$GREEN" "$1" "$NC"; }
+bad()  { printf '  %s✖ %s%s\n' "$RED" "$1" "$NC"; }
+
+MESSAGE_FILE=""
+CHECK_ONLY=false
+PATHS=()
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --message) MESSAGE_FILE="$2"; shift 2 ;;
+        --check)   CHECK_ONLY=true; shift ;;
+        --)        shift; PATHS=("$@"); break ;;
+        -h|--help) sed -n '3,35p' "${BASH_SOURCE[0]}"; exit 0 ;;
+        *) echo "Unknown option: $1" >&2; exit 2 ;;
+    esac
+done
+
+[[ -n "$MESSAGE_FILE" && -f "$MESSAGE_FILE" ]] || { echo "--message <file> is required and must exist" >&2; exit 2; }
+[[ ${#PATHS[@]} -gt 0 ]] || { echo "No paths given after --" >&2; exit 2; }
+
+# --- Gate 1: never commit on the delivery branch -------------------------------------------
+BRANCH="$(git branch --show-current)"
+step "Branch"
+if [[ "$BRANCH" == "main" ]]; then
+    bad "on 'main' — round commits go to a feature/fix branch (AGENTS.md merge policy)"
+    exit 3
+fi
+ok "$BRANCH"
+
+# --- Gate 2: expand the named set, then prove the staged set is a subset --------------------
+step "Expanding the named path set"
+EXPECTED="$(mktemp)"; STAGED="$(mktemp)"
+trap 'rm -f "$EXPECTED" "$STAGED"' EXIT
+
+for p in "${PATHS[@]}"; do
+    if [[ -d "$p" ]]; then
+        git ls-files -- "$p" >>"$EXPECTED"
+        git ls-files --others --exclude-standard -- "$p" >>"$EXPECTED"
+    elif [[ -f "$p" ]]; then
+        printf '%s\n' "$p" >>"$EXPECTED"
+    else
+        bad "no such path: $p"; exit 2
+    fi
+done
+sort -u -o "$EXPECTED" "$EXPECTED"
+ok "$(wc -l <"$EXPECTED" | tr -d ' ') path(s) named"
+
+git add -A -- "${PATHS[@]}"
+git diff --cached --name-only | sort -u >"$STAGED"
+
+step "Staged-vs-named diff (must be empty)"
+EXTRA="$(comm -13 "$EXPECTED" "$STAGED")"
+if [[ -n "$EXTRA" ]]; then
+    bad "staged but NOT in the named set:"
+    printf '%s\n' "$EXTRA"
+    exit 3
+fi
+ok "nothing staged outside the named set"
+
+step "Policy-layer exclusion (AGENTS.md L3)"
+FORBIDDEN="$(grep -E '^(\.pi/skills/|AGENTS\.md$|documents/specs/|\.githooks/|\.github/copilot/)' "$STAGED" || true)"
+if [[ -n "$FORBIDDEN" ]]; then
+    bad "policy-layer paths are staged — remove them (their own PR carries them):"
+    printf '%s\n' "$FORBIDDEN"
+    exit 3
+fi
+ok "no policy-layer paths"
+
+# --- Show the change set -------------------------------------------------------------------
+step "Change set"
+git diff --cached --stat | tail -20
+printf '  %s files\n' "$(wc -l <"$STAGED" | tr -d ' ')"
+
+if git diff --cached --quiet; then
+    bad "nothing to commit"; exit 4
+fi
+
+if [[ "$CHECK_ONLY" == true ]]; then
+    step "STOP (--check)"
+    printf '  staged, verified, not committed\n'
+    exit 0
+fi
+
+# --- Commit, then stop ---------------------------------------------------------------------
+step "Commit"
+git commit -F "$MESSAGE_FILE"
+ok "committed $(git rev-parse --short HEAD)"
+
+step "STOP — deliberately not done here"
+printf '  push    → owner word + SCHOOLCOLLAB_ALLOW_PUSH=1 git push -u origin %s\n' "$BRANCH"
+printf '  PR      → authored body, then gh pr create / gh stack submit\n'
+printf '  merge   → owner word only\n'
+exit 0
diff --git a/scripts/round/gates.sh b/scripts/round/gates.sh
new file mode 100644
index 00000000..b52a3456
--- /dev/null
+++ b/scripts/round/gates.sh
@@ -0,0 +1,194 @@
+#!/usr/bin/env bash
+# gates.sh — the CI-parity local gate for a School-Collab round.
+#
+# WHY THIS EXISTS
+#   A per-project loop over a hand-picked subset of test projects is *false confidence*:
+#   `SchoolCollab.slnx` registers 13 `*.Tests.Unit` projects, CI also gates three
+#   `*.Tests.Integration` legs' worth of projects, the repo-wide `ArchitectureTests.Unit`
+#   scanner, a project-scoped `CrossModuleWiringTests` guard, and TWO Python portal suites —
+#   none of which a "six project" script would run. So this script mirrors CI's **filter
+#   legs verbatim** instead of enumerating projects, and prints what it did NOT check.
+#
+#   It also refuses to inherit CI's one dangerous tolerance blindly: CI passes
+#   `--ignore-exit-code 8` ("no tests ran"). Here that case is a **failure**, because the
+#   repo has already paid for this exact trap (`dotnet test | grep failed` prints
+#   `failed: 0` when zero tests ran).
+#
+# USAGE
+#   scripts/round/gates.sh [--no-maui] [--no-integration] [--no-portals]
+#
+#   --no-maui          skip the MAUI Blazor Hybrid head (adds it to "NOT checked")
+#   --no-integration   skip the Integration leg (adds it to "NOT checked")
+#   --no-portals       skip the two pytest legs (adds them to "NOT checked")
+#
+# EXIT: 0 only if every leg that ran passed AND every skipped leg was explicitly asked for.
+# The parity between this script and `.github/workflows/ci.yml` is pinned by
+# `tests/SchoolCollab.ArchitectureTests.Unit/LocalGateCiParityTests.cs` — edit both or neither.
+
+set -uo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$REPO_ROOT"
+
+RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BLUE=$'\033[0;34m'; NC=$'\033[0m'
+step() { printf '\n%s▶ %s%s\n' "$BLUE" "$1" "$NC"; }
+ok()   { printf '  %s✔ %s%s\n' "$GREEN" "$1" "$NC"; }
+warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$NC"; }
+bad()  { printf '  %s✖ %s%s\n' "$RED" "$1" "$NC"; }
+
+RUN_MAUI=true
+RUN_INTEGRATION=true
+RUN_PORTALS=true
+for arg in "$@"; do
+    case "$arg" in
+        --no-maui)        RUN_MAUI=false ;;
+        --no-integration) RUN_INTEGRATION=false ;;
+        --no-portals)     RUN_PORTALS=false ;;
+        -h|--help)        sed -n '3,30p' "${BASH_SOURCE[0]}"; exit 0 ;;
+        *) echo "Unknown option: $arg" >&2; exit 2 ;;
+    esac
+done
+
+FAILURES=()
+NOT_CHECKED=()
+LOG_DIR="$REPO_ROOT/test-results/gates"
+mkdir -p "$LOG_DIR"
+
+# run_leg <label> <log-name> <command...>
+# Runs a command, tees it to a log, and treats "Zero tests ran" as a FAILURE.
+run_leg() {
+    local label="$1" log="$2"; shift 2
+    step "$label"
+    if "$@" 2>&1 | tee "$LOG_DIR/$log.log"; then
+        if grep -qi "zero tests ran" "$LOG_DIR/$log.log"; then
+            bad "$label — zero tests ran (filter matched nothing; not a pass)"
+            FAILURES+=("$label (zero tests ran)")
+        else
+            ok "$label"
+        fi
+    else
+        bad "$label"
+        FAILURES+=("$label")
+    fi
+}
+
+# --- Leg 1: restore + build (ci.yml `build-and-test` job) -----------------------------------
+step "Restore"
+if dotnet restore >"$LOG_DIR/restore.log" 2>&1; then ok "restore"; else bad "restore"; FAILURES+=("restore"); fi
+
+step "Build (Release)"
+if dotnet build --no-restore --configuration Release 2>&1 | tee "$LOG_DIR/build.log" | tail -5; then
+    if grep -Eq '\b[1-9][0-9]* Error\(s\)' "$LOG_DIR/build.log"; then
+        bad "build reported errors"; FAILURES+=("build")
+    else
+        ok "build — 0 errors"
+    fi
+else
+    bad "build"; FAILURES+=("build")
+fi
+
+# --- Leg 2: unit tests (ci.yml `build-and-test` job) ----------------------------------------
+run_leg "Unit tests (filter: FullyQualifiedName~Tests.Unit)" "unit" \
+    dotnet test --no-build --configuration Release \
+    --filter "FullyQualifiedName~Tests.Unit" --ignore-exit-code 8 \
+    --report-trx --report-trx-filename unit-results.trx --results-directory ./test-results
+
+# --- Leg 3: integration tests (ci.yml `build-and-test` job) ---------------------------------
+# KNOWN LOCAL DIVERGENCE, named rather than hidden. ci.yml injects `OpenRouter__ApiKey` while the
+# live tests read `Parameters:openrouter-api-key` (user secrets / `Parameters__openrouter_api_key`),
+# so in CI they see no key and self-skip as Inconclusive. On a developer machine the key EXISTS,
+# so `ChatProviderLiveTests` runs for real against the pinned model, which currently answers
+# HTTP 400 (ci.yml's own note records this). Those two tests are therefore classified as a
+# documented divergence — and ONLY those two; any other integration failure still fails the gate.
+if [[ "$RUN_INTEGRATION" == true ]]; then
+    run_leg "Integration tests (filter: FullyQualifiedName~Tests.Integration)" "integration" \
+        dotnet test --no-build --configuration Release \
+        --filter "FullyQualifiedName~Tests.Integration" --ignore-exit-code 8 \
+        --report-trx --report-trx-filename integration-results.trx --results-directory ./test-results
+
+    if [[ " ${FAILURES[*]-} " == *"Integration tests"* ]]; then
+        OTHER_FAILURES="$(grep -E '^failed |^  failed ' "$LOG_DIR/integration.log" \
+            | grep -vE 'failed (OpenRouterClient_UsesApiKey_AuthenticatesSuccessfully|OpenRouterProvider_WithGoogleGemma4_RespondsToSimplePrompt)' \
+            | grep -vE '^integration ' || true)"
+        if [[ -z "$OTHER_FAILURES" ]]; then
+            warn "integration: the 2 OpenRouter live tests failed locally — CI self-skips them (no key)"
+            NOT_CHECKED+=("OpenRouter live tests (ChatProviderLiveTests) — CI skips them as Inconclusive; a machine with a key runs them for real and the pinned model answers HTTP 400")
+            # Reclassify: this leg is a documented divergence, not a gate failure.
+            KEPT=()
+            for f in "${FAILURES[@]}"; do
+                [[ "$f" == "Integration tests (filter: FullyQualifiedName~Tests.Integration)" ]] || KEPT+=("$f")
+            done
+            FAILURES=("${KEPT[@]:-}")
+            [[ -n "${FAILURES[*]-}" ]] || FAILURES=()
+        else
+            bad "integration: failures outside the documented divergence:"; printf '%s\n' "$OTHER_FAILURES"
+        fi
+    fi
+else
+    NOT_CHECKED+=("Integration tests (skipped by --no-integration)")
+fi
+
+# --- Leg 4: cross-module wiring guard (ci.yml `cross-module-wiring-guard` job) --------------
+step "Cross-module wiring guard"
+if dotnet restore tests/SchoolCollab.Core.Tests.Unit/SchoolCollab.Core.Tests.Unit.csproj >"$LOG_DIR/wiring-restore.log" 2>&1 \
+   && dotnet build tests/SchoolCollab.Core.Tests.Unit/SchoolCollab.Core.Tests.Unit.csproj --no-restore --configuration Release >"$LOG_DIR/wiring-build.log" 2>&1; then
+    run_leg "CrossModuleWiringTests" "wiring" \
+        dotnet test tests/SchoolCollab.Core.Tests.Unit/SchoolCollab.Core.Tests.Unit.csproj \
+        --no-build --configuration Release \
+        --filter "FullyQualifiedName~CrossModuleWiringTests"
+else
+    bad "cross-module wiring guard build"; FAILURES+=("cross-module wiring guard build")
+fi
+
+# --- Leg 5: MAUI head (NOT in SchoolCollab.slnx — a shared-component change is invisible) ---
+if [[ "$RUN_MAUI" == true ]]; then
+    step "MAUI Blazor Hybrid head (serial: -m:1 -p:BuildInParallel=false)"
+    if dotnet build src/Mobile/SchoolCollab.Mobile/SchoolCollab.Mobile.csproj \
+         -f net10.0-windows10.0.19041.0 -m:1 -p:BuildInParallel=false \
+         2>&1 | tee "$LOG_DIR/maui.log" | tail -5; then
+        if grep -Eq '\b[1-9][0-9]* Error\(s\)' "$LOG_DIR/maui.log"; then
+            bad "MAUI head reported errors"; FAILURES+=("MAUI head")
+        else
+            ok "MAUI head — 0 errors"
+        fi
+    else
+        bad "MAUI head"; FAILURES+=("MAUI head")
+    fi
+else
+    NOT_CHECKED+=("MAUI Blazor Hybrid head (skipped by --no-maui) — a shared-component break is invisible to the main solution")
+fi
+
+# --- Leg 6: Python portals (ci.yml `portals-python` + `authportal-python` jobs) ------------
+if [[ "$RUN_PORTALS" == true ]] && command -v uv >/dev/null 2>&1; then
+    for portal in SchoolCollab.Portals SchoolCollab.AuthPortal; do
+        step "$portal (pytest)"
+        if ( cd "src/$portal" && uv sync >/dev/null 2>&1 && uv run pytest ) 2>&1 | tee "$LOG_DIR/$portal.log" | tail -5; then
+            ok "$portal pytest"
+        else
+            bad "$portal pytest"; FAILURES+=("$portal pytest")
+        fi
+    done
+elif [[ "$RUN_PORTALS" == true ]]; then
+    NOT_CHECKED+=("Python portal suites (uv not installed) — run 'uv run pytest' in src/SchoolCollab.Portals and src/SchoolCollab.AuthPortal")
+else
+    NOT_CHECKED+=("Python portal suites (skipped by --no-portals)")
+fi
+
+# --- Report --------------------------------------------------------------------------------
+printf '\n%s══ NOT checked here (CI still gates these) ══%s\n' "$BLUE" "$NC"
+if [[ ${#NOT_CHECKED[@]} -eq 0 ]]; then
+    printf '  %s(nothing skipped — this run mirrors every CI leg)%s\n' "$GREEN" "$NC"
+else
+    printf '  %s⚠ %s%s\n' "$YELLOW" "${NOT_CHECKED[0]}" "$NC"
+    for n in "${NOT_CHECKED[@]:1}"; do printf '  %s⚠ %s%s\n' "$YELLOW" "$n" "$NC"; done
+fi
+
+if [[ ${#FAILURES[@]} -eq 0 ]]; then
+    printf '\n%s✅ gates.sh — every leg that ran is green%s\n'  "$GREEN" "$NC"
+    exit 0
+fi
+
+printf '\n%s✖ gates.sh — FAILED%s\n' "$RED" "$NC"
+for f in "${FAILURES[@]}"; do printf '  %s✖ %s%s\n' "$RED" "$f" "$NC"; done
+printf '  logs: %s\n' "$LOG_DIR"
+exit 1
diff --git a/tests/SchoolCollab.ArchitectureTests.Unit/LocalGateCiParityTests.cs b/tests/SchoolCollab.ArchitectureTests.Unit/LocalGateCiParityTests.cs
new file mode 100644
index 00000000..ddd20696
--- /dev/null
+++ b/tests/SchoolCollab.ArchitectureTests.Unit/LocalGateCiParityTests.cs
@@ -0,0 +1,127 @@
+using System.Text.RegularExpressions;
+using FluentAssertions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+
+namespace SchoolCollab.ArchitectureTests.Unit;
+
+/// <summary>
+/// Guards the local gate against drifting away from CI (optimisation round, grill Q103).
+/// <para>
+/// The failure this prevents is <b>false confidence</b>: a local script that loops over a
+/// hand-picked subset of test projects and then prints "green". The repo's solution registers 13
+/// <c>*.Tests.Unit</c> projects, and CI additionally gates an Integration leg, a project-scoped
+/// <c>CrossModuleWiringTests</c> guard, and two Python portal suites. So <c>gates.sh</c> mirrors
+/// CI's <b>filter legs</b>; this test fails if a leg is added to CI and not here, if the MAUI
+/// serial flags disappear, if the "NOT checked here" honesty list is removed, or if
+/// <c>preflight-pr.sh</c> grows a second, weaker definition of green.
+/// </para>
+/// </summary>
+[TestClass]
+public class LocalGateCiParityTests
+{
+    private static readonly Regex FilterPattern =
+        new(@"--filter\s+""(?<f>[^""]+)""", RegexOptions.Compiled);
+
+    private static string? FindRepoRoot()
+    {
+        var dir = new DirectoryInfo(AppContext.BaseDirectory);
+        while (dir is not null && !Directory.Exists(Path.Combine(dir.FullName, "src", "AppHost", "SchoolCollab.AppHost")))
+        {
+            dir = dir.Parent;
+        }
+
+        return dir?.FullName;
+    }
+
+    private static (string Root, string Ci, string Gates, string Preflight) Read()
+    {
+        var root = FindRepoRoot();
+        Assert.IsNotNull(root, "Could not locate the repository root from " + AppContext.BaseDirectory);
+
+        var ci = Path.Combine(root, ".github", "workflows", "ci.yml");
+        var gates = Path.Combine(root, "scripts", "round", "gates.sh");
+        var preflight = Path.Combine(root, "scripts", "preflight-pr.sh");
+
+        File.Exists(ci).Should().BeTrue($"{ci} must exist");
+        File.Exists(gates).Should().BeTrue($"{gates} must exist");
+        File.Exists(preflight).Should().BeTrue($"{preflight} must exist");
+
+        return (root, File.ReadAllText(ci), File.ReadAllText(gates), File.ReadAllText(preflight));
+    }
+
+    [TestMethod]
+    public void GatesScript_MirrorsEveryCiTestFilter()
+    {
+        var (_, ci, gates, _) = Read();
+
+        var ciFilters = FilterPattern.Matches(ci).Select(m => m.Groups["f"].Value).Distinct().ToArray();
+        var gateFilters = FilterPattern.Matches(gates).Select(m => m.Groups["f"].Value).Distinct().ToArray();
+
+        // Non-vacuity twice: a regex that matched nothing would make the comparison meaningless.
+        ciFilters.Should().NotBeEmpty("ci.yml must declare its test legs as --filter arguments");
+        gateFilters.Should().NotBeEmpty("scripts/round/gates.sh must mirror those legs");
+
+        var missing = ciFilters.Except(gateFilters).ToArray();
+        missing.Should().BeEmpty(
+            "every test leg CI runs must also run locally — a per-project subset drops the repo-wide " +
+            "architecture scanner, the Integration projects and the CrossModuleWiring guard");
+
+        var extra = gateFilters.Except(ciFilters).ToArray();
+        extra.Should().BeEmpty(
+            "gates.sh must not invent legs CI does not run (its green would then mean something different)");
+    }
+
+    [TestMethod]
+    public void GatesScript_RunsBothPythonPortalSuites()
+    {
+        var (_, ci, gates, _) = Read();
+
+        // The two portal suites contribute no .NET project, so `dotnet test` never sees them.
+        foreach (var portal in new[] { "SchoolCollab.Portals", "SchoolCollab.AuthPortal" })
+        {
+            ci.Should().Contain(portal, $"ci.yml gates {portal}");
+            gates.Should().Contain(portal,
+                $"{portal} is invisible to `dotnet test`; a local gate that skips it reports " +
+                "\"all green\" while two real CI jobs are unexamined");
+        }
+    }
+
+    [TestMethod]
+    public void GatesScript_CarriesTheMauiSerialFlags()
+    {
+        var (_, _, gates, _) = Read();
+
+        // AGENTS.md: the default parallel build exhausts memory on the dev machine and kills the
+        // agent process (~0xC0000409) instead of reporting a compile error. These flags are not optional.
+        gates.Should().Contain("-p:BuildInParallel=false",
+            "the MAUI head build must be serial or it can OOM-kill the gate it exists to speed up");
+        gates.Should().Contain("-m:1", "the MAUI head build must cap MSBuild at one node");
+        gates.Should().Contain("src/Mobile/SchoolCollab.Mobile/SchoolCollab.Mobile.csproj",
+            "the MAUI head is NOT in SchoolCollab.slnx — a shared-component break is invisible without it");
+    }
+
+    [TestMethod]
+    public void GatesScript_StatesWhatItDidNotCheck()
+    {
+        var (_, _, gates, _) = Read();
+
+        gates.Should().Contain("NOT checked here",
+            "the gate must name what it skipped (integration, portals, or the MAUI head) so a green " +
+            "local run is never mistaken for green CI — that is the whole reason this script exists");
+    }
+
+    [TestMethod]
+    public void PreflightScript_ReusesTheGateInsteadOfDefiningASecondOne()
+    {
+        var (_, _, _, preflight) = Read();
+
+        preflight.Should().Contain("scripts/round/gates.sh",
+            "preflight-pr.sh must call the shared gate; a second, weaker build/test leg in the same " +
+            "repo is a second definition of \"green\" and they will diverge");
+
+        // The old inline leg must be gone: one `dotnet build` per definition is the smell.
+        var inlineBuilds = Regex.Matches(preflight, @"^\s*dotnet build\b", RegexOptions.Multiline).Count;
+        inlineBuilds.Should().Be(0,
+            "preflight-pr.sh must not build inline any more — gates.sh owns the build/test legs");
+    }
+}
diff --git a/tests/SchoolCollab.ArchitectureTests.Unit/RunbookSymptomRouterTests.cs b/tests/SchoolCollab.ArchitectureTests.Unit/RunbookSymptomRouterTests.cs
new file mode 100644
index 00000000..e4be9779
--- /dev/null
+++ b/tests/SchoolCollab.ArchitectureTests.Unit/RunbookSymptomRouterTests.cs
@@ -0,0 +1,82 @@
+using FluentAssertions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+
+namespace SchoolCollab.ArchitectureTests.Unit;
+
+/// <summary>
+/// Guards the runbook router adopted in the optimisation round (grill Q102).
+/// <para>
+/// The router is deliberately <b>free</b>: an agent asks "which runbook covers this symptom?" by
+/// running <c>grep -l '^## Symptom' documents/runbooks/*.md</c>, and the filesystem is the index —
+/// no stored manifest to keep in sync. That only works if <b>every</b> runbook carries a
+/// <c>## Symptom</c> block: the convention existed in 1 of 4 runbooks when this was written, so a
+/// router built then would have invented content for the other three and reported itself correct.
+/// </para>
+/// <para>
+/// The guard is therefore one-directional and total (every runbook has the block), which is what
+/// the grep router needs. A stored <c>README</c> index was rejected precisely because it needs a
+/// <i>bidirectional</i> test — the second taxonomy the owner declined.
+/// </para>
+/// </summary>
+[TestClass]
+public class RunbookSymptomRouterTests
+{
+    private static string? FindRepoRoot()
+    {
+        var dir = new DirectoryInfo(AppContext.BaseDirectory);
+        while (dir is not null && !Directory.Exists(Path.Combine(dir.FullName, "src", "AppHost", "SchoolCollab.AppHost")))
+        {
+            dir = dir.Parent;
+        }
+
+        return dir?.FullName;
+    }
+
+    [TestMethod]
+    public void EveryRunbook_CarriesASymptomBlock_SoTheGrepRouterCannotLie()
+    {
+        var root = FindRepoRoot();
+        Assert.IsNotNull(root, "Could not locate the repository root from " + AppContext.BaseDirectory);
+
+        var runbookDir = Path.Combine(root, "documents", "runbooks");
+        Directory.Exists(runbookDir).Should().BeTrue($"{runbookDir} must exist");
+
+        var runbooks = Directory.GetFiles(runbookDir, "*.md", SearchOption.TopDirectoryOnly)
+            .OrderBy(f => f, StringComparer.Ordinal)
+            .ToArray();
+
+        // Non-vacuity: a router test that scans zero files passes for the wrong reason.
+        runbooks.Should().NotBeEmpty("the runbook folder must contain at least one runbook");
+
+        var missing = runbooks
+            .Where(f => !File.ReadLines(f).Any(line => line.TrimEnd() == "## Symptom"))
+            .Select(f => Path.GetFileName(f))
+            .ToArray();
+
+        missing.Should().BeEmpty(
+            "every runbook needs a '## Symptom' block — it is the only field the free router " +
+            "(`grep -l '^## Symptom' documents/runbooks/*.md`) can search, so a runbook without one " +
+            "is invisible to every future investigation");
+    }
+
+    [TestMethod]
+    public void TheGrepRouterItself_FindsEveryRunbook()
+    {
+        // Pins the *documented* discovery command to the same answer as the file scan above:
+        // if someone changes the heading (e.g. to '## Symptoms' or '## Symptom(s)'), the anchor
+        // in the skill and the runbooks' own headings must move together.
+        var root = FindRepoRoot();
+        Assert.IsNotNull(root, "Could not locate the repository root from " + AppContext.BaseDirectory);
+
+        var runbookDir = Path.Combine(root, "documents", "runbooks");
+        var anchored = Directory.GetFiles(runbookDir, "*.md", SearchOption.TopDirectoryOnly)
+            .Where(f => File.ReadLines(f).Any(line => line.StartsWith("## Symptom", StringComparison.Ordinal)))
+            .ToArray();
+
+        var all = Directory.GetFiles(runbookDir, "*.md", SearchOption.TopDirectoryOnly);
+
+        anchored.Should().HaveCount(all.Length,
+            "`grep -l '^## Symptom' documents/runbooks/*.md` must return every runbook — " +
+            "the router's anchor is a contract, not a formatting preference");
+    }
+}
