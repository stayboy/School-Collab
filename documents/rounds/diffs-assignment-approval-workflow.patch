+    public async Task Duplicate_WhilePending_IsExempt_ItIsTheEscapeHatch()
+    {
+        var (db, tenants) = InMemoryScope("hold-dup-" + Guid.NewGuid());
+        await using var _db = db;
+        var assignment = Pending();
+        db.Assignments.Add(assignment);
