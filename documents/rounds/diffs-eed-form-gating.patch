+        {
+            live.Add(ExceptionJson(Guid.NewGuid(), TopicId, "Terms", Term1Start, Term1End, ordinal: 1));
+            return $"{{\"ids\":[\"{Guid.NewGuid():D}\"]}}";
+        });
+
+        ArmAddForm(harness.Dialog);
