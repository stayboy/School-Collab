@@ -0,0 +1,768 @@
+@inherits DialogShellBase<EnrollmentExceptionsDialog.EnrollmentExceptionsModel, EnrollmentExceptionsDialog.EnrollmentExceptionsResult>
+@using System.Globalization
+@using SchoolCollab.Admin.Shared.Components
+@using SchoolCollab.Students.Application.Services
+@using SchoolCollab.Students.Core.Domain
+@using EnrollmentExceptionDto = SchoolCollab.Students.Core.DTOs.SubjectEnrollmentExceptionDto
+@inject StudentsApiClient Api
+@inject ILogger<EnrollmentExceptionsDialog> Logger
+@implements IDisposable
+
+@*  EnrollmentExceptionsDialog — the ONE place subject enrollment exceptions are edited
+    (subject-period-exception-model.md v8 §5.1). It replaces the retired
+    /students/enrollment-exceptions page: every other surface (the Topics landing, the
+    grade-detail Subjects card, the View-all dialog) only carries a count badge and a kebab
+    that opens THIS dialog (§5.2).
+
+    Shape (D5, owner decision 2026-09-29): the scope is LOCKED — one owner + one subject come
+    from the call site and render read-only. There is no owner toggle, no grade/subject filter
+    row and no "All subjects": that filter chrome is exactly what the dialog exists to delete,
+    and the dialog is opened per-subject by each call site.
+
+    D2: ONE dialog, two regions — the subject's exception list on top and the add form below,
+    both always visible. No mode swap, no SideDrawer. D3: the add form IS the shell's
+    EditForm (DialogShellBase), so the write rides the shared footer; a successful submit
+    returns null — the dialog STAYS OPEN, because it is a management surface, not a
+    single-shot form — after re-reading the list. Error is set only on failure.
+
+    D4 keeps the add-form logic of v6/v7 unchanged: the period part is CHOSEN as an academic
+    division ("Fill from"), only where the tenant can write it (FR-56 for a group owner,
+    "a period exists for it" for a grade), the position is a MULTI-select ladder of 1st–4th
+    plus any higher declared position writing one row per ticked sequence through
+    POST /students/enrollment-exceptions/bulk, a position the tenant has no period for renders
+    DISABLED, and the date range belongs to "Any date" alone.
+
+    An exception is a period PART (descriptive only, never matched against dates, §0
+    decision 9) plus a nullable date span, at least one bound. The span is ONE range whose open
+    ends read "(any start)" / "(any end)" (§0 decision 12, kept). Zero exceptions is the NORMAL
+    state, so the empty list is plain prose, not a warning (§5.4). D8: a rejected write shows the
+    SERVER's own sentence verbatim, which the client extracts from the 409/422 body.
+*@
+
+<div class="exceptions-dialog">
+    <section class="exceptions-section" aria-label="Enrollment exceptions">
+        <div class="section-head">
+            <h2 class="section-title">@Model.TopicName</h2>
+            @* The owner is the dialog's scope made visible: the header title names the subject,
+               so the owner reads as the description line beneath it rather than as a second
+               heading. *@
+            <span class="section-owner">@Model.OwnerName</span>
+            @if (_exceptions is { Length: > 0 })
+            {
+                <FluentBadge Appearance="Appearance.Accent" Title="Enrollment exceptions">
+                    @EnrollmentExceptionLabels.FormatCount(_exceptions.Length)
+                </FluentBadge>
+            }
+        </div>
+
+        @if (_exceptions is null)
+        {
+            <FluentProgressRing aria-label="Loading enrollment exceptions" />
+        }
+        else if (_loadError is not null)
+        {
