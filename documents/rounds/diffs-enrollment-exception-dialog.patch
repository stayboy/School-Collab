+        }
+        else
+        {
+            _positions.Remove(position);
+        }
+
+        await RefreshExceptedHintAsync();
+    }
+
+    private async Task OnSpanChangedAsync() => await RefreshExceptedHintAsync();
+
+    /// <summary>
+    /// Asks the server (<c>GET /students/enrollment-exceptions/check</c>) whether this subject is
+    /// already excepted on the span's anchor date. Best effort by design: a check that cannot run
+    /// leaves the hint absent and never blocks the write — the server is the gate (a duplicate is
+    /// still a 409, and its message is surfaced).
+    /// </summary>
+    private async Task RefreshExceptedHintAsync()
+    {
+        _alreadyExcepted = null;
+
+        if (SpanAnchor is not { } onDate)
+        {
+            return;
+        }
+
+        try
+        {
+            _alreadyExcepted = await Api.IsSubjectExceptedAsync(
+                Model.TopicId,
+                onDate,
+                gradeLevelId: OwnerGradeLevelId,
+                activityGroupId: OwnerActivityGroupId,
+                ct: _loadCts?.Token ?? CancellationToken.None);
+        }
+        catch (OperationCanceledException) { }
+        catch (Exception ex)
+        {
+            Logger.LogWarning(ex, "Could not check whether topic {TopicId} is already excepted on {OnDate}", Model.TopicId, onDate);
+            _alreadyExcepted = null;
+        }
+    }
+
+    /// <summary>
+    /// The FR-56 division a group's <see cref="EnrollmentSpan"/> requires — the same mapping as
+    /// <c>TopicAssignmentPeriodValidator.ValidateGroupExceptionDivisionAsync</c>. This is what
+    /// narrows the add section's "Fill from" list to exactly one option for a group owner.
+    /// </summary>
+    private static AcademicYearDivision RequiredDivision(string span) => span switch
+    {
+        nameof(EnrollmentSpan.Termly) => AcademicYearDivision.Terms,
+        nameof(EnrollmentSpan.Semester) => AcademicYearDivision.Semesters,
+        _ => AcademicYearDivision.None
+    };
+
+    private static bool IsDivision(PeriodDto period, AcademicYearDivision division) =>
+        string.Equals(period.Division, division.ToString(), StringComparison.OrdinalIgnoreCase);
+
+    private static DateOnly? ToDateOnly(DateTime? value) =>
+        value is { } date ? DateOnly.FromDateTime(date.Date) : null;
+
+    /// <summary>
+    /// The period part: the vocabulary the user reads, never the enum member — ONE spelling per
+    /// concept (v4 decision 14), shared by the control's options and the list rows' badges.
+    /// </summary>
+    private static string PartLabel(AcademicYearDivision division) => division switch
+    {
+        AcademicYearDivision.Terms => "Term",
+        AcademicYearDivision.Semesters => "Semester",
+        _ => "Any date"
+    };
+
+    /// <summary>The wire form of <see cref="PartLabel"/>'s input: the DTO carries <c>Division</c> as
+    /// a string, so a row's badge parses it once here. Unparseable or absent division reads as
+    /// "Any date" rather than throwing in a list render.</summary>
+    private static AcademicYearDivision DivisionOf(string division) =>
+        Enum.TryParse<AcademicYearDivision>(division, true, out var parsed) ? parsed : AcademicYearDivision.None;
+
+    /// <summary>
+    /// The span in words (§5.1): <c>1–14 Mar 2027</c>, <c>from 1 Mar 2027</c> (open start),
+    /// <c>to 14 Mar 2027</c> (open end). An exception is never unbounded on both sides, so the dash
+    /// is unreachable in practice — kept so a malformed row renders quietly instead of throwing.
+    /// </summary>
+    private static string SpanLabel(DateOnly? start, DateOnly? end)
+    {
+        if (start is { } s && end is { } e)
+        {
+            return s.Year == e.Year && s.Month == e.Month
+                ? $"{s.Day}–{e.Day} {Month(e)}"
+                : $"{Day(s)} – {Day(e)}";
+        }
+        if (start is { } openStart)
+        {
+            return $"from {Day(openStart)}";
+        }
+        if (end is { } openEnd)
+        {
+            return $"to {Day(openEnd)}";
+        }
+        return "—";
+    }
+
+    private static string Day(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
+
+    private static string Month(DateOnly date) => date.ToString("MMM yyyy", CultureInfo.InvariantCulture);
+
+    public void Dispose()
+    {
+        _disposed = true;
+        _loadCts?.Cancel();
+        _loadCts?.Dispose();
+        _loadCts = null;
+    }
+}
