+
+@* WS-C1 teacher surface (spec §3.2 line 51): the per-ward guardian sign-off
+   card on the Assignments Detail page. Renders nothing when the assignment
+   does not require a signature. Self-loads its own data; Detail passes only
+   the assignment id + the gate flag; OnChanged is optional (detail re-load
+   hook for future cross-card refresh). *@
+
+@if (RequiresSignature)
+{
+    <div class="mt-4">
+        <h4>Guardian sign-off</h4>
+
+        @if (_busy)
+        {
+            <FluentProgressRing />
+        }
+        else if (!string.IsNullOrEmpty(_error))
+        {
+            <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
+        }
+        else if (_rows is null || _rows.Count == 0)
+        {
+            <FluentMessageBar Intent="MessageIntent.Info">No submissions yet.</FluentMessageBar>
+        }
+        else
+        {
+            <table class="mt-3">
+                <thead>
+                    <tr>
+                        <th>Student</th>
+                        <th>Status</th>
+                        <th>Expected signer</th>
+                        <th>Signed by</th>
+                        <th>Delivery</th>
+                        <th>Version</th>
+                        <th>Score</th>
+                        <th></th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @foreach (var row in _rows)
+                    {
+                        <tr @key="row.StudentId">
+                            <td>@row.StudentName</td>
+                            <td>
+                                <FluentBadge Appearance="@StatusAppearance(row)">
+                                    @StatusLabel(row)
+                                </FluentBadge>
+                            </td>
+                            <td>@(row.ExpectedSignerName ?? "—")</td>
+                            <td>@(row.SignerName ?? "—")</td>
+                            <td>
+                                @if (row.Delivered)
+                                {
+                                    <FluentBadge Appearance="Appearance.Neutral" Title="Delivered">Delivered</FluentBadge>
+                                }
+                                @if (row.Opened)
+                                {
+                                    <FluentBadge Appearance="Appearance.Neutral" Title="Opened">Opened</FluentBadge>
+                                }
+                                @if (!row.Delivered && !row.Opened)
+                                {
+                                    <span>—</span>
+                                }
+                            </td>
+                            <td>@row.CurrentVersionNumber</td>
+                            <td>@(row.Score?.ToString("0.##") ?? "—")</td>
+                            <td>
+                                <FluentAnchor Href="@($"/assignments/{AssignmentId}/students/{row.StudentId}/sign-off")">
+                                    Open sign-off page
+                                </FluentAnchor>
+                                @if (row.SignOffState == SignOffStateDto.AwaitingSignature)
+                                {
+                                    <FluentButton Appearance="Appearance.Outline"
+                                                  OnClick="@(() => OpenReassignDialogAsync(row))"
+                                                  class="ms-2">Reassign signer</FluentButton>
+                                }
+                                @if (row.SignOffState == SignOffStateDto.Signed && row.FinalizedAt is null)
+                                {
+                                    <FluentButton Appearance="Appearance.Outline"
+                                                  Title="Finalize the sign-off (marks the locked state)"
+                                                  OnClick="@(() => FinalizeAsync(row))"
+                                                  class="ms-2"
+                                                  Disabled="@_finalizing">Finalize</FluentButton>
+                                }
+                            </td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        }
