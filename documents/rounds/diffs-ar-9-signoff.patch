+@* WS-C2 guardian e-sign page (spec §3.2 line 50) — the v1 C2 surface. The page
+   is reachable by URL only (no identity yet — the D-6/E1 rounds relocate it
+   behind real auth + deep links with the route + command unchanged; the acting
+   guardian self-selects below, which is the documented v1 dev posture, NOT an
+   auth hole). Consumes exactly ONE aggregate (GetSignOffContextAsync) — no
+   other cross-context call. Styling: existing app.css utilities + FluentUI
+   components only — no inline style, no new .razor.css (round decision (h)). *@
+@page "/assignments/{AssignmentId:guid}/students/{StudentId:guid}/sign-off"
+@using SchoolCollab.Assignments.Contracts
+@using Microsoft.FluentUI.AspNetCore.Components
+@inject AssignmentsApiClient Api
+@inject NavigationManager Nav
+@inject ILogger<SignOff> Logger
+@implements IDisposable
+
+<PageTitle>Sign off — @_context?.AssignmentTitle</PageTitle>
+
+<ErrorBoundary>
+    <ChildContent>
+        @if (_loading)
+        {
+            <FluentProgressRing />
+        }
+        else if (_context is null)
+        {
+            <FluentMessageBar Intent="MessageIntent.Error">Assignment or student not found.</FluentMessageBar>
+            <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="mt-2">Back to assignments</FluentButton>
+        }
+        else
+        {
+            <div class="mt-3">
+                <div>
+                    <h2>Sign off — @_context.AssignmentTitle</h2>
+                    <FluentBadge Appearance="@ContextStatusAppearance(_context)">
+                        @ContextStatusLabel(_context)
+                    </FluentBadge>
+                </div>
+
+                @if (_context.SignOffState == SignOffStateDto.Signed || _context.FinalizedAt is not null)
+                {
+                    @* Already-signed view: the idempotent second visit is a VIEW, not
+                       a 409 page — the 409 only fires on a second POST. *@
+                    <FluentMessageBar Intent="MessageIntent.Success" class="mt-3">
+                        This sign-off has been completed
+                        @(_context.FinalizedAt is not null
+                            ? $"and finalized on {_context.FinalizedAt.Value.ToLocalTime():g}."
+                            : $"on {_context.SignedAt?.ToLocalTime():g}.")
+                    </FluentMessageBar>
+                    <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="mt-3">Back to assignments</FluentButton>
+                }
+                else
+                {
+                    @* Review summary (current version + score/result) *@
+                    <FluentStack Orientation="Orientation.Vertical" Gap="0.5rem" class="mt-3">
+                        <div><span class="muted">Ward:</span> @_context.StudentName</div>
+                        <div><span class="muted">Current version:</span> @(_context.CurrentVersionNumber > 0 ? _context.CurrentVersionNumber.ToString() : "—")</div>
+                        <div><span class="muted">Score:</span> @(_context.Score?.ToString("0.##") ?? "—")</div>
+                        <div><span class="muted">Result:</span> @(_context.Passed is null ? "—" : _context.Passed.Value ? "Passed" : "Failed")</div>
+                    </FluentStack>
+
+                    @* Consent block (spec §3.2 line 53 — the presented text is captured
+                       server-side on the audit event; the checkbox is client-only) *@
+                    <FluentCard class="mt-4">
+                        <FluentStack Orientation="Orientation.Vertical" Gap="0.75rem">
+                            <h5>Guardian sign-off consent</h5>
+                            <div>@_context.ConsentText</div>
+                            <FluentCheckbox @bind-Value="_consentChecked"
+                                            Label="I have read and understand the above consent"
+                                            aria-label="Confirm I have read and understand the consent" />
+                        </FluentStack>
+                    </FluentCard>
+
+                    @* Acting-guardian self-select (v1 dev posture — see header comment) *@
+                    <FluentStack Orientation="Orientation.Vertical" Gap="0.5rem" class="mt-4">
+                        <h5>Signing as (guardian) *</h5>
+                        @if (_context.Guardians.Count == 0)
+                        {
+                            <FluentMessageBar Intent="MessageIntent.Warning">No linked guardians found for this ward.</FluentMessageBar>
+                        }
+                        else
+                        {
