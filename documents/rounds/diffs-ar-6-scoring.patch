diff --git a/src/Assignments/SchoolCollab.Assignments.Core/Data/Configurations/SubmissionAnswerConfiguration.cs b/src/Assignments/SchoolCollab.Assignments.Core/Data/Configurations/SubmissionAnswerConfiguration.cs
new file mode 100644
