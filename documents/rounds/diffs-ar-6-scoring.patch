+        return new SubmitAssignmentOnBehalfCommandHandler(
+            assignmentRepo, subRepo, new FakeTenantProvider(TenantId),
+            scoring, NullLogger<SubmitAssignmentOnBehalfCommandHandler>.Instance);
+    }
