diff --git a/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/ScoringFieldsSection.razor b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/ScoringFieldsSection.razor
