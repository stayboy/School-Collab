+        result.Passed.Should().BeFalse();
+    }
+
+    // ── Duplicate answer question ids → first wins ──────────────────────
+
+    [TestMethod]
+    public void DuplicateAnswerQuestionId_FirstWins()
+    {
+        var engine = NewEngine();
+        var input = McInput(
+            questions: [new(Q1, OptA, null)],
