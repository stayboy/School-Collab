diff --git a/tests/SchoolCollab.Assignments.Tests.Unit/UpdateAssignmentCommandHandlerQuestionsTests.cs b/tests/SchoolCollab.Assignments.Tests.Unit/UpdateAssignmentCommandHandlerQuestionsTests.cs
new file mode 100644
