+    }
+
+    [TestMethod]
+    public async Task GenerateAsync_Provider403_SurfacesAsFriendlyMessage502()
+    {
+        var chatClient = new DelegateChatClient(
+            (_, _, _) => throw new HttpRequestException("Forbidden", null, HttpStatusCode.Forbidden));
+
