+    Guid AssignmentId,
+    int QuestionCount,
+    IReadOnlyList<QuestionTypeDto>? Types,
+    int? DifficultyEasyCount,
+    int? DifficultyMediumCount,
+    int? DifficultyHardCount,
+    string? Provider,
+    string? Model) : ICommand;
