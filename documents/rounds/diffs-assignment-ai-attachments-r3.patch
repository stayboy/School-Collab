+
+            modelBuilder.Entity("SchoolCollab.Assignments.Core.Domain.Assignment", b =>
+                {
+                    b.Navigation("Modules");
+
+                    b.Navigation("Resources");
+
+                    b.Navigation("Targets");
+                });
+#pragma warning restore 612, 618
+        }
+    }
+}
