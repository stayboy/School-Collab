diff --git a/src/Settings/SchoolCollab.Settings.Application/Components/Pages/NotificationTemplates.razor b/src/Settings/SchoolCollab.Settings.Application/Components/Pages/NotificationTemplates.razor
new file mode 100644
index 00000000..a533a961
--- /dev/null
+++ b/src/Settings/SchoolCollab.Settings.Application/Components/Pages/NotificationTemplates.razor
@@ -0,0 +1,1071 @@
+@page "/notification-templates"
+@using Microsoft.AspNetCore.Components
+@using SchoolCollab.Admin.Shared.Components.RichText
+@using SchoolCollab.Core.Notifications
+@using SchoolCollab.Core.RichText
+@inject NotificationTemplateApiClient Api
+@inject NotificationTemplatePreviewClient Preview
+@inject StudentsLookupClient Lookups
+@inject CodedValuesApiClient CodedValuesApi
+@inject ILogger<NotificationTemplates> Logger
+@implements IDisposable
+
+@* The ONE editing surface for tenant notification templates (spec §3.10, round
+   notification-templates-b3b). Shell posture mirrors ConfigFlagDetail (save / reset / reason /
+   audit) — this is not a list, so it is not a LandingPage. Authorization is the host's: no page
+   policy, exactly like /config-flags.
+
+   Master–detail per slot, because a slot is a SET (round b2c relaxed the store to several rows per
+   kind × channel): the row inventory on the left, one editing pane for the selected row, an
+   "+ add template" that creates, and a per-row reset that tombstones by id with the operator's
+   reason. Selection contract: on entering a tab the slot's default row (no constraints) is
+   selected when one exists, otherwise the add state; an empty slot says the built-in default
+   applies; a slot whose rows are all constrained says there is no tenant default. *@
+
+<PageTitle>Notification templates</PageTitle>
+
+<ErrorBoundary>
+    <ChildContent>
+        <div class="title-row">
+            <h1 class="page-title">Notification templates</h1>
+        </div>
+        <p class="text-muted">
+            Email and SMS overrides for assignment notifications. Where no tenant template exists the
+            built-in default applies. Constraints narrow a template to an audience or assignment type;
+            the tenant default is the row with none.
+        </p>
+
+        @if (_loading)
+        {
+            <FluentSpinner />
+        }
+        else if (!string.IsNullOrEmpty(_loadError))
+        {
+            <FluentMessageBar Intent="MessageBarIntent.Error">@_loadError</FluentMessageBar>
+        }
+        else
+        {
+            @if (!string.IsNullOrEmpty(_gradeFilterText))
+            {
+                <FluentMessageBar Intent="MessageBarIntent.Info" class="mb-2">
+                    Showing the templates that can apply to one grade level — every kind × channel tab
+                    stays reachable; new templates start with that grade's constraint.
+                </FluentMessageBar>
+            }
+
+            @if (_lookupError is not null)
+            {
+                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2">
+                    Constraint lookups are unavailable (@_lookupError). Existing constraints keep their
+                    stored values so an edit round-trips, but adding constraints is disabled until the
+                    lookups return.
+                </FluentMessageBar>
+            }
+
+            <FluentTabStrip ActiveTabId="@_activeKindTabId" ActiveTabIdChanged="OnKindTabChangedAsync">
+                @foreach (var kind in Kinds)
+                {
+                    <FluentTab Id="@KindTabId(kind)" Header="@kind.ToString()">
+                        <FluentTabStrip ActiveTabId="@_activeChannelTabId" ActiveTabIdChanged="OnChannelTabChangedAsync">
+                            @foreach (var channel in Channels)
+                            {
+                                <FluentTab Id="@ChannelTabId(channel)" Header="@ChannelLabel(channel)">
+                                    @{
+                                        var slot = Slot(kind, channel);
+                                    }
+                                    @if (kind == _activeKind && channel == _activeChannel)
+                                    {
+                                        @* ── Slot state notes ───────────────────────────────── *@
+                                        @if (slot.Rows.Count == 0)
+                                        {
+                                            <FluentMessageBar Intent="MessageBarIntent.Info" class="mb-2">
+                                                No tenant template for @kind.ToString() · @ChannelLabel(channel) —
+                                                the built-in default applies.
+                                            </FluentMessageBar>
+                                        }
+                                        else if (slot.Rows.All(r => r.Constraints.Count > 0))
+                                        {
+                                            <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2">
+                                                No tenant default — the built-in default applies to unconstrained sends.
+                                            </FluentMessageBar>
+                                        }
+
+                                        @* ── Row inventory (master) ────────────────────────── *@
+                                        <FluentCard class="pa-4 mt-3">
+                                            <h2>Templates in this slot (@slot.Rows.Count)</h2>
+                                            <FluentStack Orientation="Orientation.Vertical">
+                                                @foreach (var row in slot.Rows)
+                                                {
+                                                    <div data-row="@row.Id">
+                                                        <FluentStack Orientation="Orientation.Horizontal">
+                                                            <FluentButton Appearance="@(slot.SelectedId == row.Id ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
+                                                                          OnClick="@(() => SelectRow(slot, row))">
+                                                                @SlotRowTitle(row)
+                                                            </FluentButton>
+                                                            @if (row.Constraints.Count == 0)
+                                                            {
+                                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Default</FluentBadge>
+                                                            }
+                                                            @if (slot.SelectedId == row.Id)
+                                                            {
+                                                                <FluentBadge Appearance="BadgeAppearance.Outline">Editing</FluentBadge>
+                                                            }
+                                                            <span class="text-muted">@ConstraintSummary(row)</span>
+                                                            <FluentButton Appearance="ButtonAppearance.Transparent"
+                                                                          Disabled="@_busy"
+                                                                          OnClick="@(() => ResetAsync(slot, row))">Reset</FluentButton>
+                                                        </FluentStack>
+                                                    </div>
+                                                }
+                                            </FluentStack>
+                                            <div class="mt-3">
+                                                <FluentButton Appearance="ButtonAppearance.Outline"
+                                                              IconStart="@FluentIcons.Add"
+                                                              OnClick="@(() => BeginAdd(slot))">Add template</FluentButton>
+                                            </div>
+                                        </FluentCard>
+
+                                        @* ── Editor (detail) ─────────────────────────────── *@
+                                        <FluentCard class="pa-4 mt-3">
+                                            <h2>@(slot.SelectedId is null ? "New template" : "Edit template")</h2>
+
+                                            @if (ConflictWarning(slot) is { } warning)
+                                            {
+                                                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2">@warning</FluentMessageBar>
+                                            }
+
+                                            @if (channel == NotificationChannel.Email)
+                                            {
+                                                <FluentTextInput Label="Subject"
+                                                                 Class="full-width"
+                                                                 Placeholder="New assignment: {{Title}}"
+                                                                 @bind-Value="slot.Subject"
+                                                                 @bind-Value:after="QueuePreview" />
+                                            }
+
+                                            <div class="mt-3">
+                                                @if (channel == NotificationChannel.Email)
+                                                {
+                                                    @* Only the ACTIVE slot's pane renders, so one editor ref covers
+                                                       every email slot: switching slots unmounts and remounts it. *@
+                                                    <label class="text-muted">Body</label>
+                                                    <RichInstructionEditor @ref="_activeEditor"
+                                                                           Id="@($"template-body-{slot.Kind}-{slot.Channel}")"
+                                                                           Value="@slot.Body"
+                                                                           Placeholder="Write the email body…" />
+                                                    <p class="text-muted">
+                                                        Tags typed into the body render on send; the chips below insert
+                                                        into the subject (the body is a rich editor, inserted at the caret
+                                                        by the browser).
+                                                    </p>
+                                                }
+                                                else
+                                                {
+                                                    <FluentTextArea Label="Message"
+                                                                    Class="full-width ta-lines-6"
+                                                                    Placeholder="Reminder: {{Title}} is due {{DueDate}}. {{Link}}"
+                                                                    @bind-Value="slot.Body"
+                                                                    @bind-Value:after="QueuePreview" />
+                                                    <p class="text-muted">@SmsLengthHint(slot)</p>
+                                                }
+                                            </div>
+
+                                            @* ── Tag chips (spec §3.2 vocabulary) ────────────── *@
+                                            <div class="mt-3">
+                                                <span class="text-muted">Insert a tag:</span>
+                                                @foreach (var tag in NotificationTemplateTags.All)
+                                                {
+                                                    <FluentButton Appearance="ButtonAppearance.Outline"
+                                                                  OnClick="@(() => InsertTag(slot, tag))">@($"{{{{{tag}}}}}")</FluentButton>
+                                                }
+                                            </div>
+
+                                            @* ── Constraints ────────────────────────────────── *@
+                                            <h3 class="mt-3">Constraints</h3>
+                                            <p class="text-muted">
+                                                A template applies when every dimension below matches the
+                                                assignment. No constraints = the tenant default.
+                                            </p>
+                                            @foreach (var constraint in slot.Constraints)
+                                            {
+                                                <FluentStack Orientation="Orientation.Horizontal">
+                                                    <DropdownForEnum TEnum="TemplateConstraintDimension"
+                                                                     @bind-SelectedValue="constraint.Dimension"
+                                                                     @bind-SelectedValue:after="() => OnDimensionChanged(constraint)"
+                                                                     Width="FieldWidth.W3" />
+                                                    <DropdownComponent TItem="OptionItem" TValue="string"
+                                                                       Items="@OptionsFor(constraint.Dimension)"
+                                                                       @bind-SelectedValue="constraint.Value"
+                                                                       OptionText="@(o => o.Text)"
+                                                                       OptionValue="@(o => o.Value)"
+                                                                       Placeholder="Value"
+                                                                       Width="FieldWidth.W5" />
+                                                    <span class="text-muted">
+                                                        @($"{DimensionLabel(constraint.Dimension)}: {DisplayFor(constraint.Dimension, constraint.Value)}")
+                                                    </span>
+                                                    <FluentButton Appearance="ButtonAppearance.Transparent"
+                                                                  OnClick="@(() => RemoveConstraint(slot, constraint))">Remove</FluentButton>
+                                                </FluentStack>
+                                            }
+                                            <div class="mt-3">
+                                                <FluentButton Appearance="ButtonAppearance.Outline"
+                                                              IconStart="@FluentIcons.Add"
+                                                              Disabled="@(!LookupsAvailable)"
+                                                              OnClick="@(() => AddConstraint(slot))">Add constraint</FluentButton>
+                                            </div>
+
+                                            @* ── Save + reason ──────────────────────────────── *@
+                                            <div class="mt-3">
+                                                <FluentTextInput Label="Reason (recorded in the audit trail)"
+                                                                 Class="full-width"
+                                                                 @bind-Value="slot.Reason" />
+                                                <FluentButton Appearance="ButtonAppearance.Primary"
+                                                              Disabled="@_busy"
+                                                              OnClick="@(() => SaveAsync(slot))">Save</FluentButton>
+                                            </div>
+
+                                            @if (!string.IsNullOrEmpty(slot.Message))
+                                            {
+                                                <FluentMessageBar Intent="MessageBarIntent.Success" class="mt-2">@slot.Message</FluentMessageBar>
+                                            }
+                                            @if (!string.IsNullOrEmpty(slot.Error))
+                                            {
+                                                <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-2">@slot.Error</FluentMessageBar>
+                                            }
+                                        </FluentCard>
+
+                                        @* ── Live preview (the exact render path, sample data) ── *@
+                                        <FluentCard class="pa-4 mt-3">
+                                            <h2>Preview (sample data)</h2>
+                                            <p class="text-muted">
+                                                Rendered by the Assignments service with the sample assignment,
+                                                guardian and @LinkDescription(channel) sample link.
+                                            </p>
+                                            <FluentButton Appearance="ButtonAppearance.Outline"
+                                                          OnClick="@(() => OnRefreshPreviewAsync(slot))">Refresh preview</FluentButton>
+                                            @if (slot.PreviewUnavailable)
+                                            {
+                                                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mt-2">
+                                                    Preview unavailable — the template still saves. @slot.PreviewError
+                                                </FluentMessageBar>
+                                            }
+                                            else if (slot.PreviewBody is not null)
+                                            {
+                                                @if (channel == NotificationChannel.Email)
+                                                {
+                                                    <p class="text-muted">Subject: @slot.PreviewSubject</p>
+                                                    <RichInstruction Value="@slot.PreviewBody"
+                                                                     Id="@($"template-preview-{slot.Kind}-{slot.Channel}")" />
+                                                }
+                                                else
+                                                {
+                                                    <p>@slot.PreviewBody</p>
+                                                }
+                                            }
+                                        </FluentCard>
+
+                                        @* ── Audit trail (spec §3.9) ────────────────────── *@
+                                        <FluentCard class="pa-4 mt-3">
+                                            <h2>Audit trail — @kind.ToString() · @ChannelLabel(channel)</h2>
+                                            @if (!string.IsNullOrEmpty(slot.AuditError))
+                                            {
