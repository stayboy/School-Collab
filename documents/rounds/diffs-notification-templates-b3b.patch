+        if (!_slots.TryGetValue(key, out var slot))
+        {
+            slot = new SlotState(kind, channel);
+            _slots[key] = slot;
+        }
+
+        return slot;
+    }
+
+    private static string KindTabId(NotificationTemplateKind kind) => $"nt-kind-{kind}";
+
+    private static string ChannelTabId(NotificationChannel channel) => $"nt-channel-{channel}";
+
+    public void Dispose()
+    {
+        _disposed = true;
+        _previewDebounce?.Cancel();
+        _previewDebounce?.Dispose();
+    }
+
+    /// <summary>One picker option: the stored VALUE (the matcher's encoding) plus its display text.</summary>
+    private sealed record OptionItem(string Value, string Text);
+
+    /// <summary>One constraint being edited: the dimension plus its stored value.</summary>
+    private sealed class ConstraintDraft
+    {
+        public TemplateConstraintDimension Dimension { get; set; }
+
+        public string Value { get; set; } = string.Empty;
+    }
+
+    /// <summary>One kind × channel slot's master–detail state.</summary>
+    private sealed class SlotState(NotificationTemplateKind kind, NotificationChannel channel)
+    {
+        public NotificationTemplateKind Kind { get; } = kind;
+
+        public NotificationChannel Channel { get; } = channel;
+
+        /// <summary>The slot's rows, grade-filtered when the page was opened from a grade card.</summary>
+        public List<TenantNotificationTemplateDto> Rows { get; set; } = [];
+
+        /// <summary>Whether the selection contract has been applied to this slot.</summary>
+        public bool SelectionInitialized { get; set; }
+
+        /// <summary>The row being edited; <see langword="null"/> = the add state.</summary>
+        public Guid? SelectedId { get; set; }
+
+        public string? Subject { get; set; }
+
+        public string Body { get; set; } = string.Empty;
+
+        public List<ConstraintDraft> Constraints { get; } = [];
+
+        public string Reason { get; set; } = string.Empty;
+
+        public List<NotificationTemplateAuditEntryDto> Audit { get; set; } = [];
+
+        public string? AuditError { get; set; }
+
+        public string? PreviewSubject { get; set; }
+
+        public string? PreviewBody { get; set; }
+
+        public bool PreviewUnavailable { get; set; }
+
+        public string? PreviewError { get; set; }
+
+        public string? Message { get; set; }
+
+        public string? Error { get; set; }
+    }
+}
