+/* ── The create / edit skeleton (documents/solution/panel-layout-pattern.md §2, §6) ──────────────
+   ONE region grid for every authoring surface. Both columns are LAYOUT regions: no border, no
+   surface, no padding, no radius — they exist only to place blocks, so the single frame per block is
+   the PanelSection inside it (lesson L2: a region that draws a box double-framed every block in it).
+
+   COLLAPSE IS A CONTAINER QUERY, never a viewport magic number (owner, 2026-10-23; lesson L5: two
+   grids in the repo carried different viewport breakpoints — 1400px vs 1100px — for this same
+   decision). A viewport breakpoint lies the moment the surface renders inside a narrower host region
+   (a drawer, a dialog, a page with a wider nav), so the grid queries the width IT actually has. The
+   queried ancestor is `.region-grid-host` — a grid cannot query itself. Declare it on the page
+   wrapper, NOT on the grid. */
+.region-grid-host {
+    container-type: inline-size;
+    container-name: region-grid-host;
+}
+
+.region-grid {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(320px, 460px);
+    gap: 16px;
+    align-items: start;
+}
+
+.region-grid__main {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    min-width: 0;
+}
+
+/* The summary view's single-column stack (panel-layout-pattern §2): one block after another with the
+   same 16px rhythm the two regions use. It draws nothing — it only stacks, so the only frame per
+   block stays the PanelSection inside it. */
+.region-stack {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    min-width: 0;
+}
+
+/* The rail column sticks to the top of the page's scroll port (§6): relationships stay reachable
+   while the form scrolls. `align-self: start` is part of the rule, not a tidy-up — a stretched grid
+   item has the full column height as its containing block and can never stick. */
+.region-grid__rail {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    min-width: 0;
+    position: sticky;
+    top: var(--app-bar-sticky-offset, 0px);
+    align-self: start;
+}
+
+/* Collapsed: one column, and the rail goes LAST — the fields are what the author came for and the
+   relationships are enrichment. */
+@container region-grid-host (max-width: 899px) {
+    .region-grid {
+        grid-template-columns: minmax(0, 1fr);
+    }
+}
+
+/* ── One offset for every sticky thing on an authoring surface (§6) ─────────────────────────────
+   `--app-bar-height` is the app bar's own height (MainLayout pins its header region at 50px).
+   `--app-bar-sticky-offset` is the distance a sticky block keeps from the top of the scroll port.
+   The port — `.page-scroll` — begins at the app bar's LOWER edge, so that distance is 0 and a
+   nonzero value would float a pinned header 50px below where it belongs. Declared once here: the
+   rail column and the first block's header row both read it, and a page may not invent its own. */
+:root {
+    --app-bar-height: 50px;
+    --app-bar-sticky-offset: 0px;
+}
+
