diff --git a/src/Assignments/SchoolCollab.Assignments.Contracts/ContractTypes.cs b/src/Assignments/SchoolCollab.Assignments.Contracts/ContractTypes.cs
index 958008e3..cd0b1518 100644
--- a/src/Assignments/SchoolCollab.Assignments.Contracts/ContractTypes.cs
+++ b/src/Assignments/SchoolCollab.Assignments.Contracts/ContractTypes.cs
@@ -938,6 +938,77 @@ public record AssignmentRecipientDto(
     bool NotifyOnBroadcast,
     bool SubscriptionActive);
 
+/// <summary>
+/// Q146 (spec §4.2) — the audience reads' fixed cohort cap, declared ONCE so the client and the
+/// server cannot drift. Both the published read and the draft preview stop at this many student
+/// rows and set <see cref="AssignmentAudienceDto.Truncated"/>; the panel states the cap where the
+/// pager is, so a page can never be read as the whole cohort.
+/// </summary>
+public static class AudienceLimits
+{
+    public const int AudienceCap = 200;
+}
+
+/// <summary>
+/// The delivery state of one audience contact.
+/// <para>The published read takes it from the <b>notification log</b> (authoritative — Q145), and
+/// answers <see cref="Unknown"/> when no log row exists for the recipient or the log read failed:
+/// a status nobody wrote is never fabricated as <see cref="Sent"/>. <see cref="NotPublishingYet"/> is
+/// the draft preview's only reachable state (nothing has been sent), and <see cref="BlockedByPolicy"/>
+/// marks a resolved contact the publish-time policy filter would drop, so the draft panel can say
+/// why it will not be notified instead of silently omitting it.</para>
+/// </summary>
+public enum AudienceDeliveryStateDto
+{
+    [Description("Not publishing yet")] NotPublishingYet = 0,
+    [Description("Blocked by policy")] BlockedByPolicy = 1,
+    [Description("Queued")] Queued = 2,
+    [Description("Sent")] Sent = 3,
+    [Description("Failed")] Failed = 4,
+    [Description("Skipped")] Skipped = 5,
+    [Description("Unknown")] Unknown = 6
+}
+
+/// <summary>
+/// One contact of one student in the audience read (spec §4.2, Q145).
+/// <para><b>Deliberately carries no address of any kind</b> (spec §4.9, Q154/Q158): no email, no
+/// phone, no guardian name. A value that never enters the payload cannot leak through devtools, a
+/// screenshot or a future export; the table shows owner type, channel, role and delivery only.</para>
+/// </summary>
+public record AudienceContactDto(
+    ContactOwnerTypeDto OwnerType,
+    ContactChannelDto Channel,
+    GuardianRoleDto? GuardianRole,
+    bool SubscriptionActive,
+    bool NotifyOnBroadcast,
+    AudienceDeliveryStateDto DeliveryState,
+    DateTimeOffset? SentAt,
+    DateTimeOffset? OpenedAt,
+    string? FailureReason,
+    bool RetryScheduled,
+    Guid? TemplateId);
+
+/// <summary>One student row of the audience read: the resolved cohort member, whether any of its
+/// contacts is subscribed, and one entry per contact.</summary>
+public record AudienceStudentDto(
+    Guid StudentId,
+    string StudentName,
+    bool Reached,
+    IReadOnlyList<AudienceContactDto> Contacts);
+
+/// <summary>
+/// The audience read (spec §4.2, Q145/Q146): the cohort per student, capped at
+/// <see cref="AudienceLimits.AudienceCap"/>.
+/// <para><see cref="Truncated"/> is true when the cohort exceeded the cap. <see cref="Degraded"/> is
+/// true when a supporting read failed — the directory (names) or the notification log (delivery);
+/// the rows still carry the cohort and whatever did resolve, so a partial outage never empties the
+/// panel and is never reported as a different outage than the one that happened.</para>
+/// </summary>
+public record AssignmentAudienceDto(
+    IReadOnlyList<AudienceStudentDto> Rows,
+    bool Truncated,
+    bool Degraded);
+
 /// <summary>A single submission version (spec §4.11).</summary>
 public record SubmissionVersionDto(
     Guid Id,
diff --git a/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetAssignmentAudience/GetAssignmentAudience.cs b/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetAssignmentAudience/GetAssignmentAudience.cs
new file mode 100644
index 00000000..c6a50d6b
--- /dev/null
+++ b/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetAssignmentAudience/GetAssignmentAudience.cs
@@ -0,0 +1,260 @@
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging;
+using SchoolCollab.Assignments.Contracts;
+using SchoolCollab.Assignments.Core.Data;
+using SchoolCollab.Assignments.Core.Domain;
+using SchoolCollab.Assignments.Core.Domain.Exceptions;
+using SchoolCollab.Assignments.Core.Services;
+using SchoolCollab.Core.CQRS;
+using SchoolCollab.Students.Core.Domain;
+
+namespace SchoolCollab.Assignments.Core.CQRS.Assignments.Queries.GetAssignmentAudience;
+
+/// <summary>
+/// The published-to read (spec §4.2, Q130/Q145/Q146): one row per student of the assignment's
+/// resolved cohort, with the persisted recipients as its contacts and the notification log as the
+/// delivery state. <c>Reached = false</c> rows are the point of the read — they are what the
+/// per-recipient table could never show. Tenant-scoped by the context's global query filter, so a
+/// foreign assignment reads as absent (<see cref="AssignmentNotFoundException"/> → 404).
+/// </summary>
+public sealed record GetAssignmentAudience(Guid AssignmentId) : IQuery<AssignmentAudienceDto>;
+
+/// <summary>Handles <see cref="GetAssignmentAudience"/>.</summary>
+/// <remarks>
+/// <para><b>Delivery authority (Q145).</b> The notification log decides the state, the attempt and
+/// the failure reason — it is the record the renderer writes. <see cref="AssignmentRecipient.OpenedAt"/>
+/// supplies <i>opened</i> only: the two are read side by side and the log never overwrites the
+/// recipient's own opened stamp, nor the reverse. A recipient with no publish log row answers
+/// <see cref="AudienceDeliveryStateDto.Unknown"/>, never a fabricated <c>Sent</c>.</para>
+/// <para><b>Degradation is split, never collapsed.</b> A directory (name) failure leaves the rows
+/// intact with an empty name and delivery untouched; a log failure leaves the roster and the
+/// contacts intact with <see cref="AudienceDeliveryStateDto.Unknown"/>. Neither empties the panel.</para>
+/// </remarks>
+public sealed class GetAssignmentAudienceHandler(
+    AssignmentsDbContext db,
+    IAssignmentTargetResolver targetResolver,
+    IContactResolver contactResolver,
+    ILogger<GetAssignmentAudienceHandler> logger)
+    : IQueryHandler<GetAssignmentAudience, AssignmentAudienceDto>
+{
+    /// <inheritdoc />
+    public async Task<AssignmentAudienceDto> HandleAsync(
+        GetAssignmentAudience query,
+        CancellationToken cancellationToken = default)
+    {
+        var assignment = await db.Assignments
+            .AsNoTracking()
+            .SingleOrDefaultAsync(a => a.Id == query.AssignmentId, cancellationToken)
+            ?? throw new AssignmentNotFoundException(query.AssignmentId);
+
+        // The persisted recipients are the contact rows publish wrote — the audience read never
+        // re-resolves contacts, so a row it shows is a row that was really queued.
+        var recipients = await db.AssignmentRecipients
+            .AsNoTracking()
+            .Where(r => r.AssignmentId == query.AssignmentId)
+            .ToListAsync(cancellationToken);
+
+        var recipientsByStudent = recipients
+            .Where(r => r.WardStudentId.HasValue)
+            .ToLookup(r => r.WardStudentId!.Value);
+
+        var (cohort, cohortDegraded) = await ResolveCohortAsync(assignment, recipientsByStudent, cancellationToken);
+        var (names, namesDegraded) = await ResolveStudentNamesAsync(assignment, cohort, cancellationToken);
+        var degraded = cohortDegraded || namesDegraded;
+
+        // A log read failure degrades DELIVERY only: the rows keep their roster and contacts.
+        IReadOnlyDictionary<Guid, NotificationLog>? publishLogs;
+        try
+        {
+            publishLogs = await ReadPublishLogsAsync(query.AssignmentId, cancellationToken);
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex,
+                "Notification log read failed for assignment {AssignmentId}; reporting every delivery state as Unknown",
+                query.AssignmentId);
+            degraded = true;
+            publishLogs = null;
+        }
+
+        var ordered = cohort
+            .OrderBy(studentId => names.TryGetValue(studentId, out var name) ? name : string.Empty, StringComparer.OrdinalIgnoreCase)
+            .ThenBy(studentId => studentId)
+            .ToArray();
+
+        var rows = ordered
+            .Take(AudienceLimits.AudienceCap)
+            .Select(studentId =>
+            {
+                var contacts = recipientsByStudent[studentId]
+                    .OrderBy(recipient => (int)recipient.Channel)
+                    .ThenBy(recipient => (int)recipient.OwnerType)
+                    .Select(recipient => ProjectContact(recipient, publishLogs))
+                    .ToList();
+
+                return new AudienceStudentDto(
+                    studentId,
+                    names.TryGetValue(studentId, out var name) ? name : string.Empty,
+                    contacts.Exists(contact => contact.SubscriptionActive),
+                    contacts);
+            })
+            .ToList();
+
+        return new AssignmentAudienceDto(rows, ordered.Length > AudienceLimits.AudienceCap, degraded);
+    }
+
+    /// <summary>
+    /// The student cohort, from the same resolver publish uses. A resolver failure degrades to the
+    /// persisted recipients' wards — the cohort that really was published — rather than an empty
+    /// list, because those rows are exactly what the caller came to read.
+    /// </summary>
+    private async Task<(Guid[] Cohort, bool Degraded)> ResolveCohortAsync(
+        Assignment assignment,
+        ILookup<Guid, AssignmentRecipient> recipientsByStudent,
+        CancellationToken cancellationToken)
+    {
+        var targets = assignment.Targets;
+        if (targets.Count == 0)
+        {
+            return ([], false);
+        }
+
+        try
+        {
+            var resolved = await targetResolver.ResolveStudentIdsAsync(
+                targets.Select(target => new TargetConstraint(target.Kind, target.RefId)).ToArray(),
+                targets.Any(target => target.Kind == TargetKind.AllStudents),
+                cancellationToken);
+            return (resolved, false);
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex,
+                "Target resolution failed for assignment {AssignmentId}; falling back to the persisted recipient cohort",
+                assignment.Id);
+            return (recipientsByStudent.Select(group => group.Key).ToArray(), true);
+        }
+    }
+
+    /// <summary>
+    /// Student display names from the ONE batched subscriber read the publish path already uses
+    /// (spec §4.2: no per-student directory hop). A failure degrades the NAMES only: the rows keep
+    /// their cohort and their delivery state.
+    /// </summary>
+    /// <remarks>
+    /// The catch below is not the whole failure surface: the production <c>StudentsContactResolver</c>
+    /// swallows a per-owner <see cref="HttpRequestException"/> and degrades that owner to an empty
+    /// result, so a directory outage arrives here as a SUCCESSFUL read carrying few or no names. A
+    /// cohort student left without a name is therefore the only observable evidence of that swallowed
+    /// failure — which is why a successful read still has to report <c>Degraded</c>.
+    /// </remarks>
+    private async Task<(IReadOnlyDictionary<Guid, string> Names, bool Degraded)> ResolveStudentNamesAsync(
+        Assignment assignment,
+        Guid[] cohort,
+        CancellationToken cancellationToken)
+    {
+        var names = new Dictionary<Guid, string>();
+        if (cohort.Length == 0)
+        {
+            return (names, false);
+        }
+
+        try
+        {
+            var subscribers = await contactResolver.ResolveSubscribersAsync(
+                new ResolveSubscribersRequest(
+                    db.CurrentTenantId,
+                    SubscriptionScope.AllAssignments,
+                    AssignmentPolicyScope.GradeTargetIds(assignment),
+                    cohort,
+                    assignment.TopicId),
+                cancellationToken);
+
+            foreach (var group in subscribers.Where(subscriber => subscriber.StudentId.HasValue).GroupBy(s => s.StudentId!.Value))
+            {
+                names[group.Key] = group
+                    .Select(subscriber => subscriber.StudentName)
+                    .FirstOrDefault(name => !string.IsNullOrWhiteSpace(name)) ?? string.Empty;
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex,
+                "Student directory read failed for assignment {AssignmentId}; the audience rows keep an empty name",
+                assignment.Id);
+            return (names, true);
+        }
+
+        var namesDegraded = cohort.Any(studentId =>
+            !names.TryGetValue(studentId, out var resolvedName) || string.IsNullOrWhiteSpace(resolvedName));
+
+        return (names, namesDegraded);
+    }
+
+    /// <summary>
+    /// The publish notifications of this assignment, keyed by recipient. Publish rows only: a
+    /// reminder or overdue row describes a different sendout and must not overwrite the state of
+    /// the publish one. Where a recipient was queued more than once, the latest attempt wins.
+    /// </summary>
+    private async Task<IReadOnlyDictionary<Guid, NotificationLog>> ReadPublishLogsAsync(
+        Guid assignmentId,
+        CancellationToken cancellationToken)
+    {
+        var rows = await db.NotificationLogs
+            .AsNoTracking()
+            .Where(log => log.AssignmentId == assignmentId && log.Kind == NotificationKind.Publish)
+            .ToListAsync(cancellationToken);
+
+        return rows
+            .GroupBy(log => log.RecipientId)
+            .ToDictionary(
+                group => group.Key,
+                group => group.OrderByDescending(log => log.Attempt).ThenByDescending(log => log.CreatedAt).First());
+    }
+
+    /// <summary>One persisted recipient projected onto the wire shape, with the log's delivery
+    /// state layered on top (Q145) and the recipient's own <c>OpenedAt</c> left untouched.</summary>
+    private static AudienceContactDto ProjectContact(
+        AssignmentRecipient recipient,
+        IReadOnlyDictionary<Guid, NotificationLog>? publishLogs)
+    {
+        NotificationLog? log = null;
+        publishLogs?.TryGetValue(recipient.Id, out log);
+
+        return new AudienceContactDto(
+            (ContactOwnerTypeDto)recipient.OwnerType,
+            (ContactChannelDto)recipient.Channel,
+            recipient.Role is { } role ? (GuardianRoleDto)role : null,
+            recipient.SubscriptionActive,
+            recipient.NotifyOnBroadcast,
+            ToDeliveryState(log),
+            log?.SentAt,
+            recipient.OpenedAt,
+            log?.FailureReason,
+            log?.NextRetryAt is not null,
+            log?.TemplateId);
+    }
+
+    /// <summary>The log's state on the wire. No row — or no readable log at all — is
+    /// <see cref="AudienceDeliveryStateDto.Unknown"/>, never <c>Sent</c>.</summary>
+    private static AudienceDeliveryStateDto ToDeliveryState(NotificationLog? log) => log?.DeliveryStatus switch
+    {
+        NotificationDeliveryStatus.Queued => AudienceDeliveryStateDto.Queued,
+        NotificationDeliveryStatus.Sent => AudienceDeliveryStateDto.Sent,
+        NotificationDeliveryStatus.Failed => AudienceDeliveryStateDto.Failed,
+        NotificationDeliveryStatus.Skipped => AudienceDeliveryStateDto.Skipped,
+        _ => AudienceDeliveryStateDto.Unknown,
+    };
+}
diff --git a/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetAssignmentAudiencePreview/GetAssignmentAudiencePreview.cs b/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetAssignmentAudiencePreview/GetAssignmentAudiencePreview.cs
new file mode 100644
index 00000000..0f2ff743
--- /dev/null
+++ b/src/Assignments/SchoolCollab.Assignments.Core/CQRS/Assignments/Queries/GetAssignmentAudiencePreview/GetAssignmentAudiencePreview.cs
@@ -0,0 +1,196 @@
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging;
+using SchoolCollab.Assignments.Contracts;
+using SchoolCollab.Assignments.Core.Data;
+using SchoolCollab.Assignments.Core.Domain;
+using SchoolCollab.Assignments.Core.Domain.Exceptions;
+using SchoolCollab.Assignments.Core.Services;
+using SchoolCollab.Core.AssignmentPolicies;
+using SchoolCollab.Core.CQRS;
+using SchoolCollab.Core.Notifications;
+using SchoolCollab.Students.Core.Domain;
+
+namespace SchoolCollab.Assignments.Core.CQRS.Assignments.Queries.GetAssignmentAudiencePreview;
+
+/// <summary>
+/// The DRAFT audience read (spec §4.2 Q152, round plan P2b): the same rows the published read
+/// returns, resolved from the assignment's persisted targets through the same resolver, the same
+/// batched subscriber read and the same policy filter publish runs — with
+/// <see cref="AudienceDeliveryStateDto.NotPublishingYet"/> where the published read would carry a
+/// delivery state. <b>Nothing is persisted</b>: publish re-resolves, and the panel says so in words.
+/// <para>It exists because the published read is log-backed and a draft has no log rows, while the
+/// view page draws one table in both states (Q152). It is a page-load read, never the authoring
+/// surface's 500 ms debounce — that one keeps the counts-only <c>recipient-preview</c>.</para>
+/// </summary>
+public sealed record GetAssignmentAudiencePreview(Guid AssignmentId) : IQuery<AssignmentAudienceDto>;
+
+/// <summary>Handles <see cref="GetAssignmentAudiencePreview"/>.</summary>
+/// <remarks>
+/// A contact the publish-time filter would drop is still returned, as
+/// <see cref="AudienceDeliveryStateDto.BlockedByPolicy"/>: the draft panel exists to answer "who will
+/// be told", and an omitted contact answers it with silence. Nothing here writes — no recipient row,
+/// no gate, no log entry.
+/// </remarks>
+public sealed class GetAssignmentAudiencePreviewHandler(
+    AssignmentsDbContext db,
+    IAssignmentTargetResolver targetResolver,
+    IContactResolver contactResolver,
+    INotificationPolicyResolver policyResolver,
+    IAssignmentPolicyResolver assignmentPolicyResolver,
+    ILogger<GetAssignmentAudiencePreviewHandler> logger)
+    : IQueryHandler<GetAssignmentAudiencePreview, AssignmentAudienceDto>
+{
+    /// <inheritdoc />
+    public async Task<AssignmentAudienceDto> HandleAsync(
+        GetAssignmentAudiencePreview query,
+        CancellationToken cancellationToken = default)
+    {
+        var assignment = await db.Assignments
+            .AsNoTracking()
+            .SingleOrDefaultAsync(a => a.Id == query.AssignmentId, cancellationToken)
+            ?? throw new AssignmentNotFoundException(query.AssignmentId);
+
+        var targets = assignment.Targets;
+        if (targets.Count == 0)
+        {
+            return new AssignmentAudienceDto([], false, false);
+        }
+
+        Guid[] cohort;
+        try
+        {
+            cohort = await targetResolver.ResolveStudentIdsAsync(
+                targets.Select(target => new TargetConstraint(target.Kind, target.RefId)).ToArray(),
+                targets.Any(target => target.Kind == TargetKind.AllStudents),
+                cancellationToken);
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex,
+                "Target resolution failed for assignment {AssignmentId}; the draft audience preview is unavailable",
+                assignment.Id);
+            return new AssignmentAudienceDto([], false, true);
+        }
+
+        if (cohort.Length == 0)
+        {
+            return new AssignmentAudienceDto([], false, false);
+        }
+
+        var tenantId = db.CurrentTenantId;
+        var gradeTargetIds = AssignmentPolicyScope.GradeTargetIds(assignment);
+        var policyGradeId = AssignmentPolicyScope.DeriveGrade(gradeTargetIds);
+
+        IReadOnlyList<SubscriberInfo> subscribers;
+        try
+        {
+            subscribers = await contactResolver.ResolveSubscribersAsync(
+                new ResolveSubscribersRequest(
+                    tenantId,
+                    SubscriptionScope.AllAssignments,
+                    gradeTargetIds,
+                    cohort,
+                    assignment.TopicId),
+                cancellationToken);
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex,
+                "Subscriber resolution failed for assignment {AssignmentId}; the draft audience preview is unavailable",
+                assignment.Id);
+            return new AssignmentAudienceDto([], false, true);
+        }
+
+        // The recipients are transient projections — they exist only to feed the one pure filter
+        // publish itself runs, so "will notify" means exactly what publish would send.
+        var projected = subscribers
+            .Where(subscriber => subscriber.StudentId.HasValue)
+            .Select(subscriber => AssignmentRecipient.Create(
+                tenantId,
+                Guid.Empty,
+                subscriber.OwnerType,
+                subscriber.OwnerId,
+                subscriber.StudentId,
+                subscriber.ContactId,
+                subscriber.Channel,
+                subscriber.Role,
+                notifyOnBroadcast: true,
+                subscriptionActive: true))
+            .ToList();
+
+        // The two policy reads are a remote hop like the two above: an outage there must degrade the
+        // panel to its stated empty state, never 500 the endpoint the page loads with.
+        EffectiveNotificationPolicy effectivePolicy;
+        EffectiveAssignmentPolicy assignmentPolicy;
+        try
+        {
+            effectivePolicy = await policyResolver.ResolveEffectiveAsync(tenantId, policyGradeId, cancellationToken);
+            assignmentPolicy = await assignmentPolicyResolver.ResolveAsync(policyGradeId, cancellationToken);
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex,
+                "Policy resolution failed for assignment {AssignmentId}; the draft audience preview is unavailable",
+                assignment.Id);
+            return new AssignmentAudienceDto([], false, true);
+        }
+
+        var reachable = NotificationRecipientFilter
+            .Apply(projected, effectivePolicy, assignmentPolicy)
+            .Select(recipient => (recipient.ContactId, recipient.WardStudentId))
+            .ToHashSet();
+
+        var names = subscribers
+            .Where(subscriber => subscriber.StudentId.HasValue)
+            .GroupBy(subscriber => subscriber.StudentId!.Value)
+            .ToDictionary(
+                group => group.Key,
+                group => group.Select(subscriber => subscriber.StudentName)
+                    .FirstOrDefault(name => !string.IsNullOrWhiteSpace(name)) ?? string.Empty);
+
+        var rows = cohort
+            .OrderBy(studentId => names.TryGetValue(studentId, out var name) ? name : string.Empty, StringComparer.OrdinalIgnoreCase)
+            .ThenBy(studentId => studentId)
+            .Take(AudienceLimits.AudienceCap)
+            .Select(studentId => new AudienceStudentDto(
+                studentId,
+                names.TryGetValue(studentId, out var studentName) ? studentName : string.Empty,
+                projected.Exists(recipient =>
+                    recipient.WardStudentId == studentId
+                    && reachable.Contains((recipient.ContactId, recipient.WardStudentId))),
+                projected
+                    .Where(recipient => recipient.WardStudentId == studentId)
+                    .OrderBy(recipient => (int)recipient.Channel)
+                    .ThenBy(recipient => (int)recipient.OwnerType)
+                    .Select(recipient => new AudienceContactDto(
+                        (ContactOwnerTypeDto)recipient.OwnerType,
+                        (ContactChannelDto)recipient.Channel,
+                        recipient.Role is { } role ? (GuardianRoleDto)role : null,
+                        recipient.SubscriptionActive,
+                        recipient.NotifyOnBroadcast,
+                        reachable.Contains((recipient.ContactId, recipient.WardStudentId))
+                            ? AudienceDeliveryStateDto.NotPublishingYet
+                            : AudienceDeliveryStateDto.BlockedByPolicy,
+                        SentAt: null,
+                        OpenedAt: null,
+                        FailureReason: null,
+                        RetryScheduled: false,
+                        TemplateId: null))
+                    .ToList()))
+            .ToList();
+
+        return new AssignmentAudienceDto(rows, cohort.Length > AudienceLimits.AudienceCap, false);
+    }
+}
