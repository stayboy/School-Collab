diff --git a/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/QuestionsTable.razor b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/QuestionsTable.razor
new file mode 100644
index 00000000..5dd53d0f
--- /dev/null
+++ b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/QuestionsTable.razor
@@ -0,0 +1,188 @@
+@using Microsoft.FluentUI.AspNetCore.Components
+@using SchoolCollab.Admin.Shared.Components
+@using SchoolCollab.Assignments.Application.Helpers
+@using SchoolCollab.Assignments.Contracts
+
+@*
+    The assignment view page's Questions block (spec §4.8, §4.9; round plan P7, R7/D2) — the page's
+    OWN block, not the authoring surface's editor rendered twice: the authoring `Embedded` body
+    suppresses its own Questions hint, and this table is what a reader sees instead.
+
+    READ-ONLY, no editing affordance: questions are authored on `/assignments/{id}/edit`.
+
+    FOUR columns, `#` · Question · Type · Options — and NO POINTS COLUMN. `AssignmentQuestionReadDto`
+    carries no points field (`Id, QuestionText, QuestionType, DisplayOrder, ModelAnswer?, Options[],
+    GenerationId?, ResponseKinds?, Instructions?`); the 2c mock drew a `pts` column and the mock is
+    recorded as corrected. Nothing is invented to fill a column the payload cannot answer.
+
+    NO NEW READ: the page hands over the questions collection of the authoring child read it already
+    makes. Paging is the contract `AudienceTable` established (P7/R5) — rows-per-page in the PANEL
+    HEADER, the range and the pager sharing the FOOTER, and neither when the set fits on one page.
+*@
+
+<PanelSection Id="assignment-questions"
+              Title="Questions"
+              TitleId="assignment-questions-title"
+              ShowBorder="false"
+              Count="@Questions?.Count">
+    <HeaderActions>
+        @* R5/Q162: no rows-per-page selector when there is only one page — a choice that changes
+           nothing. *@
+        @if (ShowPagerWhenItFits)
+        {
+            <span class="questions-rows-per-page" id="assignment-questions-rows-per-page">
+                <DropdownComponent TItem="int" TValue="int?"
+                                   Items="@PageSizes"
+                                   @bind-SelectedValue="_pageSize"
+                                   @bind-SelectedValue:after="OnPageSizeChanged"
+                                   OptionText="@(size => size.ToString())"
+                                   OptionValue="@(size => (int?)size)"
+                                   AriaLabel="Rows per page"
+                                   Width="FieldWidth.W3" />
+                <span class="questions-rows-per-page__label">rows per page</span>
+            </span>
+        }
+    </HeaderActions>
+
+    <ChildContent>
+        @if (Questions is null)
+        {
+            @* A failed child read degrades to one sentence inside this panel; the rest of the page
+               (Delivery, Status) is unaffected (P7). *@
+            <p class="questions-note" id="assignment-questions-unavailable">
+                Questions could not be loaded. The rest of the page is unaffected.
+            </p>
+        }
+        else if (Questions.Count == 0)
+        {
+            <p class="questions-note" id="assignment-questions-empty">No questions yet.</p>
+        }
+        else
+        {
+            <table class="questions-table" id="assignment-questions-table">
+                <thead>
+                    <tr>
+                        <th class="questions-table__number">#</th>
+                        <th class="questions-table__question">Question</th>
+                        <th class="questions-table__type">Type</th>
+                        <th class="questions-table__options">Options</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @foreach (var (question, offset) in PageRows.Select((row, index) => (row, index)))
+                    {
+                        <tr class="questions-row" @key="question.Id">
+                            <td class="questions-table__number">@(FirstRowNumber + offset)</td>
+                            <td class="questions-table__question">@QuestionText(question)</td>
+                            <td class="questions-table__type">@EnumHelper.GetDescription(question.QuestionType)</td>
+                            <td class="questions-table__options">@OptionsText(question)</td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+
+            <div class="questions-footer" id="assignment-questions-footer">
+                <span class="questions-footer__range" id="assignment-questions-range">@RangeText</span>
+                @if (ShowPagerWhenItFits)
+                {
+                    <FluentPaginator State="@_paginationState" />
+                }
+            </div>
+        }
+    </ChildContent>
+</PanelSection>
+
+@code {
+    /// <summary>The rows-per-page choices the two growing grids offer (Q156).</summary>
+    private static readonly IReadOnlyList<int> PageSizes = [15, 25, 50];
+
+    private const int DefaultPageSize = 15;
+
+    private readonly PaginationState _paginationState = new() { ItemsPerPage = DefaultPageSize };
+
+    /// <summary><c>int?</c> because the wrapper's two-way binding is over the nullable key.</summary>
+    private int? _pageSize = DefaultPageSize;
+
+    /// <summary>
+    /// The assignment's persisted questions, from the child read the page already makes.
+    /// <see langword="null"/> means that read FAILED: the page awaits it before it renders the grid, so
+    /// null can only be the outage, and the panel says so rather than showing an empty list it cannot
+    /// vouch for.
+    /// </summary>
+    [Parameter] public IReadOnlyList<AssignmentQuestionReadDto>? Questions { get; set; }
+
+    private int EffectivePageSize => _pageSize ?? DefaultPageSize;
+
+    /// <summary>The pager is DERIVED from the row count, never chosen by the caller (Q162).</summary>
+    private bool ShowPagerWhenItFits =>
+        Questions is { Count: > 0 } questions && questions.Count > EffectivePageSize;
+
+    private int PageIndex => Math.Min(_paginationState.CurrentPageIndex, LastPageIndex(Questions?.Count ?? 0));
+
+    /// <summary>The `#` of the page's first row — the position in the whole set, never in the page.</summary>
+    private int FirstRowNumber => (PageIndex * EffectivePageSize) + 1;
+
+    private IEnumerable<AssignmentQuestionReadDto> PageRows =>
+        Questions is null
+            ? []
+            : Questions.Skip(PageIndex * EffectivePageSize).Take(EffectivePageSize);
+
+    private string RangeText
+    {
+        get
+        {
+            if (Questions is not { Count: > 0 } questions)
+            {
+                return "No rows";
+            }
+
+            var first = (PageIndex * EffectivePageSize) + 1;
+            var last = Math.Min(first + EffectivePageSize - 1, questions.Count);
+            return $"Showing {first}–{last} of {questions.Count}";
+        }
+    }
+
+    protected override void OnParametersSet()
+    {
+        var total = Questions?.Count ?? 0;
+
+        if (_paginationState.ItemsPerPage != EffectivePageSize)
+        {
+            _paginationState.ItemsPerPage = EffectivePageSize;
+        }
+
+        _ = _paginationState.SetTotalItemCountAsync(total);
+
+        var lastPageIndex = LastPageIndex(total);
+        if (_paginationState.CurrentPageIndex > lastPageIndex)
+        {
+            _ = _paginationState.SetCurrentPageIndexAsync(lastPageIndex);
+        }
+    }
+
+    private int LastPageIndex(int totalRows) =>
+        totalRows == 0 ? 0 : (totalRows - 1) / Math.Max(1, EffectivePageSize);
+
+    private void OnPageSizeChanged()
+    {
+        _paginationState.ItemsPerPage = EffectivePageSize;
+        _ = _paginationState.SetCurrentPageIndexAsync(0);
+    }
+
+    /// <summary>The editor's own empty-title wording, reused so the two readings of a blank question
+    /// agree.</summary>
+    private static string QuestionText(AssignmentQuestionReadDto question) =>
+        string.IsNullOrWhiteSpace(question.QuestionText) ? "Untitled question" : question.QuestionText;
+
+    /// <summary>The options as one line, the correct one marked. Short-answer rows carry no options —
+    /// the payload has none — so they read as absent, never as a fabricated empty set.</summary>
+    private static string OptionsText(AssignmentQuestionReadDto question)
+    {
+        var options = question.Options ?? [];
+
+        return options.Count == 0
+            ? "—"
+            : string.Join(" · ", options.Select(option =>
+                option.IsCorrect ? $"{option.OptionText} ✓" : option.OptionText));
+    }
+}
diff --git a/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/QuestionsTable.razor.css b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/QuestionsTable.razor.css
new file mode 100644
index 00000000..d33f096e
--- /dev/null
+++ b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/QuestionsTable.razor.css
@@ -0,0 +1,89 @@
+/*
+    The Questions table's own styles (spec §4.8; round plan P7/R7).
+
+    The same shape `AudienceTable` established — a panel-internal table with the rows-per-page control
+    in the header and the range plus the pager in the footer — so the two growing grids on this page
+    read as one pattern. Token colours only, each with its light fallback (§3 of
+    panel-layout-pattern.md). CSS isolation keeps these class names local to this component, which is
+    why the labels are not shared with the audience table's file.
+*/
+
+.questions-rows-per-page {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+}
+
+.questions-rows-per-page__label {
+    color: var(--neutral-foreground-hint, #616161);
+    font-size: 0.8125rem;
+    white-space: nowrap;
+}
+
+.questions-table {
+    width: 100%;
+    border-collapse: collapse;
+    font-size: 0.875rem;
+}
+
+/* The header rule is the only rule above the body: this is a list inside a panel, not a second box
+   (§3: never nest a box in a box). */
+.questions-table thead th {
+    padding: 4px 8px 6px;
+    border-bottom: 1px solid var(--neutral-stroke-divider-rest, #e1e1e1);
+    color: var(--neutral-foreground-hint, #616161);
+    font-size: 0.75rem;
+    font-weight: 600;
+    text-align: left;
+    white-space: nowrap;
+}
+
+.questions-table tbody td {
+    padding: 6px 8px;
+    vertical-align: top;
+}
+
+.questions-row + .questions-row td {
+    border-top: 1px solid var(--neutral-stroke-divider-rest, #e1e1e1);
+}
+
+/* The authored order is the row's own fact, so the number is read as data, not as decoration. */
+.questions-table__number {
+    color: var(--neutral-foreground-hint, #616161);
+    font-variant-numeric: tabular-nums;
+    white-space: nowrap;
+}
+
+.questions-table__type {
+    white-space: nowrap;
+}
+
+.questions-table__options {
+    color: var(--neutral-foreground-hint, #616161);
+}
+
+/* R5: the range and the pager share the footer, so "which rows am I looking at" is stated where the
+   control that changes it sits. */
+.questions-footer {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 8px 12px;
+    margin-top: 8px;
+    padding-top: 8px;
+    border-top: 1px solid var(--neutral-stroke-divider-rest, #e1e1e1);
+}
+
+.questions-footer__range {
+    color: var(--neutral-foreground-hint, #616161);
+    font-size: 0.8125rem;
+}
+
+/* The two non-table states: an empty set and an unavailable read. Both are one short sentence —
+   never an empty box the reader has to interpret. */
+.questions-note {
+    margin: 0;
+    color: var(--neutral-foreground-hint, #616161);
+    font-size: 0.875rem;
+}
diff --git a/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/StatusStrip.razor b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/StatusStrip.razor
new file mode 100644
index 00000000..97a5d9a9
--- /dev/null
+++ b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/StatusStrip.razor
@@ -0,0 +1,118 @@
+@using Microsoft.FluentUI.AspNetCore.Components
+@using SchoolCollab.Admin.Shared.Components
+
+@*
+    The Status panel (spec §4.8 Q155; round plan P8, R3): ONE panel, three segments — Progress ·
+    Guardian sign-off · Notifications — divided by coloured rules drawn from the `--status-*` tokens.
+    Three separate panels would each cost their own header, border and gap and would read as one fact
+    cut into three; as segments they cost one header and read in a single glance.
+
+    R3 — it renders on a DRAFT too, one shape in both states: `Not published yet` / `Not requested` /
+    `Nothing sent`, with one reason line beneath. Hiding it until publish would hide the panel a
+    reader needs BEFORE publishing.
+
+    P8 — the Progress segment's `Open progress` affordance renders DISABLED with its reason until the
+    progress page ships (round b). The page must never carry a link that 404s.
+*@
+<PanelSection Id="assignment-status" Title="Status" TitleId="assignment-status-title" ShowBorder="false">
+    <ChildContent>
+        <div class="status-strip" id="assignment-status-strip">
+
+            <div class="status-strip__segment status-strip__segment--progress" id="assignment-status-progress">
+                <div class="status-strip__label">Progress</div>
+                @if (Model.IsPublished)
+                {
+                    <p class="status-strip__line">Cohort @Model.Cohort</p>
+                    <p class="status-strip__line">Submitted @Model.Submitted · Graded @Model.Graded</p>
+                    <p class="status-strip__line">Reached @Model.Reached</p>
+                }
+                else
+                {
+                    <p class="status-strip__line">Not published yet</p>
+                    <p class="status-strip__line">—</p>
+                    <p class="status-strip__line">—</p>
+                }
+            </div>
+
+            <div class="status-strip__segment status-strip__segment--signoff" id="assignment-status-signoff">
+                <div class="status-strip__label">Guardian sign-off</div>
+                @if (!Model.SignOffRequested)
+                {
+                    <p class="status-strip__line">Not requested</p>
+                    <p class="status-strip__line">Outstanding —</p>
+                }
+                else
+                {
+                    <p class="status-strip__line">Signed @Model.Signed</p>
+                    <p class="status-strip__line">Outstanding @Model.Outstanding</p>
+                }
+            </div>
+
+            <div class="status-strip__segment status-strip__segment--notifications" id="assignment-status-notifications">
+                <div class="status-strip__label">Notifications</div>
+                @if (Model.IsPublished)
+                {
+                    <p class="status-strip__line">Queued @Model.Queued · Sent @Model.Sent</p>
+                    <p class="status-strip__line">Failed @Model.Failed · Skipped @Model.Skipped</p>
+                    <p class="status-strip__line">Retry scheduled @Model.RetryScheduled</p>
+                }
+                else
+                {
+                    <p class="status-strip__line">Nothing sent</p>
+                    <p class="status-strip__line">Queued 0</p>
+                    <p class="status-strip__line">Failed 0 · Skipped 0</p>
+                }
+            </div>
+        </div>
+
+        <p class="status-strip__foot" id="assignment-status-foot">
+            @if (Model.IsPublished)
+            {
+                <FluentButton Appearance="ButtonAppearance.Outline"
+                              Disabled="true"
+                              Title="@ProgressReason">Open progress</FluentButton>
+                <span class="status-strip__reason" id="assignment-status-progress-reason">@ProgressReason</span>
+            }
+            else
+            {
+                <span class="status-strip__reason" id="assignment-status-draft-reason">
+                    Delivery, sign-off and progress all start at publish.
+                </span>
+            }
+        </p>
+    </ChildContent>
+</PanelSection>
+
+@code {
+    /// <summary>The Progress affordance's reason — the one route this page cannot reach yet (P8).</summary>
+    private const string ProgressReason = "Progress page arrives with the submission queue";
+
+    /// <summary>The counts this panel draws. The page owns the reads; the panel owns one shape in
+    /// both states (R3), so every segment simply states its numbers.</summary>
+    [Parameter, EditorRequired] public StatusStripModel Model { get; set; } = default!;
+
+    /// <summary>
+    /// The Status panel's three segments.
+    /// <para><see cref="IsPublished"/> is "has ever been published" — the same test the audience read
+    /// uses — so an unpublished assignment keeps the draft wording while its log history survives.</para>
+    /// <para><see cref="Signed"/> / <see cref="Outstanding"/> are null when the assignment does not
+    /// request a signature, which is what makes the segment read `Not requested`.</para>
+    /// </summary>
+    public sealed record StatusStripModel(
+        bool IsPublished,
+        int Cohort,
+        int Submitted,
+        int Graded,
+        int Reached,
+        int? Signed,
+        int? Outstanding,
+        int Queued,
+        int Sent,
+        int Failed,
+        int Skipped,
+        int RetryScheduled)
+    {
+        /// <summary>Whether a guardian signature was ever requested for this assignment.</summary>
+        public bool SignOffRequested => Signed is not null;
+    }
+}
diff --git a/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/StatusStrip.razor.css b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/StatusStrip.razor.css
new file mode 100644
index 00000000..f015060a
--- /dev/null
+++ b/src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/StatusStrip.razor.css
@@ -0,0 +1,96 @@
+/*
+    The Status panel's own styles (spec §4.8 Q155; round plan P8, R3).
+
+    ONE panel, THREE segments divided by coloured vertical rules drawn from the `--status-*` tokens —
+    three separate panels would each cost a header, a border and a gap, and a stack of three short
+    panels reads as one fact cut into three. Tokens only, each with its light fallback (§3 of
+    panel-layout-pattern.md).
+*/
+
+.status-strip {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 0;
+}
+
+.status-strip__segment {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    padding: 0 16px;
+    min-width: 0;
+}
+
+/* The first segment leads with no rule; every other segment is separated by a coloured rule naming
+   the colour of the state it reports (info / success / warning, §4.8). */
+.status-strip__segment:first-child {
+    padding-left: 0;
+}
+
+.status-strip__segment + .status-strip__segment {
+    border-left: 3px solid var(--status-neutral-dot, #8a8a8a);
+}
+
+.status-strip__segment--signoff {
+    border-left-color: var(--status-success-dot, #107c41);
+}
+
+.status-strip__segment--notifications {
+    border-left-color: var(--status-warning-dot, #b8760a);
+}
+
+.status-strip__label {
+    color: var(--neutral-foreground-hint, #616161);
+    font-size: 0.6875rem;
+    font-weight: 700;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+}
+
+.status-strip__line {
+    margin: 0;
+    font-size: 0.8125rem;
+}
+
+.status-strip__foot {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 8px 12px;
+    margin: 12px 0 0;
+    padding-top: 12px;
+    border-top: 1px solid var(--neutral-stroke-divider-rest, #e1e1e1);
+    min-height: 24px;
+}
+
+.status-strip__reason {
+    color: var(--neutral-foreground-hint, #616161);
+    font-size: 0.8125rem;
+    font-style: italic;
+}
+
+/* The three segments stack on a narrow panel rather than squeezing one line of counts into a third
+   of the width. The rule becomes the separator in the stacked direction too. */
+@container region-grid-host (max-width: 720px) {
+    .status-strip {
+        grid-template-columns: minmax(0, 1fr);
+    }
+
+    .status-strip__segment {
+        padding: 8px 0;
+    }
+
+    .status-strip__segment + .status-strip__segment {
+        padding-left: 0;
+        border-left: none;
+        border-top: 3px solid var(--status-neutral-dot, #8a8a8a);
+    }
+
+    .status-strip__segment--signoff {
+        border-top-color: var(--status-success-dot, #107c41);
+    }
+
+    .status-strip__segment--notifications {
+        border-top-color: var(--status-warning-dot, #b8760a);
+    }
+}
