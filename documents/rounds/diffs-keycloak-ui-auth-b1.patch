diff --git a/tests/SchoolCollab.Core.Tests.Unit/Auth/PortalRedirectChallengeHandlerTests.cs b/tests/SchoolCollab.Core.Tests.Unit/Auth/PortalRedirectChallengeHandlerTests.cs
