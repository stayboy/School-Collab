diff --git a/tests/SchoolCollab.Students.Tests.Unit/ListSubscribedContactsNameEnrichmentTests.cs b/tests/SchoolCollab.Students.Tests.Unit/ListSubscribedContactsNameEnrichmentTests.cs
new file mode 100644
