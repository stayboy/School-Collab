+/* ── `.status-pill` — a CSS class, NOT a component (component-first-policy §2/§4/§6) ──────────────
+   The page renders four of these, all on one surface: that is ONE call site, so the second-call-site
+   extraction rule does not fire, and the §4 design-named exemption is not needed either. What it does
+   share is CSS, which is cheap and already precedented here (`.region-grid`, `.w-1`…`.w-9`, `.ta-lines-N`).
+   When a second surface wants a status pill it migrates to a component and takes this CSS with it — the
+   repo-wide migration is deliberately deferred.
+
+   Contrast is the reason the class exists. `<FluentBadge Appearance="Filled">` with no `Color` paints the
+   HOST `#0f6cbd` while its light-DOM `<span>` inherits `--neutral-foreground-1`, which app.css's global
+   `p, span, label, small, strong, em, code, pre` rule repaints `#242424` — 2.88:1, the same defect class as
+   the app bar fixed on 2026-10-24. Declaring both halves here is the fix; `Color="@BadgeColor.Success"`
+   cannot be it, because that variant's shipped rule is misspelled (`[color=sucess]`) in FluentUI 5.0.1.
+
+   Accessibility: every pill carries a TEXT label and an `aria-hidden` dot. Colour reinforces the label,
+   never replaces it, so the pill reads in greyscale and to a screen reader. */
+.status-pill {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    padding: 1px 8px;
+    border-radius: 999px;
+    border: 1px solid var(--status-neutral-border);
+    background: var(--status-neutral-bg);
+    color: var(--status-neutral-fg);
+    font-size: 0.6875rem;
+    font-weight: 600;
+    line-height: 1.5;
+    white-space: nowrap;
+}
+
+/* The global `span { color: … }` rule above is more specific than inheritance, so each pill's own
+   label span has to be told which foreground to take. Without this the text falls back to
+   `--neutral-foreground-1` and the pill loses its contrast guarantee. */
+.status-pill > span {
+    color: inherit;
+}
+
+.status-pill__dot {
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background: currentColor;
+    flex: 0 0 auto;
+}
+
+.status-pill--success {
+    background: var(--status-success-bg);
+    border-color: var(--status-success-border);
+    color: var(--status-success-fg);
+}
+
+.status-pill--success .status-pill__dot {
+    background: var(--status-success-dot);
+}
+
+.status-pill--warning {
+    background: var(--status-warning-bg);
+    border-color: var(--status-warning-border);
+    color: var(--status-warning-fg);
+}
+
+.status-pill--warning .status-pill__dot {
+    background: var(--status-warning-dot);
+}
+
+.status-pill--danger {
+    background: var(--status-danger-bg);
+    border-color: var(--status-danger-border);
+    color: var(--status-danger-fg);
+}
+
+.status-pill--danger .status-pill__dot {
+    background: var(--status-danger-dot);
+}
+
+.status-pill--neutral {
+    background: var(--status-neutral-bg);
+    border-color: var(--status-neutral-border);
+    color: var(--status-neutral-fg);
+}
+
+.status-pill--neutral .status-pill__dot {
+    background: var(--status-neutral-dot);
+}
