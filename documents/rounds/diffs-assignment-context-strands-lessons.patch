diff --git a/tests/SchoolCollab.Assignments.Tests.Integration/AssignmentContextPicksMigrationTests.cs b/tests/SchoolCollab.Assignments.Tests.Integration/AssignmentContextPicksMigrationTests.cs
new file mode 100644
