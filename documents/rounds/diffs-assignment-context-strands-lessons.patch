+    {
+        if (!LessonsLoaded)
+        {
+            return;
+        }
+
+        var selectedIds = (selected ?? []).Select(o => o.Id).ToList();
+        if (selectedIds.SequenceEqual(Model.ContextLessonIds))
+        {
+            return;
+        }
+
+        Model.ContextLessonIds.Clear();
+        Model.ContextLessonIds.AddRange(selectedIds);
+
+        await Changed.InvokeAsync();
+    }
+
+    private async Task RemoveStrand(Guid id)
