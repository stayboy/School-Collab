+    margin-top: 1.25rem;
+    padding-top: 1rem;
+    border-top: 1px solid var(--neutral-stroke-rest, #e0e0e0);
+}
+
+.stream-fields-section .hint {
+    margin: -0.5rem 0 0.75rem;
+    font-size: 0.8125rem;
+    opacity: 0.8;
+}
