+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    width: 100%;
+}
+
+.stream-create-pick-row ::deep .coded-value-dropdown {
+    flex: 1;
+    min-width: 0;
+}
+
+/* Icon-only FluentButton (switch to the editable fields) needs a square
+   footprint. ::deep is required because <fluent-button> is rendered by the
+   FluentButton child component in a different scope. */
+::deep .stream-icon-button {
+    min-width: 2rem;
+    min-height: 2rem;
+    padding: 0;
+}
+
+/* Horizontal separator (per dialog-ui §2) between the CodedValueDropdown
+   picker section and the stream fields below — CSS border-top, well padded. */
