+    [TestMethod]
+    public async Task Delete_RevokesAndReturnsTheRefreshToken_ThenGone()
+    {
+        await using var host = await AuthEndpointTestHost.StartAsync();
+        var sessionId = SeedSession(host);
+
+        var delete = await host.Client.DeleteAsync($"/auth/session/{sessionId}");
+        var getAfter = await host.Client.GetAsync($"/auth/session/{sessionId}");
+
+        delete.StatusCode.Should().Be(HttpStatusCode.OK);
+        var body = await delete.Content.ReadAsStringAsync();
+        JsonDocument.Parse(body).RootElement.GetProperty("refreshToken").GetString().Should().Be(RefreshToken);
+
+        // The refresh token is the PLAN-MANDATED exemption to the no-token-in-a-response-body
+        // rule (AC4 service-side half): the DELETE is called server-to-server by the portal,
+        // which forwards the value to Keycloak's revocation endpoint during logout. It is
+        // PINNED explicitly here so the exemption stays deliberate — if a change stops
+        // returning it, logout revocation breaks without any test noticing.
+
+        // ...and it is the ONLY token allowed out (P2-2 — reviewed into the pass): the session's
+        // access and id tokens must not travel with it. Raw-body scans, mirroring the redeem tests,
+        // so a token-shaped field added to DeleteSessionResponse fails this test.
+        body.Should().NotContain(AccessToken);
+        body.Should().NotContain(IdToken);
+        body.Should().NotContain("access_token");
+        body.Should().NotContain("id_token");
+
+        getAfter.StatusCode.Should().Be(HttpStatusCode.NotFound);
+    }
