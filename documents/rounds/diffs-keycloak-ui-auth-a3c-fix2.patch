+        var response = await host.Client.GetAsync($"/auth/session/{sessionId}");
+
+        response.StatusCode.Should().Be(HttpStatusCode.OK);
+        var json = await response.Content.ReadAsStringAsync();
+        using var doc = JsonDocument.Parse(json);
+        doc.RootElement.GetProperty("sessionId").GetString().Should().Be(sessionId);
+        doc.RootElement.GetProperty("expiresInSeconds").GetInt32().Should().Be(3600);
+        doc.RootElement.TryGetProperty("expiresAtUtc", out _).Should().BeTrue();
+
+        // AC9: the custody read exposes derived data ONLY. Scanning the RAW body — not the typed
+        // DTO — catches a token field added to the response payload later.
+        json.Should().NotContain(AccessToken);
+        json.Should().NotContain(RefreshToken);
+        json.Should().NotContain("access_token");
+        json.Should().NotContain("refresh_token");
