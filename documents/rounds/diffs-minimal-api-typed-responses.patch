diff --git a/src/Settings/SchoolCollab.Settings.Api/Endpoints/CodedValueCommandRoutes.cs b/src/Settings/SchoolCollab.Settings.Api/Endpoints/CodedValueCommandRoutes.cs
new file mode 100644
