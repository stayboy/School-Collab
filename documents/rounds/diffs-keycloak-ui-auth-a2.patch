@@ -0,0 +1,25 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace SchoolCollab.Auth.Endpoints;
+
+/// <summary>
+/// Maps the auth service's endpoint groups. Round A pass 2 carries the grouping
+/// extension plus a placeholder <c>GET /auth/ping</c> so the skeleton is
+/// exercisable and the wiring is real; passes 3c/3d replace/extend the group with
+/// the exchange/redeem/session and admin endpoints. Endpoint groups are always
+/// grouped extension methods (AGENTS.md) — never inline route maps in Program.cs.
+/// </summary>
+public static class AuthEndpointGroup
+{
+    /// <summary>Maps the <c>/auth</c> group under the app's route builder.</summary>
+    public static IEndpointRouteBuilder MapAuthEndpoints(this IEndpointRouteBuilder app)
+    {
+        var group = app.MapGroup("/auth");
+
+        group.MapGet("/ping", () => Results.Ok(new { status = "ok" }));
+
+        return app;
+    }
+}
