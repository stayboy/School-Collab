diff --git a/src/Assignments/SchoolCollab.Assignments.Core/Domain/Exceptions/TeacherTenantMismatchException.cs b/src/Assignments/SchoolCollab.Assignments.Core/Domain/Exceptions/TeacherTenantMismatchException.cs
