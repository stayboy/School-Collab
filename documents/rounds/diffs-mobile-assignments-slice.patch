diff --git a/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/AssignmentSubmissionsSection.razor b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/AssignmentSubmissionsSection.razor
