+using Microsoft.AspNetCore.Components.Authorization;
+using Microsoft.Extensions.Logging;
+using SchoolCollab.Assignments.Contracts;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The mobile assignment detail screen's state and behaviour — the device's replacement for the desktop
+/// detail page's <c>@code</c> block, so the load, the lifecycle actions, the approval decision and the
+/// per-student submission read are unit-testable without a device.
+/// </summary>
+/// <remarks>
+/// <para>
+/// It mirrors <c>src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/Detail.razor</c>
+/// for the surfaces this slice ships: the item read, the two independently failure-degraded
+/// enrichments (recipients, submissions), the lifecycle actions' reload-after-act shape, the approval
+/// decision's acting-teacher claim read, and the read-only per-student submission view. The authoring
+/// overview, the review/grade forms and the sign-off/notification tabs are out of slice scope (OD-2 and
+/// the round's scope list).
+/// </para>
+/// <para>
+/// The enrichment reads degrade rather than fail the page: a recipients or submissions failure is logged
+/// and leaves that section empty while the assignment itself stays loaded — the desktop page's behaviour,
+/// preserved so a thin endpoint can never take the whole screen down.
+/// </para>
+/// </remarks>
+public sealed class AssignmentDetailViewModel(
+    MobileAssignmentsApiClient api,
+    AuthenticationStateProvider authState,
+    ILogger<AssignmentDetailViewModel> logger) : IDisposable
+{
+    /// <summary>The acting-teacher claim the realm's mappers emit and the approval request carries.</summary>
+    private const string TeacherIdClaim = "teacher_id";
+
+    private readonly CancellationTokenSource _loadCts = new();
+    private volatile bool _disposed;
+
+    /// <summary>Raised after every state mutation, so the rendering component can re-render.</summary>
+    public event Action? Changed;
+
+    /// <summary>The assignment currently loaded; <see langword="null"/> until the read answers.</summary>
+    public AssignmentSummaryDto? Item { get; private set; }
+
+    /// <summary>The assignment id the actions act on, set by <see cref="LoadAsync"/>.</summary>
+    public Guid AssignmentId { get; private set; }
+
+    /// <summary>The publish recipients, or <see langword="null"/> when the read failed or 404'd.</summary>
+    public AssignmentRecipientDto[]? Recipients { get; private set; }
+
+    /// <summary>The submissions list, or <see langword="null"/> when the read failed or 404'd.</summary>
+    public SubmissionForReviewDto[]? Submissions { get; private set; }
+
+    /// <summary>The per-student submission the user opened, if any.</summary>
+    public SubmissionDetailDto? SelectedSubmission { get; private set; }
+
+    /// <summary>Whether the main read is in flight.</summary>
+    public bool IsLoading { get; private set; }
+
+    /// <summary>Whether a lifecycle or approval action is in flight.</summary>
+    public bool IsBusy { get; private set; }
+
+    /// <summary>Whether the per-student submission read is in flight.</summary>
+    public bool IsLoadingSubmission { get; private set; }
+
+    /// <summary>The assignment read's failure — the only failure that owns the screen's error state.</summary>
+    public string? Error { get; private set; }
+
+    /// <summary>The last failed lifecycle action's message, or <see langword="null"/>.</summary>
+    /// <remarks>
+    /// Reported apart from <see cref="Error"/> on purpose: the error branch replaces the whole screen, so
+    /// an action failure routed through it unmounted the very screen the button lived on. It renders as a
+    /// bar above the still-rendered assignment instead.
+    /// </remarks>
+    public string? ActionError { get; private set; }
+
+    /// <summary>The action-failure bar's title, e.g. "Could not publish" (set with <see cref="ActionError"/>).</summary>
+    public string? ActionErrorTitle { get; private set; }
+
+    /// <summary>
+    /// Set when an action succeeded but the re-read that follows it failed: the screen is showing pre-action
+    /// state and says so rather than silently diverging from what the server now holds.
+    /// </summary>
+    public string? ReloadWarning { get; private set; }
+
+    /// <summary>
+    /// Whether this session can record an approval decision — i.e. it carries a usable <c>teacher_id</c>.
+    /// The decision is attributed to that claim, and the server rejects a <see cref="Guid.Empty"/> approver
+    /// from a real principal, so without it Approve/Reject are guaranteed failures and are not offered.
+    /// </summary>
+    public bool CanDecideApproval { get; private set; }
+
+    /// <summary>The approval surface's own failure, so an approval problem never masks the page.</summary>
+    public string? ApprovalError { get; private set; }
+
+    /// <summary>The per-student submission read's own failure.</summary>
+    public string? SubmissionError { get; private set; }
+
+    /// <summary>True when the read answered and the assignment does not exist (or is out of scope).</summary>
+    public bool NotFound => !IsLoading && Error is null && Item is null;
+
+    /// <summary>
+    /// Loads the assignment and its two enrichments. A 404 leaves <see cref="Item"/> null (see
+    /// <see cref="NotFound"/>); a cancelled request is a silent no-op; any other main-read failure is
+    /// reported through <see cref="Error"/>.
+    /// </summary>
+    /// <param name="id">The assignment to load.</param>
+    /// <param name="ct">An explicit token; when it cannot be cancelled the view model's own token is used.</param>
+    public async Task LoadAsync(Guid id, CancellationToken ct = default)
+    {
+        AssignmentId = id;
+        IsLoading = true;
+        NotifyChanged();
+
+        try
+        {
+            logger.LogInformation("Loading assignment {AssignmentId}", id);
+            Item = await api.GetByIdAsync(id, LoadToken(ct));
+            if (_disposed)
+            {
+                return;
+            }
+
+            CanDecideApproval = await GetActingTeacherIdAsync() != Guid.Empty;
+            ClearFailures();
+
+            if (Item is not null)
+            {
+                await LoadRecipientsAsync(id, ct);
+                await LoadSubmissionsAsync(id, ct);
+            }
+
+            logger.LogInformation("Loaded assignment {AssignmentId}", id);
+        }
+        catch (OperationCanceledException)
+        {
+            // The component navigated away.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to load assignment {AssignmentId}", id);
+            Error = ex.Message;
+        }
+        finally
+        {
+            if (!_disposed)
+            {
+                IsLoading = false;
+                NotifyChanged();
+            }
+        }
+    }
+
+    /// <summary>
+    /// Re-reads the item after a lifecycle action — the desktop page's <c>ReloadItemAsync</c>. A failed
+    /// reload is logged and leaves the previous item in place, and it reports itself through
+    /// <see cref="ReloadWarning"/>, because the action it follows has already been accepted by the server.
+    /// </summary>
+    public async Task ReloadAsync()
+    {
+        if (_disposed || AssignmentId == Guid.Empty)
+        {
+            return;
+        }
+
+        try
+        {
+            Item = await api.GetByIdAsync(AssignmentId, _loadCts.Token);
+            if (_disposed)
+            {
+                return;
+            }
+
+            ReloadWarning = null;
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled: keep the item the screen already renders.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogWarning(ex, "Failed to reload assignment {AssignmentId}", AssignmentId);
+            ReloadWarning = "The action was accepted, but this screen could not re-read the assignment, "
+                + "so it may still show its previous state.";
+        }
+        finally
+        {
+            NotifyChanged();
+        }
+    }
+
+    /// <summary>Publishes the assignment, then re-reads it.</summary>
+    public Task PublishAsync() =>
+        RunActionAsync("publish", ActionSurface.Page, ct => api.PublishAsync(AssignmentId, ct));
+
+    /// <summary>Returns the assignment to draft, then re-reads it.</summary>
+    public Task UnpublishAsync() =>
+        RunActionAsync("unpublish", ActionSurface.Page, ct => api.UnpublishAsync(AssignmentId, ct));
+
+    /// <summary>Closes the assignment, then re-reads it.</summary>
+    public Task CloseAsync() =>
+        RunActionAsync("close", ActionSurface.Page, ct => api.CloseAsync(AssignmentId, ct));
+
+    /// <summary>
+    /// Submits the assignment for approval, then re-reads it. The failure surfaces on the approval
+    /// panel (the desktop page's <c>_approvalError</c>), because that is the button's own surface.
+    /// </summary>
+    public Task SubmitForApprovalAsync() =>
+        RunActionAsync("submit for approval", ActionSurface.Approval, ct => api.SubmitForApprovalAsync(AssignmentId, ct));
+
+    /// <summary>
+    /// Approves or rejects the pending assignment, attributing the decision to the session's
+    /// <c>teacher_id</c> claim, then re-reads the assignment. A failure surfaces in
+    /// <see cref="ApprovalError"/> and never throws through the UI.
+    /// </summary>
+    /// <param name="approve"><see langword="true"/> to approve, <see langword="false"/> to reject.</param>
+    public async Task SubmitApprovalDecisionAsync(bool approve)
+    {
+        if (_disposed || Item is null)
+        {
+            return;
+        }
+
+        IsBusy = true;
+        ApprovalError = null;
+        NotifyChanged();
+
+        try
+        {
+            var approverId = await GetActingTeacherIdAsync();
+            if (approve)
+            {
+                await api.ApproveAsync(AssignmentId, approverId, _loadCts.Token);
+            }
+            else
+            {
+                await api.RejectAsync(AssignmentId, approverId, _loadCts.Token);
+            }
+
+            await ReloadAsync();
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled: the panel keeps its previous state.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to record the approval decision for assignment {AssignmentId}", AssignmentId);
+            ApprovalError = ex.Message;
+        }
+        finally
+        {
+            if (!_disposed)
+            {
+                IsBusy = false;
+                NotifyChanged();
+            }
+        }
+    }
+
+    /// <summary>
+    /// Loads one student's submission (version history + review result) into
+    /// <see cref="SelectedSubmission"/>. The review/grade forms are out of slice scope (OD-2).
+    /// </summary>
+    public async Task SelectSubmissionAsync(Guid studentId)
+    {
+        if (_disposed)
+        {
+            return;
+        }
+
+        IsLoadingSubmission = true;
+        SubmissionError = null;
+        NotifyChanged();
+
+        try
+        {
+            SelectedSubmission = await api.GetSubmissionAsync(AssignmentId, studentId, _loadCts.Token);
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled: nothing to show.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to load submission for {AssignmentId}/{StudentId}", AssignmentId, studentId);
+            SubmissionError = ex.Message;
+        }
+        finally
+        {
+            if (!_disposed)
+            {
+                IsLoadingSubmission = false;
+                NotifyChanged();
+            }
+        }
+    }
+
+    /// <summary>Returns the submissions section to its list view.</summary>
+    public void ClearSelectedSubmission()
+    {
+        SelectedSubmission = null;
+        SubmissionError = null;
+        NotifyChanged();
+    }
+
+    /// <summary>Marks the view model dead and cancels its in-flight reads.</summary>
+    /// <remarks>Idempotent: the screen disposes the view model when it navigates away, and the container
+    /// also disposes any transient it created when the provider shuts down — a second
+    /// <see cref="CancellationTokenSource.Cancel"/> on an already-disposed source would throw.</remarks>
+    public void Dispose()
+    {
+        if (_disposed)
+        {
+            return;
+        }
+
+        _disposed = true;
+        _loadCts.Cancel();
+        _loadCts.Dispose();
+    }
+
+    /// <summary>
+    /// The lifecycle shape every action shares: run the call, re-read the item, and report a failure on
+    /// the surface that owns the button.
+    /// </summary>
+    private async Task RunActionAsync(string action, ActionSurface surface, Func<CancellationToken, Task> call)
+    {
+        if (_disposed || Item is null)
+        {
+            return;
+        }
+
+        IsBusy = true;
+        SetSurfaceError(surface, action, null);
+        NotifyChanged();
+
+        try
+        {
+            await call(_loadCts.Token);
+            await ReloadAsync();
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled: the screen keeps what it already shows.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to {Action} assignment {AssignmentId}", action, AssignmentId);
+            SetSurfaceError(surface, action, ex.Message);
+        }
+        finally
+        {
+            if (!_disposed)
+            {
+                IsBusy = false;
+                NotifyChanged();
+            }
+        }
+    }
+
+    /// <summary>
+    /// The acting teacher's id from the circuit principal's <c>teacher_id</c> claim — the same claim the
+    /// realm's mappers emit and the desktop page reads. No claim yields <see cref="Guid.Empty"/>, which
+    /// the server honours only under TestAuth (a real principal always wins).
+    /// </summary>
+    private async Task<Guid> GetActingTeacherIdAsync()
+    {
+        var state = await authState.GetAuthenticationStateAsync();
+        var claim = state.User.FindFirst(TeacherIdClaim)?.Value;
+        return Guid.TryParse(claim, out var id) ? id : Guid.Empty;
+    }
+
+    /// <summary>
+    /// Writes (or clears) the failure on the surface that owns the button — the approval panel for an
+    /// approval action, the action bar above the still-rendered assignment for a lifecycle one. Never
+    /// <see cref="Error"/>, which owns the screen-replacing load branch.
+    /// </summary>
+    private void SetSurfaceError(ActionSurface surface, string action, string? message)
+    {
+        if (surface == ActionSurface.Approval)
+        {
+            ApprovalError = message;
+            return;
+        }
+
+        ActionError = message;
+        ActionErrorTitle = message is null ? null : $"Could not {action}";
+    }
+
+    /// <summary>
+    /// Clears every failure surface a successful load supersedes: a message outliving the state it
+    /// described is what kept a reloaded screen behind its error branch.
+    /// </summary>
+    private void ClearFailures()
+    {
+        Error = null;
+        ActionError = null;
+        ActionErrorTitle = null;
+        ReloadWarning = null;
+    }
+
+    /// <summary>An explicit caller token wins; otherwise the view model's own token is used.</summary>
+    private CancellationToken LoadToken(CancellationToken ct) => ct.CanBeCanceled ? ct : _loadCts.Token;
+
+    private async Task LoadRecipientsAsync(Guid id, CancellationToken ct)
+    {
+        try
+        {
+            Recipients = await api.GetRecipientsAsync(id, LoadToken(ct));
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled with the page.
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex, "Failed to load recipients for {AssignmentId}", id);
+        }
+    }
+
+    private async Task LoadSubmissionsAsync(Guid id, CancellationToken ct)
+    {
+        try
+        {
+            Submissions = await api.ListSubmissionsAsync(id, LoadToken(ct));
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled with the page.
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex, "Failed to load submissions for {AssignmentId}", id);
+        }
+    }
+
+    private void NotifyChanged() => Changed?.Invoke();
+
+    /// <summary>Which surface owns a failed lifecycle action's error message.</summary>
+    private enum ActionSurface
+    {
+        /// <summary>The page-level error bar (publish / unpublish / close).</summary>
+        Page,
+
+        /// <summary>The approval panel's own error bar (submit-for-approval / approve / reject).</summary>
+        Approval,
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/AssignmentEnumDisplay.cs b/src/Mobile/SchoolCollab.Mobile.Logic/AssignmentEnumDisplay.cs
new file mode 100644
index 00000000..343eb872
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/AssignmentEnumDisplay.cs
@@ -0,0 +1,37 @@
+using System.ComponentModel;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// Reads <see cref="DescriptionAttribute"/> values from enum members, falling back to the member name —
+/// the assignments screens' display formatter for the slice's enum columns.
+/// </summary>
+/// <remarks>
+/// <b>A conscious copy</b> of <c>Assignments.Application.Helpers.EnumHelper</c> (17 BCL-only lines), not
+/// a move. The helper lives in <c>Assignments.Application</c>, which the head must not reference (that
+/// project's closure carries the <c>Microsoft.AspNetCore.App</c> FrameworkReference that broke
+/// <c>net10.0-android</c>), and moving it out would churn the nine <c>src/Assignments/</c> pages plus
+/// <c>QuestionPromptComposer.cs</c> that call it — exactly the diff the L4 round keeps out of that
+/// project (open PR #342 touches it). The duplication's drift cost is bounded to display text: a
+/// description added on one side only shows a raw enum name on the other, never a wrong value.
+/// </remarks>
+public static class AssignmentEnumDisplay
+{
+    /// <summary>
+    /// The <see cref="DescriptionAttribute"/> text of <paramref name="value"/>'s member, or the member
+    /// name when the member carries no attribute.
+    /// </summary>
+    /// <exception cref="ArgumentNullException"><paramref name="value"/> is <see langword="null"/>.</exception>
+    public static string GetDescription(Enum value)
+    {
+        ArgumentNullException.ThrowIfNull(value);
+
+        var field = value.GetType().GetField(value.ToString());
+        var attribute = field?
+            .GetCustomAttributes(typeof(DescriptionAttribute), false)
+            .Cast<DescriptionAttribute>()
+            .FirstOrDefault();
+
+        return attribute?.Description ?? value.ToString();
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/AssignmentsListViewModel.cs b/src/Mobile/SchoolCollab.Mobile.Logic/AssignmentsListViewModel.cs
new file mode 100644
index 00000000..85366a12
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/AssignmentsListViewModel.cs
@@ -0,0 +1,567 @@
+using Microsoft.Extensions.Logging;
+using SchoolCollab.Assignments.Contracts;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The mobile assignments list screen's state and behaviour — the device's replacement for the desktop
+/// page's <c>@code</c> block, so the load, the search, the status filter and the optimistic lifecycle
+/// actions are unit-testable without a device.
+/// </summary>
+/// <remarks>
+/// <para>
+/// Every method mirrors the desktop page it replaces
+/// (<c>src/Assignments/SchoolCollab.Assignments.Application/Components/Pages/Assignments/Index.razor</c>):
+/// same API calls, same optimistic-then-rollback shape for the lifecycle actions, same client-side
+/// title filter for search, same cancellation semantics. What is new is only the place it lives — the
+/// view model sits in <c>Mobile.Logic</c> (plain <c>net10.0</c>), per the round's OD3 rule that
+/// anything CI has to see lives there, not in the head.
+/// </para>
+/// <para>
+/// <see cref="Changed"/> is the render notification: the component subscribes and calls
+/// <c>StateHasChanged</c>. Without it an optimistic flip performed inside a view-model method could not
+/// paint before the round-trip completes, which is the whole point of the optimistic shape.
+/// </para>
+/// </remarks>
+public sealed class AssignmentsListViewModel(
+    MobileAssignmentsApiClient api,
+    ILogger<AssignmentsListViewModel> logger) : IDisposable
+{
+    /// <summary>The load-failure bar's title.</summary>
+    private const string LoadErrorTitle = "Could not load assignments";
+
+    /// <summary>The search-failure bar's title — the same bar, naming what actually failed.</summary>
+    private const string SearchErrorTitle = "Could not search assignments";
+
+    private CancellationTokenSource _loadCts = new();
+    private CancellationTokenSource _searchCts = new();
+    private readonly HashSet<Guid> _pendingActions = [];
+    private Func<Task>? _retryAction;
+    private int _activity;
+    private bool _errorIsFromSearch;
+    private volatile bool _disposed;
+
+    /// <summary>Raised after every state mutation, so the rendering component can re-render.</summary>
+    public event Action? Changed;
+
+    /// <summary>The loaded rows, or <see langword="null"/> while the first load is in flight.</summary>
+    public AssignmentSummaryDto[]? Items { get; private set; }
+
+    /// <summary>The client-side search result set; <see langword="null"/> while no search is active.</summary>
+    public AssignmentSummaryDto[]? SearchResults { get; private set; }
+
+    /// <summary>The active status filter; <see langword="null"/> lists every status.</summary>
+    public AssignmentStatusDto? StatusFilter { get; private set; }
+
+    /// <summary>The search box's text, trimmed.</summary>
+    public string SearchText { get; private set; } = string.Empty;
+
+    /// <summary>Whether a list fetch (load, filter reload or search fetch) is in flight.</summary>
+    public bool IsLoading { get; private set; }
+
+    /// <summary>The last <b>fetch</b> failure's message, or <see langword="null"/>.</summary>
+    /// <remarks>
+    /// A failed row action is deliberately NOT reported here: the screen renders its whole list only
+    /// while <see cref="Error"/> is clear, so routing an action failure through this property unmounted
+    /// the list the action came from. Action failures carry <see cref="ActionError"/> instead.
+    /// </remarks>
+    public string? Error { get; private set; }
+
+    /// <summary>The load-failure bar's title, naming what actually failed (set with <see cref="Error"/>).</summary>
+    public string? ErrorTitle { get; private set; }
+
+    /// <summary>The last failed row action's message, or <see langword="null"/>.</summary>
+    public string? ActionError { get; private set; }
+
+    /// <summary>The action-failure bar's title, e.g. "Could not publish" (set with <see cref="ActionError"/>).</summary>
+    public string? ActionErrorTitle { get; private set; }
+
+    /// <summary>Whether a non-empty search is narrowing the list.</summary>
+    public bool IsSearchActive => SearchText.Length > 0;
+
+    /// <summary>
+    /// Whether the row's <b>own</b> action is in flight — the card's disabled state. Deliberately not
+    /// <see cref="IsLoading"/>: that flag flips on every keystroke's search fetch and would grey out
+    /// every card's buttons while the user types.
+    /// </summary>
+    public bool IsActionPending(Guid id) => _pendingActions.Contains(id);
+
+    /// <summary>
+    /// The rows the screen should render: the search result set while a search is active, otherwise the
+    /// loaded list — in both cases narrowed to the active <see cref="StatusFilter"/>.
+    /// </summary>
+    /// <remarks>
+    /// The status filter is applied to BOTH slices. The search fetch itself asks for every status
+    /// (<see cref="SearchAsync"/>), and the loaded slice comes back already filtered from the server —
+    /// but an optimistic action can move a row out of the active filter, and a chip tap while a search
+    /// was active used to change nothing on screen. Filtering here is what keeps the rendered rows from
+    /// contradicting the chip.
+    /// </remarks>
+    public AssignmentSummaryDto[]? DisplayItems
+    {
+        get
+        {
+            var rows = IsSearchActive ? SearchResults : Items;
+            if (rows is null || StatusFilter is null)
+            {
+                return rows;
+            }
+
+            return [.. rows.Where(row => row.Status == StatusFilter)];
+        }
+    }
+
+    /// <summary>The empty-state message: search-aware, and honest about a filter that emptied the list.</summary>
+    public string EmptyMessage => IsSearchActive
+        ? $"No assignments match '{SearchText}'."
+        : StatusFilter is { } filter
+            ? $"No {filter} assignments."
+            : "No assignments yet.";
+
+    /// <summary>
+    /// Loads the list for the active <see cref="StatusFilter"/>. A cancelled request is a silent no-op;
+    /// any other failure is reported through <see cref="Error"/>.
+    /// </summary>
+    /// <param name="ct">An explicit token (a caller that owns its own cancellation); when it cannot be
+    /// cancelled the view model's own superseding token is used.</param>
+    public async Task LoadAsync(CancellationToken ct = default)
+    {
+        var activity = BeginActivity();
+
+        try
+        {
+            logger.LogInformation("Loading assignments list");
+            var items = await api.ListAsync(StatusFilter, LoadToken(ct));
+            if (_disposed)
+            {
+                return;
+            }
+
+            Items = items;
+            ClearFailures();
+            logger.LogInformation("Loaded {Count} assignments", Items?.Length ?? 0);
+        }
+        catch (OperationCanceledException)
+        {
+            // The component navigated away, or a newer load superseded this one.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to load assignments");
+            Error = ex.Message;
+            ErrorTitle = LoadErrorTitle;
+            _errorIsFromSearch = false;
+        }
+        finally
+        {
+            EndActivity(activity);
+        }
+    }
+
+    /// <summary>
+    /// Applies a status filter and reloads, cancelling the load it supersedes (the desktop page's
+    /// <c>OnStatusFilterChangedAsync</c>).
+    /// </summary>
+    /// <param name="filter">The new filter; <see langword="null"/> lists every status.</param>
+    /// <param name="ct">See <see cref="LoadAsync"/>.</param>
+    public async Task SetStatusFilterAsync(AssignmentStatusDto? filter, CancellationToken ct = default)
+    {
+        if (_disposed)
+        {
+            // A tap can still arrive after the screen navigated away and disposed this view model —
+            // and its token sources with it, so touching them here would throw.
+            return;
+        }
+
+        StatusFilter = filter;
+
+        _loadCts.Cancel();
+        _loadCts.Dispose();
+        _loadCts = new CancellationTokenSource();
+
+        await LoadAsync(ct);
+    }
+
+    /// <summary>
+    /// Applies the search text. A non-empty search fetches every status and filters titles client-side
+    /// (case-insensitive), cancelling the search it supersedes; an empty search clears the results (the
+    /// desktop page's <c>OnSearchValueChanged</c>).
+    /// </summary>
+    /// <param name="text">The raw search box text; whitespace is trimmed.</param>
+    /// <param name="ct">See <see cref="LoadAsync"/>.</param>
+    public async Task SearchAsync(string? text, CancellationToken ct = default)
+    {
+        if (_disposed)
+        {
+            return;
+        }
+
+        SearchText = text?.Trim() ?? string.Empty;
+
+        if (SearchText.Length == 0)
+        {
+            // The box was cleared: drop the results and invalidate any fetch still in flight, so a
+            // superseded search can neither repopulate them nor switch the spinner off under a load.
+            _activity++;
+            SearchResults = null;
+            IsLoading = false;
+            if (_errorIsFromSearch && Items is not null)
+            {
+                // The search that failed no longer exists, so its message no longer describes any state:
+                // the loaded list is what the screen shows again. The guard matters — with no loaded list
+                // to fall back to, the failure is still the truth about the screen.
+                Error = null;
+                ErrorTitle = null;
+                _errorIsFromSearch = false;
+            }
+
+            NotifyChanged();
+            return;
+        }
+
+        _searchCts.Cancel();
+        _searchCts.Dispose();
+        _searchCts = new CancellationTokenSource();
+
+        var activity = BeginActivity();
+
+        try
+        {
+            var results = await api.ListAsync(null, SearchToken(ct));
+            if (_disposed)
+            {
+                return;
+            }
+
+            SearchResults = results?
+                .Where(row => row.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
+                .ToArray();
+            ClearFailures();
+
+            logger.LogInformation(
+                "Search returned {Count} results for '{SearchText}'", SearchResults?.Length ?? 0, SearchText);
+        }
+        catch (OperationCanceledException)
+        {
+            // A newer keystroke superseded this search.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Search failed for '{SearchText}'", SearchText);
+            Error = ex.Message;
+            ErrorTitle = SearchErrorTitle;
+            _errorIsFromSearch = true;
+        }
+        finally
+        {
+            EndActivity(activity);
+        }
+    }
+
+    /// <summary>Publishes the row optimistically, rolling it back when the API call fails.</summary>
+    public Task PublishAsync(Guid id, CancellationToken ct = default) =>
+        ApplyStatusChangeAsync(
+            "publish",
+            id,
+            row => row with { Status = AssignmentStatusDto.Published },
+            (callCt) => api.PublishAsync(id, callCt),
+            ct);
+
+    /// <summary>Returns the row to draft optimistically, rolling it back when the API call fails.</summary>
+    public Task UnpublishAsync(Guid id, CancellationToken ct = default) =>
+        ApplyStatusChangeAsync(
+            "unpublish",
+            id,
+            row => row with { Status = AssignmentStatusDto.Draft },
+            (callCt) => api.UnpublishAsync(id, callCt),
+            ct);
+
+    /// <summary>Closes the row optimistically, rolling it back when the API call fails.</summary>
+    public Task CloseAsync(Guid id, CancellationToken ct = default) =>
+        ApplyStatusChangeAsync(
+            "close",
+            id,
+            row => row with { Status = AssignmentStatusDto.Closed },
+            (callCt) => api.CloseAsync(id, callCt),
+            ct);
+
+    /// <summary>
+    /// Marks the row's approval status pending optimistically, rolling it back when the API call fails.
+    /// </summary>
+    public Task SubmitForApprovalAsync(Guid id, CancellationToken ct = default) =>
+        ApplyStatusChangeAsync(
+            "submit for approval",
+            id,
+            row => row with { ApprovalStatus = ApprovalStatusDto.Pending },
+            (callCt) => api.SubmitForApprovalAsync(id, callCt),
+            ct);
+
+    /// <summary>
+    /// Deletes the assignment and drops the row (and its search-result twin) on success.
+    /// </summary>
+    /// <remarks>
+    /// A row the user confirmed that is no longer in the collection — a reload or a concurrent delete
+    /// removed it while the confirmation was open — is a no-op, never an error: the API is not called for
+    /// a target the screen no longer holds, and no failure is reported over an action with nothing to act
+    /// on.
+    /// </remarks>
+    public async Task DeleteAsync(Guid id, CancellationToken ct = default)
+    {
+        if (_disposed || !ContainsRow(id))
+        {
+            return;
+        }
+
+        BeginRowAction(id);
+        ClearActionError();
+
+        try
+        {
+            await api.DeleteAsync(id, LoadToken(ct));
+            if (_disposed)
+            {
+                return;
+            }
+
+            if (Items is not null)
+            {
+                Items = [.. Items.Where(row => row.Id != id)];
+            }
+
+            if (SearchResults is not null)
+            {
+                SearchResults = [.. SearchResults.Where(row => row.Id != id)];
+            }
+
+            logger.LogInformation("Deleted assignment {AssignmentId}", id);
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled: nothing was deleted from the server's point of view we can act on.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to delete assignment {AssignmentId}", id);
+            ReportActionFailure("delete", ex.Message, () => DeleteAsync(id));
+        }
+        finally
+        {
+            EndRowAction(id);
+        }
+    }
+
+    /// <summary>Re-runs the action whose failure is on the action bar, if there is one.</summary>
+    public async Task RetryActionAsync()
+    {
+        var retry = _retryAction;
+        if (_disposed || retry is null)
+        {
+            return;
+        }
+
+        // Cleared first: a retry that fails again re-arms itself through the same failure path.
+        _retryAction = null;
+        await retry();
+    }
+
+    /// <summary>Marks the view model dead and cancels its in-flight loads and searches.</summary>
+    /// <remarks>Idempotent: the screen disposes the view model when it navigates away, and the container
+    /// also disposes any transient it created when the provider shuts down — a second
+    /// <see cref="CancellationTokenSource.Cancel"/> on an already-disposed source would throw.</remarks>
+    public void Dispose()
+    {
+        if (_disposed)
+        {
+            return;
+        }
+
+        _disposed = true;
+
+        _loadCts.Cancel();
+        _loadCts.Dispose();
+        _searchCts.Cancel();
+        _searchCts.Dispose();
+    }
+
+    /// <summary>
+    /// The optimistic lifecycle shape every status action shares: stamp the new row locally, call the
+    /// API, restore the previous row and report through <see cref="Error"/> on failure (the desktop
+    /// page's per-action pattern).
+    /// </summary>
+    private async Task ApplyStatusChangeAsync(
+        string action,
+        Guid id,
+        Func<AssignmentSummaryDto, AssignmentSummaryDto> optimistic,
+        Func<CancellationToken, Task> call,
+        CancellationToken ct)
+    {
+        if (_disposed || Items is null)
+        {
+            return;
+        }
+
+        var index = Array.FindIndex(Items, row => row.Id == id);
+        if (index < 0)
+        {
+            // The row left the collection while the tap was in flight: nothing to flip, nothing to call.
+            return;
+        }
+
+        var previous = Items[index];
+        Items[index] = optimistic(previous);
+        SetSearchResult(id, Items[index]);
+        BeginRowAction(id);
+        ClearActionError();
+        NotifyChanged();
+
+        try
+        {
+            await call(LoadToken(ct));
+        }
+        catch (OperationCanceledException)
+        {
+            // Cancelled: the row keeps its optimistic value; a later load re-reads the truth.
+        }
+        catch (Exception ex)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            logger.LogError(ex, "Failed to {Action} assignment {AssignmentId}", action, id);
+
+            var restoreIndex = Array.FindIndex(Items, row => row.Id == id);
+            if (restoreIndex >= 0)
+            {
+                Items[restoreIndex] = previous;
+            }
+
+            SetSearchResult(id, previous);
+            ReportActionFailure(
+                action,
+                ex.Message,
+                () => ApplyStatusChangeAsync(action, id, optimistic, call, default));
+        }
+        finally
+        {
+            EndRowAction(id);
+        }
+    }
+
+    /// <summary>
+    /// Records a failed row action on the action bar — never on <see cref="Error"/>, which owns the
+    /// load-failure branch and therefore the whole list — and remembers how to retry it.
+    /// </summary>
+    private void ReportActionFailure(string action, string message, Func<Task> retry)
+    {
+        ActionError = message;
+        ActionErrorTitle = $"Could not {action}";
+        _retryAction = retry;
+    }
+
+    /// <summary>Whether the row is in either rendered collection.</summary>
+    private bool ContainsRow(Guid id) =>
+        Items?.Any(row => row.Id == id) == true || SearchResults?.Any(row => row.Id == id) == true;
+
+    /// <summary>Marks the row's own action as in flight, so only that row's buttons grey out.</summary>
+    private void BeginRowAction(Guid id)
+    {
+        _pendingActions.Add(id);
+        NotifyChanged();
+    }
+
+    /// <summary>Clears the row's action flag and repaints.</summary>
+    private void EndRowAction(Guid id)
+    {
+        _pendingActions.Remove(id);
+        NotifyChanged();
+    }
+
+    private void ClearActionError()
+    {
+        ActionError = null;
+        ActionErrorTitle = null;
+        _retryAction = null;
+    }
+
+    /// <summary>
+    /// Clears every failure surface after a successful fetch. A message outliving the state it described
+    /// is what kept a reloaded list hidden behind the load-failure branch.
+    /// </summary>
+    private void ClearFailures()
+    {
+        Error = null;
+        ErrorTitle = null;
+        _errorIsFromSearch = false;
+        ClearActionError();
+    }
+
+    /// <summary>
+    /// Mirrors one row substitution into the search result set: the screen renders that set while a
+    /// search is active, so an unmirrored flip (or rollback) would never be visible.
+    /// </summary>
+    private void SetSearchResult(Guid id, AssignmentSummaryDto row)
+    {
+        if (SearchResults is null)
+        {
+            return;
+        }
+
+        var index = Array.FindIndex(SearchResults, candidate => candidate.Id == id);
+        if (index >= 0)
+        {
+            SearchResults[index] = row;
+        }
+    }
+
+    /// <summary>An explicit caller token wins; otherwise the superseding load token is used.</summary>
+    private CancellationToken LoadToken(CancellationToken ct) => ct.CanBeCanceled ? ct : _loadCts.Token;
+
+    /// <summary>An explicit caller token wins; otherwise the superseding search token is used.</summary>
+    private CancellationToken SearchToken(CancellationToken ct) => ct.CanBeCanceled ? ct : _searchCts.Token;
+
+    /// <summary>
+    /// Starts a list operation (a load or a search fetch) and claims the loading flag for it. Loads
+    /// supersede each other — a status-filter change cancels the load it replaces, and each keystroke
+    /// the search before it — so the flag is owned by the NEWEST operation: the returning one carries
+    /// its claim token and only that one is allowed to switch the spinner off. Without this the
+    /// cancelled predecessor's completion clears the flag under its successor and the screen flashes
+    /// its empty state while the new request is still in flight.
+    /// </summary>
+    private int BeginActivity()
+    {
+        IsLoading = true;
+        NotifyChanged();
+        return ++_activity;
+    }
+
+    /// <summary>Releases the loading flag if <paramref name="activity"/> still owns it.</summary>
+    private void EndActivity(int activity)
+    {
+        if (_disposed || activity != _activity)
+        {
+            return;
+        }
+
+        IsLoading = false;
+        NotifyChanged();
+    }
+
+    private void NotifyChanged() => Changed?.Invoke();
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/MobileAssignmentsApiClient.cs b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAssignmentsApiClient.cs
new file mode 100644
index 00000000..19c2e5ee
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAssignmentsApiClient.cs
@@ -0,0 +1,212 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Microsoft.Extensions.Logging;
+using SchoolCollab.Assignments.Contracts;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The assignments slice's typed API client — the <b>twelve</b> methods the mobile assignments list
+/// and detail screens call, mirrored method-for-method from the server-side
+/// <c>Assignments.Application.Services.AssignmentsApiClient</c> (same route, verb, body and log
+/// semantics) and touching only <c>Assignments.Contracts</c> DTOs plus the BCL.
+/// </summary>
+/// <remarks>
+/// <para>
+/// A slice-scoped client exists instead of the 44-method server client because the head must not
+/// reference <c>Assignments.Application</c>: that project's closure carries a
+/// <c>Microsoft.AspNetCore.App</c> FrameworkReference through <c>Students.Application</c> — the very
+/// carrier that broke the head's <c>net10.0-android</c> build before L2 removed it. Two method families
+/// are deliberately absent and recorded in the L4 round doc: <c>GetEffectivePolicyAsync</c> (its return
+/// type, <c>SchoolCollab.Core.AssignmentPolicies.EffectiveAssignmentPolicy</c>, is pinned to the
+/// framework-carrying <c>Core</c> and has no caller in this slice) and the authoring / review / grade /
+/// duplicate methods (OD-2, OD-3).
+/// </para>
+/// <para>
+/// Base addresses are configuration, never C# literals (spec D8): every path below is relative and is
+/// appended to the configured <see cref="MobileApiOptions.AssignmentsApi"/> address by
+/// <see cref="MobileAssignmentsClientRegistration.AddMobileAssignmentsApiClient"/>.
+/// </para>
+/// </remarks>
+public sealed class MobileAssignmentsApiClient(HttpClient http, ILogger<MobileAssignmentsApiClient> logger)
+{
+    /// <summary>
+    /// The string-enum converter set for exactly the enums this slice's payloads carry — the slice's
+    /// mirror of the server client's set. A missing converter is not cosmetic: the API host registers
+    /// these enums as names (<c>src/Assignments/SchoolCollab.Assignments.Api/Program.cs:24-66</c>), so a
+    /// value that arrives as <c>"published"</c> or <c>"awaitingSignature"</c> deserializes only when its
+    /// converter is registered here.
+    /// </summary>
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
+    {
+        Converters =
+        {
+            new JsonStringEnumConverter<AssignmentTypeDto>(),
+            new JsonStringEnumConverter<AssignmentStatusDto>(),
+            new JsonStringEnumConverter<GradingFormatDto>(),
+            new JsonStringEnumConverter<TargetAudienceTypeDto>(),
+            new JsonStringEnumConverter<ApprovalStatusDto>(),
+            new JsonStringEnumConverter<ReviewStateDto>(),
+            new JsonStringEnumConverter<SubmissionSourceDto>(),
+            new JsonStringEnumConverter<GuardianRoleDto>(),
+            // Read-side tolerance, mirroring the server client: the delivery pair is registered even
+            // though no slice method returns a delivery DTO today, so a later read cannot be the place
+            // the wire form silently breaks.
+            new JsonStringEnumConverter<NotificationKindDto>(),
+            new JsonStringEnumConverter<ContactOwnerTypeDto>(),
+            new JsonStringEnumConverter<ContactChannelDto>(),
+            // SubmissionDetailDto.SignOffState is non-nullable and always present on the submission
+            // wire, so without this converter every GetSubmissionAsync call would throw JsonException.
+            new JsonStringEnumConverter<SignOffStateDto>(),
+        },
+    };
+
+    /// <summary>
+    /// Lists assignments, optionally filtered by status — <c>GET /assignments[?status=&lt;name&gt;]</c>.
+    /// The status travels as its enum name (the server client's shape); <see langword="null"/> lists
+    /// every status.
+    /// </summary>
+    public async Task<AssignmentSummaryDto[]?> ListAsync(
+        AssignmentStatusDto? status = null, CancellationToken ct = default)
+    {
+        var url = "/assignments";
+        if (status.HasValue)
+        {
+            url += $"?status={status.Value}";
+        }
+
+        logger.LogDebug("Listing assignments with status filter {Status}", status);
+        var result = await http.GetFromJsonAsync<AssignmentSummaryDto[]>(url, JsonOptions, ct);
+        logger.LogInformation("Listed {Count} assignments", result?.Length ?? 0);
+        return result;
+    }
+
+    /// <summary>
+    /// Reads one assignment — <c>GET /assignments/{id}</c>. A 404 is an expected answer (deleted or
+    /// out-of-scope assignment) and returns <see langword="null"/> rather than throwing.
+    /// </summary>
+    public async Task<AssignmentSummaryDto?> GetByIdAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogDebug("Getting assignment {AssignmentId}", id);
+        var response = await http.GetAsync($"/assignments/{id}", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound)
+        {
+            logger.LogWarning("Assignment {AssignmentId} not found", id);
+            return null;
+        }
+
+        response.EnsureSuccessStatusCode();
+        return await response.Content.ReadFromJsonAsync<AssignmentSummaryDto>(JsonOptions, ct);
+    }
+
+    /// <summary>Publishes a draft or scheduled assignment — <c>POST /assignments/{id}/publish</c>.</summary>
+    public async Task PublishAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogInformation("Publishing assignment {AssignmentId}", id);
+        (await http.PostAsJsonAsync($"/assignments/{id}/publish", (PublishAssignmentRequest?)null, JsonOptions, ct))
+            .EnsureSuccessStatusCode();
+    }
+
+    /// <summary>Returns a published assignment to draft — <c>POST /assignments/{id}/unpublish</c>.</summary>
+    public async Task UnpublishAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogInformation("Unpublishing assignment {AssignmentId}", id);
+        (await http.PostAsync($"/assignments/{id}/unpublish", null, ct)).EnsureSuccessStatusCode();
+    }
+
+    /// <summary>Closes an assignment — <c>POST /assignments/{id}/close</c>.</summary>
+    public async Task CloseAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogInformation("Closing assignment {AssignmentId}", id);
+        (await http.PostAsync($"/assignments/{id}/close", null, ct)).EnsureSuccessStatusCode();
+    }
+
+    /// <summary>
+    /// Submits a draft assignment for approval — <c>POST /assignments/{id}/submit-for-approval</c>.
+    /// </summary>
+    public async Task SubmitForApprovalAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogInformation("Submitting assignment {AssignmentId} for approval", id);
+        (await http.PostAsync($"/assignments/{id}/submit-for-approval", null, ct)).EnsureSuccessStatusCode();
+    }
+
+    /// <summary>
+    /// Approves a pending assignment — <c>POST /assignments/{id}/approve</c> with
+    /// <see cref="ApproveAssignmentRequest"/>. <paramref name="approverId"/> is server-ignored when the
+    /// principal carries a <c>teacher_id</c> claim (the principal wins).
+    /// </summary>
+    public async Task ApproveAsync(Guid id, Guid approverId, CancellationToken ct = default)
+    {
+        logger.LogInformation("Approving assignment {AssignmentId}", id);
+        (await http.PostAsJsonAsync($"/assignments/{id}/approve", new ApproveAssignmentRequest(approverId), JsonOptions, ct))
+            .EnsureSuccessStatusCode();
+    }
+
+    /// <summary>
+    /// Rejects a pending assignment — <c>POST /assignments/{id}/reject</c> with
+    /// <see cref="RejectAssignmentRequest"/>. <paramref name="approverId"/> has the same
+    /// principal-wins posture as <see cref="ApproveAsync"/>.
+    /// </summary>
+    public async Task RejectAsync(Guid id, Guid approverId, CancellationToken ct = default)
+    {
+        logger.LogInformation("Rejecting assignment {AssignmentId}", id);
+        (await http.PostAsJsonAsync($"/assignments/{id}/reject", new RejectAssignmentRequest(approverId), JsonOptions, ct))
+            .EnsureSuccessStatusCode();
+    }
+
+    /// <summary>Deletes an assignment — <c>DELETE /assignments/{id}</c>.</summary>
+    public async Task DeleteAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogInformation("Deleting assignment {AssignmentId}", id);
+        (await http.DeleteAsync($"/assignments/{id}", ct)).EnsureSuccessStatusCode();
+    }
+
+    /// <summary>
+    /// Reads an assignment's publish recipients — <c>GET /assignments/{id}/recipients</c>. A 404
+    /// returns <see langword="null"/>.
+    /// </summary>
+    public async Task<AssignmentRecipientDto[]?> GetRecipientsAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogDebug("Getting recipients for assignment {AssignmentId}", id);
+        var response = await http.GetAsync($"/assignments/{id}/recipients", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound)
+        {
+            return null;
+        }
+
+        response.EnsureSuccessStatusCode();
+        return await response.Content.ReadFromJsonAsync<AssignmentRecipientDto[]>(JsonOptions, ct);
+    }
+
+    /// <summary>
+    /// Lists an assignment's submissions — <c>GET /assignments/{id}/submissions</c>.
+    /// </summary>
+    public async Task<SubmissionForReviewDto[]?> ListSubmissionsAsync(Guid id, CancellationToken ct = default)
+    {
+        logger.LogDebug("Listing submissions for assignment {AssignmentId}", id);
+        var result = await http.GetFromJsonAsync<SubmissionForReviewDto[]>(
+            $"/assignments/{id}/submissions", JsonOptions, ct);
+        logger.LogInformation("Listed {Count} submissions", result?.Length ?? 0);
+        return result;
+    }
+
+    /// <summary>
+    /// Reads one student's submission with its version history — <c>GET
+    /// /assignments/{id}/students/{studentId}/submission</c>. A 404 returns <see langword="null"/>.
+    /// </summary>
+    public async Task<SubmissionDetailDto?> GetSubmissionAsync(
+        Guid id, Guid studentId, CancellationToken ct = default)
+    {
+        logger.LogDebug("Getting submission for assignment {AssignmentId} / student {StudentId}", id, studentId);
+        var response = await http.GetAsync($"/assignments/{id}/students/{studentId}/submission", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound)
+        {
+            return null;
+        }
+
+        response.EnsureSuccessStatusCode();
+        return await response.Content.ReadFromJsonAsync<SubmissionDetailDto>(JsonOptions, ct);
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/MobileAssignmentsClientRegistration.cs b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAssignmentsClientRegistration.cs
