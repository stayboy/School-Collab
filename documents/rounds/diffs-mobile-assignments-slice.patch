diff --git a/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Detail.razor b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Detail.razor
new file mode 100644
index 00000000..4b7a4bcf
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Detail.razor
@@ -0,0 +1,359 @@
+@page "/assignments/{Id:guid}"
+@using Microsoft.AspNetCore.Components.Authorization
+@using SchoolCollab.Assignments.Contracts
+@inject AssignmentDetailViewModel ViewModel
+@inject AuthenticationStateProvider AuthenticationStateProvider
+@inject OidcLoginService Login
+@inject NavigationManager Nav
+@implements IDisposable
+
+@* The mobile assignment detail screen (L4's first slice): a read-only header, the lifecycle action bar,
+   the approval decision panel when the assignment is gated on approval, the read-only recipients and
+   submissions sections, and nothing else. The desktop's authoring overview, review/grade forms,
+   sign-off and notification tabs are out of slice scope (OD-2 and the round's scope list).
+
+   Every styling hook sits on a plain element authored HERE (a child component's rendered root carries
+   the CHILD's CSS-isolation scope, so a rule in this file would never match a FluentUI component);
+   Detail.razor.css widens the phone layout to a two-column one at the tablet breakpoint. *@
+
+<PageTitle>@(ViewModel.Item?.Title ?? "Assignment")</PageTitle>
+
+<ErrorBoundary>
+    <ChildContent>
+        <AuthorizeView>
+            <Authorized>
+                <TenantGate>
+                    <ChildContent>
+                        @if (ViewModel.IsLoading)
+                        {
+                            <div class="assignment__busy" role="status" aria-label="Loading assignment">
+                                <FluentProgressRing />
+                            </div>
+                        }
+                        else if (ViewModel.Error is not null)
+                        {
+                            @* A load failure replaces the screen, so this branch owns its own way out:
+                               without it the only escape from a failed read was the phone's back gesture. *@
+                            <div class="assignment__failure">
+                                <FluentMessageBar Intent="MessageIntent.Error" Title="Could not load the assignment">
+                                    @ViewModel.Error
+                                </FluentMessageBar>
+                                <FluentButton Appearance="Appearance.Outline" OnClick="BackToListAsync">Back to list</FluentButton>
+                            </div>
+                        }
+                        else if (ViewModel.NotFound)
+                        {
+                            <div class="assignment__notice">
+                                <FluentMessageBar Intent="MessageIntent.Error">Assignment not found.</FluentMessageBar>
+                            </div>
+                            <FluentButton Appearance="Appearance.Outline" OnClick="BackToListAsync">Back to list</FluentButton>
+                        }
+                        else if (ViewModel.Item is { } item)
+                        {
+                            @* Both bars sit ABOVE the still-rendered assignment: neither a failed action
+                               nor a failed re-read may take the screen away from the user. *@
+                            @if (ViewModel.ActionError is not null)
+                            {
+                                <div class="assignment__failure">
+                                    <FluentMessageBar Intent="MessageIntent.Error" Title="@ViewModel.ActionErrorTitle">
+                                        @ViewModel.ActionError
+                                    </FluentMessageBar>
+                                </div>
+                            }
+
+                            @if (ViewModel.ReloadWarning is not null)
+                            {
+                                <div class="assignment__failure">
+                                    <FluentMessageBar Intent="MessageIntent.Warning" Title="Not refreshed">
+                                        @ViewModel.ReloadWarning
+                                    </FluentMessageBar>
+                                    <FluentButton Appearance="Appearance.Outline" OnClick="RefreshAsync">Refresh</FluentButton>
+                                </div>
+                            }
+
+                            <article class="assignment">
+                                <header class="assignment__header">
+                                    <h1 class="assignment__title">@item.Title</h1>
+                                    <div class="assignment__badges">
+                                        <FluentBadge Appearance="@StatusAppearance(item)">@item.Status</FluentBadge>
+                                        @if (item.MandatoryReview)
+                                        {
+                                            <FluentBadge Appearance="Appearance.Lightweight"
+                                                         Title="Guardian review required before students submit">
+                                                Review required
+                                            </FluentBadge>
+                                        }
+                                    </div>
+                                </header>
+
+                                <div class="assignment__card">
+                                    <div class="assignment__fields">
+                                        <FieldDisplay Label="Type">@AssignmentEnumDisplay.GetDescription(item.AssignmentType)</FieldDisplay>
+                                        <FieldDisplay Label="Grading">@AssignmentEnumDisplay.GetDescription(item.GradingFormat)</FieldDisplay>
+                                        <FieldDisplay Label="Audience">@AssignmentEnumDisplay.GetDescription(item.TargetAudienceType)</FieldDisplay>
+                                        <FieldDisplay Label="Due">@DueDateText(item)</FieldDisplay>
+                                        <FieldDisplay Label="Max score">@(item.MaxScore?.ToString("0.##") ?? "—")</FieldDisplay>
+                                        <FieldDisplay Label="Description">@(item.Description ?? "—")</FieldDisplay>
+                                    </div>
+                                </div>
+
+                                @if (item.RequiresApproval)
+                                {
+                                    <div class="assignment__card">
+                                        <h2 class="assignment__section-title">Approval</h2>
+                                        <div class="assignment__approval-state">
+                                            <FluentBadge Appearance="@ApprovalAppearance(item)">@ApprovalText(item)</FluentBadge>
+                                        </div>
+
+                                        <div class="assignment__approval-actions">
+                                            @if (item.Status == AssignmentStatusDto.Draft && (item.ApprovalStatus is null || item.ApprovalStatus == ApprovalStatusDto.Rejected))
+                                            {
+                                                <FluentButton Appearance="Appearance.Accent"
+                                                              Disabled="@ViewModel.IsBusy"
+                                                              OnClick="@(() => ViewModel.SubmitForApprovalAsync())">
+                                                    Submit for approval
+                                                </FluentButton>
+                                            }
+                                            @* Gated on the session, not on the status alone: without a
+                                               teacher_id claim the decision would be attributed to
+                                               Guid.Empty and the server would reject it. *@
+                                            @if (item.ApprovalStatus == ApprovalStatusDto.Pending && ViewModel.CanDecideApproval)
+                                            {
+                                                <FluentButton Appearance="Appearance.Accent"
+                                                              Disabled="@ViewModel.IsBusy"
+                                                              OnClick="@(() => ViewModel.SubmitApprovalDecisionAsync(true))">
+                                                    Approve
+                                                </FluentButton>
+                                                <FluentButton Appearance="Appearance.Outline"
+                                                              Disabled="@ViewModel.IsBusy"
+                                                              OnClick="@(() => ViewModel.SubmitApprovalDecisionAsync(false))">
+                                                    Reject
+                                                </FluentButton>
+                                            }
+                                        </div>
+
+                                        @if (item.ApprovalStatus == ApprovalStatusDto.Pending && !ViewModel.CanDecideApproval)
+                                        {
+                                            <div class="assignment__notice">
+                                                <FluentMessageBar Intent="MessageIntent.Info" Title="Decision not available">
+                                                    This session has no teacher id to attribute the decision to,
+                                                    so Approve and Reject are not offered here. Ask the
+                                                    assignment's teacher to record it.
+                                                </FluentMessageBar>
+                                            </div>
+                                        }
+
+                                        @if (ViewModel.ApprovalError is not null)
+                                        {
+                                            <div class="assignment__notice">
+                                                <FluentMessageBar Intent="MessageIntent.Error">@ViewModel.ApprovalError</FluentMessageBar>
+                                            </div>
+                                        }
+                                    </div>
+                                }
+
+                                <div class="assignment__body">
+                                    <div class="assignment__section">
+                                        <AssignmentRecipientsSection Recipients="ViewModel.Recipients" />
+                                    </div>
+                                    <div class="assignment__section">
+                                        <AssignmentSubmissionsSection Submissions="ViewModel.Submissions"
+                                                                      SelectedSubmission="ViewModel.SelectedSubmission"
+                                                                      Busy="@ViewModel.IsLoadingSubmission"
+                                                                      Error="@ViewModel.SubmissionError"
+                                                                      OnSelect="ViewModel.SelectSubmissionAsync"
+                                                                      OnBack="ViewModel.ClearSelectedSubmission" />
+                                    </div>
+                                </div>
+
+                                @* Bottom-anchored on a phone (Detail.razor.css widens it in place on a
+                                   tablet): the lifecycle actions this slice owns. Duplicate and the
+                                   Schedule/Archive transitions stay out (OD-3 and the scope list). *@
+                                <div class="assignment__actions">
+                                    <FluentButton Appearance="Appearance.Outline" OnClick="BackToListAsync">Back to list</FluentButton>
+                                    @if (item.Status == AssignmentStatusDto.Draft)
+                                    {
+                                        <FluentButton Appearance="Appearance.Accent"
+                                                      Disabled="@ViewModel.IsBusy"
+                                                      OnClick="@(() => ViewModel.PublishAsync())">
+                                            Publish
+                                        </FluentButton>
+                                    }
+                                    else if (item.Status == AssignmentStatusDto.Published)
+                                    {
+                                        <FluentButton Appearance="Appearance.Outline"
+                                                      Disabled="@ViewModel.IsBusy"
+                                                      OnClick="@(() => ViewModel.UnpublishAsync())">
+                                            Unpublish
+                                        </FluentButton>
+                                        <FluentButton Appearance="Appearance.Outline"
+                                                      Disabled="@ViewModel.IsBusy"
+                                                      OnClick="@(() => ViewModel.CloseAsync())">
+                                            Close
+                                        </FluentButton>
+                                    }
+                                    else if (item.Status == AssignmentStatusDto.Scheduled)
+                                    {
+                                        <FluentButton Appearance="Appearance.Accent"
+                                                      Disabled="@ViewModel.IsBusy"
+                                                      OnClick="@(() => ViewModel.PublishAsync())">
+                                            Publish now
+                                        </FluentButton>
+                                    }
+                                </div>
+                            </article>
+                        }
+                    </ChildContent>
+                    <Fallback>
+                        @TenantMissingCallToAction
+                    </Fallback>
+                </TenantGate>
+            </Authorized>
+            <NotAuthorized>
+                @SignInCallToAction
+            </NotAuthorized>
+        </AuthorizeView>
+    </ChildContent>
+    <ErrorContent Context="ex">
+        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
+    </ErrorContent>
+</ErrorBoundary>
+
+@code {
+    /// <summary>The assignment to show, from the route.</summary>
+    [Parameter] public Guid Id { get; set; }
+
+    private bool _signingIn;
+    private string? _signInError;
+
+    /// <summary>
+    /// The unauthenticated call to action — the <c>AuthorizeView</c> branch. A direct link to a detail
+    /// route is exactly where a signed-out visitor needs it most. Deliberately not the tenant gate's copy:
+    /// see <see cref="TenantMissingCallToAction"/>.
+    /// </summary>
+    private RenderFragment SignInCallToAction => CallToAction(
+        "Sign in to open this assignment.",
+        "Sign in");
+
+    /// <summary>
+    /// The tenant gate's fallback: signed in, but with no usable tenant claim — so "sign in" described the
+    /// wrong gate. The action re-acquires the session, the only recovery this head has (it ships no tenant
+    /// switcher).
+    /// </summary>
+    private RenderFragment TenantMissingCallToAction => CallToAction(
+        "This session is not linked to a school, so this assignment is not available in it. "
+            + "Sign in again with your school account.",
+        "Sign in again");
+
+    /// <summary>The gate fallbacks' shared body — one sign-in control, two honest copies.</summary>
+    private RenderFragment CallToAction(string message, string buttonLabel) => @<div class="assignment__sign-in">
+        <p class="assignment__sign-in-text">@message</p>
+        <FluentButton Appearance="Appearance.Accent"
+                      Disabled="@_signingIn"
+                      aria-busy="@_signingIn"
+                      OnClick="SignInAsync">
+            @buttonLabel
+        </FluentButton>
+        @if (_signInError is not null)
+        {
+            <FluentMessageBar Intent="MessageIntent.Error" Title="Sign-in failed">
+                @_signInError
+            </FluentMessageBar>
+        }
+    </div>;
+
+    protected override async Task OnInitializedAsync()
+    {
+        ViewModel.Changed += OnViewModelChanged;
+        await LoadIfSignedInAsync();
+    }
+
+    /// <summary>
+    /// Loads only for an authenticated session (a signed-out visitor sees the call to action), and
+    /// retries after a successful sign-in from it — the retry is what keeps the route usable when it
+    /// was opened cold and signed out.
+    /// </summary>
+    private async Task LoadIfSignedInAsync()
+    {
+        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
+        if (state.User.Identity?.IsAuthenticated == true)
+        {
+            await ViewModel.LoadAsync(Id);
+        }
+    }
+
+    private async Task SignInAsync()
+    {
+        _signingIn = true;
+        _signInError = null;
+        StateHasChanged();
+
+        try
+        {
+            await Login.SignInAsync();
+            await ViewModel.LoadAsync(Id);
+        }
+        catch (SignInCancelledException)
+        {
+            // The user dismissed the system browser: the screen simply stays signed out.
+        }
+        catch (SignInFailedException ex)
+        {
+            _signInError = ex.Message;
+        }
+        catch (TokenStoreException ex)
+        {
+            // The device's keystore refused the session — the credential was acquired but discarded,
+            // so the app stays signed out and the typed message is what the user needs to see.
+            _signInError = ex.Message;
+        }
+        finally
+        {
+            _signingIn = false;
+            StateHasChanged();
+        }
+    }
+
+    private void BackToListAsync() => Nav.NavigateTo("/assignments");
+
+    private Task RefreshAsync() => ViewModel.ReloadAsync();
+
+    // WS-A2 deviation from decision (j), preserved: FluentBadge supports Accent / Neutral /
+    // Lightweight only, so Scheduled shares Accent with Published and Closed/Archived are Neutral —
+    // the badge text distinguishes them.
+    private static Appearance StatusAppearance(AssignmentSummaryDto item) => item.Status switch
+    {
+        AssignmentStatusDto.Published or AssignmentStatusDto.Scheduled => Appearance.Accent,
+        AssignmentStatusDto.Closed or AssignmentStatusDto.Archived => Appearance.Neutral,
+        _ => Appearance.Lightweight
+    };
+
+    private static Appearance ApprovalAppearance(AssignmentSummaryDto item) => item.ApprovalStatus switch
+    {
+        null => Appearance.Lightweight,
+        ApprovalStatusDto.Pending => Appearance.Neutral,
+        ApprovalStatusDto.Approved => Appearance.Accent,
+        ApprovalStatusDto.Rejected => Appearance.Neutral,
+        _ => Appearance.Lightweight
+    };
+
+    private static string ApprovalText(AssignmentSummaryDto item) => item.ApprovalStatus switch
+    {
+        null => "Not submitted",
+        ApprovalStatusDto.Pending => "Pending",
+        ApprovalStatusDto.Approved => "Approved",
+        ApprovalStatusDto.Rejected => "Rejected",
+        _ => "—"
+    };
+
+    private static string DueDateText(AssignmentSummaryDto item) =>
+        item.DueDate?.ToLocalTime().ToString("g") ?? "—";
+
+    private void OnViewModelChanged() => _ = InvokeAsync(StateHasChanged);
+
+    public void Dispose()
+    {
+        ViewModel.Changed -= OnViewModelChanged;
+        ViewModel.Dispose();
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Detail.razor.css b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Detail.razor.css
new file mode 100644
index 00000000..86c88a35
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Detail.razor.css
@@ -0,0 +1,154 @@
+/* Assignment detail — mobile-first.
+
+   Base layout = the phone form at ≤400 dp: one column, the lifecycle action bar anchored to the bottom
+   of the viewport, the recipients and submissions sections stacked. ONE widening block follows the base,
+   at the tablet breakpoint (min-width: 641px), where the sections sit in a two-column main/aside and the
+   action bar returns to the end of the content.
+
+   Every rule targets an element authored in Detail.razor — a rule naming a FluentUI component's class
+   would never match, because that component's root carries the component's own isolation scope. */
+
+.assignment {
+    display: flex;
+    flex-direction: column;
+    gap: 1rem;
+    /* The 5rem foot reservation matches the action bar's own height, so it has to carry the inset the
+       bar carries — otherwise the last card scrolls under the taller bar on a device with a home
+       indicator. */
+    padding: 1rem 1rem calc(5rem + env(safe-area-inset-bottom, 0px));
+}
+
+.assignment__header {
+    display: flex;
+    flex-direction: column;
+    gap: 0.5rem;
+}
+
+.assignment__title {
+    font-size: 1.5rem;
+    font-weight: 600;
+    line-height: 1.2;
+    margin: 0;
+    overflow-wrap: anywhere;
+}
+
+.assignment__badges {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+}
+
+.assignment__card {
+    background: var(--neutral-layer-1, transparent);
+    border: 1px solid var(--neutral-stroke-divider-rest, #e0e0e0);
+    border-radius: 0.5rem;
+    display: flex;
+    flex-direction: column;
+    gap: 0.75rem;
+    padding: 1rem;
+}
+
+.assignment__fields {
+    display: grid;
+    gap: 0.75rem;
+    grid-template-columns: 1fr;
+}
+
+.assignment__section-title {
+    font-size: 1rem;
+    font-weight: 600;
+    margin: 0;
+}
+
+.assignment__approval-state {
+    display: flex;
+    gap: 0.5rem;
+}
+
+.assignment__approval-actions {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+}
+
+.assignment__body {
+    display: flex;
+    flex-direction: column;
+    gap: 1rem;
+}
+
+.assignment__section {
+    min-width: 0;
+}
+
+.assignment__busy {
+    display: flex;
+    justify-content: center;
+    padding: 2rem 0;
+}
+
+.assignment__notice {
+    margin: 0;
+}
+
+/* A failed action, or a re-read that failed after an action was accepted: the bar (plus its recovery
+   control) sits above the assignment, which stays rendered. */
+.assignment__failure {
+    align-items: flex-start;
+    display: flex;
+    flex-direction: column;
+    gap: 0.5rem;
+}
+
+.assignment__sign-in {
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 0.75rem;
+    padding: 1.5rem 1rem;
+}
+
+.assignment__sign-in-text {
+    margin: 0;
+}
+
+/* Bottom-anchored on a phone: the lifecycle actions stay reachable under the thumb while the read-only
+   content above scrolls. The bar is viewport-fixed, so the layout root's safe-area padding does NOT
+   apply to it (`env()` resolves against the element's own inset origin) — it carries the bottom inset
+   itself, or the buttons land behind the home indicator. */
+.assignment__actions {
+    background: var(--neutral-layer-2, transparent);
+    border-top: 1px solid var(--neutral-stroke-divider-rest, #e0e0e0);
+    bottom: 0;
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+    left: 0;
+    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
+    position: fixed;
+    right: 0;
+}
+
+@media (min-width: 641px) {
+    .assignment {
+        padding: 1.5rem;
+    }
+
+    .assignment__fields {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    .assignment__body {
+        align-items: start;
+        display: grid;
+        gap: 1.5rem;
+        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
+    }
+
+    .assignment__actions {
+        background: none;
+        border-top: 0;
+        padding: 0;
+        position: static;
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Index.razor b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Index.razor
new file mode 100644
index 00000000..7f1241d5
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/Index.razor
@@ -0,0 +1,228 @@
+@page "/assignments"
+@using Microsoft.AspNetCore.Components.Authorization
+@using SchoolCollab.Assignments.Contracts
+@inject AssignmentsListViewModel ViewModel
+@inject AuthenticationStateProvider AuthenticationStateProvider
+@inject OidcLoginService Login
+@implements IDisposable
+
+@* The mobile assignments list (L4's first slice). The desktop page it replaces renders a data grid and
+   a full toolbar; this screen is phone-first — a status chip row, a search box and one card per
+   assignment — widened to a two-column grid on a tablet by Index.razor.css. The view model owns every
+   API call and is shared with the cards, so no child component fetches anything.
+
+   Every styling hook sits on a plain element authored HERE: a child component's rendered root takes the
+   CHILD's CSS-isolation scope, so a rule in this file would silently never match a FluentUI component. *@
+
+<PageTitle>Assignments</PageTitle>
+
+<AuthorizeView>
+    <Authorized>
+        @* The shared tenant gate: a signed-in session without a real tenant sees the same sign-in
+           call to action rather than a list it cannot load. *@
+        <TenantGate>
+            <ChildContent>
+                <section class="assignments">
+                    <header class="assignments__header">
+                        <h1 class="assignments__title">Assignments</h1>
+                        <div class="assignments__search">
+                            <FluentSearch Placeholder="Search assignments…"
+                                          AriaLabel="Search assignments"
+                                          Immediate="true"
+                                          @bind-Value="_searchText"
+                                          @bind-Value:after="OnSearchChangedAsync" />
+                        </div>
+                    </header>
+
+                    <div class="assignments__filters" role="group" aria-label="Filter by status">
+                        @foreach (var filter in StatusFilterOptions)
+                        {
+                            <FluentButton Appearance="@(ViewModel.StatusFilter == filter.Value ? Appearance.Accent : Appearance.Outline)"
+                                          aria-pressed="@(ViewModel.StatusFilter == filter.Value)"
+                                          OnClick="@(() => SelectStatusAsync(filter.Value))">
+                                @filter.Label
+                            </FluentButton>
+                        }
+                    </div>
+
+                    @if (ViewModel.IsLoading)
+                    {
+                        <div class="assignments__busy" role="status" aria-label="Loading assignments">
+                            <FluentProgressRing />
+                        </div>
+                    }
+                    else if (ViewModel.Error is not null)
+                    {
+                        @* Only a LOAD failure owns this branch: it is the state that replaces the list.
+                           A failed action renders below instead, over the rows it acted on. *@
+                        <div class="assignments__failure">
+                            <FluentMessageBar Intent="MessageIntent.Error" Title="@ViewModel.ErrorTitle">
+                                @ViewModel.Error
+                            </FluentMessageBar>
+                            <FluentButton Appearance="Appearance.Outline" OnClick="RetryLoadAsync">Retry</FluentButton>
+                        </div>
+                    }
+                    else
+                    {
+                        @if (ViewModel.ActionError is not null)
+                        {
+                            @* An action failure must never take the list away from the user: the rows,
+                               and with them the button that failed, stay tappable — which is what makes
+                               "Try again" a recovery rather than the only way back. *@
+                            <div class="assignments__failure">
+                                <FluentMessageBar Intent="MessageIntent.Error" Title="@ViewModel.ActionErrorTitle">
+                                    @ViewModel.ActionError
+                                </FluentMessageBar>
+                                <FluentButton Appearance="Appearance.Outline" OnClick="RetryActionAsync">Try again</FluentButton>
+                            </div>
+                        }
+
+                        @if (ViewModel.DisplayItems is { Length: > 0 } assignments)
+                        {
+                            <ul class="assignments__cards">
+                                @foreach (var assignment in assignments)
+                                {
+                                    <li class="assignments__slot">
+                                        <AssignmentCard Item="assignment" ViewModel="ViewModel" />
+                                    </li>
+                                }
+                            </ul>
+                        }
+                        else
+                        {
+                            <div class="assignments__notice">
+                                <FluentMessageBar Intent="MessageIntent.Info">@ViewModel.EmptyMessage</FluentMessageBar>
+                            </div>
+                        }
+                    }
+                </section>
+            </ChildContent>
+            <Fallback>
+                @TenantMissingCallToAction
+            </Fallback>
+        </TenantGate>
+    </Authorized>
+    <NotAuthorized>
+        @SignInCallToAction
+    </NotAuthorized>
+</AuthorizeView>
+
+@code {
+    private static readonly (AssignmentStatusDto? Value, string Label)[] StatusFilterOptions =
+    [
+        (null, "All"),
+        (AssignmentStatusDto.Draft, "Draft"),
+        (AssignmentStatusDto.Published, "Published"),
+        (AssignmentStatusDto.Closed, "Closed"),
+        (AssignmentStatusDto.Scheduled, "Scheduled"),
+        (AssignmentStatusDto.Archived, "Archived"),
+    ];
+
+    private string? _searchText;
+    private bool _signingIn;
+    private string? _signInError;
+
+    /// <summary>
+    /// The unauthenticated call to action — the <c>AuthorizeView</c> branch. Deliberately not the tenant
+    /// gate's: a signed-in session with no tenant must not be told to sign in (see
+    /// <see cref="TenantMissingCallToAction"/>).
+    /// </summary>
+    private RenderFragment SignInCallToAction => CallToAction(
+        "Sign in to see the assignments for your school.",
+        "Sign in");
+
+    /// <summary>
+    /// The tenant gate's fallback: this session IS signed in, it just carries no usable tenant claim, so
+    /// "sign in" described the wrong gate. The action re-acquires the session — the only recovery this
+    /// head has, since it ships no tenant switcher.
+    /// </summary>
+    private RenderFragment TenantMissingCallToAction => CallToAction(
+        "This session is not linked to a school, so it has no assignments to show. "
+            + "Sign in again with your school account.",
+        "Sign in again");
+
+    /// <summary>The gate fallbacks' shared body — one sign-in control, two honest copies.</summary>
+    private RenderFragment CallToAction(string message, string buttonLabel) => @<div class="assignments__sign-in">
+        <p class="assignments__sign-in-text">@message</p>
+        <FluentButton Appearance="Appearance.Accent"
+                      Disabled="@_signingIn"
+                      aria-busy="@_signingIn"
+                      OnClick="SignInAsync">
+            @buttonLabel
+        </FluentButton>
+        @if (_signInError is not null)
+        {
+            <FluentMessageBar Intent="MessageIntent.Error" Title="Sign-in failed">
+                @_signInError
+            </FluentMessageBar>
+        }
+    </div>;
+
+    protected override async Task OnInitializedAsync()
+    {
+        ViewModel.Changed += OnViewModelChanged;
+        await LoadIfSignedInAsync();
+    }
+
+    /// <summary>
+    /// Loads only for an authenticated session: a signed-out visitor sees the call to action, and the
+    /// load is retried the moment the sign-in succeeds (<see cref="SignInAsync"/>), so the screen is
+    /// never left empty after the gate flips.
+    /// </summary>
+    private async Task LoadIfSignedInAsync()
+    {
+        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
+        if (state.User.Identity?.IsAuthenticated == true)
+        {
+            await ViewModel.LoadAsync();
+        }
+    }
+
+    private async Task SignInAsync()
+    {
+        _signingIn = true;
+        _signInError = null;
+        StateHasChanged();
+
+        try
+        {
+            await Login.SignInAsync();
+            await ViewModel.LoadAsync();
+        }
+        catch (SignInCancelledException)
+        {
+            // The user dismissed the system browser: the screen simply stays signed out.
+        }
+        catch (SignInFailedException ex)
+        {
+            _signInError = ex.Message;
+        }
+        catch (TokenStoreException ex)
+        {
+            // The device's keystore refused the session — the credential was acquired but discarded,
+            // so the app stays signed out and the typed message is what the user needs to see.
+            _signInError = ex.Message;
+        }
+        finally
+        {
+            _signingIn = false;
+            StateHasChanged();
+        }
+    }
+
+    private Task SelectStatusAsync(AssignmentStatusDto? filter) => ViewModel.SetStatusFilterAsync(filter);
+
+    private Task OnSearchChangedAsync() => ViewModel.SearchAsync(_searchText);
+
+    private Task RetryLoadAsync() => ViewModel.LoadAsync();
+
+    private Task RetryActionAsync() => ViewModel.RetryActionAsync();
+
+    private void OnViewModelChanged() => _ = InvokeAsync(StateHasChanged);
+
+    public void Dispose()
+    {
+        ViewModel.Changed -= OnViewModelChanged;
+        ViewModel.Dispose();
+    }
+}
