diff --git a/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/AssignmentRecipientsSection.razor b/src/Mobile/SchoolCollab.Mobile/Components/Pages/Assignments/AssignmentRecipientsSection.razor
new file mode 100644
