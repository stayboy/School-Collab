diff --git a/tests/SchoolCollab.Mobile.Tests.Unit/AssignmentDetailViewModelTests.cs b/tests/SchoolCollab.Mobile.Tests.Unit/AssignmentDetailViewModelTests.cs
new file mode 100644
index 00000000..c1afff25
