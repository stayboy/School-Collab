diff --git a/src/Mobile/SchoolCollab.Mobile/Services/SecureStorageTokenStore.cs b/src/Mobile/SchoolCollab.Mobile/Services/SecureStorageTokenStore.cs
new file mode 100644
index 00000000..eb074d36
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile/Services/SecureStorageTokenStore.cs
@@ -0,0 +1,75 @@
+using Microsoft.Maui.Storage;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Services;
+
+/// <summary>
+/// The device's token custody, over MAUI Essentials' <c>SecureStorage</c> — the platform keystore
+/// (Android Keystore, iOS keychain, the Windows credential vault), never the WebView's
+/// <c>sessionStorage</c>/<c>localStorage</c> (the L2 readiness control). Essentials ships with the
+/// head's <c>Microsoft.Maui.Controls</c> reference, which is why this implementation lives in the
+/// head and only the <see cref="ITokenStore"/> seam lives in <c>Mobile.Logic</c>.
+/// </summary>
+/// <remarks>
+/// <para>Nothing here logs, and no value read or written is ever placed in an exception message: the
+/// values are the session's credentials. A failure raised here names the key and the platform
+/// exception's type only.</para>
+/// <para>A keystore failure never escapes as the platform's own exception: an unreadable store is
+/// reported as "no session" (the app degrades to unauthenticated), while a refused write or removal
+/// is raised as the typed <see cref="TokenStoreException"/> so the caller can state what failed.</para>
+/// </remarks>
+public sealed class SecureStorageTokenStore : ITokenStore
+{
+    /// <inheritdoc />
+    public async Task<string?> ReadAsync(string key, CancellationToken cancellationToken = default)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        try
+        {
+            return await SecureStorage.Default.GetAsync(key);
+        }
+        catch (Exception exception) when (exception is not OperationCanceledException)
+        {
+            // No readable session: whatever asked (the startup read, the gates, the bearer handler)
+            // sees an empty store and treats the app as signed out. A keystore that cannot be read
+            // says nothing about a token's correctness, so "no session" is the honest answer.
+            return null;
+        }
+    }
+
+    /// <inheritdoc />
+    public async Task WriteAsync(string key, string value, CancellationToken cancellationToken = default)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        try
+        {
+            await SecureStorage.Default.SetAsync(key, value);
+        }
+        catch (Exception exception) when (exception is not OperationCanceledException)
+        {
+            throw new TokenStoreException(
+                $"The device's token store refused the write of its '{key}' entry " +
+                $"({exception.GetType().Name}).");
+        }
+    }
+
+    /// <inheritdoc />
+    public Task ClearAsync(string key, CancellationToken cancellationToken = default)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        try
+        {
+            SecureStorage.Default.Remove(key);
+        }
+        catch (Exception exception) when (exception is not OperationCanceledException)
+        {
+            // A removal that silently failed would leave a credential on the device after a
+            // sign-out, so this one is raised rather than swallowed.
+            throw new TokenStoreException(
+                $"The device's token store refused the removal of its '{key}' entry " +
+                $"({exception.GetType().Name}).");
+        }
+
+        return Task.CompletedTask;
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile/Services/SystemBrowserAuthenticator.cs b/src/Mobile/SchoolCollab.Mobile/Services/SystemBrowserAuthenticator.cs
new file mode 100644
index 00000000..4a69eb28
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile/Services/SystemBrowserAuthenticator.cs
@@ -0,0 +1,62 @@
+using Microsoft.Maui.Authentication;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Services;
+
+/// <summary>
+/// Opens the OIDC authorize URL in the system browser through MAUI Essentials'
+/// <c>WebAuthenticator</c> and hands the callback's query parameters back to
+/// <see cref="OidcLoginService"/>.
+/// </summary>
+/// <remarks>
+/// <para><c>WebAuthenticator</c> is cross-platform Essentials surface, so — unlike the rest of
+/// <c>Platforms/</c> — this class needs no platform <c>#if</c>. What <i>is</i> platform-specific is
+/// the callback registration: the Android <c>[IntentFilter]</c> on <c>MainActivity</c> and the
+/// Apple <c>CFBundleURLTypes</c> entries must carry exactly the scheme and authority of the
+/// <see cref="Uri"/> passed as the callback URL, or the browser returns the app to nowhere.</para>
+/// <para>Platform cancellation (the user dismissing the browser) is surfaced as the typed
+/// <see cref="SignInCancelledException"/>, and every other platform failure as the typed
+/// <see cref="SignInFailedException"/>, never raw. No token material passes through this type;
+/// the exception's message repeats the platform failure's <i>type name</i> only, never its text.</para>
+/// </remarks>
+public sealed class SystemBrowserAuthenticator : ISystemBrowserAuthenticator
+{
+    /// <inheritdoc />
+    public async Task<IDictionary<string, string>> AuthenticateAsync(
+        Uri authorizeUrl,
+        Uri callbackUri,
+        CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(authorizeUrl);
+        ArgumentNullException.ThrowIfNull(callbackUri);
+
+        try
+        {
+            var result = await WebAuthenticator.Default.AuthenticateAsync(
+                new WebAuthenticatorOptions
+                {
+                    Url = authorizeUrl,
+                    CallbackUrl = callbackUri,
+                },
+                cancellationToken);
+
+            return result.Properties;
+        }
+        catch (OperationCanceledException)
+        {
+            throw new SignInCancelledException(
+                "The sign-in was cancelled before the browser returned a callback.");
+        }
+        catch (Exception exception)
+        {
+            // A platform failure is not a cancellation, and it must not escape raw: the auth path
+            // owns two typed failures, and an untyped one would bypass the sign-in surface and land
+            // in the ErrorBoundary instead. The Windows leg's missing protocol registration
+            // (FeatureNotSupportedException on an unpackaged app) is the known case. The message
+            // names the platform failure's TYPE only — a platform message can echo request content.
+            throw new SignInFailedException(
+                "The system browser could not complete the sign-in on this platform " +
+                $"({exception.GetType().Name}).");
+        }
+    }
+}
