diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/BearerTokenDelegatingHandler.cs b/src/Mobile/SchoolCollab.Mobile.Logic/BearerTokenDelegatingHandler.cs
new file mode 100644
index 00000000..17a74284
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/BearerTokenDelegatingHandler.cs
@@ -0,0 +1,104 @@
+using System.Net.Http;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// Attaches the session's access token to every outgoing API call as
+/// <c>Authorization: Bearer &lt;token&gt;</c> — the device's replacement for the server-side
+/// cookie/bearer estate. A request that already carries the header is left alone.
+/// </summary>
+/// <remarks>
+/// <para><b>Refresh policy (OD-1).</b> The token is fetched on demand: <see cref="TokenSession"/>
+/// returns the cached one while it is usable and silently refreshes it when it is not. A failed
+/// refresh sends the request <i>unauthenticated</i> and lets the server answer 401 — the server's
+/// 401 is the truth, and the UI's interactive sign-in is the fallback. There is deliberately
+/// <b>no automatic resend of a 401'd request</b> this round: a resend loop on a rejected credential
+/// is how a 401 storm starts.</para>
+/// <para><b>A store failure is "no session".</b> The device's keystore can refuse a write on the
+/// same path (see <see cref="TokenSession.ApplyTokensAsync"/>), which discards the session and
+/// signals the typed <see cref="TokenStoreException"/> instead of letting it escape.</para>
+/// <para><b>An unreachable token endpoint is "no session" too.</b> A refresh can also die in
+/// transport — <see cref="HttpRequestException"/>, <see cref="TimeoutException"/>,
+/// <see cref="IOException"/>, or a <see cref="TaskCanceledException"/> raised by the token
+/// client's own <see cref="HttpClient.Timeout"/> — and that produced no credential either, so it
+/// degrades the same way: unauthenticated send, server 401. Neither a storage hiccup nor a network
+/// hiccup can become a transport failure for the caller's in-flight request. The transport cases
+/// deliberately leave the session intact — an unreachable endpoint says nothing about the refresh
+/// token's validity, so a later request may retry the refresh; the two typed cases cannot retry,
+/// because both have already discarded the session.</para>
+/// <para><b>Cancellation is not a session outcome.</b> An <see cref="HttpClient"/> timeout does
+/// <i>not</i> surface as a <see cref="TimeoutException"/> on this stack — it surfaces as a
+/// <see cref="TaskCanceledException"/> whose inner exception is the timeout — so that clause is
+/// guarded on the caller's token: only the token client's own deadline degrades, while a
+/// <i>caller</i>-cancelled request still sees its cancellation and is never quietly re-sent
+/// unauthenticated behind the caller's back.</para>
+/// <para>Registered <b>transient</b>, like every delegating handler in this repo:
+/// <c>IHttpClientFactory</c> builds a fresh handler instance per outgoing request through the
+/// client's handler pipeline, so a handler must never capture per-request state.</para>
+/// <para>Nothing on this path logs, and no token material is ever placed in an exception message.</para>
+/// </remarks>
+/// <param name="session">The token session the bearer value comes from.</param>
+public sealed class BearerTokenDelegatingHandler(TokenSession session) : DelegatingHandler
+{
+    private const string AuthorizationHeaderName = "Authorization";
+
+    protected override async Task<HttpResponseMessage> SendAsync(
+        HttpRequestMessage request,
+        CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+
+        if (!request.Headers.Contains(AuthorizationHeaderName))
+        {
+            string? token = null;
+            try
+            {
+                token = await session.GetBearerTokenAsync(cancellationToken);
+            }
+            catch (TokenSessionExpiredException)
+            {
+                // The refresh token was rejected, so the session has already been cleared. Send the
+                // request unauthenticated: the API's 401 is the authoritative answer and the UI
+                // turns it into a sign-in prompt. Nothing to log, and no token to name.
+            }
+            catch (TokenStoreException)
+            {
+                // The device's keystore refused a write while the session was being renewed, so
+                // TokenSession has discarded the session and this is its typed report. A store
+                // failure is "no session", never a transport failure: the request goes out
+                // unauthenticated, and the API's 401 is the answer. Nothing to log — the message
+                // names a key and a platform exception type, never a stored value.
+            }
+            catch (Exception exception)
+                when (exception is HttpRequestException or TimeoutException or IOException)
+            {
+                // The token endpoint was unreachable — DNS, socket, TLS, a timeout, or a read that
+                // failed mid-response — so the refresh produced no credential. That is a transport
+                // failure of the REFRESH, not a verdict on the session, and it must not become a
+                // transport failure for the caller's in-flight API request: the request goes out
+                // unauthenticated and the API's 401 is the authoritative answer, exactly as for the
+                // two typed failures above. The session stays intact on purpose — an unreachable
+                // endpoint says nothing about the refresh token's validity, so a later request may
+                // retry the refresh. Nothing to log — no value on this path is ever placed in a
+                // message; only the exception type would be named.
+            }
+            catch (TaskCanceledException) when (!cancellationToken.IsCancellationRequested)
+            {
+                // The token client's OWN timeout ended the attempt, which is the shape an
+                // HttpClient deadline actually takes (a TaskCanceledException carrying an inner
+                // TimeoutException — measured, never a bare TimeoutException). Same outcome as the
+                // transport failure above: no credential was produced, so the request goes out
+                // unauthenticated and the API's 401 is the answer. The guard is what keeps this a
+                // session outcome instead of swallowing the caller's cancellation, which must keep
+                // propagating. Nothing to log.
+            }
+
+            if (!string.IsNullOrEmpty(token))
+            {
+                request.Headers.TryAddWithoutValidation(AuthorizationHeaderName, $"Bearer {token}");
+            }
+        }
+
+        return await base.SendAsync(request, cancellationToken);
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/ISystemBrowserAuthenticator.cs b/src/Mobile/SchoolCollab.Mobile.Logic/ISystemBrowserAuthenticator.cs
new file mode 100644
index 00000000..07bbc56f
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/ISystemBrowserAuthenticator.cs
@@ -0,0 +1,36 @@
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// Acquires the authorization response from the system browser — the platform half of the OIDC
+/// code flow. The head implements it over MAUI Essentials' <c>WebAuthenticator</c>; the
+/// abstraction lives here so the flow itself (<see cref="OidcLoginService"/>) is testable on a
+/// plain <c>net10.0</c> TFM.
+/// </summary>
+/// <remarks>
+/// <c>WebAuthenticator</c> is cross-platform Essentials API surface, so the implementation carries
+/// no platform <c>#if</c>; it only has to make the platform's callback registration match
+/// <paramref name="callbackUri"/>'s scheme and authority.
+/// </remarks>
+public interface ISystemBrowserAuthenticator
+{
+    /// <summary>
+    /// Opens <paramref name="authorizeUrl"/> in the system browser and completes when the app is
+    /// re-launched with <paramref name="callbackUri"/>'s scheme and authority, returning the
+    /// callback URI's query parameters.
+    /// </summary>
+    /// <exception cref="SignInCancelledException">The user dismissed the browser, or the platform
+    /// cancelled the flow.</exception>
+    /// <exception cref="SignInFailedException">The platform could not carry out the browser hand-off
+    /// (e.g. a missing callback-protocol registration); nothing was persisted.</exception>
+    Task<IDictionary<string, string>> AuthenticateAsync(
+        Uri authorizeUrl,
+        Uri callbackUri,
+        CancellationToken cancellationToken = default);
+}
+
+/// <summary>
+/// The user (or the platform) cancelled the interactive sign-in. Nothing was persisted; the UI
+/// surfaces this as a dismissal, not an error.
+/// </summary>
+/// <remarks>The message carries no credential material and never names a token value.</remarks>
+public sealed class SignInCancelledException(string message) : Exception(message);
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/ITokenStore.cs b/src/Mobile/SchoolCollab.Mobile.Logic/ITokenStore.cs
new file mode 100644
index 00000000..5f2088ae
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/ITokenStore.cs
@@ -0,0 +1,60 @@
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The device-side custody of the OIDC session's tokens. The abstraction lives here so every
+/// consumer on the auth path (<see cref="TokenSession"/>, <see cref="OidcLoginService"/>) is
+/// testable on a plain <c>net10.0</c> TFM; the implementation is platform code and lives in the
+/// head, over MAUI Essentials' <c>SecureStorage</c> — never <c>sessionStorage</c>/
+/// <c>localStorage</c> (the L2 readiness control).
+/// </summary>
+/// <remarks>
+/// Implementations must never log or otherwise surface a stored value: the values written through
+/// this interface are credential material.
+/// </remarks>
+public interface ITokenStore
+{
+    /// <summary>Reads the value stored under <paramref name="key"/>, or <see langword="null"/> when absent.</summary>
+    /// <remarks>A keystore that cannot be read is reported as "no session" (<see langword="null"/>), so
+    /// a storage failure degrades the app to unauthenticated instead of failing in whatever asked.</remarks>
+    Task<string?> ReadAsync(string key, CancellationToken cancellationToken = default);
+
+    /// <summary>Writes <paramref name="value"/> under <paramref name="key"/>, replacing any previous value.</summary>
+    /// <exception cref="TokenStoreException">The platform keystore refused the write.</exception>
+    Task WriteAsync(string key, string value, CancellationToken cancellationToken = default);
+
+    /// <summary>Removes the value stored under <paramref name="key"/>. Absent keys are not an error.</summary>
+    /// <exception cref="TokenStoreException">The platform keystore refused the removal.</exception>
+    Task ClearAsync(string key, CancellationToken cancellationToken = default);
+}
+
+/// <summary>
+/// The device's token store could not carry out a write or a removal: the platform keystore
+/// (Android Keystore, iOS keychain, the Windows credential vault) reported a failure.
+/// </summary>
+/// <remarks>
+/// <para>It is raised instead of letting the platform's own exception escape: an arbitrary
+/// platform exception would bypass the auth path's typed failures and surface somewhere that
+/// cannot describe it. Reads do not raise it — an unreadable store reads as "no session".</para>
+/// <para>The message names the key and the platform failure's type — never a token value, a
+/// stored value, or <c>Authorization</c> header content.</para>
+/// </remarks>
+public sealed class TokenStoreException(string message) : Exception(message);
+
+/// <summary>
+/// The token store's keys — one constants block, so the read, write and clear sites cannot spell a
+/// key differently and silently miss each other.
+/// </summary>
+public static class TokenKeys
+{
+    /// <summary>The access token presented as <c>Authorization: Bearer</c>.</summary>
+    public const string AccessToken = "access_token";
+
+    /// <summary>The refresh token used to renew the access token without an interactive sign-in.</summary>
+    public const string RefreshToken = "refresh_token";
+
+    /// <summary>
+    /// The instant the access token stops being usable, as a round-trip ISO 8601 timestamp — the
+    /// token's own expiry minus the clock-skew margin (<see cref="TokenSession"/>).
+    /// </summary>
+    public const string ExpiresAt = "expires_at";
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/JwtPayloadReader.cs b/src/Mobile/SchoolCollab.Mobile.Logic/JwtPayloadReader.cs
new file mode 100644
index 00000000..8656e4c3
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/JwtPayloadReader.cs
@@ -0,0 +1,106 @@
+using System.Text.Json;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// Decodes the claim values out of a JWT's payload segment. One entry per JSON property, one
+/// value per claim — a multivalued claim (<c>roles</c>) therefore reads as one claim per array
+/// element, which is the shape the shared gates consume.
+/// </summary>
+/// <remarks>
+/// <para><b>Signature verification is deliberately absent.</b> On the device the token is an
+/// opaque bearer credential: verification is the API's job (<c>AddJwtBearer</c> validates issuer,
+/// audience and signature), and the claims read here only drive UI visibility
+/// (<c>TenantGate</c>/<c>FeatureFlagGate</c> are UI gating, never enforcement). A forged token
+/// therefore buys nothing — every endpoint still refuses it — while verifying client-side would
+/// mean shipping the realm's public key inside the app. <c>JwtPayloadReaderTests</c> pins this
+/// absence: a token whose signature segment is garbage still decodes its claims.</para>
+/// <para>The claim <i>spellings</i> are whatever the realm emits (<c>tenant_id</c>,
+/// <c>tenant_name</c>, <c>roles</c>) — the shared UI reads them verbatim
+/// (<c>VisibleTenantService</c>'s <c>user.FindFirst("tenant_id")</c>), so nothing is renamed to
+/// <c>ClaimTypes.*</c> here.</para>
+/// </remarks>
+public static class JwtPayloadReader
+{
+    /// <summary>A JWT is <c>header.payload.signature</c>.</summary>
+    private const int SegmentCount = 3;
+
+    /// <summary>The payload is segment index 1 (header is 0, signature is 2).</summary>
+    private const int PayloadSegmentIndex = 1;
+
+    /// <summary>
+    /// Reads every claim from <paramref name="token"/>'s payload. Values that are JSON objects
+    /// (rather than strings, numbers, booleans or arrays of those) are not claim values and are
+    /// skipped.
+    /// </summary>
+    /// <exception cref="ArgumentException"><paramref name="token"/> is null, empty or whitespace.</exception>
+    /// <exception cref="FormatException">The token is not a three-segment JWT, its payload segment
+    /// is not base64url, or the payload is not a JSON object.</exception>
+    public static IReadOnlyDictionary<string, IReadOnlyList<string>> ReadClaimValues(string token)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(token);
+
+        var segments = token.Split('.');
+        if (segments.Length != SegmentCount)
+        {
+            throw new FormatException(
+                $"A JWT must carry exactly {SegmentCount} '.'-separated segments; got {segments.Length}.");
+        }
+
+        var payload = DecodeBase64Url(segments[PayloadSegmentIndex]);
+        using var document = JsonDocument.Parse(payload);
+        if (document.RootElement.ValueKind != JsonValueKind.Object)
+        {
+            throw new FormatException($"A JWT payload must be a JSON object; got {document.RootElement.ValueKind}.");
+        }
+
+        var claims = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal);
+        foreach (var property in document.RootElement.EnumerateObject())
+        {
+            var values = new List<string>();
+            switch (property.Value.ValueKind)
+            {
+                case JsonValueKind.String:
+                    values.Add(property.Value.GetString()!);
+                    break;
+                case JsonValueKind.Number:
+                case JsonValueKind.True:
+                case JsonValueKind.False:
+                    values.Add(property.Value.GetRawText());
+                    break;
+                case JsonValueKind.Array:
+                    values.AddRange(property.Value.EnumerateArray()
+                        .Where(item => item.ValueKind == JsonValueKind.String)
+                        .Select(item => item.GetString()!));
+                    break;
+                default:
+                    continue;
+            }
+
+            claims[property.Name] = values;
+        }
+
+        return claims;
+    }
+
+    private static ReadOnlyMemory<byte> DecodeBase64Url(string segment)
+    {
+        var padded = segment.Replace('-', '+').Replace('_', '/');
+        padded = (padded.Length % 4) switch
+        {
+            2 => padded + "==",
+            3 => padded + "=",
+            0 => padded,
+            _ => throw new FormatException("A JWT payload segment is not valid base64url."),
+        };
+
+        try
+        {
+            return Convert.FromBase64String(padded);
+        }
+        catch (FormatException ex)
+        {
+            throw new FormatException("A JWT payload segment is not valid base64url.", ex);
+        }
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/MobileAuthOptions.cs b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAuthOptions.cs
new file mode 100644
index 00000000..132ebb52
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAuthOptions.cs
@@ -0,0 +1,160 @@
+using Microsoft.Extensions.Configuration;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The mobile head's OIDC credential settings, bound from the <see cref="SectionName"/> section of
+/// the head's <c>appsettings*.json</c>.
+/// </summary>
+/// <remarks>
+/// <para>Every address is configuration, never a C# literal (spec D8): the authority differs per
+/// environment (a Windows dev loopback, an Android-emulator host alias, a deployed IdP), so it is
+/// bound and normalized here and the OIDC endpoint paths are appended by
+/// <see cref="BuildAuthorizeEndpointUri"/> / <see cref="BuildTokenEndpointUri"/>.</para>
+/// <para><b>Custom-scheme hijack posture.</b> <see cref="RedirectScheme"/> is an unverified,
+/// non-owned scheme: any Android app can register the same intent filter and receive the
+/// redirect. The deliberate mitigations are <b>PKCE + <c>state</c></b> — a hijacker that captures
+/// the redirect holds a short-lived authorization <c>code</c> that is useless without the
+/// in-memory <c>code_verifier</c> (which is never persisted), and a forged callback fails the
+/// <c>state</c> match before any token is persisted (see <see cref="OidcLoginService"/>). The
+/// loopback alternative — a local listener on <c>127.0.0.1</c> — owns no scheme at all and is the
+/// preferred shape where practical, but it needs a per-run listener plus platform loopback
+/// permissions; this round ships the custom scheme with the mitigations explicit in code.</para>
+/// </remarks>
+public sealed class MobileAuthOptions
+{
+    /// <summary>The configuration section this class is bound from.</summary>
+    public const string SectionName = "MobileAuth";
+
+    /// <summary>The Keycloak OIDC authorization endpoint path, relative to <see cref="Authority"/>.</summary>
+    private const string AuthorizePath = "protocol/openid-connect/auth";
+
+    /// <summary>The Keycloak OIDC token endpoint path, relative to <see cref="Authority"/>.</summary>
+    private const string TokenPath = "protocol/openid-connect/token";
+
+    /// <summary>The realm URL, e.g. <c>&lt;scheme&gt;://&lt;host&gt;/realms/&lt;realm&gt;</c> — from configuration only.</summary>
+    public string? Authority { get; set; }
+
+    /// <summary>The public Keycloak client the device signs in with (the realm's mobile client).</summary>
+    public string? ClientId { get; set; }
+
+    /// <summary>The custom redirect scheme the device registers (the app's callback scheme).</summary>
+    public string? RedirectScheme { get; set; }
+
+    /// <summary>
+    /// The redirect URI's authority component — named <c>RedirectHost</c>, not <c>RedirectPath</c>,
+    /// because a custom-scheme callback URI carries <b>no path</b>: in
+    /// <c>schoolcollab://signin-oidc</c> the trailing token is the URI authority. The Android
+    /// <c>[IntentFilter]</c>'s <c>DataHost</c> and the realm's <c>redirectUris</c> entry must both
+    /// equal this value (Keycloak matches redirect URIs exactly).
+    /// </summary>
+    public string? RedirectHost { get; set; }
+
+    /// <summary>The scopes the authorize request asks for. Defaults to <c>openid</c> (the ID token requires it).</summary>
+    public string Scope { get; set; } = "openid";
+
+    /// <summary>Additional scopes the app requires; requested alongside <see cref="Scope"/>, de-duplicated.</summary>
+    public string[] RequiredScopes { get; set; } = [];
+
+    /// <summary>
+    /// Binds a new instance from the <see cref="SectionName"/> section of
+    /// <paramref name="configuration"/>.
+    /// </summary>
+    /// <exception cref="ArgumentNullException"><paramref name="configuration"/> is <see langword="null"/>.</exception>
+    public static MobileAuthOptions FromConfiguration(IConfiguration configuration)
+    {
+        ArgumentNullException.ThrowIfNull(configuration);
+
+        var options = new MobileAuthOptions();
+        configuration.GetSection(SectionName).Bind(options);
+        return options;
+    }
+
+    /// <summary>
+    /// The configured realm URL normalized to an absolute <see cref="Uri"/> with a trailing slash
+    /// (the shape relative Keycloak paths are appended to) — or <see langword="null"/> when the
+    /// value is absent or blank, so the head can start without a credential configuration and fail
+    /// only at the first sign-in attempt.
+    /// </summary>
+    /// <exception cref="InvalidOperationException">The configured value is not an absolute URI.</exception>
+    public Uri? AuthorityUri => string.IsNullOrWhiteSpace(Authority) ? null : ToAbsolute(Authority);
+
+    /// <summary>The realm's OIDC authorization endpoint.</summary>
+    /// <exception cref="InvalidOperationException"><see cref="Authority"/> is not configured.</exception>
+    public Uri BuildAuthorizeEndpointUri() => BuildEndpoint(AuthorizePath);
+
+    /// <summary>The realm's OIDC token endpoint (the authorization-code exchange and refresh both POST here).</summary>
+    /// <exception cref="InvalidOperationException"><see cref="Authority"/> is not configured.</exception>
+    public Uri BuildTokenEndpointUri() => BuildEndpoint(TokenPath);
+
+    /// <summary>
+    /// The custom-scheme callback URI as the exact string the realm registers in
+    /// <c>redirectUris</c> and the authorize request carries as <c>redirect_uri</c>.
+    /// </summary>
+    /// <remarks>
+    /// This is a STRING, not the <see cref="Uri"/>, on purpose: <see cref="Uri.ToString"/> normalizes a
+    /// pathless custom-scheme URI to a trailing slash (<c>schoolcollab://signin-oidc/</c>), and Keycloak
+    /// matches redirect URIs exactly — the slash is a hard <c>invalid_redirect_uri</c> at the first real
+    /// sign-in attempt.
+    /// </remarks>
+    /// <exception cref="InvalidOperationException">The scheme or host is not configured.</exception>
+    public string BuildRedirectUriString()
+    {
+        if (string.IsNullOrWhiteSpace(RedirectScheme) || string.IsNullOrWhiteSpace(RedirectHost))
+        {
+            throw new InvalidOperationException(
+                $"{SectionName}:{nameof(RedirectScheme)} and {nameof(RedirectHost)} must both be configured.");
+        }
+
+        return $"{RedirectScheme.Trim()}://{RedirectHost.Trim()}";
+    }
+
+    /// <summary>
+    /// The custom-scheme callback URI built as <c>{RedirectScheme}://{RedirectHost}</c> — the exact
+    /// literal the realm registers in <c>redirectUris</c> and the head hands to
+    /// <c>WebAuthenticator</c> as the callback URL (the platform matches scheme + authority, so the
+    /// normalized form is what it needs).
+    /// </summary>
+    /// <exception cref="InvalidOperationException">The scheme or host is not configured.</exception>
+    public Uri BuildRedirectUri() => new(BuildRedirectUriString());
+
+    /// <summary>
+    /// The space-separated scope string the authorize request sends: <see cref="Scope"/> plus
+    /// <see cref="RequiredScopes"/>, de-duplicated in request order.
+    /// </summary>
+    public string ResolveScope() => string.Join(
+        ' ',
+        new[] { Scope }.Concat(RequiredScopes)
+            .Where(scope => !string.IsNullOrWhiteSpace(scope))
+            .Select(scope => scope.Trim())
+            .Distinct(StringComparer.Ordinal));
+
+    private Uri BuildEndpoint(string path)
+    {
+        var authority = AuthorityUri
+            ?? throw new InvalidOperationException(
+                $"{SectionName}:{nameof(Authority)} must be configured before an OIDC endpoint can be built.");
+
+        return new Uri(authority, path);
+    }
+
+    private static Uri ToAbsolute(string value)
+    {
+        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri))
+        {
+            throw new InvalidOperationException(
+                $"{SectionName}:{nameof(Authority)} must be an absolute URL; got '{value}'.");
+        }
+
+        // A trailing slash is what makes `new Uri(authority, path)` APPEND the path instead of
+        // replacing the realm segment: `.../realms/school-collab` + `protocol/…` would otherwise
+        // resolve to `.../realms/protocol/…`.
+        var builder = new UriBuilder(uri);
+        if (!builder.Path.EndsWith('/'))
+        {
+            builder.Path += "/";
+        }
+
+        return builder.Uri;
+    }
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/MobileAuthenticationStateProvider.cs b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAuthenticationStateProvider.cs
new file mode 100644
index 00000000..9f62b25c
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/MobileAuthenticationStateProvider.cs
@@ -0,0 +1,81 @@
+using System.Security.Claims;
+using Microsoft.AspNetCore.Components.Authorization;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The client-side <see cref="AuthenticationStateProvider"/> the Blazor Hybrid head supplies
+/// (spec D6). A <c>BlazorWebView</c> brings none of its own, and the shared gates
+/// (<c>GateBase</c>/<c>TenantGate</c>) inject this service and re-evaluate whenever
+/// <c>AuthenticationStateChanged</c> fires — so without it the design system cannot gate anything
+/// at all.
+/// </summary>
+/// <remarks>
+/// <para>Claim spellings are the <b>raw realm spellings</b> (<c>tenant_id</c>, <c>tenant_name</c>,
+/// <c>roles</c>) because the shared UI reads them verbatim
+/// (<c>VisibleTenantService</c>'s <c>user.FindFirst("tenant_id")</c>). Nothing is renamed to
+/// <c>ClaimTypes.*</c> — that mapping is the server's, and the server's principal is not here.</para>
+/// <para>The component subscribes to <see cref="TokenSession.SessionChanged"/> only: the session
+/// signals, this provider notifies the gates. It never subscribes to its own
+/// <c>AuthenticationStateChanged</c>, so there is exactly one direction and no loop.</para>
+/// <para>Nothing on this path logs, and no token material reaches an exception message.</para>
+/// </remarks>
+public sealed class MobileAuthenticationStateProvider : AuthenticationStateProvider, IDisposable
+{
+    /// <summary>The scheme name on the principal produced from a stored session.</summary>
+    private const string AuthenticationType = "Bearer";
+
+    private readonly TokenSession _session;
+
+    /// <param name="session">The token session whose claims back the auth state.</param>
+    /// <exception cref="ArgumentNullException"><paramref name="session"/> is <see langword="null"/>.</exception>
+    public MobileAuthenticationStateProvider(TokenSession session)
+    {
+        ArgumentNullException.ThrowIfNull(session);
+
+        _session = session;
+        _session.SessionChanged += OnSessionChanged;
+    }
+
+    /// <inheritdoc />
+    public override async Task<AuthenticationState> GetAuthenticationStateAsync()
+    {
+        // Reads the persisted session on first use, and does nothing on every later call.
+        await _session.EnsureInitializedAsync();
+
+        var token = _session.AccessToken;
+        if (string.IsNullOrEmpty(token))
+        {
+            return CreateAnonymousState();
+        }
+
+        try
+        {
+            var claims = JwtPayloadReader.ReadClaimValues(token)
+                .SelectMany(claim => claim.Value.Select(value => new Claim(claim.Key, value)));
+
+            return new AuthenticationState(
+                new ClaimsPrincipal(new ClaimsIdentity(claims, AuthenticationType)));
+        }
+        catch (FormatException)
+        {
+            // A token we cannot read cannot authenticate anybody: show the signed-out state rather
+            // than a half-built principal. The APIs would refuse the same token anyway.
+            return CreateAnonymousState();
+        }
+    }
+
+    /// <summary>
+    /// A signed-out state, minted per call. It is deliberately NOT a cached static: unrelated
+    /// consumers must never be handed the same <see cref="ClaimsPrincipal"/> instance, whose
+    /// identity collection one of them could then observe as shared state.
+    /// </summary>
+    private static AuthenticationState CreateAnonymousState() =>
+        new(new ClaimsPrincipal(new ClaimsIdentity()));
+
+    /// <summary>Detaches from the session's signal. Host teardown calls this; a live single-app
+    /// host never does.</summary>
+    public void Dispose() => _session.SessionChanged -= OnSessionChanged;
+
+    private void OnSessionChanged() => NotifyAuthenticationStateChanged(GetAuthenticationStateAsync());
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/MobileClientRegistrationExtensions.cs b/src/Mobile/SchoolCollab.Mobile.Logic/MobileClientRegistrationExtensions.cs
new file mode 100644
index 00000000..a93c62f8
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/MobileClientRegistrationExtensions.cs
@@ -0,0 +1,116 @@
+using Microsoft.AspNetCore.Components.Authorization;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using SchoolCollab.Admin.Shared.Services;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>
+/// The mobile head's client-side service registration — the device's replacement for the module
+/// <c>ModuleServices.cs</c> files, which assume a <i>server</i> process (discovery-style base
+/// addresses, the Redis-backed tenant handler, server-to-server claim reads). The registered
+/// interface shapes are unchanged, so the components consuming the clients
+/// (<c>@inject CodedValuesApiClient</c>, …) need no edit: only the base address and the bearer
+/// handler differ.
+/// </summary>
+/// <remarks>
+/// It lives in <c>Mobile.Logic</c> (not in the head's <c>MauiProgram</c>) because the Logic split is
+/// load-bearing — "everything CI has to see lives in <c>Mobile.Logic</c>" — and it makes the
+/// base-address and handler wiring unit-testable on ubuntu. The host supplies the two platform
+/// implementations the auth path needs (<see cref="ITokenStore"/>,
+/// <see cref="ISystemBrowserAuthenticator"/>); they cannot be named from a plain <c>net10.0</c>
+/// library because they are MAUI Essentials types.
+/// </remarks>
+public static class MobileClientRegistrationExtensions
+{
+    /// <summary>
+    /// The single <see cref="MobileApiOptions"/> name every Admin.Shared client resolves its base
+    /// address with. All eight clients are server-side <c>settings-api</c> consumers
+    /// (<c>Settings.Application/ModuleServices.cs</c>), and <see cref="MobileApiOptions.Resolve"/>
+    /// THROWS on any name outside <c>StudentsApi</c>/<c>SettingsApi</c>/<c>AssignmentsApi</c> — so a
+    /// per-client invented name is a guaranteed runtime throw, not a configuration miss.
+    /// </summary>
+    private const string SettingsApiName = nameof(MobileApiOptions.SettingsApi);
+
+    /// <summary>
+    /// Registers the Admin.Shared API clients the mobile head can reach, each bound to the one
+    /// configured Settings API base address and carrying the bearer handler, plus the
+    /// <see cref="VisibleTenantService"/> the gates require.
+    /// </summary>
+    /// <exception cref="ArgumentNullException">An argument is <see langword="null"/>.</exception>
+    /// <exception cref="ArgumentOutOfRangeException"><see cref="MobileApiOptions.Resolve"/> rejects
+    /// <see cref="SettingsApiName"/> — unreachable while the name above matches
+    /// <see cref="MobileApiOptions.ApiNames"/>.</exception>
+    public static IServiceCollection AddMobileAdminClients(this IServiceCollection services, MobileApiOptions apiOptions)
+    {
+        ArgumentNullException.ThrowIfNull(services);
+        ArgumentNullException.ThrowIfNull(apiOptions);
+
+        // One resolve for the whole group: every client points at the Settings API, and a missing
+        // value degrades that one API (null base address) instead of failing the configuration.
+        var baseAddress = apiOptions.Resolve(SettingsApiName);
+
+        // Transient, like every delegating handler in this repo: IHttpClientFactory builds one per
+        // outgoing request through the client's pipeline.
+        services.TryAddTransient<BearerTokenDelegatingHandler>();
+
+        AddClient<CodedValuesApiClient>(services, baseAddress);
+        AddClient<ConfigFlagsApiClient>(services, baseAddress);
+        AddClient<TenantsApiClient>(services, baseAddress);
+        AddClient<EntityCodeRulesApiClient>(services, baseAddress);
+        AddClient<NotificationPolicyApiClient>(services, baseAddress);
+        AddClient<AssignmentPolicyApiClient>(services, baseAddress);
+        AddClient<SignatureConsentTextApiClient>(services, baseAddress);
+        AddClient<AssignmentAiPromptApiClient>(services, baseAddress);
+
+        // The gates' tenant condition reads the `tenant_id` claim through this service.
+        services.AddScoped<VisibleTenantService>();
+
+        return services;
+    }
+
+    /// <summary>
+    /// Registers the mobile auth path: the session, the interactive sign-in, the client-side
+    /// auth-state provider <b>as the one instance</b> every consumer sees, the testable clock, and
+    /// the named <c>oidc-token</c> client the token requests go through.
+    /// </summary>
+    /// <remarks>
+    /// <see cref="ITokenStore"/> and <see cref="ISystemBrowserAuthenticator"/> are deliberately NOT
+    /// registered here: their implementations are platform code and belong to the host. The head
+    /// binds them right after this call.
+    /// </remarks>
+    /// <exception cref="ArgumentNullException">An argument is <see langword="null"/>.</exception>
+    public static IServiceCollection AddMobileAuth(this IServiceCollection services, MobileAuthOptions authOptions)
+    {
+        ArgumentNullException.ThrowIfNull(services);
+        ArgumentNullException.ThrowIfNull(authOptions);
+
+        services.AddSingleton(authOptions);
+        services.AddSingleton(TimeProvider.System);
+
+        services.AddSingleton<TokenSession>();
+        services.AddSingleton<OidcLoginService>();
+
+        // The provider is registered under BOTH its concrete type (the host's teardown/DI seam) and
+        // the abstraction the gates inject, resolving to the SAME instance: the gates subscribe to
+        // AuthenticationStateChanged once per rendered gate, and a second instance would be a
+        // second, silent source of auth state.
+        services.AddSingleton<MobileAuthenticationStateProvider>();
+        services.AddSingleton<AuthenticationStateProvider>(
+            provider => provider.GetRequiredService<MobileAuthenticationStateProvider>());
+
+        // The token endpoints are absolute (built from the configured authority), so the named
+        // client's base address is convenience only — bound from configuration, never a literal.
+        services.AddHttpClient(
+            TokenSession.HttpClientName,
+            client => client.BaseAddress = authOptions.AuthorityUri);
+
+        return services;
+    }
+
+    private static void AddClient<TClient>(IServiceCollection services, Uri? baseAddress)
+        where TClient : class
+        => services
+            .AddHttpClient<TClient>(client => client.BaseAddress = baseAddress)
+            .AddHttpMessageHandler<BearerTokenDelegatingHandler>();
+}
diff --git a/src/Mobile/SchoolCollab.Mobile.Logic/OidcLoginService.cs b/src/Mobile/SchoolCollab.Mobile.Logic/OidcLoginService.cs
new file mode 100644
index 00000000..00f00e1a
--- /dev/null
+++ b/src/Mobile/SchoolCollab.Mobile.Logic/OidcLoginService.cs
@@ -0,0 +1,249 @@
+using System.Net.Http;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace SchoolCollab.Mobile.Logic;
+
+/// <summary>Where an interactive sign-in currently stands, for the sign-in control's own state.</summary>
+public enum SignInState
+{
+    /// <summary>No session. The UI shows the sign-in affordance and the gates their fallback.</summary>
+    SignedOut,
+
+    /// <summary>The system browser is open; the app is waiting for the redirect.</summary>
+    SigningIn,
+
+    /// <summary>A session is held; the gates can read the token's claims.</summary>
+    SignedIn,
+}
+
+/// <summary>
+/// The sign-in could not complete: the platform could not carry out the browser hand-off, the
+/// authorization response failed validation (its <c>state</c> did not match, or it carried no
+/// code), the code exchange failed at the token endpoint, or that endpoint could not be reached at
+/// all. No token was persisted either way.
+/// </summary>
+/// <remarks>The message names what failed — never a token, a refresh token, or header content. This
+/// is the ONE type every failed sign-in leaves the flow as, on purpose: the page's message bar owns
+/// it, so no sign-in outcome can reach the page's <c>&lt;ErrorBoundary&gt;</c> and replace the whole
+/// page — sign-in control included.</remarks>
+public sealed class SignInFailedException(string message) : Exception(message);
+
+/// <summary>
+/// The device's interactive OIDC sign-in: an Authorization Code + PKCE flow in the system browser.
+/// </summary>
+/// <remarks>
+/// <para><b>The security core.</b> The <c>code_verifier</c> is minted here, sent only to the token
+/// endpoint, and never persisted; the <c>code_challenge</c> is its SHA-256 (PKCE <c>S256</c>, plain
+/// — no <c>plain</c> method). Together with the random <c>state</c> this is the deliberate
+/// mitigation for the custom redirect scheme's hijack exposure (any app may register the same
+/// filter): a captured redirect yields a code that cannot be redeemed without the in-memory
+/// verifier, and a forged callback fails the state match before any token is stored. See
+/// <see cref="MobileAuthOptions"/>' remarks.</para>
+/// <para><b>No <c>nonce</c>, deliberately.</b> The client-side provider does not verify the
+/// id_token's signature (see <see cref="JwtPayloadReader"/>), so a nonce check would be theatre.
+/// PKCE + <c>state</c> are the replay/interception defences that matter for a native code flow.</para>
+/// <para>Sign-out is local only (clear the store); the Keycloak end-session round-trip is out of
+/// this round's scope.</para>
+/// </remarks>
+/// <param name="options">The credential settings (authority, client id, scheme/host, scope).</param>
+/// <param name="authenticator">The system-browser acquirer (platform-implemented).</param>
+/// <param name="session">The session the acquired tokens are applied to.</param>
+/// <param name="httpClientFactory">Supplies the <see cref="TokenSession.HttpClientName"/> client used for the code exchange.</param>
+public sealed class OidcLoginService(
+    MobileAuthOptions options,
+    ISystemBrowserAuthenticator authenticator,
+    TokenSession session,
+    IHttpClientFactory httpClientFactory)
+{
+    /// <summary>RFC 7636 requires a verifier of 43–128 characters; 32 random bytes encode to 43.</summary>
+    private const int CodeVerifierBytes = 32;
+
+    private const int StateBytes = 16;
+    private const string AuthorizationCodeGrantType = "authorization_code";
+    private const string S256ChallengeMethod = "S256";
+
+    private const string GrantTypeFormKey = "grant_type";
+    private const string ClientIdFormKey = "client_id";
+    private const string CodeFormKey = "code";
+    private const string RedirectUriFormKey = "redirect_uri";
+    private const string CodeVerifierFormKey = "code_verifier";
+
+    private const string StateResponseKey = "state";
+    private const string CodeResponseKey = "code";
+
+    /// <summary>
+    /// The one message both transport failures of the code exchange carry: what failed, and the
+    /// reassurance that no session came out of it. It names no endpoint, no value, and no header.
+    /// </summary>
+    private const string UnreachableTokenEndpointMessage =
+        "The token endpoint could not be reached (the connection failed or timed out), so the " +
+        "sign-in did not complete — no token was persisted.";
+
+    /// <summary>Where the current interactive sign-in stands.</summary>
+    public SignInState State { get; private set; } = SignInState.SignedOut;
+
+    /// <summary>
+    /// Runs one interactive sign-in: build the authorize request, open the system browser, verify
+    /// the returned <c>state</c> and <c>code</c>, exchange the code for tokens, and apply them to
+    /// the session (which signals the auth-state change).
+    /// </summary>
+    /// <exception cref="SignInCancelledException">The user dismissed the browser.</exception>
+    /// <exception cref="SignInFailedException">The authorization response was rejected, or the code
+    /// exchange failed. Nothing was persisted.</exception>
+    public async Task SignInAsync(CancellationToken cancellationToken = default)
+    {
+        State = SignInState.SigningIn;
+        try
+        {
+            var codeVerifier = CreateCodeVerifier();
+            var codeChallenge = CreateCodeChallenge(codeVerifier);
+            var state = CreateState();
+
+            // The realm-registered literal, NOT a normalized Uri: Keycloak matches redirect URIs
+            // exactly, and a pathless custom-scheme Uri normalizes to `.../signin-oidc/`.
+            var redirectUri = options.BuildRedirectUriString();
+
+            var response = await authenticator.AuthenticateAsync(
+                BuildAuthorizeUrl(codeChallenge, state, redirectUri),
+                options.BuildRedirectUri(),
+                cancellationToken);
+
+            if (!response.TryGetValue(StateResponseKey, out var returnedState)
+                || !string.Equals(returnedState, state, StringComparison.Ordinal))
+            {
+                throw new SignInFailedException(
+                    "The authorization response's state did not match the request's — no token was persisted.");
+            }
+
+            if (!response.TryGetValue(CodeResponseKey, out var code) || string.IsNullOrWhiteSpace(code))
+            {
+                throw new SignInFailedException(
+                    "The authorization response carried no authorization code — no token was persisted.");
+            }
+
+            await session.ApplyTokensAsync(
+                await ExchangeCodeAsync(code, codeVerifier, redirectUri, cancellationToken),
+                cancellationToken);
+
+            State = SignInState.SignedIn;
+        }
+        catch
+        {
+            // Cancellation, a rejected authorization response, or a rejected code exchange: all of
+            // them leave the session exactly as it was. Nothing is persisted unless the exchange
+            // succeeded, and the original exception (typed) reaches the UI unchanged.
+            State = SignInState.SignedOut;
+            throw;
+        }
+    }
+
+    /// <summary>
+    /// Ends the session locally: the store is cleared and the auth state is re-notified. There is
+    /// no Keycloak end-session redirect this round.
+    /// </summary>
+    public async Task SignOutAsync(CancellationToken cancellationToken = default)
+    {
+        await session.ClearAsync(cancellationToken);
+        State = SignInState.SignedOut;
+    }
+
+    private Uri BuildAuthorizeUrl(string codeChallenge, string state, string redirectUri)
+    {
+        var query = new Dictionary<string, string>
+        {
+            ["response_type"] = "code",
+            [ClientIdFormKey] = options.ClientId ?? string.Empty,
+            [RedirectUriFormKey] = redirectUri,
+            ["scope"] = options.ResolveScope(),
+            ["code_challenge"] = codeChallenge,
+            ["code_challenge_method"] = S256ChallengeMethod,
+            [StateResponseKey] = state,
+        };
+
+        var builder = new UriBuilder(options.BuildAuthorizeEndpointUri())
+        {
+            Query = string.Join('&', query.Select(pair =>
+                $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(pair.Value)}")),
+        };
+
+        return builder.Uri;
+    }
+
+    private async Task<TokenResponse> ExchangeCodeAsync(
+        string code,
+        string codeVerifier,
+        string redirectUri,
+        CancellationToken cancellationToken)
+    {
+        var form = new Dictionary<string, string>
+        {
+            [GrantTypeFormKey] = AuthorizationCodeGrantType,
+            [ClientIdFormKey] = options.ClientId ?? string.Empty,
+            [CodeFormKey] = code,
+            [RedirectUriFormKey] = redirectUri,
+            // The verifier's only journey: from memory into this request body. It is never written
+            // to the token store, so a stolen redirect (or a stolen store) cannot redeem a code.
+            [CodeVerifierFormKey] = codeVerifier,
+        };
+
+        using var request = new HttpRequestMessage(HttpMethod.Post, options.BuildTokenEndpointUri())
+        {
+            Content = new FormUrlEncodedContent(form),
+        };
+
+        var client = httpClientFactory.CreateClient(TokenSession.HttpClientName);
+
+        HttpResponseMessage? response = null;
+        try
+        {
+            response = await client.SendAsync(request, cancellationToken);
+            var body = await response.Content.ReadAsStringAsync(cancellationToken);
+
+            if (!response.IsSuccessStatusCode)
+            {
+                // Names the status and the endpoint's error CODE only — never a credential value.
+                var errorCode = TokenResponse.TryReadErrorCode(body);
+                throw new SignInFailedException(
+                    "The token endpoint rejected the code exchange " +
+                    $"(HTTP {(int)response.StatusCode}{(errorCode is null ? string.Empty : $" ({errorCode})")}).");
+            }
+
+            return TokenResponse.Parse(body);
+        }
+        catch (Exception exception)
+            when (exception is HttpRequestException or TimeoutException or IOException)
+        {
+            // The token endpoint was unreachable — DNS, socket, TLS, a timeout, or a read that
+            // failed mid-response — so the exchange produced no credential. This is the same
+            // normalisation the refresh path applies (BearerTokenDelegatingHandler): the transport
+            // failure becomes the typed sign-in failure the page already surfaces in its message
+            // bar, so it can never escape into the page's <ErrorBoundary> and replace the whole
+            // page — sign-in button included. Nothing is logged and no value is named.
+            throw new SignInFailedException(UnreachableTokenEndpointMessage);
+        }
+        catch (TaskCanceledException) when (!cancellationToken.IsCancellationRequested)
+        {
+            // The token client's OWN deadline ended the attempt. Measured on this stack that is the
+            // shape an HttpClient timeout actually takes (a TaskCanceledException, never a bare
+            // TimeoutException — see BearerTokenDelegatingHandlerTests), and it is the same sign-in
+            // outcome as the unreachable endpoint above. The guard is what keeps this a sign-in
+            // outcome instead of swallowing the CALLER's cancellation, which must keep propagating.
+            throw new SignInFailedException(UnreachableTokenEndpointMessage);
+        }
+        finally
+        {
+            response?.Dispose();
+        }
+    }
+
+    private static string CreateCodeVerifier() => Base64Url(RandomNumberGenerator.GetBytes(CodeVerifierBytes));
+
+    private static string CreateCodeChallenge(string codeVerifier) =>
+        Base64Url(SHA256.HashData(Encoding.ASCII.GetBytes(codeVerifier)));
+
+    private static string CreateState() => Base64Url(RandomNumberGenerator.GetBytes(StateBytes));
+
+    private static string Base64Url(ReadOnlySpan<byte> bytes) =>
+        Convert.ToBase64String(bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+}
