+            // the session has already been discarded, so the app stays signed out. Show the typed
+            // message (it names the key and the platform failure, never a value) here — a storage
+            // failure is a sign-in outcome the page reports, not something the ErrorBoundary owns.
+            _errorMessage = ex.Message;
