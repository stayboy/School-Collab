+            var session = new TokenSession(store, factory, AuthOptions(), new MutableTimeProvider(Now));
+            var handler = new BearerTokenDelegatingHandler(session) { InnerHandler = primaryHandler };
+            Client = new HttpClient(handler);
+        }
+
+        public FakeTokenStore Store { get; }
+
+        public ScriptedHandler TokenHandler { get; }
+
+        public RecordingHandler PrimaryHandler { get; }
+
+        public HttpClient Client { get; }
+
+        /// <summary>A session with the given state, and the handler pipeline under test.</summary>
+        /// <param name="hangs">The token endpoint never answers — the refresh runs until the client's
+        /// own timeout, or the caller's cancellation, ends it.</param>
+        /// <param name="tokenEndpointTimeout">The token client's own <see cref="HttpClient.Timeout"/>,
+        /// left at its default when absent.</param>
+        public static async Task<Fixture> CreateAsync(
+            string? accessToken = null,
+            TimeSpan expiresIn = default,
+            string? refreshToken = null,
+            Exception? tokenEndpointFailure = null,
+            bool hangs = false,
+            TimeSpan? tokenEndpointTimeout = null)
+        {
+            var store = new FakeTokenStore();
+            if (accessToken is not null)
+            {
+                await store.WriteAsync(TokenKeys.AccessToken, accessToken);
+                await store.WriteAsync(
+                    TokenKeys.ExpiresAt,
+                    Now.Add(expiresIn).ToString("O", CultureInfo.InvariantCulture));
+            }
+
+            if (refreshToken is not null)
+            {
+                await store.WriteAsync(TokenKeys.RefreshToken, refreshToken);
+            }
+
+            var tokenHandler = new ScriptedHandler(
+                HttpStatusCode.OK,
+                TokenBody("refreshed-access-token", "rotated-refresh-token"))
+            {
+                Failure = tokenEndpointFailure,
+                Hangs = hangs,
+            };
+
+            return new Fixture(store, tokenHandler, new RecordingHandler(), tokenEndpointTimeout);
+        }
+    }
+
+    /// <summary>
+    /// The three transport shapes an unreachable token endpoint surfaces as — the ones the bearer
+    /// handler degrades on (see <see cref="BearerTokenDelegatingHandler"/>).
+    /// <see cref="TransportFailure.RequestFailed"/> is the realistic one on a device:
+    /// Android's handler wraps DNS, socket and TLS failures in <see cref="HttpRequestException"/>.
+    /// Public only because an MSTest method is public and a parameter type may not be less
+    /// accessible than the method that takes it — no other type outside this class uses it.
+    /// </summary>
+    public enum TransportFailure
+    {
+        RequestFailed,
+        TimedOut,
+        ReadFailed,
+    }
+
+    private static Exception TransportException(TransportFailure failure) => failure switch
+    {
+        TransportFailure.RequestFailed =>
+            new HttpRequestException("The token endpoint was unreachable."),
+        TransportFailure.TimedOut =>
+            new TimeoutException("The token endpoint did not answer in time."),
+        _ => new IOException("The token endpoint's response could not be read."),
+    };
+
+    private static string TokenBody(string accessToken, string refreshToken) =>
+        $$"""{"access_token":"{{accessToken}}","refresh_token":"{{refreshToken}}","expires_in":300,"token_type":"Bearer"}""";
+
+    private static MobileAuthOptions AuthOptions() => new()
+    {
+        Authority = new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab").Uri.ToString(),
+        ClientId = "school-collab-mobile-client",
+        RedirectScheme = "schoolcollab",
+        RedirectHost = "signin-oidc",
+    };
+
+    /// <summary>The far end of the pipeline: records what actually arrived.</summary>
+    private sealed class RecordingHandler : HttpMessageHandler
+    {
+        public string? AuthorizationHeader { get; private set; }
+
+        public Uri? RequestUri { get; private set; }
+
+        public int RequestCount { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            RequestCount++;
+            RequestUri = request.RequestUri;
+            AuthorizationHeader = request.Headers.TryGetValues("Authorization", out var values)
+                ? string.Join(",", values)
+                : null;
+
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new StringContent("{}", Encoding.UTF8, "application/json"),
+            });
+        }
+    }
+
+    private sealed class FakeTokenStore : ITokenStore
+    {
+        private static readonly string[] Keys = [TokenKeys.AccessToken, TokenKeys.RefreshToken, TokenKeys.ExpiresAt];
+
+        private readonly Dictionary<string, string?> _values = new(StringComparer.Ordinal);
+
+        public IEnumerable<string?> Values => Keys.Select(key => _values.TryGetValue(key, out var value) ? value : null);
+
+        /// <summary>When set, every write is refused — the keystore that cannot keep the renewed session.</summary>
+        public bool RefusesWrite { get; set; }
+
+        public Task<string?> ReadAsync(string key, CancellationToken cancellationToken = default) =>
+            Task.FromResult(_values.TryGetValue(key, out var value) ? value : null);
+
+        public Task WriteAsync(string key, string value, CancellationToken cancellationToken = default)
+        {
+            if (RefusesWrite)
+            {
+                throw new TokenStoreException(
+                    $"The device's token store refused the write of its '{key}' entry (PlatformException).");
+            }
+
+            _values[key] = value;
+            return Task.CompletedTask;
+        }
+
+        public Task ClearAsync(string key, CancellationToken cancellationToken = default)
+        {
+            _values[key] = null;
+            return Task.CompletedTask;
+        }
+    }
+
+    private sealed class StubHttpClientFactory(HttpMessageHandler handler) : IHttpClientFactory
+    {
+        /// <summary>
+        /// When set, the token client's own <see cref="HttpClient.Timeout"/> — the real clock that
+        /// turns a hung token endpoint into a client-timed-out refresh. Absent, the client keeps its
+        /// default deadline, which no test here waits out.
+        /// </summary>
+        public TimeSpan? Timeout { get; set; }
+
+        public HttpClient CreateClient(string name)
+        {
+            var client = new HttpClient(handler, disposeHandler: false);
+
+            if (Timeout is not null)
+            {
+                client.Timeout = Timeout.Value;
+            }
+
+            return client;
+        }
+    }
+
+    /// <summary>
+    /// The token endpoint: records the refresh POST and answers with a canned response, or — when
+    /// <see cref="Failure"/> is set — dies in transport without answering, or — when
+    /// <see cref="Hangs"/> is set — never answers at all.
+    /// </summary>
+    private sealed class ScriptedHandler(HttpStatusCode status, string body) : HttpMessageHandler
+    {
+        private readonly TaskCompletionSource _entered = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        public HttpStatusCode Status { get; set; } = status;
+
+        public string Body { get; set; } = body;
+
+        /// <summary>When set, the attempt dies in transport instead of answering.</summary>
+        public Exception? Failure { get; set; }
+
+        /// <summary>When set, the attempt never answers — the token endpoint that hangs.</summary>
+        public bool Hangs { get; set; }
+
+        /// <summary>Completes once a request has reached this far end, so a test can act on a refresh
+        /// that is still in flight instead of racing it.</summary>
+        public Task Entered => _entered.Task;
+
+        public List<HttpRequestMessage> Requests { get; } = [];
+
+        protected override async Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            Requests.Add(request);
+            _entered.TrySetResult();
+
+            if (Failure is not null)
+            {
+                throw Failure;
+            }
+
+            if (Hangs)
+            {
+                await Task.Delay(System.Threading.Timeout.InfiniteTimeSpan, cancellationToken);
+            }
+
+            return new HttpResponseMessage(Status)
+            {
+                Content = new StringContent(Body, Encoding.UTF8, "application/json"),
+            };
+        }
+    }
+
+    private sealed class MutableTimeProvider(DateTimeOffset now) : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => now;
+    }
+}
diff --git a/tests/SchoolCollab.Mobile.Tests.Unit/JwtPayloadReaderTests.cs b/tests/SchoolCollab.Mobile.Tests.Unit/JwtPayloadReaderTests.cs
new file mode 100644
index 00000000..6524ac19
--- /dev/null
+++ b/tests/SchoolCollab.Mobile.Tests.Unit/JwtPayloadReaderTests.cs
@@ -0,0 +1,139 @@
+using System.Text;
+using FluentAssertions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Tests.Unit;
+
+/// <summary>
+/// Covers <see cref="JwtPayloadReader"/> — the device-side claim read that backs the client-side
+/// auth state. Fixture tokens are built here rather than fetched: no live Keycloak participates.
+/// </summary>
+[TestClass]
+public class JwtPayloadReaderTests
+{
+    [TestMethod]
+    public void ReadClaimValues_DecodesTheRawRealmClaimSpellings()
+    {
+        var token = Jwt("""
+            {
+              "tenant_id": "00000000-0000-0000-0000-000000000002",
+              "tenant_name": "Dev School",
+              "teacher_id": "00000000-0000-0000-0000-000000000003",
+              "sub": "8f14e45f"
+            }
+            """);
+
+        var claims = JwtPayloadReader.ReadClaimValues(token);
+
+        claims["tenant_id"].Should().Equal("00000000-0000-0000-0000-000000000002");
+        claims["tenant_name"].Should().Equal("Dev School");
+        claims["teacher_id"].Should().Equal("00000000-0000-0000-0000-000000000003");
+        claims["sub"].Should().Equal("8f14e45f");
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_ReadsAMultivaluedClaimAsOneValuePerArrayElement()
+    {
+        var token = Jwt("""{ "roles": ["teacher", "staff"] }""");
+
+        var claims = JwtPayloadReader.ReadClaimValues(token);
+
+        // The realm's roles mapper is multivalued; the gates and the client-side provider flatten the
+        // array into one claim per role.
+        claims["roles"].Should().Equal("teacher", "staff");
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_LeavesNonStringScalarsAsTheirJsonText()
+    {
+        var token = Jwt("""{ "exp": 1760000000, "email_verified": true }""");
+
+        var claims = JwtPayloadReader.ReadClaimValues(token);
+
+        claims["exp"].Should().Equal("1760000000");
+        claims["email_verified"].Should().Equal("true");
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_IgnoresObjectValuedProperties()
+    {
+        var token = Jwt("""{ "realm_access": { "roles": ["teacher"] }, "sub": "abc" }""");
+
+        var claims = JwtPayloadReader.ReadClaimValues(token);
+
+        claims.Should().NotContainKey("realm_access");
+        claims["sub"].Should().Equal("abc");
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_DoesNotVerifyTheSignature_ByDesign()
+    {
+        // The signature segment is deliberately garbage. Verification is the API's job
+        // (AddJwtBearer) and the claims read here only drive UI visibility, so the reader must NOT
+        // grow signature logic: a forged token buys nothing and would still be refused by every
+        // endpoint. If this test ever fails because the reader started verifying, that is a
+        // deliberate design change, not a bug fix.
+        var token = Jwt("""{ "tenant_id": "00000000-0000-0000-0000-000000000002" }""", signature: "%%not-a-signature%%");
+
+        var claims = JwtPayloadReader.ReadClaimValues(token);
+
+        claims["tenant_id"].Should().Equal("00000000-0000-0000-0000-000000000002");
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_AcceptsUnpaddedBase64UrlSegments()
+    {
+        // A real Keycloak token's payload length is not a multiple of 3, so its base64url segment
+        // carries no '=' padding — the decoder has to restore it.
+        var token = Jwt("""{ "tenant_name": "Dev School" }""");
+
+        token.Split('.')[1].Should().NotContain("=");
+        JwtPayloadReader.ReadClaimValues(token)["tenant_name"].Should().Equal("Dev School");
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_RejectsATokenThatIsNotThreeSegments()
+    {
+        Action read = () => JwtPayloadReader.ReadClaimValues("only.two");
+
+        read.Should().Throw<FormatException>();
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_RejectsAPayloadSegmentThatIsNotBase64Url()
+    {
+        Action read = () => JwtPayloadReader.ReadClaimValues("header.!!!not-base64!!!.signature");
+
+        read.Should().Throw<FormatException>();
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_RejectsAPayloadThatIsNotAJsonObject()
+    {
+        var token = $"header.{ToBase64Url("\"just-a-string\"")}.signature";
+
+        Action read = () => JwtPayloadReader.ReadClaimValues(token);
+
+        read.Should().Throw<FormatException>();
+    }
+
+    [TestMethod]
+    public void ReadClaimValues_RejectsAnEmptyToken()
+    {
+        Action read = () => JwtPayloadReader.ReadClaimValues("   ");
+
+        read.Should().Throw<ArgumentException>();
+    }
+
+    /// <summary>Builds a three-segment JWT from a payload JSON fragment. The signature segment is
+    /// never read by <see cref="JwtPayloadReader"/> (see the no-verification test).</summary>
+    private static string Jwt(string payloadJson, string signature = "signature-not-verified") =>
+        $"{ToBase64Url("{\"alg\":\"RS256\",\"typ\":\"JWT\"}")}.{ToBase64Url(payloadJson)}.{ToBase64Url(signature)}";
+
+    private static string ToBase64Url(string value) => Convert
+        .ToBase64String(Encoding.UTF8.GetBytes(value))
+        .TrimEnd('=')
+        .Replace('+', '-')
+        .Replace('/', '_');
+}
diff --git a/tests/SchoolCollab.Mobile.Tests.Unit/MobileAuthOptionsTests.cs b/tests/SchoolCollab.Mobile.Tests.Unit/MobileAuthOptionsTests.cs
new file mode 100644
index 00000000..07b13d43
--- /dev/null
+++ b/tests/SchoolCollab.Mobile.Tests.Unit/MobileAuthOptionsTests.cs
@@ -0,0 +1,191 @@
+using FluentAssertions;
+using Microsoft.Extensions.Configuration;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Tests.Unit;
+
+/// <summary>
+/// Covers <see cref="MobileAuthOptions"/> — the credential settings and the addresses built from them.
+/// Addresses are composed with <see cref="UriBuilder"/> rather than typed as literals on purpose: the
+/// rule the class enforces is "never a URL string literal in C#" (spec D8), and a test that violated it
+/// would be the one place the rule is allowed to rot. The last test pins the rule at class granularity.
+/// </summary>
+[TestClass]
+public class MobileAuthOptionsTests
+{
+    private static readonly string Authority =
+        new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab").Uri.ToString();
+
+    [TestMethod]
+    public void FromConfiguration_BindsEverySetting_FromTheMobileAuthSection()
+    {
+        var options = MobileAuthOptions.FromConfiguration(BuildConfiguration(
+            ("MobileAuth:Authority", Authority),
+            ("MobileAuth:ClientId", "school-collab-mobile-client"),
+            ("MobileAuth:RedirectScheme", "schoolcollab"),
+            ("MobileAuth:RedirectHost", "signin-oidc"),
+            ("MobileAuth:Scope", "openid profile"),
+            ("MobileAuth:RequiredScopes:0", "email")));
+
+        options.Authority.Should().Be(Authority);
+        options.ClientId.Should().Be("school-collab-mobile-client");
+        options.RedirectScheme.Should().Be("schoolcollab");
+        options.RedirectHost.Should().Be("signin-oidc");
+        options.Scope.Should().Be("openid profile");
+        options.RequiredScopes.Should().Equal("email");
+    }
+
+    [TestMethod]
+    public void FromConfiguration_WithoutTheSection_YieldsTheDefaults()
+    {
+        var options = MobileAuthOptions.FromConfiguration(BuildConfiguration());
+
+        options.Scope.Should().Be("openid", "the ID token requires the openid scope, so it is the one non-empty default.");
+        options.RequiredScopes.Should().BeEmpty();
+        options.Authority.Should().BeNull();
+        options.ClientId.Should().BeNull();
+        options.RedirectScheme.Should().BeNull(
+            "the scheme and host are configuration (the realm and the platform manifests must agree with them), not literals.");
+        options.RedirectHost.Should().BeNull();
+    }
+
+    [TestMethod]
+    public void FromConfiguration_RejectsANullConfiguration()
+    {
+        var bind = () => MobileAuthOptions.FromConfiguration(null!);
+
+        bind.Should().Throw<ArgumentNullException>();
+    }
+
+    [TestMethod]
+    public void BuildRedirectUri_JoinsTheSchemeAndTheAuthority()
+    {
+        var options = Options();
+
+        options.BuildRedirectUri().Should().Be(new Uri("schoolcollab://signin-oidc"),
+            "the same literal the realm registers in redirectUris and the platform filter/plist declares — Keycloak matches it exactly.");
+    }
+
+    [TestMethod]
+    public void BuildRedirectUri_ThrowsWhenTheSchemeOrHostIsMissing()
+    {
+        var options = Options();
+        options.RedirectHost = "   ";
+
+        var build = () => options.BuildRedirectUri();
+
+        build.Should().Throw<InvalidOperationException>().WithMessage("*RedirectHost*");
+    }
+
+    [TestMethod]
+    public void AuthorityUri_NormalizesToAnAbsoluteUriWithATrailingSlash()
+    {
+        var options = Options();
+
+        options.AuthorityUri.Should().Be(new Uri($"{Authority}/"));
+    }
+
+    [TestMethod]
+    public void AuthorityUri_IsNull_WhenTheAuthorityIsBlankOrUnset()
+    {
+        var options = Options();
+        options.Authority = "  ";
+
+        options.AuthorityUri.Should().BeNull("the head must be able to start without a credential configuration and fail only at sign-in.");
+    }
+
+    [TestMethod]
+    public void AuthorityUri_RejectsARelativeAuthority()
+    {
+        var options = Options();
+        options.Authority = "realms/school-collab";
+
+        var read = () => options.AuthorityUri;
+
+        read.Should().Throw<InvalidOperationException>().WithMessage("*MobileAuth:Authority*");
+    }
+
+    [TestMethod]
+    public void BuildAuthorizeAndTokenEndpoints_AppendTheKeycloakPaths_ToTheAuthority()
+    {
+        var options = Options();
+
+        // The trailing-slash normalization is load-bearing: without it `new Uri(authority, path)` would
+        // replace the last realm segment instead of appending.
+        options.BuildAuthorizeEndpointUri().Should()
+            .Be(new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab/protocol/openid-connect/auth").Uri);
+        options.BuildTokenEndpointUri().Should()
+            .Be(new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab/protocol/openid-connect/token").Uri);
+    }
+
+    [TestMethod]
+    public void BuildTokenEndpointUri_ThrowsWhenTheAuthorityIsUnset()
+    {
+        var options = Options();
+        options.Authority = null;
+
+        var build = () => options.BuildTokenEndpointUri();
+
+        build.Should().Throw<InvalidOperationException>().WithMessage("*MobileAuth:Authority*");
+    }
+
+    [TestMethod]
+    public void ResolveScope_RequestsTheScopePlusTheRequiredScopes_Deduplicated()
+    {
+        var options = Options();
+        options.Scope = "openid";
+        options.RequiredScopes = ["profile", "openid", " "];
+
+        options.ResolveScope().Should().Be("openid profile",
+            "the request scope is Scope plus the required scopes, de-duplicated in request order.");
+    }
+
+    [TestMethod]
+    public void MobileAuthOptions_ClassCarriesNoBaseAddressLiteral()
+    {
+        var source = File.ReadAllText(Path.Combine(
+            FindRepoRoot(),
+            "src",
+            "Mobile",
+            "SchoolCollab.Mobile.Logic",
+            "MobileAuthOptions.cs"));
+
+        // Spec D8: no `http(s)://` URL string literal anywhere under src/. The CI guard cannot see one
+        // (CrossModuleWiringTests' excludedHosts silently skips localhost), so this class-level check is
+        // the mechanical half of the rule for the credential settings.
+        source.Should().NotMatchRegex(
+            "\"(https?)://[^\"]+\"",
+            "an authority or endpoint URL must come from configuration, never from this class.");
+    }
+
+    private static MobileAuthOptions Options() => new()
+    {
+        Authority = Authority,
+        ClientId = "school-collab-mobile-client",
+        RedirectScheme = "schoolcollab",
+        RedirectHost = "signin-oidc",
+    };
+
+    private static IConfiguration BuildConfiguration(params (string Key, string Value)[] values) =>
+        new ConfigurationBuilder()
+            .AddInMemoryCollection(values.ToDictionary(v => v.Key, v => (string?)v.Value))
+            .Build();
+
+    /// <summary>Walks up from the test bin directory to the repository root. THROWS when it cannot be
+    /// found, so a moved file cannot make the source-shape assertion pass vacuously (the same
+    /// fail-loud rule the architecture tests' discovery helpers follow).</summary>
+    private static string FindRepoRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null
+               && !Directory.Exists(Path.Combine(directory.FullName, "src", "Mobile", "SchoolCollab.Mobile.Logic")))
+        {
+            directory = directory.Parent;
+        }
+
+        return directory?.FullName
+            ?? throw new InvalidOperationException(
+                "Could not locate src/Mobile/SchoolCollab.Mobile.Logic from " + AppContext.BaseDirectory);
+    }
+}
diff --git a/tests/SchoolCollab.Mobile.Tests.Unit/MobileAuthenticationStateProviderTests.cs b/tests/SchoolCollab.Mobile.Tests.Unit/MobileAuthenticationStateProviderTests.cs
new file mode 100644
index 00000000..4e01d84c
--- /dev/null
+++ b/tests/SchoolCollab.Mobile.Tests.Unit/MobileAuthenticationStateProviderTests.cs
@@ -0,0 +1,221 @@
+using System.Globalization;
+using System.Net.Http;
+using System.Text;
+using FluentAssertions;
+using Microsoft.AspNetCore.Components.Authorization;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Admin.Shared.Services;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Tests.Unit;
+
+/// <summary>
+/// Covers <see cref="MobileAuthenticationStateProvider"/> — the client-side auth bridge the shared
+/// gates require. The claim-spelling contract asserted here is the SAME read the shared UI performs:
+/// <see cref="VisibleTenantService"/> is exercised against the provider, exactly as
+/// <c>TenantGate</c>'s condition does (spec §8 L3 criterion 5's ubuntu-mechanical half).
+/// </summary>
+[TestClass]
+public class MobileAuthenticationStateProviderTests
+{
+    private static readonly DateTimeOffset Now = new(2026, 10, 13, 12, 0, 0, TimeSpan.Zero);
+
+    /// <summary>A fixture access token carrying the raw realm claim spellings the mappers emit.
+    /// Built here rather than fetched: no live Keycloak participates in this suite.</summary>
+    private static readonly string ClaimsToken = Jwt(
+        """
+        {
+          "tenant_id": "00000000-0000-0000-0000-000000000002",
+          "tenant_name": "Dev School",
+          "teacher_id": "00000000-0000-0000-0000-000000000003",
+          "roles": ["teacher", "staff"]
+        }
+        """);
+
+    [TestMethod]
+    public async Task GetAuthenticationStateAsync_IsAnonymous_WhenNoSessionIsStored()
+    {
+        var fixture = new Fixture();
+
+        var state = await fixture.Provider.GetAuthenticationStateAsync();
+
+        state.User.Identity!.IsAuthenticated.Should().BeFalse(
+            "an empty session must show the signed-out state, so the gates render their fallback.");
+        state.User.Claims.Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task GetAuthenticationStateAsync_MintsAFreshAnonymousState_SoNoTwoConsumersShareOne()
+    {
+        var fixture = new Fixture();
+
+        var first = await fixture.Provider.GetAuthenticationStateAsync();
+        var second = await fixture.Provider.GetAuthenticationStateAsync();
+
+        first.User.Should().NotBeSameAs(
+            second.User,
+            "unrelated consumers must never be handed the same ClaimsPrincipal instance — a cached anonymous principal is shared auth state.");
+        first.User.Identity!.IsAuthenticated.Should().BeFalse();
+        second.User.Identity!.IsAuthenticated.Should().BeFalse();
+    }
+
+    [TestMethod]
+    public async Task GetAuthenticationStateAsync_YieldsAnAuthenticatedPrincipal_WithTheRawRealmClaimSpellings()
+    {
+        var fixture = new Fixture();
+        await fixture.SignInAsync();
+
+        var state = await fixture.Provider.GetAuthenticationStateAsync();
+
+        state.User.Identity!.IsAuthenticated.Should().BeTrue();
+        state.User.FindFirst("tenant_id")!.Value.Should().Be("00000000-0000-0000-0000-000000000002");
+        state.User.FindFirst("tenant_name")!.Value.Should().Be("Dev School");
+        state.User.FindFirst("teacher_id")!.Value.Should().Be("00000000-0000-0000-0000-000000000003");
+        state.User.FindAll("roles").Select(claim => claim.Value).Should().Equal(
+            new[] { "teacher", "staff" },
+            "a multivalued claim reads as one claim per array element.");
+    }
+
+    [TestMethod]
+    public async Task GetAuthenticationStateAsync_BacksTheGatesOwnTenantRead()
+    {
+        var fixture = new Fixture();
+        await fixture.SignInAsync();
+
+        // The real consumer, not a re-implementation of it: this is the exact service TenantGate's
+        // TenantSelectedCondition calls, and it reads the raw `tenant_id` claim (VisibleTenantService).
+        var visibleTenant = new VisibleTenantService(
+            fixture.Provider,
+            NullLogger<VisibleTenantService>.Instance);
+
+        var scope = await visibleTenant.GetScopeAsync();
+
+        scope.IsRealTenant.Should().BeTrue();
+        scope.TenantId.Should().Be(Guid.Parse("00000000-0000-0000-0000-000000000002"));
+        scope.TenantName.Should().Be("Dev School");
+    }
+
+    [TestMethod]
+    public async Task NotifyAuthenticationStateChanged_FiresOnSessionStartAndSessionEnd()
+    {
+        var fixture = new Fixture();
+        var notified = new List<Task<AuthenticationState>>();
+        fixture.Provider.AuthenticationStateChanged += task => notified.Add(task);
+
+        await fixture.SignInAsync();
+        (await notified.Single()).User.Identity!.IsAuthenticated.Should().BeTrue();
+
+        notified.Clear();
+        await fixture.Session.ClearAsync();
+        (await notified.Single()).User.Identity!.IsAuthenticated.Should().BeFalse(
+            "sign-out must re-notify the gates, which is what flips TenantGate back to its fallback branch.");
+    }
+
+    [TestMethod]
+    public async Task GetAuthenticationStateAsync_IgnoresATokenWhosePayloadCannotBeRead()
+    {
+        var fixture = new Fixture();
+        await fixture.Store.WriteAsync(TokenKeys.AccessToken, "not-a-jwt");
+        await fixture.Store.WriteAsync(TokenKeys.ExpiresAt, UsableUntil(TimeSpan.FromMinutes(5)));
+
+        var state = await fixture.Provider.GetAuthenticationStateAsync();
+
+        state.User.Identity!.IsAuthenticated.Should().BeFalse(
+            "a token nobody can read cannot authenticate anybody — and the APIs would refuse it too.");
+    }
+
+    [TestMethod]
+    public async Task Dispose_DetachesFromTheSession()
+    {
+        var fixture = new Fixture();
+        var notified = 0;
+        fixture.Provider.AuthenticationStateChanged += _ => notified++;
+
+        fixture.Provider.Dispose();
+        await fixture.Session.ClearAsync();
+
+        notified.Should().Be(0);
+    }
+
+    private sealed class Fixture
+    {
+        public Fixture()
+        {
+            Store = new FakeTokenStore();
+            Session = new TokenSession(Store, new StubHttpClientFactory(), AuthOptions(), new MutableTimeProvider(Now));
+            Provider = new MobileAuthenticationStateProvider(Session);
+        }
+
+        public FakeTokenStore Store { get; }
+
+        public TokenSession Session { get; }
+
+        public MobileAuthenticationStateProvider Provider { get; }
+
+        /// <summary>Simulates what <see cref="OidcLoginService"/> does after a successful exchange.</summary>
+        public async Task SignInAsync() =>
+            await Session.ApplyTokensAsync(new TokenResponse(ClaimsToken, "a-refresh-token", 300));
+    }
+
+    private static MobileAuthOptions AuthOptions() => new()
+    {
+        Authority = new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab").Uri.ToString(),
+        ClientId = "school-collab-mobile-client",
+        RedirectScheme = "schoolcollab",
+        RedirectHost = "signin-oidc",
+    };
+
+    private static string UsableUntil(TimeSpan offset) =>
+        Now.Add(offset).ToString("O", CultureInfo.InvariantCulture);
+
+    private static string Jwt(string payloadJson) =>
+        $"{ToBase64Url("{{\"alg\":\"RS256\",\"typ\":\"JWT\"}}")}.{ToBase64Url(payloadJson)}.signature-not-verified";
+
+    private static string ToBase64Url(string value) => Convert
+        .ToBase64String(Encoding.UTF8.GetBytes(value))
+        .TrimEnd('=')
+        .Replace('+', '-')
+        .Replace('/', '_');
+
+    private sealed class FakeTokenStore : ITokenStore
+    {
+        private readonly Dictionary<string, string?> _values = new(StringComparer.Ordinal);
+
+        public Task<string?> ReadAsync(string key, CancellationToken cancellationToken = default) =>
+            Task.FromResult(_values.TryGetValue(key, out var value) ? value : null);
+
+        public Task WriteAsync(string key, string value, CancellationToken cancellationToken = default)
+        {
+            _values[key] = value;
+            return Task.CompletedTask;
+        }
+
+        public Task ClearAsync(string key, CancellationToken cancellationToken = default)
+        {
+            _values[key] = null;
+            return Task.CompletedTask;
+        }
+    }
+
+    /// <summary>No HTTP is expected on this path; the factory exists only to satisfy the session's
+    /// constructor.</summary>
+    private sealed class StubHttpClientFactory : IHttpClientFactory
+    {
+        public HttpClient CreateClient(string name) =>
+            new(new UnreachableHandler(), disposeHandler: false);
+    }
+
+    private sealed class UnreachableHandler : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken) =>
+            throw new InvalidOperationException("The auth-state provider must never make an HTTP call.");
+    }
+
+    private sealed class MutableTimeProvider(DateTimeOffset now) : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => now;
+    }
+}
diff --git a/tests/SchoolCollab.Mobile.Tests.Unit/MobileClientRegistrationTests.cs b/tests/SchoolCollab.Mobile.Tests.Unit/MobileClientRegistrationTests.cs
new file mode 100644
index 00000000..4ae67462
--- /dev/null
+++ b/tests/SchoolCollab.Mobile.Tests.Unit/MobileClientRegistrationTests.cs
@@ -0,0 +1,253 @@
+using System.Net;
+using System.Net.Http;
+using System.Text;
+using FluentAssertions;
+using Microsoft.AspNetCore.Components.Authorization;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Admin.Shared.Services;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Tests.Unit;
+
+/// <summary>
+/// Covers <see cref="MobileClientRegistrationExtensions"/> — the client-side replacement for the
+/// module <c>ModuleServices.cs</c> registrations. Two contracts are pinned here: the registered
+/// clients resolve against the ONE configured Settings API name (an invented per-client name would
+/// throw straight out of <see cref="MobileApiOptions.Resolve"/> at registration time), and the
+/// pipeline a registered client actually uses carries both the configured base address and the
+/// session's bearer token.
+/// </summary>
+[TestClass]
+public class MobileClientRegistrationTests
+{
+    private const int SettingsApiPort = 7460;
+
+    private static readonly string SettingsBaseAddress =
+        new UriBuilder(Uri.UriSchemeHttps, "settings.example", SettingsApiPort).Uri.ToString();
+
+    private static readonly Type[] AdminSharedClients =
+    [
+        typeof(CodedValuesApiClient),
+        typeof(ConfigFlagsApiClient),
+        typeof(TenantsApiClient),
+        typeof(EntityCodeRulesApiClient),
+        typeof(NotificationPolicyApiClient),
+        typeof(AssignmentPolicyApiClient),
+        typeof(SignatureConsentTextApiClient),
+        typeof(AssignmentAiPromptApiClient),
+    ];
+
+    [TestMethod]
+    public void AddMobileAdminClients_RegistersEveryAdminSharedClientTheHeadCanReach()
+    {
+        using var provider = BuildProvider(SettingsApi(SettingsBaseAddress));
+
+        foreach (var clientType in AdminSharedClients)
+        {
+            // Constructing the typed client builds its whole handler pipeline — so this resolution both
+            // proves the registration and that the bearer handler in it is resolvable.
+            provider.GetRequiredService(clientType).Should().NotBeNull();
+        }
+    }
+
+    [TestMethod]
+    public async Task AddMobileAdminClients_SendsThroughTheConfiguredSettingsAddress_WithTheSessionsBearerToken()
+    {
+        var primaryHandler = new RecordingHandler();
+        using var provider = BuildProvider(SettingsApi(SettingsBaseAddress), primaryHandler);
+        await provider.GetRequiredService<ITokenStore>().WriteAsync(TokenKeys.AccessToken, "session-access-token");
+        await provider.GetRequiredService<ITokenStore>().WriteAsync(
+            TokenKeys.ExpiresAt,
+            DateTimeOffset.UtcNow.AddMinutes(5).ToString("O", System.Globalization.CultureInfo.InvariantCulture));
+
+        var values = await provider.GetRequiredService<CodedValuesApiClient>().GetRootValuesAsync();
+
+        values.Should().BeEmpty();
+        primaryHandler.Requests.Should().ContainSingle();
+        var request = primaryHandler.Requests[0];
+        request.RequestUri!.Host.Should().Be("settings.example",
+            "the client's base address comes from the ONE Settings API name this registration resolves.");
+        request.RequestUri!.Port.Should().Be(SettingsApiPort);
+        request.RequestUri!.AbsolutePath.Should().Be("/api/coded-values",
+            "the relative request path is appended to the configured base address.");
+        primaryHandler.AuthorizationHeaders.Should().ContainSingle()
+            .Which.Should().Be("Bearer session-access-token",
+                "the bearer handler is in the registered client's pipeline, so the session's token travels with the call.");
+    }
+
+    [TestMethod]
+    public async Task AddMobileAdminClients_DegradesTheApi_WhenTheSettingsAddressIsUnconfigured()
+    {
+        using var provider = BuildProvider(new MobileApiOptions());
+
+        var call = () => provider.GetRequiredService<CodedValuesApiClient>().GetRootValuesAsync();
+
+        (await call.Should().ThrowAsync<InvalidOperationException>())
+            .WithMessage("*BaseAddress*");
+    }
+
+    [TestMethod]
+    public void AddMobileAdminClients_RegistersTheBearerHandler_Transiently()
+    {
+        using var provider = BuildProvider(SettingsApi(SettingsBaseAddress));
+
+        var first = provider.GetRequiredService<BearerTokenDelegatingHandler>();
+        var second = provider.GetRequiredService<BearerTokenDelegatingHandler>();
+
+        first.Should().NotBeSameAs(second,
+            "a delegating handler is built per outgoing request via IHttpClientFactory, so it must be transient and hold no per-request state.");
+    }
+
+    [TestMethod]
+    public void AddMobileAdminClients_RejectsANullApiOptions()
+    {
+        var services = new ServiceCollection();
+
+        var register = () => services.AddMobileAdminClients(null!);
+
+        register.Should().Throw<ArgumentNullException>();
+    }
+
+    [TestMethod]
+    public void AddMobileAdminClients_RegistersTheTenantServiceTheGatesNeed()
+    {
+        using var provider = BuildProvider(SettingsApi(SettingsBaseAddress));
+
+        provider.GetRequiredService<VisibleTenantService>().Should().NotBeNull();
+    }
+
+    [TestMethod]
+    public void AddMobileAuth_RegistersTheProvider_AsTheSingleInstanceTheGatesInject()
+    {
+        using var provider = BuildProvider(SettingsApi(SettingsBaseAddress));
+
+        var concrete = provider.GetRequiredService<MobileAuthenticationStateProvider>();
+        var abstraction = provider.GetRequiredService<AuthenticationStateProvider>();
+
+        abstraction.Should().BeSameAs(concrete,
+            "the gates subscribe to AuthenticationStateChanged on the injected instance; a second instance would be a second, silent source of auth state.");
+    }
+
+    [TestMethod]
+    public async Task AddMobileAuth_ResolvesTheAuthPath_WithTheNamedTokenClientBoundToTheAuthority()
+    {
+        using var provider = BuildProvider(SettingsApi(SettingsBaseAddress));
+
+        provider.GetRequiredService<OidcLoginService>().Should().NotBeNull();
+        await provider.GetRequiredService<TokenSession>().EnsureInitializedAsync();
+
+        var tokenClient = provider.GetRequiredService<IHttpClientFactory>().CreateClient(TokenSession.HttpClientName);
+        tokenClient.BaseAddress.Should().Be(new Uri($"{AuthAuthority}/"),
+            "the named token client's base address is the configured authority — never a C# literal (spec D8).");
+    }
+
+    [TestMethod]
+    public void AddMobileAuth_RejectsANullAuthOptions()
+    {
+        var services = new ServiceCollection();
+
+        var register = () => services.AddMobileAuth(null!);
+
+        register.Should().Throw<ArgumentNullException>();
+    }
+
+    /// <summary>
+    /// The head's real composition, minus the two platform implementations (they are head-only types):
+    /// the auth path, the client registrations, and the logging/token seams the container needs.
+    /// </summary>
+    private static ServiceProvider BuildProvider(MobileApiOptions apiOptions, RecordingHandler? primaryHandler = null)
+    {
+        var services = new ServiceCollection();
+        services.AddSingleton(typeof(ILogger<>), typeof(NullLogger<>));
+        services.AddSingleton<ITokenStore, FakeTokenStore>();
+        services.AddSingleton<ISystemBrowserAuthenticator, FakeAuthenticator>();
+
+        var authOptions = MobileAuthOptions.FromConfiguration(BuildConfiguration(
+            ("MobileAuth:Authority", AuthAuthority),
+            ("MobileAuth:ClientId", "school-collab-mobile-client"),
+            ("MobileAuth:RedirectScheme", "schoolcollab"),
+            ("MobileAuth:RedirectHost", "signin-oidc")));
+
+        services.AddMobileAuth(authOptions);
+        services.AddMobileAdminClients(apiOptions);
+
+        if (primaryHandler is not null)
+        {
+            // Configure the SAME typed client the registration created (identical name derivation), so the
+            // test sees exactly the request the registered pipeline produces.
+            services.AddHttpClient<CodedValuesApiClient>()
+                .ConfigurePrimaryHttpMessageHandler(() => primaryHandler);
+        }
+
+        return services.BuildServiceProvider();
+    }
+
+    /// <summary>The authority is written from <see cref="UriBuilder"/>, never typed as a literal, so
+    /// this suite cannot be the place the D8 rule rots.</summary>
+    private static string AuthAuthority =>
+        new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab").Uri.ToString();
+
+    private static MobileApiOptions SettingsApi(string baseAddress) =>
+        MobileApiOptions.FromConfiguration(BuildConfiguration(("MobileApi:SettingsApi", baseAddress)));
+
+    private static IConfiguration BuildConfiguration(params (string Key, string Value)[] values) =>
+        new ConfigurationBuilder()
+            .AddInMemoryCollection(values.ToDictionary(v => v.Key, v => (string?)v.Value))
+            .Build();
+
+    /// <summary>The far end of a registered client's pipeline: records what actually went out.</summary>
+    private sealed class RecordingHandler : HttpMessageHandler
+    {
+        public List<HttpRequestMessage> Requests { get; } = [];
+
+        public List<string> AuthorizationHeaders { get; } = [];
+
+        protected override Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            Requests.Add(request);
+            AuthorizationHeaders.Add(request.Headers.TryGetValues("Authorization", out var values)
+                ? string.Join(",", values)
+                : string.Empty);
+
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new StringContent("[]", Encoding.UTF8, "application/json"),
+            });
+        }
+    }
+
+    private sealed class FakeTokenStore : ITokenStore
+    {
+        private readonly Dictionary<string, string?> _values = new(StringComparer.Ordinal);
+
+        public Task<string?> ReadAsync(string key, CancellationToken cancellationToken = default) =>
+            Task.FromResult(_values.TryGetValue(key, out var value) ? value : null);
+
+        public Task WriteAsync(string key, string value, CancellationToken cancellationToken = default)
+        {
+            _values[key] = value;
+            return Task.CompletedTask;
+        }
+
+        public Task ClearAsync(string key, CancellationToken cancellationToken = default)
+        {
+            _values[key] = null;
+            return Task.CompletedTask;
+        }
+    }
+
+    private sealed class FakeAuthenticator : ISystemBrowserAuthenticator
+    {
+        public Task<IDictionary<string, string>> AuthenticateAsync(
+            Uri authorizeUrl,
+            Uri callbackUri,
+            CancellationToken cancellationToken = default) =>
+            Task.FromResult<IDictionary<string, string>>(new Dictionary<string, string>(StringComparer.Ordinal));
+    }
+}
diff --git a/tests/SchoolCollab.Mobile.Tests.Unit/OidcLoginServiceTests.cs b/tests/SchoolCollab.Mobile.Tests.Unit/OidcLoginServiceTests.cs
new file mode 100644
index 00000000..bd0bbeea
--- /dev/null
+++ b/tests/SchoolCollab.Mobile.Tests.Unit/OidcLoginServiceTests.cs
@@ -0,0 +1,489 @@
+using System.Net;
+using System.Net.Http;
+using System.Security.Cryptography;
+using System.Text;
+using FluentAssertions;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using SchoolCollab.Mobile.Logic;
+
+namespace SchoolCollab.Mobile.Tests.Unit;
+
+/// <summary>
+/// Covers <see cref="OidcLoginService"/> — the PKCE acquisition: the authorize request it builds,
+/// the <c>state</c> validation it enforces before anything is persisted, and the code exchange it
+/// runs. The browser is a fake and the token endpoint a scripted handler, so no live Keycloak
+/// participates (spec §8 L3 criterion 2 asserts the decoded claims, not a live IdP).
+/// </summary>
+[TestClass]
+public class OidcLoginServiceTests
+{
+    private static readonly DateTimeOffset Now = new(2026, 10, 13, 12, 0, 0, TimeSpan.Zero);
+
+    private static readonly Uri AuthorizeEndpoint =
+        new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab/protocol/openid-connect/auth").Uri;
+
+    private static readonly Uri TokenEndpoint =
+        new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab/protocol/openid-connect/token").Uri;
+
+    [TestMethod]
+    public async Task SignInAsync_BuildsTheAuthorizeRequest_WithS256PkceAndState()
+    {
+        var fixture = new Fixture();
+
+        await fixture.Service.SignInAsync();
+
+        var authorize = fixture.Authenticator.AuthorizeUrl!;
+        authorize.GetLeftPart(UriPartial.Path).Should().Be(AuthorizeEndpoint.ToString());
+        fixture.Authenticator.CallbackUri.Should().Be(new Uri("schoolcollab://signin-oidc"),
+            "the callback handed to the browser must be exactly what the realm registers and the platform filter/plist declare.");
+        var query = ParseQuery(authorize);
+        query["response_type"].Should().Be("code");
+        query["client_id"].Should().Be("school-collab-mobile-client");
+        query["redirect_uri"].Should().Be("schoolcollab://signin-oidc");
+        query["scope"].Should().Be("openid");
+        query["code_challenge_method"].Should().Be("S256");
+        query["state"].Should().NotBeNullOrWhiteSpace("a random state is the replay defence for the unverified custom scheme.");
+
+        // The challenge must be the SHA-256 of the verifier the code exchange later sends — and the
+        // verifier must come from memory, never from the token store.
+        var verifier = FormValues(fixture.Handler.Bodies[0])["code_verifier"];
+        verifier.Length.Should().BeInRange(43, 128, "RFC 7636 requires 43–128 characters.");
+        query["code_challenge"].Should().Be(ToBase64Url(SHA256.HashData(Encoding.ASCII.GetBytes(verifier))));
+        fixture.Store.Values.Should().OnlyContain(value => value == null || value != verifier,
+            "the verifier is the one secret a hijacked redirect must not be able to reach: it never leaves memory.");
+    }
+
+    [TestMethod]
+    public async Task SignInAsync_ExchangesTheCodeAndAppliesTheSession()
+    {
+        var fixture = new Fixture();
+        var sessionChanges = 0;
+        fixture.Session.SessionChanged += () => sessionChanges++;
+
+        await fixture.Service.SignInAsync();
+
+        fixture.Handler.Requests.Should().HaveCount(1);
+        fixture.Handler.Requests[0].Method.Should().Be(HttpMethod.Post);
+        fixture.Handler.Requests[0].RequestUri.Should().Be(TokenEndpoint);
+
+        var form = FormValues(fixture.Handler.Bodies[0]);
+        form["grant_type"].Should().Be("authorization_code");
+        form["code"].Should().Be("authorization-code");
+        form["client_id"].Should().Be("school-collab-mobile-client");
+        form["redirect_uri"].Should().Be("schoolcollab://signin-oidc");
+
+        fixture.Store.Written[TokenKeys.AccessToken].Should().Be(fixture.ClaimsToken);
+        fixture.Store.Written[TokenKeys.RefreshToken].Should().Be("a-refresh-token");
+        fixture.Service.State.Should().Be(SignInState.SignedIn);
+        sessionChanges.Should().Be(1, "the session signals the UI once, and the provider turns that into NotifyAuthenticationStateChanged.");
+    }
+
+    [TestMethod]
+    public async Task SignInAsync_RejectsAStateMismatch_BeforeAnythingIsPersisted()
+    {
+        var fixture = new Fixture();
+        fixture.Authenticator.State = "a-forged-state";
+
+        Func<Task> signIn = () => fixture.Service.SignInAsync();
+
+        var exception = await signIn.Should().ThrowAsync<SignInFailedException>();
+
+        exception.Which.Should().NotBeNull();
+        fixture.Handler.Requests.Should().BeEmpty("a forged callback must not reach the token endpoint.");
+        fixture.Store.Written.Should().BeEmpty("nothing may be persisted by a failed validation.");
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+    }
+
+    [TestMethod]
+    public async Task SignInAsync_RejectsAResponseWithoutACode()
+    {
+        var fixture = new Fixture();
+        fixture.Authenticator.WithCode = false;
+
+        Func<Task> signIn = () => fixture.Service.SignInAsync();
+
+        await signIn.Should().ThrowAsync<SignInFailedException>();
+
+        fixture.Handler.Requests.Should().BeEmpty();
+        fixture.Store.Written.Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task SignInAsync_SurfacesACancellation_AsTheTypedCancelledException()
+    {
+        var fixture = new Fixture();
+        fixture.Authenticator.Cancels = true;
+
+        Func<Task> signIn = () => fixture.Service.SignInAsync();
+
+        await signIn.Should().ThrowAsync<SignInCancelledException>();
+
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+        fixture.Store.Written.Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task SignInAsync_FailsTheSignIn_WhenTheTokenEndpointRejectsTheCodeExchange()
+    {
+        var fixture = new Fixture();
+        fixture.Handler.Status = HttpStatusCode.BadRequest;
+        fixture.Handler.Body = """{"error":"invalid_grant","error_description":"Code not valid"}""";
+
+        Func<Task> signIn = () => fixture.Service.SignInAsync();
+
+        var exception = await signIn.Should().ThrowAsync<SignInFailedException>();
+
+        exception.Which.Message.Should()
+            .Contain("invalid_grant", "the message names the endpoint's error code so the failure is actionable.")
+            .And.NotContain("authorization-code", "the authorization code is credential material and must never reach a message.");
+        fixture.Store.Written.Should().BeEmpty();
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+    }
+
+    /// <summary>
+    /// R11: a code exchange that dies in transport — the token endpoint unreachable — must leave the
+    /// flow as the typed sign-in failure the page already shows in its message bar. A transport
+    /// exception escaping here would reach <c>Spike.razor</c>'s <c>&lt;ErrorBoundary&gt;</c> and
+    /// replace the WHOLE page, sign-in button included. Same normalisation the refresh path applies
+    /// (<see cref="BearerTokenDelegatingHandler"/>).
+    /// </summary>
+    [TestMethod]
+    [DataRow(SignInTransportFailure.RequestFailed)]
+    [DataRow(SignInTransportFailure.TimedOut)]
+    [DataRow(SignInTransportFailure.ReadFailed)]
+    public async Task SignInAsync_SurfacesATransportFailureOfTheCodeExchange_AsTheTypedSignInFailure(
+        SignInTransportFailure failure)
+    {
+        var fixture = new Fixture(tokenEndpointFailure: TransportException(failure));
+
+        Func<Task> signIn = () => fixture.Service.SignInAsync();
+
+        await signIn.Should().ThrowAsync<SignInFailedException>(
+            "the transport failure belongs in the sign-in message bar, never in the page's ErrorBoundary.");
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+        fixture.Store.Written.Should().BeEmpty("the exchange produced no credential, so nothing may be persisted.");
+    }
+
+    /// <summary>
+    /// R11's own-deadline leg, which the three thrown shapes above cannot reach: the token endpoint
+    /// does not refuse, it HANGS, and the token client's own <see cref="HttpClient.Timeout"/> ends the
+    /// attempt. Measured on this stack that surfaces as a <see cref="TaskCanceledException"/> — never
+    /// a bare <see cref="TimeoutException"/> — so the guarded clause is the only thing standing
+    /// between a dead network and the page's ErrorBoundary.
+    /// </summary>
+    [TestMethod]
+    public async Task SignInAsync_SurfacesAClientTimeoutOfTheCodeExchange_AsTheTypedSignInFailure()
+    {
+        var fixture = new Fixture(hangs: true, tokenEndpointTimeout: TimeSpan.FromMilliseconds(50));
+
+        Func<Task> signIn = () => fixture.Service.SignInAsync();
+
+        await signIn.Should().ThrowAsync<SignInFailedException>(
+            "the token client's own deadline is a sign-in outcome, not a transport failure for the page.");
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+        fixture.Store.Written.Should().BeEmpty();
+    }
+
+    /// <summary>
+    /// The guard's other half, without which the timeout clause above would swallow every
+    /// cancellation: a <see cref="TaskCanceledException"/> raised by the CALLER's token is not a
+    /// sign-in outcome and must keep propagating. The token endpoint hangs long enough to cancel an
+    /// exchange that is genuinely in flight.
+    /// </summary>
+    [TestMethod]
+    public async Task SignInAsync_Rethrows_WhenTheCallerCancelsTheCodeExchange()
+    {
+        var fixture = new Fixture(hangs: true);
+        using var cancellation = new CancellationTokenSource();
+
+        var signIn = fixture.Service.SignInAsync(cancellation.Token);
+        await fixture.Handler.Entered;
+        await cancellation.CancelAsync();
+
+        var act = async () =>
+        {
+            await signIn;
+        };
+
+        await act.Should().ThrowAsync<OperationCanceledException>(
+            "the caller's cancellation is the caller's verdict — the guard must let it through.");
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+        fixture.Store.Written.Should().BeEmpty();
+    }
+
+    [TestMethod]
+    public async Task SignOutAsync_ClearsTheSession()
+    {
+        var fixture = new Fixture();
+        await fixture.Service.SignInAsync();
+
+        await fixture.Service.SignOutAsync();
+
+        fixture.Store.Values.Should().OnlyContain(value => value == null);
+        fixture.Service.State.Should().Be(SignInState.SignedOut);
+    }
+
+    /// <summary>One scripted sign-in: the fake browser, the scripted token endpoint, the in-memory
+    /// store and the flow under test.</summary>
+    private sealed class Fixture
+    {
+        /// <param name="tokenEndpointFailure">When set, the code exchange dies in transport instead of
+        /// being answered — the unreachable token endpoint.</param>
+        /// <param name="hangs">The token endpoint never answers — the exchange runs until the token
+        /// client's own timeout, or the caller's cancellation, ends it.</param>
+        /// <param name="tokenEndpointTimeout">The token client's own <see cref="HttpClient.Timeout"/>,
+        /// left at its default when absent.</param>
+        public Fixture(
+            Exception? tokenEndpointFailure = null,
+            bool hangs = false,
+            TimeSpan? tokenEndpointTimeout = null)
+        {
+            Store = new FakeTokenStore();
+            Handler = new ScriptedHandler(HttpStatusCode.OK, BuildTokenBody(ClaimsToken))
+            {
+                Failure = tokenEndpointFailure,
+                Hangs = hangs,
+            };
+            Session = new TokenSession(Store, new StubHttpClientFactory(Handler), AuthOptions(), new MutableTimeProvider(Now));
+            Authenticator = new FakeAuthenticator();
+            Service = new OidcLoginService(
+                AuthOptions(),
+                Authenticator,
+                Session,
+                new StubHttpClientFactory(Handler) { Timeout = tokenEndpointTimeout });
+        }
+
+        /// <summary>A fixture access token whose payload carries the realm's raw claim spellings.</summary>
+        public string ClaimsToken { get; } = Jwt(
+            """
+            {
+              "tenant_id": "00000000-0000-0000-0000-000000000002",
+              "tenant_name": "Dev School",
+              "teacher_id": "00000000-0000-0000-0000-000000000003",
+              "roles": ["teacher"]
+            }
+            """);
+
+        public FakeTokenStore Store { get; }
+
+        public ScriptedHandler Handler { get; }
+
+        public TokenSession Session { get; }
+
+        public FakeAuthenticator Authenticator { get; }
+
+        public OidcLoginService Service { get; }
+
+        private string BuildTokenBody(string accessToken) =>
+            $$"""{"access_token":"{{accessToken}}","refresh_token":"a-refresh-token","expires_in":300,"token_type":"Bearer"}""";
+    }
+
+    private static MobileAuthOptions AuthOptions() => new()
+    {
+        Authority = new UriBuilder(Uri.UriSchemeHttps, "idp.example", 8080, "realms/school-collab").Uri.ToString(),
+        ClientId = "school-collab-mobile-client",
+        RedirectScheme = "schoolcollab",
+        RedirectHost = "signin-oidc",
+    };
+
+    /// <summary>The system browser: hands back the authorization response the test asks for, echoing
+    /// the <c>state</c> it was sent unless the test forges one.</summary>
+    private sealed class FakeAuthenticator : ISystemBrowserAuthenticator
+    {
+        /// <summary>When set, the response carries this state instead of the requested one.</summary>
+        public string? State { get; set; }
+
+        public bool WithCode { get; set; } = true;
+
+        public bool Cancels { get; set; }
+
+        public Uri? AuthorizeUrl { get; private set; }
+
+        public Uri? CallbackUri { get; private set; }
+
+        public Task<IDictionary<string, string>> AuthenticateAsync(
+            Uri authorizeUrl,
+            Uri callbackUri,
+            CancellationToken cancellationToken = default)
+        {
+            if (Cancels)
+            {
+                throw new SignInCancelledException("The sign-in was cancelled before the browser returned a callback.");
+            }
+
+            AuthorizeUrl = authorizeUrl;
+            CallbackUri = callbackUri;
+
+            var response = new Dictionary<string, string>(StringComparer.Ordinal)
+            {
+                ["state"] = State ?? ParseQuery(authorizeUrl)["state"],
+            };
+
+            if (WithCode)
+            {
+                response["code"] = "authorization-code";
+            }
+
+            return Task.FromResult<IDictionary<string, string>>(response);
+        }
+    }
+
+    private sealed class FakeTokenStore : ITokenStore
+    {
+        private static readonly string[] Keys = [TokenKeys.AccessToken, TokenKeys.RefreshToken, TokenKeys.ExpiresAt];
+
+        private readonly Dictionary<string, string?> _values = new(StringComparer.Ordinal);
+
+        public Dictionary<string, string?> Written { get; } = new(StringComparer.Ordinal);
+
+        public IEnumerable<string?> Values => Keys.Select(key => _values.TryGetValue(key, out var value) ? value : null);
+
+        public Task<string?> ReadAsync(string key, CancellationToken cancellationToken = default) =>
+            Task.FromResult(_values.TryGetValue(key, out var value) ? value : null);
+
+        public Task WriteAsync(string key, string value, CancellationToken cancellationToken = default)
+        {
+            _values[key] = value;
+            Written[key] = value;
+            return Task.CompletedTask;
+        }
+
+        public Task ClearAsync(string key, CancellationToken cancellationToken = default)
+        {
+            _values[key] = null;
+            return Task.CompletedTask;
+        }
+    }
+
+    private sealed class StubHttpClientFactory(HttpMessageHandler handler) : IHttpClientFactory
+    {
+        /// <summary>
+        /// When set, the token client's own <see cref="HttpClient.Timeout"/> — the real clock that
+        /// turns a hung token endpoint into a client-timed-out exchange. Absent, the client keeps its
+        /// default deadline, which no test here waits out.
+        /// </summary>
+        public TimeSpan? Timeout { get; set; }
+
+        public HttpClient CreateClient(string name)
+        {
+            var client = new HttpClient(handler, disposeHandler: false);
+
+            if (Timeout is not null)
+            {
+                client.Timeout = Timeout.Value;
+            }
+
+            return client;
+        }
+    }
+
+    /// <summary>
+    /// The token endpoint: records the code exchange POST and answers with a canned response, or —
+    /// when <see cref="Failure"/> is set — dies in transport without answering, or — when
+    /// <see cref="Hangs"/> is set — never answers at all.
+    /// </summary>
+    private sealed class ScriptedHandler(HttpStatusCode status, string body) : HttpMessageHandler
+    {
+        private readonly TaskCompletionSource _entered = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        public HttpStatusCode Status { get; set; } = status;
+
+        public string Body { get; set; } = body;
+
+        /// <summary>When set, the exchange dies in transport instead of being answered.</summary>
+        public Exception? Failure { get; set; }
+
+        /// <summary>When set, the exchange never answers — the token endpoint that hangs until the
+        /// client's own deadline, or the caller's cancellation, ends it.</summary>
+        public bool Hangs { get; set; }
+
+        /// <summary>Completes once a request has reached this far end, so a test can act on an
+        /// exchange that is still in flight instead of racing it.</summary>
+        public Task Entered => _entered.Task;
+
+        public List<HttpRequestMessage> Requests { get; } = [];
+
+        public List<string> Bodies { get; } = [];
+
+        protected override async Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            Requests.Add(request);
+            Bodies.Add(request.Content is null
+                ? string.Empty
+                : await request.Content.ReadAsStringAsync(cancellationToken));
+            _entered.TrySetResult();
+
+            if (Failure is not null)
+            {
+                throw Failure;
+            }
+
+            if (Hangs)
+            {
+                await Task.Delay(System.Threading.Timeout.InfiniteTimeSpan, cancellationToken);
+            }
+
+            return new HttpResponseMessage(Status)
+            {
+                Content = new StringContent(Body, Encoding.UTF8, "application/json"),
+            };
+        }
+    }
+
+    /// <summary>
+    /// The three transport shapes an unreachable token endpoint surfaces as — the same three the
+    /// refresh path degrades on (<see cref="BearerTokenDelegatingHandler"/>).
+    /// Public only because an MSTest method is public and a parameter type may not be less
+    /// accessible than the method that takes it — no other type outside this class uses it.
+    /// </summary>
+    public enum SignInTransportFailure
+    {
+        RequestFailed,
+        TimedOut,
+        ReadFailed,
+    }
+
+    private static Exception TransportException(SignInTransportFailure failure) => failure switch
+    {
+        SignInTransportFailure.RequestFailed =>
+            new HttpRequestException("The token endpoint was unreachable."),
+        SignInTransportFailure.TimedOut =>
+            new TimeoutException("The token endpoint did not answer in time."),
+        _ => new IOException("The token endpoint's response could not be read."),
+    };
+
+    private sealed class MutableTimeProvider(DateTimeOffset now) : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => now;
+    }
+
+    private static Dictionary<string, string> ParseQuery(Uri uri) => uri.Query
+        .TrimStart('?')
+        .Split('&', StringSplitOptions.RemoveEmptyEntries)
+        .Select(pair => pair.Split('=', 2))
+        .ToDictionary(
+            parts => Uri.UnescapeDataString(parts[0]),
+            parts => parts.Length == 2 ? Uri.UnescapeDataString(parts[1]) : string.Empty,
+            StringComparer.Ordinal);
+
+    private static Dictionary<string, string> FormValues(string body) => body
+        .Split('&', StringSplitOptions.RemoveEmptyEntries)
+        .Select(pair => pair.Split('=', 2))
+        .ToDictionary(
+            parts => Uri.UnescapeDataString(parts[0]),
+            parts => parts.Length == 2 ? Uri.UnescapeDataString(parts[1]) : string.Empty,
+            StringComparer.Ordinal);
+
+    private static string Jwt(string payloadJson) =>
+        $"{ToBase64Url("{\"alg\":\"RS256\",\"typ\":\"JWT\"}")}.{ToBase64Url(payloadJson)}.signature-not-verified";
+
+    private static string ToBase64Url(ReadOnlySpan<byte> bytes) => Convert
+        .ToBase64String(bytes)
+        .TrimEnd('=')
+        .Replace('+', '-')
+        .Replace('/', '_');
+
+    private static string ToBase64Url(string value) => ToBase64Url(Encoding.UTF8.GetBytes(value));
+}
