+            if (_disposed) return;
+            _exceptions = exceptions ?? [];
+            _topics = [.. (topics ?? []).OrderBy(t => t.Name)];
+        }
+        catch (OperationCanceledException) { return; }
+        catch (Exception ex)
+        {
+            if (_disposed) return;
+            Logger.LogError(ex, "Failed to load enrollment exceptions for {GradeLevelId}/{ActivityGroupId}",
+                OwnerGradeLevelId, OwnerActivityGroupId);
+            _loadError = ex.Message;
+            _exceptions = [];
+            ApplyPendingTopicSelection();
+            return;
+        }
+
+        ApplyPendingTopicSelection();
+        await LoadPeriodsAsync(token);
+    }
+
+    /// <summary>
+    /// Loads the tenant's periods — best effort and self-contained: they widen the part
+    /// picker (OOD-1) and decide which periods a term/semester picker can offer. A
+    /// failure leaves free dates only, and the server validator remains the gate.
+    /// </summary>
+    private async Task LoadPeriodsAsync(CancellationToken token)
+    {
+        try
+        {
+            _periods = await Api.ListPeriodsAsync(token) ?? [];
+            if (_disposed) return;
+        }
+        catch (OperationCanceledException) { return; }
+        catch (Exception ex)
+        {
+            if (_disposed) return;
+            Logger.LogWarning(ex, "Could not load the tenant's periods; the part picker offers free dates only");
+            _periods = [];
+        }
+
+        _divisionOptions = BuildDivisionOptions();
+        KeepDivisionOffered();
+    }
+
+    /// <summary>
+    /// The period parts the picker may offer this owner — §5.1's "filtered by the
+    /// owner's rule (§4.2)":
+    ///
+    /// <para>A group-owned exception must match the group's
+    /// <see cref="EnrollmentSpan"/> (FR-56: <c>Termly</c>→Terms,
+    /// <c>Semester</c>→Semesters, everything else→None), so exactly ONE part is on
+    /// offer and "not term-scoped" appears only when <c>None</c> is that part. A
+    /// grade-owned exception is unconstrained (FR-57), so the parts on offer are the
+    /// ones the tenant actually has (OOD-1) plus an explicit, honestly-labelled "not
+    /// term-scoped". A group whose definition is not loaded is treated as a grade —
+    /// the server validator stays the gate.</para>
+    /// </summary>
+    private DivisionOption[] BuildDivisionOptions()
+    {
+        if (SelectedGroup is { } group)
+        {
+            var required = RequiredDivision(group.Span);
+            return [new(required, PartLabel(required))];
+        }
+
+        var options = new List<DivisionOption>(3);
+        if (_periods.Any(p => IsDivision(p, AcademicYearDivision.Terms)))
+        {
+            options.Add(new(AcademicYearDivision.Terms, "Term"));
+        }
+        if (_periods.Any(p => IsDivision(p, AcademicYearDivision.Semesters)))
+        {
+            options.Add(new(AcademicYearDivision.Semesters, "Semester"));
+        }
+        options.Add(new(AcademicYearDivision.None, "Not term-scoped"));
+        return [.. options];
+    }
+
+    /// <summary>
+    /// The FR-56 division a group's <see cref="EnrollmentSpan"/> requires — the same
+    /// mapping as <c>TopicAssignmentPeriodValidator.ValidateGroupExceptionDivisionAsync</c>.
+    /// </summary>
+    private static AcademicYearDivision RequiredDivision(string span) => span switch
+    {
+        nameof(EnrollmentSpan.Termly) => AcademicYearDivision.Terms,
+        nameof(EnrollmentSpan.Semester) => AcademicYearDivision.Semesters,
+        _ => AcademicYearDivision.None
+    };
+
+    /// <summary>
+    /// Keeps the picked part inside what this owner's rule permits: a part that is no
+    /// longer on offer (the owner changed, or the tenant has no periods of it) falls
+    /// back to the honest one — "not term-scoped" when it is permitted, otherwise the
+    /// only part the owner's rule allows.
+    /// </summary>
+    private void KeepDivisionOffered()
+    {
+        if (_divisionOptions.Any(o => o.Value == _division))
+        {
+            return;
+        }
+
+        _division = _divisionOptions.FirstOrDefault(o => o.Value == AcademicYearDivision.None, _divisionOptions[0]).Value;
+        _spanPeriodId = null;
+    }
+
+    private static bool IsDivision(PeriodDto period, AcademicYearDivision division) =>
+        string.Equals(period.Division, division.ToString(), StringComparison.OrdinalIgnoreCase);
+
+    private async Task OnOwnerTypeChangedAsync()
+    {
+        if (_disposed) return;
+        ClearAddSelection();
+        await LoadOwnerDataAsync(_loadCts?.Token ?? CancellationToken.None);
+    }
+
+    private async Task OnOwnerChangedAsync()
+    {
+        if (_disposed) return;
+        ClearAddSelection();
+        await LoadOwnerDataAsync(_loadCts?.Token ?? CancellationToken.None);
+    }
+
+    /// <summary>The picked subject changed: only the pickers' pre-write check follows.</summary>
+    private async Task OnAddInputChangedAsync() => await RefreshExceptedHintAsync();
+
+    /// <summary>The picked part changed: the term/semester picker's options follow it,
+    /// so a period from the previous part must not linger.</summary>
+    private async Task OnDivisionChangedAsync()
+    {
+        _spanPeriodId = null;
+        await RefreshExceptedHintAsync();
+    }
+
+    /// <summary>
+    /// The term/semester picker resolved to a period: fill the two date fields from
+    /// THAT period's dates. The period is a convenience for the dates — the dates are
+    /// what travel to the server, and each stays independently clearable afterwards.
+    /// </summary>
+    private async Task OnSpanPeriodPickedAsync()
+    {
+        if (_spanPeriodId is { } periodId
+            && SpanPeriods.FirstOrDefault(p => p.Id == periodId) is { } period)
+        {
+            _startDate = period.StartDate.ToDateTime(TimeOnly.MinValue);
+            _endDate = period.EndDate.ToDateTime(TimeOnly.MinValue);
+        }
+        await RefreshExceptedHintAsync();
+    }
+
+    private async Task OnSpanChangedAsync() => await RefreshExceptedHintAsync();
+
+    private async Task ClearStartAsync()
+    {
+        _startDate = null;
+        await RefreshExceptedHintAsync();
+    }
+
+    private async Task ClearEndAsync()
+    {
+        _endDate = null;
+        await RefreshExceptedHintAsync();
+    }
+
+    /// <summary>
+    /// Asks the server (<c>GET /students/enrollment-exceptions/check</c>) whether the
+    /// picked subject is already excepted on the span's anchor date, and shows the
+    /// answer as a hint. Best effort by design: a check that cannot run leaves the hint
+    /// absent and never blocks the write — the server is the gate (a duplicate is still
+    /// a 409, and its message is surfaced).
+    /// </summary>
