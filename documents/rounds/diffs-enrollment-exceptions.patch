+            // The span was consumed by this write; clearing it keeps the next add honest.
+            _startDate = null;
+            _endDate = null;
+            _spanPeriodId = null;
+            _reason = null;
+            _alreadyExcepted = null;
+            await LoadExceptionsAsync(_loadCts?.Token ?? CancellationToken.None);
+        }
+        catch (OperationCanceledException) { }
+        catch (Exception ex)
+        {
+            if (_disposed) return;
+            Logger.LogError(ex, "Failed to create an enrollment exception for topic {TopicId}", topicId);
+            _addError = ex.Message;
+        }
+        finally
+        {
+            _busy = false;
+        }
+    }
+
+    private async Task RemoveAsync(EnrollmentExceptionDto exception)
+    {
+        if (_busy) return;
+        _busy = true;
+        _addError = null;
+
+        try
+        {
+            await Api.RemoveSubjectEnrollmentExceptionAsync(exception.Id);
