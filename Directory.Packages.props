<Project>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Python" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.4" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="8.0.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.12.0" />
  </ItemGroup>
  <ItemGroup Label="Entity Framework Core">
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.5.4" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>
  <ItemGroup Label="Notifications">
    <!-- WS-E2 (ar-16-channel-delivery): SMTP transport for the MailKit email sender.
         Consumed by SchoolCollab.Assignments.Core (no Version on the PackageReference — CPM). -->
    <PackageVersion Include="MailKit" Version="4.18.0" />
  </ItemGroup>
  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.9" />
    <!-- WS-E1 (ar-14-deep-links): concrete DataProtection provider used by the
         DeepLinkProtectorTests / DeepLinkWiringTests unit projects to mint real
         keyrings under the shared application name. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.9" />
    <!-- L2 (round mobile-severance): Admin.Shared's FrameworkReference to
         Microsoft.AspNetCore.App is replaced by these Blazor component packages, so the
         design-system RCL (and the mobile head that references it) build for a device TFM.
         Versions resolved from the mobile head's restored obj/project.assets.json —
         WebView.Maui 10.0.110 unifies the Components family at 10.0.8. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <!-- L1 (round mobile-host-skeleton): the mobile head loads its embedded appsettings.json
         through AddJsonStream — MAUI brings Microsoft.Extensions.Configuration itself but not
         the JSON provider, so the provider is referenced explicitly. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <!-- L3 (round mobile-credential): the auth-path tests in SchoolCollab.Mobile.Tests.Unit build
         real containers (ServiceCollection/BuildServiceProvider). The version is aligned to the
         Microsoft.Extensions.* family and to the graph that actually SHIPS — the mobile head's own
         restored graph (src/Mobile/SchoolCollab.Mobile/obj/project.assets.json) resolves
         Microsoft.Extensions.DependencyInjection 10.0.11 on every device TFM, as do 25 of the
         repo's 29 restored projects (only the Blazor 10.0.8 closure sits lower), and the sibling
         ...Abstractions entry below is 10.0.11 here too. A 10.0.8 pin would be a downgrade against
         the head the moment a head-side project referenced this package directly. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <!-- L1 (round mobile-host-skeleton): the MAUI template's `builder.Logging.AddDebug()`
         provider; MAUI brings Logging but not the Debug provider. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <!-- L3 (round mobile-credential): `AddHttpClient` for the mobile head's client-side
         registration path. The version is the one the restored graph ALREADY resolves —
         Microsoft.FluentUI.AspNetCore.Components 4.14.2 declares
         `Microsoft.Extensions.Http >= 10.0.8` (verified in
         src/SchoolCollab.Admin.Shared/obj/project.assets.json), so declaring 10.0.8 adds a
         first-class dependency without moving a single resolved version. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
  </ItemGroup>
  <ItemGroup Label="Fluent UI">
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.2" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.2" />
  </ItemGroup>
  <ItemGroup Label="MAUI">
    <!-- L1 (round mobile-host-skeleton): the Blazor Hybrid head. These two are the head's
         first-party MAUI packages; the .csproj carries NO Version attribute (CPM). The MAUI
         workload (android/ios/maccatalyst/maui-windows) supplies the build tasks and the
         platform assemblies. Pinned together — the WebView package ships in lockstep with
         Controls. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>
  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>
  <ItemGroup Label="Serilog">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageVersion Include="Microsoft.Playwright.MSTest" Version="1.60.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MSTest" Version="4.2.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.3.3" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="6.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
  </ItemGroup>
  <ItemGroup Label="AI">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />
  </ItemGroup>
  <ItemGroup Label="Other">
    <PackageVersion Include="Humanizer" Version="2.14.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- C3 certificate PDF rendering. PINNED at 2026.8.0: 2026.9.0 (2026-09-14)
         shipped font-system breaking changes. Community license tier. -->
    <PackageVersion Include="QuestPDF" Version="2026.8.0" />
    <!-- R3 (assignment-authoring-compartments §14) attachment text extraction.
         The NuGet id for UglyToad's PdfPig reader is **"PdfPig"**, NOT
         "UglyToad.PdfPig" — that id is an unrelated two-version placeholder with
         no licence element and no project url, so it must never replace this one.
         Authors="UglyToad", licenseExpression="Apache-2.0". -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- R3 DOCX extraction. MIT; the OpenXmlReader SAX API is what keeps the read
         streaming (see AttachmentTextExtractor). -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup Label="Rich text (round wysiwyg-instruction-editor)">
    <!-- §8.4 Q12 (owner, 2026-10-09; re-confirmed 2026-10-11): Blazored.TextEditor over Quill 2.x,
         both pinned locally, no CDN. The wrapper's own setup is CDN-first, so the Quill assets are
         vendored under the Assignments Application RCL's wwwroot/lib/quill/ and the tags in each
         host's App.razor point at them (see documents/rounds/round-wysiwyg-instruction-editor.md).
         1.1.3 targets net9.0; it depends on Microsoft.AspNetCore.Components(.Web) 3.1.0, which the
         framework's 10.x satisfies — no downgrade. -->
    <PackageVersion Include="Blazored.TextEditor" Version="1.1.3" />
    <!-- §8.4 Q11/Q15: the ONE allow-list sanitiser, applied on write and again on render. 9.2.1039 is
         the latest stable (the 10.x line is beta at the time of writing). -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>
  <ItemGroup Label="Transitive Security Overrides">
    <!-- AngleSharp reaches us two ways: transitively by bunit, and (>= 1.7.2) by HtmlSanitizer 9.2.1039
         in the rich-text round. The 1.4.0 version bunit would otherwise allow has a moderate severity
         vulnerability (GHSA-pgww-w46g-26qg), so we pin the patched line explicitly in test projects.
         PINNED AT 1.8.4 (latest stable): bumping is what satisfies HtmlSanitizer's floor; 1.5.2 was the
         previous pin and is now a DOWNGRADE (NU1605). -->
    <PackageVersion Include="AngleSharp" Version="1.8.4" />
  </ItemGroup>
</Project>