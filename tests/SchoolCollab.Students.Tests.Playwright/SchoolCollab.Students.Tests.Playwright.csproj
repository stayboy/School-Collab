<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Students Admin Playwright tests. Drives the guardian admin UI (Guardians
      landing page, GuardianSetupWizard, student Guardians + Contacts tabs) in a
      real browser against the running AppHost. The Students Admin UI is served
      by the unified SchoolCollab.Admin host, so these tests point at the same
      origin as the Settings Playwright tests. See student-guardian-plan.md
      Phase 4 (Tests).
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Playwright.MSTest" />
  </ItemGroup>
  <Target Name="InstallPlaywrightBrowsers" AfterTargets="Build">
    <Exec Command="pwsh bin/$(Configuration)/net10.0/playwright.ps1 install --with-deps" ContinueOnError="true" />
  </Target>
</Project>