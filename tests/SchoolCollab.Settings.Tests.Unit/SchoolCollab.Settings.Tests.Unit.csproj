<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Unified Settings unit tests. Replaces the legacy
      SchoolCollab.CodedValues.Tests.Unit + SchoolCollab.Config.Tests.Unit
      projects (the two contexts are now a single bounded context — see
      documents/solution/settings-context-merge-spec.md §3, §14).
    -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Settings\SchoolCollab.Settings.Core\SchoolCollab.Settings.Core.csproj" />
    <ProjectReference Include="..\..\src\Settings\SchoolCollab.Settings.Api\SchoolCollab.Settings.Api.csproj" />
    <ProjectReference Include="..\..\src\Settings\SchoolCollab.Settings.Application\SchoolCollab.Settings.Application.csproj" />
    <ProjectReference Include="..\..\src\SchoolCollab.Admin.Shared\SchoolCollab.Admin.Shared.csproj" />
    <ProjectReference Include="..\..\src\SchoolCollab.Admin\SchoolCollab.Admin.csproj" />
    <ProjectReference Include="..\..\src\AI\SchoolCollab.AI.Server\SchoolCollab.AI.Server.csproj" />
    <ProjectReference Include="..\..\src\SchoolCollab.MigrationService\SchoolCollab.MigrationService.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>
</Project>
