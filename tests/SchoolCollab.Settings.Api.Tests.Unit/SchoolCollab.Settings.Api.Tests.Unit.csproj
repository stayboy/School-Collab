<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Replaces the legacy SchoolCollab.CodedValues.Api.Tests.Unit. Verifies
      that the unified Settings API assembly loads and exposes the
      <c>Program</c> type for WebApplicationFactory use. See spec §14.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <!-- Round B1: the TestHost harness the assignment-policy route tests need (400 on a
         non-positive cap, 200 on a valid field set). The project's documented purpose above is
         exactly "exposes the Program type for WebApplicationFactory use"; the reference was
         simply never added. Version comes from Directory.Packages.props (CPM). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Settings\SchoolCollab.Settings.Api\SchoolCollab.Settings.Api.csproj" />
    <ProjectReference Include="..\..\src\SchoolCollab.Core\SchoolCollab.Core.csproj" />
  </ItemGroup>
</Project>
