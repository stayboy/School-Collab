<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunSettingsFilePath>.runsettings</RunSettingsFilePath>
    <!--
      Unified Settings Playwright tests. Replaces the legacy
      SchoolCollab.CodedValues.Tests.Playwright +
      SchoolCollab.Config.Tests.Playwright projects. Drives the unified
      Settings admin pages (/coded-values, /config-flags) in a real browser
      against the running AppHost. See spec §14.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Playwright.MSTest" />
  </ItemGroup>
  <Target Name="InstallPlaywrightBrowsers" AfterTargets="Build">
    <Exec Command="pwsh bin/$(Configuration)/net10.0/playwright.ps1 install --with-deps" ContinueOnError="true" />
  </Target>
</Project>
