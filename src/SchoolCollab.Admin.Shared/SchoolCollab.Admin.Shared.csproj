<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Portable design-system RCL: no Microsoft.AspNetCore.App framework reference.
         The Blazor component family + the two Extensions abstractions it uses are
         declared as packages so this project (and the mobile head that references it)
         can build for a device TFM. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <!-- §8 WYSIWYG round (owner 2026-10-11): the rich instruction editor lives HERE so no host
         replicates its assets or its wiring. Blazored.TextEditor is the wrapper (MIT) over the Quill
         2.0.3 assets vendored in wwwroot/lib/quill; HtmlSanitizer is the ONE allow-list sanitiser
         (write + render). Versions live in Directory.Packages.props (CPM) — never here. -->
    <PackageReference Include="Blazored.TextEditor" />
    <PackageReference Include="HtmlSanitizer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolCollab.Core.Abstractions\SchoolCollab.Core.Abstractions.csproj" />
  </ItemGroup>

</Project>
