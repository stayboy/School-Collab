@using Microsoft.AspNetCore.Components

<div class="home-dashboard">
    <h1>@Title</h1>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <p class="home-subtitle">@Subtitle</p>
    }
    <div class="home-cards">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The dashboard heading.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional subtitle rendered beneath the heading.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>
    /// The dashboard cards. Typically one or more <c>&lt;DashboardCard /&gt;</c>
    /// instances, but any markup is accepted so a page can interleave comments
    /// or bespoke entries.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }
}