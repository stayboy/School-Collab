@typeparam TItem
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager Nav

<PageTitle>@Title</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <SectionContent SectionName="page-toolbar">
            <div class="title-row">
                <h1 class="page-title">@Title</h1>
            </div>
            <div class="action-bar">
                @if (CreateEnabled)
                {
                    <FluentAnchor Appearance="Appearance.Accent" Href="#" OnClick="HandleCreateClicked">@CreateLabel</FluentAnchor>
                }
                @ToolbarFilters
                <div class="spacer"></div>
                @if (SearchEnabled)
                {
                    <FluentTextField Placeholder="@(SearchPlaceholder ?? "Search…")"
                                     class="search-box"
                                     Immediate="true"
                                     ImmediateDelay="300"
                                     Value="@SearchText"
                                     ValueChanged="@OnSearchChanged" />
                }
                @ToolbarActions
            </div>
        </SectionContent>

        @if (Loading || Items is null)
        {
            <div class="spinner-container">
                <FluentProgressRing />
            </div>
        }
        else if (Items.Length == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">@EmptyMessage</FluentMessageBar>
        }
        else
        {
            <div class="grid-container">
                <EntityGrid TItem="TItem"
                            Items="Items"
                            GridSettings="GridSettings"
                            Columns="EffectiveColumns"
                            Loading="@Loading"
                            EmptyMessage="@EmptyMessage"
                            Error="@Error" />
            </div>
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@Error</FluentMessageBar>
        }

        @ChildContent
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@if (Footer is not null)
{
    <SectionContent SectionName="page-footer">@Footer</SectionContent>
}

@code {
    /// <summary>
    /// The grid row DTO. Forwarded to <c>&lt;FluentDataGrid TGridItem&gt;</c> and
    /// available to the <c>Columns</c> render fragment as <c>context</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Text of the <c>+ New …</c> button (e.g. "+ New Assignment").</summary>
    [Parameter, EditorRequired]
    public string CreateLabel { get; set; } = string.Empty;

    /// <summary>
    /// Route the New button navigates to (e.g. "/assignments/create").
    /// </summary>
    [Parameter, EditorRequired]
    public string CreateRoute { get; set; } = string.Empty;

    /// <summary>
    /// The list to render. <c>null</c> shows the loading spinner; an empty
    /// array shows <see cref="EmptyMessage"/>; otherwise the wrapper's
    /// <c>&lt;FluentDataGrid&gt;</c> renders (wrapped in <c>grid-container</c>).
    /// </summary>
    [Parameter]
    public TItem[]? Items { get; set; }

    /// <summary>
    /// Message bar text shown when <see cref="Items"/> is an empty array.
    /// </summary>
    [Parameter, EditorRequired]
    public string EmptyMessage { get; set; } = string.Empty;

    /// <summary>
    /// Grid configuration applied to the wrapper's
    /// <c>&lt;FluentDataGrid&gt;</c> — at minimum
    /// <see cref="LandingGridSettings.GridTemplateColumns"/>.
    /// </summary>
    [Parameter, EditorRequired]
    public LandingGridSettings GridSettings { get; set; } = new();

    /// <summary>
    /// The grid's column definitions, forwarded as the child content of the
    /// wrapper's <c>&lt;FluentDataGrid TGridItem="TItem"&gt;</c>. Because the
    /// columns are compiled in the consuming page's scope (not the grid's),
    /// Blazor cannot infer each column's <c>TGridItem</c> — so every
    /// <c>TemplateColumn</c>/<c>PropertyColumn</c> MUST declare
    /// <c>TGridItem="&lt;the DTO&gt;"</c> explicitly. <c>context</c> inside a
    /// <c>TemplateColumn</c> is the current <typeparamref name="TItem"/> row.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment? Columns { get; set; }

    /// <summary>
    /// Optional per-row action builder. When supplied, the grid gains a trailing
    /// "Actions" column rendered as the shared <c>&lt;RowActionsMenu&gt;</c> kebab
    /// dropdown (the repo-standard pattern used by the student / grade / subject /
    /// activity-group landing pages). The page supplies a
    /// <c>Func&lt;TItem, IReadOnlyList&lt;RowAction&gt;&gt;</c> (e.g. <c>BuildXActions</c>)
    /// and does NOT declare its own Actions column — LandingPage appends it so every
    /// landing page gets the same dropdown. The page must reserve the trailing
    /// column in its <see cref="LandingGridSettings.GridTemplateColumns"/> (a
    /// trailing <c>auto</c> or fixed width), matching the old inline Actions width.
    /// <para>Actions-column rendering follows the landing-grid pattern
    /// (handled inside <see cref="RowActionsMenu"/>; pages don't branch):
    /// 0 actions → renders nothing; exactly 1 action → a labeled
    /// <c>FluentButton</c>; 2+ actions → the kebab (⋮) menu.</para>
    /// </summary>
    [Parameter]
    public Func<TItem, IReadOnlyList<RowAction>>? RowActions { get; set; }

    /// <summary>Accessibility label for the per-row actions kebab trigger button.</summary>
    [Parameter]
    public string? RowActionsAriaLabel { get; set; }

    /// <summary>Header text for the trailing actions column. Default "Actions".</summary>
    [Parameter]
    public string RowActionsColumnTitle { get; set; } = "Actions";

    /// <summary>
    /// Controls whether the trailing actions menu renders via
    /// <c>FluentMenuProvider</c> (true, the production default so the menu is
    /// never clipped by the grid's scroll container) or inline (false, used in
    /// bUnit tests so the items are assertable in the rendered markup). Mirrors
    /// the <c>UseMenuService</c> parameter of <c>&lt;RowActionsMenu&gt;</c>.
    /// </summary>
    [Parameter]
    public bool RowActionsUseMenuService { get; set; } = true;

    /// <summary>
    /// The effective grid columns: the page's <see cref="Columns"/> plus a trailing
    /// "Actions" <see cref="RowActionsMenu"/> column when <see cref="RowActions"/>
    /// is supplied.
    /// </summary>
    private RenderFragment EffectiveColumns => @<text>@Columns@if (RowActions is not null)
    {
        <TemplateColumn TGridItem="TItem" Title="@RowActionsColumnTitle" Sortable="false" Context="row">
            <RowActionsMenu AriaLabel="@(RowActionsAriaLabel ?? RowActionsColumnTitle)"
                            UseMenuService="@RowActionsUseMenuService"
                            Actions="@RowActions(row)" />
        </TemplateColumn>
    }</text>;

    /// <summary>
    /// Error text. Rendered as a red message bar beneath the grid when non-empty.
    /// </summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>
    /// When <c>true</c>, the spinner is shown even if <see cref="Items"/> is
    /// non-null (e.g. an in-flight server search). The page drives this from its
    /// own search state.
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// Optional slot rendered in the action-bar immediately after the New
    /// button — typically a filter control such as a status
    /// <c>FluentSelect</c> or a "Show deleted" <c>FluentCheckbox</c>.
    /// </summary>
    [Parameter]
    public RenderFragment? ToolbarFilters { get; set; }

    /// <summary>
    /// Optional slot rendered at the far right of the action-bar, after the
    /// search box — e.g. an AI-assistant launcher button.
    /// </summary>
    [Parameter]
    public RenderFragment? ToolbarActions { get; set; }

    /// <summary>Two-way bound search box value.</summary>
    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    /// <summary>
    /// Fired (debounced by the <c>FluentTextField</c>'s <c>Immediate</c> +
    /// <c>ImmediateDelay</c>) when the search box value changes. The page owns
    /// the strategy: a server fetch with cancellation, a client-side filter,
    /// or a bind-and-reload.
    /// </summary>
    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    /// <summary>Search box placeholder. Defaults to "Search…".</summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }

    /// <summary>Default <c>true</c>; set <c>false</c> to hide the search box.</summary>
    [Parameter]
    public bool SearchEnabled { get; set; } = true;

    /// <summary>Default <c>true</c>; set <c>false</c> to hide the New button.</summary>
    [Parameter]
    public bool CreateEnabled { get; set; } = true;

    /// <summary>
    /// Optional click handler for the New button. When set, takes precedence
    /// over <see cref="CreateRoute"/> and the New button invokes this callback
    /// instead of navigating. Use this for dialog-based Create flows where
    /// the New button should open a <c>DialogShellBase</c>-derived dialog
    /// rather than navigate to a dedicated <c>/create</c> route.
    /// </summary>
    [Parameter]
    public EventCallback OnCreate { get; set; }

    /// <summary>
    /// Optional pinned-footer content, published into the layout's
    /// <c>page-footer</c> section slot (e.g. an inline chat launcher).
    /// </summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Escape hatch for anything not covered by the slots above; rendered last
    /// in the scroll region. Kept for forward-compatibility.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private Task OnSearchChanged(string? text)
        => SearchTextChanged.InvokeAsync(text ?? string.Empty);

    /// <summary>
    /// Routes the New button click: prefers <see cref="OnCreate"/> when a
    /// delegate is supplied, otherwise falls back to the legacy
    /// <see cref="CreateRoute"/> navigation. The fallback keeps every existing
    /// call site working unchanged; pages that opt into dialog-based Create
    /// just supply <c>OnCreate</c> and may leave <c>CreateRoute</c> empty.
    /// </summary>
    private async Task HandleCreateClicked()
    {
        if (OnCreate.HasDelegate)
        {
            await OnCreate.InvokeAsync();
            return;
        }
        Nav.NavigateTo(CreateRoute);
    }
}