@using Microsoft.JSInterop
@using Blazored.TextEditor
@inject IJSRuntime JS
@inject ILogger<RichInstructionEditor> Logger
@implements IAsyncDisposable
@* RichInstructionEditor (round wysiwyg-instruction-editor, §8.4 Q12) — the shared rich-text editor for
   instruction prose, and the answer to "don't replicate the wrapper and its JS in every host": this
   component lives in the shared UI library, imports its own asset loader, and mounts the wrapper only
   once Quill exists. Hosts declare nothing.

   The wrapper IS the interop (owner, 2026-10-11) — we write no JS bridge. What we read at submit is
   sanitised by the caller, and what we seed is a plain string.

   HEIGHT: the panel's height is a caller knob (the MinHeight parameter) but the sizing itself stays in
   the component's scoped CSS. The root carries the value as the --rich-instruction-editor-min-height
   custom property; the scoped rules consume it with the assignment surface's 8rem as their fallback,
   so a host that passes nothing renders exactly as before.

   PLACEHOLDER TAGS (template-editor round, B3): a host that passes PlaceholderTags gets a tag button in
   the Quill TOOLBAR — inside the editor's own box, so its menu anchors where the operator is typing —
   and the chosen token is inserted at the current caret. A host that passes nothing (the assignment
   authoring surface) renders none of it: no button, no menu, and no interop beyond the asset load it
   already did. *@
<div class="rich-instruction-editor" id="@_rootElementId" style="--rich-instruction-editor-min-height: @MinHeight">
    @if (_assetsReady)
    {
        <BlazoredTextEditor @ref="_editor"
                            Theme="snow"
                            Placeholder="@Placeholder"
                            ReadOnly="@ReadOnly">
            @* Real Razor markup, not an HTML-string constant: the tag button needs an id and a menu
               anchor, which a string cannot carry. The formats stay tag-based only (G4) — no colour,
               background, font or size, because those emit inline `style` that RichInstructionSanitizer
               refuses to admit — and no image, because Q14 keeps media as instruction ITEMS rather than
               inline embeds. *@
            <ToolbarContent>
                <span class="ql-formats">
                    <select class="ql-header">
                        <option selected></option>
                        <option value="1"></option>
                        <option value="2"></option>
                        <option value="3"></option>
                        <option value="4"></option>
                    </select>
                </span>
                <span class="ql-formats">
                    <button class="ql-bold"></button>
                    <button class="ql-italic"></button>
                    <button class="ql-underline"></button>
                    <button class="ql-strike"></button>
                </span>
                <span class="ql-formats">
                    <button class="ql-list" value="ordered"></button>
                    <button class="ql-list" value="bullet"></button>
                </span>
                <span class="ql-formats">
                    <button class="ql-link"></button>
                    <button class="ql-clean"></button>
                </span>
                @if (HasPlaceholderMenu)
                {
                    @* OUR button, not a Quill format: Quill attaches a handler only to a class it knows,
                       so it ignores this one and the FluentMenu owns the click. The menu is anchored to
                       the button (FluentMenu.Trigger points its CSS anchor at that element), which is why
                       it opens in the toolbar rather than beside the editor. *@
                    <span class="ql-formats">
                        <button type="button"
                                id="@_tagButtonId"
                                class="rich-instruction-editor__tag-button"
                                aria-label="Insert tag"
                                aria-haspopup="menu"
                                aria-expanded="@(_tagMenuOpen ? "true" : "false")">
                            @TagButtonText
                        </button>
                        <FluentMenu Trigger="@_tagButtonId"
                                    OpenedChanged="OnTagMenuOpenedChanged"
                                    OnClick="OnPlaceholderTagClickedAsync">
                            <FluentMenuList>
                                <PlaceholderTagMenu Tags="@(PlaceholderTags ?? Array.Empty<string>())" />
                            </FluentMenuList>
                        </FluentMenu>
                    </span>
                }
            </ToolbarContent>
        </BlazoredTextEditor>
    }
    else
    {
        @* The assets are loading: an empty box beats handing the wrapper a page where window.Quill
           does not exist yet. *@
        <div class="rich-instruction-editor-loading" aria-hidden="true"></div>
    }
</div>

@code {
    /// <summary>Optional element id (the bUnit/page seam).</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>The stored instruction text to seed the editor with — plain text or sanitised HTML.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Read-only posture (the authoring page's View mode).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Shown while the editor is empty.</summary>
    [Parameter] public string Placeholder { get; set; } = "Write the instructions…";

    /// <summary>
    /// The editor surface's minimum height, as a CSS length — the panel-fill knob (naming spec D10:
    /// the template editor passes a taller value so the body fills the panel it sits in). Emitted on
    /// the root as the <c>--rich-instruction-editor-min-height</c> custom property and consumed by this
    /// component's scoped CSS; the loading placeholder follows the same value so the panel does not jump
    /// when the real control arrives.
    /// <para>Defaults to <see cref="DefaultMinHeight"/> (8rem), so the assignment authoring surface —
    /// which passes nothing — renders exactly as it always has.</para>
    /// </summary>
    [Parameter] public string MinHeight { get; set; } = DefaultMinHeight;

    /// <summary>The <see cref="MinHeight"/> a host gets by default (the pre-D10 behaviour).</summary>
    public const string DefaultMinHeight = "8rem";

    /// <summary>
    /// The placeholder tags this editor offers in its toolbar menu (template-editor round, B3).
    /// <para>Null or empty — the default, and what every pre-existing host passes — renders no tag
    /// button and no menu, so the assignment authoring surface is unchanged. Read-only editors get
    /// neither: there is nothing to insert into.</para>
    /// </summary>
    [Parameter] public IReadOnlyList<string>? PlaceholderTags { get; set; }

    /// <summary>
    /// The asset loader in THIS library — the reason no host declares a tag.
    /// The <c>./</c> prefix is MANDATORY, not stylistic: blazor.web.js's "import" interop handler
    /// rewrites only specifiers starting with <c>./</c> to absolute URLs (via document.baseURI)
    /// before calling <c>import()</c>. A bare specifier like <c>_content/…</c> is passed through
    /// raw, fails module resolution ("Failed to resolve module specifier") BEFORE any fetch, and
    /// lands as a swallowed JSException — the editor then stays on its loading placeholder for
    /// ever (the reported "editor not displaying" defect, diagnosed 2026-10-11). Every working
    /// module import in this repo carries the prefix: dialogDrawer.js, chatInput.js, the
    /// collocated *.razor.js modules — see the constant below.
    /// </summary>
    public const string AssetsModulePath = "./_content/SchoolCollab.Admin.Shared/js/quillAssets.js";

    /// <summary>
    /// What the tag button says. It is a WORD, not a glyph: the two-brace mark this button used to
    /// carry was unreadable at toolbar size (owner, 2026-10-23), and a toolbar-wide label needs no
    /// legend. Same wording as the page-level trigger it replaced, so nothing has to be relearned.
    /// </summary>
    private const string TagButtonText = "Insert tag";

    private BlazoredTextEditor? _editor;
    private IJSObjectReference? _assetsModule;
    private bool _assetsReady;
    private bool _seeded;
    private string? _seededValue;
    private bool _tagMenuOpen;

    /// <summary>Whether the render pass that gives the WRAPPER its initialisation turn has run —
    /// see <see cref="OnAfterRenderAsync"/> for why the seed must not share the mount batch.</summary>
    private bool _editorMounted;

    /// <summary>Bounded seed retries: each attempt is one render pass, so a permanently broken
    /// interop can never loop, and a transient one gets more than one chance.</summary>
    private int _seedAttempts;

    private const int MaxSeedAttempts = 3;

    /// <summary>
    /// The editor ROOT element's DOM id — two roles: the root div's <c>id</c> attribute, and the editor
    /// the insert call addresses.
    /// <para><see cref="Id"/> when the host pins one (the template editor pins
    /// <c>#template-body-editor</c>, the bUnit suites address the same id); otherwise one generated per
    /// instance, because the wrapper's inner ids are NOT unique and two editors on one page must never
    /// share an id. Null when the host passed no <see cref="Id"/> and no tags, so a tag-less host's
    /// markup is byte-for-byte what it always was.</para>
    /// </summary>
    private string? _rootElementId;

    /// <summary>The generated half of <see cref="_rootElementId"/>, created at most once per instance.</summary>
    private string? _generatedId;

    /// <summary>
    /// The tag button's DOM id, and the element the <see cref="FluentMenu"/> anchors to — derived from the
    /// root id so two editors on one page can never share a trigger.
    /// </summary>
    private string? _tagButtonId => _rootElementId is null ? null : $"{_rootElementId}-insert-tag";

    /// <summary>Whether this instance's tag button and menu exist — the gate for their markup.</summary>
    private bool HasPlaceholderMenu => !ReadOnly && PlaceholderTags is { Count: > 0 };

    /// <summary>A new value (the dialog reopening on another row) re-seeds, rather than leaving the
    /// previous row's prose on screen.</summary>
    protected override void OnParametersSet()
    {
        if (_seededValue != Value)
        {
            _seededValue = Value;
            _seeded = false;
            _seedAttempts = 0;
        }

        // Stable from the first render pass on, so the root never changes id mid-flight: a pinned id wins,
        // and a tag-less host keeps no id at all.
        _rootElementId = Id ?? (HasPlaceholderMenu
            ? _generatedId ??= $"rich-instruction-editor-{Guid.NewGuid():N}"
            : null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _assetsModule = await JS.InvokeAsync<IJSObjectReference>("import", AssetsModulePath);
                if (_assetsModule is null)
                {
                    // bUnit's loose default; a real browser either resolves the module or throws.
                    return;
                }

                await _assetsModule.InvokeAsync<bool>("ensureQuillAssets");
            }
            catch (JSException ex)
            {
                // Without the assets there is no editor to show; the box stays empty and the reason is
                // logged rather than swallowed (the lesson from the Enter-guard round).
                Logger.LogWarning(ex, "Quill assets could not be loaded; the instruction editor is unavailable in this session.");
                return;
            }

            // Blazor calls a CHILD's OnAfterRenderAsync before its parent's, so the wrapper would have
            // initialised against a page with no window.Quill. Mount it on the render AFTER the assets
            // are in place instead.
            _assetsReady = true;
            StateHasChanged();
            return;
        }

        if (!_assetsReady || _editor is null)
        {
            return;
        }

        if (!_editorMounted)
        {
            // The 2026-10-11 "editor not displaying" defect, found by a live instrumented repro:
            // in the batch where the WRAPPER first renders, this parent's OnAfterRenderAsync runs
            // BEFORE the child's, so a seed issued here reached QuillFunctions.loadQuillHTMLContent
            // while the element had no __quill yet (createQuill had not run) — the resulting
            // TypeError surfaced as a JSException and the PAGE's ErrorBoundary replaced the whole
            // form. Rendering one more pass hands the child its initialisation turn: the next batch
            // is processed only after the wrapper's createQuill has been awaited to completion.
            _editorMounted = true;
            StateHasChanged();
            return;
        }

        if (_seeded || string.IsNullOrEmpty(Value) || _seedAttempts >= MaxSeedAttempts)
        {
            return;
        }

        _seedAttempts++;
        try
        {
            _seeded = true; // cleared in the catch so the next render pass may retry
            await _editor.LoadHTMLContent(Value); // G6: a string seed, so no markup injection is needed.
        }
        catch (JSException ex)
        {
            _seeded = false;
            Logger.LogWarning(
                ex,
                "Seeding the instruction editor failed (attempt {Attempt} of {Max}); it will be retried on a later render pass.",
                _seedAttempts,
                MaxSeedAttempts);
        }
    }

    /// <summary>
    /// The editor's HTML, read when the caller submits (G6). The wrapper has no change callback, and
    /// reading at submit keeps sanitising to one point: where the value can enter the model.
    /// <para><c>null</c> means "the editor is not available in this session" (assets never loaded, or
    /// the interop failed) — the caller keeps the model's current value rather than wiping the
    /// guidance or faulting the save through the page's ErrorBoundary.</para>
    /// </summary>
    public async Task<string?> GetHtmlAsync()
    {
        if (_editor is null)
        {
            return null;
        }

        try
        {
            return await _editor.GetHTML();
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Reading the instruction editor's HTML failed; the caller keeps its current value.");
            return null;
        }
    }

    /// <summary>
    /// Inserts a placeholder token at the editor's current caret (B2), falling back in JS to the end of
    /// the body when the editor has no selection.
    /// <para>The toolbar menu's items call THIS. A no-op when the editor is unavailable (assets never
    /// loaded, or the module already released) or the host offers no tags.</para>
    /// </summary>
    /// <returns><c>true</c> only when the token was actually inserted — so a caller can tell a real body
    /// change (worth a preview) from a no-op.</returns>
    public async Task<bool> InsertPlaceholderAsync(string token)
    {
        if (_assetsModule is not { } module
            || _rootElementId is null
            || !HasPlaceholderMenu
            || string.IsNullOrEmpty(token))
        {
            return false;
        }

        try
        {
            return await module.InvokeAsync<bool>("insertPlaceholderAtSelection", _rootElementId, token);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing left to insert into.
        }
        catch (ObjectDisposedException)
        {
            // The module was released by DisposeAsync — a menu click racing the page's teardown.
            Logger.LogDebug("The instruction editor's script module was already released; the token was not inserted.");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Inserting the placeholder tag into the instruction editor failed.");
        }

        return false;
    }

    /// <summary>The menu's click handler. <see cref="FluentMenu.OnClick"/> is MENU-scoped, so a group
    /// parent ("Assignment", "Recipients") and a parent whose reported text carries its whole nested
    /// sub-menu both arrive here — hence <see cref="PlaceholderTagMenu.TokenFromText"/>, which admits
    /// nothing but the strict token shape and so can never let a label land in a customer-facing
    /// message body.</summary>
    private async Task OnPlaceholderTagClickedAsync(MenuItemEventArgs args)
    {
        if (PlaceholderTagMenu.TokenFromText(args.Text) is not { } token)
        {
            return;
        }

        await InsertPlaceholderAsync(token);
    }

    /// <summary>
    /// Keeps the button's <c>aria-expanded</c> true to the menu's real state — the menu opens and closes
    /// from its own JS, so only its callback can tell us.
    /// </summary>
    private void OnTagMenuOpenedChanged(bool opened) => _tagMenuOpen = opened;

    public async ValueTask DisposeAsync()
    {
        if (_assetsModule is not { } module)
        {
            return;
        }

        _assetsModule = null;

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is nothing left to release.
        }
        catch (ObjectDisposedException)
        {
            // Already released; nothing to do.
        }
        catch (JSException ex)
        {
            // The module reference outlived its circuit or the page navigated away mid-teardown.
            Logger.LogWarning(ex, "Releasing the instruction editor's script module failed.");
        }
    }
}
