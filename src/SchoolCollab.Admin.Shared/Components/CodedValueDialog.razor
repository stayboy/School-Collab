@* Coded value Create / Override dialog. Consolidated onto DialogShellBase:
   the saving/error/Cancel/Close boilerplate and the Cancel/Save footer live
   in the base + DialogShellFooter; this component contributes only the form
   fields (per Mode) and the SubmitAsync side effect.

   The "Reset to default" button in Override mode is a non-shell secondary
   action — it is rendered inside the body and closes the dialog directly
   with a DialogShellResult<CodedValueDto> so the caller's
   ShowShellDialogAsync unwraps it uniformly. *@
@inherits DialogShellBase<CodedValueFormModel, CodedValueDto>
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject CodedValuesApiClient CodedValuesApi

<div class="dialog-container">
    @if (Mode == "Create")
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <FluentTextField @bind-Value="Model.Code" Label="Code *" Placeholder="e.g. GRADE9" Required class="full-width mb-3" />
            <FluentTextField @bind-Value="Model.Name" Label="Name *" Placeholder="e.g. Grade 9" Required class="full-width mb-3" />
            <FluentTextField @bind-Value="Model.Description" Label="Description" Rows="2" class="full-width mb-3" />
            <FluentNumberField @bind-Value="Model.DisplayOrder" Label="Display Order" class="full-width mb-3" />

            <DialogShellFooter Saving="@Saving"
                               Error="@Error"
                               SubmitText="@SubmitText"
                               SavingText="@SavingText"
                               OnCancel="HandleCancelAsync" />
        </EditForm>
    }
    else if (Mode == "Override")
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <p class="hint">Overriding: <strong>@GetDefaultName()</strong></p>
            <FluentTextField @bind-Value="Model.Name" Label="Override Name" Placeholder="@GetPlaceholder()" class="full-width mb-3" />
            <FluentTextArea @bind-Value="Model.Description" Label="Description (optional)" Rows="2" class="full-width mb-3" />

            @if (_hasOverride)
            {
                <FluentButton Appearance="Appearance.Neutral" OnClick="RemoveOverrideAndCloseAsync" Disabled="@_removing" class="mb-3">
                    @if (_removing)
                    {
                        <FluentProgressRing Style="width: 16px; height: 16px;" />
                    }
                    else
                    {
                        <span>Reset to default</span>
                    }
                </FluentButton>
            }

            <DialogShellFooter Saving="@Saving"
                               Error="@Error"
                               SubmitText="@SubmitText"
                               SavingText="@SavingText"
                               OnCancel="HandleCancelAsync" />
        </EditForm>
    }
</div>

<style>
    .dialog-container {
        padding: 16px;
        box-sizing: border-box;
        width: 100%;
        overflow-wrap: break-word;
    }
    .full-width { width: 100%; min-width: 0; box-sizing: border-box; }
    .mb-3 { margin-bottom: 12px; }
    .hint { color: var(--neutral-foreground-hint); margin-bottom: 12px; word-wrap: break-word; }
</style>

@code {
    private string Mode => Model.Mode;
    private CodedValueDto? _codedValue => Model.CodedValue;

    private bool _removing;
    private bool _hasOverride;

    protected override string SubmitText => Mode == "Create" ? "Create" : "Save Override";

    /// <summary>Preserves the original Create-mode "Creating..." in-flight label (the shared footer defaults to "Saving...").</summary>
    protected override string SavingText => Mode == "Create" ? "Creating..." : "Saving...";

    protected override void OnModelInitialized(CodedValueFormModel model)
    {
        // Name / Description are left at their default (null) so the Override
        // input shows the default-name placeholder rather than the current
        // resolved value — same UX as the pre-consolidation dialog. The
        // "Overriding: ..." hint above shows the default name explicitly.
        _hasOverride = model.HasOverride;
    }

    protected override async Task<CodedValueDto?> SubmitAsync(CodedValueFormModel model)
    {
        if (model.Mode == "Create")
        {
            return await CreateAsync(model);
        }
        return await OverrideAsync(model);
    }

    private async Task<CodedValueDto?> CreateAsync(CodedValueFormModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Code) || string.IsNullOrWhiteSpace(model.Name))
        {
            Error = "Code and Name are required.";
            return null;
        }

        await CodedValuesApi.CreateAsync(new CreateCodedValueRequest(
            model.Code.Trim().ToUpperInvariant(),
            model.Name.Trim(),
            model.Description,
            model.ParentId,
            model.DisplayOrder ?? 0));

        var created = await CodedValuesApi.GetByCodeAsync(model.Code.Trim().ToUpperInvariant(), model.ParentId);
        if (created is null)
        {
            Error = "Created but could not fetch the new coded value.";
            return null;
        }

        return created;
    }

    private async Task<CodedValueDto?> OverrideAsync(CodedValueFormModel model)
    {
        if (_codedValue is null)
        {
            Error = "No coded value selected.";
            return null;
        }

        var result = await CodedValuesApi.UpsertOverrideAsync(
            _codedValue.Id,
            string.IsNullOrWhiteSpace(model.Name) ? null : model.Name.Trim(),
            string.IsNullOrWhiteSpace(model.Description) ? null : model.Description);

        _hasOverride = true;
        return result;
    }

    /// <summary>
    /// Non-shell secondary action: removes the tenant override and closes the
    /// dialog with the freshly re-fetched (default) coded value, wrapped in a
    /// <see cref="DialogShellResult{TResult}"/> so the caller's
    /// <c>ShowShellDialogAsync</c> unwraps it the same as the submit path.
    /// </summary>
    private async Task RemoveOverrideAndCloseAsync()
    {
        if (_codedValue is null || _removing) return;

        _removing = true;
        Error = null;

        try
        {
            await CodedValuesApi.RemoveOverrideAsync(_codedValue.Id);
            _hasOverride = false;

            // Re-fetch to get the original (non-overridden) name.
            var original = await CodedValuesApi.GetByIdAsync(_codedValue.Id);
            if (original is not null)
            {
                await Dialog.CloseAsync(new DialogShellResult<CodedValueDto>(original));
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            _removing = false;
        }
    }

    /// <summary>Default (non-tenant) name, for the "Overriding: ..." hint and the input placeholder.</summary>
    private string GetDefaultName()
    {
        if (_codedValue is null) return string.Empty;
        return _codedValue.DefaultName ?? _codedValue.Name;
    }

    private string GetPlaceholder()
    {
        var defaultName = GetDefaultName();
        return string.IsNullOrEmpty(defaultName)
            ? "Enter custom name for your tenant"
            : $"e.g. {defaultName}";
    }
}
