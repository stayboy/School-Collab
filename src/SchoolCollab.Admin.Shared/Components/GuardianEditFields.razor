@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Admin.Shared.Constants

@* Shared guardian metadata field group used by BOTH the Add form and the
   Edit form inside GuardianSection's focused Edit view (the side drawer).
   Before this component existed the two branches duplicated the same
   Title / Name (First + Last) / Relationship+Role FormRows with
   identical bindings and identical widths — a drift risk (the inline-add
   branch and the draft-edit branch were byte-for-byte the same, and the
   pre-existing Full-mode branch carried a different W4/W3 width for
   relationship/role). Consolidating into one component locks the field
   set and the canonical widths (Title W3, Name row splits the input cell,
   relationship W3 + role W2) in a single definition.

   The host owns the working copy as a single <see cref="GuardianEditFieldsModel"/>
   reference: inputs two-way bind to its properties (e.g. <c>@bind-Value="Model.FirstName"</c>),
   so the host binds the whole field group with one <c>Model</c> parameter
   instead of five two-way primitives. <see cref="ShowIdentityFields"/>
   gates the Title / name rows so the existing-guardian edit form (which
   doesn't persist those fields through the student save — they're
   guardian-surface operations) can hide them while still using the same
   component for Relationship/Role.

   Usage (host, Edit view):
     <GuardianEditFields Model="_editModel"
                         ShowIdentityFields="@(editedGuardian.ExistingGuardianId is null)" /> *@

@if (ShowIdentityFields)
{
    <FormRow Label="Title">
        <CodedValueDropdown Parent="CodedValueParent.Salutations"
                            @bind-SelectedId="Model.TitleCodedValueId"
                            Placeholder="Optional"
                            Width="FieldWidth.W3" />
    </FormRow>
    <FormRow Label="Name" Required For="guardianEditFirstName">
        <FluentTextField Id="guardianEditFirstName"
                         @bind-Value="Model.FirstName"
                         Required Placeholder="First name"
                         class="guardian-name-field" />
        <FluentTextField Id="guardianEditLastName"
                         @bind-Value="Model.LastName"
                         Required Placeholder="Last name"
                         class="guardian-name-field" />
    </FormRow>
}
<FormRow Label="Relationship/Role" Required Orientation="RowOrientation.Vertical">
    <CodedValueDropdown Parent="CodedValueParent.Relationships"
                        @bind-SelectedId="Model.RelationshipCodedValueId"
                        @bind-SelectedId:after="NotifyRelationshipChanged"
                        Placeholder="Relationship"
                        Width="FieldWidth.W3" />
    <div class="guardian-role-checkbox">
        <FluentCheckbox @bind-Value="Model.IsCC"
                        Label="CC"
                        HelpText="carbon-copy / not the primary" />
    </div>
</FormRow>

@code {
    /// <summary>The working-copy model bound to the four field rows. The
    /// host instantiates one <see cref="GuardianEditFieldsModel"/> per
    /// edit session and mutates its properties via the two-way bindings
    /// above; on Save the host reads the accumulated values from the
    /// same instance.</summary>
    [Parameter, EditorRequired] public GuardianEditFieldsModel Model { get; set; } = default!;

    /// <summary>When true (default), renders the Title / First name / Last
    /// name rows above Relationship/Role. Set false for the
    /// existing-guardian edit form, where those identity fields don't
    /// persist through the student save and would mislead the user into
    /// editing them.</summary>
    [Parameter] public bool ShowIdentityFields { get; set; } = true;

    /// <summary>Raised after the relationship dropdown selection changes, so
    /// the host (GuardianSection) can re-render the drawer's identity header
    /// to reflect the newly chosen relationship (R2). Parameterless — mirrors
    /// <see cref="ContactFormFields.ChannelChanged"/>.</summary>
    [Parameter] public EventCallback RelationshipChanged { get; set; }

    private Task NotifyRelationshipChanged() => RelationshipChanged.InvokeAsync();
}
