@*
    Shared read-only label/value field display primitive for detail cards,
    summary panels, and read-only review blocks across the repo.

    Layout is controlled by <see cref="FieldDisplayOrientation"/>:

      Vertical (default):
        ┌─ .field-display ───────────────┐
        │ .field-display__label          │  uppercase, muted, 0.75rem
        │ "NAME"                         │
        │ .field-display__value          │  1rem, neutral rest
        │ "Grade 5"                      │
        └────────────────────────────────┘

      Horizontal:
        ┌─ .field-display ───────────────┐
        │ .field-display__label: "Name"  │  normal case, bold, inline
        │ .field-display__value: "..."   │
        └────────────────────────────────┘

    Usage:
        <FieldDisplay Label="Name">@_grade.Name</FieldDisplay>

        <FieldDisplay Label="Status" Orientation="FieldDisplayOrientation.Horizontal">
            <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
        </FieldDisplay>

    The value is supplied via ChildContent so it can contain plain text or
    arbitrary markup (badges, anchors, icons, etc).

    For a link value, pass <see cref="Href"/> and FieldDisplay renders the
    value as a hypertext FluentAnchor to that URL (with the anchor's internal
    left/right control padding stripped so the text left-aligns with the label
    in the vertical layout) — callers don't wrap the value in an anchor
    themselves.
*@
@using Microsoft.FluentUI.AspNetCore.Components

<div class="field-display field-display-@_orientationCss @Class">
    <span class="field-display__label">@Label</span>
    <span class="field-display__value">
        @if (Href is { } href)
        {
            <FluentAnchor Appearance="Appearance.Hypertext" Href="@href">@ChildContent</FluentAnchor>
        }
        else
        {
            @ChildContent
        }
    </span>
</div>

@code {
    /// <summary>Visible label text. Required.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = default!;

    /// <summary>
    /// Layout orientation. Default is <see cref="FieldDisplayOrientation.Vertical"/>
    /// (label above value, muted uppercase label style).
    /// </summary>
    [Parameter] public FieldDisplayOrientation Orientation { get; set; } = FieldDisplayOrientation.Vertical;

    /// <summary>Optional additional CSS class on the wrapper element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The field value. Can be plain text or arbitrary markup.</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>
    /// Optional navigation URL. When set, the value renders as a hypertext
    /// <c>FluentAnchor</c> link to this URL (with the anchor's internal
    /// left/right control padding removed so the text left-aligns with the
    /// label in the vertical layout).
    /// </summary>
    [Parameter] public string? Href { get; set; }

    private string _orientationCss => Orientation.ToString().ToLowerInvariant();
}
