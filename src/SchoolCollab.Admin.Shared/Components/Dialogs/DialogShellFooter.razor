@* Shared footer for every DialogShellBase-derived dialog. Renders the
   inline error message bar (when set) and the Cancel / Submit button
   row, plus the shared CSS.

   IMPORTANT: place this component INSIDE the derived dialog's
   <EditForm OnValidSubmit="HandleSubmitAsync"> ... </EditForm>. The
   Submit button below is Type="ButtonType.Submit" with no @onclick, so
   clicking it submits the enclosing EditForm and fires its
   OnValidSubmit (which calls DialogShellBase.HandleSubmitAsync →
   SubmitAsync). The Cancel button uses OnClick (it is not a Submit
   button) so it does not trigger form validation.

   Parameters:
     Saving      — disables both buttons and swaps the submit label for
                   "Saving..." while the submit is in flight.
     Error       — when non-empty, renders a red FluentMessageBar above
                   the button row.
     SubmitText  — the submit button label (default "Save").
     OnCancel    — invoked when the Cancel button is clicked (typically
                   bound to DialogShellBase.HandleCancelAsync).
     ShowSubmit  — when false, hides the Submit button (used by dialogs that
                   toggle between a read-only display and an edit section, e.g.
                   the topic create/edit dialogs, where the Submit action only
                   applies in edit mode). Default true. *@

@if (!string.IsNullOrWhiteSpace(Error))
{
    <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@Error</FluentMessageBar>
}

<div class="button-row">
    <FluentButton Appearance="Appearance.Outline"
                  OnClick="OnCancel"
                  Disabled="@Saving">
        Cancel
    </FluentButton>
    @if (ShowSubmit)
    {
        @if (SubmitIsServerSubmit)
        {
            <FluentButton Type="ButtonType.Submit"
                          Appearance="Appearance.Accent"
                          Disabled="@(Saving || SubmitDisabled)">
                @(Saving ? SavingText : SubmitText)
            </FluentButton>
        }
        else
        {
            @* Local (non-server) submit — e.g. the topic edit dialog's
               "Update Fields" button, which reflects changes back to the
               read-only display section instead of submitting to the server. *@
            <FluentButton Type="ButtonType.Button"
                          Appearance="Appearance.Accent"
                          Disabled="@(Saving || SubmitDisabled)"
                          OnClick="OnSubmit">
                @SubmitText
            </FluentButton>
        }
    }
</div>


@code {
    /// <summary>True while the submit is in flight; disables both buttons.</summary>
    [Parameter] public bool Saving { get; set; }

    /// <summary>When non-empty, rendered as a red message bar above the buttons.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Submit button label. Default: "Save".</summary>
    [Parameter] public string SubmitText { get; set; } = "Save";

    /// <summary>Label shown while <paramref name="Saving"/> is true. Default: "Saving...".</summary>
    [Parameter] public string SavingText { get; set; } = "Saving...";

    /// <summary>Invoked when the Cancel button is clicked.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>When true, disables the Submit button (in addition to <see cref="Saving"/>).</summary>
    [Parameter] public bool SubmitDisabled { get; set; }

    /// <summary>
    /// When true (default), the Submit button is <c>Type=Submit</c> and submits the
    /// enclosing EditForm (firing <c>HandleSubmitAsync</c> → the dialog's
    /// <c>SubmitAsync</c>). When false, it renders as a plain button invoking
    /// <see cref="OnSubmit"/> — used by dialogs whose edit-mode action reflects
    /// changes locally (e.g. the topic edit dialog's "Update Fields") instead of
    /// submitting to the server.
    /// </summary>
    [Parameter] public bool SubmitIsServerSubmit { get; set; } = true;

    /// <summary>Invoked when the Submit button is clicked in local (non-server) mode.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    /// <summary>When false, hides the Submit button (display-only mode).</summary>
    [Parameter] public bool ShowSubmit { get; set; } = true;
}
