@* Reusable "chip" (pill). Two modes:

   1. Selected / added item (default) — built on the native <FluentBadge>: FluentUI
      Blazor has no dedicated Chip component. The badge uses a fill-less (Ghost)
      appearance and is further neutralized in CSS so it shows no inner background
      of its own — all the visible styling (border, fill, radius, padding, hover)
      comes from our own .chip wrapper, which wraps BOTH the text and the dismiss
      button.

      The badge's own dismiss affordance did not survive the FluentUI 5.0.1 port:
      <FluentBadge> 5.0.1 has no DismissTitle / OnDismissClick (Content, ChildContent,
      Shape and Size replace the 4.14.2 dismissal API), so those parameters would now
      render as meaningless HTML attributes and the chip would silently lose its remove
      button. The dismiss control is therefore authored here as a real <button> beside
      the badge — styled by .chip-dismiss in Chip.razor.css.

   2. Selectable (opt-in, round content-questions-modern-ui) — set `OnToggle` and
      the chip renders as a real <button type="button" aria-pressed> instead of a
      badge, so a set of independent toggles (the composer's question-type mix) is
      keyboard-activatable and correctly announced. The visual two-state look is
      `.is-selected` (filled, no border) vs the default (hairline, transparent).
      This mode is purely additive: every existing call site keeps mode 1. *@
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<span class="chip @(OnToggle.HasDelegate ? "chip--toggle" : null) @(OnToggle.HasDelegate && Selected ? "is-selected" : null)">
    @if (OnToggle.HasDelegate)
    {
        <button type="button" class="chip-toggle" aria-pressed="@(Selected ? "true" : "false")" @onclick="HandleToggleAsync">
            <span class="chip-label">@Label</span>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="chip-sub">@Subtitle</span>
            }
        </button>
    }
    else
    {
        <FluentBadge Class="chip-badge" Appearance="BadgeAppearance.Ghost">
            <span class="chip-inner">
                <span class="chip-label">@Label</span>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <span class="chip-sub">@Subtitle</span>
                }
            </span>
        </FluentBadge>
        @if (OnDismiss.HasDelegate)
        {
            <button type="button" class="chip-dismiss"
                    title="@DismissTitle" aria-label="@DismissTitle"
                    @onclick="OnDismiss">
                <FluentIcon Value="@(new Icons.Regular.Size12.Dismiss())" />
            </button>
        }
    }
</span>

@code {
    /// <summary>Primary text shown in the chip (usually a name).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Optional secondary text shown after the label (e.g. a number).</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Tooltip / accessible name of the dismiss (remove) button. Default "Remove".</summary>
    [Parameter] public string DismissTitle { get; set; } = "Remove";

    /// <summary>When set, a dismiss button is shown and invoked to remove the chip.
    /// When not set, the chip is read-only.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>Selectable mode only: the current on/off state, mirrored onto
    /// <c>aria-pressed</c>. Ignored when <see cref="OnToggle"/> is unset.</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>When set, the chip becomes a toggle BUTTON rather than a badge and this
    /// callback receives the newly-requested state. Unset (the default) keeps the
    /// original badge rendering, so this mode is fully opt-in.</summary>
    [Parameter] public EventCallback<bool> OnToggle { get; set; }

    private Task HandleToggleAsync() => OnToggle.InvokeAsync(!Selected);
}
