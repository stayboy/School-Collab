@* Reusable kebab (⋮) overflow menu for row actions in a FluentDataGrid.
   Landing-grid actions-column pattern:
     • 0 actions      → renders nothing (no kebab / empty menu);
     • 1 action       → a labeled FluentButton (Stealth appearance) instead
                        of the kebab, so the single action is discoverable
                        without an extra click;
     • 2+ actions     → the kebab trigger + FluentMenu, one FluentMenuItem
                        (or FluentDivider) per RowAction.
   Both renderings share the same invoke path (Href / callback /
   destructive-confirmation), so behavior is identical.

   Grid-level consistency (repo convention): when a grid contains any row that
   qualifies for the kebab (2+ non-separator actions), the grid owner passes
   ForceKebab="true" so EVERY row with at least one action renders the kebab —
   no row shows a lone labeled button while a sibling shows the kebab. Rows
   with 0 actions still render nothing. Use <see cref="HasKebabActions"/> to
   compute the grid-level flag from a row-action builder.

   FluentMenu 5.0.1 removed the menu provider (Anchor → Trigger, UseMenuService and
   Open gone) and moved the popover state onto the menu's LIST child: the library's
   own stylesheet hides `fluent-menu-list:not([popover])`, and the menu's JS flips
   that state when the trigger is clicked. The items therefore MUST be wrapped in a
   <FluentMenuList> — bare <FluentMenuItem> children under <FluentMenu> render inline
   and permanently visible, with the trigger doing nothing (post-merge defect
   2026-10-17). The trigger button's Id and the menu's Id are auto-generated per
   instance so multiple rows each get a unique trigger pair. *@
@using SchoolCollab.Admin.Shared.Constants
@inject NavigationManager Nav
@inject IDialogService DialogService

<span class="row-actions-menu">
    @if (!ForceKebab && singleAction is not null)
    {
        @* Single-action rows render a labeled FluentButton instead of the
           kebab menu (landing-grid pattern: one action → button; two or
           more → kebab). When ForceKebab is true the grid owner has decided
           that a sibling row qualifies for the kebab, so this row renders
           the kebab too for visual consistency. The button reuses the same
           invoke path as the menu item, so Href / callback /
           destructive-confirm behavior is identical between the two
           renderings. *@
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      Title="@(singleAction.DisabledReason ?? singleAction.Label)"
                      Disabled="@singleAction.Disabled"
                      OnClick="@(() => InvokeActionAsync(singleAction))">
            @if (singleAction.Icon is not null)
            {
                <FluentIcon Value="@singleAction.Icon" Slot="start" />
            }
            @singleAction.Label
        </FluentButton>
    }
    else if (Actions.Count > 0)
    {
        @* Rows with an empty action list render nothing (no kebab / empty
           menu) — e.g. Completed/Archived periods with no actions. *@
        <FluentButton Id="@_buttonId"
              Appearance="ButtonAppearance.Subtle"
              Title="@(AriaLabel ?? "More actions")"
              aria-haspopup="true"
              aria-expanded="@_open">
        <FluentIcon Value="@(KebabIcon ?? FluentIcons.MoreVertical)" />
    </FluentButton>

    @* FluentMenu 5.0.1 renamed Anchor to Trigger (still the HTML id of the element
       that toggles the menu) and removed UseMenuService/Open. The items go in a
       <FluentMenuList>: v5 hides `fluent-menu-list:not([popover])` and flips that
       popover state on trigger click, which is also what reports back through
       OpenedChanged (keeping aria-expanded honest). Without the list wrapper the
       items are always visible and the trigger does nothing. *@
    <FluentMenu Id="@_menuId"
                Trigger="@_buttonId"
                OpenedChanged="@(opened => _open = opened)">
        <FluentMenuList>
        @foreach (var action in Actions)
        {
            @if (action.IsSeparator)
            {
                <FluentDivider />
            }
            else
            {
                @* F7: FluentMenuItem exposes no Title parameter, so this renders as its HTML
                   title attribute — the accessible description a disabled item would otherwise not
                   have. A null reason renders no attribute at all (no invented text). *@
                <FluentMenuItem Label="@action.Label"
                                Disabled="@action.Disabled"
                                Title="@action.DisabledReason"
                                OnClick="@(async () => await InvokeActionAsync(action))">
                    @if (action.Icon is not null)
                    {
                        <FluentIcon Value="@action.Icon" Slot="start" />
                    }
                </FluentMenuItem>
            }
        }
        </FluentMenuList>
    </FluentMenu>
    }
</span>

@code {
    /// <summary>
    /// When the action list contains exactly one non-separator action, it is
    /// rendered as a labeled <c>&lt;FluentButton&gt;</c> instead of the kebab
    /// menu (landing-grid pattern: one action → button, two or more → kebab).
    /// </summary>
    private RowAction? singleAction
    {
        get
        {
            var nonSeparators = Actions.Where(a => !a.IsSeparator).ToList();
            return nonSeparators.Count == 1 ? nonSeparators[0] : null;
        }
    }

    /// <summary>
    /// The ordered list of actions to render. Separator entries render a
    /// <c>&lt;FluentDivider&gt;</c>; all others render a <c>&lt;FluentMenuItem&gt;</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RowAction> Actions { get; set; } = Array.Empty<RowAction>();

    /// <summary>
    /// Accessibility label / tooltip for the kebab trigger button.
    /// Default: "More actions".
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Retained for call-site compatibility only: FluentUI 5.0.1 removed
    /// <c>FluentMenu.UseMenuService</c> together with the menu provider, and the items
    /// are always present in the markup (nested in a <c>FluentMenuList</c>) whatever
    /// the open state, so this flag no longer changes anything. Callers that pass
    /// <c>false</c> in bUnit hosts (items assertable in the markup) keep working
    /// unchanged.
    /// </summary>
    [Parameter]
    public bool UseMenuService { get; set; } = true;

    /// <summary>Icon for the kebab trigger button. Defaults to MoreVertical (⋮).</summary>
    [Parameter]
    public Icon? KebabIcon { get; set; }

    /// <summary>
    /// When true, every row with at least one action renders the kebab (⋮)
    /// menu instead of the single-action labeled button. The grid owner sets
    /// this when any row in the grid qualifies for the kebab (2+ non-separator
    /// actions) so all rows render consistently. Rows with 0 actions still
    /// render nothing. Default false preserves the per-row behavior.
    /// </summary>
    [Parameter]
    public bool ForceKebab { get; set; }

    /// <summary>
    /// True when <paramref name="actions"/> contains 2+ non-separator actions —
    /// i.e. the row qualifies for the kebab (⋮) menu rather than a single-action
    /// labeled button. Grid owners use this to compute the grid-level
    /// <see cref="ForceKebab"/> flag: if any row qualifies, force the kebab on
    /// every row for visual consistency.
    /// </summary>
    public static bool HasKebabActions(IReadOnlyList<RowAction> actions)
        => actions.Count(a => !a.IsSeparator) >= 2;

    private string _buttonId = string.Empty;
    private string _menuId = string.Empty;
    private bool _open;

    protected override void OnInitialized()
    {
        // Unique ids per instance so every row's menu anchors to its own button.
        var suffix = Guid.NewGuid().ToString("N");
        _buttonId = $"row-actions-btn-{suffix}";
        _menuId = $"row-actions-menu-{suffix}";
    }

    private async Task InvokeActionAsync(RowAction action)
    {
        if (action.Disabled) return;
        if (action.Href is not null)
        {
            Nav.NavigateTo(action.Href);
            return;
        }
        if (action.OnClick is not null)
        {
            // Destructive actions (Remove / Delete) are gated by a confirmation
            // prompt before the callback runs. Enforced here at the component
            // level so every destructive row action is confirmed. The prompt is
            // a modal dialog (dark overlay) that can be dismissed by clicking
            // the overlay or pressing ESC.
            if (action.Destructive)
            {
                var message = action.ConfirmMessage
                    ?? $"Are you sure you want to {action.Label.ToLowerInvariant()}?";
                var confirmed = await DialogService.ShowConfirmDialogAsync(
                    message, action.Label, "Cancel", action.Label);
                if (!confirmed) return;
            }
            await action.OnClick.Invoke();
        }
    }
}
