@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Constants

@inject CodedValuesApiClient Api
@inject ILogger<CodedValueDropdown> Logger
@implements IDisposable

@*
    Usage
    ─────
    Simple two-way binding (just store the picked id in a model field):
        <CodedValueDropdown Parent="CodedValueParent.Genders"
                            @bind-SelectedId="Model.GenderCodedValueId" />

    Two-way binding with a side-effect (e.g. fetch the full CodedValueDto
    and seed dependent state). Uses Blazor's pseudo binder `@bind-Foo:after`
    so the binder still updates the bound field AND the handler runs — no
    need for a custom "On*" parameter.

    Recommended C# form: declare the `:after` handler as a parameterless
    `void` method that fire-and-forgets an `async Task` helper. The method
    group then converts directly to the `Action` that `@bind-Foo:after`
    expects, so the call site is just the bare method name — no lambda
    wrapper. The handler reads the post-bind bound field directly (the
    binder has already updated it). The async helper owns the real work
    and its own try/catch, so any failure surfaces via the logger instead
    of becoming an unobserved-Task exception from the discarded Task:

        <CodedValueDropdown Parent="CodedValueParent.Grades"
                            @bind-SelectedId="_codedValueIdNullable"
                            @bind-SelectedId:after="OnCodedValueChanged" />

        @code {
            // Parameterless void handler — :after target. Reads the
            // post-bind field, fire-and-forgets the async seed.
            private void OnCodedValueChanged()
                => _ = SeedFromCodedValueAsync();

            // Async helper — real work, properly awaited inside, with
            // its own try/catch for clean error handling.
            private async Task SeedFromCodedValueAsync() { ... }
        }

    If the side-effect handler must genuinely take a parameter (e.g. it
    is shared with other call sites and the value isn't always bound),
    wrap it in a lambda: `@bind-SelectedId:after="() => OnHandler(id)"`.
    The lambda is `Action` and the `async Task` method's returned Task is
    discarded — equivalent fire-and-forget semantics.

    Do NOT pass `SelectedIdChanged=` at the call site — that overrides the
    binder and the bound field stops updating. Use `@bind-SelectedId:after`
    for the side-effect; the binder owns `SelectedIdChanged`.
*@

@if (_error is not null)
{
    <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
}

<FluentSelect TOption="CodedValueDto"
              Items="@(_items ?? [])"
              SelectedOption="@_selectedOption"
              SelectedOptionChanged="@OnSelectedOptionChanged"
              OptionText="@(o => o.Name)"
              OptionValue="@(o => o.Id.ToString())"
              Label="@Label"              
              Placeholder="@EffectivePlaceholder"              
              Disabled="@IsDisabled"
              class="@EffectiveClass" />

@code {
    /// <summary>
    /// The parent coded value category.
    /// Changing this value after initialization will reload the dropdown items.
    /// Values are resolved through the tenant-aware coded-value API, so any
    /// tenant-specific overrides are applied automatically.
    /// </summary>
    [Parameter, EditorRequired]
    public CodedValueParent Parent { get; set; }

    private string ParentCode => Parent.ToCode();

    /// <summary>
    /// Label shown above the dropdown.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Placeholder text when no value is selected.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; } = "Select…";

    /// <summary>
    /// CSS class to apply to the dropdown component.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The currently selected coded value id (two-way bindable).
    /// </summary>
    [Parameter]
    public Guid? SelectedId { get; set; }

    /// <summary>
    /// Callback invoked when the selected coded value id changes.
    /// </summary>
    [Parameter]
    public EventCallback<Guid?> SelectedIdChanged { get; set; }

    /// <summary>
    /// Disables the dropdown independently of loading state.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    private CodedValueDto[]? _items;
    private CodedValueDto? _selectedOption;
    private string? _error;
    private string _lastLoadedParentCode = string.Empty;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private bool IsDisabled => Disabled || _items is null || _error is not null;

    private string EffectivePlaceholder => _error is not null
        ? "—"
        : _items is null
            ? "Loading…"
            : _items.Length == 0
                ? "No options available"
                : (Placeholder ?? "Select…");

    private string EffectiveClass => string.IsNullOrWhiteSpace(Class) 
        ? "coded-value-dropdown" 
        : $"{Class} coded-value-dropdown";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(ParentCode);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Parent is an enum parameter that may change after initialization
        // (e.g. cascading value, wizard step, or form field dependency). When it
        // changes we must discard the previous items and reload for the new parent.
        if (ParentCode != _lastLoadedParentCode)
        {
            await LoadAsync(ParentCode);
        }

        // Keep the internal selection in sync when the consumer updates SelectedId.
        if (_items is not null && SelectedId.HasValue)
        {
            var selected = _items.FirstOrDefault(x => x.Id == SelectedId);
            if (!Equals(selected, _selectedOption))
            {
                _selectedOption = selected;
            }
        }
    }

    /// <summary>
    /// Reloads the dropdown items for the current <see cref="ParentCode"/>.
    /// Call this from a parent component when the underlying coded value list
    /// may have changed (e.g. after creating a new option in a dialog).
    /// </summary>
    public async Task RefreshAsync()
    {
        if (_disposed) return;
        await LoadAsync(ParentCode);
    }

    private async Task LoadAsync(string parentCode)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        _items = null;
        _error = null;
        _selectedOption = null;
        _lastLoadedParentCode = parentCode;

        try
        {
            var items = await Api.GetChildrenByParentCodeAsync(parentCode, ct) ?? [];
            if (_disposed || ct.IsCancellationRequested) return;

            _items = items;
            _selectedOption = _items.FirstOrDefault(x => x.Id == SelectedId);
        }
        catch (OperationCanceledException)
        {
            // User navigated away or ParentCode changed before the lookup completed.
        }
        catch (Exception ex)
        {
            if (_disposed || ct.IsCancellationRequested) return;

            Logger.LogError(ex, "Failed to load coded values for parent {ParentCode}", parentCode);
            _error = $"Unable to load options for {parentCode}.";
        }
    }

    private async Task OnSelectedOptionChanged(CodedValueDto? value)
    {
        _selectedOption = value;
        // Notifies the binder (drives the @bind-SelectedId target). When the
        // consumer also supplies a @bind-SelectedId:after handler, Blazor's
        // binder wires that handler into its internal callback chain and
        // invokes it after the bound field is updated. Consumers should NOT
        // pass SelectedIdChanged= directly — that overrides the binder and
        // the bound field stops updating. Use @bind-SelectedId:after for
        // side-effects; the binder owns SelectedIdChanged.
        await SelectedIdChanged.InvokeAsync(value?.Id);
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
