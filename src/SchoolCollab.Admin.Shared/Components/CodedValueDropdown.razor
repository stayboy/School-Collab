@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Constants

@inject CodedValuesApiClient Api
@inject ILogger<CodedValueDropdown> Logger
@implements IDisposable

@*
    Usage
    ─────
    Simple two-way binding (just store the picked id in a model field):
        <CodedValueDropdown Parent="CodedValueParent.Genders"
                            @bind-SelectedId="Model.GenderCodedValueId" />

    Two-way binding with a side-effect (e.g. fetch the full CodedValueDto
    and seed dependent state). Uses Blazor's pseudo binder `@bind-Foo:after`
    so the binder still updates the bound field AND the handler runs — no
    need for a custom "On*" parameter.

    Recommended C# form: declare the `:after` handler as a parameterless
    `void` method that fire-and-forgets an `async Task` helper. The method
    group then converts directly to the `Action` that `@bind-Foo:after`
    expects, so the call site is just the bare method name — no lambda
    wrapper. The handler reads the post-bind bound field directly (the
    binder has already updated it). The async helper owns the real work
    and its own try/catch, so any failure surfaces via the logger instead
    of becoming an unobserved-Task exception from the discarded Task:

        <CodedValueDropdown Parent="CodedValueParent.Grades"
                            @bind-SelectedId="_codedValueIdNullable"
                            @bind-SelectedId:after="OnCodedValueChanged" />

        @code {
            // Parameterless void handler — :after target. Reads the
            // post-bind field, fire-and-forgets the async seed.
            private void OnCodedValueChanged()
                => _ = SeedFromCodedValueAsync();

            // Async helper — real work, properly awaited inside, with
            // its own try/catch for clean error handling.
            private async Task SeedFromCodedValueAsync() { ... }
        }

    If the side-effect handler must genuinely take a parameter (e.g. it
    is shared with other call sites and the value isn't always bound),
    wrap it in a lambda: `@bind-SelectedId:after="() => OnHandler(id)"`.
    The lambda is `Action` and the `async Task` method's returned Task is
    discarded — equivalent fire-and-forget semantics.

    Do NOT pass `SelectedIdChanged=` at the call site — that overrides the
    binder and the bound field stops updating. Use `@bind-SelectedId:after`
    for the side-effect; the binder owns `SelectedIdChanged`.
*@

@if (_error is not null)
{
    <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
}

<FluentSelect TOption="CodedValueDto"
              Items="@(_items ?? [])"
              SelectedOption="@_selectedOption"
              SelectedOptionChanged="@OnSelectedOptionChanged"
              OptionText="@EffectiveOptionText"
              OptionValue="@(o => o.Id.ToString())"
              Label="@Label"              
              Placeholder="@EffectivePlaceholder"              
              Disabled="@IsDisabled"
              Style="@EffectiveStyle"
              class="@EffectiveClass" />

@code {
    /// <summary>
    /// The parent coded value category.
    /// Changing this value after initialization will reload the dropdown items.
    /// Values are resolved through the tenant-aware coded-value API, so any
    /// tenant-specific overrides are applied automatically.
    /// <para>
    /// Optional when <see cref="AttributeFilter"/> is supplied — the filter
    /// call still needs a parent (resolved from the filter's key context) but
    /// the dropdown does not require the caller to set the enum. When both
    /// <see cref="AttributeFilter"/> and <see cref="Parent"/> are set the
    /// filter takes precedence (used by the stream picker, where the parent
    /// is <c>GRSTREAMS</c> and the filter is <c>gradeLevel=&lt;selectedGrade&gt;</c>).
    /// </para>
    /// </summary>
    [Parameter]
    public CodedValueParent Parent { get; set; }

    private string ParentCode => Parent.ToCode();

    /// <summary>
    /// Optional attribute key/value filter. When set, the dropdown loads its
    /// items via the <c>attributeKey</c>/<c>attributeValue</c> query params
    /// on the Settings <c>GET /api/coded-values/by-parent</c> endpoint
    /// instead of the unfiltered parent lookup. Used by the grade-stream
    /// picker to show only streams whose <c>gradeLevel</c> attribute
    /// references the currently selected grade.
    /// </summary>
    [Parameter]
    public (string Key, string Value)? AttributeFilter { get; set; }

    /// <summary>
    /// Placeholder text shown when an attribute filter is set but no items
    /// match. Defaults to <c>"No matches"</c>.
    /// </summary>
    [Parameter]
    public string? EmptyFilterPlaceholder { get; set; } = "No matches";

    /// <summary>
    /// Label shown above the dropdown.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Placeholder text when no value is selected.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; } = "Select…";

    /// <summary>
    /// CSS class to apply to the dropdown component.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Fixed input width from the repo's W1–W9 ladder
    /// (see <see cref="FieldWidth"/>). When set, emits an inline
    /// <c>style</c> on the underlying <see
    /// cref="Microsoft.FluentUI.AspNetCore.Components.FluentSelect"/> so the
    /// width always wins over this wrapper's scoped
    /// <c>.coded-value-dropdown { width: 100% }</c> default (inline style
    /// beats Blazor scoped CSS). Takes precedence over any width set via
    /// <see cref="Class"/>. Leave null to keep the default
    /// <c>fill-the-cell</c> behavior.
    /// </summary>
    [Parameter]
    public FieldWidth? Width { get; set; }

    /// <summary>
    /// Optional override for the function that produces the display text
    /// for each option. Defaults to <c>o =&gt; o.Name</c> (the coded value's
    /// Name field). Use this to compose a richer label from a coded value's
    /// attributes — e.g. <c>o =&gt; $"{o.Name} ({o.Attributes.First(a =&gt; a.Key == "COUNTRY").Value})"</c>
    /// for country calling codes that should display "+233 (Ghana)".
    /// </summary>
    [Parameter]
    public Func<CodedValueDto, string>? OptionText { get; set; }

    /// <summary>
    /// The currently selected coded value id (two-way bindable).
    /// </summary>
    [Parameter]
    public Guid? SelectedId { get; set; }

    /// <summary>
    /// Callback invoked when the selected coded value id changes.
    /// </summary>
    [Parameter]
    public EventCallback<Guid?> SelectedIdChanged { get; set; }

    /// <summary>
    /// Disables the dropdown independently of loading state.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// When true, prepends an empty option (<c>Id = Guid.Empty</c>) so the user
    /// can clear the selection. Selecting it fires <see cref="SelectedIdChanged"/>
    /// with <c>null</c>. Used by the topic-create dialog to re-enable the custom
    /// topic fields after picking an existing subject.
    /// </summary>
    [Parameter]
    public bool ShowEmptyOption { get; set; }

    /// <summary>Display text for the empty option when <see cref="ShowEmptyOption"/> is true.</summary>
    [Parameter]
    public string EmptyOptionText { get; set; } = "None";

    private CodedValueDto[]? _items;
    private CodedValueDto? _selectedOption;
    private string? _error;
    private string? _loadedLoadKey;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isLoadingItems;

    /// <summary>
    /// The currently loaded dropdown items. Callers can use this to resolve the
    /// full <see cref="CodedValueDto"/> for the selected id without a redundant
    /// per-item API round-trip.
    /// </summary>
    public IReadOnlyList<CodedValueDto> Items => _items ?? Array.Empty<CodedValueDto>();

    private bool IsDisabled => Disabled || _items is null || _error is not null;

    private string EffectivePlaceholder => _error is not null
        ? "—"
        : _items is null
            ? "Loading…"
            : _items.Length == 0
                ? (AttributeFilter is not null
                    ? (EmptyFilterPlaceholder ?? "No matches")
                    : "No options available")
                : (Placeholder ?? "Select…");

    private string EffectiveClass => string.IsNullOrWhiteSpace(Class) 
        ? "coded-value-dropdown" 
        : $"{Class} coded-value-dropdown";

    /// <summary>
    /// Inline <c>style</c> emitted when <see cref="Width"/> is set; null
    /// otherwise (so no empty <c>style=""</c> attribute is rendered).
    /// </summary>
    private string? EffectiveStyle => Width?.ToCssStyle();

    private Func<CodedValueDto, string> EffectiveOptionText => OptionText ?? (o => o.Name);

    /// <summary>
    /// Stable identity of the current load: parent code + the attribute
    /// filter (if any). A change to either triggers a reload. When the
    /// filter is set the parent code is still part of the key so a parent
    /// change with a stable filter still reloads.
    /// </summary>
    private string LoadKey => ComputeLoadKey(ParentCode, AttributeFilter);

    /// <summary>Shared key computation so the comparison in
    /// <see cref="OnParametersSetAsync"/> and the value recorded by
    /// <see cref="LoadAsync"/> can never diverge. NOTE: both sides MUST
    /// include the <see cref="AttributeFilter"/> — recording only the parent
    /// code made the equality permanently false for filtered dropdowns (the
    /// stream picker), so every render took the reload branch instead of
    /// <see cref="SyncSelection"/>, clearing items mid-flight and causing
    /// FluentSelect to fire a spurious SelectedOptionChanged(null) that wiped
    /// the user's selection.</summary>
    private static string ComputeLoadKey(string parentCode, (string Key, string Value)? attributeFilter)
        => string.IsNullOrEmpty(parentCode)
            ? string.Empty
            : attributeFilter is { } f
                ? $"{parentCode}|{f.Key}={f.Value}"
                : parentCode;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(ParentCode)) return;
        await LoadAsync(ParentCode);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Parent is an enum parameter that may change after initialization
        // (e.g. cascading value, wizard step, or form field dependency). When
        // it changes we discard the previous items and reload for the new parent.
        // When it does NOT change (e.g. a sibling control on the page changed and
        // triggered a re-render) we only re-sync the current selection — no async
        // reload round-trip — so interacting elsewhere on the page never causes an
        // unwanted dropdown refresh or latency.
        if (string.IsNullOrWhiteSpace(ParentCode))
        {
            _items = [];
            _error = null;
            _selectedOption = null;
            return;
        }

        if (LoadKey != _loadedLoadKey)
        {
            await LoadAsync(ParentCode);
        }
        else
        {
            SyncSelection();
        }
    }

    private void SyncSelection()
    {
        // Keep the internal selection in sync when the consumer updates SelectedId.
        // Runs synchronously during the normal lifecycle so a re-render triggered by
        // a sibling control does not defer the dropdown update or re-open the list.
        if (_items is not null)
        {
            // When the consumer sets SelectedId to null (e.g. an optimistic-UI
            // pick handler that resets the picker immediately after rendering
            // a confirmation chip from the dropdown's data), clear the
            // internal selection too — otherwise FluentSelect keeps showing
            // the stale picked option. We only touch _selectedOption when
            // the consumer-driven value disagrees with what we have, so we
            // don't fight the user's mid-pick state.
            if (!SelectedId.HasValue)
            {
                // When no value is selected, show the empty option (if enabled)
                // so the user can see the "clear" affordance; otherwise clear.
                var empty = ShowEmptyOption ? _items.FirstOrDefault(x => x.Id == Guid.Empty) : null;
                if (!Equals(empty, _selectedOption))
                {
                    _selectedOption = empty;
                }
            }
            else
            {
                var selected = _items.FirstOrDefault(x => x.Id == SelectedId);
                if (!Equals(selected, _selectedOption))
                {
                    _selectedOption = selected;
                }
            }
        }
    }

    /// <summary>
    /// Reloads the dropdown items for the current <see cref="ParentCode"/>.
    /// Call this from a parent component when the underlying coded value list
    /// may have changed (e.g. after creating a new option in a dialog).
    /// </summary>
    public async Task RefreshAsync()
    {
        if (_disposed) return;
        await LoadAsync(ParentCode);
    }

    /// <summary>
    /// Looks up a coded value by id from the dropdown's already-loaded items
    /// without re-fetching from the server. The dropdown's initial load uses
    /// <c>GetChildrenByParentCodeAsync</c> which already returns the full
    /// tenant-resolved <see cref="CodedValueDto"/> (Name, IsOverridden,
    /// DefaultName, …) — so a pick from the dropdown never needs a follow-up
    /// <c>GetByIdAsync</c> round-trip just to read the resolved name.
    ///
    /// Returns <c>false</c> while the dropdown is still loading, after a load
    /// error, or when the id is not in the current items (e.g. the items were
    /// never loaded for this <see cref="Parent"/>). Callers should fall back
    /// to <c>CodedValuesApi.GetByIdAsync</c> in those rare cases.
    /// </summary>
    public bool TryFindItem(Guid id, out CodedValueDto? item)
    {
        if (_items is null || _error is not null)
        {
            item = null;
            return false;
        }

        item = _items.FirstOrDefault(x => x.Id == id);
        return item is not null;
    }

    /// <summary>Resolves the internal selection from the consumer's
    /// <see cref="SelectedId"/> against the CURRENT items. Null-safe: returns
    /// null while items are unloaded. Shared by both load phases in
    /// <see cref="LoadAsync"/> so every render carries a selection that is
    /// guaranteed to be contained in <see cref="_items"/>.</summary>
    private CodedValueDto? ResolveSelection()
        => _items is null
            ? null
            : SelectedId.HasValue
                ? _items.FirstOrDefault(x => x.Id == SelectedId)
                : (ShowEmptyOption ? _items.FirstOrDefault(x => x.Id == Guid.Empty) : null);

    private async Task LoadAsync(string parentCode)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        _items = null;
        _error = null;
        _selectedOption = null;
        // Record the FULL load key (parent + attribute filter), not just the
        // parent code — OnParametersSetAsync compares against the same
        // computation, so recording a subset made filtered dropdowns (the
        // stream picker) reload on EVERY render and wipe the selection.
        _loadedLoadKey = ComputeLoadKey(parentCode, AttributeFilter);
        _isLoadingItems = true; // suppress spurious events during the #1533 workaround below

        try
        {
            // AttributeFilter takes precedence: when set we call the
            // attribute-filtered endpoint so the dropdown shows only items
            // that match the filter (e.g. streams whose gradeLevel attribute
            // references the currently selected grade). Otherwise we fall
            // back to the unfiltered parent-children lookup.
            var items = AttributeFilter is { } f
                ? await Api.GetChildrenByParentCodeFilteredByAttributeAsync(parentCode, f.Key, f.Value, ct) ?? []
                : await Api.GetChildrenByParentCodeAsync(parentCode, ct) ?? [];
            if (_disposed || ct.IsCancellationRequested) return;

            // Prepend an empty option (Id = Guid.Empty) when requested so the
            // user can clear the selection and re-enable custom entry.
            if (ShowEmptyOption)
            {
                var empty = new CodedValueDto(
                    Guid.Empty, string.Empty, EmptyOptionText, null, null, null, false, 0,
                    DateTimeOffset.MinValue, DateTimeOffset.MinValue,
                    Array.Empty<CodedValueAttributeDto>(), Array.Empty<CodedValueAttributeDefinitionDto>());
                items = new[] { empty }.Concat(items).ToArray();
            }

            // Phase 1: render the new items with NO selection. FluentSelect does
            // not apply a SelectedOption when Items and SelectedOption change in the
            // same render cycle — the <fluent-select> web component has not yet
            // registered the new option list (microsoft/fluentui-blazor #1533).
            // By rendering the items first and yielding one tick, we give the web
            // component time to attach its options before we ask it to select one.
            //
            // IMPORTANT: during this load window we suppress SelectedOptionChanged
            // events that match either (a) a spurious reset to null while we still
            // have a valid SelectedId, or (b) a reassertion of the same SelectedId.
            // Without suppression, (a) would wipe the consumer's bound field, and
            // (b) would re-fire @bind-SelectedId:after handlers such as
            // EnrollStudentDialog.OnGradePicked (which clears the stream).
            _items = items;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1);

            if (_disposed || ct.IsCancellationRequested) return;
            // Phase 2: the web component now knows the options, so applying the
            // resolved selection will display it. Resolving again is idempotent;
            // the explicit render is only needed when a concrete option is selected
            // (a null/empty-option selection has nothing new to re-apply).
            _selectedOption = ResolveSelection();
            if (_selectedOption is not null)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // User navigated away or ParentCode changed before the lookup completed.
        }
        catch (Exception ex)
        {
            if (_disposed || ct.IsCancellationRequested) return;

            Logger.LogError(ex, "Failed to load coded values for parent {ParentCode}", parentCode);
            _error = $"Unable to load options for {parentCode}.";
        }
        finally
        {
            _isLoadingItems = false;
        }
    }

    private Task OnSelectedOptionChanged(CodedValueDto? value)
    {
        _selectedOption = value;
        // The empty option (Id = Guid.Empty) clears the selection — fire null so
        // the consumer's bound field re-enables (e.g. custom topic fields).
        var id = value is not null && value.Id == Guid.Empty ? (Guid?)null : value?.Id;

        // During an async item load we render once with no selection and once
        // with the resolved selection. Both can raise SelectedOptionChanged events
        // that must NOT flow back to the consumer: a spurious reset to null while
        // the current SelectedId is still valid would wipe the bound field, and a
        // reassertion of the same SelectedId would re-fire @bind-SelectedId:after
        // handlers (e.g. clearing the stream in EnrollStudentDialog). We suppress
        // only those two cases; when the items legitimately no longer contain the
        // current SelectedId (e.g. the filter changed), the resulting clear is
        // allowed to propagate.
        if (_isLoadingItems)
        {
            var resolved = ResolveSelection();
            if (id is null && resolved is not null)
                return Task.CompletedTask;

            if (EqualityComparer<Guid?>.Default.Equals(id, SelectedId))
                return Task.CompletedTask;
        }

        // Notifies the binder (drives the @bind-SelectedId target). When the
        // consumer also supplies a @bind-SelectedId:after handler, Blazor's
        // binder wires that handler into its internal callback chain and
        // invokes it after the bound field is updated. Consumers should NOT
        // pass SelectedIdChanged= directly — that overrides the binder and
        // the bound field stops updating. Use @bind-SelectedId:after for
        // side-effects; the binder owns SelectedIdChanged.
        //
        // Returning the EventCallback task directly (instead of awaiting it)
        // keeps this event handler synchronous and avoids the Blazor renderer
        // having to schedule an async continuation before FluentSelect can
        // close the dropdown and refresh the UI.
        return SelectedIdChanged.InvokeAsync(id);
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
