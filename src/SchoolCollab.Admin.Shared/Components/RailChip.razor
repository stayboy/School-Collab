@namespace SchoolCollab.Admin.Shared.Components

@*
    One chip inside a <see cref="RailBand"/>. Five shapes, each a state of the same thing:

      * a FACT        — Grade 4, Term 2, Active            → no interaction
      * a REMOVABLE   — Chess Club ✕ (OnRemove supplied)    → the ✕ affordance
      * a BLOCKED     — Choir · window closed               → struck through, Reason required, aria-disabled
      * an ACTIONABLE — Mathematics · not chosen            → struck through AND a real button (OnActivate)
      * a BADGE       — "0 joined" style markers            → use RailBand.Hint instead where possible

    Blocked chips exist because an unavailable option must read as a RULE, not as a bug (Q18a): the
    reason is in the visible text AND in title/aria-description, so it survives keyboard and screen
    reader use. A blocked chip with no reason is the failure the Reason parameter exists to prevent.

    An ACTIONABLE chip is the opposite case and must not be built out of the blocked one: it is struck
    through because a record is MISSING (the student is not enrolled) and it is the way to fix that —
    so it renders a real <button>, keeps its place in the keyboard tab order, and never carries
    aria-disabled (which is exactly what would make it unreachable and unsolvable at once).
*@

<span class="@ChipClass" role="listitem" title="@Tooltip" aria-description="@Reason" aria-disabled="@(Blocked ? "true" : null)">
    @if (OnActivate.HasDelegate)
    {
        <button type="button"
                class="rail-chip__activate"
                aria-label="@ActivateName"
                disabled="@Disabled"
                @onclick="OnActivate">@Text</button>
        @if (!string.IsNullOrWhiteSpace(StateLabel))
        {
            <span class="rail-chip__state">· @StateLabel</span>
        }
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
    @if (Blocked && !string.IsNullOrWhiteSpace(Reason))
    {
        <span class="rail-chip__reason">· @Reason</span>
    }
    @if (OnRemove.HasDelegate)
    {
        <button type="button"
                class="rail-chip__action"
                title="@($"Remove {Text}")"
                aria-label="@($"Remove {Text}")"
                disabled="@Disabled"
                @onclick="OnRemove">✕</button>
    }
</span>

@code {
    /// <summary>The chip's text. Also the accessible name of its remove button ("Remove {Text}").</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>Struck through, and rendered <c>aria-disabled</c>. Requires <see cref="Reason"/>.</summary>
    [Parameter]
    public bool Blocked { get; set; }

    /// <summary>Why the chip is blocked (e.g. "window closed"). Required when <see cref="Blocked"/>: it is
    /// rendered as visible text after the name, and again as the tooltip and accessible description.</summary>
    [Parameter]
    public string? Reason { get; set; }

    /// <summary>Supplying a delegate turns the chip into an ACTIONABLE one — struck through, but the name
    /// is a real <c>&lt;button&gt;</c> that performs the action (e.g. enrol this student). The strike says
    /// the record is missing; the button is how it stops being missing. Never combined with
    /// <see cref="Blocked"/>: a chip is either unavailable (nothing to do) or a to-do (something to do).</summary>
    [Parameter]
    public EventCallback OnActivate { get; set; }

    /// <summary>The actionable chip's state in words ("not chosen"), rendered as visible text after the
    /// name so the strike-through is never the only signal, and folded into the button's accessible name.</summary>
    [Parameter]
    public string? StateLabel { get; set; }

    /// <summary>Tints the chip to match a <see cref="RailBandVariant.Groups"/> band.</summary>
    [Parameter]
    public bool GroupStyle { get; set; }

    /// <summary>Supplying a delegate renders the ✕ affordance. Absent ⇒ no ✕ (facts are not removable).</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Disables the chip's action (✕ or the actionable button) while a write is in flight, so a
    /// slow server cannot be double-clicked. The chip's text stays readable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Custom content instead of <see cref="Text"/> (the text is still used for the ✕'s label).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ChipClass
    {
        get
        {
            var cls = "rail-chip";
            if (GroupStyle)
            {
                cls += " rail-chip--groups";
            }

            if (Blocked)
            {
                cls += " rail-chip--blocked";
            }

            if (OnActivate.HasDelegate)
            {
                cls += " rail-chip--actionable";
            }

            return cls;
        }
    }

    /// <summary>The actionable button's accessible name: the subject PLUS its state, because the visible
    /// text alone ("Mathematics") would not say why it is struck through.</summary>
    private string ActivateName => string.IsNullOrWhiteSpace(StateLabel) ? Text : $"{Text} — {StateLabel}";

    private string? Tooltip => Blocked && !string.IsNullOrWhiteSpace(Reason)
        ? $"{Text} — {Reason}"
        : null;
}
