@* Shared multi-channel contacts editor (spec §11 + §4.4 Option C). Owns
   add / remove / reorder / verify / set-primary / subscribe for a single
   contact owner (a Student or a Guardian). Supports TWO modes:

     - <b>Live</b> (default): the owner already exists. Loads contacts on
       mount and owns every mutation against the injected IContactsClient.
       Parents only supply the owner identity. Used by the student
       ContactsTab, GuardianDetail, GuardianSetupWizard, GradeLevelWizard.
     - <b>Buffered</b>: the owner does NOT exist yet (e.g. creating a
       guardian inside the picker). The parent hands in a
       <see cref="Contacts"/> list + <see cref="ContactsChanged"/> and the
       editor mutates it in memory — no API calls. The parent flushes the
       list to /contacts after it persists the owner. Used by
       GuardianPickerDialog's New panel.

   Usage:
     <ContactsEditor OwnerType="ContactOwnerType.Student" OwnerId="@studentId" />
     <ContactsEditor Mode="EditorMode.Buffered" OwnerType="ContactOwnerType.Guardian"
                     Contacts="_newContacts" ContactsChanged="..." />

   The two modes share the add-row form (Channel + Country code + Value +
   Label) and the country-code loading / formatting helpers. They differ
   in: the list row actions (Buffered has no Verify / Subscribe / Primary
   checkbox — contacts have no Primary/CC role during creation; priority is
   expressed by Order via move-up / move-down / mark-preferred), and the
   data shape (ContactDto in Live vs ContactModel in Buffered). *@
@using SchoolCollab.Students.Core.Contracts
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Core.DTOs
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Services
@inject IContactsClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject ILogger<ContactsEditor> Logger

<div class="contacts-editor @(View == ContactsView.Readonly ? "contacts-editor--readonly" : null)">
    @if (View == ContactsView.Readonly)
    {
        @* Student-edit-dialog summary. Each contact is a card with Edit +
           Delete; "Add contact" anchor below the list. Clicking Edit/Add
           raises host callbacks that open the side drawer hosting this
           editor in View="Edit". *@
        @if (RowSource.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info" class="contacts-empty">No contacts yet.</FluentMessageBar>
        }
        else
        {
            <ul class="contacts-list">
                @foreach (var c in RowSource)
                {
                    <li class="contact-item @(c.IsPreferred ? "contact-item--preferred" : null)">
                        <span class="contact-channel" title="@c.Channel.ToString()">@ChannelGlyph(c.Channel) @c.Channel</span>
                        <span class="contact-value">@FormatRowValue(c)</span>
                        @if (!string.IsNullOrWhiteSpace(c.Label))
                        {
                            <span class="contact-label">(@c.Label)</span>
                        }
                        @if (c.IsPreferred)
                        {
                            <FluentBadge Appearance="Appearance.Accent" class="contact-badge">
                                @(Mode == EditorMode.Live ? "Primary" : "Preferred")
                            </FluentBadge>
                        }
                        @if (Mode == EditorMode.Live)
                        {
                            <FluentBadge Appearance="@(c.IsVerified ? Appearance.Accent : Appearance.Neutral)" class="contact-badge">
                                @(c.IsVerified ? "Verified" : "Unverified")
                            </FluentBadge>
                        }
                        <span class="contact-actions">
                            <FluentButton Appearance="Appearance.Lightweight"
                                          Title="Edit contact"
                                          IconStart="@FluentIcons.Edit"
                                          Disabled="@EditDisabled"
                                          OnClick="@(() => OnEditContact.InvokeAsync(c.Key))" />
                            <FluentButton Appearance="Appearance.Lightweight"
                                          Title="Remove contact"
                                          IconStart="@FluentIcons.Delete"
                                          Disabled="@EditDisabled"
                                          OnClick="@(() => OnRemoveAsync(c))" />
                        </span>
                    </li>
                }
            </ul>
        }
        <FluentAnchor Href="#" OnClick="@(() => OnAddContact.InvokeAsync())" class="contacts-add-anchor">
            Add contact
        </FluentAnchor>
    }
    else if (View == ContactsView.Edit)
    {
        @* Focused per-item edit form hosted in the side drawer. Initialized
           from InitialEditKey / IsAdd; the host drawer owns Close / backdrop /
           Escape so we don't render an inline Cancel — that's redundant chrome
           inside a side drawer. Fields are stacked vertically with FormRow
           (label on top, input below) so the narrow 420px drawer breathes. *@
        <div class="contacts-edit-form">
            @if (IsAdd)
            {
                <FormRow Label="Channel" Orientation="RowOrientation.Vertical">
                    <DropdownForEnum TEnum="ContactChannel"
                                     @bind-Value="_newChannel"
                                     @bind-Value:after="OnChannelChanged"
                                     Width="FieldWidth.W3" />
                </FormRow>
                @if (_newChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
                {
                    <FormRow Label="Country code" Orientation="RowOrientation.Vertical">
                        <CodedValueDropdown Parent="CodedValueParent.CountryCallingCodes"
                                            @bind-SelectedId="_newCountryCodeId"
                                            Placeholder="Code"
                                            Width="FieldWidth.W5"
                                            OptionText="@FormatCountryCodeOption" />
                    </FormRow>
                }
                <FormRow Label="@ValueLabel" Required Orientation="RowOrientation.Vertical">
                    <FluentTextField @bind-Value="_newValue"
                                      Placeholder="@ValuePlaceholder"
                                      Required
                                      class="w-9" />
                </FormRow>
                <FormRow Label="Label" Orientation="RowOrientation.Vertical">
                    <FluentTextField @bind-Value="_newLabel"
                                      Placeholder="Label (optional)"
                                      class="w-9" />
                </FormRow>
                <div class="contacts-edit-form__actions">
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@FluentIcons.Add"
                                  OnClick="AddAsync"
                                  Disabled="@(_adding || string.IsNullOrWhiteSpace(_newValue) || EditDisabled)">
                        @(_adding ? "Adding…" : "Add")
                    </FluentButton>
                </div>
            }
            else
            {
                @* Focused per-item edit form. Same vertical FormRow layout as
                   the Add branch. Initialized from InitialEditKey; Save commits
                   the working copy (see SaveInlineEditAsync). The host drawer's
                   Close button is the Cancel affordance. *@
                @if (_editingContactKey is not null)
                {
                    <FormRow Label="Channel" Orientation="RowOrientation.Vertical">
                        <DropdownForEnum TEnum="ContactChannel"
                                         @bind-SelectedValue="_editChannel"
                                         @bind-SelectedValue:after="OnInlineEditChannelChanged"
                                         Width="FieldWidth.W1" />
                    </FormRow>
                    @if (_editChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
                    {
                        <FormRow Label="Country code" Orientation="RowOrientation.Vertical">
                            <CodedValueDropdown Parent="CodedValueParent.CountryCallingCodes"
                                                @bind-SelectedId="_editCountryCodeId"
                                                Placeholder="Code"
                                                Width="FieldWidth.W2"
                                                OptionText="@FormatCountryCodeOption" />
                        </FormRow>
                    }
                    <FormRow Label="@EditValueLabel" Required Orientation="RowOrientation.Vertical">
                        <FluentTextField @bind-Value="_editValue"
                                          Placeholder="@EditValuePlaceholder"
                                          Required
                                          class="w-9" />
                    </FormRow>
                    <FormRow Label="Label" Orientation="RowOrientation.Vertical">
                        <FluentTextField @bind-Value="_editLabel"
                                          Placeholder="Label (optional)"
                                          class="w-9" />
                    </FormRow>
                    <div class="contacts-edit-form__actions">
                        <FluentButton Appearance="Appearance.Accent"
                                      OnClick="SaveInlineEditAsync"
                                      Disabled="@EditDisabled">
                            Save
                        </FluentButton>
                    </div>
                }
            }
        </div>
    }
    else
    {
        @if (Mode == EditorMode.Live && _loading)
        {
            <div class="contacts-editor-loading">
                <FluentProgressRing />
            </div>
        }
        else
        {
        <div class="contacts-editor-add">
            <div class="contacts-editor-add__identity">
                <DropdownForEnum TEnum="ContactChannel"
                                  @bind-SelectedValue="_newChannel"
                                  @bind-SelectedValue:after="OnChannelChanged"
                                  Placeholder="Channel"
                                  Width="FieldWidth.W2" />
                @if (_newChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
                {
                    <CodedValueDropdown Parent="CodedValueParent.CountryCallingCodes"
                                        @bind-SelectedId="_newCountryCodeId"
                                        Placeholder="Code"
                                        Width="FieldWidth.W3"
                                        OptionText="@FormatCountryCodeOption" />
                }
            </div>
            <div class="contacts-editor-add__value">
                <FluentTextField @bind-Value="_newValue"
                                  Placeholder="@ValuePlaceholder"
                                  class="contacts-value" />
                <FluentTextField @bind-Value="_newLabel"
                                  Placeholder="Label (optional)"
                                  class="contacts-label" />
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@FluentIcons.Add"
                              OnClick="AddAsync"
                              Disabled="@(_adding || string.IsNullOrWhiteSpace(_newValue))">
                    @(_adding ? "Adding…" : "Add")
                </FluentButton>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" class="contacts-error">@_error</FluentMessageBar>
        }

        @if (RowSource.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info" class="contacts-empty">No contacts yet.</FluentMessageBar>
        }
        else
        {
            <ul class="contacts-list">
                @foreach (var c in RowSource)
                {
                    <li class="contact-item @(c.IsPreferred ? "contact-item--preferred" : null)">
                        <span class="contact-channel" title="@c.Channel.ToString()">@ChannelGlyph(c.Channel) @c.Channel</span>
                            <span class="contact-value">@FormatRowValue(c)</span>
                            @if (!string.IsNullOrWhiteSpace(c.Label))
                            {
                                <span class="contact-label">(@c.Label)</span>
                            }
                            @if (c.IsPreferred)
                            {
                                <FluentBadge Appearance="Appearance.Accent" class="contact-badge">
                                    @(Mode == EditorMode.Live ? "Primary" : "Preferred")
                                </FluentBadge>
                            }
                            @if (Mode == EditorMode.Live)
                            {
                                if (c.IsVerified)
                                {
                                    <FluentBadge Appearance="Appearance.Accent" class="contact-badge">Verified</FluentBadge>
                                }
                                else
                                {
                                    <FluentBadge Appearance="Appearance.Neutral" class="contact-badge">Unverified</FluentBadge>
                                }
                            }

                            @if (Mode == EditorMode.Live && ShowSubscription)
                            {
                                <FluentCheckbox Value="@_subscribed.Contains(c.Key)"
                                                ValueChanged="@(v => ToggleSubscribeAsync(c.Key, v))"
                                                class="contact-subscribe">
                                    Subscribed
                                </FluentCheckbox>
                            }

                            <span class="contact-actions">
                                @if (Mode == EditorMode.Live && !c.IsVerified)
                                {
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  Title="Mark verified"
                                                  IconStart="@FluentIcons.Checkmark"
                                                  OnClick="@(() => VerifyAsync(c.Key))" />
                                }
                                <FluentButton Appearance="Appearance.Lightweight"
                                              Title="Edit contact"
                                              IconStart="@FluentIcons.Edit"
                                              Disabled="@EditDisabled"
                                              OnClick="@(() => OnEditAsync(c))" />
                                @* Move-up / move-down reorder. Live swaps ids
                                   and calls the reorder endpoint; Buffered swaps
                                   the in-memory list and raises ContactsChanged. *@
                                <FluentButton Appearance="Appearance.Lightweight"
                                              Title="Move up (higher priority)"
                                              IconStart="@FluentIcons.ChevronUp"
                                              Disabled="@(IsFirst(c))"
                                              OnClick="@(() => MoveUpAsync(c.Key))" />
                                <FluentButton Appearance="Appearance.Lightweight"
                                              Title="Move down (lower priority)"
                                              IconStart="@FluentIcons.ChevronDown"
                                              Disabled="@(IsLast(c))"
                                              OnClick="@(() => MoveDownAsync(c.Key))" />
                                <FluentButton Appearance="Appearance.Lightweight"
                                              Title="Remove contact"
                                              IconStart="@FluentIcons.Delete"
                                              OnClick="@(() => OnRemoveAsync(c))" />
                            </span>
                    </li>
                }
            </ul>
        }
    }

    @* No embedded drawer. Buffered-mode per-row edits render inline above
       (no publish-up). Live mode keeps the ContactChangeDialog because
       per-edit audit requires a reason. *@
    @* Inline per-row edit form (Buffered). Rendered here as plain Razor markup
       instead of a published RenderFragment: the host drawer hosts the whole
       editor, so the edit form lives inline (no RenderTreeBuilder, no
       re-publish on channel change — @bind-Value:after handles it). *@
    @if (Mode == EditorMode.Buffered && _editingContactKey is not null)
    {
        <div class="contacts-inline-edit">
            <div class="contacts-editor-add__identity">
                <DropdownForEnum TEnum="ContactChannel"
                                  @bind-SelectedValue="_editChannel"
                                  @bind-SelectedValue:after="OnInlineEditChannelChanged"
                                  Placeholder="Channel"
                                  Width="FieldWidth.W2" />
                @if (_editChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
                {
                    <CodedValueDropdown Parent="CodedValueParent.CountryCallingCodes"
                                        @bind-SelectedId="_editCountryCodeId"
                                        Placeholder="Code"
                                        Width="FieldWidth.W3"
                                        OptionText="@FormatCountryCodeOption" />
                }
            </div>
            <div class="contacts-editor-add__value">
                <FluentTextField @bind-Value="_editValue"
                                  Placeholder="@EditValuePlaceholder"
                                  class="contacts-value" />
                <FluentTextField @bind-Value="_editLabel"
                                  Placeholder="Label (optional)"
                                  class="contacts-label" />
                <FluentButton Appearance="Appearance.Accent"
                              OnClick="SaveInlineEditAsync">
                    Save
                </FluentButton>
                <FluentButton Appearance="Appearance.Lightweight"
                              OnClick="CancelInlineEditAsync">
                    Cancel
                </FluentButton>
            </div>
        </div>
    }
}

</div>

@code {
    /// <summary>Editor mode. <see cref="Live"/> calls the API on every
    /// mutation (owner already exists). <see cref="Buffered"/> mutates an
    /// in-memory <see cref="Contacts"/> list and never calls the API —
    /// the parent flushes after persisting the owner.</summary>
    public enum EditorMode { Live, Buffered }

    /// <summary>Presentation mode for the editor.
    /// <see cref="Full"/> (default) is the entire inline editor (add-row + list
    /// + per-row actions + inline edit) used by all existing callers.
    /// <see cref="Readonly"/> is the student-edit-dialog summary: a list of
    /// cards each with Edit + Delete, plus an "Add contact" anchor — clicking
    /// Edit/Add raises host callbacks that open the side drawer.
    /// <see cref="Edit"/> is the focused per-item edit form for that drawer,
    /// initialized from <see cref="InitialEditKey"/> / <see cref="IsAdd"/>.</summary>
    public enum ContactsView { Full, Readonly, Edit }

    /// <summary>The contact owner type (Student or Guardian). Required in
    /// both modes (drives the country-code context and, in Live mode, the
    /// API load / persist calls).</summary>
    [Parameter, EditorRequired] public ContactOwnerType OwnerType { get; set; }

    /// <summary>The owner's id. Required in <see cref="EditorMode.Live"/>
    /// (the editor loads and mutates the owner's persisted contacts). Not
    /// used in <see cref="EditorMode.Buffered"/> (the owner does not exist
    /// yet). A runtime guard enforces this in Live mode.</summary>
    [Parameter] public Guid OwnerId { get; set; }

    /// <summary>Editor mode (defaults to <see cref="EditorMode.Live"/> so
    /// every existing caller is unchanged).</summary>
    [Parameter] public EditorMode Mode { get; set; } = EditorMode.Live;

    /// <summary>Presentation mode (defaults to <see cref="ContactsView.Full"/> so
    /// every existing caller renders the full editor unchanged).</summary>
    [Parameter] public ContactsView View { get; set; } = ContactsView.Full;

    /// <summary>For <see cref="ContactsView.Edit"/>: the contact to edit
    /// (its Buffered <c>TempId</c>), or <c>null</c> for a blank add form
    /// (when <see cref="IsAdd"/> is true). Ignored in other views.</summary>
    [Parameter] public Guid? InitialEditKey { get; set; }

    /// <summary>For <see cref="ContactsView.Edit"/>: when true the focused form
    /// is a blank add form (Save appends a new contact) instead of editing
    /// <see cref="InitialEditKey"/>. Ignored in other views.</summary>
    [Parameter] public bool IsAdd { get; set; }

    /// <summary>For <see cref="ContactsView.Readonly"/>: raised when a card's
    /// Edit button is clicked, with the contact key. The host opens the drawer
    /// hosting <see cref="ContactsView.Edit"/> for that contact.</summary>
    [Parameter] public EventCallback<Guid> OnEditContact { get; set; }

    /// <summary>For <see cref="ContactsView.Readonly"/>: raised when the
    /// "Add contact" anchor is clicked. The host opens the drawer hosting
    /// <see cref="ContactsView.Edit"/> with <see cref="IsAdd"/> = true.</summary>
    [Parameter] public EventCallback OnAddContact { get; set; }

    /// <summary>When true (default, Live mode only), shows the
    /// subscribe/unsubscribe toggle. Forced false in Buffered mode
    /// (subscriptions need a persisted contact).</summary>
    [Parameter] public bool ShowSubscription { get; set; } = true;

    /// <summary>In-memory contacts for <see cref="EditorMode.Buffered"/>.
    /// The parent owns the list and passes it by reference; the editor
    /// mutates it in place and raises <see cref="ContactsChanged"/> after
    /// every mutation. Ignored in Live mode.</summary>
    [Parameter] public List<ContactModel>? Contacts { get; set; }

    /// <summary>Raised after every Buffered mutation so the parent can
    /// re-render / persist. Not raised in Live mode (the reload handles
    /// re-rendering).</summary>
    [Parameter] public EventCallback ContactsChanged { get; set; }

    /// <summary>When true, disables the per-row Edit button. Used when the
    /// editor is nested inside another drawer (e.g. the draft-guardian
    /// edit form): the nested editor has no shared <c>DialogDrawer</c> to
    /// host a contact edit, so clicking Edit would silently no-op. Disabling
    /// the trigger removes the dead path while Add/Remove (which mutate
    /// <c>Contacts</c> directly or open <c>ContactChangeDialog</c>) still
    /// work. Default false.</summary>
    [Parameter] public bool EditDisabled { get; set; }

    private List<ContactDto> _contacts = new();
    private HashSet<Guid> _subscribed = new();
    private bool _loading;
    private bool _adding;
    private string? _error;
    private Guid? _loadedOwnerId;

    // Cancellation: separate CTSes for loads and mutations (Live mode only).
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _mutationCts = new();
    private volatile bool _disposed;
    private CancellationToken LoadToken => _loadCts?.Token ?? CancellationToken.None;
    private CancellationToken MutationToken => _mutationCts?.Token ?? CancellationToken.None;

    // Shared add-row form state.
    private ContactChannel _newChannel = ContactChannel.Email;
    private Guid? _newCountryCodeId;
    private CodedValueDto[]? _countryCodeOptions;
    private string _newValue = string.Empty;
    private string _newLabel = string.Empty;

    // Edit state. Buffered mode publishes the edit form up to the host
    // (StudentFormFields → StudentEditDialog) which renders it inside the
    // shared DialogDrawer. The fragment captures _editChannel / _editValue /
    // _editLabel / _editCountryCodeId via closure so the host is just chrome;
    // the editor remains the owner of the working copy.
    private Guid? _editingContactKey;
    private ContactChannel _editChannel = ContactChannel.Email;
    private Guid? _editCountryCodeId;
    private string _editValue = string.Empty;
    private string _editLabel = string.Empty;

    private string ValuePlaceholder => _newChannel switch
    {
        ContactChannel.SMS => "Phone number…",
        ContactChannel.WhatsApp => "WhatsApp number…",
        _ => "Email address…"
    };

    private string EditValuePlaceholder => _editChannel switch
    {
        ContactChannel.SMS => "Phone number…",
        ContactChannel.WhatsApp => "WhatsApp number…",
        _ => "Email address…"
    };

    /// <summary>Channel-aware label text for the value field on the Add form
    /// (used as <c>&lt;FormRow Label="..."&gt;</c>). Mirrors the placeholder
    /// so the label and placeholder use the same wording per channel.</summary>
    private string ValueLabel => _newChannel switch
    {
        ContactChannel.SMS => "Phone number",
        ContactChannel.WhatsApp => "WhatsApp number",
        _ => "Email address"
    };

    /// <summary>Channel-aware label text for the value field on the focused
    /// Edit form. See <see cref="ValueLabel"/>.</summary>
    private string EditValueLabel => _editChannel switch
    {
        ContactChannel.SMS => "Phone number",
        ContactChannel.WhatsApp => "WhatsApp number",
        _ => "Email address"
    };

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _mutationCts?.Cancel();
        _mutationCts?.Dispose();
        _mutationCts = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Mode == EditorMode.Live)
        {
            // Reload whenever the owner changes (e.g. navigating between
            // students that reuse the same component instance).
            if (_loadedOwnerId != OwnerId)
            {
                _loadedOwnerId = OwnerId;
                await LoadAsync();
            }
        }
        // Buffered mode: nothing to load — the parent owns the list.

        // Focused Edit view: initialize the working copy from the host's
        // InitialEditKey (or reset to a blank add form when IsAdd).
        if (View == ContactsView.Edit)
        {
            await InitializeEditViewAsync();
        }
    }

    /// <summary>Initializes the focused per-item edit form (View="Edit")
    /// from <see cref="InitialEditKey"/> / <see cref="IsAdd"/>. Called on
    /// every parameter set so the drawer re-initializes when the host opens
    /// it for a different contact or for a new add.</summary>
    private async Task InitializeEditViewAsync()
    {
        if (IsAdd)
        {
            ResetAddForm();
            _editingContactKey = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (InitialEditKey is not { } key)
        {
            // No target: nothing to edit.
            _editingContactKey = null;
            return;
        }

        var row = RowSource.FirstOrDefault(x => x.Key == key);
        if (row is null)
        {
            _editingContactKey = null;
            return;
        }

        _editingContactKey = row.Key;
        _editChannel = row.Channel;
        _editValue = row.Value;
        _editLabel = row.Label ?? string.Empty;

        if (_editChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
        {
            await LoadCountryCodesAsync();
        }

        _editCountryCodeId = row.CountryCode is { } code && _countryCodeOptions is not null
            ? _countryCodeOptions.FirstOrDefault(x => x.Name == code)?.Id
            : null;

        await InvokeAsync(StateHasChanged);
    }

    // ─── Unified row view for rendering ────────────────────────────────
    // Both ContactDto (Live) and ContactModel (Buffered) project into this
    // so the @foreach markup is shared. The action handlers map the Key
    // back to the underlying object per mode.
    private sealed record ContactRow(
        Guid Key,
        ContactChannel Channel,
        string Value,
        string? Label,
        string? CountryCode,
        bool IsPreferred,
        bool IsVerified,
        int Order);

    private List<ContactRow> RowSource
    {
        get
        {
            if (Mode == EditorMode.Buffered)
            {
                var list = Contacts ?? new List<ContactModel>();
                return list.OrderBy(x => x.Order)
                           .Select(x => new ContactRow(
                               x.TempId, x.Channel, x.Value, x.Label,
                               x.CountryCode, x.Order == 0, false, x.Order))
                           .ToList();
            }
            return _contacts.Select(x => new ContactRow(
                               x.Id, x.Channel, x.Value, x.Label,
                               x.CountryCode, x.DisplayOrder == 0, x.IsVerified,
                               x.DisplayOrder))
                            .ToList();
        }
    }

    private bool IsFirst(ContactRow c)
    {
        var rows = RowSource;
        return rows.Count > 0 && rows[0].Key == c.Key;
    }

    private bool IsLast(ContactRow c)
    {
        var rows = RowSource;
        return rows.Count > 0 && rows[^1].Key == c.Key;
    }

    // ─── Live-mode load ────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        var previousCts = _loadCts;
        var cts = new CancellationTokenSource();
        _loadCts = cts;
        var ct = cts.Token;
        var superseded = false;

        _loading = true;
        _error = null;
        try
        {
            var contacts = await Api.ListContactsAsync(OwnerType, OwnerId, ct);
            ct.ThrowIfCancellationRequested();
            _contacts = contacts?.ToList() ?? new List<ContactDto>();

            if (ShowSubscription)
            {
                var subscribed = await Api.ListSubscribedContactsAsync(OwnerType, OwnerId, ct: ct);
                ct.ThrowIfCancellationRequested();
                _subscribed = new HashSet<Guid>(subscribed?.Select(s => s.Id) ?? []);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load contacts for {OwnerType} {OwnerId}", OwnerType, OwnerId);
            _error = ex.Message;
            _contacts = new List<ContactDto>();
        }
        finally
        {
            superseded = !ReferenceEquals(_loadCts, cts);
            cts.Dispose();
            previousCts?.Dispose();
        }

        if (superseded || _disposed) return;
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    // ─── Shared add-row helpers ────────────────────────────────────────
    private async Task OnChannelChanged()
    {
        if (_newChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
        {
            await LoadCountryCodesAsync();
        }
        else
        {
            _newCountryCodeId = null;
        }
    }

    private async Task LoadCountryCodesAsync()
    {
        if (_countryCodeOptions is not null) return;
        try
        {
            var token = Mode == EditorMode.Live ? MutationToken : CancellationToken.None;
            _countryCodeOptions = await CodedValuesApi.GetChildrenByParentCodeAsync(
                CodedValueParent.CountryCallingCodes.ToCode(), token) ?? [];

            _newCountryCodeId ??= _countryCodeOptions
                .FirstOrDefault(x => x.Code.Equals("CNCODES_GHA", StringComparison.OrdinalIgnoreCase))?.Id
                ?? _countryCodeOptions.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load country calling codes");
            _error = "Could not load country codes.";
        }
    }

    private string? ResolveCountryCode()
    {
        if (_newCountryCodeId is null || _countryCodeOptions is null) return null;
        var selected = _countryCodeOptions.FirstOrDefault(x => x.Id == _newCountryCodeId);
        return selected?.Name;
    }

    // ─── Add ───────────────────────────────────────────────────────────
    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newValue)) return;

        var countryCode = _newChannel is ContactChannel.SMS or ContactChannel.WhatsApp
            ? ResolveCountryCode()
            : null;

        if (Mode == EditorMode.Buffered)
        {
            var list = Contacts ??= new List<ContactModel>();
            list.Add(new ContactModel
            {
                Channel = _newChannel,
                Value = _newValue.Trim(),
                Label = string.IsNullOrWhiteSpace(_newLabel) ? null : _newLabel.Trim(),
                CountryCode = countryCode,
                // Append at the tail (Order = current count). The first
                // added contact is Order 0 = preferred.
                Order = list.Count
            });
            ResetAddForm();
            await NotifyChangedAsync();
            return;
        }

        // Live mode
        _adding = true;
        _error = null;
        try
        {
            await Api.AddContactAsync(new AddContactRequest(
                OwnerType, OwnerId, _newChannel, _newValue.Trim(),
                string.IsNullOrWhiteSpace(_newLabel) ? null : _newLabel.Trim())
                { CountryCode = countryCode, DisplayOrder = _contacts.Count }, MutationToken);
            ResetAddForm();
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to add contact for {OwnerType} {OwnerId}", OwnerType, OwnerId);
            _error = ex.Message;
        }
        finally
        {
            _adding = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetAddForm()
    {
        _newValue = string.Empty;
        _newLabel = string.Empty;
        _newChannel = ContactChannel.Email;
        _newCountryCodeId = null;
    }

    // ─── Edit / Remove ─────────────────────────────────────────
    // Buffered mode opens a SideDrawer (embedded in the dialog content) for
    // the single-contact edit. Live mode keeps the ContactChangeDialog because
    // per-edit contact audit requires a reason.
    private Task OnEditAsync(ContactRow row)
    {
        if (Mode == EditorMode.Live)
        {
            return OpenEditDialogAsync(row);
        }

        return StartInlineEditAsync(row);
    }

    private async Task StartInlineEditAsync(ContactRow row)
    {
        _editingContactKey = row.Key;
        _editChannel = row.Channel;
        _editValue = row.Value;
        _editLabel = row.Label ?? string.Empty;

        if (_editChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
        {
            await LoadCountryCodesAsync();
        }

        _editCountryCodeId = row.CountryCode is { } code && _countryCodeOptions is not null
            ? _countryCodeOptions.FirstOrDefault(x => x.Name == code)?.Id
            : null;

        // The per-row edit form renders inline in the Edit view above;
        // nothing is published up to the host.
        await InvokeAsync(StateHasChanged);
    }


    /// <summary>Reacts to a channel change in the inline per-row edit form.
    /// Loads the country calling codes on demand when entering SMS / WhatsApp
    /// and clears a stale country-code selection when leaving them so it does
    /// not leak into the saved contact. No re-publish is needed: the inline
    /// form is plain Razor markup and re-renders reactively.</summary>
    private async Task OnInlineEditChannelChanged()
    {
        if (_editChannel is ContactChannel.SMS or ContactChannel.WhatsApp)
        {
            if (_countryCodeOptions is null) await LoadCountryCodesAsync();
        }
        else
        {
            _editCountryCodeId = null;
        }
    }

    private async Task OpenEditDialogAsync(ContactRow row)
    {
        var result = await DialogService.ShowShellDialogAsync<ContactChangeDialog, ContactChangeModel, ContactChangeResult>(
            new ContactChangeModel(row.Key, row.Channel, row.Value, row.Label, row.CountryCode, ContactChangeMode.Edit),
            "Edit contact",
            DialogSize.Medium);

        if (result is null) return;

        if (Mode == EditorMode.Buffered)
        {
            var list = Contacts;
            if (list is null) return;
            var target = list.FirstOrDefault(x => x.TempId == row.Key);
            if (target is null) return;
            target.Channel = result.Channel ?? target.Channel;
            target.Value = result.Value ?? target.Value;
            target.Label = result.Label;
            target.CountryCode = result.CountryCode;
            await NotifyChangedAsync();
            return;
        }

        _error = null;
        try
        {
            await Api.UpdateContactAsync(row.Key, new UpdateContactRequest(
                result.Value!,
                result.Label,
                result.Reason)
            { CountryCode = result.CountryCode }, MutationToken);
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to update contact {ContactId}", row.Key);
            _error = ex.Message;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editingContactKey is null) return;

        var key = _editingContactKey.Value;
        var countryCode = _editCountryCodeId is { } id && _countryCodeOptions is not null
            ? _countryCodeOptions.FirstOrDefault(x => x.Id == id)?.Name
            : null;

        if (Mode == EditorMode.Buffered)
        {
            var list = Contacts;
            if (list is not null)
            {
                var target = list.FirstOrDefault(x => x.TempId == key);
                if (target is not null)
                {
                    target.Channel = _editChannel;
                    target.Value = _editValue.Trim();
                    target.Label = string.IsNullOrWhiteSpace(_editLabel) ? null : _editLabel.Trim();
                    target.CountryCode = countryCode;
                    await NotifyChangedAsync();
                }
            }
        }

        await EndInlineEditAsync();
    }

    /// <summary>Public entry point invoked by the shared
    /// <c>DialogDrawer</c>'s Cancel button (× / backdrop / Escape
    /// arrive via the host clearing the edit context, which calls this).
    /// Discards the working copy and tears down the edit state.</summary>
    public Task CancelInlineEditAsync() => EndInlineEditAsync();

    /// <summary>Public entry point invoked by the shared
    /// <c>DialogDrawer</c>'s Submit button. Applies the edit to the
    /// in-memory list (Buffered mode) and tears down the edit state.
    /// Returns <c>true</c> so the drawer auto-closes on success.</summary>
    public async Task<bool> SubmitInlineEditAsync()
    {
        await SaveEditAsync();
        return true;
    }

    private async Task EndInlineEditAsync()
    {
        _editingContactKey = null;
        _editChannel = ContactChannel.Email;
        _editValue = string.Empty;
        _editLabel = string.Empty;
        _editCountryCodeId = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>FluentButton-friendly wrapper around
    /// <see cref="SubmitInlineEditAsync"/> (discards the <c>bool</c> return
    /// the drawer footer needed). Used by the inline Save button.</summary>
    private async Task SaveInlineEditAsync() => await SubmitInlineEditAsync();

    private async Task OnRemoveAsync(ContactRow row)
    {
        // Buffered mode (student dialog): remove directly, no audit dialog.
        // Live mode keeps the ContactChangeDialog because per-edit contact
        // audit requires a reason.
        if (Mode == EditorMode.Buffered)
        {
            var list = Contacts;
            if (list is null) return;
            var target = list.FirstOrDefault(x => x.TempId == row.Key);
            if (target is null) return;
            list.Remove(target);
            RestampOrders(list);
            await NotifyChangedAsync();
            return;
        }

        var result = await DialogService.ShowShellDialogAsync<ContactChangeDialog, ContactChangeModel, ContactChangeResult>(
            new ContactChangeModel(row.Key, row.Channel, row.Value, row.Label, row.CountryCode, ContactChangeMode.Delete),
            "Delete contact",
            DialogSize.Small);

        if (result is null) return;

        _error = null;
        try
        {
            await Api.DeleteContactAsync(row.Key, result.Reason, MutationToken);
            _subscribed.Remove(row.Key);
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to remove contact {ContactId}", row.Key);
            _error = ex.Message;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    // ─── Reorder (move-up / move-down) ─────────────────────────────────
    private async Task MoveUpAsync(Guid key)
    {
        if (Mode == EditorMode.Buffered)
        {
            var list = Contacts;
            if (list is null) return;
            var ordered = list.OrderBy(x => x.Order).ToList();
            var idx = ordered.FindIndex(x => x.TempId == key);
            if (idx <= 0) return;
            (ordered[idx - 1], ordered[idx]) = (ordered[idx], ordered[idx - 1]);
            RestampOrders(ordered);
            await NotifyChangedAsync();
            return;
        }

        var orderedIds = _contacts.Select(x => x.Id).ToList();
        var i = orderedIds.IndexOf(key);
        if (i <= 0) return;
        (orderedIds[i - 1], orderedIds[i]) = (orderedIds[i], orderedIds[i - 1]);
        await ReorderLiveAsync(orderedIds);
    }

    private async Task MoveDownAsync(Guid key)
    {
        if (Mode == EditorMode.Buffered)
        {
            var list = Contacts;
            if (list is null) return;
            var ordered = list.OrderBy(x => x.Order).ToList();
            var idx = ordered.FindIndex(x => x.TempId == key);
            if (idx < 0 || idx >= ordered.Count - 1) return;
            (ordered[idx + 1], ordered[idx]) = (ordered[idx], ordered[idx + 1]);
            RestampOrders(ordered);
            await NotifyChangedAsync();
            return;
        }

        var orderedIds = _contacts.Select(x => x.Id).ToList();
        var i = orderedIds.IndexOf(key);
        if (i < 0 || i >= orderedIds.Count - 1) return;
        (orderedIds[i + 1], orderedIds[i]) = (orderedIds[i], orderedIds[i + 1]);
        await ReorderLiveAsync(orderedIds);
    }

    private async Task ReorderLiveAsync(IReadOnlyList<Guid> orderedIds)
    {
        _error = null;
        try
        {
            await Api.ReorderContactsAsync(OwnerType, OwnerId, orderedIds, MutationToken);
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reorder contacts for {OwnerType} {OwnerId}", OwnerType, OwnerId);
            _error = ex.Message;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    // ─── Live-only: verify + subscribe ─────────────────────────────────
    private async Task VerifyAsync(Guid id)
    {
        _error = null;
        try
        {
            await Api.VerifyContactAsync(id, MutationToken);
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to verify contact {ContactId}", id);
            _error = ex.Message;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleSubscribeAsync(Guid id, bool subscribe)
    {
        _error = null;
        try
        {
            if (subscribe)
                await Api.SubscribeAsync(id, ct: MutationToken);
            else
                await Api.UnsubscribeAsync(id, ct: MutationToken);

            if (subscribe) _subscribed.Add(id); else _subscribed.Remove(id);
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to toggle subscription for contact {ContactId}", id);
            _error = ex.Message;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    // ─── Buffered helpers ──────────────────────────────────────────────
    private static void RestampOrders(List<ContactModel> ordered)
    {
        for (var i = 0; i < ordered.Count; i++) ordered[i].Order = i;
    }

    private async Task NotifyChangedAsync()
    {
        if (ContactsChanged.HasDelegate)
            await ContactsChanged.InvokeAsync();
        else
            await InvokeAsync(StateHasChanged);
    }

    // ─── Formatting ────────────────────────────────────────────────────
    private static string FormatRowValue(ContactRow c) => c.Channel switch
    {
        ContactChannel.SMS or ContactChannel.WhatsApp when !string.IsNullOrWhiteSpace(c.CountryCode)
            => $"{c.CountryCode} {c.Value}",
        _ => c.Value
    };

    private static string FormatCountryCodeOption(CodedValueDto o)
    {
        var country = o.Attributes.FirstOrDefault(a => a.Key == "COUNTRY")?.Value;
        return string.IsNullOrWhiteSpace(country) ? o.Name : $"{o.Name} ({country})";
    }

    private static string ChannelGlyph(ContactChannel channel) => channel switch
    {
        ContactChannel.Email => "✉",
        ContactChannel.SMS => "📱",
        ContactChannel.WhatsApp => "💬",
        _ => "•"
    };
}
