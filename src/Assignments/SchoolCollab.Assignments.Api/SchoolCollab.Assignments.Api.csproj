<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ServiceDefaults\SchoolCollab.ServiceDefaults\SchoolCollab.ServiceDefaults.csproj" />
    <ProjectReference Include="..\SchoolCollab.Assignments.Core\SchoolCollab.Assignments.Core.csproj" />
    <ProjectReference Include="..\..\Students\SchoolCollab.Students.Core\SchoolCollab.Students.Core.csproj" />
    <ProjectReference Include="..\..\Settings\SchoolCollab.Settings.Core\SchoolCollab.Settings.Core.csproj" />
    <ProjectReference Include="..\..\SchoolCollab.Core\SchoolCollab.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.RabbitMQ.Client" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <!-- WS-E1 (ar-14-deep-links): Redis-persisted DataProtection keyring shared with
         the Families host so it can unprotect mint-side deep-link tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- C3 certificate PDF rendering (Community license; pin 2026.8.0 in CPM). -->
    <PackageReference Include="QuestPDF" />
    <!-- R3 attachment text extraction (AttachmentTextExtractor, D1/D2/D8).
         "PdfPig" is the real UglyToad package id (Apache-2.0); the similarly-spelled
         "UglyToad.PdfPig" id is an unrelated placeholder — do not "correct" this. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>
</Project>