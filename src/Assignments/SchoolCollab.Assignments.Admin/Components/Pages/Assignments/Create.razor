@page "/assignments/create"
@using SchoolCollab.Assignments.Contracts
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject AssignmentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Create> Logger
@using SchoolCollab.Assignments.Admin.Helpers

<PageTitle>New Assignment</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentWizard StepperPosition="StepperPosition.Top"
                      StepSequence="WizardStepSequence.Visited"
                      Width="960px"
                      Height="auto"
                      @ref="_wizard"
                      @bind-Value="_stepIndex">
            <Steps>
                @* ── Step 1: Assignment Type, Grading Format, Target Audience ── *@
                <FluentWizardStep Label="Type &amp; Format"
                                  Summary="Choose type, grading, audience"
                                  IconPrevious="@(Icon.FromType<Icons.Filled.Size24.CheckmarkCircle>())"
                                  OnChange="OnStep1ChangingAsync">
                    <section class="wizard-section">
                        <div class="wizard-section-header">
                            <FluentIcon Value="@_typeSectionIcon" Color="@Color.Accent" />
                            <div>
                                <h3>Assignment Type</h3>
                                <p class="wizard-hint">How will this assignment be completed and submitted?</p>
                            </div>
                        </div>

                        <ul class="wizard-cards" role="radiogroup" aria-label="Assignment Type">
                            <li class="@GetCardClass(_selectedType == AssignmentTypeDto.Digital)"
                                @onclick="() => SelectType(AssignmentTypeDto.Digital)"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedType == AssignmentTypeDto.Digital)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_digitalIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(AssignmentTypeDto.Digital)</h4>
                                <p class="wizard-card-desc">Online MCQ or free-text response. Auto-graded or instant feedback.</p>
                            </li>

                            <li class="@GetCardClass(_selectedType == AssignmentTypeDto.SemiManual)"
                                @onclick="() => SelectType(AssignmentTypeDto.SemiManual)"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedType == AssignmentTypeDto.SemiManual)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_semiManualIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(AssignmentTypeDto.SemiManual)</h4>
                                <p class="wizard-card-desc">Computer-generated prompts with user-uploaded submissions.</p>
                            </li>

                            <li class="@GetCardClass(_selectedType == AssignmentTypeDto.Manual)"
                                @onclick="() => SelectType(AssignmentTypeDto.Manual)"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedType == AssignmentTypeDto.Manual)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_manualIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(AssignmentTypeDto.Manual)</h4>
                                <p class="wizard-card-desc">Instructions only. Students submit offline (printed, hand-written).</p>
                            </li>
                        </ul>
                    </section>

                    <section class="wizard-section">
                        <div class="wizard-section-header">
                            <FluentIcon Value="@_gradingSectionIcon" Color="@Color.Accent" />
                            <div>
                                <h3>Grading Format</h3>
                                <p class="wizard-hint">How should this assignment be graded?</p>
                            </div>
                        </div>

                        <ul class="wizard-cards" role="radiogroup" aria-label="Grading Format">
                            <li class="@GetCardClass(_selectedGradingFormat == GradingFormatDto.TeacherGraded)"
                                @onclick="() => _selectedGradingFormat = GradingFormatDto.TeacherGraded"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedGradingFormat == GradingFormatDto.TeacherGraded)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_teacherGradedIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(GradingFormatDto.TeacherGraded)</h4>
                                <p class="wizard-card-desc">Teacher reviews and assigns marks manually.</p>
                            </li>

                            <li class="@GetCardClass(_selectedGradingFormat == GradingFormatDto.AutoGraded)"
                                @onclick="() => _selectedGradingFormat = GradingFormatDto.AutoGraded"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedGradingFormat == GradingFormatDto.AutoGraded)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_autoGradedIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(GradingFormatDto.AutoGraded)</h4>
                                <p class="wizard-card-desc">System scores MCQ / structured answers automatically.</p>
                            </li>

                            <li class="@GetCardClass(_selectedGradingFormat == GradingFormatDto.InstantGraded)"
                                @onclick="() => _selectedGradingFormat = GradingFormatDto.InstantGraded"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedGradingFormat == GradingFormatDto.InstantGraded)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_instantGradedIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(GradingFormatDto.InstantGraded)</h4>
                                <p class="wizard-card-desc">Students see results immediately on submission.</p>
                            </li>
                        </ul>
                    </section>

                    <section class="wizard-section">
                        <div class="wizard-section-header">
                            <FluentIcon Value="@_audienceSectionIcon" Color="@Color.Accent" />
                            <div>
                                <h3>Target Audience</h3>
                                <p class="wizard-hint">Who is this assignment for?</p>
                            </div>
                        </div>

                        <ul class="wizard-cards" role="radiogroup" aria-label="Target Audience">
                            <li class="@GetCardClass(_selectedTargetAudience == TargetAudienceTypeDto.AllStudents)"
                                @onclick="() => _selectedTargetAudience = TargetAudienceTypeDto.AllStudents"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedTargetAudience == TargetAudienceTypeDto.AllStudents)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_allStudentsIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(TargetAudienceTypeDto.AllStudents)</h4>
                                <p class="wizard-card-desc">Available to every student in the subject.</p>
                            </li>

                            <li class="@GetCardClass(_selectedTargetAudience == TargetAudienceTypeDto.SelectedGrades)"
                                @onclick="() => _selectedTargetAudience = TargetAudienceTypeDto.SelectedGrades"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedTargetAudience == TargetAudienceTypeDto.SelectedGrades)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_selectedGradesIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(TargetAudienceTypeDto.SelectedGrades)</h4>
                                <p class="wizard-card-desc">Target specific grade levels or classes.</p>
                            </li>

                            <li class="@GetCardClass(_selectedTargetAudience == TargetAudienceTypeDto.SelectedGroups)"
                                @onclick="() => _selectedTargetAudience = TargetAudienceTypeDto.SelectedGroups"
                                @onkeydown="OnCardKeydown"
                                role="radio" tabindex="0"
                                aria-checked="@(_selectedTargetAudience == TargetAudienceTypeDto.SelectedGroups)">
                                <div class="wizard-card-check">
                                    <FluentIcon Value="@_checkmarkIcon" Color="@Color.Accent" />
                                </div>
                                <div class="wizard-card-icon">
                                    <FluentIcon Value="@_selectedGroupsIcon" />
                                </div>
                                <h4>@EnumHelper.GetDescription(TargetAudienceTypeDto.SelectedGroups)</h4>
                                <p class="wizard-card-desc">Assign to specific student groups or sections.</p>
                            </li>
                        </ul>
                    </section>

                    @if (!string.IsNullOrEmpty(_step1Error))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_step1Error</FluentMessageBar>
                    }
                </FluentWizardStep>

                @* ── Step 2: Title, Description, Due Date, Max Score ── *@
                <FluentWizardStep Label="Details"
                                  Summary="Title, date, score"
                                  IconPrevious="@(Icon.FromType<Icons.Filled.Size24.CheckmarkCircle>())">
                    <section class="wizard-section">
                        <div class="wizard-section-header">
                            <FluentIcon Value="@_detailsSectionIcon" Color="@Color.Accent" />
                            <div>
                                <h3>Assignment Details</h3>
                                <p class="wizard-hint">Provide the basic information for this assignment.</p>
                            </div>
                        </div>

                        <FluentEditForm Model="_model" class="wizard-form">
                            <FluentTextField @bind-Value="_model.Title" Label="Title *" Placeholder="e.g. Chapter 5 Quiz" class="full-width mb-4" Required />
                            <FluentTextArea @bind-Value="_model.Description" Label="Description" Rows="4" Placeholder="Assignment instructions…" class="full-width mb-4" />

                            <FluentStack Orientation="Orientation.Horizontal" class="mb-4">
                                <FluentDatePicker @bind-Value="_model.DueDate" Label="Due Date" style="flex:1" />
                                <FluentNumberField @bind-Value="_model.MaxScore" Label="Max Score" style="flex:1; margin-left:1rem" />
                            </FluentStack>
                        </FluentEditForm>
                    </section>
                </FluentWizardStep>

                @* ── Step 3: Review & Submit ── *@
                <FluentWizardStep Label="Review"
                                  Summary="Verify and submit"
                                  IconPrevious="@(Icon.FromType<Icons.Filled.Size24.CheckmarkCircle>())"
                                  DeferredLoading="true">
                    <section class="wizard-section">
                        <div class="wizard-section-header">
                            <FluentIcon Value="@_reviewSectionIcon" Color="@Color.Accent" />
                            <div>
                                <h3>Review &amp; Submit</h3>
                                <p class="wizard-hint">Verify the details before creating this assignment.</p>
                            </div>
                        </div>

                        <div class="review-card">
                            <div class="review-grid">
                                <div class="review-row">
                                    <span class="review-label">Type</span>
                                    <FluentBadge Appearance="Appearance.Accent">@EnumHelper.GetDescription(_selectedType.Value)</FluentBadge>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Grading</span>
                                    <FluentBadge Appearance="Appearance.Lightweight">@EnumHelper.GetDescription(_selectedGradingFormat)</FluentBadge>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Audience</span>
                                    <FluentBadge Appearance="Appearance.Lightweight">@EnumHelper.GetDescription(_selectedTargetAudience)</FluentBadge>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Title</span>
                                    <span class="review-value">@_model.Title</span>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Description</span>
                                    <span class="review-value">@(string.IsNullOrWhiteSpace(_model.Description) ? "—" : _model.Description)</span>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Due Date</span>
                                    <span class="review-value">@(_model.DueDate?.ToString("g") ?? "—")</span>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Max Score</span>
                                    <span class="review-value">@(_model.MaxScore?.ToString("0.##") ?? "—")</span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" class="mt-3 mb-3">@_error</FluentMessageBar>
                        }
                    </section>
                </FluentWizardStep>
            </Steps>

            <ButtonTemplate Context="stepIndex">
                <div class="wizard-actions">
                    @if (stepIndex > 0)
                    {
                        <FluentButton Appearance="Appearance.Neutral"
                                      Icon="@(Icon.FromType<Icons.Regular.Size20.ArrowLeft>())"
                                      OnClick="@(() => _wizard.GoToStepAsync(stepIndex - 1, false))">
                            Back
                        </FluentButton>
                    }

                    <span style="flex:1"></span>

                    <FluentButton Appearance="Appearance.Outline" OnClick="Cancel">Cancel</FluentButton>

                    @if (stepIndex < 2)
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      Icon="@(Icon.FromType<Icons.Regular.Size20.ArrowRight>())"
                                      OnClick="@(() => _wizard.GoToStepAsync(stepIndex + 1))"
                                      class="ms-2">
                            Continue
                        </FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      Icon="@(Icon.FromType<Icons.Regular.Size20.Save>())"
                                      Disabled="@_saving" OnClick="SubmitAsync"
                                      class="ms-2">
                            @(_saving ? "Saving…" : "Save as Draft")
                        </FluentButton>
                    }
                </div>
            </ButtonTemplate>
        </FluentWizard>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private static readonly Icon _digitalIcon = Icon.FromType<Icons.Regular.Size24.PhoneLaptop>();
    private static readonly Icon _semiManualIcon = Icon.FromType<Icons.Regular.Size24.DocumentEdit>();
    private static readonly Icon _manualIcon = Icon.FromType<Icons.Regular.Size24.Document>();
    private static readonly Icon _teacherGradedIcon = Icon.FromType<Icons.Regular.Size24.Person>();
    private static readonly Icon _autoGradedIcon = Icon.FromType<Icons.Regular.Size24.CheckmarkCircle>();
    private static readonly Icon _instantGradedIcon = Icon.FromType<Icons.Regular.Size24.Flash>();
    private static readonly Icon _allStudentsIcon = Icon.FromType<Icons.Regular.Size24.People>();
    private static readonly Icon _selectedGradesIcon = Icon.FromType<Icons.Regular.Size24.Organization>();
    private static readonly Icon _selectedGroupsIcon = Icon.FromType<Icons.Regular.Size24.PeopleTeam>();
    private static readonly Icon _checkmarkIcon = Icon.FromType<Icons.Regular.Size20.CheckmarkCircle>();
    private static readonly Icon _typeSectionIcon = Icon.FromType<Icons.Regular.Size24.Document>();
    private static readonly Icon _gradingSectionIcon = Icon.FromType<Icons.Regular.Size24.CheckmarkCircle>();
    private static readonly Icon _audienceSectionIcon = Icon.FromType<Icons.Regular.Size24.People>();
    private static readonly Icon _detailsSectionIcon = Icon.FromType<Icons.Regular.Size24.DocumentEdit>();
    private static readonly Icon _reviewSectionIcon = Icon.FromType<Icons.Regular.Size24.Eye>();

    private FluentWizard? _wizard;
    private int _stepIndex;
    private readonly FormModel _model = new();
    private bool _saving;
    private string? _error;
    private string? _step1Error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private AssignmentTypeDto? _selectedType;
    private GradingFormatDto _selectedGradingFormat = GradingFormatDto.TeacherGraded;
    private TargetAudienceTypeDto _selectedTargetAudience = TargetAudienceTypeDto.AllStudents;

    private string GetCardClass(bool isSelected) => isSelected ? "wizard-card selected" : "wizard-card";

    private void SelectType(AssignmentTypeDto type)
    {
        _selectedType = type;
        _step1Error = null;
    }

    private void OnCardKeydown(KeyboardEventArgs e)
    {
        // @onclick on the <li> already handles selection.
        // This ensures keyboard activation works for role="radio".
    }

    private Task OnStep1ChangingAsync(FluentWizardStepChangeEventArgs args)
    {
        if (_selectedType is null)
        {
            args.IsCancelled = true;
            _step1Error = "Please select an assignment type before continuing.";
        }
        else
        {
            _step1Error = null;
        }

        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        _loadCts ??= new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            if (_selectedType is null)
            {
                _error = "Assignment Type is required.";
                return;
            }

            Logger.LogInformation("User initiated create for assignment {Title}", _model.Title);

            var req = new CreateAssignmentRequest(
                _model.Title!,
                _model.Description,
                _selectedType.Value,
                _selectedGradingFormat,
                _selectedTargetAudience,
                _model.SubjectCodedValueId,
                _model.GradeCodedValueId,
                _model.DueDate.HasValue ? new DateTimeOffset(_model.DueDate.Value, TimeSpan.Zero) : null,
                _model.MaxScore);

            await Api.CreateAsync(req, ct);
            Nav.NavigateTo("/assignments");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create assignment {Title}", _model.Title);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/assignments");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Title { get; set; }

        public string? Description { get; set; }

        public DateTime? DueDate { get; set; }

        public decimal? MaxScore { get; set; }

        // Placeholder — will wire to CodedValues API in Phase 6
        public Guid SubjectCodedValueId { get; set; } = Guid.Empty;
        public Guid? GradeCodedValueId { get; set; }
    }
}