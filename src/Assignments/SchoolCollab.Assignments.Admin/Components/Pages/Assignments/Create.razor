@page "/assignments/create"
@using SchoolCollab.Assignments.Admin.Services
@using SchoolCollab.CodedValues.Admin.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject AssignmentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject NavigationManager Nav
@inject ILogger<Create> Logger
@implements IDisposable

<PageTitle>New Assignment</PageTitle>

<ErrorBoundary>
    <ChildContent>
        @if (_loadingLookups)
        {
            <FluentProgressRing />
        }
        else
        {
            <div class="wizard-container">
                <h2>New Assignment</h2>

                @* Step indicator *@
                <div class="stepper">
                    @for (var i = 0; i < _stepLabels.Length; i++)
                    {
                        var step = i + 1;
                        var isActive = step == _currentStep;
                        var isCompleted = step < _currentStep;
                        <div class="stepper-step @GetStepCss(step)" @onclick="() => GoToStep(step)">
                            <div class="stepper-circle">
                                @if (isCompleted)
                                {
                                    <span style="color:var(--foreground-on-accent-rest);font-weight:700">✓</span>
                                }
                                else
                                {
                                    @step
                                }
                            </div>
                            <div class="stepper-label">@_stepLabels[i]</div>
                        </div>
                        @if (i < _stepLabels.Length - 1)
                        {
                            <div class="stepper-line @(_currentStep > step ? "completed" : "")"></div>
                        }
                    }
                </div>

                @* Step content *@
                <div class="step-content">
                    @if (_currentStep == 1)
                    {
                        <h3>Grade &amp; Subject</h3>
                        <p class="step-description">Select the grade and subject for this assignment.</p>

                        <FluentSelect TOption="CodedValueOption"
                                      Items="@_gradeOptions"
                                      @bind-SelectedOption="_selectedGrade"
                                      OptionText="@(o => o.Label)"
                                      OptionValue="@(o => o.Value)"
                                      Label="Grade *"
                                      class="full-width mb-3"
                                      Placeholder="Select a grade…" />

                        <FluentSelect TOption="CodedValueOption"
                                      Items="@_subjectOptions"
                                      @bind-SelectedOption="_selectedSubject"
                                      OptionText="@(o => o.Label)"
                                      OptionValue="@(o => o.Value)"
                                      Label="Subject *"
                                      class="full-width mb-3"
                                      Placeholder="Select a subject…" />

                        @if (_step1Error is not null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_step1Error</FluentMessageBar>
                        }
                    }
                    else if (_currentStep == 2)
                    {
                        <h3>Assignment Details</h3>
                        <p class="step-description">Add the assignment title, description, and other details.</p>

                        <FluentTextField @bind-Value="_model.Title" Label="Title *" Placeholder="e.g. Chapter 5 Quiz" class="full-width mb-3" />
                        <FluentTextArea @bind-Value="_model.Description" Label="Description / Instructions" Rows="4" class="full-width mb-3" />

                        <FluentSelect TOption="AssignmentTypeOption"
                                      Items="@_typeOptions"
                                      @bind-SelectedOption="_selectedType"
                                      OptionText="@(o => o.Label)"
                                      OptionValue="@(o => o.Value)"
                                      Label="Assignment Type *"
                                      class="full-width mb-3" />

                        <FluentStack Orientation="Orientation.Horizontal" Gap="16">
                            <FluentDatePicker @bind-Value="_model.DueDate" Label="Due Date" class="full-width mb-3" Style="flex:1" />
                            <FluentNumberField @bind-Value="_model.MaxScore" Label="Max Score" class="narrow-field mb-3" Style="flex:0 0 200px" />
                        </FluentStack>

                        @* Resource links *@
                        <h4 style="margin-top:0.5rem">Resource Links</h4>
                        <p class="step-description">Add optional links to resources (videos, articles, etc.).</p>
                        @for (var i = 0; i < _resourceLinks.Count; i++)
                        {
                            var idx = i;
                            <FluentStack Orientation="Orientation.Horizontal" Gap="8" class="mb-2">
                                <FluentTextField @bind-Value="_resourceLinks[idx].Label"
                                                 Label="Link Label"
                                                 Placeholder="e.g. Video tutorial"
                                                 Style="flex:1" />
                                <FluentTextField @bind-Value="_resourceLinks[idx].Url"
                                                 Label="URL"
                                                 Placeholder="https://..."
                                                 Style="flex:2" />
                                <FluentButton Appearance="Appearance.Outline"
                                              Icon="@(Icon.FromType<Icons.Regular.Size20.Delete>())"
                                              @onclick="() => RemoveResourceLink(idx)"
                                              aria-label="Remove link" />
                            </FluentStack>
                        }
                        <FluentButton Appearance="Appearance.Outline"
                                      Icon="@(Icon.FromType<Icons.Regular.Size20.Add>())"
                                      @onclick="AddResourceLink">
                            Add Link
                        </FluentButton>

                        @if (_step2Error is not null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_step2Error</FluentMessageBar>
                        }
                    }
                    else if (_currentStep == 3)
                    {
                        <h3>Questions &amp; Attachments</h3>
                        <p class="step-description">Add sample questions and/or attach files for this assignment.</p>

                        @* Questions *@
                        <h4 style="margin-top:0.5rem">Sample Questions</h4>
                        @for (var i = 0; i < _questions.Count; i++)
                        {
                            var idx = i;
                            <div class="question-card mb-3">
                                <FluentStack Orientation="Orientation.Horizontal" Gap="8" class="mb-2">
                                    <span class="question-number">Q@(idx + 1)</span>
                                    <FluentSelect TOption="QuestionTypeOption"
                                                  Items="@_questionTypeOptions"
                                                  @bind-SelectedOption="_questions[idx].SelectedType"
                                                  OptionText="@(o => o.Label)"
                                                  OptionValue="@(o => o.Value)"
                                                  Label="Type"
                                                  Style="min-width:160px" />
                                    <FluentButton Appearance="Appearance.Outline"
                                                  Icon="@(Icon.FromType<Icons.Regular.Size20.Delete>())"
                                                  @onclick="() => RemoveQuestion(idx)"
                                                  aria-label="Remove question" />
                                </FluentStack>
                                <FluentTextArea @bind-Value="_questions[idx].QuestionText"
                                                Label="Question Text *"
                                                Rows="2"
                                                class="full-width" />
                            </div>
                        }
                        <FluentButton Appearance="Appearance.Outline"
                                      Icon="@(Icon.FromType<Icons.Regular.Size20.Add>())"
                                      @onclick="AddQuestion">
                            Add Question
                        </FluentButton>

                        @* Attachments placeholder *@
                        <h4 style="margin-top:1.5rem">Attachments</h4>
                        <FluentMessageBar Intent="MessageIntent.Info">
                            File attachments will be available in a future update. For now, use Resource Links in Step 2 to share external files.
                        </FluentMessageBar>
                    }
                </div>

                @* Navigation buttons *@
                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_error</FluentMessageBar>
                }

                <div class="wizard-actions">
                    @if (_currentStep > 1)
                    {
                        <FluentButton Appearance="Appearance.Outline" @onclick="PreviousStep">
                            Back
                        </FluentButton>
                    }
                    <div class="spacer"></div>
                    <FluentButton Appearance="Appearance.Outline" @onclick="Cancel">Cancel</FluentButton>
                    @if (_currentStep < 3)
                    {
                        <FluentButton Appearance="Appearance.Accent" @onclick="NextStep" class="ms-2">
                            Next
                        </FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent" @onclick="SubmitAsync" Disabled="@_saving" class="ms-2">
                            @(_saving ? "Saving…" : "Save as Draft")
                        </FluentButton>
                    }
                </div>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private int _currentStep = 1;
    private readonly string[] _stepLabels = ["Grade & Subject", "Details", "Questions & Attachments"];
    private bool _loadingLookups = true;
    private bool _saving;
    private string? _error;
    private string? _step1Error;
    private string? _step2Error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private readonly FormModel _model = new();

    // Step 1 — CodedValues lookups
    private record CodedValueOption(string Value, string Label);
    private List<CodedValueOption> _gradeOptions = [];
    private List<CodedValueOption> _subjectOptions = [];
    private CodedValueOption? _selectedGrade;
    private CodedValueOption? _selectedSubject;

    // Step 2 — Assignment type
    private record AssignmentTypeOption(string Value, string Label);
    private readonly AssignmentTypeOption[] _typeOptions =
    [
        new(((int)AssignmentTypeDto.Digital).ToString(), "Digital"),
        new(((int)AssignmentTypeDto.SemiManual).ToString(), "Semi-Manual"),
        new(((int)AssignmentTypeDto.Manual).ToString(), "Manual")
    ];
    private AssignmentTypeOption? _selectedType;

    // Step 2 — Resource links
    private class ResourceLinkEntry { public string Label { get; set; } = ""; public string Url { get; set; } = ""; }
    private readonly List<ResourceLinkEntry> _resourceLinks = [];

    // Step 3 — Questions
    private record QuestionTypeOption(string Value, string Label);
    private readonly QuestionTypeOption[] _questionTypeOptions =
    [
        new("0", "Multiple Choice"),
        new("1", "True / False"),
        new("2", "Short Answer")
    ];

    private class QuestionEntry
    {
        public string? QuestionText { get; set; }
        public QuestionTypeOption? SelectedType { get; set; }
    }
    private readonly List<QuestionEntry> _questions = [];

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            Logger.LogInformation("Loading coded value lookups for assignment create");

            var subjectTask = CodedValuesApi.GetByCodeAsync("SUBJECT", ct: ct);
            var gradeTask = CodedValuesApi.GetByCodeAsync("GRADE", ct: ct);

            await Task.WhenAll(subjectTask, gradeTask);
            if (_disposed) return;

            var subjectRoot = subjectTask.Result;
            var gradeRoot = gradeTask.Result;

            // Load children of both roots in parallel
            if (subjectRoot is not null && gradeRoot is not null)
            {
                var subjectChildrenTask = CodedValuesApi.GetChildrenAsync(subjectRoot.Id, ct);
                var gradeChildrenTask = CodedValuesApi.GetChildrenAsync(gradeRoot.Id, ct);
                await Task.WhenAll(subjectChildrenTask, gradeChildrenTask);
                if (_disposed) return;

                var subjects = subjectChildrenTask.Result ?? [];
                var grades = gradeChildrenTask.Result ?? [];

                _subjectOptions = [.. subjects
                    .Where(s => !s.IsDisabled && !s.IsDeleted)
                    .OrderBy(s => s.DisplayOrder)
                    .Select(s => new CodedValueOption(s.Id.ToString(), s.Name))];

                _gradeOptions = [.. grades
                    .Where(g => !g.IsDisabled && !g.IsDeleted)
                    .OrderBy(g => g.DisplayOrder)
                    .Select(g => new CodedValueOption(g.Id.ToString(), g.Name))];
            }

            Logger.LogInformation("Loaded {SubjectCount} subjects and {GradeCount} grades",
                _subjectOptions.Count, _gradeOptions.Count);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load coded value lookups");
            _error = "Could not load grade and subject options. Please try again later.";
        }
        finally
        {
            if (!_disposed) _loadingLookups = false;
        }
    }

    private string GetStepCss(int step) =>
        step < _currentStep ? "completed" :
        step == _currentStep ? "active" : "";

    private void GoToStep(int step)
    {
        // Only allow going back to completed steps or current-1
        if (step < _currentStep)
            _currentStep = step;
    }

    private void PreviousStep() => _currentStep = Math.Max(1, _currentStep - 1);

    private void NextStep()
    {
        _step1Error = null;
        _step2Error = null;

        if (_currentStep == 1)
        {
            if (_selectedSubject is null)
            {
                _step1Error = "Subject is required.";
                return;
            }
            _model.SubjectCodedValueId = Guid.Parse(_selectedSubject.Value);
            _model.GradeCodedValueId = _selectedGrade is not null
                ? Guid.Parse(_selectedGrade.Value) : null;
            _currentStep = 2;
        }
        else if (_currentStep == 2)
        {
            if (string.IsNullOrWhiteSpace(_model.Title))
            {
                _step2Error = "Title is required.";
                return;
            }
            if (_selectedType is null)
            {
                _step2Error = "Assignment Type is required.";
                return;
            }
            _currentStep = 3;
        }
    }

    private void AddResourceLink() => _resourceLinks.Add(new ResourceLinkEntry());

    private void RemoveResourceLink(int idx) => _resourceLinks.RemoveAt(idx);

    private void AddQuestion() => _questions.Add(new() { SelectedType = _questionTypeOptions[0] });

    private void RemoveQuestion(int idx) => _questions.RemoveAt(idx);

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        _loadCts ??= new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            Logger.LogInformation("User initiated create for assignment {Title}", _model.Title);

            var req = new CreateAssignmentRequest(
                _model.Title!,
                _model.Description,
                (AssignmentTypeDto)int.Parse(_selectedType!.Value),
                _model.SubjectCodedValueId,
                _model.GradeCodedValueId,
                _model.DueDate.HasValue ? new DateTimeOffset(_model.DueDate.Value, TimeSpan.Zero) : null,
                _model.MaxScore);

            var assignmentId = await Api.CreateAsync(req, ct);

            Logger.LogInformation("Assignment {AssignmentId} created, questions will be added in future update", assignmentId);
            Nav.NavigateTo("/assignments");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create assignment {Title}", _model.Title);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/assignments");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Title { get; set; }

        public string? Description { get; set; }

        public DateTime? DueDate { get; set; }

        public decimal? MaxScore { get; set; }

        public Guid SubjectCodedValueId { get; set; } = Guid.Empty;
        public Guid? GradeCodedValueId { get; set; }
    }
}