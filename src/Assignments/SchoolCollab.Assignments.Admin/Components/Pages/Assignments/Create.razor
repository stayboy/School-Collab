@page "/assignments/create"
@using SchoolCollab.Assignments.Admin.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject AssignmentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Create> Logger
@implements IDisposable

<PageTitle>New Assignment</PageTitle>
<h2>New Assignment</h2>

<ErrorBoundary>
    <ChildContent>
        <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form-container">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <FluentTextField @bind-Value="_model.Title" Label="Title *" Placeholder="e.g. Chapter 5 Quiz" class="full-width mb-3" />
            <FluentTextArea @bind-Value="_model.Description" Label="Description" Rows="3" class="full-width mb-3" />

            <FluentSelect TOption="AssignmentTypeOption"
                           Items="@_typeOptions"
                           @bind-SelectedOption="_selectedType"
                           OptionText="@(o => o.Label)"
                           OptionValue="@(o => o.Value)"
                           Label="Assignment Type *"
                           class="full-width mb-3" />

            <FluentDatePicker @bind-Value="_model.DueDate" Label="Due Date" class="full-width mb-3" />
            <FluentNumberField @bind-Value="_model.MaxScore" Label="Max Score" class="narrow-field mb-3" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_error</FluentMessageBar>
            }

            <div>
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                    @(_saving ? "Saving…" : "Save as Draft")
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="ms-2">Cancel</FluentButton>
            </div>
        </EditForm>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private readonly FormModel _model = new();
    private bool _saving;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private record AssignmentTypeOption(string Value, string Label);
    private readonly AssignmentTypeOption[] _typeOptions =
    [
        new(((int)AssignmentTypeDto.Digital).ToString(), "Digital"),
        new(((int)AssignmentTypeDto.SemiManual).ToString(), "Semi-Manual"),
        new(((int)AssignmentTypeDto.Manual).ToString(), "Manual")
    ];
    private AssignmentTypeOption? _selectedType;

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        _loadCts ??= new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            if (_selectedType is null)
            {
                _error = "Assignment Type is required.";
                return;
            }

            Logger.LogInformation("User initiated create for assignment {Title}", _model.Title);

            var req = new CreateAssignmentRequest(
                _model.Title!,
                _model.Description,
                (AssignmentTypeDto)int.Parse(_selectedType!.Value),
                _model.SubjectCodedValueId,
                _model.GradeCodedValueId,
                _model.DueDate.HasValue ? new DateTimeOffset(_model.DueDate.Value, TimeSpan.Zero) : null,
                _model.MaxScore);

            await Api.CreateAsync(req, ct);
            Nav.NavigateTo("/assignments");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create assignment {Title}", _model.Title);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/assignments");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Title { get; set; }

        public string? Description { get; set; }

        public DateTime? DueDate { get; set; }

        public decimal? MaxScore { get; set; }

        // Placeholder — will wire to CodedValues API in Phase 6
        public Guid SubjectCodedValueId { get; set; } = Guid.Empty;
        public Guid? GradeCodedValueId { get; set; }
    }
}