@page "/assignments/{Id:guid}"
@using SchoolCollab.Assignments.Contracts
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Authoring
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Core.AssignmentPolicies
@using Microsoft.AspNetCore.Components.Authorization
@inject AssignmentsApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Detail> Logger
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

@*
    The assignment VIEW page (spec documents/specs/assignment-detail-view-modernization.md §4.1, §4.8,
    §4.9, §4.10; round plan P5/P5b/P7/P8) on the shared skeleton
    (documents/solution/panel-layout-pattern.md): ONE page action header owned by AuthoringShell, a
    `region-grid` of a main column and a rail, and one PanelSection per block. There is NO FluentTab
    anywhere in this page — the tabs produced the page-inside-a-page and are the regression this
    rewrite removes.

    The heading is the shell's `<h2 class="authoring-heading">` (R2): this page renders no `<h1>` and
    does not change shared chrome for one heading level.

    Main = Details · Questions · Delivery · Status; rail = Content & Resources · Rules, with Approval
    on a draft. Details embeds the authoring surface's read-only body (`Embedded`, R7/D2) and Questions
    is this page's own read-only table (P7); the Delivery/Targets block (P7), the Status panel (P8) and
    the three rail blocks (P5/P5b) complete the page.

    The rail blocks keep their FRAME while the main blocks do not (panel-layout-pattern §3/§6): a narrow
    column of unboxed blocks has no edge to read, so the box is the rail's, not the page's.
*@

<PageTitle>Assignment @_item?.Title</PageTitle>

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <div class="spinner-container">
                <FluentSpinner />
            </div>
        }
        else if (_item is null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">Assignment not found.</FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Outline" @onclick="Cancel" class="mt-2">Back to List</FluentButton>
        }
        else
        {
            @* P5b (extended, §2/§11): the header is STATUS-DRIVEN, not a constant — Draft → Publish,
               Scheduled → Unpublish, Closed → Archive, Published → `Open progress` (R1, disabled until
               round b ships the route), Archived → no primary at all. The chips ride LeadingActions,
               which is where a disabled primary's reason is read beside it (R1). *@
            <AuthoringShell Crumbs="@ShellCrumbs"
                           Title="@_item.Title"
                           Badge="@StatusBadge"
                           TitleMenu="@PageMenu"
                           LeadingActions="@HeaderChips"
                           PrimaryId="assignment-primary-action"
                           PrimaryLabel="@PrimaryLabel"
                           PrimaryDisabled="@PrimaryDisabled"
                           OnPrimaryAction="OnPrimaryActionAsync"
                           SecondaryActions="@SecondaryActions">
                <ChildContent>
                    @* The header fact row is presentation over the same summary DTO the authoring
                       read-out uses — at most four facts, never a second field-set definition (§4.1). *@
                    <p class="assignment-facts" id="assignment-facts">
                        @for (var index = 0; index < Facts.Count; index++)
                        {
                            if (index > 0)
                            {
                                <span class="assignment-facts__separator" aria-hidden="true">·</span>
                            }
                            <span class="assignment-facts__fact">@Facts[index]</span>
                        }
                    </p>

                    @if (!string.IsNullOrEmpty(_actionError))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-2" id="assignment-action-error">
                            @_actionError
                        </FluentMessageBar>
                    }

                    @* ONE region grid. Regions draw nothing: the single frame per block is the
                       PanelSection inside them (panel-layout-pattern §2, lesson L2). DOM order is main
                       then rail, which is also the collapsed order — the rail goes last. *@
                    <div class="region-grid-host">
                        <div class="region-grid">
                            <div class="region-grid__main">
                                @* R7/D2: the page owns the skeleton, so Details EMBEDS the authoring
                                   surface's read-only body instead of forking a second facts layout
                                   (NFR-4: one definition). `Embedded` strips the shell, the summary
                                   header, the questions hint and the targets accordion — Questions and
                                   Targets & Audience are this page's own blocks below. *@
                                <PanelSection Id="assignment-details"
                                              Title="Details"
                                              TitleId="assignment-details-title"
                                              ShowBorder="false">
                                    <HeaderActions>
                                        <FluentLink Id="assignment-details-edit"
                                                    Appearance="LinkAppearance.Default"
                                                    Href="@($"/assignments/{Id}/edit")">Edit ▸</FluentLink>
                                    </HeaderActions>
                                    <ChildContent>
                                        <AssignmentAuthoring Mode="AssignmentAuthoringMode.View"
                                                             Id="@Id"
                                                             Embedded="true" />
                                    </ChildContent>
                                </PanelSection>

                                @* The page's OWN questions block (P7/R7): read-only, four feasible
                                   columns, no points column. It reads the child set the page already
                                   loads — never a second read. *@
                                <QuestionsTable Questions="@_children?.Questions" />

                                <AudienceTable Model="@_audience" IsDraft="@IsDraft" LoadFailed="@_audienceLoadFailed" />

                                <StatusStrip Model="@StatusModel" />
                            </div>

                            @* The rail (panel-layout-pattern §5/§6): one FRAMED, collapsible panel
                               per RELATIONSHIP — Content & Resources, Rules, and Approval on a draft.
                               The frame is the rail's (§3): a narrow column of unboxed blocks reads as
                               one undifferentiated list. Collapsibility is the approved consent
                               checklist's per-panel YES for all three (2026-10-30), not a rail default. *@
                            <div class="region-grid__rail" id="assignment-rail">
                                <PanelSection Id="assignment-materials"
                                              Title="Content &amp; Resources"
                                              TitleId="assignment-materials-title"
                                              Count="@MaterialsCount"
                                              Collapsible="true">
                                    <HeaderActions>
                                        <FluentLink Id="assignment-materials-manage"
                                                    Appearance="LinkAppearance.Default"
                                                    Href="@($"/assignments/{Id}/edit")">Manage ▸</FluentLink>
                                    </HeaderActions>
                                    <ChildContent>
                                        @* No second read: these are the ATTACHMENTS and RESOURCES of the
                                           authoring child read the Questions table already consumes. *@
                                        @if (_children is null)
                                        {
                                            <p class="rail-empty" id="assignment-materials-unavailable">
                                                Materials could not be loaded. The rest of the page is unaffected.
                                            </p>
                                        }
                                        else if (MaterialsCount == 0)
                                        {
                                            <p class="rail-empty" id="assignment-materials-empty">No materials yet.</p>
                                        }
                                        else
                                        {
                                            <ul class="materials-list" id="assignment-materials-list">
                                                @foreach (var attachment in _children.Attachments)
                                                {
                                                    <li class="materials-row" @key="attachment.Id">
                                                        <FluentIcon Value="@AttachmentIcon(attachment.ContentType)"
                                                                    aria-hidden="true" />
                                                        <span class="materials-row__name" title="@attachment.FileName">@attachment.FileName</span>
                                                        <span class="materials-row__meta">@GroundingText(attachment)</span>
                                                    </li>
                                                }
                                                @* Resources are references, not uploads: the payload carries
                                                   no extraction outcome for them, so the row is a link and
                                                   nothing is invented to fill a grounding line. *@
                                                @foreach (var resource in _children.Resources)
                                                {
                                                    <li class="materials-row" @key="resource.Id">
                                                        <FluentIcon Value="@FluentIcons.Link" aria-hidden="true" />
                                                        <span class="materials-row__name">
                                                            @if (!string.IsNullOrWhiteSpace(resource.Url))
                                                            {
                                                                <FluentLink Appearance="LinkAppearance.Default"
                                                                            Href="@resource.Url">@ResourceName(resource)</FluentLink>
                                                            }
                                                            else
                                                            {
                                                                @ResourceName(resource)
                                                            }
                                                        </span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </ChildContent>
                                </PanelSection>

                                @* One row per REAL `EffectiveAssignmentPolicy` field. The approved mock
                                   drew two literal rule sentences and a "5 slots · 20,000 chars each"
                                   line; no field backs either, so both are dropped (recorded in the
                                   round doc's dropped-mock-row account) rather than invented here. *@
                                <PanelSection Id="assignment-rules"
                                              Title="Rules"
                                              TitleId="assignment-rules-title"
                                              Collapsible="true">
                                    <ChildContent>
                                        @if (_policy is null)
                                        {
                                            <p class="rail-empty" id="assignment-rules-unavailable">Policy unavailable.</p>
                                        }
                                        else
                                        {
                                            <dl class="rules-list" id="assignment-rules-list">
                                                @foreach (var rule in PolicyRows)
                                                {
                                                    <div class="rules-row" @key="rule.Label">
                                                        <dt class="rules-row__label">@rule.Label</dt>
                                                        <dd class="rules-row__value">
                                                            @rule.Value
                                                            @if (rule.FromOverride)
                                                            {
                                                                <span class="rules-row__override"> (override)</span>
                                                            }
                                                        </dd>
                                                    </div>
                                                }
                                            </dl>
                                        }
                                    </ChildContent>
                                </PanelSection>

                                @* R4: the decisions are BODY buttons (US6 — the decision lives with the
                                   content), never header buttons. Pre-publish only: Approval joins the
                                   rail on a Draft and leaves it once the assignment is out. *@
                                @if (ShowsApprovalPanel)
                                {
                                    <PanelSection Id="assignment-approval"
                                                  Title="Approval"
                                                  TitleId="assignment-approval-title"
                                                  Collapsible="true">
                                        <ChildContent>
                                            @if (_item.ApprovalStatus == ApprovalStatusDto.Pending)
                                            {
                                                <div class="approval-actions" id="assignment-approval-actions">
                                                    <FluentButton Appearance="ButtonAppearance.Primary"
                                                                  Disabled="@_actingOnApproval"
                                                                  OnClick="OnApproveAsync">
                                                        @(_actingOnApproval ? "Working…" : "Approve")
                                                    </FluentButton>
                                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                                  Disabled="@_actingOnApproval"
                                                                  OnClick="OnRejectAsync">Reject…</FluentButton>
                                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                                  Disabled="@_actingOnApproval"
                                                                  OnClick="OnDenyAsync"
                                                                  Title="Deny — terminal; the author must duplicate the assignment to continue">Deny…</FluentButton>
                                                </div>
                                                <p class="rail-empty" id="assignment-approval-hint">Reject and Deny ask for a reason.</p>
                                            }
                                            else if (_item.ApprovalStatus == ApprovalStatusDto.Approved)
                                            {
                                                <p class="approval-state" id="assignment-approval-approved">Approval ✓ approved</p>
                                            }
                                            else if (_item.ApprovalStatus == ApprovalStatusDto.Denied)
                                            {
                                                <p class="approval-state" id="assignment-approval-denied">
                                                    Approval denied — the author must duplicate the assignment to continue.
                                                </p>
                                            }
                                            else
                                            {
                                                <FluentButton Appearance="ButtonAppearance.Primary"
                                                              Disabled="@_submittingForApproval"
                                                              OnClick="OnSubmitForApprovalAsync">
                                                    @(_submittingForApproval ? "Submitting…" : "Submit for approval")
                                                </FluentButton>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(_item.ApprovalReason))
                                            {
                                                <p class="rail-empty" id="assignment-approval-reason">Reason: @_item.ApprovalReason</p>
                                            }
                                            @if (!string.IsNullOrEmpty(_approvalError))
                                            {
                                                <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-2"
                                                                  id="assignment-approval-error">@_approvalError</FluentMessageBar>
                                            }
                                        </ChildContent>
                                    </PanelSection>
                                }
                            </div>
                        </div>
                    </div>
                </ChildContent>
            </AuthoringShell>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        @* The friendly-error seam (#416): the exception is logged with full detail and the reader gets
           this page's own sentence — a caught message never reaches the UI. *@
        <FriendlyErrorBar Message="@FriendlyError.Describe(
            ex,
            "This assignment could not be displayed. Reload the page, and tell an administrator if it keeps happening.",
            Logger)" />
    </ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>The Progress affordance's reason (P8/R1) — the route this page cannot reach yet.</summary>
    private const string ProgressReason = "Progress page arrives with the submission queue";

    /// <summary>P5b: why a Draft's primary cannot be used while its approval is outstanding.</summary>
    private const string PublishApprovalReason =
        "Approval is required before this assignment can be published";

    /// <summary>R1: the published primary. It renders disabled — the route ships with round b. *@</summary>
    private const string ProgressLabel = "Open progress";

    [Parameter] public Guid Id { get; set; }

    private AssignmentSummaryDto? _item;
    private bool _loading = true;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    /// <summary>The audience read — the published (log-backed) one, or the draft preview (P2b).</summary>
    private AssignmentAudienceDto? _audience;

    /// <summary>
    /// True when that read threw. The panel needs it because a null <see cref="_audience"/> means
    /// "still loading" until the read settles, and a failed read would otherwise leave it spinning
    /// for the life of the page (P2: never a silent state).
    /// </summary>
    private bool _audienceLoadFailed;

    /// <summary>
    /// The Questions block's rows, taken from the authoring child read the page already makes (no
    /// second read), together with the same read's attachments and resources for the rail's Content &
    /// Resources block. <see langword="null"/> means that read failed — both panels then say so in one
    /// sentence each and the rest of the page is unaffected.
    /// </summary>
    private AssignmentAuthoringChildrenDto? _children;

    /// <summary>
    /// The effective assignment policy the Rules rail panel reads, resolved for the assignment's own
    /// grade target (or the tenant default when the summary names none). Null means the read failed or
    /// the route could not answer — the panel degrades to one sentence, never a page failure.
    /// </summary>
    private EffectiveAssignmentPolicy? _policy;

    /// <summary>Submission rows, read only for the Status panel's submitted/graded counts.</summary>
    private SubmissionForReviewDto[]? _submissions;

    /// <summary>Per-ward sign-off rows — read only when the assignment requests a signature.</summary>
    private IReadOnlyList<SignOffStatusDto>? _signOff;

    /// <summary>One "verb in flight" flag per lifecycle action, so each control can disable itself
    /// while its own request runs and none of them share a single ambiguous busy state.</summary>
    private bool _duplicating;
    private bool _publishing;
    private bool _unpublishing;
    private bool _closing;
    private bool _archiving;
    private bool _scheduling;

    /// <summary>The ONE error bar every page-level action reports to — one action at a time can be in
    /// flight, so six private error fields would be six spellings of the same state.</summary>
    private string? _actionError;

    /// <summary>The approval block's own state (P5b): a submission, a decision in flight, and the
    /// refusal text. Kept apart from <see cref="_actionError"/> so the bar renders INSIDE the panel
    /// the reader acted in.</summary>
    private bool _submittingForApproval;
    private bool _actingOnApproval;
    private string? _approvalError;

    private IReadOnlyList<AuthoringCrumb> ShellCrumbs =>
        [new AuthoringCrumb("Assignments", "/assignments"), new AuthoringCrumb(_item?.Title ?? "…")];

    /// <summary>"Has ever been published" — the same test the log-backed read uses, so an assignment
    /// returned to Draft by Unpublish keeps its real delivery history (§4.2).</summary>
    private bool IsDraft => _item?.PublishedAt is null;

    /// <summary>The assignment's own grade target, the policy scope the Rules panel resolves against.
    /// <see langword="null"/> when the summary names none, which is the tenant-global default.</summary>
    private Guid? GradeLevelId =>
        _item?.TargetGradeIds is { Count: > 0 } gradeIds ? gradeIds[0] : null;

    /// <summary>The header fact row: at most four facts, read from the summary DTO (§4.1).</summary>
    private IReadOnlyList<string> Facts
    {
        get
        {
            if (_item is null)
            {
                return [];
            }

            var facts = new List<string>(4);
            if (!string.IsNullOrWhiteSpace(_item.TopicName))
            {
                facts.Add(_item.TopicName);
            }

            facts.Add(EnumHelper.GetDescription(_item.AssignmentType));

            if (_item.MaxScore is { } maxScore)
            {
                facts.Add($"{maxScore:0.##} points");
            }

            facts.Add(_item.DueDate is { } dueDate
                ? $"Due {dueDate.ToLocalTime():ddd d MMM yyyy}"
                : "No due date");

            return facts;
        }
    }

    /// <summary>§4.5: the semantic pill vocabulary, never a bare filled badge. The label is always
    /// text, so the state reads in greyscale and to a screen reader.</summary>
    private RenderFragment StatusBadge => @<text>
        <span class="status-pill @StatusPillClass" id="assignment-status-pill">
            <span class="status-pill__dot" aria-hidden="true"></span>@_item!.Status
        </span>
    </text>;

    private string StatusPillClass => _item?.Status switch
    {
        AssignmentStatusDto.Published => "status-pill--success",
        AssignmentStatusDto.Scheduled => "status-pill--warning",
        AssignmentStatusDto.Closed => "status-pill--neutral",
        AssignmentStatusDto.Archived => "status-pill--danger",
        _ => "status-pill--neutral",
    };

    /// <summary>The chips that ride the header ahead of the primary action, plus the disabled
    /// primary's reason (R1) — a reason the reader can see, not a tooltip.</summary>
    private RenderFragment HeaderChips => @<text>
        @if (_item!.RequiresApproval)
        {
            <span class="status-pill @ApprovalPillClass" id="assignment-approval-chip">@ApprovalChipText</span>
        }
        @if (_item.RequiresSignature)
        {
            <span class="status-pill status-pill--neutral" id="assignment-signoff-chip">Sign-off @SignOffProgressText</span>
        }
        @if (PrimaryDisabledReason is { } primaryGap)
        {
            <span class="assignment-primary-reason" id="@primaryGap.Id">@primaryGap.Text</span>
        }
    </text>;

    /// <summary>The status-driven primary (§2/§11). Null on an Archived assignment — the terminal state
    /// offers no primary action, so the shell renders no button at all rather than a dead one.</summary>
    private string? PrimaryLabel => _item?.Status switch
    {
        AssignmentStatusDto.Draft => "Publish",
        AssignmentStatusDto.Scheduled => "Unpublish",
        AssignmentStatusDto.Closed => "Archive",
        AssignmentStatusDto.Published => ProgressLabel,
        _ => null,
    };

    /// <summary>
    /// P5b/AC4b: the disabled primary's VISIBLE reason, never a tooltip and never invented. Null
    /// whenever the primary is live or absent, so a reason can only ever describe a real refusal.
    /// <para>The id differs because the two refusals are different sentences about different routes:
    /// <c>assignment-progress-reason</c> is R1's round-b route, <c>assignment-publish-reason</c> is the
    /// outstanding approval.</para>
    /// </summary>
    private (string Id, string Text)? PrimaryDisabledReason => _item?.Status switch
    {
        AssignmentStatusDto.Published => ("assignment-progress-reason", ProgressReason),
        AssignmentStatusDto.Draft when PublishBlockedByApproval =>
            ("assignment-publish-reason", PublishApprovalReason),
        _ => null,
    };

    private bool PrimaryDisabled =>
        PrimaryDisabledReason is not null || _publishing || _unpublishing || _archiving;

    /// <summary>Q6/D3: the server-derived approval gate — the page reads the OR'd field, never the
    /// feature flag. Only an APPROVED draft may be published: a rejected or denied row can never be
    /// sent until it is submitted (and, for a denial, duplicated) again.</summary>
    private bool PublishBlockedByApproval =>
        _item?.RequiresApproval == true && _item.ApprovalStatus != ApprovalStatusDto.Approved;

    /// <summary>P5b: Approval joins the rail on a DRAFT — pre-publish is the only state in which the
    /// decision is still the reader's to make.</summary>
    private bool ShowsApprovalPanel =>
        _item is { RequiresApproval: true, Status: AssignmentStatusDto.Draft };

    /// <summary>The rail panel's count: every material row it presents, attachments and resources.</summary>
    private int MaterialsCount =>
        (_children?.Attachments.Count ?? 0) + (_children?.Resources.Count ?? 0);

    private string ApprovalChipText => _item?.ApprovalStatus switch
    {
        null => "Approval not submitted",
        ApprovalStatusDto.Pending => "Approval outstanding",
        ApprovalStatusDto.Approved => "Approval ✓ approved",
        ApprovalStatusDto.Rejected => "Approval rejected",
        ApprovalStatusDto.Denied => "Approval denied",
        _ => "Approval —",
    };

    private string ApprovalPillClass => _item?.ApprovalStatus switch
    {
        ApprovalStatusDto.Approved => "status-pill--success",
        ApprovalStatusDto.Pending => "status-pill--warning",
        ApprovalStatusDto.Rejected or ApprovalStatusDto.Denied => "status-pill--danger",
        _ => "status-pill--neutral",
    };

    private string SignOffProgressText => _signOff is null
        ? "—"
        : $"{SignedCount}/{_signOff.Count}";

    private int SignedCount => _signOff is null
        ? 0
        : _signOff.Where(row => row.SignOffState == SignOffStateDto.Signed).Count();

    /// <summary>The page's own menu, beside the title (panel-layout-pattern §4). *@
    private RenderFragment PageMenu => @<text>
        <RowActionsMenu UseMenuService="false"
                        ForceKebab="true"
                        Actions="@PageActions"
                        AriaLabel="Page actions" />
    </text>;

    /// <summary>
    /// The page menu (US7: lifecycle actions live HERE, not split across surfaces). <c>Duplicate</c>
    /// rides every status — it is a read-only-on-source operation. <c>Schedule…</c> / <c>Reschedule…</c>
    /// belong to Draft/Scheduled and <c>Close</c> to Published; <c>Unpublish</c> stays the published
    /// page's live SECONDARY action (R1 pins that placement, the spec puts it in this kebab — the
    /// owner's later pin wins, so the pair is split by decision, not by accident).
    /// </summary>
    private IReadOnlyList<RowAction> PageActions
    {
        get
        {
            var actions = new List<RowAction>
            {
                RowAction.Callback(
                    "Duplicate",
                    OnDuplicateAsync,
                    icon: FluentIcons.DocumentCopy,
                    disabled: _duplicating,
                    disabledReason: _duplicating ? "Duplicating…" : null),
            };

            switch (_item?.Status)
            {
                case AssignmentStatusDto.Draft:
                    actions.Add(RowAction.Callback(
                        "Schedule…",
                        OnScheduleAsync,
                        icon: FluentIcons.Calendar,
                        disabled: _scheduling,
                        disabledReason: _scheduling ? "Scheduling…" : null));
                    break;
                case AssignmentStatusDto.Scheduled:
                    actions.Add(RowAction.Callback(
                        "Reschedule…",
                        OnScheduleAsync,
                        icon: FluentIcons.Calendar,
                        disabled: _scheduling,
                        disabledReason: _scheduling ? "Scheduling…" : null));
                    break;
                case AssignmentStatusDto.Published:
                    actions.Add(RowAction.Callback(
                        "Close",
                        OnCloseAsync,
                        icon: FluentIcons.Checkmark,
                        disabled: _closing,
                        disabledReason: _closing ? "Closing…" : null));
                    break;
            }

            return actions;
        }
    }

    /// <summary>R1: `Unpublish` stays LIVE beside the disabled `Open progress` primary while
    /// published — the owner's pin, against the spec's kebab wording (recorded in the round doc).</summary>
    private RenderFragment? SecondaryActions => _item?.Status == AssignmentStatusDto.Published
        ? @<text>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Disabled="@(_unpublishing || _publishing)"
                          OnClick="OnUnpublishAsync">
                @(_unpublishing ? "Unpublishing…" : "Unpublish")
            </FluentButton>
        </text>
        : null;

    /// <summary>One resolved policy readout per REAL <see cref="EffectiveAssignmentPolicy"/> field.</summary>
    private sealed record PolicyRule(string Label, string Value, bool FromOverride);

    /// <summary>
    /// The Rules rail panel's rows — every field the resolved policy actually carries, in the order a
    /// reader meets them, each noting <c>(override)</c> when the grade override supplied the value.
    /// <para>A null optional field states the built-in behaviour it falls back to (the write seams'
    /// own defaults, documented on <see cref="EffectiveAssignmentPolicy"/>) rather than reading as an
    /// empty cell. Nothing else is printed: the approved mock's two literal rule sentences and its
    /// "5 slots · 20,000 chars each" line have no backing field and are dropped.</para>
    /// </summary>
    private IReadOnlyList<PolicyRule> PolicyRows
    {
        get
        {
            if (_policy is not { } policy)
            {
                return [];
            }

            return
            [
                new("Signature requirement", policy.SignatureRequirement switch
                {
                    SignatureRequirementMode.Disabled => "Not required",
                    SignatureRequirementMode.Optional => "Optional",
                    _ => "Required after completion",
                }, policy.SignatureRequirementFromOverride),
                new("Approval before publish",
                    policy.RequiresApprovalBeforePublish ? "Required" : "Not required",
                    policy.RequiresApprovalBeforePublishFromOverride),
                new("Max primary contacts",
                    ContactCapText(policy.MaxPrimaryContacts), policy.MaxPrimaryContactsFromOverride),
                new("Max copy contacts",
                    ContactCapText(policy.MaxCopyContacts), policy.MaxCopyContactsFromOverride),
                new("Mandatory review", policy.MandatoryReview switch
                {
                    true => "Required",
                    false => "Not required",
                    _ => "Author's choice",
                }, policy.MandatoryReviewFromOverride),
                new("Archive grace days", policy.ArchiveGraceDays is int graceDays
                    ? $"{graceDays} days"
                    : "Built-in 30 days", policy.ArchiveGraceDaysFromOverride),
                new("Approval window", policy.ApprovalWindowDays is int windowDays
                    ? $"{windowDays} days"
                    : "No deadline", policy.ApprovalWindowDaysFromOverride),
            ];
        }
    }

    /// <summary>A contact cap: the resolved number, or the policy's own "uncapped" default.</summary>
    private static string ContactCapText(int? cap) => cap is int value ? value.ToString() : "Uncapped";

    /// <summary>The attachment's grounding state — the one fact that tells a reader whether this
    /// material can feed the AI. Derived from the persisted extraction outcome and the content type;
    /// nothing beyond those two is inferred.</summary>
    private static string GroundingText(AssignmentAttachmentReadDto attachment) =>
        attachment.ExtractionStatus switch
        {
            AttachmentExtractionStatusDto.Succeeded => "grounds ✓ · extracted text",
            AttachmentExtractionStatusDto.Failed =>
                "extraction failed — " + (attachment.ExtractionError ?? "no reason recorded"),
            _ when attachment.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) =>
                "image only · not grounded",
            _ => "no extractable text · not grounded",
        };

    /// <summary>The material's kind, read off the content type — the same three kinds the extraction
    /// seam distinguishes.</summary>
    private static Icon AttachmentIcon(string contentType) => contentType switch
    {
        var type when type.StartsWith("image/", StringComparison.OrdinalIgnoreCase) => FluentIcons.Image,
        var type when type.StartsWith("video/", StringComparison.OrdinalIgnoreCase) => FluentIcons.Video,
        _ => FluentIcons.Document,
    };

    /// <summary>A resource's name: its display name, else the URL it points at. Never a blank row.</summary>
    private static string ResourceName(ResourceDto resource) =>
        string.IsNullOrWhiteSpace(resource.DisplayName)
            ? resource.Url ?? "Untitled resource"
            : resource.DisplayName;

    /// <summary>
    /// The Status panel's three segments (P8/R3). Progress counts come from the submission rows and
    /// the cohort; the notification counts are folded straight out of the audience read's contacts —
    /// the log-backed one for a published assignment, so no second read is needed for them.
    /// </summary>
    private StatusStrip.StatusStripModel StatusModel
    {
        get
        {
            var rows = _audience?.Rows ?? [];
            var contacts = rows.SelectMany(row => row.Contacts).ToList();
            var signOffRequested = _item?.RequiresSignature == true;
            var signed = signOffRequested && _signOff is not null ? SignedCount : (int?)null;

            return new StatusStrip.StatusStripModel(
                IsPublished: _item?.PublishedAt is not null,
                Cohort: rows.Count,
                Submitted: _submissions?.Length ?? 0,
                Graded: _submissions?.Where(submission => submission.ReviewState == ReviewStateDto.Graded).Count() ?? 0,
                Reached: rows.Where(row => row.Reached).Count(),
                Signed: signed,
                Outstanding: signed is null ? null : _signOff!.Count - signed.Value,
                Queued: contacts.Count(contact => contact.DeliveryState == AudienceDeliveryStateDto.Queued),
                Sent: contacts.Count(contact => contact.DeliveryState == AudienceDeliveryStateDto.Sent),
                Failed: contacts.Count(contact => contact.DeliveryState == AudienceDeliveryStateDto.Failed),
                Skipped: contacts.Count(contact => contact.DeliveryState == AudienceDeliveryStateDto.Skipped),
                RetryScheduled: contacts.Count(contact => contact.RetryScheduled));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            Logger.LogInformation("Loading assignment {AssignmentId}", Id);
            _item = await Api.GetByIdAsync(Id, ct);
            if (_disposed)
            {
                return;
            }

            if (_item is not null)
            {
                await LoadOperationalReadsAsync(ct);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed)
            {
                return;
            }

            Logger.LogError(ex, "Failed to load assignment {AssignmentId}", Id);
        }
        finally
        {
            if (!_disposed)
            {
                _loading = false;
            }
        }
    }

    /// <summary>
    /// The blocks' own reads. Each one degrades on its own: a failed audience read leaves the panel
    /// saying so in one sentence rather than claiming a state it does not have, and the
    /// submission/sign-off counts simply read zero/absent — a supporting outage never fails the page.
    /// </summary>
    private async Task LoadOperationalReadsAsync(CancellationToken ct)
    {
        // The Questions block's rows come from the authoring child read — the one call that already
        // returns them, so this page never adds a read for them (P7).
        // ONE child read feeds two panels: the Questions table and the rail's Content & Resources
        // block take their rows from it, so the page adds no read of its own (P7).
        try
        {
            _children = await Api.GetAuthoringChildrenAsync(Id, ct);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load the authoring children for {AssignmentId}", Id);
        }

        // The Rules rail panel's read: the effective policy for the assignment's own grade target, or
        // the tenant default when the summary names none. A failure leaves the panel saying so — a
        // supporting read never fails the page.
        try
        {
            _policy = await Api.GetEffectivePolicyAsync(GradeLevelId, ct);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to resolve the effective policy for {AssignmentId}", Id);
        }

        // The published read is log-backed and the draft read resolves the persisted targets
        // through the same chain publish runs (P2/P2b) — one read per page load, never on the
        // authoring surface's 500 ms debounce.
        try
        {
            _audience = IsDraft
                ? await Api.GetAssignmentAudiencePreviewAsync(Id, ct)
                : await Api.GetAssignmentAudienceAsync(Id, ct);
            _audienceLoadFailed = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load the audience for {AssignmentId}", Id);
            _audienceLoadFailed = true;
        }

        if (!IsDraft)
        {
            try
            {
                _submissions = await Api.ListSubmissionsAsync(Id, ct);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load submissions for {AssignmentId}", Id);
            }
        }

        if (_item?.RequiresSignature == true)
        {
            try
            {
                _signOff = await Api.ListSignOffStatusesAsync(Id, ct);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load sign-off statuses for {AssignmentId}", Id);
            }
        }
    }

    /// <summary>Re-reads everything the page draws — used after a page-level action changes state.</summary>
    private async Task ReloadAsync()
    {
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            _item = await Api.GetByIdAsync(Id, ct);
            if (_item is not null)
            {
                await LoadOperationalReadsAsync(ct);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed)
            {
                return;
            }

            Logger.LogWarning(ex, "Failed to reload assignment {AssignmentId}", Id);
        }
    }

