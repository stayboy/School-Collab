    // ── Approval (LIF-1; the panel lives in the rail, its decisions in the panel body) ──────

    /// <summary>
    /// Q6 / ar-24: the acting teacher comes from the circuit principal's <c>teacher_id</c> claim —
    /// <see cref="AuthenticationStateProvider"/>, never <c>IHttpContextAccessor</c>, which is null in
    /// the interactive circuit. No claim (the dev/TestAuth default) yields <see cref="Guid.Empty"/>, the
    /// server's own "unchanged" placeholder.
    /// </summary>
    private async Task<Guid> GetActingTeacherIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst("teacher_id")?.Value;
        return Guid.TryParse(claim, out var teacherId) ? teacherId : Guid.Empty;
    }

