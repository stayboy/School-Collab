    private Task OnPrimaryActionAsync() => _item?.Status switch
    {
        AssignmentStatusDto.Draft => OnPublishAsync(),
        AssignmentStatusDto.Scheduled => OnUnpublishAsync(),
        AssignmentStatusDto.Closed => OnArchiveAsync(),
        _ => Task.CompletedTask,
    };

