@page "/assignments/{Id:guid}"
@using SchoolCollab.Assignments.Contracts
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Admin.Shared.Components
@inject AssignmentsApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Detail> Logger
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Assignment @_item?.Title</PageTitle>

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (_item is null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">Assignment not found.</FluentMessageBar>
            <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="mt-2">Back to List</FluentButton>
        }
        else
        {
            <div class="detail-container">
                <div class="title-row">
                    <h2 class="page-title">@_item.Title</h2>
                    @* WS-A2 deviation from decision (j): FluentBadge only supports Accent /
                        Neutral / Lightweight (validated at render in Fluent UI 4.14) — Outline
                        would crash the page. Scheduled shares Accent with Published (both
                        committed publishing states); the badge text distinguishes them. *@
                    <FluentBadge Appearance="@( _item.Status == AssignmentStatusDto.Published ? Appearance.Accent
                        : _item.Status == AssignmentStatusDto.Scheduled ? Appearance.Accent
                        : _item.Status == AssignmentStatusDto.Closed || _item.Status == AssignmentStatusDto.Archived ? Appearance.Neutral
                        : Appearance.Lightweight)">
                        @_item.Status
                    </FluentBadge>
                    @if (_item.MandatoryReview)
                    {
                        <FluentBadge Appearance="Appearance.Lightweight" Title="Guardian review required before students submit">Review required</FluentBadge>
                    }
                </div>

                <FluentTabs>
                    <FluentTab Label="Overview" Icon="@FluentIcons.ClipboardCheckmark">
                        @* R1 (UX-10 / assignment-authoring-compartments §5): the read-only
                           authoring summary IS the shared View mode — the hand-rolled Overview
                           grid was retired so Detail can never drift from Create/Edit (NFR-4).
                           The lifecycle actions (Publish / Unpublish / Schedule / Reschedule /
                           Close / Archive) now live in the authoring action bar's §11 matrix;
                           Detail keeps the approver surface (LIF-1) and the operational tabs. *@
                        <AssignmentAuthoring Mode="AssignmentAuthoringMode.View" Id="@Id"
                                             Changed="ReloadItemAsync" />

                        <div class="mt-3">
                            <FluentButton Appearance="Appearance.Outline" @onclick="Cancel">Back to List</FluentButton>
                            @* WS-A4 / spec §3.1: duplicate the assignment as a fresh
                               Draft template copy. Rendered regardless of status — it
                               is a read-only-on-source operation. *@
                            <FluentButton Appearance="Appearance.Outline" OnClick="OnDuplicateAsync" Disabled="@_duplicating" class="ms-2">
                                @(_duplicating ? "Duplicating…" : "Duplicate")
                            </FluentButton>
                            @if (!string.IsNullOrEmpty(_duplicateError))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_duplicateError</FluentMessageBar>
                            }
                        </div>

                        @* Q6 / D3 (documents/solution/assignment-policy-fields.md §5) — the
                           approval panel is gated on the SERVER-derived RequiresApproval:
                           the grade's effective RequiresApprovalBeforePublish policy field
                           OR'd with the assignment-approval runtime feature flag by the read
                           handler. The page reads no feature flag itself. *@
                        @if (_item.RequiresApproval)
                        {
                            <hr class="my-4" />
                            <h4>Approval</h4>
                            <div class="mt-2">
                                <FluentBadge Appearance="@ApprovalBadgeAppearance()">@ApprovalStatusText()</FluentBadge>

                                @if (_item.Status == AssignmentStatusDto.Draft && (_item.ApprovalStatus is null || _item.ApprovalStatus == ApprovalStatusDto.Rejected))
                                {
                                    <FluentButton Appearance="Appearance.Accent" OnClick="OnSubmitForApprovalAsync" Disabled="@_submittingForApproval" class="ms-2">
                                        @(_submittingForApproval ? "Submitting…" : "Submit for Approval")
                                    </FluentButton>
                                }

                                @if (_item.ApprovalStatus == ApprovalStatusDto.Pending)
                                {
                                    <FluentButton Appearance="Appearance.Accent" OnClick="OnApproveAsync" Disabled="@_actingOnApproval" class="ms-2">
                                        @(_actingOnApproval ? "Working…" : "Approve")
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Outline" OnClick="OnRejectAsync" Disabled="@_actingOnApproval" class="ms-2">
                                        @(_actingOnApproval ? "Working…" : "Reject")
                                    </FluentButton>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_approvalError))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_approvalError</FluentMessageBar>
                            }
                        }

                        @if (_item.Status == AssignmentStatusDto.Closed)
                        {
                            <hr class="my-4" />
                            <h4>Submit Review</h4>
                            <EditForm Model="_reviewModel" OnValidSubmit="SubmitReviewAsync" class="form-container">
                                <DataAnnotationsValidator />
                                <FluentNumberField @bind-Value="_reviewModel.Score" Label="Score" class="narrow-field mb-3" />
                                <FluentTextArea @bind-Value="_reviewModel.Comments" Label="Comments" Rows="3" class="full-width mb-3" />
                                @if (!string.IsNullOrEmpty(_reviewError))
                                {
                                    <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_reviewError</FluentMessageBar>
                                }
                                <div>
                                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_submittingReview">@(_submittingReview ? "Submitting…" : "Submit Review")</FluentButton>
                                </div>
                            </EditForm>
                        }
                    </FluentTab>

                    <FluentTab Label="Recipients" Icon="@FluentIcons.People">
                        @if (_loadingRecipients)
                        {
                            <FluentProgressRing />
                        }
                        else if (_recipients is null || _recipients.Length == 0)
                        {
                            <FluentMessageBar Intent="MessageIntent.Info" class="mt-3">
                                No recipients yet. Publish the assignment to notify subscribed student/guardian contacts.
                            </FluentMessageBar>
                        }
                        else
                        {
                            <table class="recipients-table mt-3">
                                <thead>
                                    <tr>
                                        <th>Recipient</th>
                                        <th>Channel</th>
                                        <th>Role</th>
                                        <th>Subscription</th>
                                        <th>Broadcast</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _recipients)
                                    {
                                        <tr>
                                            <td>@EnumHelper.GetDescription(r.OwnerType)</td>
                                            <td>@EnumHelper.GetDescription(r.Channel)</td>
                                            <td>@(r.Role is not null ? EnumHelper.GetDescription(r.Role) : "—")</td>
                                            <td>
                                                <FluentBadge Appearance="@(r.SubscriptionActive ? Appearance.Accent : Appearance.Neutral)">
                                                    @(r.SubscriptionActive ? "Active" : "Inactive")
                                                </FluentBadge>
                                            </td>
                                            <td>@(r.NotifyOnBroadcast ? "Yes" : "No")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </FluentTab>

                    <FluentTab Label="Submissions" Icon="@FluentIcons.TextBulletList">
                        @if (_loadingSubmissions)
                        {
                            <FluentProgressRing />
                        }
                        else if (_selectedSubmission is not null)
                        {
                            <div class="mt-3">
                                <FluentButton Appearance="Appearance.Outline" OnClick="BackToSubmissionsAsync">← All submissions</FluentButton>
                                <h4 class="mt-2">Student @_selectedSubmission.StudentId</h4>
                                <p class="dialog-hint">Current version @_selectedSubmission.CurrentVersionNumber · Review: @EnumHelper.GetDescription(_selectedSubmission.ReviewState)</p>

                                <h5>Version history</h5>
                                <table class="recipients-table">
                                    <thead>
                                        @* WS-A3 (spec §3.3): Score + Passed columns
                                           surfaced for AutoGraded / InstantGraded
                                           versions (the engine sets both; null for
                                           TeacherGraded). The display falls back to
                                           "—" when the value is null. *@
                                        <tr><th>Ver</th><th>Source</th><th>Submitted</th><th>Score</th><th>Passed</th><th>Content</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in _selectedSubmission.Versions)
                                        {
                                            <tr>
                                                <td>@v.VersionNumber</td>
                                                <td>@EnumHelper.GetDescription(v.Source)</td>
                                                <td>@v.SubmittedAt.ToLocalTime().ToString("g")</td>
                                                <td>@(v.Score?.ToString("0.##") ?? "—")</td>
                                                <td>@(v.Passed is null ? "—" : v.Passed.Value ? "Passed" : "Failed")</td>
                                                <td class="submission-content">@(v.Content ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                @if (_selectedSubmission.Review is not null)
                                {
                                    <FluentMessageBar Intent="MessageIntent.Success" class="mt-3">
                                        Reviewed: @(_selectedSubmission.Review!.Score?.ToString("0.##") ?? "—") @(_selectedSubmission.Review.Grade ?? "") — @(_selectedSubmission.Review.Comments ?? "")
                                    </FluentMessageBar>
                                }

                                <hr class="my-4" />
                                <h5>Teacher review / grade</h5>
                                <EditForm Model="_submissionReviewModel" OnValidSubmit="SubmitSubmissionReviewAsync" class="form-container">
                                    <DataAnnotationsValidator />
                                    <FluentNumberField @bind-Value="_submissionReviewModel.Score" Label="Score" class="narrow-field mb-3" />
                                    <FluentTextField @bind-Value="_submissionReviewModel.Grade" Label="Grade" class="full-width mb-3" />
                                    <FluentTextArea @bind-Value="_submissionReviewModel.Comments" Label="Comments" Rows="3" class="full-width mb-3" />
                                    @if (!string.IsNullOrEmpty(_submissionReviewError))
                                    {
                                        <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_submissionReviewError</FluentMessageBar>
                                    }
                                    <div>
                                        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_submittingSubmissionReview">
                                            @(_submittingSubmissionReview ? "Submitting…" : "Submit Review")
                                        </FluentButton>
                                    </div>
                                </EditForm>
                            </div>
                        }
                        else if (_submissions is null || _submissions.Length == 0)
                        {
                            <FluentMessageBar Intent="MessageIntent.Info" class="mt-3">No submissions yet.</FluentMessageBar>
                        }
                        else
                        {
                            <table class="recipients-table mt-3">
                                <thead>
                                    <tr><th>Student</th><th>Version</th><th>Review</th><th>Last submitted</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in _submissions)
                                    {
                                        <tr>
                                            <td>@s.StudentId</td>
                                            <td>@s.CurrentVersionNumber</td>
                                            <td>@EnumHelper.GetDescription(s.ReviewState)</td>
                                            <td>@s.LastSubmittedAt.ToLocalTime().ToString("g")</td>
                                            <td><FluentButton Appearance="Appearance.Outline" OnClick="@(() => SelectSubmissionAsync(s.StudentId))">View</FluentButton></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </FluentTab>

                    @* WS-C1 (spec §3.2 line 51): guardian sign-off card. The tab is
                       gated so the card renders NOTHING when the assignment does not
                       require a signature (the section self-loads its own data). *@
                    @if (_item.RequiresSignature)
                    {
                        <FluentTab Label="Guardian Sign-off">
                            <SignOffSection AssignmentId="@Id" RequiresSignature="true" />
                        </FluentTab>
                    }

                    @* WS-E2 / ar-17 — failed-notification surface. The gate is "has ever been
                       published" (PublishedAt is not null), NOT a status test: NotificationLog
                       rows exist only after a publish, and Unpublish returns the assignment to
                       Draft while those rows survive — a status gate would hide that history.
                       It is deliberately a DATA test rather than a status enumeration: Close()
                       has no published precondition, so a never-published Draft that was Closed
                       reports PublishedAt == null and correctly shows no tab. The section
                       self-loads (no Detail-side failure fetch, mirroring SignOffSection); it
                       renders an Info empty state when the endpoint returns zero rows. *@
                    @if (_item.PublishedAt is not null)
                    {
                        <FluentTab Label="@NotificationsTabLabel">
                            <NotificationFailuresSection AssignmentId="@Id" CanHaveFailures="true"
                                                          OnFailureCountLoaded="@OnFailureCountLoaded" />
                        </FluentTab>
                    }
                </FluentTabs>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public Guid Id { get; set; }

    private AssignmentSummaryDto? _item;
    private bool _loading = true;
    private string? _error;    // WS-E2b / ar-18 (ar-17 follow-up F5): reported by the failures section's own load —
    // Detail never fetches the failure list itself just to count it.
    private int _notificationFailureCount;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // Recipients (spec §12)
    private AssignmentRecipientDto[]? _recipients;
    private bool _loadingRecipients;

    // Submissions + review (spec §12)
    private SubmissionForReviewDto[]? _submissions;
    private bool _loadingSubmissions;
    private SubmissionDetailDto? _selectedSubmission;
    private bool _loadingSubmission;

    // WS-A2 schedule / cancel-schedule / approval actions
    private bool _submittingForApproval;
    private bool _actingOnApproval;
    private string? _approvalError;

    // WS-A4 / spec §3.1: duplicate-as-template action state. The failure
    // surfaces on a dedicated _duplicateError bar (Detail never renders the
    // generic _error field).
    private bool _duplicating;
    private string? _duplicateError;

    // Closed-assignment review (existing AssignmentReview)
    private bool _submittingReview;
    private string? _reviewError;
    private readonly ReviewFormModel _reviewModel = new();

    // Submission teacher review/grade
    private bool _submittingSubmissionReview;
    private string? _submissionReviewError;
    private readonly SubmissionReviewFormModel _submissionReviewModel = new();

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            Logger.LogInformation("Loading assignment {AssignmentId}", Id);
            _item = await Api.GetByIdAsync(Id, ct);
            if (_disposed) return;

            if (_item is not null)
            {
                _loadingRecipients = true;
                _loadingSubmissions = true;
                try
                {
                    _recipients = await Api.GetRecipientsAsync(Id, ct);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load recipients for {AssignmentId}", Id);
                }
                finally { _loadingRecipients = false; }

                try
                {
                    _submissions = await Api.ListSubmissionsAsync(Id, ct);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load submissions for {AssignmentId}", Id);
                }
                finally { _loadingSubmissions = false; }
            }

            Logger.LogInformation("Loaded assignment {AssignmentId}", Id);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load assignment {AssignmentId}", Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    /// <summary>WS-E2b / ar-18: the failures tab badges its row count (F5).
    /// Zero reads as the plain label — an empty list is not worth a "(0)".</summary>
    private string NotificationsTabLabel =>
        _notificationFailureCount > 0 ? $"Notifications ({_notificationFailureCount})" : "Notifications";

    private void OnFailureCountLoaded(int count) => _notificationFailureCount = count;

    /// <summary>R1: the shared View-mode authoring component raises this after a successful
    /// lifecycle action (publish / unpublish / schedule / close / archive) so Detail re-reads
    /// the assignment its badge, tabs and approval panel render around.</summary>
    private async Task ReloadItemAsync()
    {
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            _item = await Api.GetByIdAsync(Id, ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to reload assignment {AssignmentId}", Id);
        }
    }

    // ── WS-A2: approval-status chip + dialog ────────────────────────────

    private string ApprovalStatusText() => _item?.ApprovalStatus switch
    {
        null => "Not submitted",
        ApprovalStatusDto.Pending => "Pending",
        ApprovalStatusDto.Approved => "Approved",
        ApprovalStatusDto.Rejected => "Rejected",
        _ => "—"
    };

    // WS-A2 deviation from decision (j): FluentBadge only supports Accent / Neutral /
    // Lightweight, so Pending shares Neutral with Rejected (both "submitted, not yet
    // approved" — text distinguishes). Approved keeps the Accent success fill and
    // "Not submitted" stays muted Lightweight.
    private Appearance ApprovalBadgeAppearance() => _item?.ApprovalStatus switch
    {
        null => Appearance.Lightweight,
        ApprovalStatusDto.Pending => Appearance.Neutral,
        ApprovalStatusDto.Approved => Appearance.Accent,
        ApprovalStatusDto.Rejected => Appearance.Neutral,
        _ => Appearance.Lightweight
    };

    private async Task OnSubmitForApprovalAsync()
    {
        if (_item is null) return;
        _submittingForApproval = true;
        _approvalError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            await Api.SubmitForApprovalAsync(Id, ct);
            _item = await Api.GetByIdAsync(Id, ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to submit assignment {AssignmentId} for approval", Id);
            _approvalError = ex.Message;
        }
        finally
        {
            if (!_disposed) _submittingForApproval = false;
        }
    }

    // ar-24 row 2: the acting teacher id from the circuit principal's teacher_id claim
    // (AuthenticationStateProvider — NOT IHttpContextAccessor, which is null in the
    // interactive circuit). No claim (the dev/TestAuth default) => Guid.Empty (unchanged).
    private async Task<Guid> GetActingTeacherIdAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst("teacher_id")?.Value;
        return Guid.TryParse(claim, out var id) ? id : Guid.Empty;
    }

    private async Task OnApproveAsync()
    {
        if (_item is null) return;
        if (!await DialogService.ShowConfirmDialogAsync($"Approve assignment '{_item.Title}'?", primaryText: "Approve"))
            return;
        _actingOnApproval = true;
        _approvalError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            await Api.ApproveAsync(Id, await GetActingTeacherIdAsync(), ct);
            _item = await Api.GetByIdAsync(Id, ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to approve assignment {AssignmentId}", Id);
            _approvalError = ex.Message;
        }
        finally
        {
            if (!_disposed) _actingOnApproval = false;
        }
    }

    private async Task OnRejectAsync()
    {
        if (_item is null) return;
        if (!await DialogService.ShowConfirmDialogAsync($"Reject assignment '{_item.Title}'?", primaryText: "Reject"))
            return;
        _actingOnApproval = true;
        _approvalError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            await Api.RejectAsync(Id, await GetActingTeacherIdAsync(), ct);
            _item = await Api.GetByIdAsync(Id, ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reject assignment {AssignmentId}", Id);
            _approvalError = ex.Message;
        }
        finally
        {
            if (!_disposed) _actingOnApproval = false;
        }
    }

    // WS-A4 / spec §3.1: duplicate the assignment as a fresh Draft template
    // copy, then navigate to the copy so the teacher can edit it. A failure
    // surfaces on the dedicated _duplicateError bar (no navigation).
    private async Task OnDuplicateAsync()
    {
        if (_item is null) return;
        if (!await DialogService.ShowConfirmDialogAsync($"Duplicate assignment '{_item.Title}'? This creates a new draft copy.", primaryText: "Duplicate"))
            return;
        _duplicating = true;
        _duplicateError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            var newId = await Api.DuplicateAsync(Id, ct);
            Nav.NavigateTo($"/assignments/{newId}");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to duplicate assignment {AssignmentId}", Id);
            _duplicateError = ex.Message;
        }
        finally
        {
            if (!_disposed) _duplicating = false;
        }
    }

    private async Task SelectSubmissionAsync(Guid studentId)
    {
        _loadingSubmission = true;
        _submissionReviewError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            _selectedSubmission = await Api.GetSubmissionAsync(Id, studentId, ct);
            _submissionReviewModel.Score = _selectedSubmission?.Review?.Score;
            _submissionReviewModel.Grade = _selectedSubmission?.Review?.Grade;
            _submissionReviewModel.Comments = _selectedSubmission?.Review?.Comments;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load submission for {AssignmentId}/{StudentId}", Id, studentId);
            _submissionReviewError = ex.Message;
        }
        finally
        {
            if (!_disposed) _loadingSubmission = false;
        }
    }

    private void BackToSubmissionsAsync() => _selectedSubmission = null;

    private async Task SubmitSubmissionReviewAsync()
    {
        if (_selectedSubmission is null) return;
        _submittingSubmissionReview = true;
        _submissionReviewError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            Logger.LogInformation("Submitting review for submission {SubmissionId}", _selectedSubmission.SubmissionId);
            await Api.ReviewSubmissionAsync(Id, _selectedSubmission.StudentId, new ReviewSubmissionRequest(
                await GetActingTeacherIdAsync(), // ar-24: acting teacher from the circuit principal (claim-wins server-side)
                _submissionReviewModel.Score,
                _submissionReviewModel.Grade,
                _submissionReviewModel.Comments));
            _selectedSubmission = await Api.GetSubmissionAsync(Id, _selectedSubmission.StudentId, ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to submit review for {AssignmentId}/{StudentId}", Id, _selectedSubmission.StudentId);
            _submissionReviewError = ex.Message;
        }
        finally
        {
            if (!_disposed) _submittingSubmissionReview = false;
        }
    }

    private async Task SubmitReviewAsync()
    {
        _submittingReview = true;
        _reviewError = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            Logger.LogInformation("Submitting review for assignment {AssignmentId}", Id);
            var req = new ReviewAssignmentRequest(
                await GetActingTeacherIdAsync(), // ar-24: acting teacher from the circuit principal
                _reviewModel.Score,
                _reviewModel.Comments);
            await Api.ReviewAsync(Id, req, ct);
            Nav.NavigateTo("/assignments");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to submit review for assignment {AssignmentId}", Id);
            _reviewError = ex.Message;
        }
        finally
        {
            if (!_disposed) _submittingReview = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/assignments");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    private sealed class ReviewFormModel
    {
        public decimal? Score { get; set; }
        public string? Comments { get; set; }
    }

    private sealed class SubmissionReviewFormModel
    {
        public decimal? Score { get; set; }
        public string? Grade { get; set; }
        public string? Comments { get; set; }
    }
}
