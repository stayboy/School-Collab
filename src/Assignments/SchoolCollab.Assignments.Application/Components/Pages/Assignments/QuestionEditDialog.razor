@* Question Add/Edit dialog (spec §6.2 QA-11, round content-questions-modern-ui).
   The per-type fields are the ones the inline editor used to render — moved verbatim into the
   repo's shared dialog shell so the question LIST can stay a single-line, kebab-driven row list
   (the reference project page's shape). Edits apply to a working copy; Cancel discards. *@
@using SchoolCollab.Assignments.Application.Helpers
@inherits DialogShellBase<QuestionEditModel, QuestionEditResult>

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <FluentTextField @bind-Value="Model.Row.QuestionText"
                         Id="cq-qedit-text"
                         Label="Question *"
                         class="full-width mb-3" />

        <DropdownForEnum TEnum="QuestionTypeDto"
                         @bind-SelectedValue="Model.Row.Type"
                         @bind-SelectedValue:after="OnTypeChanged"
                         Label="Type"
                         Class="w-3" />

        @* D16/QR-2 (spec §5.1, round Q1(ii)): what the student must submit — a SET, because the
           owner's requirement is "any of or a mix of". On Auto Scored / Instant Feedback the media
           rule forbids every kind, so the picker renders DISABLED WITH THE REASON (the
           ScoringFieldsSection pattern) rather than disappearing or silently accepting a bad value. *@
        <div class="cq-qedit-options" id="cq-qedit-kinds">
            <span class="cq-qedit-sublabel">Response — what the student submits</span>
            @if (KindsForbidden)
            {
                <p class="cq-qedit-reason" id="cq-qedit-kinds-reason">@QuestionResponseKindRules.TeacherMarkedOnlyHint</p>
            }
            <div class="cq-qedit-kind-row">
                @foreach (var kind in AllKinds)
                {
                    <FluentCheckbox Id="@($"cq-qedit-kind-{kind}")"
                                    Label="@EnumHelper.GetDescription(kind)"
                                    Disabled="@KindsForbidden"
                                    Value="@Model.Row.ResponseKinds.Contains(kind)"
                                    ValueChanged="@(isChecked => OnKindChanged(kind, isChecked))" />
                }
            </div>
        </div>

        @* QR-5 (§5.2/§5.6): the per-question instruction blocks. The shared inline editor, so the
           two owners cannot drift; no nested dialog (dialog-ui §4). *@
        <div class="cq-qedit-options" id="cq-qedit-instructions">
            <span class="cq-qedit-sublabel">Instructions</span>
            <InstructionEditorList Id="cq-qedit-instructions-list"
                                   Rows="Model.Row.Instructions"
                                   StageMediaAsync="Model.StageMediaAsync" />
        </div>

        @switch (Model.Row.Type)
        {
            case QuestionTypeDto.MultipleChoice:
            {
                <div class="cq-qedit-options">
                    <span class="cq-qedit-sublabel">Options (pick the correct one)</span>
                    <FluentRadioGroup TValue="int" Name="@RadioGroupKey">
                        @for (var i = 0; i < Model.Row.Options.Count; i++)
                        {
                            var optIndex = i;
                            var opt = Model.Row.Options[i];
                            <div class="cq-qedit-option" @key="opt">
                                <FluentRadio Value="@optIndex"
                                             Group="@RadioGroupKey"
                                             Checked="@(Model.Row.CorrectOptionIndex == optIndex)"
                                             CheckedChanged="@(EventCallback.Factory.Create<bool>(this, v => OnCorrectOptionChanged(optIndex, v)))"
                                             aria-label="Mark as correct option" />
                                <FluentTextField @bind-Value="opt.OptionText"
                                                 Placeholder="@($"Option {optIndex + 1}")"
                                                 class="full-width" />
                                @if (Model.Row.Options.Count > QuestionEditorRow.MinOptions)
                                {
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  OnClick="@(() => OnRemoveOption(optIndex))"
                                                  aria-label="Remove option">
                                        ×
                                    </FluentButton>
                                }
                            </div>
                        }
                    </FluentRadioGroup>
                    <FluentButton Appearance="Appearance.Outline"
                                  Disabled="@(Model.Row.Options.Count >= QuestionEditorRow.MaxOptions)"
                                  OnClick="OnAddOption">
                        Add option
                    </FluentButton>
                </div>
                break;
            }
            case QuestionTypeDto.TrueFalse:
            {
                <div class="cq-qedit-options">
                    <span class="cq-qedit-sublabel">Correct answer</span>
                    <FluentRadioGroup TValue="int" Name="@RadioGroupKey">
                        <FluentRadio Value="0"
                                     Label="True"
                                     Checked="@(Model.Row.CorrectOptionIndex == 0)"
                                     CheckedChanged="@(EventCallback.Factory.Create<bool>(this, v => OnCorrectOptionChanged(0, v)))" />
                        <FluentRadio Value="1"
                                     Label="False"
                                     Checked="@(Model.Row.CorrectOptionIndex == 1)"
                                     CheckedChanged="@(EventCallback.Factory.Create<bool>(this, v => OnCorrectOptionChanged(1, v)))" />
                    </FluentRadioGroup>
                </div>
                break;
            }
            case QuestionTypeDto.ShortAnswer:
            {
                <FluentTextArea @bind-Value="Model.Row.ModelAnswer"
                                Label="Model answer (teacher reference)"
                                Rows="2"
                                class="full-width" />
                break;
            }
        }

        <DialogShellFooter Saving="@Saving"
                           Error="@Error"
                           SubmitText="@SubmitText"
                           OnCancel="HandleCancelAsync" />
    </EditForm>
</div>

@code {
    /// <summary>A per-dialog radio-group name so each question's radios stay independent.</summary>
    private readonly string _groupName = $"qedit-{Guid.NewGuid():N}";

    /// <summary>The response kinds in canonical order — the order the payload carries them in, so the
    /// wire is a function of the SET rather than of the author's click order.</summary>
    private static readonly QuestionResponseKindDto[] AllKinds =
    [
        QuestionResponseKindDto.Video,
        QuestionResponseKindDto.Audio,
        QuestionResponseKindDto.Document,
        QuestionResponseKindDto.Image,
    ];

    /// <summary>True exactly where the media rule forbids every kind (Auto Scored / Instant
    /// Feedback) — the picker stays visible, disabled, with the reason beside it.</summary>
    private bool KindsForbidden =>
        !QuestionResponseKindRules.RequiresResponseKinds(Model.GradingFormat);

    private void OnKindChanged(QuestionResponseKindDto kind, bool? isChecked)
    {
        var selected = Model.Row.ResponseKinds.ToHashSet();
        if (isChecked == true)
        {
            selected.Add(kind);
        }
        else
        {
            selected.Remove(kind);
        }

        Model.Row.ResponseKinds.Clear();
        Model.Row.ResponseKinds.AddRange(AllKinds.Where(selected.Contains));
    }

    private string RadioGroupKey => $"{_groupName}-{Model.Position}";

    protected override string SubmitText => Model.IsNew ? "Add question" : "Save";

    /// <summary>Applies the type change's canonical option/correct-answer reset (spec §7).</summary>
    private void OnTypeChanged() => Model.Row.ApplyTypeChange(Model.Row.Type);

    private void OnAddOption() => Model.Row.AddOption();

    private void OnRemoveOption(int index) => Model.Row.RemoveOptionAt(index);

    private void OnCorrectOptionChanged(int index, bool isChecked)
    {
        if (isChecked)
        {
            Model.Row.CorrectOptionIndex = index;
        }
        else if (Model.Row.CorrectOptionIndex == index)
        {
            // Radio-uncheck is allowed; the submit gate rejects a row with no correct pick.
            Model.Row.CorrectOptionIndex = null;
        }
    }

    /// <summary>No per-question validation exists today (the apply-time submit gate owns it), so
    /// a confirmed dialog always returns its working copy.</summary>
    protected override Task<QuestionEditResult?> SubmitAsync(QuestionEditModel model) =>
        Task.FromResult<QuestionEditResult?>(new QuestionEditResult(model.Row));
}
