@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Assignments.Application.Helpers
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using SchoolCollab.Assignments.Application.Services
@using SchoolCollab.Assignments.Contracts
@using SchoolCollab.AI.Abstractions
@implements IDisposable
@inject IDialogService DialogService
@inject IAssignmentQuestionGenerator QuestionGenerator
@inject AssignmentsApiClient Api
@inject ILogger<QuestionsDraftSection> Logger

<section class="questions-draft-section">
    @* QA-18 (spec §6.3, D12): the staged-draft surface is a collapsed disclosure, auto-expanded
       whenever a draft is staged — its duplicate generation controls are not deduplicated this
       round, so collapsing keeps them off the default page while the draft route stays one click
       away inside the same compartment. *@
    <button type="button" class="cq-draft-toggle"
            id="cq-draft-panel"
            aria-expanded="@(_expanded ? "true" : "false")"
            aria-controls="cq-draft-body"
            @onclick="ToggleExpanded">
        <FluentIcon Icon="@(Icons.Regular.Size20.ChevronRight)"
                    Class="@(_expanded ? "cq-draft-chevron is-open" : "cq-draft-chevron")"
                    aria-hidden="true" />
        <span>Draft preview</span>
    </button>

    @if (_expanded)
    {
        <div class="cq-draft-body" id="cq-draft-body" role="region" aria-label="Draft preview">
    <FluentMessageBar Intent="MessageIntent.Info">
        Regenerate questions as a draft. Confirming replaces every current question.
    </FluentMessageBar>

    <div class="questions-draft-prompt">
        <FluentTextArea @bind-Value="_prompt"
                        Label="Additional guidance for the AI (optional)"
                        MaxLength="4000"
                        Rows="2"
                        Disabled="@PromptLocked"
                        Placeholder="@PromptPlaceholder"
                        class="full-width" />
    </div>

    @* PB-11: the draft surface keeps its own inline controls (QA-20) and ALSO gets the shared
       prompt-builder dialog plus the same read-only summary line. Composing here writes this
       surface's transient _prompt and never dirties the form. *@
    <div class="cq-composer-config">
        <span class="cq-config-summary" id="cq-draft-config-summary">@ConfigSummary</span>
        <FluentButton Id="cq-draft-configure"
                      Appearance="Appearance.Outline"
                      IconStart="@FluentIcons.Settings"
                      Disabled="@(!GateEnabled || TopicId is null || _busy)"
                      OnClick="OpenPromptDialogAsync"
                      Tooltip="@(TopicId is null ? ConfigureDisabledReason : null)">
            Configure
        </FluentButton>
    </div>

    <div class="questions-draft-row">
        <FluentNumberField @bind-Value="_questionCount"
                           Label="Number of questions"
                           Min="1"
                           Max="30"
                           Class="w-2" />

        <div class="questions-draft-types" role="group" aria-label="Question types">
            <FluentCheckbox @bind-Value="_includeMultipleChoice" Label="Multiple choice" />
            <FluentCheckbox @bind-Value="_includeTrueFalse" Label="True / False" />
            <FluentCheckbox @bind-Value="_includeShortAnswer" Label="Short answer" />
        </div>
    </div>

    <div class="questions-draft-row">
        <FluentNumberField @bind-Value="_difficultyEasy" Label="Easy questions" Min="0" Max="30" Class="w-2" />
        <FluentNumberField @bind-Value="_difficultyMedium" Label="Medium questions" Min="0" Max="30" Class="w-2" />
        <FluentNumberField @bind-Value="_difficultyHard" Label="Hard questions" Min="0" Max="30" Class="w-2" />
    </div>

    <div class="questions-draft-actions">
        <FluentButton Appearance="Appearance.Accent"
                      Disabled="@(!GateEnabled || _busy)"
                      OnClick="GenerateDraftAsync">
            @(_busy ? "Generating…" : "Generate draft")
        </FluentButton>

        @if (_draft is not null)
        {
            <FluentButton Appearance="Appearance.Accent"
                          Disabled="@_busy"
                          OnClick="ConfirmDraftAsync"
                          Class="ms-2">
                Confirm &amp; replace
            </FluentButton>
            <FluentButton Appearance="Appearance.Neutral"
                          Disabled="@_busy"
                          OnClick="DiscardDraftAsync"
                          Class="ms-2">
                Discard draft
            </FluentButton>
        }

        @if (_busy)
        {
            <FluentProgressRing Class="ms-2" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_error</FluentMessageBar>
    }

    @if (!string.IsNullOrEmpty(_attachmentWarning))
    {
        <FluentMessageBar Intent="MessageIntent.Warning" class="mt-2">@_attachmentWarning</FluentMessageBar>
    }

    @if (_draft is not null)
    {
        <ul class="questions-draft-preview">
            @foreach (var (q, index) in _draft.Select((x, i) => (x, i)).ToList())
            {
                <li class="questions-draft-preview-row" @key="q">
                    <span class="questions-draft-preview-text">@(index + 1). @q.QuestionText</span>
                    <FluentBadge Appearance="Appearance.Accent">@EnumHelper.GetDescription(q.QuestionType)</FluentBadge>
                    @if (q.Options is { Count: > 0 })
                    {
                        <ul class="questions-draft-preview-options">
                            @foreach (var opt in q.Options)
                            {
                                <li>@opt.OptionText@(opt.IsCorrect ? " ✓" : "")</li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    }
        </div>
    }
</section>

@code {
    /// <summary>The assignment whose draft is being edited. Draft-only
    /// (rendered by the Edit page only for Draft assignments).</summary>
    [Parameter, EditorRequired] public Guid AssignmentId { get; set; }

    /// <summary>R3 (P1-6/AI-3): the page's form model, read for the staged attachments' extracted
    /// text. This section owns no editor of its own — it borrows the page's rows so attachment
    /// grounding behaves identically on the draft surface and compartment 6.</summary>
    [Parameter, EditorRequired] public AssignmentEditFormModel Model { get; set; } = default!;

    /// <summary>True when the type + grading-format combination supports
    /// AI question generation (FR-220 / EC-3) — the wizard gate mirrored.</summary>
    [Parameter] public bool GateEnabled { get; set; }

    /// <summary>True when the tenant LOCKED the org-level AI prompt
    /// (WS-B2 / spec §3.4 line 70) — disables the guidance textarea.</summary>
    [Parameter] public bool PromptLocked { get; set; }

    /// <summary>The subject id for the generation request; null short-circuits
    /// with a friendly "select a subject" message.</summary>
    [Parameter] public Guid? TopicId { get; set; }

    /// <summary>The subject's display name for the generation request.</summary>
    [Parameter] public string? TopicName { get; set; }

    /// <summary>Raised after Confirm replaces the questions so the Edit page can
    /// reload the summary (question count / review area changes).</summary>
    [Parameter] public EventCallback OnConfirmed { get; set; }

    private int _questionCount = 5;
    private bool _includeMultipleChoice = true;
    private bool _includeTrueFalse = true;
    private bool _includeShortAnswer = true;    private int? _difficultyEasy;
    private int? _difficultyMedium;
    private int? _difficultyHard;
    private string? _prompt;

    /// <summary>QA-4/PB-11: the disabled reason, spelled as the composer spells it.</summary>
    private const string ConfigureDisabledReason = "Select a subject before generating questions.";

    /// <summary>The targeted grades' canonical levels (D18/PB-3), supplied by the page.</summary>
    [Parameter] public IReadOnlyList<int> TargetGradeLevels { get; set; } = [];

    /// <summary>R4 (CP-6/CP-8/D24): the picked strands' display NAMES, matched 1:1 to the picked ids —
    /// they ride the structured <see cref="QuestionGenerationRequest.ContextStrands"/> field, which
    /// the AI host does NOT strip under an org prompt lock. The lesson names
    /// (<see cref="ContextLessonNames"/>) are prompt TEXT only and are therefore dropped for a locked
    /// org (D19/G40) — the same asymmetry the composer documents.</summary>
    [Parameter] public IReadOnlyList<string> ContextStrandNames { get; set; } = [];

    /// <summary>R4 (CP-7/CP-8/D24): the picked lessons' display NAMES — see
    /// <see cref="ContextStrandNames"/>.</summary>
    [Parameter] public IReadOnlyList<string> ContextLessonNames { get; set; } = [];

    /// <summary>PB-11: the same read-only summary line the composer shows, over THIS surface's knobs.</summary>
    private string ConfigSummary => QuestionPromptComposer.ComposeSummary(NarrativeInputs());

    private IReadOnlyList<QuestionTypeDto> SelectedTypes()
    {
        var picked = new List<QuestionTypeDto>(3);
        if (_includeMultipleChoice) picked.Add(QuestionTypeDto.MultipleChoice);
        if (_includeTrueFalse) picked.Add(QuestionTypeDto.TrueFalse);
        if (_includeShortAnswer) picked.Add(QuestionTypeDto.ShortAnswer);
        return picked;
    }

    private IReadOnlyList<string> ResourceNames() =>
        Model.Attachments.Select(a => a.FileName).OfType<string>()
            .Concat(Model.ResourceUrls.Select(r => r.Url))
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .ToList();

    private QuestionPromptNarrativeInputs NarrativeInputs() => new(
        TopicName: TopicName,
        GradeLevels: TargetGradeLevels,
        QuestionCount: _questionCount,
        DifficultyEasy: _difficultyEasy,
        DifficultyMedium: _difficultyMedium,
        DifficultyHard: _difficultyHard,
        Types: SelectedTypes(),
        ResourceNames: ResourceNames(),
        // R4 (CP-8/D24): the same composed-prompt seam as compartment 6 — this surface's context
        // rides the same page-supplied parameters, so no additional wiring is needed here.
        StrandNames: ContextStrandNames,
        LessonNames: PromptLocked ? [] : ContextLessonNames);

    /// <summary>PB-11 + PB-6: the draft surface's dialog opens from THIS surface's own transient
    /// knobs — the composer's persisted-count source (PB-6(i)) deliberately does not apply here.</summary>
    private async Task OpenPromptDialogAsync()
    {
        if (TopicId is null || _busy)
        {
            return;
        }

        var count = _questionCount;
        var multiple = _includeMultipleChoice;
        var trueFalse = _includeTrueFalse;
        var shortAnswer = _includeShortAnswer;

        if (QuestionPromptComposer.TryParse(_prompt, out var parsed))
        {
            count = parsed.QuestionCount;
            multiple = parsed.Types.Contains(QuestionTypeDto.MultipleChoice);
            trueFalse = parsed.Types.Contains(QuestionTypeDto.TrueFalse);
            shortAnswer = parsed.Types.Contains(QuestionTypeDto.ShortAnswer);
        }

        var model = new QuestionPromptModel
        {
            TopicName = TopicName,
            GradeLevels = TargetGradeLevels,
            ResourceNames = ResourceNames(),
            PromptLocked = PromptLocked,
            QuestionCount = count,
            DifficultyEasyCount = _difficultyEasy,
            DifficultyMediumCount = _difficultyMedium,
            DifficultyHardCount = _difficultyHard,
            IncludeMultipleChoice = multiple,
            IncludeTrueFalse = trueFalse,
            IncludeShortAnswer = shortAnswer,
        };

        var result = await DialogService
            .ShowShellDialogAsync<QuestionPromptDialog, QuestionPromptModel, QuestionPromptResult>(
                model, "Configure questions", DialogSize.Medium);

        if (result is null)
        {
            return;
        }

        _questionCount = result.QuestionCount;
        _difficultyEasy = result.DifficultyEasyCount;
        _difficultyMedium = result.DifficultyMediumCount;
        _difficultyHard = result.DifficultyHardCount;
        _includeMultipleChoice = result.IncludeMultipleChoice;
        _includeTrueFalse = result.IncludeTrueFalse;
        _includeShortAnswer = result.IncludeShortAnswer;

        await WriteComposedPromptAsync();
    }

    /// <summary>PB-5 on the draft surface: replace when empty or template-matched, otherwise confirm
    /// (caller-side — <c>dialog-ui</c> forbids nested dialogs). Never touches the form model, so
    /// composing here cannot dirty the form (PB-11).</summary>
    private async Task WriteComposedPromptAsync()
    {
        if (PromptLocked)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_prompt) && !QuestionPromptComposer.IsTemplateMatch(_prompt))
        {
            var replace = await DialogService.ShowConfirmDialogAsync(
                "Replace the prompt guidance you wrote with the generated one? Your text will be overwritten.",
                primaryText: "Replace",
                title: "Replace prompt");

            if (!replace)
            {
                return;
            }
        }

        _prompt = QuestionPromptComposer.Compose(NarrativeInputs());
    }
    private IReadOnlyList<NewQuestionDto>? _draft;
    private bool _busy;
    private string? _error;

    /// <summary>QA-18 (spec §6.3, D12): whether the "Draft preview" disclosure is open. Auto-expanded
    /// whenever a draft is staged — on load, and right after a successful generate.</summary>
    private bool _expanded;

    private void ToggleExpanded() => _expanded = !_expanded;
    private string? _attachmentWarning;
    private CancellationTokenSource? _cts;

    private string? PromptPlaceholder => PromptLocked ? "Your organization has locked the AI prompt." : null;

    /// <summary>R3-2: the draft surface's attachment-budget warning, mirroring the compartment-6 one.
    /// This surface sends no URL texts, so the only action that frees a slot here is removing an
    /// attachment — the message names exactly that.</summary>
    private static string? BuildAttachmentWarning(int droppedAttachmentCount) =>
        droppedAttachmentCount > 0
            ? $"{droppedAttachmentCount} attachment(s) were read but not included in this generation: " +
              $"the {ResourceTextBudget.MaxResourceTexts}-text grounding budget is full. " +
              "Remove an attachment to include them."
            : null;

    protected override async Task OnInitializedAsync()
    {
        // WS-B2: an already-staged draft survives page reloads — render it.
        try
        {
            _draft = await Api.GetQuestionsDraftAsync(AssignmentId);
            // QA-18/D12: a staged draft opens the panel; the load must never CLOSE a panel the
            // author already opened themselves.
            if (_draft is not null)
            {
                _expanded = true;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load the questions draft for assignment {AssignmentId}", AssignmentId);
            _error = "Couldn't load a previously staged draft.";
        }
    }

    private async Task GenerateDraftAsync()
    {
        if (!GateEnabled || _busy)
        {
            return;
        }
        if (_questionCount < 1)
        {
            return;
        }
        if (TopicId is null)
        {
            _error = "Select a subject before generating questions.";
            return;
        }

        _busy = true;
        _error = null;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        IReadOnlyList<GeneratedQuestionType>? types = null;
        var picked = new List<GeneratedQuestionType>(3);
        if (_includeMultipleChoice) picked.Add(QuestionEditorRow.ToGeneratedType(QuestionTypeDto.MultipleChoice));
        if (_includeTrueFalse) picked.Add(QuestionEditorRow.ToGeneratedType(QuestionTypeDto.TrueFalse));
        if (_includeShortAnswer) picked.Add(QuestionEditorRow.ToGeneratedType(QuestionTypeDto.ShortAnswer));
        if (picked.Count > 0) types = picked;

        // R3 (P1-2): the author's actual selection as wire enum names — the shape the header records.
        var requestedTypes = new List<QuestionTypeDto>(3);
        if (_includeMultipleChoice) requestedTypes.Add(QuestionTypeDto.MultipleChoice);
        if (_includeTrueFalse) requestedTypes.Add(QuestionTypeDto.TrueFalse);
        if (_includeShortAnswer) requestedTypes.Add(QuestionTypeDto.ShortAnswer);

        // R3 (P1-6 / AI-3): attachment-derived reference material shares the AI host's budget with
        // the URL texts. The draft section has no URL rows of its own, so attachments fill from slot
        // zero; per-attachment overflow is a fail-open drop. Attachment grounding applies to the
        // draft path too — this is the surface the kebab's "Generate questions" action anchors to.
        // R3-2: the budget reports its own overflow, and that count (never a re-derived one) drives the
        // warning below — an attachment that grounded nothing must not read as if it had.
        var attachmentTexts = Model.Attachments
            .Where(a => a.ExtractionStatus == AttachmentExtractionStatusDto.Succeeded
                && !string.IsNullOrEmpty(a.ExtractedText))
            .Select(a => a.ExtractedText!)
            .ToList();
        var composition = ResourceTextBudget.ComposeWithReport(urlTexts: null, attachmentTexts);
        var resourceTexts = composition.Texts;
        _attachmentWarning = BuildAttachmentWarning(composition.DroppedAttachmentCount);

        var request = new QuestionGenerationRequest(
            TopicId: TopicId!.Value,
            TopicName: TopicName ?? string.Empty,
            // R4 (CP-6/CP-8/D24): the draft surface's generation carries the same picked strand
            // names as compartment 6 — one generation context for both surfaces.
            ContextStrands: ContextStrandNames.Count > 0 ? ContextStrandNames : null,
            QuestionCount: _questionCount,
            Types: types,
            PromptOverride: _prompt,
            DifficultyEasyCount: _difficultyEasy,
            DifficultyMediumCount: _difficultyMedium,
            DifficultyHardCount: _difficultyHard,
            ResourceTexts: resourceTexts);

        try
        {
            var response = await QuestionGenerator.GenerateAsync(request, ct);

            // R3 (D4/P1-2): THIS is the draft-stage write point. The header is recorded before the
            // draft is staged, and its id rides inside the draft blob (NewQuestionDto.GenerationId),
            // so it reaches AddQuestion through ConfirmQuestionsDraftCommandHandler's re-mint.
            var generationId = await Api.RecordQuestionGenerationAsync(
                AssignmentId,
                new RecordQuestionGenerationRequest(
                    QuestionCount: _questionCount,
                    Types: requestedTypes.Count > 0 ? requestedTypes : null,
                    DifficultyEasyCount: _difficultyEasy,
                    DifficultyMediumCount: _difficultyMedium,
                    DifficultyHardCount: _difficultyHard,
                    // P1-1: the AI host's own resolved tuple, relayed — the author never names a model.
                    Provider: response.Provider,
                    Model: response.Model),
                ct);

            var draft = new List<NewQuestionDto>(response.Questions.Count);
            for (var i = 0; i < response.Questions.Count; i++)
            {
                draft.Add(GeneratedQuestionMapper.ToNewQuestionDto(response.Questions[i]) with
                {
                    DisplayOrder = i,
                    GenerationId = generationId,
                });
            }
            await Api.StageQuestionsDraftAsync(AssignmentId, draft, ct);
            _draft = draft;
            _expanded = true;
        }
        catch (QuestionGenerationFailed ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            // EC-2: cancel leaves any prior draft untouched.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate the questions draft for assignment {AssignmentId}", AssignmentId);
            _error = "Something went wrong while generating the draft. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmDraftAsync()
    {
        if (_busy || _draft is null)
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            await Api.ConfirmQuestionsDraftAsync(AssignmentId, _cts?.Token ?? default);
            _draft = null;
            await OnConfirmed.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to confirm the questions draft for assignment {AssignmentId}", AssignmentId);
            _error = "Couldn't confirm the draft. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiscardDraftAsync()
    {
        if (_busy || _draft is null)
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            await Api.DiscardQuestionsDraftAsync(AssignmentId, _cts?.Token ?? default);
            _draft = null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to discard the questions draft for assignment {AssignmentId}", AssignmentId);
            _error = "Couldn't discard the draft. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
