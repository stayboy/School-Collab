@* Recording materials (spec recording-materials D3/D7/D8/D9) — the INLINE recorder. One shape, two
   owners (the assignment page's kebab and a question's instruction list), so it is a plain
   presentational panel, NOT a dialog (dialog-ui §4 forbids a nested dialog, and the question dialog is
   itself a DialogShellBase — hence D12's revision of the original "dedicated dialog").

   Flow: capability probe → permission + live preview → record / stop → preview → retake or commit.
   Commit delivers the take to the host's staging seam as a Stream through the hidden InputFile (the SAME
   path an uploaded media file takes), so the list stays the single writer of its rows and nothing about
   staging changes — and no bytes ever cross the circuit as one oversized byte[] interop call.

   All getUserMedia/MediaRecorder work lives in the collocated RecorderPanel.razor.js module, loaded
   lazily and owned here (disposed, with the device tracks released, on teardown — AC-10). *@
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Assignments.Contracts
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="recorder-panel" id="@Id">
    @* Round-recorder-takeover (Q3, AC-2): the panel fills its whole container, so the header bar —
       title + labeled Cancel — IS the close affordance. Rendered UNCONDITIONALLY, before the probe
       branches, so Cancel stays reachable in the unsupported and pre-probe states too. *@
    <div class="recorder-header">
        @* Owner request 2026-10-15 (grill Q10): the title and the host's optional action share a
           leading group, so the action reads as BESIDE the title rather than floating between it and
           Cancel. The panel owns this layout; the action itself is the host's. *@
        <div class="recorder-header-leading">
            <span class="recorder-title" id="@($"{Id}-title")">@(IsVideo ? "Recording video" : "Recording audio")</span>
            @if (HeaderAction is not null)
            {
                @HeaderAction
            }
        </div>
        <FluentButton Appearance="ButtonAppearance.Default"
                      Id="@($"{Id}-cancel")"
                      IconStart="@FluentIcons.Dismiss"
                      OnClick="CancelAsync">
            Cancel
        </FluentButton>
    </div>
    @* D8: an insecure context or a browser without getUserMedia shows the capability reason and never
       renders controls that could only fail. Until the first-render probe resolves the panel renders
       neither branch — otherwise the unsupported message would flash before we know the capability. *@
    @* Owner pill rework (2026-10-12): a REOPENED review (the list's play pill seeded this panel with
       the session-held take) renders the SAME player and the same Record again button — but never
       "Use this recording" (there is no fresh Blob to commit; the take is already staged). It renders
       AHEAD of the capability branches: playback needs no getUserMedia capability. *@
    @if (_reopened && _state == RecorderState.Review)
    {
        @if (_previewUrl is not null)
        {
            @if (IsVideo)
            {
                <video id="@($"{Id}-preview-take")" class="recorder-preview" controls src="@_previewUrl"></video>
            }
            else
            {
                <audio id="@($"{Id}-preview-take")" class="recorder-audio" controls src="@_previewUrl"></audio>
            }
        }
        <div class="recorder-controls">
            <FluentButton Appearance="ButtonAppearance.Default"
                          Id="@($"{Id}-retake")"
                          IconStart="@FluentIcons.ArrowClockwise"
                          OnClick="RetakeAsync">
                Record again
            </FluentButton>
        </div>
    }
    else if (_probed && !_supported)
    {
        <p class="recorder-unsupported" id="@($"{Id}-unsupported")">
            Recording needs a secure (https) connection and a microphone@(IsVideo ? "/camera" : "").
            Use <strong>Upload From Device</strong> instead.
        </p>
    }
    else if (_probed)
    {
        @* Live preview: the <video> the JS module binds the camera stream to (video kind). Audio has no
           visual stream, so no preview element renders. Owner rework (2026-10-12): the element STAYS in
           the DOM through Review (RetakeAsync's startCapture re-binds it by id) but is HIDDEN there —
           endRecording already released the tracks, so in Review it would only show the frozen last
           frame beside the take's player (the awkward leftover pane the owner reported). *@
        @if (IsVideo)
        {
            <video id="@($"{Id}-preview")" class="recorder-preview" playsinline muted hidden="@(_state == RecorderState.Review)"></video>
        }

        @* Owner rework (2026-10-12): the take plays in its OWN full-width block — never squeezed into
           the controls row (flex, wrap), where the player sat side-by-side with the badge and buttons. *@
        @if (_state == RecorderState.Review && _previewUrl is not null)
        {
            @* AC-3 (D3): preview the take BEFORE committing — the author hears/sees what was captured
               and retakes without leaving the panel. A Blob URL, so playback is local and instant. *@
            @if (IsVideo)
            {
                <video id="@($"{Id}-preview-take")" class="recorder-preview" controls src="@_previewUrl"></video>
            }
            else
            {
                <audio id="@($"{Id}-preview-take")" class="recorder-audio" controls src="@_previewUrl"></audio>
            }
        }

        <div class="recorder-controls">
            @if (_state == RecorderState.Idle)
            {
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Id="@($"{Id}-start")"
                              IconStart="@(IsVideo ? new Icons.Regular.Size20.Video() : FluentIcons.Mic)"
                              OnClick="StartAsync">
                    @(IsVideo ? "Start recording" : "Start recording audio")
                </FluentButton>
            }
            else if (_state == RecorderState.Recording)
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Class="recorder-live">● Recording @_elapsed</FluentBadge>
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Id="@($"{Id}-stop")"
                              IconStart="@FluentIcons.Dismiss"
                              OnClick="StopAsync">
                    Stop
                </FluentButton>
            }
            else if (_state == RecorderState.Review)
            {
                <FluentBadge Appearance="BadgeAppearance.Filled">@AttachmentUploadPolicy.FormatFileSize(_recordedSize)</FluentBadge>
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Id="@($"{Id}-commit")"
                              IconStart="@FluentIcons.Checkmark"
                              Disabled="@_committing"
                              OnClick="CommitAsync">
                    @(_committing ? "Adding…" : "Use this recording")
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default"
                              Id="@($"{Id}-retake")"
                              IconStart="@FluentIcons.ArrowClockwise"
                              OnClick="RetakeAsync">
                    Record again
                </FluentButton>
            }
        </div>

        @* D3 delivery seam: the recorded take stays in the browser as a Blob and is delivered by writing
           it into this hidden InputFile — its OnChange streams the content to .NET through
           IBrowserFile.OpenReadStream in bounded circuit chunks. Marshalling the whole recording as a
           single byte[] JS→.NET interop call is BLOCKED in Blazor Server (the hub's
           MaximumReceiveMessageSize caps a lone byte-array transfer — dotnet/aspnetcore#38941); this is
           the same proven 100MiB streaming path FluentInputFile uploads already take. *@
        <div class="recorder-delivery" id="@($"{Id}-delivery")" hidden>
            <InputFile OnChange="OnFileChosenAsync" />
        </div>
    }

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Class="recorder-error">@_error</FluentMessageBar>
    }
</div>

@code {
    /// <summary>The recorder's lifecycle. Idle → Recording → Review; Commit returns to Idle (the row is
    /// now staged, so the host replaces this panel with the file readout).</summary>
    private enum RecorderState { Idle, Recording, Review }

    /// <summary>The container id stem — the bUnit seam and the JS preview-element id.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    /// <summary>The collocated capture module, served from this RCL's static-web-asset root
    /// (<c>_content/{assembly}/…</c> — the <c>AssignmentAuthoring.razor.js</c> precedent). A bare
    /// <c>./Components/…</c> path 404s at runtime.</summary>
    private const string ModulePath =
        "./_content/SchoolCollab.Assignments.Application/Components/Pages/Assignments/RecorderPanel.razor.js";

    /// <summary>Owner request 2026-10-15 (grill Q10): an optional action rendered beside the header
    /// title. The panel owns the header's LAYOUT, the host owns the action — the seeded review's
    /// "Edit Note" link lives in the list, which owns the metadata dialog.</summary>
    [Parameter] public RenderFragment? HeaderAction { get; set; }

    /// <summary>Audio or Video — drives the device constraints and the preview element.</summary>
    [Parameter, EditorRequired] public bool IsVideo { get; set; }

    /// <summary>The host's staging seam (the <c>StageInstructionMediaAsync</c> delegate the shared editor
    /// already threads). Commit streams the recorded take here as a <see cref="Stream"/> (never a marshalled
    /// byte[] — see the delivery seam); the host owns a refusal (returns null).</summary>
    [Parameter] public EventCallback<RecordedMedia> OnRecorded { get; set; }

    /// <summary>Round-recorder-takeover (Q3/Q5): notified when the author cancels — the host closes
    /// the takeover (unmounting this panel) and the list restores itself. The panel resets its own
    /// state first (see <see cref="CancelAsync"/>) so a cancel never leaves a stale take behind.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private IJSObjectReference? _module;
    private RecorderState _state = RecorderState.Idle;
    private bool _probed;
    private bool _supported;
    private bool _committing;
    // Set the moment this panel is torn down. The commit path can still be awaiting OnRecorded when the
    // HOST unmounts the panel (staging succeeds → the row's readout replaces it), so every later StateHasChanged
    // or JS call must be skipped rather than run against a disposed module.
    private bool _disposed;
    private string? _error;
    private string? _recordedContentType;
    private string? _recordedFileName;
    private string? _previewUrl;
    private long _recordedSize;
    /// <summary>Owner pill rework (2026-10-12): the take's duration in seconds, probed from the Blob
    /// once its metadata loads; null when the probe failed or timed out.</summary>
    private double? _durationSeconds;
    /// <summary>True when the panel owns <see cref="_previewUrl"/> and must revoke it; false for a
    /// SEEDED (reopened) URL or one handed to the host's session map — neither is ours to revoke.</summary>
    private bool _ownsPreviewUrl;
    /// <summary>Hold verdict 2026-10-12 (finding 3): a retake started from a REOPENED review has no
    /// <c>{Id}-preview</c> element in the DOM when StartAsync's startCapture runs (the reopened branch
    /// renders only the take's player), so its bind-by-id is a silent no-op. This flag defers the bind
    /// to OnAfterRenderAsync, once the recording branch has rendered the live preview element.</summary>
    private bool _needPreviewBind;
    /// <summary>True once the host reopens this panel for a staged take's playback (the list's play
    /// pill). The panel then renders only the player + Record again — never the commit button.</summary>
    private bool _reopened;
    private ReviewSeed? _appliedSeed;

    /// <summary>Owner request 2026-10-15 (grill Q15): a SEEDED review (the list's play click) opens
    /// already playing, so the author clicks play once rather than twice. Armed when the seed is
    /// applied and spent by the first render that can reach the module — never on a post-record review
    /// or a retake, which keep their manual player (the author is checking their own fresh take).</summary>
    private bool _needAutoPlay;

    /// <summary>Owner pill rework (2026-10-12): the host's seed for REOPENING this panel as the staged
    /// take's preview player (the list's play pill). A new instance reopens; null closes the reopen.</summary>
    [Parameter] public ReviewSeed? Seed { get; set; }

    /// <summary>The reopened-review payload: the session-held Blob URL plus the take's identity.</summary>
    public sealed record ReviewSeed(string PreviewUrl, string FileName, long FileSize);

    /// <summary>Applies the host's seed once per instance (reference-guarded), entering Review with the
    /// URL-owned-by-host posture; state changes after that (retake) are the panel's own. The seed is
    /// CONSUMED when it arrives, whether or not it applies: it OPENS a review and never replaces the
    /// take the panel is already reviewing — the author's own handed-off take (AC-4) or a commit in
    /// flight — so a later render cannot re-open it under a retake that has moved on.</summary>
    protected override void OnParametersSet()
    {
        if (Seed is null || ReferenceEquals(Seed, _appliedSeed))
        {
            return;
        }

        _appliedSeed = Seed;
        if (_committing || _state == RecorderState.Review)
        {
            return;
        }

        _reopened = true;
        // Grill Q15: this is the ONLY entry that auto-plays — a seed means the list's play click.
        _needAutoPlay = true;
        _ownsPreviewUrl = false;
        _previewUrl = Seed.PreviewUrl;
        _recordedFileName = Seed.FileName;
        _recordedSize = Seed.FileSize;
        _durationSeconds = null;
        _state = RecorderState.Review;
    }
    private string _elapsed = "0:00";
    private System.Timers.Timer? _ticker;
    private DateTime _startedAt;

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Hold verdict 2026-10-12 (finding 3): the deferred live-preview re-bind — the recording branch
        // (and its {Id}-preview element) only renders after StartAsync returns, so the reopened-retake
        // path binds here. Best-effort by design: a failed bind never blocks the take itself.
        if (_needPreviewBind && _module is not null && _state == RecorderState.Recording)
        {
            // Clear only when the bind actually runs: a render landing while StartAsync still awaits
            // interop (module not yet imported, or state still Idle) must keep the flag for the next
            // render, or the live preview stays unbound for the whole take (P3 residual, 2026-10-12).
            _needPreviewBind = false;
            try
            {
                await _module.InvokeVoidAsync("bindPreview", $"{Id}-preview", IsVideo);
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        // Grill Q15 (owner 2026-10-15): a SEEDED review auto-plays once it is switched in, so the
        // list's play click is one click rather than two. Guarded on _reopened so the post-record
        // review and the retake keep their manual player, and cleared only when the call actually runs
        // — the first render lands BEFORE the module import below, so the flag must survive it (the
        // _needPreviewBind rule above, for the same reason).
        if (_needAutoPlay && _reopened && _state == RecorderState.Review && _module is not null)
        {
            _needAutoPlay = false;
            try
            {
                await _module.InvokeVoidAsync("playPreview", $"{Id}-preview-take");
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            // Collocated *.razor.js in an RCL is served from the static-web-asset root
            // (_content/{assembly}/…), the AssignmentAuthoring.razor.js / fileDownload.js precedent —
            // a bare ./Components/... path 404s at runtime (bUnit loose mode would mask it).
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", ModulePath);
            _supported = await _module.InvokeAsync<bool>("isSupported");
        }
        catch (JSDisconnectedException)
        {
            // Circuit closed before the probe resolved — nothing to render.
            return;
        }
        catch (JSException)
        {
            // The module failed to load (or the probe threw): unsupported — the panel renders the
            // capability message pointing at Upload From Device rather than a dead control.
            _supported = false;
        }
        finally
        {
            _probed = true;
            StateHasChanged();
        }
    }

    private async Task StartAsync()
    {
        if (_module is null) return;
        _error = null;
        try
        {
            // D7: pass the byte-stop so the JS module halts a take before it can be lost to a 413.
            await _module.InvokeVoidAsync("startCapture", $"{Id}-preview", IsVideo, (double)AttachmentUploadPolicy.RecorderAutoStopBytes);
            await _module.InvokeVoidAsync("beginRecording");
            _state = RecorderState.Recording;
            _startedAt = DateTime.UtcNow;
            StartTicker();
            StateHasChanged();
        }
        catch (JSException ex)
        {
            _error = CaptureErrorMessage(ex.Message);
            StateHasChanged();
        }
    }

    private async Task StopAsync()
    {
        if (_module is null) return;
        StopTicker();
        try
        {
            // Metadata only — the take itself stays in the browser as a Blob (see the delivery seam).
            var result = await _module.InvokeAsync<RecordedMediaResult>("endRecording", IsVideo);
            _recordedContentType = result.ContentType;
            _recordedFileName = result.FileName;
            _recordedSize = result.Size;
            // AC-3: the take plays back locally (a Blob URL) before the author commits or retakes.
            _previewUrl = await _module.InvokeAsync<string>("createPreviewUrl");
            // Owner pill rework (2026-10-12): probe the duration for the row's play pill (null on any
            // failure — the pill falls back gracefully).
            try
            {
                _durationSeconds = await _module.InvokeAsync<double?>("mediaDuration", _previewUrl);
            }
            catch (JSException)
            {
                _durationSeconds = null;
            }

            _ownsPreviewUrl = true;
            _state = RecorderState.Review;
            StateHasChanged();
        }
        catch (JSException ex)
        {
            _error = CaptureErrorMessage(ex.Message);
            _state = RecorderState.Idle;
            StateHasChanged();
        }
    }

    /// <summary>D3 commit trigger: hands the browser-held Blob to the hidden <c>InputFile</c> (JS wraps
    /// it as a File and dispatches change). The ACTUAL staging happens in <see cref="OnFileChosenAsync"/>
    /// — the streaming path — because marshalling the whole take as one byte[] is blocked in Blazor
    /// Server (dotnet/aspnetcore#38941). This just flips to the "Adding…" state and fires the delivery;
    /// the OnChange handler completes the commit.</summary>
    private async Task CommitAsync()
    {
        if (_recordedFileName is null) return;
        if (_module is null)
        {
            _error = CaptureErrorMessage("unsupported");
            return;
        }

        _committing = true;
        _error = null;
        StateHasChanged();
        try
        {
            await _module.InvokeVoidAsync("commitBlob", $"#{Id}-delivery input[type=\"file\"]", _recordedFileName);
        }
        catch (JSException ex)
        {
            _committing = false;
            _error = CaptureErrorMessage(ex.Message);
            StateHasChanged();
        }
    }

    /// <summary>The delivery seam: the hidden <c>InputFile</c> now holds the recorded take as a File, and
    /// its content streams to .NET through <see cref="IBrowserFile.OpenReadStream"/> — bounded circuit
    /// chunks, the path this repo already moves 100MiB uploads over. The stream is handed to the host's
    /// staging seam, then the panel resets.</summary>
    private async Task OnFileChosenAsync(InputFileChangeEventArgs args)
    {
        if (_recordedFileName is null)
        {
            _committing = false;
            return;
        }

        _error = null;
        try
        {
            var file = args.File;
            // Explicit maxAllowedSize: the default (500KB) would reject any real recording.
            await using var stream = file.OpenReadStream(AttachmentUploadPolicy.MaxFileSizeBytes);
            var contentType = string.IsNullOrWhiteSpace(file.ContentType)
                ? (_recordedContentType ?? "application/octet-stream")
                : file.ContentType;
            // Hold verdict 2026-10-12 (P1): the host stores the preview URL in its session map (the
            // pill replays from it) and unmounts this panel BEFORE its staging call returns — the
            // after-await ownership flip never ran on the mainline commit path, and the panel's
            // DisposeAsync then revoked the very URL the row's pill points at. Flip ownership BEFORE
            // the await, carrying the URL to the host in a local.
            var previewUrl = _previewUrl;
            _ownsPreviewUrl = false;
            await OnRecorded.InvokeAsync(
                new RecordedMedia(stream, file.Name, contentType, file.Size, previewUrl, _durationSeconds));
            // Round media-pill-listing (AC-4): the host either COMMITTED the take — unmounting this
            // panel the moment staging succeeded (the P1 invariant above) — or it HELD it, because its
            // metadata dialog was cancelled. A held take stays with the review: the player, "Record
            // again", and a second "Use this recording" (the module keeps the Blob for exactly that
            // retry). So nothing resets here — resetting a held take is what dropped it, and a
            // committed take's panel is torn down regardless. The URL is no longer ours to revoke
            // (ownership flipped above): the host's pending take owns it.
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException or TimeoutException)
        {
            // A refusal (too large, stream failed) is surfaced, never swallowed — the panel stays in
            // Review so the author can retake or use Upload From Device. A TimeoutException is the
            // stalled/failed stream (the Blazor Server data stream gave up): surfaced on this same
            // line, never left to terminate the circuit.
            _error = ex is IOException
                ? "That recording is too large to add. Try a shorter take, or use Upload From Device."
                : CaptureErrorMessage(ex.Message);
        }
        finally
        {
            _committing = false;
            // The host may have unmounted this panel the moment staging succeeded (the row's readout
            // replaced it) — never re-render a disposed component.
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private async Task RetakeAsync()
    {
        // Hold verdict 2026-10-12 (finding 3): only a retake FROM the reopened branch needs the
        // deferred bind — in-session Review keeps the (hidden) preview element in the DOM and
        // startCapture re-binds it by id directly.
        var fromReopened = _reopened;
        Reset();
        if (fromReopened)
        {
            _needPreviewBind = true;
        }

        await StartAsync();
    }

    private void Reset()
    {
        StopTicker();
        _recordedContentType = null;
        _recordedFileName = null;
        _recordedSize = 0;
        _state = RecorderState.Idle;
        _elapsed = "0:00";
        // Free the preview object URL (and the held Blob) — a discarded take must not leak memory.
        // A SEEDED (reopened) URL or one handed to the host's session map is NOT ours to revoke.
        if (_previewUrl is not null && _ownsPreviewUrl)
        {
            var url = _previewUrl;
            _previewUrl = null;
            _ = RevokePreviewAsync(url);
        }

        _previewUrl = null;
        _ownsPreviewUrl = false;
        _reopened = false;
        _durationSeconds = null;
    }

    /// <summary>Round-recorder-takeover (Q5): Cancel stops the live capture, discards the take (Blob +
    /// preview URL revoked, state back to Idle) and tells the host via <see cref="OnClose"/> — the host
    /// unmounts the panel, so this does NOT dispose; <see cref="DisposeAsync"/> stays the single
    /// (idempotent-guarded) teardown path.</summary>
    private async Task CancelAsync()
    {
        if (_disposed) return;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stopCapture"); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            try { await _module.InvokeVoidAsync("clearBlob"); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
        }
        // Reset() stops the ticker, zeroes the recorded metadata/elapsed and revokes the preview URL;
        // _error is this method's to clear.
        Reset();
        _error = null;
        await OnClose.InvokeAsync();
    }

    private async Task RevokePreviewAsync(string url)
    {
        var module = _module;
        if (module is null) return;
        try { await module.InvokeVoidAsync("revokePreviewUrl", url); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private void StartTicker()
    {
        StopTicker();
        _ticker = new System.Timers.Timer(1000);
        _ticker.Elapsed += (_, _) =>
        {
            var span = DateTime.UtcNow - _startedAt;
            _elapsed = $"{(int)span.TotalMinutes}:{span.Seconds:D2}";
            InvokeAsync(StateHasChanged);
        };
        _ticker.Start();
    }

    private void StopTicker()
    {
        if (_ticker is not null)
        {
            _ticker.Stop();
            _ticker.Dispose();
            _ticker = null;
        }
    }

    /// <summary>Maps a JS capture failure code to an author-facing message (D8 — a denied permission or a
    /// missing device is named, never a dead end).</summary>
    private static string CaptureErrorMessage(string? code) => code switch
    {
        "denied" => "Microphone/camera access was denied. Allow it in your browser, or use Upload From Device.",
        "notfound" => "No microphone/camera was found. Connect one, or use Upload From Device.",
        "insecure" => "Recording needs a secure (https) connection. Use Upload From Device instead.",
        "unsupported" => "This browser can't record here. Use Upload From Device instead.",
        _ => "Recording could not start. Please try again, or use Upload From Device.",
    };

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopTicker();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stopCapture"); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            try { await _module.InvokeVoidAsync("clearBlob"); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            // Hold verdict 2026-10-12 (P1): guard the teardown revoke — a SEEDED (reopened) URL and one
            // the commit already handed to the host's session map are not this panel's to revoke.
            if (_previewUrl is not null && _ownsPreviewUrl)
            {
                var url = _previewUrl;
                _previewUrl = null;
                try { await _module.InvokeVoidAsync("revokePreviewUrl", url); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            }

            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _module = null;
        }
    }

    /// <summary>The recorded take handed to the host's staging seam — same shape
    /// <c>StageInstructionMediaAsync</c> consumes for an upload. <c>PreviewUrl</c>/<c>DurationSeconds</c>
    /// (owner pill rework, 2026-10-12) let the host keep the session-held Blob URL for the row's play
    /// pill; neither is persisted anywhere.</summary>
    public sealed record RecordedMedia(Stream Content, string FileName, string ContentType, long FileSize,
        string? PreviewUrl = null, double? DurationSeconds = null);

    /// <summary>The JS module's <c>endRecording</c> return: metadata only. The take's BYTES never cross
    /// interop — Blazor Server blocks a single large byte[] transfer (dotnet/aspnetcore#38941), so the
    /// Blob stays in the browser and streams to .NET via the hidden <c>InputFile</c> instead.</summary>
    private sealed class RecordedMediaResult
    {
        public string ContentType { get; set; } = "";
        public string FileName { get; set; } = "";
        public long Size { get; set; }
    }
}

