@page "/assignments/{Id:guid}/edit"
@using SchoolCollab.Assignments.Contracts
@using Microsoft.FluentUI.AspNetCore.Components
@inject AssignmentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Edit> Logger
@implements IDisposable

<PageTitle>Edit @_item?.Title</PageTitle>
<h2>Edit Assignment</h2>

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (_item is null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">Assignment not found or is not in Draft status.</FluentMessageBar>
        }
        else if (_item.Status != AssignmentStatusDto.Draft)
        {
            <FluentMessageBar Intent="MessageIntent.Warning">Only Draft assignments can be edited.</FluentMessageBar>
            <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="mt-2">Back to List</FluentButton>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form-container">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <FormRow Label="Title" Required For="assignmentEditTitle">
                    <FluentTextField Id="assignmentEditTitle" @bind-Value="_model.Title" Required class="full-width" />
                </FormRow>
                <FormRow Label="Description" For="assignmentEditDescription">
                    <FluentTextArea Id="assignmentEditDescription" @bind-Value="_model.Description" Rows="3" class="full-width" />
                </FormRow>

                <FormRow Label="Assignment Type" Required For="assignmentEditType">
                    <FluentSelect TItem="AssignmentTypeOption"
                                  Id="assignmentEditType"
                                  Items="@_typeOptions"
                                  @bind-SelectedOption="_selectedType"
                                  OptionText="@(o => o.Label)"
                                  OptionValue="@(o => o.Value)"
                                  class="full-width" />
                </FormRow>

                <FormRow Label="Grading Format" For="assignmentEditGrading">
                    <FluentSelect TItem="GradingFormatOption"
                                  Id="assignmentEditGrading"
                                  Items="@_gradingFormatOptions"
                                  @bind-SelectedOption="_selectedGradingFormat"
                                  OptionText="@(o => o.Label)"
                                  OptionValue="@(o => o.Value)"
                                  class="full-width" />
                </FormRow>

                <FormRow Label="Target Audience" For="assignmentEditAudience">
                    <FluentSelect TItem="TargetAudienceOption"
                                  Id="assignmentEditAudience"
                                  Items="@_targetAudienceOptions"
                                  @bind-SelectedOption="_selectedTargetAudience"
                                  OptionText="@(o => o.Label)"
                                  OptionValue="@(o => o.Value)"
                                  class="full-width" />
                </FormRow>

                <FormRow Label="Due Date" For="assignmentEditDue">
                    <FluentDatePicker Id="assignmentEditDue" @bind-Value="_model.DueDate" class="full-width" />
                </FormRow>
                <FormRow Label="Max Score" For="assignmentEditMaxScore">
                    <FluentNumberField Id="assignmentEditMaxScore" @bind-Value="_model.MaxScore" class="narrow-field" />
                </FormRow>
                <FormRow Label="Guardian review" For="assignmentEditMandatoryReview">
                    <FluentCheckbox Id="assignmentEditMandatoryReview" @bind-Value="_mandatoryReview" Label="Require guardian review before student submits" />
                </FormRow>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_error</FluentMessageBar>
                }

                <div>
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="ms-2">Cancel</FluentButton>
                </div>
            </EditForm>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public Guid Id { get; set; }

    private AssignmentSummaryDto? _item;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private bool _mandatoryReview = true;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private record AssignmentTypeOption(string Value, string Label);
    private readonly AssignmentTypeOption[] _typeOptions =
    [
        new(((int)AssignmentTypeDto.Digital).ToString(), "Online"),
        new(((int)AssignmentTypeDto.SemiManual).ToString(), "Hybrid"),
        new(((int)AssignmentTypeDto.Manual).ToString(), "Offline")
    ];
    private AssignmentTypeOption? _selectedType;

    private record GradingFormatOption(string Value, string Label);
    private readonly GradingFormatOption[] _gradingFormatOptions =
    [
        new(((int)GradingFormatDto.TeacherGraded).ToString(), "Teacher Graded"),
        new(((int)GradingFormatDto.AutoGraded).ToString(), "Auto Graded"),
        new(((int)GradingFormatDto.InstantGraded).ToString(), "Instant Graded")
    ];
    private GradingFormatOption? _selectedGradingFormat;

    private record TargetAudienceOption(string Value, string Label);
    private readonly TargetAudienceOption[] _targetAudienceOptions =
    [
        new(((int)TargetAudienceTypeDto.AllStudents).ToString(), "All Students"),
        new(((int)TargetAudienceTypeDto.SelectedGrades).ToString(), "Selected Grades"),
        new(((int)TargetAudienceTypeDto.SelectedGroups).ToString(), "Selected Groups")
    ];
    private TargetAudienceOption? _selectedTargetAudience;

    private readonly AssignmentEditFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            Logger.LogInformation("Loading assignment {AssignmentId} for edit", Id);
            _item = await Api.GetByIdAsync(Id, ct);
            if (_disposed) return;

            if (_item is not null && _item.Status == AssignmentStatusDto.Draft)
            {
                // Project the assignment DTO into the shared form model via the
                // tested on-model mapping (AssignmentEditFormModel.LoadFrom).
                _model.LoadFrom(_item);
                _mandatoryReview = _item.MandatoryReview;
                _selectedType = _typeOptions.FirstOrDefault(o => o.Value == ((int)_item.AssignmentType).ToString());
                _selectedGradingFormat = _gradingFormatOptions.FirstOrDefault(o => o.Value == ((int)_item.GradingFormat).ToString());
                _selectedTargetAudience = _targetAudienceOptions.FirstOrDefault(o => o.Value == ((int)_item.TargetAudienceType).ToString());
            }

            Logger.LogInformation("Loaded assignment {AssignmentId} for edit", Id);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load assignment {AssignmentId}", Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            if (_selectedType is null)
            {
                _error = "Assignment Type is required.";
                return;
            }
            if (_selectedGradingFormat is null)
            {
                _error = "Grading Format is required.";
                return;
            }
            if (_selectedTargetAudience is null)
            {
                _error = "Target Audience is required.";
                return;
            }

            Logger.LogInformation("Updating assignment {AssignmentId}", Id);

            var req = new UpdateAssignmentRequest(
                _model.Title!,
                _model.Description,
                (AssignmentTypeDto)int.Parse(_selectedType!.Value),
                _selectedGradingFormat is not null ? (GradingFormatDto)int.Parse(_selectedGradingFormat.Value) : _item!.GradingFormat,
                _selectedTargetAudience is not null ? (TargetAudienceTypeDto)int.Parse(_selectedTargetAudience.Value) : _item!.TargetAudienceType,
                _item!.TopicId,
                _item.GradeLevelId,
                _model.DueDate.HasValue ? new DateTimeOffset(_model.DueDate.Value, TimeSpan.Zero) : null,
                _model.MaxScore,
                _mandatoryReview);

            await Api.UpdateAsync(Id, req, ct);
            Nav.NavigateTo("/assignments");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to update assignment {AssignmentId}", Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/assignments");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

}