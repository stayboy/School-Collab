@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Assignments.Application.Helpers
@implements IDisposable
@inject IDialogService DialogService
@inject ILogger<QuestionEditorSection> Logger

@* Spec §6.2 (round content-questions-modern-ui): the question list is a single-line,
   hairline-separated row list — the reference project page's shape. The question text is the
   "open" target and the trailing kebab holds Edit / Remove; editing happens in the shared
   QuestionEditDialog, NOT inline (decision D4, invariant X-9). The per-type fields moved to the
   dialog verbatim. *@
<section class="question-editor-section">
    <div class="cq-list-head">
        <span class="cq-list-count">@Model.Questions.Count question(s)</span>
        <FluentButton Id="cq-add-question"
                      Appearance="Appearance.Outline"
                      IconStart="@FluentIcons.Add"
                      OnClick="OnAddQuestionAsync">
            Add question
        </FluentButton>
    </div>

    @if (Model.Questions.Count == 0)
    {
        @* QA-15/X-6: the long-standing empty-state string is retained. *@
        <p class="cq-empty">No questions yet. Add a question to get started.</p>
    }
    else
    {
        <ul class="cq-qrows" id="cq-question-list">
            @foreach (var (row, index) in _currentPage.Select((r, i) => (r, i)))
            {
                var absoluteIndex = _paginationState.CurrentPageIndex * AssignmentEditFormModel.QuestionPageSize + index;
                <li class="cq-qrow" id="@($"cq-qrow-{absoluteIndex}")" @key="row">
                    <span class="cq-qrow-position">#@(absoluteIndex + 1)</span>
                    @* QA-9/QA-12: a real anchor so the open target is keyboard reachable; the row
                       itself is NOT a button (a button nested in a clickable row is invalid). *@
                    <FluentAnchor Appearance="Appearance.Hypertext"
                                  Href="#"
                                  Id="@($"cq-qrow-{absoluteIndex}-open")"
                                  Class="cq-qrow-open"
                                  Title="@(string.IsNullOrWhiteSpace(row.QuestionText) ? "Untitled question" : row.QuestionText)"
                                  OnClick="@(() => OpenEditAsync(absoluteIndex, row))">
                        @(string.IsNullOrWhiteSpace(row.QuestionText) ? "Untitled question" : row.QuestionText)
                    </FluentAnchor>
                    <FluentBadge Appearance="Appearance.Accent">@EnumHelper.GetDescription(row.Type)</FluentBadge>
                    @* QA-16/D13: always in the DOM, revealed on hover / focus-within by CSS. *@
                    <span class="cq-qrow-actions" id="@($"cq-qrow-{absoluteIndex}-actions")">
                        <RowActionsMenu UseMenuService="false"
                                        ForceKebab="true"
                                        AriaLabel="@($"Question {absoluteIndex + 1} actions")"
                                        Actions="ActionsFor(absoluteIndex, row)" />
                    </span>
                </li>
            }
        </ul>

        <FluentPaginator State="@_paginationState" />
    }
</section>

@code {
    /// <summary>The form model that owns the question list being edited.</summary>
    [Parameter, EditorRequired] public AssignmentEditFormModel Model { get; set; } = default!;

    /// <summary>Raised when the model was mutated (add / remove / dialog-confirmed edit) so the page
    /// can re-render review counts and the submit gate.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private readonly PaginationState _paginationState = new()
    {
        ItemsPerPage = AssignmentEditFormModel.QuestionPageSize,
    };
    private IReadOnlyList<QuestionEditorRow> _currentPage = [];

    protected override void OnParametersSet()
    {
        // Track the paginator's total so it follows appends/removals (FR-240).
        _ = _paginationState.SetTotalItemCountAsync(Model.Questions.Count);
        if (_paginationState.CurrentPageIndex >= Model.QuestionPageCount())
        {
            _ = _paginationState.SetCurrentPageIndexAsync(Math.Max(0, Model.QuestionPageCount() - 1));
        }
        _currentPage = Model.GetQuestionPage(_paginationState.CurrentPageIndex);
    }

    /// <summary>Appends a blank MultipleChoice row and moves to it. Unchanged from the inline
    /// editor: Add produces a row whose fields are then edited through the row's own Edit action.</summary>
    public async Task OnAddQuestionAsync()
    {
        Model.AddQuestion(QuestionEditorRow.NewMultipleChoice());
        await _paginationState.SetCurrentPageIndexAsync(Model.QuestionPageCount() - 1);
        await Changed.InvokeAsync();
    }

    /// <summary>QA-10: Edit opens the dialog; Remove is destructive so RowActionsMenu owns the
    /// confirmation prompt (this method must NOT prompt again — a second gate would double-confirm).</summary>
    private IReadOnlyList<RowAction> ActionsFor(int index, QuestionEditorRow row) =>
    [
        RowAction.Callback("Edit", () => OpenEditAsync(index, row), FluentIcons.Edit),
        RowAction.Callback("Remove", () => OnRemoveQuestionAsync(index), FluentIcons.Delete, destructive: true),
    ];

    /// <summary>QA-11/QA-12: opens the question in the shared dialog shell and adopts the confirmed
    /// working copy. A cancelled dialog leaves the row untouched (the model held a copy).
    /// The testable seam the bUnit suite drives directly.</summary>
    public async Task OpenEditAsync(int index, QuestionEditorRow row)
    {
        var result = await DialogService.ShowShellDialogAsync<QuestionEditDialog, QuestionEditModel, QuestionEditResult>(
            QuestionEditModel.ForEdit(index, row),
            title: "Edit question",
            size: DialogSize.Medium);

        if (result is null || index < 0 || index >= Model.Questions.Count)
        {
            return;
        }

        // Keep the row's slot identity/order: the dialog edited a copy, not the position.
        result.Row.DisplayOrder = Model.Questions[index].DisplayOrder;
        Model.Questions[index] = result.Row;
        await Changed.InvokeAsync();
    }

    /// <summary>Removes the question at <paramref name="absoluteIndex"/> (destructive-gated upstream
    /// by <see cref="RowActionsMenu"/>).</summary>
    public async Task OnRemoveQuestionAsync(int absoluteIndex)
    {
        if (absoluteIndex < 0 || absoluteIndex >= Model.Questions.Count)
        {
            return;
        }
        Model.RemoveQuestionAt(absoluteIndex);
        if (_paginationState.CurrentPageIndex >= Model.QuestionPageCount())
        {
            await _paginationState.SetCurrentPageIndexAsync(Math.Max(0, Model.QuestionPageCount() - 1));
        }
        await Changed.InvokeAsync();
    }

    public void Dispose()
    {
        // No unmanaged resources; the paginator is owned by Blazor.
    }
}
