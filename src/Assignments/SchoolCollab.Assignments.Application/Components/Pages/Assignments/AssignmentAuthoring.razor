    // ── Target chips (TGT-16 chip list, DisplayOrder) ─────────────────────────

    /// <summary>One rendered target chip: its position in the DisplayOrder and the labels the
    /// author reads.</summary>
    public sealed record TargetChip(int Index, TargetKindDto Kind, Guid? RefId, string KindLabel, string Label);

    /// <summary>The authored constraints as chips, in DisplayOrder (the model's list order).</summary>
    private IReadOnlyList<TargetChip> TargetChips => _model.Targets
        .Select((t, i) => new TargetChip(i, t.Kind, t.RefId, KindLabel(t.Kind), TargetLabel(t)))
        .ToList();

    private static string KindLabel(TargetKindDto kind) => kind switch
    {
        TargetKindDto.AllStudents => "Everyone",
        TargetKindDto.GradeLevel => "Grade level",
        TargetKindDto.Stream => "Stream",
        TargetKindDto.Student => "Student",
        _ => "Activity group"
    };

    /// <summary>The chip's display name, resolved from the loaded picker option for that kind and
    /// id — with an explicit fallback so a stale or foreign id is still removable.</summary>
    private string TargetLabel(AssignmentEditFormModel.AssignmentTargetSpec target)
    {
        if (target.Kind == TargetKindDto.AllStudents)
        {
            return "Everyone";
        }

        var options = target.Kind switch
        {
            TargetKindDto.GradeLevel => _gradeLevelOptions,
            TargetKindDto.Stream => _streamOptions,
            TargetKindDto.ActivityGroup => _activityGroupOptions,
            TargetKindDto.Student => _selectedStudentOptions.ToArray(),
            _ => []
        };

        // F16: one explicit shape for the fallback — the null-conditional chain
        // `RefId?.ToString()[..8] ?? "—"` leans on the ?. propagating through the range operator,
        // which reads as a slice taken before the null check. Branch on the Guid instead.
        return options.FirstOrDefault(o => o.Value == target.RefId?.ToString())?.Label
            ?? $"{KindLabel(target.Kind)} {(target.RefId is Guid refId ? refId.ToString()[..8] : "—")}";
    }

