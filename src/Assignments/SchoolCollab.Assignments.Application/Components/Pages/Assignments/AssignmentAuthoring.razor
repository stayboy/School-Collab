    /// </summary>
    private IReadOnlyList<Guid> KnownGradeTargetIds =>
        _model.TargetsLoaded ? TargetIds(TargetKindDto.GradeLevel) : _item?.TargetGradeIds ?? [];

    /// <summary>R3 (D18/PB-3): the targeted grades' canonical levels, ascending — resolved from the
