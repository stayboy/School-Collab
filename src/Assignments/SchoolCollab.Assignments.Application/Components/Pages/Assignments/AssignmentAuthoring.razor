    private string ArchiveWindowPolicyValueText => _policy is null
        ? "Not resolved yet"
        : _policy.ArchiveGraceDays is int days
            ? $"Archived {days} days after the due date"
            : $"Archived {DefaultArchiveGraceDays} days after the due date (built-in default)";

    /// <summary>D2/OD3/OD4: the guardian-review readout — the policy's locked value, or the
    /// statement that the choice is the author's (the Basics toggle).</summary>
    private string GuardianReviewPolicyValueText => _policy?.MandatoryReview switch
    {
        true => "Guardian review is required before a student can submit",
        false => "Guardian review is not required",
        _ => "Not set by the policy — the author chooses in Basics"
    };

    /// <summary>OD3: the author's guardian-review toggle is editable only while the effective
    /// policy leaves review unset — a policy-set value locks it.</summary>
    private bool PolicyReviewLocked => _policy?.MandatoryReview is not null;

    /// <summary>UX-13: the resolved values link to the policy card that owns them — the single
    /// targeted grade's policy page when the assignment targets exactly one grade, otherwise the
    /// grade-level list that hosts the tenant-global default (the same one-distinct-grade rule
    /// <see cref="DerivedPolicyGrade"/> applies to the policy resolution itself).</summary>
    private string? PolicyLinkHref => DerivedPolicyGrade is Guid gradeId
        ? $"/students/grade-levels/{gradeId}"
        : null;

    private PickerOption[] TypeOptions =>
    [
        new(((int)AssignmentTypeDto.Digital).ToString(), EnumHelper.GetDescription(AssignmentTypeDto.Digital)),
        new(((int)AssignmentTypeDto.SemiManual).ToString(), EnumHelper.GetDescription(AssignmentTypeDto.SemiManual)),
        new(((int)AssignmentTypeDto.Manual).ToString(), EnumHelper.GetDescription(AssignmentTypeDto.Manual))
    ];

    private PickerOption[] GradingFormatOptions =>
    [
        new(((int)GradingFormatDto.TeacherGraded).ToString(), EnumHelper.GetDescription(GradingFormatDto.TeacherGraded)),
        new(((int)GradingFormatDto.AutoGraded).ToString(), EnumHelper.GetDescription(GradingFormatDto.AutoGraded)),
        new(((int)GradingFormatDto.InstantGraded).ToString(), EnumHelper.GetDescription(GradingFormatDto.InstantGraded))
    ];

    // ── Live recipient preview (TGT-16 / D-4) ─────────────────────────────────

    /// <summary>D-4: the inline degraded note the compartment renders when the preview could not
    /// be resolved. Advisory only — save is never blocked and publish re-resolves.</summary>
    public const string PreviewUnavailableReason =
        "Preview unavailable — the audience could not be resolved right now. Saving is unaffected; " +
        "publishing re-resolves the audience server-side.";

    /// <summary>F11: the stable note a read-only surface renders in place of recipient counts —
    /// <see cref="SchedulePreviewAsync"/> resolves a preview on an editable surface only, so
    /// "Preview pending…" in View mode would never settle into anything.</summary>
    public const string PreviewAuthorOnlyNote =
        "Recipient counts are resolved for authors on the edit surface.";

    /// <summary>F12: with no audience target authored the preview area points at the missing step
    /// instead of rendering "Students matched: 0" — the server answers zero for an empty audience,
    /// so a bare count reads as a resolved audience of nobody rather than as work not done yet.</summary>
    public const string PreviewNoTargetsHint =
        "No audience targets yet — add one above to see how many students this assignment reaches.";

    private string PreviewText
    {
        get
        {
            if (IsReadOnly)
            {
                return PreviewAuthorOnlyNote;
            }

            // F12: nothing is authored to preview, so the hint replaces both the pending line and
            // the meaningless zero the server would report.
            if (_model.Targets.Count == 0)
            {
                return PreviewNoTargetsHint;
            }

            return _preview is null
                ? "Preview pending…"
                : $"Students matched: {_preview.StudentsMatched} \u00b7 Contacts reachable: " +
                  $"{_preview.PrimaryContacts + _preview.OtherContacts} " +
                  $"({_preview.PrimaryContacts} primary / {_preview.OtherContacts} other)";
        }
    }

    /// <summary>
    /// D-4: schedules a preview call on a 500 ms TRAILING debounce, cancelling any pending or
    /// in-flight call first so a burst of constraint changes produces exactly one server read and
    /// a stale response can never overwrite a newer one. The delay runs on
    /// <see cref="TimeProvider"/> so tests can drive it deterministically.
    /// </summary>
    private async Task SchedulePreviewAsync()
    {
        var previous = _previewCts;
        _previewCts = null;
        previous?.Cancel();
        previous?.Dispose();

        if (IsReadOnly || AudienceEditorDisabledReason is not null)
        {
            _preview = null;
            _previewDegraded = false;
            return;
        }

        var cts = new CancellationTokenSource();
        _previewCts = cts;
        var ct = cts.Token;

        try
        {
            await Task.Delay(PreviewDebounce, TimeProvider, ct);
            var preview = await Api.GetRecipientPreviewAsync(
                new RecipientPreviewRequest(
                    _model.HasAllStudents,
                    TargetIds(TargetKindDto.GradeLevel),
                    TargetIds(TargetKindDto.Stream),
                    TargetIds(TargetKindDto.Student),
                    TargetIds(TargetKindDto.ActivityGroup)),
                ct);

            if (ct.IsCancellationRequested)
            {
                return;
            }

            _preview = preview;
            _previewDegraded = preview?.PreviewDegraded ?? true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed)
            {
                return;
            }

            Logger.LogWarning(ex, "Recipient preview resolution failed");
            _preview = null;
            _previewDegraded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<Guid> TargetIds(TargetKindDto kind) => _model.Targets
        .Where(t => t.Kind == kind && t.RefId.HasValue)
        .Select(t => t.RefId!.Value)
        .Distinct()
        .ToList();

    // ── UX-7: the unsaved-changes guard (D2) ─────────────────────────────────

    /// <summary>
    /// UX-7 (D3): true when a save from this form would write something different from what was
    /// loaded — a BASELINE COMPARISON of the save payload, not an edit event. Read-only surfaces
    /// carry no unsaved work, and a load in flight is not an author edit.
    /// </summary>
    private bool IsDirty =>
        !IsReadOnly && !_loading && _dirtyBaseline is not null && CaptureSaveSnapshot() != _dirtyBaseline;

    /// <summary>UX-7 (D3): the payload this form would save — the model's own fields plus the
    /// page-level values that live outside it, passed exactly as the save passes them, so "dirty"
    /// means "the next save would differ" and nothing else.</summary>
    private string CaptureSaveSnapshot() => _model.CaptureSaveSnapshot(
        SelectedType ?? AssignmentTypeDto.Manual,
        SelectedGradingFormat,
        DerivedTargetAudience,
        TopicId ?? Guid.Empty,
        _mandatoryReview);

    /// <summary>UX-7 (D3): moves the baseline onto the form's current content — the two moments the
    /// form IS the persisted state: the end of a load, and the component's own exit after a save
    /// (see <see cref="NavigateToSavedState"/>).
    /// <para>UX-7 / F17 (this round): it also retires <see cref="UnsavedEditsDiscardedNotice"/> on
    /// those same two moments, because the notice describes the swap that produced the <i>previous</i>
    /// state — a load that has settled or a save that has been accepted has moved the surface past it.
    /// Gated on <see cref="_error"/> so a load that FAILED retires nothing: the only thing that may
    /// retire the notice is a read that actually succeeded, or the component's own successful exit.
    /// </para></summary>
    private void CaptureDirtyBaseline()
    {
        _dirtyBaseline = CaptureSaveSnapshot();
        if (_error is null)
        {
            _unsavedEditsDiscarded = false;
        }
    }

    /// <summary>
    /// UX-7 (D2) in-app half: cancels a navigation that would discard unsaved work, after
    /// confirming the discard with the shared FluentUI dialog. A non-dirty form returns immediately,
    /// so the guard never stands between an author and an ordinary link.
    /// </summary>
    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!IsDirty)
        {
            return;
        }

        var discard = await DialogService.ShowConfirmDialogAsync(
            UnsavedChangesMessage,
            UnsavedChangesDiscardAction,
            UnsavedChangesKeepEditingAction,
            title: "Unsaved changes");

        if (!discard)
        {
            context.PreventNavigation();
            return;
        }

        // UX-7 / F17 (this round): the author just told us the discard is fine, so the reload this
        // navigation reaches is a consented one — OnParametersSetAsync reads this and stays quiet
        // (D2: announce the unguarded discard, never nag about the author's own decision).
        _discardConsented = true;
    }

    /// <summary>
    /// UX-7 (D2) browser-unload half: mirrors the dirty state onto the collocated module's
    /// <c>window.beforeunload</c> listener — the only mechanism covering a tab close, a reload or an
    /// external URL, none of which an in-app handler sees. It can only trigger the browser's own
    /// prompt (a beforeunload handler is not allowed to show anything of its own), which is why both
    /// halves exist. The listener is attached exactly while the form is dirty.
    /// <para>Read-only is deliberately NOT an early return: <see cref="IsDirty"/> is already false
    /// on a read-only surface, so the state machine still has to run through to the unregister on
    /// the dirty→clean transition a lifecycle action performs (Publish/Unpublish/Close/Archive
    /// flip <see cref="EffectiveMode"/> to View) — returning early there would leave the listener
    /// armed on a page with nothing left to lose. The module import stays lazy: it happens on the
    /// dirty edge only.</para>
    /// </summary>
    private async Task SyncBeforeUnloadGuardAsync()
    {
        if (_disposed)
        {
            return;
        }

        var dirty = IsDirty;
        if (dirty == _beforeUnloadRegistered)
        {
            return;
        }

        try
        {
            _beforeUnloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", BeforeUnloadModulePath);
            await _beforeUnloadModule.InvokeVoidAsync(
                dirty ? "registerBeforeUnload" : "unregisterBeforeUnload");
            _beforeUnloadRegistered = dirty;
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed between the render and the call — nothing to surface, and the
            // listener went with the page it belonged to.
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>UX-7 (D3): the component's own exit after a successful save — the baseline moves
    /// with the form, so the guard cannot prompt on a navigation the page itself started.</summary>
    private void NavigateToSavedState(string url)
    {
        CaptureDirtyBaseline();
        Nav.NavigateTo(url);
    }

    // ── Lifecycle ───────────────────────────────────────────────────────────

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// F17: Blazor reuses this component instance when the host swaps the route parameter —
    /// <c>/assignments/{a}/edit</c> → <c>/assignments/{b}/edit</c> is the same component type at the
    /// same render-tree position, so only <see cref="Id"/> changes and assignment A's loaded state
    /// would stay on screen under B's URL (the R2 F1 defect class: a stale-write path). Reload when
    /// — and only when — <see cref="Id"/> or <see cref="Mode"/> CHANGED, compared against what the
    /// current state was loaded from, so a re-set of the same values never re-enters the load.
    /// <para>UX-7 (D2): the load this reaches is guarded upstream by the registered location-changing
    /// handler, which runs before a navigation can change the parameter — but a host that swaps
    /// <see cref="Id"/> without a <c>NavigationManager</c> navigation reaches it unguarded. The reload
    /// still happens there (refusing it would keep A's state under B's URL — the stale-write path F17
    /// exists to remove), so the belt-and-braces half is that an UNCONSENTED discard is announced
    /// instead of silent; see <see cref="UnsavedEditsDiscardedNotice"/>.</para>
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Consumed on every parameter set, not only on a change: a consented navigation that never
        // reached a parameter change (a same-URL navigation) must not leave the consent behind to
        // silence a later, genuinely unguarded swap.
        var consented = _discardConsented;
        _discardConsented = false;

        if (_loadedId == Id && _loadedMode == Mode)
        {
            return;
        }

        // Sampled BEFORE the load: it resets the form and moves the dirty baseline, so afterwards
        // there is nothing left to compare and the discard would go unrecorded. Read-only surfaces
        // and a load still in flight are never dirty, so neither can raise the notice.
        var discardedUnsavedEdits = IsDirty && !consented;

        await LoadAsync();

        if (discardedUnsavedEdits)
        {
            _unsavedEditsDiscarded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // UX-7 (D2): registered once per instance — a reload for another assignment keeps this
            // same instance and needs no second registration — and disposed with the component.
            _locationChangingRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
        }

        await SyncBeforeUnloadGuardAsync();
    }

    /// <summary>
    /// The one load path: <see cref="OnInitializedAsync"/> runs it for a fresh instance and
    /// <see cref="OnParametersSetAsync"/> runs it again when the host swapped <see cref="Id"/> or
    /// <see cref="Mode"/> (F17).
    /// </summary>
    private async Task LoadAsync()
    {
        _loadedId = Id;
        _loadedMode = Mode;

        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        ResetLoadState();

        try
        {
            if (Mode != AssignmentAuthoringMode.Create && Id is Guid id)
            {
                _item = await Api.GetByIdAsync(id, ct);
                if (_disposed) return;
                if (_item is not null)
                {
                    _model.LoadFrom(_item);
                    _mandatoryReview = _item.MandatoryReview;
                    _selectedType = TypeOptions.FirstOrDefault(o => o.Value == ((int)_item.AssignmentType).ToString());
                    _selectedGradingFormat = GradingFormatOptions
                        .FirstOrDefault(o => o.Value == ((int)_item.GradingFormat).ToString());
                }
            }
            else if (Mode == AssignmentAuthoringMode.Create)
            {
                // A new assignment starts on the authored defaults the retired wizard used
                // (Offline / Teacher Marked / no targets yet — TGT-13 requires the author to add one).
                _selectedType = TypeOptions.Single(o => o.Value == ((int)AssignmentTypeDto.Manual).ToString());
                _selectedGradingFormat = GradingFormatOptions
                    .Single(o => o.Value == ((int)GradingFormatDto.TeacherGraded).ToString());
            }

            await LoadPickersAsync(_item, ct);

            // P1/P2-1/R2: an editable Edit surface reads the persisted children (which now carry
            // the targeting rows, D-8.3) and the linked activity groups BEFORE the editors render,
            // so an author's first add can never turn an empty collection into a full-replacement
            // payload.
            if (EffectiveMode == AssignmentAuthoringMode.Edit && Id is Guid authoringId)
            {
                await LoadPersistedSelectionAsync(authoringId, ct);
            }
            else
            {
                if (Mode == AssignmentAuthoringMode.Create)
                {
                    // Create has no persisted targets to lose, so its targeting editor is live.
                    _model.LoadTargets([]);
                }

                // Create has no persisted set to read and View does not read one either, so only the
                // mirrors run here — they carry whatever the surface already holds.
                SyncTargetPickerState();
                SyncGroupsFromTargets();
                RebuildTargetsAndAudienceFromModel();
            }

            // WS-C1 (spec §7 Q1) / D2/OD4: resolve the effective assignment policy — the five
            // Rules readouts, the guardian-review lock, and (for the author) the review toggle's
            // editable state all read this ONE object. Round drop-primary-grade: the grade is
            // DERIVED from the loaded grade-target rows (create → null ⇒ the tenant default),
            // never read off an authored field.
            await ResolveEffectivePolicyAsync(DerivedPolicyGrade);

            // WS-B2 (spec §3.4 line 70): org-level AI-prompt lock (best-effort, fail-open).
            await LoadAiPromptPolicyAsync(ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load the assignment authoring surface for {AssignmentId}", Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }

        // UX-7 (D3): what was just loaded is the baseline the guard compares against.
        CaptureDirtyBaseline();

        // F13 (D6): the advisory preview does not hold the first render behind its own 500 ms
        // trailing debounce — awaiting it here kept a spinner in front of a form that was already
        // fully loaded. The debounce's CTS owns this call's lifetime (a further constraint change
        // cancels it), so an unawaited schedule is well-defined.
        _ = SchedulePreviewAsync();
    }

    /// <summary>
    /// F17: clears every projection the load re-derives, so a reused instance (the host page swapped
    /// <see cref="Id"/>/<see cref="Mode"/>) can never render the previous assignment's picker
    /// selection, search results or preview beside the new assignment's fields. The form model's own
    /// fields are re-projected wholesale by <c>LoadFrom</c> + <c>LoadChildren</c>, so only the
    /// page-level mirrors are cleared here.
    /// </summary>
    private void ResetLoadState()
    {
        _item = null;
        _error = null;
        _loading = Mode != AssignmentAuthoringMode.Create;

        _selectedType = null;
        _selectedGradingFormat = null;
        _mandatoryReview = true;
        _policy = null;
        _aiPromptLocked = false;

        _childrenLoaded = false;
        _groupLinksLoaded = false;
        _loadedGroupIds.Clear();
        _groupLinksUnavailableReason = null;

        _gradeLevels = null;
        _gradeLevelOptions = [];
        _subjects = null;
        _subjectOptions = [];
        _selectedSubject = null;
        _activityGroupOptions = [];
        _selectedGroupIds = [];
        _groupSubjects = null;
        _groupSubjectOptions = [];
        _streamOptions = [];

        _targetsAndAudience.Clear();
        _preview = null;
        _previewDegraded = false;
    }

    /// <summary>
    /// P1/P2-1/R2 — the ONE read of the assignment's persisted authoring set: the children (which carry
    /// the targeting rows, D-8.3) and the linked activity groups, followed by the picker mirrors that
    /// make the loaded set visible. <see cref="LoadAsync"/> runs it before the editors first render (so
    /// an author's first add can never turn an empty collection into a full-replacement payload) and
    /// <see cref="ReloadAsync"/> runs it again after a lifecycle action, so the surface shows the set
    /// the server actually holds rather than the one it held before the action.
    /// <para>It re-reads NOTHING else: the picker option sources (grade levels, streams, activity groups)
    /// are tenant-level data no lifecycle action changes, and the scalar summary is refreshed by the
    /// callers from their own detail read.</para>
    /// </summary>
    private async Task LoadPersistedSelectionAsync(Guid assignmentId, CancellationToken ct)
    {
        await LoadChildrenAsync(assignmentId, ct);
        await LoadLinkedGroupIdsAsync(assignmentId, ct);

        // D-2 / TGT-7: mirror the loaded target set onto the pickers, and rebuild the builder's
        // entries from the same set so the surface shows the targets the server actually holds (AC-5).
        SyncTargetPickerState();
        SyncGroupsFromTargets();
        RebuildTargetsAndAudienceFromModel();

        // FR-58: a persisted group target needs its group-subject union loaded up front — the submit
        // gate and the subject picker both read it, and the union otherwise only loads when the author
        // touches the group picker (which would silently block the save).
        if (_selectedGroupIds.Count > 0)
        {
            await LoadGroupSubjectsAsync();
        }
    }

    /// <summary>Loads grade levels, activity groups (flag-gated) and, for a loaded assignment,
    /// the subject option that carries its persisted topic. Every fetch is isolated so one
    /// optional backend being absent can never take down the rest of the page (the
    /// /activity-groups 404 precedent).</summary>
    private async Task LoadPickersAsync(AssignmentSummaryDto? item, CancellationToken ct)
    {
        try
        {
            _gradeLevels = await StudentsApi.ListGradeLevelsAsync(ct);
            if (_gradeLevels is not null)
            {
                _gradeLevelOptions = _gradeLevels
                    .OrderBy(gl => gl.Level)
                    .Select(gl => new PickerOption(gl.Id.ToString(), gl.Name))
                    .ToArray();
            }
            else
            {
                _gradeLevels = [];
            }
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load grade levels");
        }

        await LoadActivityGroupsAsync(ct);

        // TGT-5 (D-5): the stream picker's options come from the existing grade-stream listing,
        // so only real StreamCodedValueIds are ever offered.
        await LoadStreamTargetsAsync(ct);

        if (item is not null)
        {
            // The persisted topic seeds the subject picker; it may not appear in the grade's
            // effective subject list anymore, so it is added to the options explicitly.
            var topic = new PickerOption(item.TopicId.ToString(), item.TopicName ?? "Current subject");
            _selectedSubject = topic;
            _subjectOptions = [topic];
        }

        // FR-58 (round drop-primary-grade): the grade side of the subject union is the union over the
        // loaded assignment's grade TARGETS — the summary projects them, so no target row has to be
        // read yet. A create has no grade targets, and an assignment without one simply offers the
        // group-subject union.
        if (item?.TargetGradeIds is { Count: > 0 } gradeTargetIds)
        {
            await LoadSubjectsForGradeTargetsAsync(gradeTargetIds, ct);
        }
    }

    /// <summary>Loads the activity groups backing the SelectedGroups audience. Off flag = the
    /// audience is not offered at all, so this is a normal no-op rather than an error.</summary>
    private async Task LoadActivityGroupsAsync(CancellationToken ct)
    {
        _activityGroupOptions = [];
        _selectedGroupIds.Clear();
        _loadedGroupIds.Clear();
        _groupLinksLoaded = false;

        try
        {
            if (!await FeatureFlags.IsEnabledAsync(FeatureFlagKeys.EnableActivityGroups, ct))
            {
                _activityGroupsEnabled = false;
                return;
            }

            _activityGroupsEnabled = true;
            var groups = await StudentsApi.ListActivityGroupsAsync(ct);
            if (groups is null) return;

            // §17 (item 4): every group the listing returned is offered only while it is active;
            // an archived row is not selectable (the replace-set link route refuses it).
            _activityGroupOptions = groups
                .Where(g => g.IsActive)
                .OrderBy(g => g.Name)
                .Select(g => new PickerOption(g.Id.ToString(), g.Name))
                .ToArray();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to load activity groups; the SelectedGroups target is unavailable");
            _activityGroupOptions = [];
            _selectedGroupIds.Clear();
        }
    }

    /// <summary>
    /// P1 rework (the load half of Edit parity): reads the assignment's persisted question /
    /// attachment / resource set into the form model. Fail-closed — a failed or absent read
    /// leaves <see cref="ChildrenEditorDisabledReason"/> non-null, so the editors render
    /// disabled-with-reason and the save payload keeps its (null) child collections, which the
    /// update handler reads as "preserve".
    /// </summary>
    private async Task LoadChildrenAsync(Guid assignmentId, CancellationToken ct)
    {
        _childrenLoaded = false;
        try
        {
            var children = await Api.GetAuthoringChildrenAsync(assignmentId, ct);
            if (children is null)
            {
                Logger.LogWarning("Authoring children read found no assignment {AssignmentId}", assignmentId);
                return;
            }

            _model.LoadChildren(children);
            _childrenLoaded = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load authoring children for {AssignmentId}", assignmentId);
        }
    }

    /// <summary>
    /// P2-1 rework: reads the activity groups already linked to this assignment so the picker
    /// starts from the persisted links (the review's P2-1 — the picker was editable but never
    /// loaded or persisted). Fail-closed: a failed read disables the picker with a reason and
    /// the save path then never issues the replace-set call, so an unknown set can never be
    /// written over the stored one.
    /// </summary>
    private async Task LoadLinkedGroupIdsAsync(Guid assignmentId, CancellationToken ct)
    {
        _groupLinksLoaded = false;
        _loadedGroupIds.Clear();
        _groupLinksUnavailableReason = null;

        if (!_activityGroupsEnabled)
        {
            // The link routes are unmapped with the flag off and the group audience is not
            // offered, so there is nothing to load and nothing to persist.
            return;
        }

        try
        {
            var ids = await Api.GetLinkedActivityGroupIdsAsync(assignmentId, ct);
            if (ids is null)
            {
                _groupLinksUnavailableReason = GroupLinksUnavailableReason;
                return;
            }

            foreach (var groupId in ids)
            {
                // Only ids the picker can represent are selected: the link route rejects ANY
                // archived id in a replace set, so offering one would fail every save (bounded
                // residual — an archived link is not re-writable through this route).
                if (_activityGroupOptions.Any(o => o.Value == groupId.ToString()))
                {
                    // Only ids the picker can represent are selected: the link route rejects ANY
                    // archived id in a replace set, so offering one would fail every save (bounded
                    // residual — an archived link is not re-writable through this route).
                    _loadedGroupIds.Add(groupId);
                    _selectedGroupIds.Add(groupId);
                }
            }

            _groupLinksLoaded = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            _groupLinksUnavailableReason = GroupLinksUnavailableReason;
            Logger.LogWarning(ex, "Failed to load linked activity groups for {AssignmentId}", assignmentId);
        }
    }

    /// <summary>WS-B2 (spec §3.4 line 70): loads the org-level AI-prompt lock. Fail-open —
    /// any failure is a warning log and the prompt stays editable (no error bar).</summary>
    private async Task LoadAiPromptPolicyAsync(CancellationToken ct)
    {
        try
        {
            _aiPromptLocked = await Api.GetAiPromptPolicyAsync(ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "AI-prompt lock resolution failed");
        }
    }

    private void OnModelChanged() { }

    /// <summary>
    /// FR-58 (round <c>drop-primary-grade</c>): loads the grade side of the subject union — the union
    /// over the given distinct grade targets' effective subject lists on the effective date. The
    /// previous single primary grade becomes a set, so the fetch runs once per grade target with
    /// the same per-call isolation the stream-option loader uses: a grade whose subjects cannot be
    /// read simply contributes none and never fails the page.
    /// </summary>
    private async Task LoadSubjectsForGradeTargetsAsync(IReadOnlyList<Guid> gradeTargetIds, CancellationToken ct)
    {
        _loadingSubjects = true;
        try
        {
            var effectiveDate = EffectiveTopicDate();
            var union = new List<SubjectDto>();
            var seen = new HashSet<Guid>();

            foreach (var gradeTargetId in gradeTargetIds.Distinct())
            {
                if (ct.IsCancellationRequested)
                {
                    return;
                }

                try
                {
                    var subjects = await StudentsApi.ListSubjectsByGradeEffectiveAsync(
                        gradeTargetId, effectiveDate, ct) ?? [];
                    foreach (var s in subjects)
                    {
                        if (seen.Add(s.Id)) union.Add(s);
                    }
                }
                catch (OperationCanceledException) { return; }
                catch (Exception ex)
                {
                    if (_disposed) return;
                    // Optional picker source: a grade whose subjects cannot be read contributes
                    // none instead of failing the whole load (the stream-options posture).
                    Logger.LogWarning(ex, "Subject options unavailable for grade target {GradeId}", gradeTargetId);
                }
            }

            _subjects = union.ToArray();
            _subjectOptions = _subjects
                .OrderBy(s => s.DisplayOrder)
                .Select(s => new PickerOption(s.Id.ToString(), s.Name))
                .ToArray();
        }
        finally
        {
            _loadingSubjects = false;
        }
    }

    /// <summary>FR-58 — re-filter the topic picker so only topics effective on the due date
    /// are offered (the grade-target path and the group-union path both re-run here).</summary>
    private async Task OnDueDateChangedAsync()
    {
        var gradeTargetIds = KnownGradeTargetIds;
        if (gradeTargetIds.Count > 0)
        {
            _selectedSubject = null;
            _subjectOptions = [];
            await LoadSubjectsForGradeTargetsAsync(gradeTargetIds, _loadCts?.Token ?? CancellationToken.None);
        }

        if (TargetIds(TargetKindDto.ActivityGroup).Count > 0)
        {
            _selectedSubject = null;
            _groupSubjectOptions = [];
            await LoadGroupSubjectsAsync();
        }
    }

    /// <summary>
    /// The single reaction to a builder edit: mirror the new target set onto the page's picker state,
    /// refresh the subject sources the changed targets feed, re-resolve the signature default when the
    /// DERIVED policy-scope grade moved, and re-schedule the debounced preview. Nothing here persists —
    /// the preview never writes (D-4).
    /// </summary>
    private async Task OnTargetsChangedAsync()
    {
        // P1-4 (TGT-16): the form model IS the target set the picker mirrors and the advisory
        // preview read, so the builder's entries are projected onto it on EVERY add/remove — not
        // only at save, which would leave the preview resolving a stale audience. The previous
        // grade-target set is sampled BEFORE that projection, because it is what the change
        // detection below compares against.
        var previousGradeTargetIds = KnownGradeTargetIds;
        var previousGroupIds = _selectedGroupIds;

        SyncTargetsFromBuilder();

        var gradeTargetIds = KnownGradeTargetIds;

        // D-4 / F13 (the load path's posture): the advisory preview depends only on the target set the
        // sync just wrote, so it is scheduled HERE — BEFORE the awaited subject reloads below, never held
        // behind them (a reload would otherwise delay the debounce past a caller's clock advance). Its CTS
        // owns the call's lifetime, so the builder's add/remove shows its new entry immediately while the
        // preview settles in the background.
        _ = SchedulePreviewAsync();

        SyncTargetPickerState(previousGradeTargetIds);
        SyncGroupsFromTargets();

        // Only a CHANGED grade-target set reloads the grade side of the subject union — a reload
        // clears the author's subject otherwise. The comparison is the whole id set: a second grade
        // target added or removed does not move the derived policy grade (still null), yet it does
        // change the offered subjects.
        if (!gradeTargetIds.Order().SequenceEqual(previousGradeTargetIds.Order()))
        {
            _selectedSubject = null;
            _subjectOptions = [];
            _subjects = null;
            if (gradeTargetIds.Count > 0)
            {
                await LoadSubjectsForGradeTargetsAsync(gradeTargetIds, _loadCts?.Token ?? CancellationToken.None);
            }
        }

        // WS-C1 (spec §7 Q1) / D2 (round drop-primary-grade): the effective policy follows the
        // DERIVED grade, so it re-resolves exactly when that grade moves (a single grade target
        // added or removed) — there is no picker to change.
        if (DerivePolicyGrade(previousGradeTargetIds) != DerivedPolicyGrade)
        {
            await ResolveEffectivePolicyAsync(DerivedPolicyGrade);
        }

        // FR-58: the group-subject union the submit gate reads follows the group TARGETS, exactly as
        // the retired group picker kept it in step — the author can add a group target from the builder
        // and must not then be validated against the union of a set they just left. Only a CHANGED group
        // set re-reads it, so a grade or stream entry does not re-issue the call.
        if (!previousGroupIds.SetEquals(_selectedGroupIds))
        {
            _selectedSubject = null;
            _groupSubjectOptions = [];
            _groupSubjects = null;
            if (_selectedGroupIds.Count > 0)
            {
                await LoadGroupSubjectsAsync();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Round <c>drop-primary-grade</c>: the picker mirrors have no grade selection left to keep — the
    /// grade half of the audience IS the target rows. What remains is dropping a stale subject selection
    /// once the grade-target set MOVED: <paramref name="previousGradeTargetIds"/> is the set before the
    /// edit (null on the load paths, where nothing has moved and the author's subject must survive the
    /// reload — the persisted topic may deliberately not appear in the offered set).
    /// </summary>
    private void SyncTargetPickerState(IReadOnlyList<Guid>? previousGradeTargetIds = null)
    {
        if (previousGradeTargetIds is null
            || KnownGradeTargetIds.Order().SequenceEqual(previousGradeTargetIds.Order()))
        {
            return;
        }

        _selectedSubject = null;
    }

    /// <summary>Mirrors the model's ActivityGroup targets onto the picker's id set (the load and the
    /// builder sync both need this without re-entering the model).</summary>
    private void SyncGroupsFromTargets() =>
        _selectedGroupIds = TargetIds(TargetKindDto.ActivityGroup).ToHashSet();

    /// <summary>TGT-5/D-5: loads the stream options from the grade-stream listing, labelled
    /// "Grade · Stream" for the display grouping the spec asks for. Per-grade failures are
    /// isolated — a grade whose streams cannot be read simply offers none.</summary>
    private async Task LoadStreamTargetsAsync(CancellationToken ct)
    {
        _streamOptions = [];
        if (_gradeLevels is not { Length: > 0 } grades)
        {
            return;
        }

        var options = new List<PickerOption>();
        var seen = new HashSet<Guid>();
        foreach (var grade in grades.OrderBy(g => g.Level))
        {
            if (ct.IsCancellationRequested)
            {
                return;
            }

            try
            {
                var streams = await StudentsApi.ListGradeStreamsAsync(grade.Id, ct);
                foreach (var stream in streams ?? [])
                {
                    if (seen.Add(stream.StreamCodedValueId))
                    {
                        options.Add(new PickerOption(
                            stream.StreamCodedValueId.ToString(),
                            $"{grade.Name} · {stream.NameOverride ?? stream.Name}"));
                    }
                }
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex)
            {
                if (_disposed) return;
                // Optional picker source: a grade whose streams cannot be read simply offers none
                // (never a page-level load failure).
                Logger.LogDebug(ex, "Stream options unavailable for grade {GradeId}", grade.Id);
            }
        }

        _streamOptions = options.ToArray();
    }

    /// <summary>TGT-6: the student search behind the dialog's student picker
    /// (<c>GET /students?search=</c>). A short query answers an empty list rather than scanning the
    /// roster. Fail-open: a failed search offers nothing instead of failing the dialog.</summary>
    private async Task<IReadOnlyList<TargetsAndAudienceOption>> SearchStudentsAsync(
        string query, CancellationToken ct)
    {
        query = (query ?? string.Empty).Trim();
        if (query.Length < 2)
        {
            return [];
        }

        try
        {
            var students = await StudentsApi.ListStudentsAsync(ct, query) ?? [];
            return students
                .Where(s => !s.IsDeleted)
                .Take(20)
                .Select(s => new TargetsAndAudienceOption(s.Id.ToString(), StudentLabel(s)))
                .ToArray();
        }
        catch (OperationCanceledException) { return []; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Student target search failed");
            return [];
        }
    }

    /// <summary>TGT-6: the student option label — one spelling for the search results and every
    /// author-facing student name (the builder entry included), so a name never renders two ways.</summary>
    private static string StudentLabel(StudentDto student) =>
        $"{student.FirstName} {student.LastName} ({student.StudentNumber})";

    private async Task LoadGroupSubjectsAsync()
    {
        _loadingGroupSubjects = true;
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            // One effective date per load so the union across the selected groups is
            // consistent (FR-58), mirroring the grade path.
            var effectiveDate = EffectiveTopicDate();
            var union = new List<SubjectDto>();
            var seen = new HashSet<Guid>();
            foreach (var groupId in _selectedGroupIds)
            {
                var subjects = await StudentsApi.ListSubjectsByGroupAsync(groupId, effectiveDate, ct) ?? [];
                foreach (var s in subjects)
                {
                    if (seen.Add(s.Id)) union.Add(s);
                }
            }
            _groupSubjects = union.ToArray();
            _groupSubjectOptions = _groupSubjects
                .OrderBy(s => s.DisplayOrder)
                .Select(s => new PickerOption(s.Id.ToString(), s.Name))
                .ToArray();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load subjects for selected groups");
        }
        finally
        {
            _loadingGroupSubjects = false;
        }
    }

    private DateOnly EffectiveTopicDate() => _model.DueDate.HasValue
        ? DateOnly.FromDateTime(_model.DueDate.Value)
        : DateOnly.FromDateTime(DateTime.UtcNow);

    /// <summary>WS-C1 (spec §7 Q1) / D2/OD4: resolves the effective assignment policy for the
    /// DERIVED policy-scope grade (round <c>drop-primary-grade</c>; null ⇒ the tenant-global
    /// default) and applies it to the page — the guardian-review lock and the five Rules readouts.
    /// Fail-open: an endpoint failure is a warning, every readout renders "Not resolved yet" and the
    /// author's review choice stays editable — a transport failure never locks an author out of
    /// their own choice.
    /// </summary>
    private async Task ResolveEffectivePolicyAsync(Guid? derivedGradeId)
    {
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            ApplyEffectivePolicy(await Api.GetEffectivePolicyAsync(derivedGradeId, ct));
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            ApplyEffectivePolicy(null);
            Logger.LogWarning(ex, "Effective assignment policy resolution failed for grade {GradeId}", derivedGradeId);
        }
    }

    /// <summary>D2/OD3: applies the resolved policy. A non-null resolved review value is the
    /// policy's locked answer, so the Basics toggle mirrors it and renders disabled; an unset value
    /// leaves the toggle free and keeps whatever the author (or the loaded row) already chose.</summary>
    private void ApplyEffectivePolicy(EffectiveAssignmentPolicy? policy)
    {
        _policy = policy;
        if (policy?.MandatoryReview is bool policyReview)
        {
            _mandatoryReview = policyReview;
        }
    }

    private async Task ReloadAsync()
    {
        if (Id is not Guid id) return;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        // §17 (item 1, this round): the persisted authoring set is only re-read onto a form that carries
        // no unsaved work. Two of this method's callers leave the author on a surface they can still
        // save from — Unpublish from Scheduled, and Schedule from Draft — and re-reading the persisted
        // questions/attachments there would replace the rows they are still editing: the data-loss path
        // the re-read must not create. Sampled BEFORE the summary refresh below, because that refresh
        // itself rewrites the scalar fields the comparison reads. Every path on which the fresh set is
        // REQUIRED is clean here: a read-only View is never dirty, and a save navigates away instead of
        // leaving the author on the reloaded form.
        var unsavedEdits = IsDirty;

        try
        {
            _item = await Api.GetByIdAsync(id, ct);
            if (_item is not null)
            {
                _model.LoadFrom(_item);
                _mandatoryReview = _item.MandatoryReview;

                // §17 (item 1, this round): a lifecycle action can move the assignment to a status whose
                // surface is editable again (Published → Unpublish → Draft) or change the persisted
                // children, so the re-read happens against the mode the refreshed summary selects.
                if (!unsavedEdits && EffectiveMode == AssignmentAuthoringMode.Edit)
                {
                    // Re-read AFTER the summary refresh, and deliberately not held behind it: the status
                    // change is what the author acted on, so it shows even if this read fails. Accepted
                    // posture on that failure — the refreshed scalars stay, the child/target set stays as
                    // it was (nothing is cleared), i.e. a partial refresh rather than a broken form. Caught
                    // separately from the summary failure below so the log says which half of the reload
                    // was lost.
                    try
                    {
                        await LoadPersistedSelectionAsync(id, ct);
                    }
                    catch (OperationCanceledException) { }
                    catch (Exception ex)
                    {
                        if (_disposed) return;
                        Logger.LogWarning(ex,
                            "Assignment {AssignmentId} reloaded its summary but its persisted children/targets could not be re-read; the form keeps the rows it already had",
                            id);
                    }
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to reload assignment {AssignmentId}", id);
        }
    }

    // ── Action bar (§11) ─────────────────────────────────────────────────────

    /// <summary>The status-driven primary action (§11 / UX-5). Null for an Archived assignment
    /// (the terminal state has no primary action).</summary>
    private string? PrimaryActionLabel => EffectiveMode switch
    {
        AssignmentAuthoringMode.Create => "Save as Draft",
        _ => _item?.Status switch
        {
            AssignmentStatusDto.Draft => "Publish",
            AssignmentStatusDto.Scheduled => "Unpublish",
            AssignmentStatusDto.Published => "Unpublish",
            AssignmentStatusDto.Closed => "Archive",
            _ => null
        }
    };

    /// <summary>The kebab overflow (UX-5). "Generate questions" anchors to compartment 6
    /// (AI-1/AI-2) and is disabled when the type/grading gate is closed (AI-4). The Save /
    /// Schedule actions only appear where the surface can actually perform them; an Archived
    /// assignment has no secondary actions at all (§11).</summary>
    private IReadOnlyList<RowAction> SecondaryActions
    {
        get
        {
            var actions = new List<RowAction>();

            if (EffectiveMode == AssignmentAuthoringMode.Create)
            {
                actions.Add(GenerateQuestionsAction());
                return actions;
            }

            if (_item is null) return actions;

            var editable = EffectiveMode == AssignmentAuthoringMode.Edit;
            switch (_item.Status)
            {
                case AssignmentStatusDto.Draft:
                    if (editable) actions.Add(RowAction.Callback("Save draft", SaveAsync, FluentIcons.Save));
                    actions.Add(GenerateQuestionsAction());
                    actions.Add(RowAction.Callback("Schedule", OpenScheduleDialogAsync, FluentIcons.Calendar));
                    break;
                case AssignmentStatusDto.Scheduled:
                    if (editable) actions.Add(RowAction.Callback("Save", SaveAsync, FluentIcons.Save));
                    actions.Add(RowAction.Callback("Reschedule", OpenScheduleDialogAsync, FluentIcons.Calendar));
                    break;
                case AssignmentStatusDto.Published:
                    actions.Add(RowAction.Callback("Close", CloseAsync, FluentIcons.Checkmark));
                    break;
            }

            // View mode is the read-only surface (Detail's Overview): the edit surface itself
            // stays one click away for the statuses that still accept structural edits.
            if (!editable && _item.Status is AssignmentStatusDto.Draft or AssignmentStatusDto.Scheduled)
            {
                actions.Add(RowAction.Navigate("Edit", $"/assignments/{_item.Id}/edit", FluentIcons.Edit));
            }

            return actions;
        }
    }

    private RowAction GenerateQuestionsAction() =>
        RowAction.Navigate("Generate questions", "#authoring-questions", FluentIcons.Bot,
            disabled: !GateEnabled,
            // F7: a greyed-out action explains itself instead of being a dead end (the compartment's
            // own hint is shown there too, but the kebab is where the author meets the refusal).
            disabledReason: GateEnabled ? null : QuestionGenerationGate.DisabledHint);

    private async Task OnPrimaryActionAsync()
    {
        switch (EffectiveMode)
        {
            case AssignmentAuthoringMode.Create:
                await SaveAsync();
                break;
            default:
                switch (_item?.Status)
                {
                    case AssignmentStatusDto.Draft:
                        await PublishAsync();
                        break;
                    case AssignmentStatusDto.Scheduled:
                    case AssignmentStatusDto.Published:
                        await UnpublishAsync();
                        break;
                    case AssignmentStatusDto.Closed:
                        await ArchiveAsync();
                        break;
                }
                break;
        }
    }

    // ── Save ─────────────────────────────────────────────────────────────────

    private async Task SaveAsync()
    {
        // P1-3 (UX-21) fail-closed: while the persisted targets could not be read, a save must not
        // write a target set at all — the update handler reads a non-null target collection as a
        // full replacement, which would delete rows this surface never saw.
        if (AudienceEditorDisabledReason is not null)
        {
            _error = AudienceEditorDisabledReason;
            return;
        }

        // AC-4: the builder's entries ARE the assignment's target rows, so they are projected onto the
        // form model before the submit gate and the payload both read the target set.
        SyncTargetsFromBuilder();

        if (!ValidateForSave()) return;

        _busy = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            if (EffectiveMode == AssignmentAuthoringMode.Create)
            {
                var request = _model.ToCreateRequest(
                    SelectedType ?? AssignmentTypeDto.Manual,
                    SelectedGradingFormat,
                    DerivedTargetAudience,
                    TopicId!.Value,
                    _mandatoryReview,
                    _model.ToTargetDtos());

                Logger.LogInformation("Creating assignment {Title} from the authoring page", _model.Title);
                var assignmentId = await Api.CreateAsync(request, ct);

                // D-8.2: the group ids ALSO ride the legacy link route, whose R2 handler is a
                // thin adapter over SetTargets — so the link table the FR-6 delete guard and
                // GET /assignments/{id}/groups read stays in step with the target rows.
                if (TargetIds(TargetKindDto.ActivityGroup).Count > 0)
                {
                    await Api.LinkAssignmentGroupsAsync(assignmentId, _selectedGroupIds.ToList(), ct);
                }

                await Changed.InvokeAsync();
                NavigateToSavedState("/assignments");
                return;
            }

            // UX-21/D-4 change gate: an untouched targeting editor sends null, which the update
            // handler reads as "preserve" — only an actual edit issues a full replacement.
            var update = _model.ToUpdateRequest(
                SelectedType ?? AssignmentTypeDto.Manual,
                SelectedGradingFormat,
                DerivedTargetAudience,
                TopicId!.Value,
                _mandatoryReview,
                _model.TargetsChanged ? _model.ToTargetDtos() : null);

            Logger.LogInformation("Updating assignment {AssignmentId} from the authoring page", Id);
            await Api.UpdateAsync(Id!.Value, update, ct);

            // P2-1/R2: the picker starts from the persisted links, so an actual edit of the group
            // target set is synchronised to the legacy link table too — and only then (the route
            // deletes every link missing from its payload).
            if (TargetIds(TargetKindDto.ActivityGroup).Count > 0
                && _groupLinksLoaded
                && !_loadedGroupIds.SetEquals(_selectedGroupIds))
            {
                await Api.LinkAssignmentGroupsAsync(Id!.Value, _selectedGroupIds.ToList(), ct);

                // The persisted set is now the loaded baseline, so a later save of this same
                // page does not re-issue the replace-set call for an already-written set.
                _loadedGroupIds.Clear();
                _loadedGroupIds.UnionWith(_selectedGroupIds);
            }

            await ReloadAsync();
            await Changed.InvokeAsync();
            NavigateToSavedState($"/assignments/{Id}");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to save assignment {Title}", _model.Title);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _busy = false;
        }
    }

    /// <summary>The client-side mirror of the server-side create/update guards: a subject is
    /// always required, at least one audience target is required (TGT-13), a group target needs
    /// the chosen subject inside the group-subject union (FR-58), and the question / scoring gates
    /// mirror the domain rules. (The retired D-2 primary-grade rule has no successor: the
    /// policy-scope grade is derived from the grade targets, and the server's FR-58 grade gate
    /// still refuses a subject no targeted grade is assigned.)
    /// </summary>
    private bool ValidateForSave()
    {
        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _error = "Title is required.";
            return false;
        }
        if (TopicId is null)
        {
            _error = "Select a subject.";
            return false;
        }

        // TGT-13: at least one target is required.
        if (_model.Targets.Count == 0)
        {
            _error = "Add at least one audience target.";
            return false;
        }

        if (_activityGroupsEnabled && _groupLinksUnavailableReason is not null)
        {
            // P2-1 fail-closed: the picker is disabled because the persisted links are
            // unknown, so asking the author to pick a group would be a dead end.
            _error = _groupLinksUnavailableReason;
            return false;
        }

        // TGT-2: Everyone is mutually exclusive — a state the pickers cannot produce, but the
        // loaded model could carry from legacy data.
        if (_model.HasAllStudents && _model.Targets.Count > 1)
        {
            _error = "An Everyone audience cannot be combined with any other target.";
            return false;
        }

        var groupTargetIds = TargetIds(TargetKindDto.ActivityGroup);
        if (groupTargetIds.Count > 0 && !(_groupSubjects?.Any(s => s.Id == TopicId.Value) ?? false))
        {
            _error = "The selected subject is not assigned to any of the selected activity groups.";
            return false;
        }

        if (!_model.QuestionsPassSubmitGate(SelectedGradingFormat, out var gateError))
        {
            _error = gateError;
            return false;
        }
        if (!_model.ScoringFieldsPassSubmitGate(SelectedGradingFormat, out var scoringError))
        {
            _error = scoringError;
            return false;
        }
        return true;
    }

    // ── Lifecycle actions ────────────────────────────────────────────────────

    /// <summary>UX-6: the publish-time choices are captured in the confirm dialog (replacing
    /// the wizard's Review step) — contact limiting lives in <c>PublishDialog</c>.</summary>
    private async Task PublishAsync()
    {
        if (_item is null) return;
        _busy = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            var contacts = await StudentsApi.ListSubscribedContactsAsync(
                ContactOwnerType.Guardian, null, SubscriptionScope.AllAssignments, ct) ?? [];
            var model = new PublishFormModel(contacts.ToList(), $"Audience: {DerivedAudienceText}", _item.MandatoryReview);

            var result = await DialogService.ShowShellDialogAsync<PublishDialog, PublishFormModel, PublishResult>(
                model, title: "Publish assignment", size: DialogSize.Medium);

            if (result is null) return; // cancelled

            await Api.PublishAsync(_item.Id, result.ContactIds, ct);
            await ReloadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to publish assignment {AssignmentId}", _item.Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _busy = false;
        }
    }

    private async Task UnpublishAsync()
    {
        if (_item is null) return;
        if (!await DialogService.ShowConfirmDialogAsync(
                $"Unpublish assignment '{_item.Title}'? It returns to Draft and its schedule is cleared.",
                primaryText: "Unpublish"))
        {
            return;
        }

        _busy = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            await Api.UnpublishAsync(_item.Id, ct);
            await ReloadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to unpublish assignment {AssignmentId}", _item.Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_item is null) return;
        if (!await DialogService.ShowConfirmDialogAsync(
                $"Close assignment '{_item.Title}'? Closed assignments are read-only.",
                primaryText: "Close"))
        {
            return;
        }

        _busy = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            await Api.CloseAsync(_item.Id, ct);
            await ReloadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to close assignment {AssignmentId}", _item.Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _busy = false;
        }
    }

    private async Task ArchiveAsync()
    {
        if (_item is null) return;
        if (!await DialogService.ShowConfirmDialogAsync(
                $"Archive assignment '{_item.Title}'? Archived assignments are retained read-only.",
                primaryText: "Archive"))
        {
            return;
        }

        _busy = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;
        try
        {
            await Api.ArchiveAsync(_item.Id, ct);
            await ReloadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to archive assignment {AssignmentId}", _item.Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _busy = false;
        }
    }

    private async Task OpenScheduleDialogAsync()
    {
        if (_item is null) return;
        _busy = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            var result = await DialogService.ShowShellDialogAsync<ScheduleDialog, ScheduleFormModel, ScheduleResult>(
                new ScheduleFormModel(), title: "Schedule assignment", size: DialogSize.Medium);

            if (result is null) return; // cancelled

            await Api.ScheduleAsync(_item.Id, result.AvailableFromUtc, ct);
            await ReloadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to schedule assignment {AssignmentId}", _item.Id);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _busy = false;
        }
    }

    private void BackToList() => Nav.NavigateTo("/assignments");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;

        // D-4: a pending/stale preview call must not outlive the component.
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        _previewCts = null;

        // UX-7 (D2): the in-app navigation registration belongs to this component's lifetime.
        _locationChangingRegistration?.Dispose();
        _locationChangingRegistration = null;

        if (_beforeUnloadModule is null)
        {
            return;
        }

        try
        {
            // UX-7 (D2): detach the browser-unload listener before releasing the module, so a stale
            // listener cannot outlive the page it guards.
            if (_beforeUnloadRegistered)
            {
                await _beforeUnloadModule.InvokeVoidAsync("unregisterBeforeUnload");
            }

            await _beforeUnloadModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Server-side Blazor: the circuit can be lost between the call and the awaited disposal
            // — the listener died with the page it belonged to.
        }
        catch (TaskCanceledException)
        {
            // Disposal in flight when the circuit closed — same deal.
        }
        finally
        {
            _beforeUnloadModule = null;
            _beforeUnloadRegistered = false;
        }
    }
}
