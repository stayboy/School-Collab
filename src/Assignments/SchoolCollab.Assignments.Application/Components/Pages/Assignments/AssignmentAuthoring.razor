    private bool ModelHasTarget(TargetKindDto kind, string value) =>
        Guid.TryParse(value, out var id)
        && _model.Targets.Any(t => t.Kind == kind && t.RefId == id);

    /// <summary>
    /// FR-58: the offered subjects are the union of the primary grade's effective list and the
    /// union across the targeted activity groups — the pre-R2 grade-or-group paths, now both driven
    /// by the authored target rows.
    /// <para>The union is CACHED and only rebuilt when one of its two source arrays is replaced: a
    /// fresh array on every render makes the picker see its <c>Items</c> change on each pass, and
    /// the control then drops a selection it cannot match by instance (the subject was silently
    /// cleared between the author's pick and the save).</para>
    /// </summary>
    private PickerOption[] SubjectOptions
    {
        get
        {
            if (!ReferenceEquals(_subjectOptionsUnionSource, _subjectOptions)
                || !ReferenceEquals(_groupSubjectOptionsUnionSource, _groupSubjectOptions))
            {
                _subjectOptionsUnionSource = _subjectOptions;
                _groupSubjectOptionsUnionSource = _groupSubjectOptions;
                _subjectOptionsUnion = _subjectOptions
                    .Concat(_groupSubjectOptions)
                    .GroupBy(o => o.Value)
                    .Select(g => g.First())
                    .ToArray();
            }

            return _subjectOptionsUnion!;
        }
    }

    private PickerOption[]? _subjectOptionsUnion;
    private PickerOption[]? _subjectOptionsUnionSource;
    private PickerOption[]? _groupSubjectOptionsUnionSource;

