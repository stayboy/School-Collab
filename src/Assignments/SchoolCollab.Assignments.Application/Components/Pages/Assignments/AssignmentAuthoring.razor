    /// <summary>R2/grill: the single "Targets &amp; audience" builder's entries.
    /// UI-only, in-memory (no new table/migration); each entry is a category plus the TYPED value
    /// collected through <see cref="TargetsAndAudienceDialog"/>. The entries ARE the assignment's
    /// target rows — <see cref="SyncTargetsFromBuilder"/> projects them onto the form model before a
    /// save, and <see cref="RebuildTargetsAndAudienceFromModel"/> reads the loaded rows back.</summary>
    private readonly List<TargetsAndAudienceEntry> _targetsAndAudience = [];

    /// <summary>Label shown above an entry's value in the card body.</summary>
    private static string TargetCategoryLabel(TargetsAndAudienceCategory category) => category switch
    {
        TargetsAndAudienceCategory.GradeLevels => "Grade Levels",
        TargetsAndAudienceCategory.Streams => "Streams",
        TargetsAndAudienceCategory.Students => "Students",
        TargetsAndAudienceCategory.ActivityGroups => "Activity Groups",
        _ => "Applies to All in Org"
    };

    /// <summary>
    /// The builder category a persisted target kind belongs to — the one map between the closed
    /// category set and <see cref="TargetKindDto"/>, read by both the load rebuild and the save sync
    /// so the two can never disagree. <see cref="TargetKindDto.AllStudents"/> is the single Everyone
    /// row (no ref id), not an entity kind.
    /// </summary>
    private static TargetsAndAudienceCategory BuilderCategoryOf(TargetKindDto kind) => kind switch
    {
        TargetKindDto.GradeLevel => TargetsAndAudienceCategory.GradeLevels,
        TargetKindDto.Stream => TargetsAndAudienceCategory.Streams,
        TargetKindDto.Student => TargetsAndAudienceCategory.Students,
        TargetKindDto.ActivityGroup => TargetsAndAudienceCategory.ActivityGroups,
        _ => TargetsAndAudienceCategory.Everyone
    };

    /// <summary>The page's option list for a builder entity category — the label source for a loaded
    /// target row. Empty for Everyone, which references no entity (and for Students, which the page
    /// never preloads: that row's label falls back to its id).</summary>
    private PickerOption[] TargetOptionsFor(TargetsAndAudienceCategory category) => category switch
    {
        TargetsAndAudienceCategory.GradeLevels => _gradeLevelOptions,
        TargetsAndAudienceCategory.Streams => _streamOptions,
        TargetsAndAudienceCategory.ActivityGroups => _activityGroupOptions,
        _ => []
    };

    /// <summary>
    /// AC-5: rebuilds the builder's entries from the form model's target rows — one entry per row, in
    /// the model's DisplayOrder (the persisted order), so an edit surface shows the targets the server
    /// actually holds. The label comes from the loaded option list and falls back to the bare id, so a
    /// reference the page has no option for still renders (and stays removable).
    /// </summary>
    private void RebuildTargetsAndAudienceFromModel()
    {
        _targetsAndAudience.Clear();

        foreach (var target in _model.Targets)
        {
            if (target.Kind == TargetKindDto.AllStudents)
            {
                _targetsAndAudience.Add(new TargetsAndAudienceEntry(
                    TargetsAndAudienceCategory.Everyone, null, TargetsAndAudienceEntry.EveryoneLabel));
                continue;
            }

            // A ref-id target row without a ref id cannot be represented as a typed entry, and must
            // never be collapsed onto Guid.Empty: the server rejects such a row, so this is a guard
            // against inventing a reference, not a path a real load takes.
            if (target.RefId is not Guid refId)
            {
                continue;
            }

            var category = BuilderCategoryOf(target.Kind);
            _targetsAndAudience.Add(new TargetsAndAudienceEntry(category, refId, TargetLabelOf(category, refId)));
        }
    }

    /// <summary>The label of the option a persisted target row references, falling back to the bare id
    /// so a row the page has no option for (a student, a deleted grade level) still names something.</summary>
    private string TargetLabelOf(TargetsAndAudienceCategory category, Guid refId) =>
        TargetOptionsFor(category).FirstOrDefault(o => o.Value == refId.ToString())?.Label
        ?? refId.ToString();

    /// <summary>
    /// AC-4: projects the builder's authored entries onto the form model's target rows, so the save
    /// payload carries exactly what the card shows. Only the model's existing API is used —
    /// <c>SetTargetsOfKind</c> per entity kind (an empty list clears that kind) — and
    /// <c>SetEveryoneTarget(true)</c> for Everyone, which REPLACES the whole set and therefore runs
    /// INSTEAD of the per-kind calls, never alongside them.
    /// <para>Each kind is written only when its ids actually differ from the model's: the model's
    /// setter removes-then-appends, so a blanket rebuild would re-order the rows of an untouched set
    /// — and the update path reads a re-ordered set as a changed one, which would make a no-op save
    /// replace the persisted rows and their DisplayOrder.</para>
    /// </summary>
    private void SyncTargetsFromBuilder()
    {
        if (_targetsAndAudience.Any(e => e.Category == TargetsAndAudienceCategory.Everyone))
        {
            // Grill Q6 keeps Everyone mutually exclusive with every entity entry, so this is the
            // whole authored set: one AllStudents row and nothing else.
            _model.SetEveryoneTarget(true);
            return;
        }

        if (_model.HasAllStudents)
        {
            // Mutual exclusivity, the other direction: the authored set holds no Everyone entry, so a
            // model that still carries the loaded AllStudents row (an edit-loaded Everyone assignment
            // whose entry was removed) is stale — the save would persist a target the card no longer
            // shows. Cleared through SetTargetsOfKind, which removes only the AllStudents rows, so the
            // per-kind diff below still preserves an untouched entity set.
            _model.SetTargetsOfKind(TargetKindDto.AllStudents, []);
        }

        foreach (var kind in Enum.GetValues<TargetKindDto>())
        {
            if (kind == TargetKindDto.AllStudents)
            {
                // AC-4: an AllStudents row carries no ref id, so it is set by SetEveryoneTarget
                // alone — SetTargetsOfKind would store Guid.Empty.
                continue;
            }

            var authoredIds = _targetsAndAudience
                .Where(e => e.Category == BuilderCategoryOf(kind) && e.RefId.HasValue)
                .Select(e => e.RefId!.Value)
                .Distinct()
                .ToList();

            if (!authoredIds.SequenceEqual(TargetIds(kind)))
            {
                _model.SetTargetsOfKind(kind, authoredIds);
            }
        }
    }

    /// <summary>
    /// Removes a previously added entry from the builder. Record VALUE equality is not enough here:
    /// two entries may legitimately be equal (the same category and ref id added twice), so removing
    /// by value would drop the FIRST match when the second one was clicked. The entry instance the
    /// rendered row closed over is the one identity that names the clicked row.
    /// </summary>
    private async Task RemoveTargetEntryAsync(TargetsAndAudienceEntry entry)
    {
        _targetsAndAudience.RemoveAll(e => ReferenceEquals(e, entry));
        await OnTargetsChangedAsync();
    }

    /// <summary>Opens the single add dialog (category + a single-value picker that APPENDS every pick
    /// as a chip), then appends every entry it returned. Inert while the builder is disabled, so the
    /// unknown persisted set can never be extended (P1-3).</summary>
    private async Task OpenTargetsAndAudienceDialogAsync()
    {
        if (!BuilderAddEnabled)
        {
            return;
        }

        // DialogSize.Large (720px), not the Small (420px) default: the dialog's entity pickers are
        // multi-select listboxes, and the dialog's `full-width` fields floor at 400px — beside the
        // fixed 180px label column, only the 720px body leaves the option rows that room.
        var result = await DialogService.ShowShellDialogAsync<
            TargetsAndAudienceDialog, TargetsAndAudienceDialogModel, TargetsAndAudienceDialogResult>(
            BuildTargetsAndAudienceDialogModel(),
            "Add target & audience",
            DialogSize.Large);

        if (result is null || result.Entries.Count == 0)
        {
            return;
        }

        // Grill Q6: "everyone" is mutually exclusive with any other category. The dialog clears the
        // opposite side on either pick (an Everyone checkpoint clears the entity chips, an entity
        // pick clears the Everyone entry), and the page ACCUMULATES across dialog opens, so a batch may
        // be MIXED-KIND — several categories merged into one target set — and the merge below is the
        // page-side enforcement: an Everyone entry in the batch still clears every entity entry, and a
        // batch without one still clears the Everyone entry.
        if (result.Entries.Any(e => e.Category == TargetsAndAudienceCategory.Everyone))
        {
            _targetsAndAudience.RemoveAll(e => e.Category != TargetsAndAudienceCategory.Everyone);
        }
        else
        {
            _targetsAndAudience.RemoveAll(e => e.Category == TargetsAndAudienceCategory.Everyone);
        }

        _targetsAndAudience.AddRange(result.Entries);
        await OnTargetsChangedAsync();
    }

    /// <summary>
    /// The dialog's form model: the page owns the option sources (grade levels, streams, activity
    /// groups) and the student search, so the dialog itself stays data-free. The student search runs on
    /// the page's load token — the dialog has no cancellation source of its own, and a reload that
    /// swaps this instance must take an in-flight search with it.
    /// </summary>
    private TargetsAndAudienceDialogModel BuildTargetsAndAudienceDialogModel() => new()
    {
        GradeLevelOptions = ToDialogOptions(_gradeLevelOptions),
        StreamOptions = ToDialogOptions(_streamOptions),
        ActivityGroupOptions = ToDialogOptions(_activityGroupOptions),
