    /// <summary>
    /// Round <c>drop-primary-grade</c>: the policy-scope grade the effective-policy resolution asks
    /// for, DERIVED from the grade targets by the one shared rule — exactly one distinct grade
    /// target ⇒ that grade, otherwise <see langword="null"/> (the tenant-default leg).
    /// <para>Mirrors <c>SchoolCollab.Assignments.Core.Services.AssignmentPolicyScope.DeriveGrade</c>,
    /// which this project cannot reference (Assignments.Application does not reference
    /// Assignments.Core); the page's input is the form model's DTO-kind target rows rather than the
    /// entity's, so the one-line derivation is the whole rule.</para>
    /// </summary>
    private Guid? DerivedPolicyGrade => DerivePolicyGrade(KnownGradeTargetIds);

    /// <summary>The one-distinct-grade rule over a grade-target id set — the page's one spelling of
    /// <c>AssignmentPolicyScope.DeriveGrade</c>. Kept byte-for-byte equivalent to the Core rule on
    /// purpose (it is the same function): drop <see cref="Guid.Empty"/>, de-duplicate, then exactly
    /// one distinct grade ⇒ that grade, else <see langword="null"/>. A future edit here must mirror
    /// any change to <c>src/Assignments/SchoolCollab.Assignments.Core/Services/AssignmentPolicyScope.cs</c>.</summary>
    private static Guid? DerivePolicyGrade(IReadOnlyList<Guid> gradeTargetIds) =>
        gradeTargetIds.Where(id => id != Guid.Empty).Distinct().ToArray() is [var onlyGrade]
            ? onlyGrade
            : null;

    /// <summary>
    /// FR-58: the offered subjects are the union of the targeted grade levels' effective lists and the
    /// union across the targeted activity groups — the pre-R2 grade-or-group paths, now both driven
    /// by the authored target rows (round <c>drop-primary-grade</c>: the grade leg is the union over
    /// the distinct grade targets, not over one authored primary grade).
    /// <para>The union is CACHED and only rebuilt when one of its two source arrays is replaced: a
    /// fresh array on every render makes the picker see its <c>Items</c> change on each pass, and
    /// the control then drops a selection it cannot match by instance (the subject was silently
    /// cleared between the author's pick and the save).</para>
    /// </summary>
    private PickerOption[] SubjectOptions
    {
        get
        {
            if (!ReferenceEquals(_subjectOptionsUnionSource, _subjectOptions)
                || !ReferenceEquals(_groupSubjectOptionsUnionSource, _groupSubjectOptions))
            {
                _subjectOptionsUnionSource = _subjectOptions;
                _groupSubjectOptionsUnionSource = _groupSubjectOptions;
                _subjectOptionsUnion = _subjectOptions
                    .Concat(_groupSubjectOptions)
                    .GroupBy(o => o.Value)
                    .Select(g => g.First())
                    .ToArray();
            }

            return _subjectOptionsUnion!;
        }
    }

    private PickerOption[]? _subjectOptionsUnion;
    private PickerOption[]? _subjectOptionsUnionSource;
    private PickerOption[]? _groupSubjectOptionsUnionSource;

    private bool SubjectPickerDisabled =>
        (KnownGradeTargetIds.Count == 0 && _selectedGroupIds.Count == 0)
        || SubjectOptions.Length == 0
        || _loadingSubjects
        || _loadingGroupSubjects;

    private string SubjectPickerPlaceholder =>
        KnownGradeTargetIds.Count == 0 && _selectedGroupIds.Count == 0
            ? "Select a grade level or activity group first"
            : "Select a subject";


