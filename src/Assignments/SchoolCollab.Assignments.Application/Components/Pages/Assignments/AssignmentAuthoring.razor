@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Core.AssignmentPolicies
@using SchoolCollab.Core.Features
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Application.Components.Students
@using Microsoft.JSInterop
@inject AssignmentsApiClient Api
@inject StudentsApiClient StudentsApi
@inject IFeatureFlagService FeatureFlags
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<AssignmentAuthoring> Logger
@implements IAsyncDisposable

@*
    The ONE compartmentalized assignment authoring surface
    (documents/specs/assignment-authoring-compartments.md §3–§6, §9, §11, §12; R1).

    Modes (UX-9): Create (empty form → Draft) · Edit (loaded form, full parity while
    Draft|Scheduled) · View (read-only; Published|Closed|Archived). Edit degrades to View
    internally for a later status so hosts never test the status themselves.

    Layout (UX-3/UX-4/UX-8): all five compartments stacked in one scroll as
    section-card-style blocks, a sticky compartment jump-nav, and a sticky action bar whose
    primary action follows the §11 status matrix with the secondary actions in a kebab.

    Conditional fields follow UX-17/UX-18/UX-19 — inapplicable controls render DISABLED
    with an inline reason, never hidden, so changing type/grading never reflows the page.
    Policy-derived values follow UX-13 — read-only resolved values with an
    "Inherited from Grade/Tenant policy" badge, never an editable control.

    UX-7 (D2/D3): leaving the page with unsaved changes is guarded on BOTH paths — an in-app
    navigation is cancelled by a registered location-changing handler and confirmed with the
    shared FluentUI dialog, while a tab close / reload / external URL is covered by the collocated
    ``AssignmentAuthoring.razor.js`` module's ``window.beforeunload`` listener. "Unsaved" is a
    BASELINE COMPARISON against the loaded state, never an event flag.

    Out of scope for R1 (R2/R3): multi-constraint targeting + recipient preview, attachment
    grounded AI generation.
*@

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (Mode != AssignmentAuthoringMode.Create && _item is null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">Assignment not found.</FluentMessageBar>
            <FluentButton Appearance="Appearance.Outline" OnClick="BackToList">Back to List</FluentButton>
        }
        else
        {
            <div class="authoring-page">
                <header class="authoring-actionbar">
                    <div class="authoring-title-group">
                        <h2 class="authoring-heading">@HeadingText</h2>
                        @if (_item is not null)
                        {
                            <FluentBadge Appearance="@StatusAppearance(_item.Status)">@_item.Status</FluentBadge>
                        }
                    </div>
                    <div class="authoring-actionbar-controls">
                        @if (PrimaryActionLabel is not null)
                        {
                            <FluentButton Id="authoring-primary-action"
                                          Appearance="Appearance.Accent"
                                          Disabled="@_busy"
                                          OnClick="OnPrimaryActionAsync">
                                @(_busy ? "Working…" : PrimaryActionLabel)
                            </FluentButton>
                        }
                        @if (SecondaryActions.Count > 0)
                        {
                            @* UseMenuService="false" keeps the kebab items in the rendered DOM
                               (the Index.razor landing-grid precedent) — the module registers no
                               FluentMenuProvider. *@
                            <RowActionsMenu UseMenuService="false"
                                            ForceKebab="true"
                                            Actions="@SecondaryActions"
                                            AriaLabel="More assignment actions" />
                        }
                    </div>
                </header>

                <nav class="authoring-jumpnav" aria-label="Assignment compartments">
                    @foreach (var compartment in Compartments)
                    {
                        <FluentAnchor @key="compartment.Anchor"
                                      Id="@($"jump-{compartment.Anchor}")"
                                      Appearance="Appearance.Hypertext"
                                      Href="@($"#authoring-{compartment.Anchor}")"
                                      class="authoring-jumpnav-link">@compartment.Title</FluentAnchor>
                    }
                </nav>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Id="authoring-error" Intent="MessageIntent.Error" class="authoring-message">@_error</FluentMessageBar>
                }

                @* UX-7 / F17 (this round): the parameter change reloaded this instance and took unsaved
                   edits with it — the one case the in-app guard cannot see (a host swapping Id/Mode without
                   a NavigationManager navigation). It sits beside the error bar so it is read with the
                   surface it describes, not buried in a compartment. *@
                @if (_unsavedEditsDiscarded)
                {
                    <p class="authoring-reason" id="authoring-unsaved-edits-discarded">@UnsavedEditsDiscardedNotice</p>
                }

                @* ── 1 · Basics (the always-on spine, §3/UX-12) ───────────────── *@
                <div class="authoring-layout">
                    <section id="authoring-basics" class="authoring-compartment">
                        <h3 class="authoring-compartment-title">Basics</h3>

                        <FormRow Label="Title" Required For="authoring-basics-title">
                            <FluentTextField Id="authoring-basics-title" @bind-Value="_model.Title" Required
                                             ReadOnly="@IsReadOnly" Placeholder="e.g. Chapter 5 Quiz" class="full-width" />
                        </FormRow>

                        <FormRow Label="Description" For="authoring-basics-description">
                            <FluentTextArea Id="authoring-basics-description" @bind-Value="_model.Description"
                                            ReadOnly="@IsReadOnly" Rows="3"
                                            Placeholder="Internal note for other teachers…" class="full-width" />
                        </FormRow>

                        @* INS-1/INS-2: student-facing task text, distinct from Description. *@
                        <FormRow Label="Instructions" For="authoring-basics-instructions">
                            <FluentTextArea Id="authoring-basics-instructions" @bind-Value="_model.Instructions"
                                            ReadOnly="@IsReadOnly" Rows="4"
                                            Placeholder="What the student must do — shown to students…" class="full-width" />
                        </FormRow>

                        @* Round authoring-compact-fields: type + grading are two short pickers, so they
                           render as ONE row of the shared FormRow primitive. AlignTop is the
                           repo's multi-input row pattern (flex-row-input-alignment): the row's own input
                           cell already lays its children inline (8px gap) and top-aligned, and the row keeps the shared 180px label
                           gutter, so the pair lines up with every single-field row. Do NOT add
                           LabelPosition="Below" here: it drops that gutter and renders the pair's one
                           label under its FIRST control — no bespoke CSS, no new component. *@
                        <FormRow Label="Assignment type &amp; grading format" Required AlignTop
                                 For="authoring-basics-type">
                            <FluentSelect TOption="PickerOption" Id="authoring-basics-type"
                                          Items="@TypeOptions" @bind-SelectedOption="_selectedType"
                                          OptionText="@(o => o?.Label ?? string.Empty)"
                                          OptionValue="@(o => o?.Value ?? string.Empty)"
                                          Disabled="@IsReadOnly" Class="w-6" />
                            <FluentSelect TOption="PickerOption" Id="authoring-basics-grading" aria-label="Grading format"
                                          Items="@GradingFormatOptions" @bind-SelectedOption="_selectedGradingFormat"
                                          OptionText="@(o => o?.Label ?? string.Empty)"
                                          OptionValue="@(o => o?.Value ?? string.Empty)"
                                          Disabled="@IsReadOnly" Class="w-6" />
                        </FormRow>

                        @* D9 + OD1 (round authoring-compact-fields): the author-fed scoring fields sit
                           directly under the Grading format control that already drives them. The attempt
                           cap joins the max score here — the two short number fields are paired — and it
                           keeps the UX-17/D12 gate: for TeacherGraded it renders DISABLED with the one
                           reason ScoringFieldsSection still prints below the pass score, so the page
                           never reflows when the grading format changes. *@
                        <FormRow Label="Max score &amp; max attempts" AlignTop
                                 For="authoring-basics-max-score">
                            <FluentNumberField Id="authoring-basics-max-score" @bind-Value="_model.MaxScore"
                                               ReadOnly="@IsReadOnly" Class="w-3" />
                            <FluentNumberField Id="scoringFieldsMaxAttempts" aria-label="Max attempts" @bind-Value="_model.MaxAttempts"
                                               Class="w-3"
                                               Disabled="@ScoringFieldsSection.IsScoringInapplicable(SelectedGradingFormat)" />
                        </FormRow>

                        <p class="authoring-hint" id="authoring-feedback-mode">
                            Feedback mode: @EnumHelper.GetDescription(SelectedGradingFormat)
                        </p>

                        @* UX-17/UX-18: the pass-score / attempt-cap pair renders disabled with an
                           inline reason for TeacherGraded instead of disappearing — the disable logic
                           moved with the fields. *@
                        <ScoringFieldsSection Model="_model" GradingFormat="SelectedGradingFormat" />

                        @* OD3: the author guardian-review toggle lives beside the grading format. It is
                           editable ONLY while the effective policy leaves review unset; a policy-set value
                           locks it (disabled with an inline reason), and Rules carries the policy readout. *@
                        <FormRow Label="Guardian review" For="authoring-basics-mandatory-review">
                            <FluentCheckbox Id="authoring-basics-mandatory-review"
                                            @bind-Value="_mandatoryReview"
                                            Label="Require guardian review before student submits"
                                            Disabled="@(IsReadOnly || PolicyReviewLocked)"
                                            Tooltip="@(PolicyReviewLocked ? PolicyReviewLockedReason : null)" />
                        </FormRow>
                        @if (PolicyReviewLocked)
                        {
                            <p class="authoring-reason" id="authoring-review-policy-reason">@PolicyReviewLockedReason</p>
                        }

                        @* FR-220 / UX-19: the AI-availability hint lives with the type/grading choice. *@
                        <p class="authoring-hint" id="authoring-generation-hint">
                            @QuestionGenerationGate.HintText(SelectedType, SelectedGradingFormat)
                        </p>

                        <FormRow Label="Subject" Required For="authoring-basics-subject">
                            <FluentSelect TOption="PickerOption" Id="authoring-basics-subject"
                                          Items="@SubjectOptions" @bind-SelectedOption="_selectedSubject"
                                          OptionText="@(o => o?.Label ?? string.Empty)"
                                          OptionValue="@(o => o?.Value ?? string.Empty)"
                                          Placeholder="@SubjectPickerPlaceholder"
                                          Disabled="@(IsReadOnly || SubjectPickerDisabled)" class="full-width" />
                        </FormRow>

                        @* D1/D2: the retired Delivery & Publishing compartment's lifecycle facts and its one
                           author field. Rules is readouts-only, so the author's due date and the two
                           always-derived delivery readouts sit on the always-on Basics spine instead.
                           Round authoring-compact-fields: Status + Available from are the compact pair. *@
                        <FormRow Label="Status &amp; available from" AlignTop
                                 For="authoring-basics-status">
                            <span class="authoring-readonly-value" id="authoring-basics-status">
                                @(_item?.Status.ToString() ?? "New draft")
                            </span>
                            <span class="authoring-readonly-value" id="authoring-basics-available-from">
                                @(_item?.AvailableFromUtc?.ToLocalTime().ToString("g") ?? "—")
                            </span>
                        </FormRow>

                        <FormRow Label="Due date" For="authoring-basics-due">
                            <FluentDatePicker Id="authoring-basics-due" @bind-Value="_model.DueDate"
                                              @bind-Value:after="OnDueDateChangedAsync" ReadOnly="@IsReadOnly"
                                              Class="w-4" />
                        </FormRow>
                    </section>

                    <section id="authoring-targets" class="authoring-compartment authoring-compartment--right">
                        @* Round drop-primary-grade: the assignment carries no primary grade. The
                           grade half of the audience is authored as grade TARGET rows in the builder
                           below; the policy-scope grade is derived from them (one distinct grade ⇒
                           that grade, otherwise the tenant default). *@
                        @if (_gradeLevels is { Length: 0 })
                        {
                            <FluentMessageBar Intent="MessageIntent.Warning">
                                No grade levels available. Please create grade levels in the Students module first.
                            </FluentMessageBar>
                        }

                        @* UX-21 load-half, fail-closed: when an editable Edit surface could not read the
                           persisted targets, the builder renders DISABLED WITH REASON (never live-empty) —
                           a first add over an unknown set is what the save path would write as a full
                           replacement. *@
                        @if (AudienceEditorDisabledReason is not null)
                        {
                            <p class="authoring-reason" id="authoring-targets-reason">@AudienceEditorDisabledReason</p>
                        }

                        @* The card keeps SectionCard's native header Add (grill Q4) and its header IS the
                           compartment's single title — the section renders no <h3> of its own. The Add is
                           wired through SectionCard's own ShowAddButton (the card header shows no Add while
                           the audience editor is disabled) and the disabled state renders the
                           disabled-with-reason replacement below the card. *@
                        <SectionCard TItem="TargetsAndAudienceEntry"
                                     Title="Targets & audience"
                                     Count="@_targetsAndAudience.Count"
                                     ShowAddButton="@BuilderAddEnabled"
                                     AddTitle="Add target"
                                     AddAriaLabel="Add target"
                                     OnAddClick="@OpenTargetsAndAudienceDialogAsync"
                                     Items="@_targetsAndAudience.ToArray()"
                                     EmptyMessage="No targets yet. Click + to add.">
                            <ItemTemplate Context="entry">
                                <div class="targets-audience-item">
                                    <div class="targets-audience-item__text">
                                        <span class="targets-audience-item__label">@TargetCategoryLabel(entry.Category)</span>
                                        <span class="targets-audience-item__value">@entry.Label</span>
                                    </div>
                                    @* P1-1: the remove action lives INSIDE the ItemTemplate — SectionCard
                                       ignores ItemActions whenever a template is supplied. *@
                                    <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small"
                                                  IconStart="@FluentIcons.Delete" Title="Remove"
                                                  AriaLabel="@($"Remove {entry.Label}")"
                                                  Disabled="@BuilderDisabled"
                                                  OnClick="() => RemoveTargetEntryAsync(entry)" />
                                </div>
                            </ItemTemplate>
                        </SectionCard>

                        @if (AudienceEditorDisabledReason is not null)
                        {
                            <FluentButton Appearance="Appearance.Outline"
                                          IconStart="@FluentIcons.Add"
                                          Title="Add target"
                                          AriaLabel="Add target"
                                          Disabled="true">Add target</FluentButton>
                        }

                        @* TGT-16 / D-4: live, server-resolved, advisory preview (debounced; never blocks
                           save). F10: a degraded read answers all-zero counts, so only the unavailable
                           reason renders then — counts that merely LOOK trustworthy are never shown beside
                           it. F11: the preview resolves on an editable surface only, so a read-only View
                           renders PreviewAuthorOnlyNote (via PreviewText) rather than a "Preview pending…"
                           that can never settle. *@
                        @if (!IsReadOnly && _previewDegraded)
                        {
                            <p class="authoring-reason" id="authoring-audience-preview-note">@PreviewUnavailableReason</p>
                        }
                        else
                        {
                            <p class="authoring-hint" id="authoring-audience-preview">@PreviewText</p>
                        }

                        @* ── 3 · Rules (D1/D2: policy-derived readouts only) ────────────
                           Round authoring-compact-fields (OD1/OD2): the five policy readouts render as a
                           SectionCard stacked directly beneath the Targets & audience card, inside this same
                           right-hand column (the element carrying authoring-compartment--right).
                           OD2: all five stay card items and the card's own row chrome wraps — no compact row
                           component, no truncation. The card header IS the compartment's single title (no
                           <h3>), ShowAddButton="false" hides the header Add (a readout list authors
                           nothing), and #authoring-rules stays on the card's container so the jump-nav
                           anchor still resolves. *@
                        <div id="authoring-rules" class="authoring-rules-card">
                            <SectionCard TItem="PolicyReadout"
                                         Title="Rules"
                                         Count="@PolicyReadouts.Length"
                                         ShowAddButton="false"
                                         OnAddClick="@NoAddActionAsync"
                                         Items="@PolicyReadouts">
                                <ItemTemplate Context="readout">
                                    @* UX-13: a policy-derived value is the resolved read-only text plus the
                                       inherited badge and — when one grade owns the policy — the link to it.
                                       The row keeps the .authoring-policy-row chrome it had in the spine. *@
                                    <div class="authoring-policy-row" id="@readout.Id">
                                        <span class="authoring-policy-label">@readout.Label</span>
                                        <span class="authoring-policy-value">@readout.Value</span>
                                        <FluentBadge Appearance="Appearance.Lightweight">@InheritedPolicyBadgeText</FluentBadge>
                                        @if (PolicyLinkHref is not null)
                                        {
                                            <FluentAnchor Appearance="Appearance.Hypertext" Href="@PolicyLinkHref"
                                                          class="authoring-policy-link">Grade policy</FluentAnchor>
                                        }
                                    </div>
                                </ItemTemplate>
                            </SectionCard>

                            <p class="authoring-hint" id="authoring-rules-hint">
                                These values are resolved from your grade and organization policy — they are not authored per assignment.
                            </p>
                        </div>
                    </section>
                </div>

                @* ── Row 2 · Content & Resources / Questions & AI ────────────────
                   Round content-questions-modern-ui (spec §4, decisions D1/D9): the two
                   compartments are composed as ONE row mirroring the reference project page —
                   Questions & AI in the main column, Content & Resources in the rail. Grid
                   AREAS do the placing; DOM order stays content → questions so the compartment
                   order assertion and the jump-nav order are untouched. *@
                <div class="authoring-layout authoring-layout--cq">
                    @* ── 5 · Content & Resources (always active, UX-19) ───────────── *@
                    <section id="authoring-content" class="authoring-compartment authoring-compartment--cq">
                        @if (IsReadOnly)
                        {
                            <div class="cq-header">
                                <h3 class="authoring-compartment-title">Content &amp; Resources</h3>
                            </div>
                            <p class="authoring-hint">
                                Attachments and URL resources are managed on the assignment's edit surface.
                            </p>
                        }
                        else if (ChildrenEditorDisabledReason is not null)
                        {
                            <div class="cq-header">
                                <h3 class="authoring-compartment-title">Content &amp; Resources</h3>
                            </div>
                            @* P1 fail-closed: no live-empty editor, so an add can never replace the
                               persisted set (the update handler full-replaces a non-null collection). *@
                            <p class="authoring-reason" id="authoring-content-reason">@ChildrenEditorDisabledReason</p>
                        }
                        else
                        {
                            @* CR-1/D3: on the live surface the section owns its card header
                               (title + count + the + that reveals the link input), so the page
                               renders no duplicate heading here — X-1 still holds because the
                               h3 is a descendant of #authoring-content. *@
                            <ResourcesSection Model="_model" Changed="OnModelChanged" AssignmentId="_item?.Id" />
                        }
                    </section>

                    @* ── 6 · Questions & AI (UX-19: disabled-with-reason, never hidden) ── *@
                    <section id="authoring-questions" class="authoring-compartment authoring-compartment--cq">
                        <div class="cq-header">
                            <h3 class="authoring-compartment-title">Questions &amp; AI</h3>
                        </div>
                        @if (IsReadOnly)
                        {
                            <p class="authoring-hint">
                                Questions are managed on the assignment's edit surface.
                            </p>
                        }
                        else if (ChildrenEditorDisabledReason is not null)
                        {
                            <p class="authoring-reason" id="authoring-questions-reason">@ChildrenEditorDisabledReason</p>
                        }
                        else if (!GateEnabled)
                        {
                            <p class="authoring-reason" id="authoring-questions-reason">@QuestionGenerationGate.DisabledHint</p>
                            <QuestionGenerationSection Model="_model"
                                                       GateEnabled="false"
                                                       TopicId="@TopicId"
                                                       TopicName="@_selectedSubject?.Label"
                                                       TargetGradeLevels="@TargetGradeLevels"
                                                       PromptLocked="_aiPromptLocked"
                                                       AssignmentId="_item?.Id"
                                                       OnQuestionsChanged="OnModelChanged" />
                            <QuestionEditorSection Model="_model" Changed="OnModelChanged" />
                        }
                        else
                        {
                            <QuestionGenerationSection Model="_model"
                                                       GateEnabled="true"
                                                       TopicId="@TopicId"
                                                       TopicName="@_selectedSubject?.Label"
                                                       TargetGradeLevels="@TargetGradeLevels"
                                                       PromptLocked="_aiPromptLocked"
                                                       AssignmentId="_item?.Id"
                                                       OnQuestionsChanged="OnModelChanged" />
                            <QuestionEditorSection Model="_model" Changed="OnModelChanged" />
                            @if (_item is not null && _item.Status == AssignmentStatusDto.Draft)
                            {
                                <QuestionsDraftSection AssignmentId="_item.Id"
                                                       Model="_model"
                                                       GateEnabled="true"
                                                       PromptLocked="_aiPromptLocked"
                                                       TopicId="@TopicId"
                                                       TopicName="@_selectedSubject?.Label"
                                                       TargetGradeLevels="@TargetGradeLevels"
                                                       OnConfirmed="ReloadAsync" />
                            }
                        }
                    </section>
                </div>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>UX-13: the badge every policy-derived (non-editable) value carries.
    /// Declared once so the markup, the spec wording and the bUnit suite cannot drift.</summary>
    public const string InheritedPolicyBadgeText = "Inherited from Grade/Tenant policy";

    /// <summary>D3/OD3 (round <c>assignment-rules-policy-rework</c>): the inline reason (also the
    /// toggle's tooltip) shown when the resolved effective policy SETS guardian review — a
    /// policy-set value is not author-editable, so the Basics toggle renders disabled with this
    /// explanation. Mirrors the retired signature checkbox's lock precedent.</summary>
    public const string PolicyReviewLockedReason =
        "Your organization's policy sets guardian review for assignments in this grade, so it cannot be changed here.";

    /// <summary>D6/OD2: the built-in archive retention floor the write seam falls back to when the
    /// resolved policy leaves the archive window unset — mirrors <c>Assignment.Create</c>'s default.</summary>
    private const int DefaultArchiveGraceDays = 30;

    /// <summary>P1 rework, fail-closed: the reason the Content &amp; Resources and
    /// Questions &amp; AI editors render disabled with when an editable Edit surface could
    /// not load the assignment's persisted children. Adding to a blank form there is what
    /// let one new question/URL delete every persisted child.</summary>
    public const string ChildrenUnavailableReason =
        "The saved questions, attachments and links could not be loaded, so these editors are disabled — " +
        "adding to a blank form would replace what is already saved. Reload the page to try again.";

    /// <summary>P2-1 rework, fail-closed: the reason the activity-group picker renders
    /// disabled with when the assignment's persisted links could not be read. An unknown
    /// link set must never be written over the stored one (the replace-set route deletes
    /// whatever is not in the payload).</summary>
    public const string GroupLinksUnavailableReason =
        "The activity groups already linked to this assignment could not be loaded, so this picker is " +
        "disabled — saving would replace the existing links. Reload the page to try again.";

    // ── UX-7: the unsaved-changes guard (D2/D3) ─────────────────────────────

    /// <summary>UX-7 (D2) in-app half: the confirmation shown when a navigation would discard
    /// authored-but-unsaved values.</summary>
    public const string UnsavedChangesMessage =
        "This assignment has unsaved changes — leaving now discards them.";

    /// <summary>UX-7 (D2): the confirmation's primary action — leaves and discards.</summary>
    public const string UnsavedChangesDiscardAction = "Discard changes";

    /// <summary>UX-7 (D2): the confirmation's secondary action — cancels the navigation and stays.
    /// The guard cancels on ANY non-discard outcome (secondary, ESC, overlay click), so staying is
    /// always the safe default.</summary>
    public const string UnsavedChangesKeepEditingAction = "Keep editing";

    /// <summary>UX-7 / F17 (this round) defence-in-depth: the notice the parameter-change reload
    /// renders when it discarded unsaved edits that <b>no</b> confirmation consented to. D2 — the reload
    /// itself still proceeds (refusing it would leave the previous assignment's state on screen under
    /// the new assignment's URL, the stale-write path F17 removed), so what is removed here is only the
    /// <i>silence</i>. Deliberately not a public const: it is page wording, not a contract, and this
    /// round adds no public API member (D3) — the bUnit suite pins the rendered element by id.
    /// </summary>
    private const string UnsavedEditsDiscardedNotice =
        "This form was reloaded for a different assignment or mode without a confirmation, so the unsaved " +
        "edits you had made were discarded.";

    /// <summary>UX-7 (D2) browser-unload half: the collocated module that owns
    /// <c>window.beforeunload</c>. Collocated <c>*.razor.js</c> is served from the Razor class
    /// library's static-web-asset root (<c>_content/{assembly}/…</c>), the
    /// <c>fileDownload.js</c> precedent.</summary>
    public const string BeforeUnloadModulePath =
        "./_content/SchoolCollab.Assignments.Application/Components/Pages/Assignments/AssignmentAuthoring.razor.js";

    /// <summary>The requested mode (UX-9). <see cref="AssignmentAuthoringMode.Edit"/> degrades
    /// to <see cref="AssignmentAuthoringMode.View"/> for a Published/Closed/Archived
    /// assignment — see <see cref="EffectiveMode"/>.</summary>
    [Parameter, EditorRequired] public AssignmentAuthoringMode Mode { get; set; } = AssignmentAuthoringMode.View;

    /// <summary>The assignment to load for Edit / View. Unused (and ignored) in Create mode.</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>D-4: the clock the 500 ms trailing preview debounce runs on. BCL default so the
    /// component needs no host wiring; a bUnit test substitutes a controllable
    /// <see cref="TimeProvider"/> because the trail cannot be asserted deterministically against
    /// wall-clock time.</summary>
    [Parameter] public TimeProvider TimeProvider { get; set; } = TimeProvider.System;

    /// <summary>Raised after a successful save or lifecycle action so a host page (Detail) can
    /// re-read the assignment it renders around this component.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private readonly AssignmentEditFormModel _model = new();
    private AssignmentSummaryDto? _item;
    private bool _loading;
    private bool _busy;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    /// <summary>F17: the <see cref="Id"/> and <see cref="Mode"/> the current instance state was
    /// loaded from. <see cref="OnParametersSetAsync"/> reloads when either CHANGES (the host page
    /// swapping the route parameter reuses this instance) and returns immediately when the same
