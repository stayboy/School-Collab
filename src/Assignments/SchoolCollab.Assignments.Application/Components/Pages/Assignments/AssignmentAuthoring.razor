@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Core.AssignmentPolicies
@using SchoolCollab.Core.Features
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@inject AssignmentsApiClient Api
@inject StudentsApiClient StudentsApi
@inject IFeatureFlagService FeatureFlags
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<AssignmentAuthoring> Logger
@implements IDisposable

@*
    The ONE compartmentalized assignment authoring surface
    (documents/specs/assignment-authoring-compartments.md §3–§6, §9, §11, §12; R1).

    Modes (UX-9): Create (empty form → Draft) · Edit (loaded form, full parity while
    Draft|Scheduled) · View (read-only; Published|Closed|Archived). Edit degrades to View
    internally for a later status so hosts never test the status themselves.

    Layout (UX-3/UX-4/UX-8): all six compartments stacked in one scroll as
    section-card-style blocks, a sticky compartment jump-nav, and a sticky action bar whose
    primary action follows the §11 status matrix with the secondary actions in a kebab.

    Conditional fields follow UX-17/UX-18/UX-19 — inapplicable controls render DISABLED
    with an inline reason, never hidden, so changing type/grading never reflows the page.
    Policy-derived values follow UX-13 — read-only resolved values with an
    "Inherited from Grade/Tenant policy" badge, never an editable control.

    Out of scope for R1 (R2/R3): multi-constraint targeting + recipient preview, attachment
    grounded AI generation.
*@

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (Mode != AssignmentAuthoringMode.Create && _item is null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">Assignment not found.</FluentMessageBar>
            <FluentButton Appearance="Appearance.Outline" OnClick="BackToList">Back to List</FluentButton>
        }
        else
        {
            <div class="authoring-page">
                <header class="authoring-actionbar">
                    <div class="authoring-title-group">
                        <h2 class="authoring-heading">@HeadingText</h2>
                        @if (_item is not null)
                        {
                            <FluentBadge Appearance="@StatusAppearance(_item.Status)">@_item.Status</FluentBadge>
                        }
                    </div>
                    <div class="authoring-actionbar-controls">
                        @if (PrimaryActionLabel is not null)
                        {
                            <FluentButton Id="authoring-primary-action"
                                          Appearance="Appearance.Accent"
                                          Disabled="@_busy"
                                          OnClick="OnPrimaryActionAsync">
                                @(_busy ? "Working…" : PrimaryActionLabel)
                            </FluentButton>
                        }
                        @if (SecondaryActions.Count > 0)
                        {
                            @* UseMenuService="false" keeps the kebab items in the rendered DOM
                               (the Index.razor landing-grid precedent) — the module registers no
                               FluentMenuProvider. *@
                            <RowActionsMenu UseMenuService="false"
                                            ForceKebab="true"
                                            Actions="@SecondaryActions"
                                            AriaLabel="More assignment actions" />
                        }
                    </div>
                </header>

                <nav class="authoring-jumpnav" aria-label="Assignment compartments">
                    @foreach (var compartment in Compartments)
                    {
                        <FluentAnchor @key="compartment.Anchor"
                                      Id="@($"jump-{compartment.Anchor}")"
                                      Appearance="Appearance.Hypertext"
                                      Href="@($"#authoring-{compartment.Anchor}")"
                                      class="authoring-jumpnav-link">@compartment.Title</FluentAnchor>
                    }
                </nav>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Id="authoring-error" Intent="MessageIntent.Error" class="authoring-message">@_error</FluentMessageBar>
                }

                @* ── 1 · Basics (the always-on spine, §3/UX-12) ───────────────── *@
                <section id="authoring-basics" class="authoring-compartment">
                    <h3 class="authoring-compartment-title">Basics</h3>

                    <FormRow Label="Title" Required For="authoring-basics-title">
                        <FluentTextField Id="authoring-basics-title" @bind-Value="_model.Title" Required
                                         ReadOnly="@IsReadOnly" Placeholder="e.g. Chapter 5 Quiz" class="full-width" />
                    </FormRow>

                    <FormRow Label="Description" For="authoring-basics-description">
                        <FluentTextArea Id="authoring-basics-description" @bind-Value="_model.Description"
                                        ReadOnly="@IsReadOnly" Rows="3"
                                        Placeholder="Internal note for other teachers…" class="full-width" />
                    </FormRow>

                    @* INS-1/INS-2: student-facing task text, distinct from Description. *@
                    <FormRow Label="Instructions" For="authoring-basics-instructions">
                        <FluentTextArea Id="authoring-basics-instructions" @bind-Value="_model.Instructions"
                                        ReadOnly="@IsReadOnly" Rows="4"
                                        Placeholder="What the student must do — shown to students…" class="full-width" />
                    </FormRow>

                    <FormRow Label="Assignment type" Required For="authoring-basics-type">
                        <FluentSelect TOption="PickerOption" Id="authoring-basics-type"
                                      Items="@TypeOptions" @bind-SelectedOption="_selectedType"
                                      OptionText="@(o => o?.Label ?? string.Empty)"
                                      OptionValue="@(o => o?.Value ?? string.Empty)"
                                      Disabled="@IsReadOnly" class="full-width" />
                    </FormRow>

                    <FormRow Label="Grading format" Required For="authoring-basics-grading">
                        <FluentSelect TOption="PickerOption" Id="authoring-basics-grading"
                                      Items="@GradingFormatOptions" @bind-SelectedOption="_selectedGradingFormat"
                                      OptionText="@(o => o?.Label ?? string.Empty)"
                                      OptionValue="@(o => o?.Value ?? string.Empty)"
                                      Disabled="@IsReadOnly" class="full-width" />
                    </FormRow>

                    @* FR-220 / UX-19: the AI-availability hint lives with the type/grading choice. *@
                    <p class="authoring-hint" id="authoring-generation-hint">
                        @QuestionGenerationGate.HintText(SelectedType, SelectedGradingFormat)
                    </p>

                    <FormRow Label="Subject" Required For="authoring-basics-subject">
                        <FluentSelect TOption="PickerOption" Id="authoring-basics-subject"
                                      Items="@SubjectOptions" @bind-SelectedOption="_selectedSubject"
                                      OptionText="@(o => o?.Label ?? string.Empty)"
                                      OptionValue="@(o => o?.Value ?? string.Empty)"
                                      Placeholder="@SubjectPickerPlaceholder"
                                      Disabled="@(IsReadOnly || SubjectPickerDisabled)" class="full-width" />
                    </FormRow>

                    <FormRow Label="Primary grade" For="authoring-basics-grade">
                        @* The grade picker owns an extra side effect (FR-58 subject reload + the
                           WS-C1 signature re-resolve), so it binds the selected option and the
                           changed callback explicitly rather than through @bind. *@
                        <FluentSelect TOption="PickerOption" Id="authoring-basics-grade"
                                      Items="@_gradeLevelOptions"
                                      SelectedOption="@_selectedGradeLevel"
                                      SelectedOptionChanged="@OnGradeLevelChangedAsync"
                                      OptionText="@(o => o?.Label ?? string.Empty)"
                                      OptionValue="@(o => o?.Value ?? string.Empty)"
                                      Placeholder="Select a grade level"
                                      Disabled="@(IsReadOnly || GradePickerDisabled)"
                                      class="full-width" />
                    </FormRow>
                    @if (GradePickerReason is not null)
                    {
                        <p class="authoring-reason" id="authoring-grade-reason">@GradePickerReason</p>
                    }

                    @if (_gradeLevels is { Length: 0 })
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning">
                            No grade levels available. Please create grade levels in the Students module first.
                        </FluentMessageBar>
                    }
                </section>

                @* ── 2 · Audience & Targets (§7.5 recipient preview is R2) ─────── *@
                <section id="authoring-audience" class="authoring-compartment">
                    <h3 class="authoring-compartment-title">Audience &amp; Targets</h3>

                    <FormRow Label="Target audience" Required For="authoring-audience-target">
                        <FluentSelect TOption="PickerOption" Id="authoring-audience-target"
                                      Items="@TargetAudienceOptions" @bind-SelectedOption="_selectedTargetAudience"
                                      OptionText="@(o => o?.Label ?? string.Empty)"
                                      OptionValue="@(o => o?.Value ?? string.Empty)"
                                      Disabled="@IsReadOnly" class="full-width" />
                    </FormRow>

                    <FormRow Label="Activity groups" For="authoring-audience-groups">
                        @* Raw FluentSelect with Multiple (not a wrapper): dropdown-ui/SKILL.md routes
                           multi-select pickers to the raw control and asks for the reason to be
                           documented here — the five shared wrappers are all single-value. The
                           selection binds the supported SelectedOptions/SelectedOptionsChanged
                           pair over the option objects; the page keeps the ids as its source of
                           truth. (R1 regression: this element bound @bind-SelectedValues, which
                           does not exist on FluentListbox in FluentUI 4.14.2, so the binding was
                           silently dropped into AdditionalAttributes and the picker never
                           reported or showed a selection.) *@
                        <FluentSelect TOption="PickerOption" Id="authoring-audience-groups"
                                      Items="@_activityGroupOptions"
                                      Multiple="true"
                                      OptionText="@(g => g.Label)"
                                      OptionValue="@(g => g.Value)"
                                      SelectedOptions="@SelectedGroupOptions"
                                      SelectedOptionsChanged="@OnSelectedGroupsChangedAsync"
                                      Disabled="@(IsReadOnly || GroupPickerReason is not null)"
                                      class="full-width" />
                    </FormRow>
                    @if (GroupPickerReason is not null)
                    {
                        <p class="authoring-reason" id="authoring-groups-reason">@GroupPickerReason</p>
                    }

                    <p class="authoring-hint">
                        Recipients are resolved from this audience when the assignment is published.
                    </p>
                </section>

                @* ── 3 · Delivery & Publishing (UX-15) ────────────────────────── *@
                <section id="authoring-delivery" class="authoring-compartment">
                    <h3 class="authoring-compartment-title">Delivery &amp; Publishing</h3>

                    <FormRow Label="Status" For="authoring-delivery-status">
                        <span class="authoring-readonly-value" id="authoring-delivery-status">
                            @(_item?.Status.ToString() ?? "New draft")
                        </span>
                    </FormRow>

                    <FormRow Label="Available from" For="authoring-delivery-available-from">
                        <span class="authoring-readonly-value" id="authoring-delivery-available-from">
                            @(_item?.AvailableFromUtc?.ToLocalTime().ToString("g") ?? "—")
                        </span>
                    </FormRow>

                    <FormRow Label="Due date" For="authoring-delivery-due">
                        <FluentDatePicker Id="authoring-delivery-due" @bind-Value="_model.DueDate"
                                          @bind-Value:after="OnDueDateChangedAsync" ReadOnly="@IsReadOnly"
                                          Class="w-4" />
                    </FormRow>

                    <FormRow Label="Archive grace (days)" For="authoring-delivery-grace">
                        <FluentNumberField Id="authoring-delivery-grace" @bind-Value="_model.ArchiveGraceDays"
                                           ReadOnly="@IsReadOnly" Class="w-3" />
                    </FormRow>

                    <div class="authoring-policy-row" id="authoring-policy-approval">
                        <span class="authoring-policy-label">Approval before publish</span>
                        <span class="authoring-policy-value">@ApprovalPolicyValueText</span>
                        <FluentBadge Appearance="Appearance.Lightweight">@InheritedPolicyBadgeText</FluentBadge>
                        @if (PolicyLinkHref is not null)
                        {
                            <FluentAnchor Appearance="Appearance.Hypertext" Href="@PolicyLinkHref"
                                          class="authoring-policy-link">Grade policy</FluentAnchor>
                        }
                    </div>

                    <div class="authoring-policy-row" id="authoring-policy-notification">
                        <span class="authoring-policy-label">Notification policy</span>
                        <span class="authoring-policy-value">Resolved per recipient grade at publish</span>
                        <FluentBadge Appearance="Appearance.Lightweight">@InheritedPolicyBadgeText</FluentBadge>
                        @if (PolicyLinkHref is not null)
                        {
                            <FluentAnchor Appearance="Appearance.Hypertext" Href="@PolicyLinkHref"
                                          class="authoring-policy-link">Grade policy</FluentAnchor>
                        }
                    </div>
                </section>

                @* ── 4 · Submission & Sign-off (UX-16, UX-17) ─────────────────── *@
                <section id="authoring-submission" class="authoring-compartment">
                    <h3 class="authoring-compartment-title">Submission &amp; Sign-off</h3>

                    <FormRow Label="Max score" For="authoring-submission-max-score">
                        <FluentNumberField Id="authoring-submission-max-score" @bind-Value="_model.MaxScore"
                                           ReadOnly="@IsReadOnly" Class="w-3" />
                    </FormRow>

                    <p class="authoring-hint" id="authoring-feedback-mode">
                        Feedback mode: @EnumHelper.GetDescription(SelectedGradingFormat)
                    </p>

                    @* UX-17/UX-18: the pass-score / attempt-cap pair renders disabled with an
                       inline reason for TeacherGraded instead of disappearing. *@
                    <ScoringFieldsSection Model="_model" GradingFormat="SelectedGradingFormat" />

                    <FormRow Label="Guardian review" For="authoring-submission-mandatory-review">
                        <FluentCheckbox Id="authoring-submission-mandatory-review"
                                        @bind-Value="_mandatoryReview"
                                        Label="Require guardian review before student submits"
                                        Disabled="@IsReadOnly" />
                    </FormRow>

                    <FormRow Label="Guardian signature" For="authoring-submission-requires-signature">
                        <FluentCheckbox Id="authoring-submission-requires-signature"
                                        @bind-Value="_requiresSignature"
                                        Label="Require guardian signature after completion"
                                        Disabled="@(IsReadOnly || _signatureMandatory)"
                                        Tooltip="@(_signatureMandatory ? SignatureMandatoryReason : null)" />
                    </FormRow>
                    @if (_signatureMandatory)
                    {
                        <p class="authoring-reason" id="authoring-signature-reason">@SignatureMandatoryReason</p>
                    }

                    <div class="authoring-policy-row" id="authoring-policy-signature">
                        <span class="authoring-policy-label">Signature requirement</span>
                        <span class="authoring-policy-value">@SignaturePolicyValueText</span>
                        <FluentBadge Appearance="Appearance.Lightweight">@InheritedPolicyBadgeText</FluentBadge>
                        @if (PolicyLinkHref is not null)
                        {
                            <FluentAnchor Appearance="Appearance.Hypertext" Href="@PolicyLinkHref"
                                          class="authoring-policy-link">Grade policy</FluentAnchor>
                        }
                    </div>
                </section>

                @* ── 5 · Content & Resources (always active, UX-19) ───────────── *@
                <section id="authoring-content" class="authoring-compartment">
                    <h3 class="authoring-compartment-title">Content &amp; Resources</h3>
                    @if (IsReadOnly)
                    {
                        <p class="authoring-hint">
                            Attachments and URL resources are managed on the assignment's edit surface.
                        </p>
                    }
                    else if (ChildrenEditorDisabledReason is not null)
                    {
                        @* P1 fail-closed: no live-empty editor, so an add can never replace the
                           persisted set (the update handler full-replaces a non-null collection). *@
                        <p class="authoring-reason" id="authoring-content-reason">@ChildrenEditorDisabledReason</p>
                    }
                    else
                    {
                        <ResourcesSection Model="_model" Changed="OnModelChanged" />
                    }
                </section>

                @* ── 6 · Questions & AI (UX-19: disabled-with-reason, never hidden) ── *@
                <section id="authoring-questions" class="authoring-compartment">
                    <h3 class="authoring-compartment-title">Questions &amp; AI</h3>
                    @if (IsReadOnly)
                    {
                        <p class="authoring-hint">
                            Questions are managed on the assignment's edit surface.
                        </p>
                    }
                    else if (ChildrenEditorDisabledReason is not null)
                    {
                        <p class="authoring-reason" id="authoring-questions-reason">@ChildrenEditorDisabledReason</p>
                    }
                    else if (!GateEnabled)
                    {
                        <p class="authoring-reason" id="authoring-questions-reason">@QuestionGenerationGate.DisabledHint</p>
                        <QuestionGenerationSection Model="_model"
                                                   GateEnabled="false"
                                                   TopicId="@TopicId"
                                                   TopicName="@_selectedSubject?.Label"
                                                   GradeLevelId="@GradeLevelId"
                                                   PromptLocked="_aiPromptLocked"
                                                   OnQuestionsChanged="OnModelChanged" />
                        <QuestionEditorSection Model="_model" Changed="OnModelChanged" />
                    }
                    else
                    {
                        <QuestionGenerationSection Model="_model"
                                                   GateEnabled="true"
                                                   TopicId="@TopicId"
                                                   TopicName="@_selectedSubject?.Label"
                                                   GradeLevelId="@GradeLevelId"
                                                   PromptLocked="_aiPromptLocked"
                                                   OnQuestionsChanged="OnModelChanged" />
                        <QuestionEditorSection Model="_model" Changed="OnModelChanged" />
                        @if (_item is not null && _item.Status == AssignmentStatusDto.Draft)
                        {
                            <QuestionsDraftSection AssignmentId="_item.Id"
                                                   GateEnabled="true"
                                                   PromptLocked="_aiPromptLocked"
                                                   TopicId="@TopicId"
                                                   TopicName="@_selectedSubject?.Label"
                                                   GradeLevelId="@GradeLevelId"
                                                   OnConfirmed="ReloadAsync" />
                        }
                    }
                </section>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>UX-13: the badge every policy-derived (non-editable) value carries.
    /// Declared once so the markup, the spec wording and the bUnit suite cannot drift.</summary>
    public const string InheritedPolicyBadgeText = "Inherited from Grade/Tenant policy";

    /// <summary>D2 / Round B1: the inline reason (also the checkbox tooltip) shown when the
    /// resolved grade/tenant signature requirement is <c>Mandatory</c> and therefore locks the
    /// <c>RequiresSignature</c> checkbox.</summary>
    public const string SignatureMandatoryReason =
        "Your organization requires a guardian signature for new assignments in this grade.";

    /// <summary>P1 rework, fail-closed: the reason the Content &amp; Resources and
    /// Questions &amp; AI editors render disabled with when an editable Edit surface could
    /// not load the assignment's persisted children. Adding to a blank form there is what
    /// let one new question/URL delete every persisted child.</summary>
    public const string ChildrenUnavailableReason =
        "The saved questions, attachments and links could not be loaded, so these editors are disabled — " +
        "adding to a blank form would replace what is already saved. Reload the page to try again.";

    /// <summary>P2-1 rework, fail-closed: the reason the activity-group picker renders
    /// disabled with when the assignment's persisted links could not be read. An unknown
    /// link set must never be written over the stored one (the replace-set route deletes
    /// whatever is not in the payload).</summary>
    public const string GroupLinksUnavailableReason =
        "The activity groups already linked to this assignment could not be loaded, so this picker is " +
        "disabled — saving would replace the existing links. Reload the page to try again.";

    /// <summary>The requested mode (UX-9). <see cref="AssignmentAuthoringMode.Edit"/> degrades
    /// to <see cref="AssignmentAuthoringMode.View"/> for a Published/Closed/Archived
    /// assignment — see <see cref="EffectiveMode"/>.</summary>
    [Parameter, EditorRequired] public AssignmentAuthoringMode Mode { get; set; } = AssignmentAuthoringMode.View;

    /// <summary>The assignment to load for Edit / View. Unused (and ignored) in Create mode.</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Raised after a successful save or lifecycle action so a host page (Detail) can
    /// re-read the assignment it renders around this component.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private readonly AssignmentEditFormModel _model = new();
    private AssignmentSummaryDto? _item;
    private bool _loading;
    private bool _busy;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // Type / grading / audience / review / signature selection state.
    private PickerOption? _selectedType;
    private PickerOption? _selectedGradingFormat;
    private PickerOption? _selectedTargetAudience;
    private bool _mandatoryReview = true;
    private bool _requiresSignature;
    private bool _signatureMandatory;
    private SignatureRequirementMode? _resolvedSignatureMode;

    /// <summary>WS-B2 (spec §3.4 line 70) — org-level AI-prompt lock.</summary>
    private bool _aiPromptLocked;

    // Primary grade + subject + activity-group picker state.
    private GradeLevelDto[]? _gradeLevels;
    private PickerOption[] _gradeLevelOptions = [];
    private PickerOption? _selectedGradeLevel;
    private bool _loadingSubjects;
    private SubjectDto[]? _subjects;
    private PickerOption[] _subjectOptions = [];
    private PickerOption? _selectedSubject;
    private bool _activityGroupsEnabled;
    private PickerOption[] _activityGroupOptions = [];
    private HashSet<Guid> _selectedGroupIds = [];
    private SubjectDto[]? _groupSubjects;
    private PickerOption[] _groupSubjectOptions = [];
    private bool _loadingGroupSubjects;

    /// <summary>P1 rework — whether the persisted children were loaded into
    /// <see cref="AssignmentEditFormModel"/> before the editors rendered.</summary>
    private bool _childrenLoaded;

    /// <summary>P2-1 rework — whether the persisted activity-group links were read, plus the
    /// set that was read, so an update only rewrites the links when the author changed them.</summary>
    private bool _groupLinksLoaded;
    private readonly HashSet<Guid> _loadedGroupIds = [];
    private string? _groupLinksUnavailableReason;

    /// <summary>One dropdown item for every picker on this page (grade, subject, group,
    /// assignment type, grading format, target audience). Kept public so the pickers can be
    /// driven by tests through their real <c>SelectedOptionChanged</c> callback.</summary>
    public sealed record PickerOption(string Value, string Label);

    private sealed record Compartment(string Anchor, string Title);

    /// <summary>The six compartments in canonical order (UX-1). The jump-nav and the stacked
    /// sections both render from this list, so the two can never disagree.</summary>
    private static readonly Compartment[] Compartments =
    [
        new("basics", "Basics"),
        new("audience", "Audience & Targets"),
        new("delivery", "Delivery & Publishing"),
        new("submission", "Submission & Sign-off"),
        new("content", "Content & Resources"),
        new("questions", "Questions & AI")
    ];

    // ── Mode resolution (UX-9 / UX-11) ────────────────────────────────────────

    /// <summary>The mode actually rendered. Create stays Create; Edit degrades to View when the
    /// loaded assignment is no longer Draft/Scheduled (the server refuses structural edits
    /// outside Draft|Scheduled — <c>Assignment.Update</c>'s guard is unchanged).</summary>
    private AssignmentAuthoringMode EffectiveMode
    {
        get
        {
            if (Mode == AssignmentAuthoringMode.Create)
            {
                return AssignmentAuthoringMode.Create;
            }

            var stillEditable = _item is { Status: AssignmentStatusDto.Draft or AssignmentStatusDto.Scheduled };
            return Mode == AssignmentAuthoringMode.Edit && stillEditable
                ? AssignmentAuthoringMode.Edit
                : AssignmentAuthoringMode.View;
        }
    }

    private bool IsReadOnly => EffectiveMode == AssignmentAuthoringMode.View;

    /// <summary>P1 rework, fail-closed: non-null exactly when an editable Edit surface did
    /// NOT get its persisted children. The Content &amp; Resources and Questions &amp; AI
    /// editors then render disabled-with-reason instead of live-empty (UX-17/UX-19
    /// treatment) — never an empty editor that a first add would convert into a
    /// full-replacement payload. Create mode is exempt: it has no persisted children to
    /// lose, so its editors stay live.</summary>
    private string? ChildrenEditorDisabledReason =>
        EffectiveMode == AssignmentAuthoringMode.Edit && !_childrenLoaded
            ? ChildrenUnavailableReason
            : null;

    private string HeadingText => EffectiveMode switch
    {
        AssignmentAuthoringMode.Create => "New assignment",
        AssignmentAuthoringMode.Edit => "Edit assignment",
        _ => "Assignment overview"
    };

    private static Appearance StatusAppearance(AssignmentStatusDto status) => status switch
    {
        AssignmentStatusDto.Published or AssignmentStatusDto.Scheduled => Appearance.Accent,
        AssignmentStatusDto.Closed or AssignmentStatusDto.Archived => Appearance.Neutral,
        _ => Appearance.Lightweight
    };

    // ── Typed selection projections ───────────────────────────────────────────

    private AssignmentTypeDto? SelectedType =>
        _selectedType is null ? null : (AssignmentTypeDto)int.Parse(_selectedType.Value);

    private GradingFormatDto SelectedGradingFormat =>
        _selectedGradingFormat is not null
            ? (GradingFormatDto)int.Parse(_selectedGradingFormat.Value)
            : _item?.GradingFormat ?? GradingFormatDto.TeacherGraded;

    private TargetAudienceTypeDto SelectedTargetAudience =>
        _selectedTargetAudience is not null
            ? (TargetAudienceTypeDto)int.Parse(_selectedTargetAudience.Value)
            : _item?.TargetAudienceType ?? TargetAudienceTypeDto.AllStudents;

    private bool IsSelectedGroupsAudience =>
        SelectedTargetAudience == TargetAudienceTypeDto.SelectedGroups;

    /// <summary>FR-220 / EC-3 — whether this type + grading combination offers AI generation.
    /// Drives the disabled-with-reason treatment of compartment 6 and the kebab's
    /// "Generate questions" action (AI-4).</summary>
    private bool GateEnabled => QuestionGenerationGate.IsEnabled(SelectedType, SelectedGradingFormat);

    private Guid? TopicId =>
        _selectedSubject is not null && Guid.TryParse(_selectedSubject.Value, out var id) ? id : null;

    private Guid? GradeLevelId =>
        _selectedGradeLevel is not null && Guid.TryParse(_selectedGradeLevel.Value, out var id) ? id : null;

    /// <summary>The picker's selection projection: the option instances matching the ids the
    /// page holds. FluentSelect highlights the options it is handed, so a loaded link must be
    /// projected back onto its own option (the TeacherEditDialog multi-select precedent).
    /// <para>R1 regression fix: the picker previously bound <c>@bind-SelectedValues</c>, a
    /// parameter that does not exist on the FluentUI 4.14.2 list components — Blazor routed it
    /// into the catch-all <c>AdditionalAttributes</c> (rendering a stray
    /// <c>selectedvalues</c> HTML attribute) and the picker neither showed nor reported a
    /// selection, so Create-with-By-Group could never pass <see cref="ValidateForSave"/>.</para></summary>
    private IEnumerable<PickerOption> SelectedGroupOptions =>
        _activityGroupOptions.Where(o => _selectedGroupIds.Contains(Guid.Parse(o.Value)));

    private PickerOption[] SubjectOptions => IsSelectedGroupsAudience ? _groupSubjectOptions : _subjectOptions;

    private bool SubjectPickerDisabled =>
        IsSelectedGroupsAudience
            ? _selectedGroupIds.Count == 0 || _loadingGroupSubjects
            : _selectedGradeLevel is null || _loadingSubjects;

    private string SubjectPickerPlaceholder =>
        IsSelectedGroupsAudience
            ? (_selectedGroupIds.Count == 0 ? "Select activity groups first" : "Select a subject")
            : (_selectedGradeLevel is null ? "Select a grade level first" : "Select a subject");

    /// <summary>UX-17: the Primary grade picker is inapplicable (not hidden) when the audience
    /// is group-based.</summary>
    private string? GradePickerReason =>
        IsSelectedGroupsAudience ? "Not applicable when the audience is By Group." : null;

    private bool GradePickerDisabled => GradePickerReason is not null;

    /// <summary>UX-17/UX-19: the activity-group picker is inapplicable (not hidden) unless the
    /// audience is group-based — unavailable entirely when the tenant flag is off (in which
    /// case the group audience is not offered at all), and disabled when the persisted links
    /// could not be read (P2-1 fail-closed: an unknown set must never be saved over).</summary>
    private string? GroupPickerReason =>
        !_activityGroupsEnabled
            ? "Not available — activity groups are disabled for this organization."
            : _groupLinksUnavailableReason
              ?? (IsSelectedGroupsAudience ? null : "Not applicable for the selected target audience.");

