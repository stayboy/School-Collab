@using SchoolCollab.Assignments.Contracts
@using Microsoft.FluentUI.AspNetCore.Components

@*
    WS-A3 (spec §3.3 / §7 Q4): the Pass Score CONTROL — now rendered inside the authoring page's
    Basics "Score" row as its third FormRowCell (owner 2026-10-11), so this component owns the
    control and its two states, never a FormRow of its own.

    D11 (assignment-create-edit-redesign, owner 2026-10-08) → owner 2026-10-11:
    - The applicable state is the number field; "Set the pass threshold…" rides the SCORE CELL's
      help-hint tooltip (the page attaches <see cref="PassScoreHint"/>).
    - The inapplicable state (Teacher Marked grading) is a DISABLED CHECKBOX with the SHORT label
      <see cref="ScoringInapplicableShortLabel"/>; the long <see cref="ScoringInapplicableReason"/>
      rides the same cell's help tooltip — the row reads clean, the explanation stays one hover
      away. The control keeps the `scoringFieldsPassScore` id in both states (the bUnit seam and
      the page's order assertions read the id, not the element type).

    Round `authoring-compact-fields` (OD1): the attempt cap LEFT this section earlier; the page
    still asks <see cref="IsScoringInapplicable"/> for its disabled state.

    The gating rule itself is unchanged (`ScoringFieldsPassSubmitGate`
    still always passes for TeacherGraded, so a stale value can never
    block submit with an invisible error).
*@

@{
    var inapplicable = IsScoringInapplicable(GradingFormat);
}

@if (inapplicable)
{
    @* Owner 2026-10-11: the checkbox label is SHORT — the long reason is the SCORE cell's
       help-hint tooltip, not the label. *@
    <FluentCheckbox Id="scoringFieldsPassScore" Disabled="true" Value="false"
                    Label="@ScoringInapplicableShortLabel" />
}
else
{
    <FluentNumberField Id="scoringFieldsPassScore" @bind-Value="Model.PassScore" />
}

@code {
    /// <summary>D11: the field-level hint, carried as the SCORE cell's help-hint tooltip
    /// instead of the inline paragraph it used to be.</summary>
    public const string PassScoreHint =
        "Set the pass threshold. Leave blank for no pass threshold.";

    /// <summary>UX-17 / D12 → D11 → owner 2026-10-11: the LONG reason the inapplicable state
    /// shows — the SCORE cell's help-hint tooltip in the Teacher Marked state. Declared once so
    /// the component, the authoring page and the bUnit suite cannot drift.</summary>
    public const string ScoringInapplicableReason =
        "Not applicable for Teacher Marked grading — pass score and attempt caps apply to Auto Scored and Instant Feedback only.";

    /// <summary>Owner 2026-10-11: the disabled checkbox's SHORT label — the long wording lives in
    /// the cell's help tooltip (<see cref="ScoringInapplicableReason"/>), never inline.</summary>
    public const string ScoringInapplicableShortLabel = "Not applicable";

    /// <summary>The shared form model (PassScore lives here — and MaxAttempts
    /// still does, so the authoring page's request projection and
    /// <c>ScoringFieldsPassSubmitGate</c> pick them up automatically — while
    /// this section renders only the pass score, OD1).</summary>
    [Parameter, EditorRequired] public AssignmentEditFormModel Model { get; set; } = default!;

    /// <summary>The currently selected grading format. For
    /// <see cref="GradingFormatDto.TeacherGraded"/> the fields render
    /// disabled with <see cref="ScoringInapplicableReason"/> — scoring is
    /// reviewer-driven, so neither a pass threshold nor an attempt cap has
    /// a meaning to enforce.</summary>
    [Parameter, EditorRequired] public GradingFormatDto GradingFormat { get; set; }

    /// <summary>True when the grading format does not support the
    /// pass-score / attempt-cap fields (UX-17 / D12). Public because the two
    /// fields no longer share a component: this section renders the pass score
    /// and the authoring page renders the attempt cap in its Basics row, so the
    /// page asks here rather than restating the gate (one spelling, OD1).</summary>
    public static bool IsScoringInapplicable(GradingFormatDto gradingFormat) =>
        gradingFormat is not (GradingFormatDto.AutoGraded or GradingFormatDto.InstantGraded);
}
