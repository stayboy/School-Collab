@using SchoolCollab.Assignments.Contracts
@using Microsoft.FluentUI.AspNetCore.Components

@*
    WS-A3 (spec §3.3 / §7 Q4): the Pass Score control.

    D11 (assignment-create-edit-redesign, owner 2026-10-08):
    - The "Set the pass threshold…" prose is the field's native `title` tooltip,
      never an inline paragraph.
    - The inapplicable state (Teacher Marked grading) renders a DISABLED
      CHECKBOX whose LABEL carries <see cref="ScoringInapplicableReason"/> —
      the label IS the explanation, so there is no standalone reason paragraph
      and no disabled number field eating the row. The control keeps the
      `scoringFieldsPassScore` id in both states (the bUnit seam and the page's
      order assertions read the id, not the element type).

    Round `authoring-compact-fields` (OD1): the attempt cap LEFT this section
    for the Basics `(Max score · Max attempts)` row; the page still asks
    <see cref="IsScoringInapplicable"/> for its disabled state — the checkbox
    label names BOTH fields, exactly as the old paragraph did.

    The gating rule itself is unchanged (`ScoringFieldsPassSubmitGate`
    still always passes for TeacherGraded, so a stale value can never
    block submit with an invisible error).
*@

@{
    var inapplicable = IsScoringInapplicable(GradingFormat);
}

@if (inapplicable)
{
    <FormRow Label="Pass Score" For="scoringFieldsPassScore">
        @* D11: the checkbox's LABEL explains the disabled state — no separate paragraph. *@
        <FluentCheckbox Id="scoringFieldsPassScore" Disabled="true" Value="false"
                        Label="@ScoringInapplicableReason" />
    </FormRow>
}
else
{
    @* D11: the "Set the pass threshold…" hint rides the row label's (i) help icon —
       no inline paragraph, no hover-only field title. *@
    <FormRow Label="Pass Score" For="scoringFieldsPassScore" Help="@PassScoreHint">
        <FluentNumberField Id="scoringFieldsPassScore" @bind-Value="Model.PassScore" Class="w-3" />
    </FormRow>
}

@code {
    /// <summary>D11: the field-level hint, carried as the number field's native `title`
    /// tooltip instead of the inline paragraph it used to be.</summary>
    public const string PassScoreHint =
        "Set the pass threshold. Leave blank for no pass threshold.";

    /// <summary>UX-17 / D12 → D11: the reason the inapplicable state shows — the checkbox's
    /// LABEL in the Teacher Marked state (and the field tooltip's sibling text elsewhere).
    /// Declared once so the component, the authoring page and the bUnit suite cannot drift.</summary>
    public const string ScoringInapplicableReason =
        "Not applicable for Teacher Marked grading — pass score and attempt caps apply to Auto Scored and Instant Feedback only.";

    /// <summary>The shared form model (PassScore lives here — and MaxAttempts
    /// still does, so the authoring page's request projection and
    /// <c>ScoringFieldsPassSubmitGate</c> pick them up automatically — while
    /// this section renders only the pass score, OD1).</summary>
    [Parameter, EditorRequired] public AssignmentEditFormModel Model { get; set; } = default!;

    /// <summary>The currently selected grading format. For
    /// <see cref="GradingFormatDto.TeacherGraded"/> the fields render
    /// disabled with <see cref="ScoringInapplicableReason"/> — scoring is
    /// reviewer-driven, so neither a pass threshold nor an attempt cap has
    /// a meaning to enforce.</summary>
    [Parameter, EditorRequired] public GradingFormatDto GradingFormat { get; set; }

    /// <summary>True when the grading format does not support the
    /// pass-score / attempt-cap fields (UX-17 / D12). Public because the two
    /// fields no longer share a component: this section renders the pass score
    /// and the authoring page renders the attempt cap in its Basics row, so the
    /// page asks here rather than restating the gate (one spelling, OD1).</summary>
    public static bool IsScoringInapplicable(GradingFormatDto gradingFormat) =>
        gradingFormat is not (GradingFormatDto.AutoGraded or GradingFormatDto.InstantGraded);
}
