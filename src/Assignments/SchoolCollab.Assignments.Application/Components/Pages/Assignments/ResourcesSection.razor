@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Assignments.Application.Services
@using SchoolCollab.Assignments.Contracts
@inject AssignmentsApiClient Api
@inject IDialogService DialogService
@inject ILogger<ResourcesSection> Logger

<section class="resources-section">
    <div class="resources-section-toolbar">
        <FluentInputFile Mode="InputFileMode.Stream"
                         Multiple="true"
                         MaximumFileCount="@AttachmentUploadPolicy.MaximumFileCount"
                         MaximumFileSize="@AttachmentUploadPolicy.MaxFileSizeBytes"
                         Accept="@AttachmentUploadPolicy.AcceptExtensions"
                         OnFileUploaded="@OnFileUploadedAsync"
                         OnFileCountExceeded="@OnFileCountExceededAsync"
                         DragDropZoneVisible="true">
            Upload files
        </FluentInputFile>
        <span class="resources-section-count">@Model.Attachments.Count file(s) attached</span>
    </div>

    <div class="resources-section-urls">
        <div class="resources-section-url-actions">
            <FluentTextField @bind-Value="_newUrl"
                             Placeholder="https://example.com/article"
                             Class="w-4" />
            <FluentButton Appearance="Appearance.Accent"
                          Disabled="@(string.IsNullOrWhiteSpace(_newUrl))"
                          OnClick="AddUrlAsync">
                Add link
            </FluentButton>
            <span class="resources-section-count">@Model.ResourceUrls.Count link(s)</span>
        </div>

        @if (!string.IsNullOrEmpty(_urlError))
        {
            <FluentMessageBar Intent="MessageIntent.Warning" class="resources-section-error">@_urlError</FluentMessageBar>
        }

        @if (Model.ResourceUrls.Count > 0)
        {
            <ul class="resources-section-list">
                @foreach (var (row, index) in Model.ResourceUrls.Select((r, i) => (r, i)).ToList())
                {
                    <li class="resources-section-row" @key="row">
                        <FluentIcon Icon="@(Icons.Regular.Size20.Link)"
                                    Color="@Color.Accent"
                                    aria-hidden="true" />
                        <span class="resources-section-row-name">@(row.DisplayName ?? row.Url)</span>
                        <FluentButton Appearance="Appearance.Neutral"
                                      IconEnd="@(FluentIcons.Dismiss)"
                                      OnClick="@(() => RemoveUrlAtAsync(index))"
                                      aria-label="@($"Remove {row.Url}")" />
                    </li>
                }
            </ul>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="resources-section-error">@_error</FluentMessageBar>
    }

    @if (Model.Attachments.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">No resources attached yet.</FluentMessageBar>
    }
    else
    {
        <ul class="resources-section-list">
            @foreach (var (row, index) in Model.Attachments.Select((r, i) => (r, i)).ToList())
            {
                <li class="resources-section-row" @key="row">
                    <FluentIcon Icon="@(Icons.Regular.Size20.Document)"
                                Color="@Color.Accent"
                                aria-hidden="true" />
                    <span class="resources-section-row-name">@row.FileName</span>
                    <span class="resources-section-row-size">@AttachmentUploadPolicy.FormatFileSize(row.FileSize)</span>
                    @* R3 (D2/D4): an unreadable or unsupported upload is SURFACED, never silently
                       dropped — this badge is the fail-open surface the author sees. *@
                    @if (row.ExtractionStatus != AttachmentExtractionStatusDto.Succeeded)
                    {
                        <FluentBadge Appearance="Appearance.Lightweight"
                                    class="resources-section-extraction-badge"
                                    title="@row.ExtractionError">
                            @ExtractionStatusText(row.ExtractionStatus)
                        </FluentBadge>
                    }
                    @if (AssignmentId is not null && row.Id is not null)
                    {
                        <FluentButton Appearance="Appearance.Neutral"
                                      IconStart="@FluentIcons.ArrowClockwise"
                                      Disabled="@(_reextractingIndex is not null)"
                                      OnClick="@(() => RegenerateExtractionAsync(index))"
                                      aria-label="@($"Re-read text from {row.FileName}")"
                                      title="Re-read the text from this file">
                            @(_reextractingIndex == index ? "Reading…" : "Re-read")
                        </FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Neutral"
                                  IconEnd="@(FluentIcons.Dismiss)"
                                  OnClick="@(() => RemoveAtAsync(index))"
                                  aria-label="@($"Remove {row.FileName}")" />
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>The form model that owns the attachment list. The section
    /// mutates <see cref="AssignmentEditFormModel.Attachments"/> via
    /// <see cref="AssignmentEditFormModel.AddAttachment"/> and
    /// <see cref="AssignmentEditFormModel.RemoveAttachmentAt"/>.</summary>
    [Parameter, EditorRequired] public AssignmentEditFormModel Model { get; set; } = default!;

    /// <summary>Raised after each successful stage + add so the parent
    /// page re-renders the Review attachment summary + submit gate
    /// (the same pattern the question section uses).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>R3 (D3): the assignment whose persisted attachments can be re-extracted, or null on a
    /// Create surface (nothing is stored yet).</summary>
    [Parameter] public Guid? AssignmentId { get; set; }

    private string? _error;
    private bool _staging;

    /// <summary>R3: the row currently being re-extracted, so its button shows progress and cannot be
    /// pressed twice.</summary>
    private int? _reextractingIndex;
    // WS-B2 (decision g): reference-URL rows for AI question generation.
    private string? _newUrl;
    private string? _urlError;

    private async Task OnFileUploadedAsync(FluentInputFileEventArgs args)
    {
        await StageFileAsync(args.Stream, args.Name, args.ContentType, args.Size);
    }

    /// <summary>The testable seam for the upload pipeline: drives the
    /// client pre-check, calls the staging API, and appends a row on
    /// success. The bUnit suite hits this method directly because the
    /// FluentInputFile JS pipeline is not driven in tests (the ar-3
    /// recorded fallback for web-component quirks).</summary>
    public async Task StageFileAsync(Stream content, string fileName, string contentType, long fileSize)
    {
        if (_staging)
        {
            // FluentUI's multi-select fires OnFileUploaded for every queued
            // file while a previous one is still staging. Surface a friendly,
            // retryable message instead of silently dropping the file — the
            // user can wait a moment and re-pick the same file.
            _error = $"'{fileName}' is still uploading — please wait until the current upload finishes, then try again.";
            return;
        }

        var clientError = AttachmentUploadPolicy.Validate(fileName, fileSize);
        if (clientError is not null)
        {
            _error = clientError;
            return;
        }

        _staging = true;
        try
        {
            var staged = await Api.StageAttachmentAsync(content, fileName, contentType, fileSize);
            Model.AddAttachment(new AttachmentEditorRow
            {
                FileName = staged.FileName,
                ContentType = staged.ContentType,
                FileSize = staged.FileSize,
                StoragePath = staged.StoragePath,
                // R3 (P1-3): carry the extraction outcome the stage response reported, so it is on the
                // save payload and is not wiped when the server re-mints this row.
                ExtractionStatus = staged.ExtractionStatus,
                ExtractedText = staged.ExtractedText,
                ExtractedAt = staged.ExtractedAt,
                ExtractionError = staged.ExtractionError,
            });
            _error = null;
            await Changed.InvokeAsync();
        }
        catch (AttachmentStagingFailed ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            // navigation cancellation — swallow (mirrors the wizard's other sections)
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Stage attachment failed for {FileName}", fileName);
            _error = $"Could not upload '{fileName}'.";
        }
        finally
        {
            _staging = false;
        }
    }

    private async Task RemoveAtAsync(int index)
    {
        if (index < 0 || index >= Model.Attachments.Count)
        {
            return;
        }
        var fileName = Model.Attachments[index].FileName ?? "(unnamed)";
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            $"Remove '{fileName}'?",
            "Remove",
            "Cancel",
            "Remove file");
        if (!confirmed)
        {
            return;
        }
        Model.RemoveAttachmentAt(index);
        await Changed.InvokeAsync();
    }

    /// <summary>
    /// R3 (D3, criterion 5) — the testable seam for the user-triggered re-extraction of one
    /// <b>persisted</b> attachment row. The only path that rewrites a stored extraction; it replaces
    /// the outcome in place rather than appending a row, so running it twice leaves one attachment.
    /// A row staged in this session has no server id yet, so the action is offered only for loaded
    /// rows.
    /// </summary>
    public async Task RegenerateExtractionAsync(int index)
    {
        if (AssignmentId is not Guid assignmentId
            || index < 0 || index >= Model.Attachments.Count
            || Model.Attachments[index].Id is not Guid attachmentId)
        {
            return;
        }

        _reextractingIndex = index;
        _error = null;
        try
        {
            var updated = await Api.RegenerateAttachmentExtractionAsync(assignmentId, attachmentId);
            var row = Model.Attachments[index];
            row.ExtractionStatus = updated.ExtractionStatus;
            row.ExtractedText = updated.ExtractedText;
            row.ExtractedAt = updated.ExtractedAt;
            row.ExtractionError = updated.ExtractionError;
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
            // navigation cancellation — swallow (mirrors the other sections)
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Re-extracting attachment {AttachmentId} failed", attachmentId);
            _error = "Could not re-read that file. Please try again.";
        }
        finally
        {
            _reextractingIndex = null;
        }
    }

    private Task OnFileCountExceededAsync(int exceededCount)
    {
        // FluentUI 4.14.2's callback parameter is "the total number of files
        // that were attempted for upload", NOT the configured cap — so we
        // must reference AttachmentUploadPolicy.MaximumFileCount directly
        // (the same constant the FluentInputFile markup is bound to) to
        // show the user the true ceiling instead of the attempted batch size.
        _ = exceededCount;
        _error = $"Too many files selected at once — the limit is {AttachmentUploadPolicy.MaximumFileCount}. Add them in smaller batches.";
        return Task.CompletedTask;
    }

    /// <summary>WS-B2 (decision g) — adds the typed URL as an AI reference row
    /// (the testable seam the bUnit suite drives directly). An exact duplicate
    /// is a no-op with a warning; a blank URL is guarded client-side and by
    /// <see cref="AssignmentEditFormModel.AddResourceUrl"/>.</summary>
    public async Task AddUrlAsync()
    {
        _urlError = null;
        try
        {
            if (Model is null) return;
            var added = Model.AddResourceUrl(_newUrl ?? string.Empty);
            if (!added)
            {
                _urlError = "That link was already added.";
                return;
            }
            _newUrl = null;
            await Changed.InvokeAsync();
        }
        catch (ArgumentException ex)
        {
            _urlError = ex.Message;
        }
    }

    /// <summary>R3 (D2/D4): the author-facing label for a non-succeeded extraction. Unsupported and
    /// Failed are distinguished because they call for different author action — convert the file vs.
    /// check it uploaded intact.</summary>
    private static string ExtractionStatusText(AttachmentExtractionStatusDto status) => status switch
    {
        AttachmentExtractionStatusDto.Succeeded => "Text read",
        AttachmentExtractionStatusDto.Unsupported => "Not read (unsupported)",
        AttachmentExtractionStatusDto.Failed => "Not read (failed)",
        _ => "Not read yet",
    };

    /// <summary>WS-B2 (decision g) — removes the reference-URL row at
    /// <paramref name="index"/>.</summary>
    public async Task RemoveUrlAtAsync(int index)
    {
        if (index < 0 || index >= Model.ResourceUrls.Count)
        {
            return;
        }
        Model.RemoveResourceUrlAt(index);
        await Changed.InvokeAsync();
    }
}
