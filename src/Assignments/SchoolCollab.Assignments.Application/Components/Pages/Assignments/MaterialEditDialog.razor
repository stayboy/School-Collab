@* Round content-materials-redesign (owner 2026-10-10, Q1-Q5): the kebab's Text and Link actions are
   captured in THIS dialog — one dialog whose fields switch on the kind — and the page appends the row
   from the result (Q2). Built on DialogShellBase per the dialog-ui skill: never hand-rolled chrome,
   the footer's Error bound (never a literal), actions at the dialog's bottom. Upload From Device still
   pops the file picker directly (Q3).

   Round media-pill-listing (owner 2026-10-14, C2/Q10): the Audio/Video/Image kinds come through here
   too now — the same dialog, opened from the row's readout (Dialog-mode host) and from the recorder's
   commit — carrying the media's OPTIONAL, independent Title + Description. The staged FILE never
   passes through this dialog; only its metadata does.

   Post-close rework (owner 2026-10-14, grill Q9-Q12): the description slot doubles as the media
   PREVIEW. An eye-icon toggle (rendered only when the model carries a PreviewLoader) swaps the
   Description field for the native player/image in the same slot; the Blob URL resolves lazily on
   the first press through the host-supplied seam, so opening the dialog never streams a file.

   Round wysiwyg-instruction-editor, grill extension (owner 2026-10-11): a Text material's BODY is the
   shared RICH editor — read at submit and sanitised on the way out (Q11's write half). The Enter guard
   retired WITH the textarea it existed for: Quill's contenteditable never submits a form on Enter, and
   it inserts the newline itself. *@
@inherits DialogShellBase<MaterialEditFormModel, MaterialEditResult>
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Assignments.Contracts

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        @if (Model.Kind == InstructionKindDto.Text)
        {
            <p class="dialog-hint">A text material is named: the title is required, the body is optional.</p>
            <FluentTextField Label="Title" @bind-Value="Model.Title" class="full-width mb-3" />
            <label class="material-body-label" for="@BodyFieldId">Body (optional)</label>
            <RichInstructionEditor @ref="_bodyEditor"
                                   Id="@BodyFieldId"
                                   Value="@Model.Body"
                                   Placeholder="What this material covers…" />
        }
        else if (Model.Kind == InstructionKindDto.Url)
        {
            <p class="dialog-hint">A link needs an absolute http(s) URL. Its label is optional.</p>
            <FluentTextField Label="URL" @bind-Value="Model.Url" Placeholder="https://…" class="full-width mb-3" />
            <FluentTextField Label="Label (optional)" @bind-Value="Model.Title" class="full-width" />
        }
        else
        {
            @* Round media-pill-listing (C2/Q10): Audio/Video/Image now edit their OPTIONAL metadata
               here — a title and a plain-prose description, both independent and both optional. The
               file itself is untouched (the dialog never carries the staged file fields). This dialog
               is opened from the row's READOUT (Dialog-mode host) and from the recorder's commit; the
               Inline-mode host (question dialog) expands the same pair on the row instead (Q12). *@
            <p class="dialog-hint">Both fields are optional: name this material and/or describe what it covers.</p>
            <FluentTextField Label="Title (optional)" @bind-Value="Model.Title" class="full-width mb-3" />

            @* Post-close rework (owner 2026-10-14): the Preview ⇄ Description swap. The toggle
               renders only when a preview can resolve (the loader seam is present) — never a dead
               button — and both views never show at once: they own the SAME slot, description by
               default (the dialog's job is metadata), preview on demand. *@
            @if (Model.PreviewLoader is not null)
            {
                <div class="media-preview-toggle">
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@FluentIcons.Eye"
                                  Disabled="@_previewLoading"
                                  OnClick="@TogglePreviewAsync"
                                  aria-label="@( _showPreview ? "Hide the media preview" : "Preview the media file" )">
                        @(_showPreview ? "Hide preview" : "Preview")
                    </FluentButton>
                </div>
            }

            @if (_showPreview)
            {
                <div class="media-preview">
                    @if (_previewUrl is null)
                    {
                        <p class="media-preview-missing">Preview unavailable for this file.</p>
                    }
                    else if (Model.Kind == InstructionKindDto.Video)
                    {
                        <video controls src="@_previewUrl" class="media-preview-video"></video>
                    }
                    else if (Model.Kind == InstructionKindDto.Audio)
                    {
                        <audio controls src="@_previewUrl" class="media-preview-audio"></audio>
                    }
                    else
                    {
                        <img src="@_previewUrl" alt="@(Model.Title ?? "Media preview")" class="media-preview-image" />
                    }
                </div>
            }
            else
            {
                @* Post-close correction (owner 2026-10-14): the media DESCRIPTION is the SAME shared
                   rich editor as a Text material's body — Q10's letter ("mirroring its Text branch's
                   Title + rich Body"). Read at submit and sanitised there (no binding exists); the
                   label element replaces the FluentTextField's own Label, exactly as in the Text branch. *@
                <label class="material-body-label" for="@BodyFieldId">Description (optional)</label>
                <RichInstructionEditor @ref="_bodyEditor"
                                       Id="@BodyFieldId"
                                       Value="@Model.Body"
                                       Placeholder="What this material covers…" />
            }
        }

        <DialogShellFooter Saving="@Saving" Error="@Error" SubmitText="@SubmitText" OnCancel="HandleCancelAsync" />
    </EditForm>
</div>

@code {
    /// <summary>The body field's id — the seam the rich editor wraps (and the bUnit seam).</summary>
    public const string BodyFieldId = "material-edit-body";

    /// <summary>The rich body editor (grill extension, owner 2026-10-11). No binding exists (G6), so
    /// its HTML is read in <see cref="SubmitAsync"/> — the one point where the value can enter the
    /// result — and sanitised there.</summary>
    private RichInstructionEditor? _bodyEditor;

    protected override string SubmitText =>
        Model.Kind is InstructionKindDto.Audio or InstructionKindDto.Video or InstructionKindDto.Image
            ? "Save"
            : Model.IsEdit ? "Save"
                : Model.Kind == InstructionKindDto.Text ? "Add Text Content" : "Add Link";

    protected override string SavingText => Model.IsEdit ? "Saving…" : "Adding…";

    /// <summary>Post-close rework (owner 2026-10-14): whether the media branch currently shows the
    /// preview instead of the description (they share one slot; description is the default view).</summary>
    private bool _showPreview;

    /// <summary>True while the seam is resolving, so the toggle reads as busy rather than dead.</summary>
    private bool _previewLoading;

    /// <summary>The resolved preview Blob URL — fetched ONCE per dialog (the host-side seam caches),
    /// kept across toggles. Null while unresolved or when the seam yielded nothing.</summary>
    private string? _previewUrl;

    /// <summary>Swaps the description slot for the media preview and back. The URL resolves lazily on
    /// the FIRST press only; a seam failure or a null result renders the named "unavailable" state
    /// (never a blank box, never a thrown dialog) — the AC-10 rule applied to the preview.</summary>
    private async Task TogglePreviewAsync()
    {
        if (_showPreview)
        {
            _showPreview = false;
            return;
        }

        // The preview takes the description's slot, so the rich editor UNMOUNTS: capture its HTML
        // into the model first, or the author's unsaved edits would die with the editor and submit
        // would see the stale seeded value. The model then re-seeds the editor on hide.
        if (_bodyEditor is not null)
        {
            var bodyHtml = await _bodyEditor.GetHtmlAsync();
            if (bodyHtml is not null)
            {
                Model.Body = bodyHtml;
            }
        }

        _previewLoading = true;
        try
        {
            _previewUrl ??= await (Model.PreviewLoader?.Invoke() ?? Task.FromResult<string?>(null));
        }
        catch (Exception)
        {
            _previewUrl = null;
        }
        finally
        {
            _previewLoading = false;
            _showPreview = true;
        }
    }

    /// <summary>Mirrors <c>InstructionDtoValidator</c> so the author is told before the save, not after
    /// (D6/D7, AC-4): a Text row must be NAMED (body optional); a Link row must carry an absolute
    /// http(s) URL (its label optional). Returning null keeps the dialog open with the Error shown.
    /// <para>The Text half reads the rich editor here (Q11 write-side): a null read = editor unavailable
    /// → the form's value is kept, never wiped; an editor that holds nothing yields the Quill empty
    /// payload <c>&lt;p&gt;&lt;br&gt;&lt;/p&gt;</c>, which is stored as <c>null</c> — never as junk markup.</para></summary>
    protected override async Task<MaterialEditResult?> SubmitAsync(MaterialEditFormModel model)
    {
        if (model.Kind == InstructionKindDto.Text)
        {
            if (_bodyEditor is not null)
            {
                var bodyHtml = await _bodyEditor.GetHtmlAsync();
                if (bodyHtml is not null)
                {
                    model.Body = RichInstructionSanitizer.Sanitize(bodyHtml);
                }
            }

            if (model.Body is not null && string.IsNullOrWhiteSpace(RichInstructionSanitizer.ToPlainText(model.Body)))
            {
                model.Body = null;
            }

            if (string.IsNullOrWhiteSpace(model.Title))
            {
                Error = "A text material needs its title.";
                return null;
            }

            return new MaterialEditResult(
                model.Kind,
                model.Title!.Trim(),
                string.IsNullOrWhiteSpace(model.Body) ? null : model.Body!.Trim(),
                null);
        }

        if (model.Kind is InstructionKindDto.Audio or InstructionKindDto.Video or InstructionKindDto.Image)
        {
            // C2/Q10 + post-close correction (owner 2026-10-14): a media row's description IS the shared
            // rich editor — the Text branch's body half exactly: read at submit (no binding exists) and
            // sanitised on the way out; the Quill empty payload is stored as null, never as junk markup.
            // Title and description stay independent and both optional; the file fields are never touched.
            if (_bodyEditor is not null)
            {
                var bodyHtml = await _bodyEditor.GetHtmlAsync();
                if (bodyHtml is not null)
                {
                    model.Body = RichInstructionSanitizer.Sanitize(bodyHtml);
                }
            }
            else if (model.Body is not null)
            {
                // The preview was showing at submit, so the editor is unmounted: the model carries the
                // HTML captured on the way into the preview — sanitise it here rather than trusting it.
                model.Body = RichInstructionSanitizer.Sanitize(model.Body);
            }

            if (model.Body is not null && string.IsNullOrWhiteSpace(RichInstructionSanitizer.ToPlainText(model.Body)))
            {
                model.Body = null;
            }

            return new MaterialEditResult(
                model.Kind,
                string.IsNullOrWhiteSpace(model.Title) ? null : model.Title!.Trim(),
                string.IsNullOrWhiteSpace(model.Body) ? null : model.Body!.Trim(),
                null);
        }

        if (!Uri.TryCreate(model.Url, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            Error = "A link needs an absolute http(s) URL.";
            return null;
        }

        return new MaterialEditResult(
            model.Kind,
            string.IsNullOrWhiteSpace(model.Title) ? null : model.Title!.Trim(),
            null,
            model.Url!.Trim());
    }
}
