@* Round content-materials-redesign (owner 2026-10-10, Q1-Q5): the kebab's Text and Link actions are
   captured in THIS dialog — one dialog whose fields switch on the kind — and the page appends the row
   from the result (Q2). Built on DialogShellBase per the dialog-ui skill: never hand-rolled chrome,
   the footer's Error bound (never a literal), actions at the dialog's bottom. Media never comes
   through here — Upload From Device pops the file picker directly (Q3).

   Round wysiwyg-instruction-editor, grill extension (owner 2026-10-11): a Text material's BODY is the
   shared RICH editor — read at submit and sanitised on the way out (Q11's write half). The Enter guard
   retired WITH the textarea it existed for: Quill's contenteditable never submits a form on Enter, and
   it inserts the newline itself. *@
@inherits DialogShellBase<MaterialEditFormModel, MaterialEditResult>
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Assignments.Contracts

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        @if (Model.Kind == InstructionKindDto.Text)
        {
            <p class="dialog-hint">A text material is named: the title is required, the body is optional.</p>
            <FluentTextField Label="Title" @bind-Value="Model.Title" class="full-width mb-3" />
            <label class="material-body-label" for="@BodyFieldId">Body (optional)</label>
            <RichInstructionEditor @ref="_bodyEditor"
                                   Id="@BodyFieldId"
                                   Value="@Model.Body"
                                   Placeholder="What this material covers…" />
        }
        else
        {
            <p class="dialog-hint">A link needs an absolute http(s) URL. Its label is optional.</p>
            <FluentTextField Label="URL" @bind-Value="Model.Url" Placeholder="https://…" class="full-width mb-3" />
            <FluentTextField Label="Label (optional)" @bind-Value="Model.Title" class="full-width" />
        }

        <DialogShellFooter Saving="@Saving" Error="@Error" SubmitText="@SubmitText" OnCancel="HandleCancelAsync" />
    </EditForm>
</div>

@code {
    /// <summary>The body field's id — the seam the rich editor wraps (and the bUnit seam).</summary>
    public const string BodyFieldId = "material-edit-body";

    /// <summary>The rich body editor (grill extension, owner 2026-10-11). No binding exists (G6), so
    /// its HTML is read in <see cref="SubmitAsync"/> — the one point where the value can enter the
    /// result — and sanitised there.</summary>
    private RichInstructionEditor? _bodyEditor;

    protected override string SubmitText =>
        Model.IsEdit ? "Save"
            : Model.Kind == InstructionKindDto.Text ? "Add Text Content" : "Add Link";

    protected override string SavingText => Model.IsEdit ? "Saving…" : "Adding…";

    /// <summary>Mirrors <c>InstructionDtoValidator</c> so the author is told before the save, not after
    /// (D6/D7, AC-4): a Text row must be NAMED (body optional); a Link row must carry an absolute
    /// http(s) URL (its label optional). Returning null keeps the dialog open with the Error shown.
    /// <para>The Text half reads the rich editor here (Q11 write-side): a null read = editor unavailable
    /// → the form's value is kept, never wiped; an editor that holds nothing yields the Quill empty
    /// payload <c>&lt;p&gt;&lt;br&gt;&lt;/p&gt;</c>, which is stored as <c>null</c> — never as junk markup.</para></summary>
    protected override async Task<MaterialEditResult?> SubmitAsync(MaterialEditFormModel model)
    {
        if (model.Kind == InstructionKindDto.Text)
        {
            if (_bodyEditor is not null)
            {
                var bodyHtml = await _bodyEditor.GetHtmlAsync();
                if (bodyHtml is not null)
                {
                    model.Body = RichInstructionSanitizer.Sanitize(bodyHtml);
                }
            }

            if (model.Body is not null && string.IsNullOrWhiteSpace(RichInstructionSanitizer.ToPlainText(model.Body)))
            {
                model.Body = null;
            }

            if (string.IsNullOrWhiteSpace(model.Title))
            {
                Error = "A text material needs its title.";
                return null;
            }

            return new MaterialEditResult(
                model.Kind,
                model.Title!.Trim(),
                string.IsNullOrWhiteSpace(model.Body) ? null : model.Body!.Trim(),
                null);
        }

        if (!Uri.TryCreate(model.Url, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            Error = "A link needs an absolute http(s) URL.";
            return null;
        }

        return new MaterialEditResult(
            model.Kind,
            string.IsNullOrWhiteSpace(model.Title) ? null : model.Title!.Trim(),
            null,
            model.Url!.Trim());
    }
}
