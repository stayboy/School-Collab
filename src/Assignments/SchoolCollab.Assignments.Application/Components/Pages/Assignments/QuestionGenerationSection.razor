@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Assignments.Application.Services
@using SchoolCollab.AI.Abstractions
@implements IDisposable
@inject IDialogService DialogService
@inject IAssignmentQuestionGenerator QuestionGenerator
@inject ILogger<QuestionGenerationSection> Logger
@inject IUrlTextExtractor UrlTextExtractor
@inject AssignmentsApiClient Api

<section class="question-generation-section">
    <div class="cq-composer" id="cq-composer">
        @* QA-1/QA-2 (spec §6.1): the prompt is the composer's hero field. No visible
           label — the reference has none — so the accessible name comes from the
           visually-hidden label element instead. *@
        <label class="cq-visually-hidden" for="cq-composer-prompt">Additional guidance for the AI (optional)</label>
        <FluentTextArea @bind-Value="Model.AiPromptOverride"
                        Id="cq-composer-prompt"
                        MaxLength="4000"
                        Rows="3"
                        Disabled="@PromptLocked"
                        Placeholder="Describe the questions you want — e.g. '10 mixed questions on fractions, 40% hard'"
                        Tooltip="@(PromptLocked ? "Your organization has locked the AI prompt." : null)"
                        class="full-width" />

        @* QA-3/QA-4/QA-22 (spec §6.1, D14): the knobs moved into the dialog, so the composer shows
           only the read-only summary and the Configure trigger. The Generate row keeps the
           trailing-edge primary action (QA-5). *@
        <div class="cq-composer-config">
            <span class="cq-config-summary" id="cq-config-summary">@ConfigSummary</span>
            <FluentButton Id="cq-configure"
                          Appearance="Appearance.Outline"
                          IconStart="@FluentIcons.Settings"
                          Disabled="@(!GateEnabled || TopicId is null || _generating)"
                          OnClick="OpenPromptDialogAsync"
                          Tooltip="@(TopicId is null ? ConfigureDisabledReason : null)">
                Configure
            </FluentButton>
        </div>

        @* QA-4: the disabled reason, mirroring Generate's own "select a subject" message. *@
        @if (TopicId is null)
        {
            <p class="cq-configure-reason" id="cq-configure-reason">@ConfigureDisabledReason</p>
        }

        <div class="cq-composer-footer">
            <div class="cq-composer-actions">
                <FluentButton Appearance="Appearance.Accent"
                              Disabled="@(!GateEnabled || _generating)"
                              OnClick="OnGenerateAsync"
                              Tooltip="@(GateEnabled ? null : QuestionGenerationGate.DisabledTooltip)">
                    @(_generating ? "Generating…" : "Generate")
                </FluentButton>

                @if (_generating)
                {
                    <FluentProgressRing class="question-generation-progress" />
                    <FluentButton Appearance="Appearance.Neutral"
                                  OnClick="OnCancelAsync">
                        Cancel
                    </FluentButton>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_generationError))
        {
            <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_generationError</FluentMessageBar>
        }

        @if (!string.IsNullOrEmpty(_urlWarning))
        {
            <FluentMessageBar Intent="MessageIntent.Warning" class="mt-2">@_urlWarning</FluentMessageBar>
        }

        @if (!string.IsNullOrEmpty(_attachmentWarning))
        {
            <FluentMessageBar Intent="MessageIntent.Warning" class="mt-2">@_attachmentWarning</FluentMessageBar>
        }
    </div>
</section>

@code {
    /// <summary>The form model that owns the prompt override and the question
    /// list the generated questions are appended to.</summary>
    [Parameter, EditorRequired] public AssignmentEditFormModel Model { get; set; } = default!;

    /// <summary>True when the type + grading format combination supports
    /// AI question generation (FR-220 / EC-3).</summary>
    [Parameter] public bool GateEnabled { get; set; }

    /// <summary>True when the tenant LOCKED the org-level AI prompt (WS-B2
    /// spec §3.4 line 70) — disables the prompt-guidance textarea.</summary>
    [Parameter] public bool PromptLocked { get; set; }

    /// <summary>The selected subject's id, passed into the generation
    /// request's <see cref="QuestionGenerationRequest.TopicId"/>. Null
    /// short-circuits the call with a friendly "select a subject"
    /// message.</summary>
    [Parameter] public Guid? TopicId { get; set; }

    /// <summary>The selected subject's display name, passed into
    /// <see cref="QuestionGenerationRequest.TopicName"/>.</summary>
    [Parameter] public string? TopicName { get; set; }

    /// <summary>R3 (D4/P1-2): the assignment being authored, or null in Create mode (where no row
    /// exists yet to hang a generation header off). When set, every successful generate records one
    /// <c>AssignmentQuestionGeneration</c> header and stamps its id onto the appended rows.</summary>
    [Parameter] public Guid? AssignmentId { get; set; }

    /// <summary>Raised after a successful append so the page can re-render
    /// review counts and the submit gate. The page is the
    /// orchestrator; this component owns the generation call only.</summary>
    [Parameter] public EventCallback OnQuestionsChanged { get; set; }

    private int _questionCount = 5;
    private bool _includeMultipleChoice = true;
    private bool _includeTrueFalse = true;
    private bool _includeShortAnswer = true;

    /// <summary>QA-4: the Configure trigger's disabled reason — the composer's own "select a subject"
    /// message, so both actions explain themselves identically.</summary>
    private const string ConfigureDisabledReason = "Select a subject before generating questions.";

    /// <summary>The targeted grades' canonical levels (D18/PB-3). Supplied by the page from
    /// <c>KnownGradeTargetIds</c> + the loaded grade levels — no new API call.</summary>
    [Parameter] public IReadOnlyList<int> TargetGradeLevels { get; set; } = [];

    /// <summary>QA-3: the read-only summary line — the same parts the narrative is built from.</summary>
    private string ConfigSummary => QuestionPromptComposer.ComposeSummary(NarrativeInputs());

    private IReadOnlyList<QuestionTypeDto> SelectedTypes()
    {
        var picked = new List<QuestionTypeDto>(3);
        if (_includeMultipleChoice) picked.Add(QuestionTypeDto.MultipleChoice);
        if (_includeTrueFalse) picked.Add(QuestionTypeDto.TrueFalse);
        if (_includeShortAnswer) picked.Add(QuestionTypeDto.ShortAnswer);
        return picked;
    }

    /// <summary>The attached file/link names the narrative names (PB-4's <c>Grounded on:</c> line).</summary>
    private IReadOnlyList<string> ResourceNames() =>
        Model.Attachments.Select(a => a.FileName).OfType<string>()
            .Concat(Model.ResourceUrls.Select(r => r.Url))
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .ToList();

    private QuestionPromptNarrativeInputs NarrativeInputs() => new(
        TopicName: TopicName,
        GradeLevels: TargetGradeLevels,
        QuestionCount: _questionCount,
        DifficultyEasy: Model.DifficultyEasyCount,
        DifficultyMedium: Model.DifficultyMediumCount,
        DifficultyHard: Model.DifficultyHardCount,
        Types: SelectedTypes(),
        ResourceNames: ResourceNames());

    /// <summary>PB-6: open the knobs dialog. Difficulty always opens from the PERSISTED assignment
    /// counts (PB-6(i)); the count and type mix come from the template parse only when the prompt
    /// still matches PB-4's skeleton, otherwise from this surface's current values (PB-6(ii)).</summary>
    private async Task OpenPromptDialogAsync()
    {
        if (TopicId is null || _generating)
        {
            return;
        }

        var count = _questionCount;
        var multiple = _includeMultipleChoice;
        var trueFalse = _includeTrueFalse;
        var shortAnswer = _includeShortAnswer;

        if (QuestionPromptComposer.TryParse(Model.AiPromptOverride, out var parsed))
        {
            count = parsed.QuestionCount;
            multiple = parsed.Types.Contains(QuestionTypeDto.MultipleChoice);
            trueFalse = parsed.Types.Contains(QuestionTypeDto.TrueFalse);
            shortAnswer = parsed.Types.Contains(QuestionTypeDto.ShortAnswer);
        }

        var model = new QuestionPromptModel
        {
            TopicName = TopicName,
            GradeLevels = TargetGradeLevels,
            ResourceNames = ResourceNames(),
            PromptLocked = PromptLocked,
            QuestionCount = count,
            DifficultyEasyCount = Model.DifficultyEasyCount,
            DifficultyMediumCount = Model.DifficultyMediumCount,
            DifficultyHardCount = Model.DifficultyHardCount,
            IncludeMultipleChoice = multiple,
            IncludeTrueFalse = trueFalse,
            IncludeShortAnswer = shortAnswer,
        };

        var result = await DialogService
            .ShowShellDialogAsync<QuestionPromptDialog, QuestionPromptModel, QuestionPromptResult>(
                model, "Configure questions", DialogSize.Medium);

        if (result is null)
        {
            return;
        }

        ApplyPromptResult(result);
        await WriteComposedPromptAsync(confirmBeforeReplace: true);
    }

    /// <summary>The dialog's knobs always apply; whether they are WRITTEN into the prompt is PB-5's
    /// separate decision, so declining the confirm never costs the author their knob edits.</summary>
    private void ApplyPromptResult(QuestionPromptResult result)
    {
        _questionCount = result.QuestionCount;
        Model.DifficultyEasyCount = result.DifficultyEasyCount;
        Model.DifficultyMediumCount = result.DifficultyMediumCount;
        Model.DifficultyHardCount = result.DifficultyHardCount;
        _includeMultipleChoice = result.IncludeMultipleChoice;
        _includeTrueFalse = result.IncludeTrueFalse;
        _includeShortAnswer = result.IncludeShortAnswer;
    }

    /// <summary>PB-5's write point. The confirm runs CALLER-side because <c>dialog-ui</c> forbids
    /// nested dialogs — a <c>ConfirmDialog</c> inside a shell dialog is exactly that.</summary>
    private async Task WriteComposedPromptAsync(bool confirmBeforeReplace)
    {
        if (PromptLocked)
        {
            // PB-8: a locked org has its PromptOverride discarded by the server.
            return;
        }

        var current = Model.AiPromptOverride;
        if (string.IsNullOrWhiteSpace(current) || QuestionPromptComposer.IsTemplateMatch(current))
        {
            Model.AiPromptOverride = QuestionPromptComposer.Compose(NarrativeInputs());
            return;
        }

        if (!confirmBeforeReplace)
        {
            return;
        }

        var replace = await DialogService.ShowConfirmDialogAsync(
            "Replace the prompt guidance you wrote with the generated one? Your text will be overwritten.",
            primaryText: "Replace",
            title: "Replace prompt");

        if (replace)
        {
            Model.AiPromptOverride = QuestionPromptComposer.Compose(NarrativeInputs());
        }
    }

    /// <summary>QA-23: refresh before Generate when the context changed and the text is still the
    /// machine-composed one. "Template-matched" is the unedited predicate, so the rule behaves
    /// identically after a reload where no transient state exists.</summary>
    private void RefreshComposedPromptIfStale()
    {
        if (PromptLocked)
        {
            return;
        }

        var current = Model.AiPromptOverride;
        if (!QuestionPromptComposer.IsTemplateMatch(current))
        {
            return;
        }

        var narrative = QuestionPromptComposer.Compose(NarrativeInputs());
        if (!string.Equals(current, narrative, StringComparison.Ordinal))
        {
            Model.AiPromptOverride = narrative;
        }
    }
    private bool _generating;
    private string? _generationError;
    private string? _urlWarning;
    private string? _attachmentWarning;
    private CancellationTokenSource? _generateCts;

    private async Task OnGenerateAsync()
    {
        if (!GateEnabled || _generating)
        {
            return;
        }
        if (_questionCount < 1)
        {
            // EC-10: zero (or negative) count = no call. Min="1" on the
            // number field normally prevents this, but guard here too so a
            // pasted value cannot slip through.
            return;
        }
        if (TopicId is null)
        {
            _generationError = "Select a subject before generating questions.";
            return;
        }

        _generating = true;
        _generationError = null;
        _generateCts?.Cancel();
        _generateCts?.Dispose();
        _generateCts = new CancellationTokenSource();
        var ct = _generateCts.Token;

        // QA-23: keep the composed narrative honest for the knobs this request is about to send.
        RefreshComposedPromptIfStale();

        // Build the type set; null = "all" (server-side balanced default per FR-221).
        IReadOnlyList<GeneratedQuestionType>? types = null;
        var picked = new List<GeneratedQuestionType>(3);
        if (_includeMultipleChoice) picked.Add(QuestionEditorRow.ToGeneratedType(QuestionTypeDto.MultipleChoice));
        if (_includeTrueFalse) picked.Add(QuestionEditorRow.ToGeneratedType(QuestionTypeDto.TrueFalse));
        if (_includeShortAnswer) picked.Add(QuestionEditorRow.ToGeneratedType(QuestionTypeDto.ShortAnswer));
        if (picked.Count > 0) types = picked;

        // R3 (P1-2): the same selection as wire enum names, for the generation header's requested
        // shape. Derived from the checkboxes rather than the GeneratedQuestionType list so the
        // recorded shape is the author's request, not the AI host's wire mirror of it.
        var requestedTypes = new List<QuestionTypeDto>(3);
        if (_includeMultipleChoice) requestedTypes.Add(QuestionTypeDto.MultipleChoice);
        if (_includeTrueFalse) requestedTypes.Add(QuestionTypeDto.TrueFalse);
        if (_includeShortAnswer) requestedTypes.Add(QuestionTypeDto.ShortAnswer);

        // WS-B2 + URL ingestion (decision g): fetch up to 3 included URLs as reference material;
        // per-URL failure is fail-open with a warning.
        var allUrls = Model.ResourceUrls.Select(r => r.Url).ToList();
        var urls = allUrls.Take(3).ToList();
        var overCapSkipped = allUrls.Count - urls.Count;
        var failedUrls = new List<string>();
        var urlTexts = new List<string>(urls.Count);
        foreach (var url in urls)
        {
            var result = await UrlTextExtractor.ExtractAsync(url, ct);
            if (result.Success && result.Text is not null)
                urlTexts.Add(result.Text);
            else
                failedUrls.Add(url);
        }
        _urlWarning = BuildUrlWarning(overCapSkipped, failedUrls);

        // R3 (P1-6 / AI-3): attachment texts are grounded through the SAME seam and the SAME budget as
        // the URL texts — URL first, attachments into the remaining slots, per-attachment fail-open
        // drop when the slots run out. Extending the budget would need an AI-host constant change,
        // which this round forbids; the AI host rejects > 5 entries with a 400.
        // R3-2: the budget reports its own overflow, and that count (never a re-derived one) drives the
        // warning below — an attachment that grounded nothing must not read as if it had.
        var attachmentTexts = Model.Attachments
            .Where(a => a.ExtractionStatus == AttachmentExtractionStatusDto.Succeeded
                && !string.IsNullOrEmpty(a.ExtractedText))
            .Select(a => a.ExtractedText!)
            .ToList();
        var composition = ResourceTextBudget.ComposeWithReport(urlTexts, attachmentTexts);
        var resourceTexts = composition.Texts;
        _attachmentWarning = BuildAttachmentWarning(composition.DroppedAttachmentCount);

        var request = new QuestionGenerationRequest(
            TopicId: TopicId.Value,
            TopicName: TopicName ?? string.Empty,
            ContextStrands: null,
            QuestionCount: _questionCount,
            Types: types,
            PromptOverride: Model.AiPromptOverride,
            DifficultyEasyCount: Model.DifficultyEasyCount,
            DifficultyMediumCount: Model.DifficultyMediumCount,
            DifficultyHardCount: Model.DifficultyHardCount,
            ResourceTexts: resourceTexts);

        // WS-B2: the difficulty fields bind directly to the form model, so
        // the values are already on Model before Generate runs and survive a
        // Save-without-Generate (decision (c) — never reset the mix).

        Logger.LogInformation(
            "Requesting {Count} questions for topic {TopicName}",
            _questionCount, request.TopicName);

        try
        {
            var response = await QuestionGenerator.GenerateAsync(request, ct);

            // R3 (D4/P1-2): record the generation BEFORE the questions land on the form, so the rows
            // carry the header id from the moment they exist. Only possible once the assignment
            // exists (Edit) — a Create has no row to hang the header off, and the questions it saves
            // then correctly carry a null GenerationId.
            Guid? generationId = null;
            if (AssignmentId is Guid assignmentId)
            {
                generationId = await Api.RecordQuestionGenerationAsync(
                    assignmentId,
                    new RecordQuestionGenerationRequest(
                        QuestionCount: _questionCount,
                        Types: requestedTypes.Count > 0 ? requestedTypes : null,
                        DifficultyEasyCount: Model.DifficultyEasyCount,
                        DifficultyMediumCount: Model.DifficultyMediumCount,
                        DifficultyHardCount: Model.DifficultyHardCount,
                        // P1-1: the AI host's own resolution, relayed — never a client-chosen model.
                        Provider: response.Provider,
                        Model: response.Model),
                    ct);
            }

            Model.AppendGenerated(response.Questions, generationId);
            await OnQuestionsChanged.InvokeAsync();
        }
        catch (QuestionGenerationFailed ex)
        {
            // EC-1 / EC-8: friendly text from the typed exception; the
            // still-enabled Generate button is the retry.
            _generationError = ex.Message;
        }
        catch (OperationCanceledException)
        {
            // EC-2: cancel leaves the list untouched; nothing to surface.
        }
        catch (Exception ex)
        {
            // Catch-all (P2 tester finding): non-typed failures must not
            // escape to the page-level ErrorBoundary and permanently
            // replace the wizard. Log the exception and surface the
            // same friendly error state — the still-enabled Generate
            // button is the retry. The message is intentionally
            // user-facing: a transient infrastructure blip the teacher
            // can try again from.
            Logger.LogError(
                ex,
                "Unexpected error generating questions for topic {TopicName}",
                request.TopicName);
            _generationError = "Something went wrong while generating questions. Please try again.";
        }
        finally
        {
            _generating = false;
        }
    }

    private void OnCancelAsync()
    {
        _generateCts?.Cancel();
    }

    private static string? BuildUrlWarning(int overCapSkipped, IReadOnlyList<string> failedUrls)
    {
        var parts = new List<string>(2);
        if (overCapSkipped > 0)
        {
            parts.Add($"Only the first 3 included links are fetched; {overCapSkipped} link(s) skipped.");
        }
        if (failedUrls.Count > 0)
        {
            parts.Add($"Couldn't read content from: {string.Join(", ", failedUrls)} — generating without it.");
        }
        return parts.Count > 0 ? string.Join(" ", parts) : null;
    }

    /// <summary>R3-2: the attachment half's warning, mirroring <see cref="BuildUrlWarning"/>. The drop is
    /// fail-open by design, so the only thing the author can act on is knowing it happened and why.</summary>
    private static string? BuildAttachmentWarning(int droppedAttachmentCount) =>
        droppedAttachmentCount > 0
            ? $"{droppedAttachmentCount} attachment(s) were read but not included in this generation: " +
              $"the {ResourceTextBudget.MaxResourceTexts}-text grounding budget is full. " +
              "Remove a reference URL or attachment to include them."
            : null;

    public void Dispose()
    {
        _generateCts?.Cancel();
        _generateCts?.Dispose();
        _generateCts = null;
    }
}
