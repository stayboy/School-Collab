@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@using SchoolCollab.Assignments.Application.Helpers
@inject IJSRuntime JS
@implements IAsyncDisposable

@* QR-5 (spec §5.2/§5.6, owner 2026-10-09): the shared INSTRUCTION editor — one shape, two owners
   (the assignment's own blocks and each question's). Inline by construction: the dialog-ui rule
   forbids a nested dialog, so this is a plain presentational panel, and it holds no API client — the
   host supplies staging as StageMediaAsync, exactly as the attachments flow stages at selection. *@
<div class="cq-instructions@(_recordingRow is not null ? " cq-instructions-recording" : string.Empty)" id="@Id">
    @if (_recordingRow is not null)
    {
        @* Round-recorder-takeover (owner 2026-10-12, grill Q2/Q3/Q5): while a recorder is open it
           takes over the WHOLE container — the rows, dropzone, add button and error line are
           suppressed and the panel's own header carries the close affordance (labeled Cancel). The
           placeholder row stays in Rows untouched: cancel discards the take, never the row. *@
        <div class="cq-instruction-recorder" id="@($"{Id}-recorder-takeover")">
            @* Hold verdict 2026-10-12 (finding 2): @key on the recording row — without it, replacing an
               open pill review with a new recorder REUSES this panel instance, whose reopened-Review
               state (old take's player + Record again) survives even after the seed is cleared. The
               key gives the "a new instance reopens" semantics the Seed contract already assumed (see
               RecorderPanel.OnParametersSet); the discarded instance's seeded URL is safe from its
               teardown revoke by the panel's own ownership guard. *@
            <RecorderPanel @key="_recordingRow"
                           Id="@($"{Id}-recorder-{Rows.IndexOf(_recordingRow)}")"
                           IsVideo="@(_recordingRow.Kind == InstructionKindDto.Video)"
                           Seed="@_reviewSeed"
                           OnRecorded="@(media => OnRecordedAsync(_recordingRow!, media))"
                           OnClose="CloseRecorder" />
        </div>
    }
    else
    {
    @if (Rows.Count == 0)
    {
        <p class="cq-instructions-empty" id="@($"{Id}-empty")">No instructions yet.</p>
    }
    else
    {
        <ul class="cq-instruction-rows" id="@($"{Id}-rows")">
            @foreach (var (row, index) in Rows.Select((r, i) => (r, i)))
            {
                <li class="cq-instruction-row" @key="row">
                    @* D12/§4 + grill Q1/Q2 (round material-row-editing): the kind reads as an ICON
                       befitting the material — the per-row kind DROPDOWN was the replaced pattern, and
                       its word is gone too. The word survives only as the wrapper's accessible name, so
                       a screen reader still hears "Text": an icon-only indicator with no name would be
                       an a11y regression, and the tooltip keeps hover honest. *@
                    <span class="cq-instruction-kind cq-instruction-kind-readonly"
                          role="img"
                          aria-label="@EnumHelper.GetDescription(row.Kind)"
                          title="@EnumHelper.GetDescription(row.Kind)">
                        <FluentIcon Value="@KindIcon(row.Kind)" />
                    </span>

                    @switch (row.Kind)
                    {
                        case InstructionKindDto.Text:
                            @if (EditingMode == RowEditingMode.Dialog)
                            {
                                @* Q4(b) + owner refinement (2026-10-10): the row is IDENTIFIED, not read —
                                   an icon plus the material's NAME. A Text material's name is its title; the
                                   body is what the dialog is for, which is where it is read and edited
                                   (AC-14 amended to match). *@
                                <span class="cq-instruction-readout cq-instruction-readout-payload" id="@($"{Id}-title-{index}")">@row.Title</span>
                            }
                            else
                            {
                                @* D6/D10: a Text material is TITLED (the title is required, the body optional) —
                                   the title is the row's first field, so it is also the focus target (AC-2). *@
                                <FluentTextField @ref="_focusTarget"
                                                 @bind-Value="row.Title"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="Name this material"
                                                 class="cq-instruction-title" />
                                <FluentTextField @bind-Value="row.Text"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="What the student should read or do"
                                                 class="cq-instruction-payload" />
                            }
                            break;

                        case InstructionKindDto.Url:
                            @if (EditingMode == RowEditingMode.Dialog)
                            {
                                @* Q4(b) + the same identification rule for a Link: its LABEL names it, and a
                                   link with no label is named by its target — never a blank row (the ward
                                   card's own title ?? url rule, D11). *@
                                <span class="cq-instruction-readout cq-instruction-readout-payload" id="@($"{Id}-label-{index}")">@(string.IsNullOrWhiteSpace(row.Title) ? row.Url : row.Title)</span>
                            }
                            else
                            {
                                <FluentTextField @ref="_focusTarget"
                                                 @bind-Value="row.Url"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="https://…"
                                                 class="cq-instruction-payload" />
                                @* D7: a Link's title is an optional LABEL — never prose (D10). *@
                                <FluentTextField @bind-Value="row.Title"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="Label (optional)"
                                                 class="cq-instruction-title" />
                            }
                            break;

                        default:
                            @* Audio · Video · Image: a staged file (stage-at-selection). *@
                            @if (string.IsNullOrWhiteSpace(row.StoragePath))
                            {
                                @* D3/D10 (recording-materials): the Record affordance sits beside the upload
                                   control in the SAME capture slot — a recording is just a second input path
                                   to the same staged media row. Toggling it expands the inline RecorderPanel;
                                   its OnRecorded stages through the same StageMediaFileAsync seam an upload
                                   uses, so the list stays the single writer of its rows. *@
                                <div class="cq-instruction-capture">
                                    <FluentInputFile Mode="InputFileMode.Stream"
                                                     MaximumFileCount="1"
                                                     Accept="@AttachmentUploadPolicy.AcceptExtensions"
                                                     MaximumFileSize="@AttachmentUploadPolicy.MaxFileSizeBytes"
                                                     OnCompleted="@(args => OnFileUploadedAsync(row, args))" />
                                    @if (!ReadOnly && StageMediaAsync is not null)
                                    {
                                        <FluentButton Appearance="Appearance.Neutral"
                                                      Id="@($"{Id}-record-{index}")"
                                                      IconStart="@(row.Kind == InstructionKindDto.Audio ? FluentIcons.Mic : new Icons.Regular.Size20.Video())"
                                                      OnClick="@(() => ToggleRecorderAsync(row))">
                                            Record
                                        </FluentButton>
                                    }
                                </div>
                            }
                            else
                            {
                                @* Owner pill rework (2026-10-12): the staged item reads as a compact
                                   pill — play + duration when THIS SESSION holds the take (the kept
                                   Blob URL), else the size as plain text (uploaded rows and post-reload
                                   rows have no session entry — served playback is the named follow-up).
                                   The row's trailing remove × is the single close; the clear-file × is
                                   retired, and Record again lives on the review panel, never here. *@
                                @if (_sessionMedia.TryGetValue(row, out var session))
                                {
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Class="cq-media-play"
                                                  Id="@($"{Id}-play-{index}")"
                                                  Title="@row.FileName"
                                                  OnClick="@(() => ToggleReviewAsync(row))">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Play())" />
                                        <span class="cq-media-pill-text">@FormatDuration(session.DurationSeconds)</span>
                                    </FluentButton>
                                }
                                else
                                {
                                    <span class="cq-instruction-file" title="@row.FileName">
                                        @AttachmentUploadPolicy.FormatFileSize(row.FileSize)
                                    </span>
                                }
                            }
                            break;
                    }

                    @if (!ReadOnly)
                    {
                        @* Q4(b)/AC-14: Text and Link rows are edited THROUGH the dialog, so the affordance
                           that opens it lives here and the decision to open one stays with the host (the
                           component holds no dialog). Media rows keep the stage/clear flow instead — the
                           file IS their value, so there is nothing a form could seed (grill Q3). *@
                        @if (EditingMode == RowEditingMode.Dialog && !row.HasMedia)
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                          Id="@($"{Id}-edit-{index}")"
                                          OnClick="@(() => EditRowRequested.InvokeAsync(row))"
                                          IconStart="@FluentIcons.Edit"
                                          aria-label="Edit this material" />
                        }

                        <FluentButton Appearance="Appearance.Stealth"
                                      Id="@($"{Id}-remove-{index}")"
                                      OnClick="@(() => RemoveAsync(row))"
                                      aria-label="Remove instruction">×</FluentButton>
                    }
                </li>
                @* The recorder no longer renders beside its row (round-recorder-takeover, owner
                   2026-10-12): an open recorder TAKES OVER the whole container — see the branch at
                   the top of .cq-instructions — and carries its close affordance in its own header.
                   The cramped sibling-<li> slot this replaces was the defect being fixed. *@
            }
        </ul>
    }

    @if (!ReadOnly && ShowAddButton)
    {
        <div class="cq-instruction-actions">
            <FluentButton Appearance="Appearance.Outline"
                          Id="@($"{Id}-add")"
                          IconStart="@FluentIcons.Add"
                          OnClick="AddAsync">
                Add instruction
            </FluentButton>
        </div>
    }

    @if (_error is not null)
    {
        <p class="cq-instruction-error" id="@($"{Id}-error")">@_error</p>
    }
    }
</div>

@code {
    /// <summary>The container id, and the stem every inner id is built from — the bUnit/page seam.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    /// <summary>The rows being edited — the HOST's list (a question's or the assignment's), so the
    /// edit lands where the host projects the payload from.</summary>
    [Parameter, EditorRequired] public List<InstructionEditorRow> Rows { get; set; } = default!;

    /// <summary>The host's staging call: content + name/type/size in, the staged metadata out (null
    /// when it refused). Null here means the host offers no uploads in this context — the media kinds
    /// then report that instead of rendering a file input that could never succeed.</summary>
    [Parameter] public StageInstructionMediaAsync? StageMediaAsync { get; set; }

    /// <summary>Raised after any mutation, so the host can re-render counts and its submit gate.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>View mode (the authoring page's <c>IsReadOnly</c>): the blocks render as read-only text
    /// with no add/remove affordances — the same posture the Instructions textarea takes.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Whether this component renders its own "Add instruction" button. The QUESTION DIALOG
    /// keeps it (default); the authoring page sets it false because the section supplies the kebab
    /// menu instead (round grill Q1) — a visibility seam, so the dialog's rendering is untouched.</summary>
    [Parameter] public bool ShowAddButton { get; set; } = true;

    /// <summary>How a Text/Link row is edited (round <c>material-row-editing</c>). <see
    /// cref="RowEditingMode.Inline"/> is the default because the QUESTION DIALOG host cannot open a
    /// dialog of its own (no nesting — dialog-ui §4); the authoring page states
    /// <see cref="RowEditingMode.Dialog"/>. Two behaviours on purpose, and the parameter is where
    /// that reason is written down.
    /// <para>Deliberately NOT named after the enum: an attribute called <c>RowEditingMode</c> whose
    /// value expression starts with the same identifier is legal markup but ambiguous to read — and
    /// a mismatched name fails only at RUNTIME (Blazor passes unknown attributes through as HTML,
    /// then throws during the render), which is exactly the defect this round's page test caught.</para></summary>
    [Parameter] public RowEditingMode EditingMode { get; set; } = RowEditingMode.Inline;

    /// <summary>Raised when a row's edit affordance is activated in <see
    /// cref="RowEditingMode.Dialog"/> mode. The host owns the dialog (this component stays
    /// presentational), and hands the result back through <see cref="ApplyEditAsync"/> — so the list
    /// remains the single writer of its rows.</summary>
    [Parameter] public EventCallback<InstructionEditorRow> EditRowRequested { get; set; }

    /// <summary>Owner rework (2026-10-12): raised whenever a recorder opens or closes, carrying the
    /// open state — the page's own materials dropzone sits OUTSIDE this component and must hide while
    /// the takeover shows. No-op when unwired (the question dialog has no such sibling surface).</summary>
    [Parameter] public EventCallback<bool> RecorderStateChanged { get; set; }

    private bool _staging;
    private string? _error;

    /// <summary>D3/D10 (recording-materials): the row whose inline <see cref="RecorderPanel"/> is open —
    /// null when none is. Only one recorder is ever open at a time (one camera/mic), so toggling a new
    /// row's recorder closes the previous one.</summary>
    private InstructionEditorRow? _recordingRow;

    /// <summary>Owner rework (2026-10-12, round-recorder-takeover): the row the RECORD ACTION itself
    /// appended (kebab "Record Audio"/"Record Video") — null when the open recorder was toggled onto a
    /// pre-existing row. Cancel drops this row while it is still unstaged so no recording residue is
    /// left behind; a committed take stages it first, so a surviving row is never lost.</summary>
    private InstructionEditorRow? _recorderCreatedRow;

    /// <summary>Owner pill rework (2026-10-12): per-row session media — the Blob URL of the take this
    /// circuit recorded (never persisted; the served-playback endpoint is the named follow-up) plus
    /// its probed duration. Uploaded rows and post-reload rows have no entry, so no play affordance.</summary>
    private readonly Dictionary<InstructionEditorRow, SessionMedia> _sessionMedia = new();

    private sealed record SessionMedia(string Url, double? DurationSeconds);

    /// <summary>The seed handed to the panel when the play pill reopens a take's preview player.</summary>
    private RecorderPanel.ReviewSeed? _reviewSeed;

    /// <summary>The list's tiny media module (revoke only) — owned and disposed here (use-js-interop).</summary>
    private const string ModulePath =
        "./_content/SchoolCollab.Assignments.Application/Components/Pages/Assignments/InstructionEditorList.razor.js";

    private IJSObjectReference? _mediaModule;

    /// <summary>The pill's text: the take's duration when known, else a plain "Play" label.</summary>
    private static string FormatDuration(double? seconds)
    {
        if (seconds is null or < 0)
        {
            return "Play";
        }

        var s = (int)Math.Round(seconds.Value);
        return $"{s / 60}:{s % 60:D2}";
    }

    /// <summary>The row's first field, captured per row during render — the LAST assignment wins, so
    /// after an append this points at the new row's first field (AC-2's focus target).</summary>
    private FluentTextField? _focusTarget;
    private bool _focusPending;

    /// <summary>D2/D3 (spec instructional-materials): the host's menu appends a row of the chosen kind
    /// straight to the form model — no confirmation step — and focuses that row's first field. Called
    /// through <c>@ref</c> by the page's kebab; the dialog reaches the same path via <see cref="AddAsync"/>.</summary>
    public async Task AddRowAsync(InstructionKindDto kind)
    {
        Rows.Add(new InstructionEditorRow { Kind = kind });
        _focusPending = true;
        StateHasChanged();
        await Changed.InvokeAsync();
    }

    /// <summary>D2/D3 (recording-materials): appends a MEDIA row of the chosen kind and opens its inline
    /// recorder in one step — the page's "Record Audio"/"Record Video" kebab action calls this. Reuses
    /// <see cref="AddRowAsync"/> to append + focus, then opens the recorder on that just-added row.</summary>
    public async Task AddRowWithRecorderAsync(InstructionKindDto kind)
    {
        // Owner rework (2026-10-12): moving the recorder off an earlier record-action placeholder
        // drops that placeholder (still unstaged) — switching kebab actions must not accumulate
        // ghost rows. AddRowAsync fires Changed, which also covers the removal to the host.
        DropOrphanedRecorderRow();
        // Hold verdict 2026-10-12 (finding 2): this opens a FRESH recorder — a pill review left open
        // must not seed it. Every recorder-open path clears the seed (CloseRecorder/OnRecordedAsync
        // already did); without this, the kebab panel reopened into the previous take's player.
        _reviewSeed = null;
        await AddRowAsync(kind);
        _recordingRow = Rows.Count > 0 ? Rows[^1] : null;
        _recorderCreatedRow = _recordingRow;
        StateHasChanged();
        await NotifyRecorderStateAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _focusTarget is not null)
        {
            _focusPending = false;
            // FocusAsync is void in this FluentUI version (the ResourcesSection:365 precedent).
            _focusTarget.FocusAsync();
        }

        return Task.CompletedTask;
    }

    /// <summary>Appends a Text block — the method the question dialog and the page's own tests call.</summary>
    public Task AddAsync() => AddRowAsync(InstructionKindDto.Text);

    /// <summary>Writes a dialog result back onto an EXISTING row (the row-edit path, AC-14). The page
    /// never mutates a row behind this component — the list stays the single writer of its rows (Q2) —
    /// so the host hands the confirmed result here. Also the bUnit seam for the write-back, because the
    /// dialog itself is the page's to open.</summary>
    public async Task ApplyEditAsync(InstructionEditorRow row, MaterialEditResult result)
    {
        row.Kind = result.Kind;
        row.Title = result.Title;
        row.Text = result.Body;
        row.Url = result.Url;
        StateHasChanged();
        await Changed.InvokeAsync();
    }

    /// <summary>Grill Q1 (round material-row-editing): the glyph per kind. Text and Link ARE the kebab's
    /// own two glyphs, so the menu that adds a row and the row itself cannot drift; the media kinds take
    /// the FluentUI glyph of the thing itself. An unknown kind falls back to Info rather than rendering
    /// an empty box — the row still says something true.</summary>
    private static Icon KindIcon(InstructionKindDto kind) => kind switch
    {
        InstructionKindDto.Text => FluentIcons.TextDescription,
        InstructionKindDto.Url => FluentIcons.Link,
        InstructionKindDto.Audio => FluentIcons.MusicNote2,
        InstructionKindDto.Video => FluentIcons.Video,
        InstructionKindDto.Image => FluentIcons.Image,
        _ => FluentIcons.Info,
    };

    public async Task RemoveAsync(InstructionEditorRow row)
    {
        await RevokeSessionMediaAsync(row);
        if (Rows.Remove(row))
        {
            StateHasChanged();
            await Changed.InvokeAsync();
        }
    }

    /// <summary>Drops the staged file from a media row, keeping its kind so the author can pick
    /// another file (or switch the kind) without losing the intent.</summary>
    public async Task ClearMediaAsync(InstructionEditorRow row)
    {
        // The button that reaches this seam is retired (owner pill rework, 2026-10-12 — one close per
        // row), but the seam stays and now also drops the row's session media entry.
        await RevokeSessionMediaAsync(row);
        row.FileName = null;
        row.ContentType = null;
        row.FileSize = 0;
        row.StoragePath = null;
        StateHasChanged();
        await Changed.InvokeAsync();
    }

    /// <summary>One media instruction row carries exactly one staged file, but FluentInputFile reports
    /// its completions as a set — so the (capped-to-one) set is drained in order.</summary>
    private async Task OnFileUploadedAsync(
        InstructionEditorRow row, IEnumerable<FluentInputFileEventArgs> args)
    {
        foreach (var file in args)
        {
            await StageMediaFileAsync(row, file.Stream, file.Name, file.ContentType, file.Size);
        }
    }

    /// <summary>The testable seam (the <c>ResourcesSection.StageFileAsync</c> precedent): the client
    /// pre-check, the host's staging call, then the row filled with what came back. bUnit drives this
    /// directly, because the FluentInputFile JS pipeline is not up in tests.</summary>
    public async Task StageMediaFileAsync(
        InstructionEditorRow row, Stream content, string fileName, string contentType, long fileSize)
    {
        if (StageMediaAsync is null)
        {
            Fail("Attaching a file is not available here.");
            return;
        }

        if (_staging)
        {
            Fail($"'{fileName}' is still uploading — please wait until the current upload finishes, then try again.");
            return;
        }

        // One allow-list for every kind: it carries the media extensions (round Q1), so an audio or
        // video instruction file passes the same pre-check as a document or an image.
        var clientError = AttachmentUploadPolicy.Validate(fileName, fileSize);
        if (clientError is not null)
        {
            Fail(clientError);
            return;
        }

        // D4/D5: the kind follows the FILE — the row the kebab opened is a placeholder for "whichever
        // media the author picks", and a document picked here is refused by the same named reason the
        // dropzone uses (never staged into a row that cannot represent it).
        var inferred = InstructionKindInference.ForFile(fileName, contentType);
        if (inferred is null)
        {
            Fail(InstructionKindInference.DocumentRefusal(fileName));
            return;
        }

        row.Kind = inferred.Value;

        _staging = true;
        try
        {
            var staged = await StageMediaAsync(row, content, fileName, contentType, fileSize);
            if (staged is null)
            {
                Fail($"'{fileName}' could not be attached — please try again.");
                return;
            }

            row.FileName = staged.FileName;
            row.ContentType = staged.ContentType;
            row.FileSize = staged.FileSize;
            row.StoragePath = staged.StoragePath;
            _error = null;
            StateHasChanged();
            await Changed.InvokeAsync();
        }
        finally
        {
            _staging = false;
        }
    }

    /// <summary>D3/D10 (recording-materials): opens/closes the inline <see cref="RecorderPanel"/> for a
    /// media row. One recorder at a time — toggling the same row closes it; toggling another row moves
    /// the recorder (releasing the previous camera/mic via the panel's own disposal).</summary>
    private Task ToggleRecorderAsync(InstructionEditorRow row)
    {
        _recordingRow = _recordingRow == row ? null : row;
        // Toggling targets the author's own row — never the record action's placeholder — so Cancel
        // must keep it (owner rework, 2026-10-12).
        _recorderCreatedRow = null;
        // Hold verdict 2026-10-12 (finding 2): same invariant as AddRowWithRecorderAsync — an open
        // recorder is never a seeded review. Unreachable with a stale seed today (rows are hidden
        // during the takeover), but the open path owns the clear, not the render graph.
        _reviewSeed = null;
        _error = null;
        StateHasChanged();
        return NotifyRecorderStateAsync();
    }

    /// <summary>Round-recorder-takeover Q5 + owner rework (2026-10-12): the panel's Cancel — the
    /// takeover closes and the list body (rows, dropzone, add button) is restored. The row the record
    /// action itself appended is dropped while still unstaged (no recording residue in the list); a
    /// toggled-open pre-existing row and any staged row survive. The discarded take never reaches
    /// staging.</summary>
    private async Task CloseRecorder()
    {
        _recordingRow = null;
        _reviewSeed = null;
        var removed = DropOrphanedRecorderRow();
        _error = null;
        StateHasChanged();
        if (removed)
        {
            await Changed.InvokeAsync();
        }

        await NotifyRecorderStateAsync();
    }

    /// <summary>Owner rework (2026-10-12): removes the record action's own placeholder row while it is
    /// still unstaged. Never touches a pre-existing row (toggled open, not appended) and never a
    /// committed take's row (staged before Cancel can reach it). True when a row was removed.</summary>
    private bool DropOrphanedRecorderRow()
    {
        if (_recorderCreatedRow is not null && string.IsNullOrWhiteSpace(_recorderCreatedRow.StoragePath))
        {
            Rows.Remove(_recorderCreatedRow);
            _recorderCreatedRow = null;
            return true;
        }

        _recorderCreatedRow = null;
        return false;
    }

    /// <summary>Signals <see cref="RecorderStateChanged"/> with the current open state (owner rework,
    /// 2026-10-12 — the host hides its own competing surfaces, e.g. the page's materials dropzone).</summary>
    private Task NotifyRecorderStateAsync() => RecorderStateChanged.InvokeAsync(_recordingRow is not null);

    /// <summary>Owner pill rework (2026-10-12): the play pill reopens the staged take's session Blob in
    /// the SAME review panel (player + Record again) — one takeover at a time, like the recorder.
    /// Closing keeps the session entry, so the pill can reopen it; only removal revokes the URL.</summary>
    private async Task ToggleReviewAsync(InstructionEditorRow row)
    {
        if (_recordingRow == row)
        {
            await CloseRecorder();
            return;
        }

        if (_sessionMedia.TryGetValue(row, out var session))
        {
            _recordingRow = row;
            _reviewSeed = new RecorderPanel.ReviewSeed(session.Url, row.FileName ?? "recording", row.FileSize);
            _error = null;
            StateHasChanged();
            await NotifyRecorderStateAsync();
        }
    }

    /// <summary>Owner pill rework (2026-10-12): the list's tiny media module (revoke only). The import
    /// is INSIDE the guard — a missing/404 module (e.g. a stale session that predates this asset) must
    /// never blow up the row operation the revoke serves; the browser purges Blob URLs on teardown.</summary>
    private async Task RevokeMediaUrlAsync(string url)
    {
        try
        {
            _mediaModule ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _mediaModule.InvokeVoidAsync("revokeMediaUrl", url);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    /// <summary>Drops a row's session media entry and revokes its Blob URL — a discarded take must not
    /// leak memory. No-op for rows without an entry (uploaded / post-reload).</summary>
    private async Task RevokeSessionMediaAsync(InstructionEditorRow row)
    {
        if (_sessionMedia.Remove(row, out var session))
        {
            await RevokeMediaUrlAsync(session.Url);
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        // Hold verdict 2026-10-12 (finding 4): the session-held Blob URLs are this list's to revoke on
        // teardown too — dialog close / in-page navigation previously leaked every recorded take's URL
        // (RemoveAsync/ClearMediaAsync revoke only their own row's entry). Best-effort (RevokeMediaUrlAsync
        // guards import + call as one), and BEFORE the module goes away.
        foreach (var session in _sessionMedia.Values)
        {
            await RevokeMediaUrlAsync(session.Url);
        }

        _sessionMedia.Clear();
        if (_mediaModule is not null)
        {
            try { await _mediaModule.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _mediaModule = null;
        }
    }

    /// <summary>D3 (recording-materials): the recorder's commit seam. The recorded take (delivered as a
    /// Stream via the panel's hidden InputFile) stages through the SAME <see cref="StageMediaFileAsync"/>
    /// path an uploaded media file takes, so the row is filled identically and the list stays the single
    /// writer of its rows. The recorder then closes. Public by the owner pill rework (2026-10-12) as the
    /// seam bUnit drives directly (the <c>StageMediaFileAsync</c> precedent) — and it now keeps the
    /// take's session Blob URL + duration for the row's play pill.</summary>
    public async Task OnRecordedAsync(InstructionEditorRow row, RecorderPanel.RecordedMedia media)
    {
        if (StageMediaAsync is null)
        {
            Fail("Recording is not available here.");
            return;
        }

        _recordingRow = null;
        _reviewSeed = null;
        // The committed take's row is staged now — it survives as a real row (owner rework, 2026-10-12).
        _recorderCreatedRow = null;
        if (media.PreviewUrl is not null)
        {
            if (_sessionMedia.TryGetValue(row, out var previous))
            {
                await RevokeMediaUrlAsync(previous.Url);
            }

            _sessionMedia[row] = new SessionMedia(media.PreviewUrl, media.DurationSeconds);
        }

        await NotifyRecorderStateAsync();
        await StageMediaFileAsync(row, media.Content, media.FileName, media.ContentType, media.FileSize);
    }

    /// <summary>Sets the failure line and re-renders. A method invoked directly (bUnit, a test seam)
    /// does not get the render an event handler would, so every state change renders explicitly —
    /// which is also what lets the page/dialog re-render when they call these methods.</summary>
    private void Fail(string message)
    {
        _error = message;
        StateHasChanged();
    }
}

