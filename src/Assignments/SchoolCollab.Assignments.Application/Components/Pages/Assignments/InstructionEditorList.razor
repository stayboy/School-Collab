@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@using SchoolCollab.Assignments.Application.Helpers
@inject IJSRuntime JS
@implements IAsyncDisposable

@* QR-5 (spec §5.2/§5.6, owner 2026-10-09): the shared INSTRUCTION editor — one shape, two owners
   (the assignment's own blocks and each question's). Inline by construction: the dialog-ui rule
   forbids a nested dialog, so this is a plain presentational panel, and it holds no API client — the
   host supplies staging as StageMediaAsync, exactly as the attachments flow stages at selection. *@
<div class="cq-instructions@(_recordingRow is not null ? " cq-instructions-recording" : string.Empty)" id="@Id">
    @if (_recordingRow is not null)
    {
        @* Round-recorder-takeover (owner 2026-10-12, grill Q2/Q3/Q5): while a recorder is open it
           takes over the WHOLE container — the rows, dropzone, add button and error line are
           suppressed and the panel's own header carries the close affordance (labeled Cancel). The
           placeholder row stays in Rows untouched: cancel discards the take, never the row. *@
        <div class="cq-instruction-recorder" id="@($"{Id}-recorder-takeover")">
            @* Hold verdict 2026-10-12 (finding 2): @key on the recording row — without it, replacing an
               open pill review with a new recorder REUSES this panel instance, whose reopened-Review
               state (old take's player + Record again) survives even after the seed is cleared. The
               key gives the "a new instance reopens" semantics the Seed contract already assumed (see
               RecorderPanel.OnParametersSet); the discarded instance's seeded URL is safe from its
               teardown revoke by the panel's own ownership guard. *@
            <RecorderPanel @key="_recordingRow"
                           Id="@($"{Id}-recorder-{Rows.IndexOf(_recordingRow)}")"
                           IsVideo="@(_recordingRow.Kind == InstructionKindDto.Video)"
                           Seed="@_reviewSeed"
                           OnRecorded="@(media => OnRecordedAsync(_recordingRow!, media))"
                           OnClose="CloseRecorder">
                @* Owner request 2026-10-15 (grill Q10-Q12): on a SEEDED review the metadata control
                   sits BESIDE the recorder title and reads as a native hyperlink — the previous
                   stealth button floated below the panel, outside the header, and did not look like
                   the admin UI's links. It renders UNCONDITIONALLY on a seeded review (Q11): the
                   takeover suppresses the rows, so the readout — the only other route to the dialog —
                   is unreachable, and a take with no note would otherwise have no way to gain one.
                   The condition lives INSIDE the fragment: Razor only recognizes a named child
                   element as a direct child, so an @if around it is rejected (RZ9996). *@
                <HeaderAction>
                    @if (_reviewSeed is not null)
                    {
                        <FluentLink Appearance="LinkAppearance.Default"
                                      Href="#"
                                      Id="@($"{Id}-review-edit")"
                                      Class="cq-review-edit"
                                      OnClick="@(() => OnReviewMetadataAsync(_recordingRow!))">
                            @EditNoteLabel
                        </FluentLink>
                    }
                </HeaderAction>
            </RecorderPanel>
        </div>
    }
    else
    {
    @if (Rows.Count == 0)
    {
        <p class="cq-instructions-empty" id="@($"{Id}-empty")">No instructions yet.</p>
    }
    else
    {
        <ul class="cq-instruction-rows" id="@($"{Id}-rows")">
            @foreach (var (row, index) in Rows.Select((r, i) => (r, i)))
            {
                <li class="cq-instruction-row" @key="row">
                    @* D12/§4 + grill Q1/Q2 (round material-row-editing): the kind reads as an ICON
                       befitting the material — the per-row kind DROPDOWN was the replaced pattern, and
                       its word is gone too. The word survives only as the wrapper's accessible name, so
                       a screen reader still hears "Text": an icon-only indicator with no name would be
                       an a11y regression, and the tooltip keeps hover honest. *@
                    <span class="cq-instruction-kind cq-instruction-kind-readonly"
                          role="img"
                          aria-label="@EnumHelper.GetDescription(row.Kind)"
                          title="@EnumHelper.GetDescription(row.Kind)">
                        <FluentIcon Value="@KindIcon(row.Kind)" />
                    </span>

                    @switch (row.Kind)
                    {
                        case InstructionKindDto.Text:
                            @if (EditingMode == RowEditingMode.Dialog)
                            {
                                @* Q4(b) + owner refinement (2026-10-10): the row is IDENTIFIED, not read —
                                   an icon plus the material's NAME. A Text material's name is its title; the
                                   body is what the dialog is for, which is where it is read and edited
                                   (AC-14 amended to match). *@
                                <span class="cq-instruction-readout cq-instruction-readout-payload" id="@($"{Id}-title-{index}")">@row.Title</span>
                            }
                            else
                            {
                                @* D6/D10: a Text material is TITLED (the title is required, the body optional) —
                                   the title is the row's first field, so it is also the focus target (AC-2). *@
                                <FluentTextInput @ref="_focusTarget"
                                                 @bind-Value="row.Title"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="Name this material"
                                                 class="cq-instruction-title" />
                                <FluentTextInput @bind-Value="row.Text"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="What the student should read or do"
                                                 class="cq-instruction-payload" />
                            }
                            break;

                        case InstructionKindDto.Url:
                            @if (EditingMode == RowEditingMode.Dialog)
                            {
                                @* Q4(b) + the same identification rule for a Link: its LABEL names it, and a
                                   link with no label is named by its target — never a blank row (the ward
                                   card's own title ?? url rule, D11). *@
                                <span class="cq-instruction-readout cq-instruction-readout-payload" id="@($"{Id}-label-{index}")">@(string.IsNullOrWhiteSpace(row.Title) ? row.Url : row.Title)</span>
                            }
                            else
                            {
                                <FluentTextInput @ref="_focusTarget"
                                                 @bind-Value="row.Url"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="https://…"
                                                 class="cq-instruction-payload" />
                                @* D7: a Link's title is an optional LABEL — never prose (D10). *@
                                <FluentTextInput @bind-Value="row.Title"
                                                 ReadOnly="@ReadOnly"
                                                 Placeholder="Label (optional)"
                                                 class="cq-instruction-title" />
                            }
                            break;

                        default:
                            @* Audio · Video · Image: a staged file (stage-at-selection). *@
                            @if (string.IsNullOrWhiteSpace(row.StoragePath))
                            {
                                @* D3/D10 (recording-materials): the Record affordance sits beside the upload
                                   control in the SAME capture slot — a recording is just a second input path
                                   to the same staged media row. Toggling it expands the inline RecorderPanel;
                                   its OnRecorded stages through the same StageMediaFileAsync seam an upload
                                   uses, so the list stays the single writer of its rows. *@
                                <div class="cq-instruction-capture" id="@($"{Id}-capture-{index}")">
                                    <FluentInputFile Mode="InputFileMode.Stream"
                                                     MaximumFileCount="1"
                                                     Accept="@AttachmentUploadPolicy.AcceptExtensions"
                                                     MaximumFileSize="@AttachmentUploadPolicy.MaxFileSizeBytes"
                                                     OnCompleted="@(args => OnFileUploadedAsync(row, args))" />
                                    @if (!ReadOnly && StageMediaAsync is not null)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Default"
                                                      Id="@($"{Id}-record-{index}")"
                                                      IconStart="@(row.Kind == InstructionKindDto.Audio ? FluentIcons.Mic : new Icons.Regular.Size20.Video())"
                                                      OnClick="@(() => ToggleRecorderAsync(row))">
                                            Record
                                        </FluentButton>
                                    }
                                </div>
                            }
                            else
                            {
                                @* Round media-pill-listing (C1/Q3 + C2/Q10/Q13): the staged item reads
                                   exactly like a Text row — glyph · READOUT · action · trailing ×. The
                                   readout is the EDIT affordance (click opens the metadata dialog on the
                                   Dialog host; the Inline host expands the fields on the row below); the
                                   play button holds the action slot; the pill and its size text are gone.
                                   The native `title` tooltip carries the file name. *@
                                <span class="cq-instruction-readout cq-media-readout"
                                      id="@($"{Id}-title-{index}")"
                                      title="@row.FileName"
                                      @onclick="@(() => OnReadoutClickedAsync(row))">@MediaReadout(row)</span>

                                @if (EditingMode == RowEditingMode.Inline && ReferenceEquals(_inlineMediaRow, row))
                                {
                                    @* Q12 (owner-pinned): the question dialog host cannot nest a dialog, so
                                       there the same optional Title + Description pair edits INLINE on the row
                                       (the pattern Text/Link rows already use in this mode). *@
                                    <FluentTextInput @bind-Value="row.Title"
                                                     ReadOnly="@ReadOnly"
                                                     Placeholder="Title (optional)"
                                                     class="cq-instruction-title" />
                                    <FluentTextInput @bind-Value="row.Text"
                                                     ReadOnly="@ReadOnly"
                                                     Placeholder="Description (optional)"
                                                     class="cq-instruction-payload" />
                                }
                            }
                            break;
                    }

                    @if (!ReadOnly)
                    {
                        @* Q4(b)/AC-14: Text and Link rows are edited THROUGH the dialog, so the affordance
                           that opens it lives here and the decision to open one stays with the host (the
                           component holds no dialog). Media rows reach the same dialog through their
                           READOUT instead (round media-pill-listing C2), never through a pencil. *@
                        @if (EditingMode == RowEditingMode.Dialog && !row.HasMedia)
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                          Id="@($"{Id}-edit-{index}")"
                                          OnClick="@(() => EditRowRequested.InvokeAsync(row))"
                                          IconStart="@FluentIcons.Edit"
                                          aria-label="Edit this material" />
                        }

                        @* Round media-pill-listing (C1/Q3): a staged Audio/Video row holds PLAY in the
                           action slot where Text/Link hold their pencil — play is purely PREVIEW (it
                           never opens the metadata dialog; the readout does). Image rows keep their
                           standard shape (Q4/Q13). *@
                        @if (row.HasMedia && row.Kind != InstructionKindDto.Image && !string.IsNullOrWhiteSpace(row.StoragePath))
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                          Id="@($"{Id}-play-{index}")"
                                          IconStart="@(new Icons.Regular.Size20.Play())"
                                          aria-label="Play"
                                          Title="@row.FileName"
                                          OnClick="@(() => PlayMediaAsync(row))" />
                        }

                        @* Owner request 2026-10-15 (grill Q13a): an IMAGE row has no recorder and no
                           review (play is Audio/Video only), so its metadata control is the row-level
                           mirror of the review's header link — same hypertext look, same label. The
                           READOUT stays data; this is the action. *@
                        @if (row.HasMedia && row.Kind == InstructionKindDto.Image && !string.IsNullOrWhiteSpace(row.StoragePath))
                        {
                            <FluentLink Appearance="LinkAppearance.Default"
                                          Href="#"
                                          Id="@($"{Id}-edit-note-{index}")"
                                          Class="cq-instruction-edit-note"
                                          OnClick="@(() => OnReadoutClickedAsync(row))">
                                @EditNoteLabel
                            </FluentLink>
                        }

                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                      Id="@($"{Id}-remove-{index}")"
                                      OnClick="@(() => RemoveAsync(row))"
                                      aria-label="Remove instruction">×</FluentButton>
                    }
                </li>
                @* The recorder no longer renders beside its row (round-recorder-takeover, owner
                   2026-10-12): an open recorder TAKES OVER the whole container — see the branch at
                   the top of .cq-instructions — and carries its close affordance in its own header.
                   The cramped sibling-<li> slot this replaces was the defect being fixed. *@
            }
        </ul>
    }

    @if (!ReadOnly && ShowAddButton)
    {
        <div class="cq-instruction-actions">
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Id="@($"{Id}-add")"
                          IconStart="@FluentIcons.Add"
                          OnClick="AddAsync">
                Add instruction
            </FluentButton>
        </div>
    }

    @if (_error is not null)
    {
        <p class="cq-instruction-error" id="@($"{Id}-error")">@_error</p>
    }
    }
</div>

@code {
    /// <summary>The container id, and the stem every inner id is built from — the bUnit/page seam.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    /// <summary>The rows being edited — the HOST's list (a question's or the assignment's), so the
    /// edit lands where the host projects the payload from.</summary>
    [Parameter, EditorRequired] public List<InstructionEditorRow> Rows { get; set; } = default!;

    /// <summary>The host's staging call: content + name/type/size in, the staged metadata out (null
    /// when it refused). Null here means the host offers no uploads in this context — the media kinds
    /// then report that instead of rendering a file input that could never succeed.</summary>
    [Parameter] public StageInstructionMediaAsync? StageMediaAsync { get; set; }

    /// <summary>Round <c>media-pill-listing</c> (Q2/Q9): the host's served-playback call — fetches a
    /// staged media row's bytes through the teacher-authed range-enabled route, so an uploaded or
    /// reloaded row (no session Blob) can still play. Null here means the host cannot fetch (the row
    /// then names that rather than offering a dead play button). The list stays client-free.</summary>
    [Parameter] public LoadInstructionMediaAsync? LoadInstructionMediaAsync { get; set; }

    /// <summary>Raised after any mutation, so the host can re-render counts and its submit gate.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>View mode (the authoring page's <c>IsReadOnly</c>): the blocks render as read-only text
    /// with no add/remove affordances — the same posture the Instructions textarea takes.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Whether this component renders its own "Add instruction" button. The QUESTION DIALOG
    /// keeps it (default); the authoring page sets it false because the section supplies the kebab
    /// menu instead (round grill Q1) — a visibility seam, so the dialog's rendering is untouched.</summary>
    [Parameter] public bool ShowAddButton { get; set; } = true;

    /// <summary>How a Text/Link row is edited (round <c>material-row-editing</c>). <see
    /// cref="RowEditingMode.Inline"/> is the default because the QUESTION DIALOG host cannot open a
    /// dialog of its own (no nesting — dialog-ui §4); the authoring page states
    /// <see cref="RowEditingMode.Dialog"/>. Two behaviours on purpose, and the parameter is where
    /// that reason is written down.
    /// <para>Deliberately NOT named after the enum: an attribute called <c>RowEditingMode</c> whose
    /// value expression starts with the same identifier is legal markup but ambiguous to read — and
    /// a mismatched name fails only at RUNTIME (Blazor passes unknown attributes through as HTML,
    /// then throws during the render), which is exactly the defect this round's page test caught.</para></summary>
    [Parameter] public RowEditingMode EditingMode { get; set; } = RowEditingMode.Inline;

    /// <summary>Raised when a row's edit affordance is activated in <see
    /// cref="RowEditingMode.Dialog"/> mode. The host owns the dialog (this component stays
    /// presentational), and hands the result back through <see cref="ApplyEditAsync"/> — so the list
    /// remains the single writer of its rows.</summary>
    [Parameter] public EventCallback<InstructionEditorRow> EditRowRequested { get; set; }

    /// <summary>Owner rework (2026-10-12): raised whenever a recorder opens or closes, carrying the
    /// open state — the page's own materials dropzone sits OUTSIDE this component and must hide while
    /// the takeover shows. No-op when unwired (the question dialog has no such sibling surface).</summary>
    [Parameter] public EventCallback<bool> RecorderStateChanged { get; set; }

    private bool _staging;
    private string? _error;

    /// <summary>D3/D10 (recording-materials): the row whose inline <see cref="RecorderPanel"/> is open —
    /// null when none is. Only one recorder is ever open at a time (one camera/mic), so toggling a new
    /// row's recorder closes the previous one.</summary>
    private InstructionEditorRow? _recordingRow;

    /// <summary>Owner rework (2026-10-12, round-recorder-takeover): the row the RECORD ACTION itself
    /// appended (kebab "Record Audio"/"Record Video") — null when the open recorder was toggled onto a
    /// pre-existing row. Cancel drops this row while it is still unstaged so no recording residue is
    /// left behind; a committed take stages it first, so a surviving row is never lost.</summary>
    private InstructionEditorRow? _recorderCreatedRow;

    /// <summary>Round <c>media-pill-listing</c> (Q12, owner-pinned): the staged media row whose
    /// optional Title/Description pair is expanded INLINE on the row — the Inline-mode host (the
    /// question dialog) cannot nest the metadata dialog, so its readout click expands the fields here.
    /// Null when no row is being edited inline.</summary>
    private InstructionEditorRow? _inlineMediaRow;

    /// <summary>Round <c>media-pill-listing</c> (C2/Q12): a recorded take handed over by the panel on
    /// the Dialog-mode host — the host's own reference to it while its metadata dialog is open, staged
    /// only when the confirmed <see cref="MaterialEditResult"/> comes back through
    /// <see cref="ApplyEditAsync"/>. A cancelled dialog keeps it (AC-4): the take stays uncommitted
    /// with the review, and this is the one place that revokes its Blob URL when the review is
    /// discarded — <see cref="DiscardPendingRecordingAsync"/> on close or teardown. Its
    /// <c>Content</c> is this list's OWN buffer, materialised by <see cref="OnRecordedAsync"/> before
    /// the dialog popped (the panel hands over a LIVE browser-file stream, and a pending JS data
    /// stream left across that round-trip wedges the circuit) — so the list, and only the list,
    /// disposes it.</summary>
    private PendingRecording? _pendingRecording;

    private sealed record PendingRecording(InstructionEditorRow Row, RecorderPanel.RecordedMedia Media);

    /// <summary>Recording materials (round <c>media-pill-listing</c>, C1/Q8): per-row session media
    /// — the Blob URL of the take this circuit recorded (never persisted) or of the bytes just served
    /// through the teacher route, plus the take's probed duration. The list owns every URL it enters
    /// here and revokes it exactly once (row remove / re-commit / DisposeAsync).</summary>
    private readonly Dictionary<InstructionEditorRow, SessionMedia> _sessionMedia = new();

    private sealed record SessionMedia(string Url, double? DurationSeconds);

    /// <summary>The seed handed to the panel when a play (session take or served bytes) reopens a
    /// row's preview player.</summary>
    private RecorderPanel.ReviewSeed? _reviewSeed;

    /// <summary>The list's tiny media module (revoke + stream→Blob-URL + upload probe) — owned and
    /// disposed here (use-js-interop).</summary>
    private const string ModulePath =
        "./_content/SchoolCollab.Assignments.Application/Components/Pages/Assignments/InstructionEditorList.razor.js";

    private IJSObjectReference? _mediaModule;

    /// <summary>Round <c>media-pill-listing</c> (C1/Q7): the media readout — the duration `m:ss`, or
    /// `—:—` when unknown, prefixed by `[Title]` when the row is titled. An Image row reads `[Title]`
    /// when titled and today's size text when not (Q13). The row's persisted duration wins; a
    /// session-only probe (a served fetch's display-only re-probe) is the fallback.</summary>
    private string MediaReadout(InstructionEditorRow row)
    {
        if (row.Kind == InstructionKindDto.Image)
        {
            return string.IsNullOrWhiteSpace(row.Title)
                ? AttachmentUploadPolicy.FormatFileSize(row.FileSize)
                : $"[{row.Title}]";
        }

        var duration = FormatReadoutDuration(ReadoutDuration(row));
        return string.IsNullOrWhiteSpace(row.Title) ? duration : $"{duration} [{row.Title}]";
    }

    /// <summary>The readout's duration: the persisted column first, else a session probe's value.</summary>
    private int? ReadoutDuration(InstructionEditorRow row)
    {
        if (row.DurationSeconds is int persisted)
        {
            return persisted;
        }

        return _sessionMedia.TryGetValue(row, out var session) && session.DurationSeconds is double probed
            ? ToWholeSeconds(probed)
            : null;
    }

    /// <summary>`m:ss`, or the `—:—` fallback when the duration is unknown (a legacy row, a failed or
    /// impossible probe) — never a guess.</summary>
    private static string FormatReadoutDuration(int? seconds)
    {
        if (seconds is null or < 0)
        {
            return "—:—";
        }

        return $"{seconds.Value / 60}:{seconds.Value % 60:D2}";
    }

    /// <summary>A probed duration rounded to whole seconds; null for absent/invalid values.</summary>
    private static int? ToWholeSeconds(double? seconds) =>
        seconds is double d && !double.IsNaN(d) && d >= 0 ? (int)Math.Round(d) : null;

    /// <summary>Owner request 2026-10-15 (grill Q12/Q13; label SIMPLIFIED by the owner the same day):
    /// the media's metadata affordance reads "Edit Note". The first wording repeated the medium —
    /// "Recorded Audio (edit note)", "Image (edit note)", "Recorded Video (edit note)" — but the anchor
    /// already sits beside that medium's own readout, so the medium was noise; "Edit Note" says only what
    /// the control does. "Note" is the author's word for the optional Title + Description pair the shared
    /// dialog carries. One label serves both call sites: the review's header link (audio/video) and the
    /// row-level link an image row uses (Q13a — an image has no recorder and no review).</summary>
    private const string EditNoteLabel = "Edit Note";

    /// <summary>The row's first field, captured per row during render — the LAST assignment wins, so
    /// after an append this points at the new row's first field (AC-2's focus target).</summary>
    private FluentTextInput? _focusTarget;
    private bool _focusPending;

    /// <summary>D2/D3 (spec instructional-materials): the host's menu appends a row of the chosen kind
    /// straight to the form model — no confirmation step — and focuses that row's first field. Called
    /// through <c>@ref</c> by the page's kebab; the dialog reaches the same path via <see cref="AddAsync"/>.</summary>
    public async Task AddRowAsync(InstructionKindDto kind)
    {
        Rows.Add(new InstructionEditorRow { Kind = kind });
        _focusPending = true;
        StateHasChanged();
        await Changed.InvokeAsync();
    }

    /// <summary>D2/D3 (recording-materials): appends a MEDIA row of the chosen kind and opens its inline
    /// recorder in one step — the page's "Record Audio"/"Record Video" kebab action calls this. Reuses
    /// <see cref="AddRowAsync"/> to append + focus, then opens the recorder on that just-added row.</summary>
    public async Task AddRowWithRecorderAsync(InstructionKindDto kind)
    {
        // Owner rework (2026-10-12): moving the recorder off an earlier record-action placeholder
        // drops that placeholder (still unstaged) — switching kebab actions must not accumulate
        // ghost rows. AddRowAsync fires Changed, which also covers the removal to the host.
        DropOrphanedRecorderRow();
        // Hold verdict 2026-10-12 (finding 2): this opens a FRESH recorder — a pill review left open
        // must not seed it. Every recorder-open path clears the seed (CloseRecorder/OnRecordedAsync
        // already did); without this, the kebab panel reopened into the previous take's player.
        _reviewSeed = null;
        await AddRowAsync(kind);
        _recordingRow = Rows.Count > 0 ? Rows[^1] : null;
        _recorderCreatedRow = _recordingRow;
        StateHasChanged();
        await NotifyRecorderStateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _focusTarget is not null)
        {
            _focusPending = false;
            // FluentTextInput exposes its Element; focus it through ElementReference.FocusAsync().
            await _focusTarget.Element.FocusAsync();
        }
    }

    /// <summary>Appends a Text block — the method the question dialog and the page's own tests call.</summary>
    public Task AddAsync() => AddRowAsync(InstructionKindDto.Text);

    /// <summary>Writes a dialog result back onto an EXISTING row (the row-edit path, AC-14). The page
    /// never mutates a row behind this component — the list stays the single writer of its rows (Q2) —
    /// so the host hands the confirmed result here. Also the bUnit seam for the write-back, because the
    /// dialog itself is the page's to open.</summary>
    public async Task ApplyEditAsync(InstructionEditorRow row, MaterialEditResult result)
    {
        row.Kind = result.Kind;
        row.Title = result.Title;
        row.Text = result.Body;
        row.Url = result.Url;

        // Round media-pill-listing (C2/Q12): a confirmed metadata dialog on the recorder-commit path
        // also commits the stashed take — stage it exactly as a direct commit does, with the row's
        // fresh title/body (StageRecordedTakeAsync raises Changed and re-renders itself, and clears —
        // and releases — the pending take itself).
        if (_pendingRecording is { } pending && ReferenceEquals(pending.Row, row))
        {
            await StageRecordedTakeAsync(row, pending.Media);
            return;
        }

        StateHasChanged();
        await Changed.InvokeAsync();
    }

    /// <summary>Grill Q1 (round material-row-editing): the glyph per kind. Text and Link ARE the kebab's
    /// own two glyphs, so the menu that adds a row and the row itself cannot drift; the media kinds take
    /// the FluentUI glyph of the thing itself. An unknown kind falls back to Info rather than rendering
    /// an empty box — the row still says something true.</summary>
    private static Icon KindIcon(InstructionKindDto kind) => kind switch
    {
        InstructionKindDto.Text => FluentIcons.TextDescription,
        InstructionKindDto.Url => FluentIcons.Link,
        InstructionKindDto.Audio => FluentIcons.MusicNote2,
        InstructionKindDto.Video => FluentIcons.Video,
        InstructionKindDto.Image => FluentIcons.Image,
        _ => FluentIcons.Info,
    };

    public async Task RemoveAsync(InstructionEditorRow row)
    {
        if (ReferenceEquals(_inlineMediaRow, row))
        {
            _inlineMediaRow = null;
        }

        await RevokeSessionMediaAsync(row);
        if (Rows.Remove(row))
        {
            StateHasChanged();
            await Changed.InvokeAsync();
        }
    }

    /// <summary>Drops the staged file from a media row, keeping its kind so the author can pick
    /// another file (or switch the kind) without losing the intent.</summary>
    public async Task ClearMediaAsync(InstructionEditorRow row)
    {
        // The button that reaches this seam is retired (owner pill rework, 2026-10-12 — one close per
        // row), but the seam stays and now also drops the row's session media entry.
        await RevokeSessionMediaAsync(row);
        row.FileName = null;
        row.ContentType = null;
        row.FileSize = 0;
        row.StoragePath = null;
        StateHasChanged();
        await Changed.InvokeAsync();
    }

    /// <summary>One media instruction row carries exactly one staged file, but FluentInputFile reports
    /// its completions as a set — so the (capped-to-one) set is drained in order.</summary>
    private async Task OnFileUploadedAsync(
        InstructionEditorRow row, IEnumerable<FluentInputFileEventArgs> args)
    {
        foreach (var file in args)
        {
            await StageMediaFileAsync(row, file.Stream, file.Name, file.ContentType, file.Size);
        }
    }

    /// <summary>The testable seam (the <c>ResourcesSection.StageFileAsync</c> precedent): the client
    /// pre-check, the host's staging call, then the row filled with what came back. bUnit drives this
    /// directly, because the FluentInputFile JS pipeline is not up in tests.</summary>
    public async Task StageMediaFileAsync(
        InstructionEditorRow row, Stream content, string fileName, string contentType, long fileSize)
    {
        if (StageMediaAsync is null)
        {
            Fail("Attaching a file is not available here.");
            return;
        }

        if (_staging)
        {
            Fail($"'{fileName}' is still uploading — please wait until the current upload finishes, then try again.");
            return;
        }

        // One allow-list for every kind: it carries the media extensions (round Q1), so an audio or
        // video instruction file passes the same pre-check as a document or an image.
        var clientError = AttachmentUploadPolicy.Validate(fileName, fileSize);
        if (clientError is not null)
        {
            Fail(clientError);
            return;
        }

        // D4/D5: the kind follows the FILE — the row the kebab opened is a placeholder for "whichever
        // media the author picks", and a document picked here is refused by the same named reason the
        // dropzone uses (never staged into a row that cannot represent it).
        var inferred = InstructionKindInference.ForFile(fileName, contentType);
        if (inferred is null)
        {
            Fail(InstructionKindInference.DocumentRefusal(fileName));
            return;
        }

        row.Kind = inferred.Value;

        _staging = true;
        try
        {
            var staged = await StageMediaAsync(row, content, fileName, contentType, fileSize);
            if (staged is null)
            {
                Fail($"'{fileName}' could not be attached — please try again.");
                return;
            }

            row.FileName = staged.FileName;
            row.ContentType = staged.ContentType;
            row.FileSize = staged.FileSize;
            row.StoragePath = staged.StoragePath;
            _error = null;
            StateHasChanged();
            await Changed.InvokeAsync();

            // Round media-pill-listing (Q7, E.7): best-effort duration probe after a successful
            // stage — the File may still sit on the row's own <input type=file>. Fire-and-forget on
            // purpose: a probe that cannot read the input, or times out, must never delay or fail the
            // staging that already succeeded (the readout then falls back to "—:—").
            _ = ProbeUploadDurationAsync(row);
        }
        finally
        {
            _staging = false;
        }
    }

    /// <summary>D3/D10 (recording-materials): opens/closes the inline <see cref="RecorderPanel"/> for a
    /// media row. One recorder at a time — toggling the same row closes it; toggling another row moves
    /// the recorder (releasing the previous camera/mic via the panel's own disposal).</summary>
    private Task ToggleRecorderAsync(InstructionEditorRow row)
    {
        _recordingRow = _recordingRow == row ? null : row;
        // Toggling targets the author's own row — never the record action's placeholder — so Cancel
        // must keep it (owner rework, 2026-10-12).
        _recorderCreatedRow = null;
        // Hold verdict 2026-10-12 (finding 2): same invariant as AddRowWithRecorderAsync — an open
        // recorder is never a seeded review. Unreachable with a stale seed today (rows are hidden
        // during the takeover), but the open path owns the clear, not the render graph.
        _reviewSeed = null;
        _error = null;
        StateHasChanged();
        return NotifyRecorderStateAsync();
    }

    /// <summary>Round-recorder-takeover Q5 + owner rework (2026-10-12): the panel's Cancel — the
    /// takeover closes and the list body (rows, dropzone, add button) is restored. The row the record
    /// action itself appended is dropped while still unstaged (no recording residue in the list); a
    /// toggled-open pre-existing row and any staged row survive. The discarded take never reaches
    /// staging.</summary>
    private async Task CloseRecorder()
    {
        _recordingRow = null;
        _reviewSeed = null;
        // AC-4: a take handed off by the panel and never committed dies with the review — its Blob URL
        // is the host's (it never entered _sessionMedia), so this is its single revocation.
        await DiscardPendingRecordingAsync();
        var removed = DropOrphanedRecorderRow();
        _error = null;
        StateHasChanged();
        if (removed)
        {
            await Changed.InvokeAsync();
        }

        await NotifyRecorderStateAsync();
    }

    /// <summary>Owner rework (2026-10-12): removes the record action's own placeholder row while it is
    /// still unstaged. Never touches a pre-existing row (toggled open, not appended) and never a
    /// committed take's row (staged before Cancel can reach it). True when a row was removed.</summary>
    private bool DropOrphanedRecorderRow()
    {
        if (_recorderCreatedRow is not null && string.IsNullOrWhiteSpace(_recorderCreatedRow.StoragePath))
        {
            Rows.Remove(_recorderCreatedRow);
            _recorderCreatedRow = null;
            return true;
        }

        _recorderCreatedRow = null;
        return false;
    }

    /// <summary>Drops the handed-off take that was never committed and revokes its Blob URL exactly
    /// once — an uncommitted take lives only here (the panel owns nothing once it has handed over), so
    /// no row path can revoke it a second time. Its buffered stream goes with it: that buffer is this
    /// list's own (materialised before the metadata dialog popped).</summary>
    private async Task DiscardPendingRecordingAsync()
    {
        if (_pendingRecording is { } pending)
        {
            _pendingRecording = null;
            await pending.Media.Content.DisposeAsync();
            if (pending.Media.PreviewUrl is not null)
            {
                await RevokeMediaUrlAsync(pending.Media.PreviewUrl);
            }
        }
    }

    /// <summary>Signals <see cref="RecorderStateChanged"/> with the current open state (owner rework,
    /// 2026-10-12 — the host hides its own competing surfaces, e.g. the page's materials dropzone).</summary>
    private Task NotifyRecorderStateAsync() => RecorderStateChanged.InvokeAsync(_recordingRow is not null);

    /// <summary>Round media-pill-listing (C2, E.3): the readout is the edit affordance. On the
    /// Dialog-mode host it raises <see cref="EditRowRequested"/> — the host owns the dialog, exactly as
    /// for a Text/Link pencil. On the Inline-mode host (the question dialog, which cannot nest a
    /// dialog — dialog-ui §4) it expands the optional Title/Description pair ON the row (Q12).</summary>
    private async Task OnReadoutClickedAsync(InstructionEditorRow row)
    {
        if (ReadOnly)
        {
            return;
        }

        if (EditingMode == RowEditingMode.Dialog)
        {
            await EditRowRequested.InvokeAsync(row);
            return;
        }

        _inlineMediaRow = ReferenceEquals(_inlineMediaRow, row) ? null : row;
        StateHasChanged();
    }

    /// <summary>Round media-pill-listing (C2, E.6): the seeded review's link-styled metadata control —
    /// the same destination the readout click reaches (the host dialog on the Dialog host, the inline
    /// expansion on the Inline host).
    /// <para>On the Inline host the link must take effect IN THE SAME CLICK (P2, UI tester 2026-10-12):
    /// the takeover hides the rows, so toggling the inline expansion behind the open review panel had
    /// no visible effect until Cancel. It closes the review first and expands the row on the row that
    /// the close has just restored — nothing else moves, the row is staged and never the record
    /// action's placeholder, so <see cref="CloseRecorder"/> drops only the takeover.</para></summary>
    private async Task OnReviewMetadataAsync(InstructionEditorRow row)
    {
        if (ReadOnly
            || EditingMode != RowEditingMode.Inline
            || !ReferenceEquals(_recordingRow, row))
        {
            await OnReadoutClickedAsync(row);
            return;
        }

        await CloseRecorder();
        _inlineMediaRow = row;
        StateHasChanged();
    }

    /// <summary>Round media-pill-listing (C1/Q6): the play button. A session take replays from its kept
    /// Blob URL; any other staged row (uploaded / post-reload) fetches its bytes through the host's
    /// served route and wraps them in a Blob URL via <c>DotNetStreamReference</c>. Either way the SAME
    /// review panel reopens — playback only (no commit button on a seeded review). A missing seam or a
    /// failed/404 fetch surfaces a named error rather than a dead affordance (AC-10).</summary>
    private async Task PlayMediaAsync(InstructionEditorRow row)
    {
        if (_recordingRow == row)
        {
            await CloseRecorder();
            return;
        }

        if (_sessionMedia.TryGetValue(row, out var session))
        {
            SeedReview(row, session.Url);
            await NotifyRecorderStateAsync();
            return;
        }

        if (LoadInstructionMediaAsync is null)
        {
            Fail("Playing this recording is not available here.");
            return;
        }

        try
        {
            var stream = await LoadInstructionMediaAsync(row);
            if (stream is null)
            {
                Fail("This recording is no longer available.");
                return;
            }

            var url = await CreateMediaUrlFromStreamAsync(stream, row.ContentType);
            _sessionMedia[row] = new SessionMedia(url, null);
            SeedReview(row, url);
            await NotifyRecorderStateAsync();

            // Display-only probe (E.5): a row whose persisted duration is null can still read its
            // duration from the fetched bytes — but the value is never written back to the row, so it
            // is never persisted (that would need a PATCH endpoint — a named non-goal).
            await ProbeServedDurationAsync(row, url);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) when (ex is JSException or HttpRequestException or InvalidOperationException)
        {
            Fail("This recording could not be loaded.");
        }
    }

    /// <summary>Post-close rework (owner 2026-10-14, grill Q11): the metadata dialog's Preview ⇄
    /// Description seam. The dialog resolves a media row's preview Blob URL LAZILY through this
    /// delegate — a pending take or a session entry returns its kept URL instantly, while a
    /// persisted row streams its bytes through the host's served route on the FIRST press, so
    /// opening the dialog never blocks on a large file. Null = nothing can resolve here, and the
    /// dialog renders no toggle at all (never a dead button). The dialog never revokes: every URL
    /// entering <see cref="_sessionMedia"/> stays this list's to revoke exactly as before.</summary>
    public Func<Task<string?>>? GetPreviewLoader(InstructionEditorRow row) =>
        row.HasMedia && IsPreviewResolvable(row) ? () => ResolvePreviewUrlAsync(row) : null;

    /// <summary>Whether a media row's preview bytes can resolve right now: the pending take's
    /// handed-over URL, an already-resolved session entry, or a persisted row with the host's
    /// served-fetch seam.</summary>
    private bool IsPreviewResolvable(InstructionEditorRow row) =>
        (_pendingRecording is { } pending && ReferenceEquals(pending.Row, row) && pending.Media.PreviewUrl is not null)
        || _sessionMedia.ContainsKey(row)
        || (row.Id is not null && LoadInstructionMediaAsync is not null);

    /// <summary>Resolves (and, for a served fetch, caches) the preview Blob URL — the serve half
    /// mirrors <see cref="PlayMediaAsync"/> guard-for-guard; any failure resolves null and never
    /// throws (the dialog renders its named "unavailable" state). No duration probe here: the
    /// preview is the metadata dialog's eye, not a play.</summary>
    private async Task<string?> ResolvePreviewUrlAsync(InstructionEditorRow row)
    {
        if (_pendingRecording is { } pending && ReferenceEquals(pending.Row, row))
        {
            return pending.Media.PreviewUrl;
        }

        if (_sessionMedia.TryGetValue(row, out var session))
        {
            return session.Url;
        }

        if (row.Id is null || LoadInstructionMediaAsync is null)
        {
            return null;
        }

        try
        {
            var stream = await LoadInstructionMediaAsync(row);
            if (stream is null)
            {
                return null;
            }

            var url = await CreateMediaUrlFromStreamAsync(stream, row.ContentType);
            _sessionMedia[row] = new SessionMedia(url, null);
            return url;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
        catch (ObjectDisposedException)
        {
            return null;
        }
        catch (Exception ex) when (ex is JSException or HttpRequestException or InvalidOperationException)
        {
            return null;
        }
    }

    /// <summary>Opens the review panel on <paramref name="row"/> seeded with a Blob URL — the one
    /// playback surface (player + Record again; a reopened review never renders the commit button).</summary>
    private void SeedReview(InstructionEditorRow row, string url)
    {
        _recordingRow = row;
        _reviewSeed = new RecorderPanel.ReviewSeed(url, row.FileName ?? "recording", row.FileSize);
        _error = null;
        StateHasChanged();
    }

    /// <summary>Round media-pill-listing (Q8): the served bytes cross .NET→JS as a
    /// <c>DotNetStreamReference</c> — never a byte[] (an oversized interop number array in Blazor
    /// Server), and the JS side reads the stream before building the Blob URL.</summary>
    private async Task<string> CreateMediaUrlFromStreamAsync(Stream stream, string? contentType)
    {
        _mediaModule ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        using var streamRef = new DotNetStreamReference(stream);
        return await _mediaModule.InvokeAsync<string>("createMediaUrlFromStream", streamRef, contentType);
    }

    /// <summary>Display-only duration probe for a served/preview play — reuses the recorder module's
    /// single <c>mediaDuration</c> implementation, imported by this module. Best-effort: any failure
    /// leaves the readout on its `—:—` fallback.</summary>
    private async Task ProbeServedDurationAsync(InstructionEditorRow row, string url)
    {
        try
        {
            var seconds = await _mediaModule!.InvokeAsync<double?>("mediaDuration", url);
            if (ToWholeSeconds(seconds) is int whole && _sessionMedia.ContainsKey(row))
            {
                _sessionMedia[row] = new SessionMedia(url, whole);
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    /// <summary>Best-effort duration probe for a just-staged upload (E.7): reads the File still
    /// attached to the row's capture-slot input. Every failure path is swallowed — staging already
    /// succeeded, and the readout falls back to `—:—`.</summary>
    private async Task ProbeUploadDurationAsync(InstructionEditorRow row)
    {
        try
        {
            var index = Rows.IndexOf(row);
            if (index < 0)
            {
                return;
            }

            _mediaModule ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            var seconds = await _mediaModule.InvokeAsync<double?>(
                "probeDurationFromInput", $"#{Id}-capture-{index} input[type=file]");
            if (ToWholeSeconds(seconds) is int whole)
            {
                row.DurationSeconds = whole;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    /// <summary>Owner pill rework (2026-10-12): the list's tiny media module (revoke only). The import
    /// is INSIDE the guard — a missing/404 module (e.g. a stale session that predates this asset) must
    /// never blow up the row operation the revoke serves; the browser purges Blob URLs on teardown.</summary>
    private async Task RevokeMediaUrlAsync(string url)
    {
        try
        {
            _mediaModule ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _mediaModule.InvokeVoidAsync("revokeMediaUrl", url);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    /// <summary>Drops a row's session media entry and revokes its Blob URL — a discarded take must not
    /// leak memory. No-op for rows without an entry (uploaded / post-reload).</summary>
    private async Task RevokeSessionMediaAsync(InstructionEditorRow row)
    {
        if (_sessionMedia.Remove(row, out var session))
        {
            await RevokeMediaUrlAsync(session.Url);
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        // Hold verdict 2026-10-12 (finding 4): the session-held Blob URLs are this list's to revoke on
        // teardown too — dialog close / in-page navigation previously leaked every recorded take's URL
        // (RemoveAsync/ClearMediaAsync revoke only their own row's entry). Best-effort (RevokeMediaUrlAsync
        // guards import + call as one), and BEFORE the module goes away.
        foreach (var session in _sessionMedia.Values)
        {
            await RevokeMediaUrlAsync(session.Url);
        }

        // AC-4: a take the host still holds at teardown (the review was never closed) is revoked too —
        // it never entered _sessionMedia, so this is its single revocation.
        await DiscardPendingRecordingAsync();

        _sessionMedia.Clear();
        if (_mediaModule is not null)
        {
            try { await _mediaModule.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _mediaModule = null;
        }
    }

    /// <summary>D3 (recording-materials): the recorder's commit seam. The recorded take (delivered as a
    /// Stream via the panel's hidden InputFile) stages through the SAME <see cref="StageMediaFileAsync"/>
    /// path an uploaded media file takes, so the row is filled identically and the list stays the single
    /// writer of its rows. Public by the owner pill rework (2026-10-12) as the seam bUnit drives directly
    /// (the <c>StageMediaFileAsync</c> precedent) — and it now keeps the take's session Blob URL +
    /// duration for the row's play button.
    /// <para>Round media-pill-listing (C2/Q12): on the Dialog-mode host the take stages NOTHING here —
    /// the metadata dialog pops first (through the host's own <see cref="EditRowRequested"/> seam) and
    /// the stashed take is committed by <see cref="ApplyEditAsync"/> when the dialog confirms. A
    /// CANCELLED dialog leaves the stashed take with the review (AC-4): the panel keeps its own take
    /// open, the review is re-seeded on it, and nothing was staged. On the Inline-mode host (the
    /// question dialog — no nested dialogs) the take stages directly, exactly as before, and the
    /// freshly staged row's metadata is edited from its readout click.</para></summary>
    public async Task OnRecordedAsync(InstructionEditorRow row, RecorderPanel.RecordedMedia media)
    {
        if (StageMediaAsync is null)
        {
            Fail("Recording is not available here.");
            return;
        }

        if (EditingMode == RowEditingMode.Dialog)
        {
            // A take handed off earlier and still uncommitted is superseded by this one — a retake
            // after a cancelled metadata dialog. The panel handed its URL over and owns nothing, so
            // that URL is this host's to revoke here or it is orphaned. The SAME take arriving again
            // (the held review's second "Use this recording") is no supersede: same URL, still ours.
            if (_pendingRecording is { } superseded
                && superseded.Media.PreviewUrl is not null
                && !string.Equals(superseded.Media.PreviewUrl, media.PreviewUrl, StringComparison.Ordinal))
            {
                await RevokeMediaUrlAsync(superseded.Media.PreviewUrl);
            }

            // Materialise the take BEFORE the dialog round-trip. The panel hands over the LIVE stream
            // its hidden InputFile is still feeding and disposes it as soon as this handler returns
            // (its own `await using`), so a take stashed live would leave that JS data stream pending
            // across the dialog: the rich-text editor's interop never completes, the dialog renders
            // inert (no further event is dispatched) and the circuit later dies with a
            // TimeoutException — and the take's bytes are unreadable when the confirm stages them.
            // Copying here, inside the handler that RECEIVED the stream, consumes it; the buffer is
            // this list's own and is released with the pending take.
            var buffer = new MemoryStream();
            try
            {
                await media.Content.CopyToAsync(buffer);
                buffer.Position = 0;
            }
            catch
            {
                // A copy that failed leaves the PREVIOUS take untouched (nothing is superseded until
                // this one is in hand) and must not strand a half-filled buffer.
                await buffer.DisposeAsync();
                throw;
            }

            // The take this one replaces was buffered by this list too (the hand-off above): its
            // stream is ours to release, and the fresh take supersedes it whether or not it is the
            // same take arriving a second time. A host re-delivering the very same instance is not
            // disposed here — that stream is the one just copied. Disposing only AFTER the copy
            // succeeded is what keeps a failed retake from leaving the pending take disposed.
            if (_pendingRecording is { } replaced && !ReferenceEquals(replaced.Media.Content, media.Content))
            {
                await replaced.Media.Content.DisposeAsync();
            }

            // Stash the buffered take and pop the metadata dialog — staging happens only once the host
            // hands the confirmed result back through ApplyEditAsync.
            _pendingRecording = new PendingRecording(row, media with { Content = buffer });
            _error = null;
            await EditRowRequested.InvokeAsync(row);

            // A confirm cleared _pendingRecording and staged through ApplyEditAsync, so a take still
            // stashed here was CANCELLED: it stays uncommitted with the review (AC-4). The re-seed is
            // the review's own record of that take — the panel keeps its in-session take, and this is
            // what reopens the review on the same take for any render that no longer has it (the
            // list-level seam the cancel path is pinned through).
            if (_pendingRecording is { Media.PreviewUrl: not null } held)
            {
                _reviewSeed = new RecorderPanel.ReviewSeed(
                    held.Media.PreviewUrl, held.Media.FileName, held.Media.FileSize);
                StateHasChanged();
            }

            return;
        }

        await StageRecordedTakeAsync(row, media);
    }

    /// <summary>Commits a recorded take: stores its session Blob URL + probed duration on the row (the
    /// duration PERSISTS — Q7/AC-9), closes the review, then stages through the shared upload path.
    /// A Dialog-host take arrives as the list's own BUFFER (see <see cref="OnRecordedAsync"/>) — it is
    /// released here, after staging, with the pending take it came from. On the Inline path nothing is
    /// pending and the panel's live stream stays the panel's to dispose.</summary>
    private async Task StageRecordedTakeAsync(InstructionEditorRow row, RecorderPanel.RecordedMedia media)
    {
        _recordingRow = null;
        _reviewSeed = null;
        var buffered = _pendingRecording;
        _pendingRecording = null;
        // The committed take's row is staged now — it survives as a real row (owner rework, 2026-10-12).
        _recorderCreatedRow = null;
        if (media.PreviewUrl is not null)
        {
            if (_sessionMedia.TryGetValue(row, out var previous))
            {
                await RevokeMediaUrlAsync(previous.Url);
            }

            _sessionMedia[row] = new SessionMedia(media.PreviewUrl, media.DurationSeconds);
        }

        // Round media-pill-listing (Q7): the probed duration rides the row (and so the save payload).
        row.DurationSeconds = ToWholeSeconds(media.DurationSeconds);

        await NotifyRecorderStateAsync();
        try
        {
            await StageMediaFileAsync(row, media.Content, media.FileName, media.ContentType, media.FileSize);
        }
        finally
        {
            // The buffered pending take is consumed — release the buffer the list itself created (never
            // a stream the list did not create: the Inline path has nothing pending here). The release
            // sits in a `finally` because staging has NON-throwing failure paths of its own (the
            // in-flight guard, the allow-list pre-check, the document refusal all `Fail` and return),
            // and a refused or faulted stage must not strand the take's bytes.
            if (buffered is not null)
            {
                await buffered.Media.Content.DisposeAsync();
            }
        }
    }

    /// <summary>Sets the failure line and re-renders. A method invoked directly (bUnit, a test seam)
    /// does not get the render an event handler would, so every state change renders explicitly —
    /// which is also what lets the page/dialog re-render when they call these methods.</summary>
    private void Fail(string message)
    {
        _error = message;
        StateHasChanged();
    }
}

