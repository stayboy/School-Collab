@page "/assignments"
@using SchoolCollab.Assignments.Contracts
@using SchoolCollab.Assignments.Application.Helpers
@using SchoolCollab.Admin.Shared.Components.Landing
@using SchoolCollab.Core.Features
@inject AssignmentsApiClient Api
@inject IFeatureFlagService FeatureFlags
@inject ILogger<Index> Logger
@inject IToastService Toast
@implements IDisposable

<LandingPage TItem="AssignmentSummaryDto"
             Title="Assignments"
             CreateLabel="+ New Assignment"
             CreateRoute="/assignments/create"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@DisplayItems"
             Error="@_error"
             Loading="@_isSearching"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search assignments…"
             RowActions="@BuildAssignmentActions"
             RowActionsAriaLabel="Assignment actions"
             RowActionsUseMenuService="false">
    <ToolbarFilters>
        <FluentSelect Items="@StatusFilterOptions"
                      @bind-SelectedOption="_selectedStatus"
                      @bind-SelectedOption:after="OnStatusFilterChangedAsync"
                      OptionText="@(o => o!.Label)"
                      OptionValue="@(o => o!.Value?.ToString() ?? "")"
                      class="status-filter" />
    </ToolbarFilters>
    <Columns>
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Title" SortBy="@_sortByTitle" Sortable="true">
            <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/assignments/{context.Id}")">@context.Title</FluentAnchor>
        </TemplateColumn>
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Type" SortBy="@_sortByType" Sortable="true">
            @EnumHelper.GetDescription(context.AssignmentType)
        </TemplateColumn>
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Grading" SortBy="@_sortByGradingFormat" Sortable="true">
            @EnumHelper.GetDescription(context.GradingFormat)
        </TemplateColumn>
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Audience" SortBy="@_sortByTargetAudience" Sortable="true">
            @EnumHelper.GetDescription(context.TargetAudienceType)
        </TemplateColumn>
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Status" SortBy="@_sortByStatus" Sortable="true">
            @* WS-A2 deviation from decision (j): FluentBadge only supports Accent / Neutral /
               Lightweight (validated at render in Fluent UI 4.14) — Outline would crash the grid.
               Scheduled therefore shares Accent with Published (both committed publishing
               states); the badge text distinguishes them. *@
            <FluentBadge Appearance="@(context.Status == AssignmentStatusDto.Published ? Appearance.Accent
                : context.Status == AssignmentStatusDto.Scheduled ? Appearance.Accent
                : context.Status == AssignmentStatusDto.Closed || context.Status == AssignmentStatusDto.Archived ? Appearance.Neutral
                : Appearance.Lightweight)">
                @context.Status
            </FluentBadge>
        </TemplateColumn>
        @* WS-A2 / spec §7 Q2 — reviewer-rework UI-tester P2: a Draft row's
           approval state is otherwise invisible in the index, so the
           optimistic Submit-for-approval flip (and its failure rollback)
           has no surface. The Approval column is conditional on the flag
           so OFF tenants see exactly today's grid; ON tenants see a chip
           per Draft row with the five approval states. *@
        @if (_approvalRequired)
        {
            <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Approval">
                @if (context.Status == AssignmentStatusDto.Draft)
                {
                    <FluentBadge Appearance="@ApprovalChipAppearance(context.ApprovalStatus)">
                        @ApprovalChipText(context.ApprovalStatus)
                    </FluentBadge>
                }
            </TemplateColumn>
        }
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Due Date" SortBy="@_sortByDueDate" Sortable="true">
            @(context.DueDate?.ToLocalTime().ToString("g") ?? "—")
        </TemplateColumn>
        <TemplateColumn TGridItem="AssignmentSummaryDto" Title="Max Score" SortBy="@_sortByMaxScore" Sortable="true">
            @(context.MaxScore?.ToString("0.##") ?? "—")
        </TemplateColumn>
    </Columns>
</LandingPage>

@code {
    private AssignmentSummaryDto[]? _items;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // Search state
    private string _searchText = string.Empty;
    private AssignmentSummaryDto[]? _searchResults;
    private bool _isSearching;
    private CancellationTokenSource? _searchCts;

    // The array currently shown: search results while searching, otherwise the
    // loaded list. Null while the relevant fetch is in flight (the wrapper turns
    // that into the spinner via Items=null or Loading=_isSearching).
    private AssignmentSummaryDto[]? DisplayItems =>
        !string.IsNullOrWhiteSpace(_searchText) ? _searchResults : _items;

    private string CurrentEmptyMessage =>
        !string.IsNullOrWhiteSpace(_searchText)
            ? $"No assignments match '{_searchText}'."
            : "No assignments yet.";

    private static readonly LandingGridSettings _gridSettings = new()
    {
        // WS-A2 / spec §7 Q2 — the optional Approval column rides on the
        // flag. Template columns therefore grow by one when the flag is on
        // (the explicit "auto" trailing column keeps the Actions column's
        // natural width regardless).
        GridTemplateColumns = "minmax(180px,2fr) 1fr 1fr 1fr 1fr 1fr 1fr auto auto"
    };

    // Status filter (WS-A2 / spec §3.5 — adds Scheduled + Archived).
    public record StatusOption(int? Value, string Label);
    public static readonly StatusOption[] StatusFilterOptions =
    [
        new(null, "All"),
        new(0, "Draft"),
        new(1, "Published"),
        new(2, "Closed"),
        new(3, "Scheduled"),
        new(4, "Archived")
    ];
    private StatusOption? _selectedStatus;

    // WS-A2 / spec §7 Q2: approval flag toggle for the Draft row action
    // (Submit-for-approval replaces Publish when the flag is on).
    private bool _approvalRequired;

    private readonly GridSort<AssignmentSummaryDto> _sortByTitle =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.Title);
    private readonly GridSort<AssignmentSummaryDto> _sortByType =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.AssignmentType);
    private readonly GridSort<AssignmentSummaryDto> _sortByGradingFormat =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.GradingFormat);
    private readonly GridSort<AssignmentSummaryDto> _sortByTargetAudience =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.TargetAudienceType);
    private readonly GridSort<AssignmentSummaryDto> _sortByStatus =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.Status);
    private readonly GridSort<AssignmentSummaryDto> _sortByDueDate =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.DueDate);
    private readonly GridSort<AssignmentSummaryDto> _sortByMaxScore =
        GridSort<AssignmentSummaryDto>.ByAscending(x => x.MaxScore);

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        Logger.LogInformation("Loading assignments list");
        try
        {
            // WS-A2 / spec §7 Q2: resolve the approval flag once and cache it
            // (the NavMenu precedent). A resolution failure logs and leaves the
            // page in the OFF state — the list never blocks on the flag.
            try
            {
                _approvalRequired = await FeatureFlags.IsEnabledAsync(FeatureFlagKeys.RequireAssignmentApproval, token);
            }
            catch (Exception flagEx)
            {
                Logger.LogWarning(flagEx, "Feature flag resolution failed; defaulting approval to OFF");
                _approvalRequired = false;
            }

            _items = await LoadAssignmentsAsync(token);
            if (_disposed) return;
            Logger.LogInformation("Loaded {Count} assignments", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load assignments");
            _error = ex.Message;
        }
    }

    private async Task<AssignmentSummaryDto[]?> LoadAssignmentsAsync(CancellationToken ct)
    {
        AssignmentStatusDto? statusFilter = _selectedStatus?.Value switch
        {
            0 => AssignmentStatusDto.Draft,
            1 => AssignmentStatusDto.Published,
            2 => AssignmentStatusDto.Closed,
            3 => AssignmentStatusDto.Scheduled,
            4 => AssignmentStatusDto.Archived,
            _ => null
        };
        return await Api.ListAsync(statusFilter, ct);
    }

    private async Task OnPublishAsync(Guid id)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { Status = AssignmentStatusDto.Published };
        StateHasChanged();

        try
        {
            await Api.PublishAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to publish assignment {AssignmentId}", id);
            var i = Array.FindIndex(_items, x => x.Id == id);
            if (i >= 0) _items[i] = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnUnpublishAsync(Guid id)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { Status = AssignmentStatusDto.Draft };
        StateHasChanged();

        try
        {
            await Api.UnpublishAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to unpublish assignment {AssignmentId}", id);
            var i = Array.FindIndex(_items, x => x.Id == id);
            if (i >= 0) _items[i] = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnCloseAsync(Guid id)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { Status = AssignmentStatusDto.Closed };
        StateHasChanged();

        try
        {
            await Api.CloseAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to close assignment {AssignmentId}", id);
            var i = Array.FindIndex(_items, x => x.Id == id);
            if (i >= 0) _items[i] = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnDeleteAsync(Guid id, string title)
    {
        if (_disposed) return;

        try
        {
            await Api.DeleteAsync(id);
            if (_disposed) return;
            Toast.ShowSuccess($"Assignment '{title}' deleted.");
            if (_items is not null)
            {
                _items = _items.Where(x => x.Id != id).ToArray();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete assignment {AssignmentId}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    // WS-A2 / spec §7 Q2: submit-for-approval optimistic update mirrors the
    // existing publish/unpublish pattern — stamp the new approval state
    // locally, then call the API. A failure rolls back to the previous row.
    private async Task OnSubmitForApprovalAsync(Guid id)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { ApprovalStatus = ApprovalStatusDto.Pending };
        StateHasChanged();

        try
        {
            await Api.SubmitForApprovalAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to submit assignment {AssignmentId} for approval", id);
            var i = Array.FindIndex(_items, x => x.Id == id);
            if (i >= 0) _items[i] = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    // WS-A2 / spec §7 Q2 — reviewer-rework UI-tester P2: the approval-state
    // chip on a Draft row. Mirrors the Detail page's chip text + appearance
    // so the user sees consistent approval surfaces across the two pages.
    // (Validates the optimistic Submit-for-approval flip — and its failure
    // rollback — visibly in the grid.)
    private static string ApprovalChipText(ApprovalStatusDto? status) => status switch
    {
        null => "Not submitted",
        ApprovalStatusDto.Pending => "Pending",
        ApprovalStatusDto.Approved => "Approved",
        ApprovalStatusDto.Rejected => "Rejected",
        _ => "—"
    };

    private static Appearance ApprovalChipAppearance(ApprovalStatusDto? status) => status switch
    {
        null => Appearance.Lightweight,
        ApprovalStatusDto.Pending => Appearance.Neutral,
        ApprovalStatusDto.Approved => Appearance.Accent,
        ApprovalStatusDto.Rejected => Appearance.Neutral,
        _ => Appearance.Lightweight
    };

    private IReadOnlyList<RowAction> BuildAssignmentActions(AssignmentSummaryDto a)
    {
        var actions = new List<RowAction>();
        switch (a.Status)
        {
            case AssignmentStatusDto.Draft:
                actions.Add(RowAction.Navigate("Edit", $"/assignments/{a.Id}/edit", FluentIcons.Edit));
                // WS-A2 / spec §7 Q2: when the approval flag is on, Draft
                // rows surface "Submit for Approval" instead of Publish —
                // BUT only while the assignment has no current approval. An
                // already-APPROVED Draft must keep the Publish action so the
                // reviewer-rework UI-tester P1 cannot silently revoke an
                // approval (SubmitForApproval on an Approved row is a
                // Draft-only guard that flips Approved → Pending).
                if (_approvalRequired && a.ApprovalStatus != ApprovalStatusDto.Approved)
                {
                    actions.Add(RowAction.Callback(
                        "Submit for Approval",
                        () => OnSubmitForApprovalAsync(a.Id),
                        FluentIcons.Checkmark));
                }
                else
                {
                    actions.Add(RowAction.Callback("Publish", () => OnPublishAsync(a.Id), FluentIcons.ArrowExportUp));
                }
                actions.Add(RowAction.Separator());
                actions.Add(RowAction.Callback(
                    "Delete",
                    () => OnDeleteAsync(a.Id, a.Title),
                    FluentIcons.Delete,
                    destructive: true,
                    confirmMessage: $"Delete assignment '{a.Title}'? This cannot be undone."));
                break;
            case AssignmentStatusDto.Published:
                actions.Add(RowAction.Callback("Unpublish", () => OnUnpublishAsync(a.Id), FluentIcons.ArrowClockwise));
                actions.Add(RowAction.Callback("Close", () => OnCloseAsync(a.Id), FluentIcons.Checkmark));
                break;
            case AssignmentStatusDto.Scheduled:
                actions.Add(RowAction.Navigate("Edit", $"/assignments/{a.Id}/edit", FluentIcons.Edit));
                actions.Add(RowAction.Callback("Publish now", () => OnPublishAsync(a.Id), FluentIcons.ArrowExportUp));
                actions.Add(RowAction.Callback("Unpublish", () => OnUnpublishAsync(a.Id), FluentIcons.ArrowClockwise));
                break;
            case AssignmentStatusDto.Closed:
                actions.Add(RowAction.Navigate("Review", $"/assignments/{a.Id}", FluentIcons.Open));
                break;
            case AssignmentStatusDto.Archived:
                // Spec §7 Q6: archived is read-only retention — review only.
                actions.Add(RowAction.Navigate("Review", $"/assignments/{a.Id}", FluentIcons.Open));
                break;
        }
        return actions;
    }

    private async Task OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _searchResults = null;
            _isSearching = false;
            StateHasChanged();
            return;
        }

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        _isSearching = true;
        try
        {
            _searchResults = await Api.ListAsync(null, ct);
            if (_disposed) return;
            // Client-side filter for search
            _searchResults = _searchResults?
                .Where(a => a.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            _isSearching = false;
            Logger.LogInformation("Search returned {Count} results for '{SearchText}'", _searchResults?.Length ?? 0, _searchText);
        }
        catch (OperationCanceledException)
        {
            // previous search cancelled
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Search failed for '{SearchText}'", _searchText);
            _error = ex.Message;
            _isSearching = false;
        }

        StateHasChanged();
    }

    private async Task OnStatusFilterChangedAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            _items = await LoadAssignmentsAsync(ct);
            if (_disposed) return;
            Logger.LogInformation("Reloaded {Count} assignments for status filter {Status}", _items?.Length ?? 0, _selectedStatus?.Value);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload assignments for status filter");
            _error = ex.Message;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }
}