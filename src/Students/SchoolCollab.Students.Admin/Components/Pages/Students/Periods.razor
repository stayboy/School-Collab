@page "/students/periods"
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Constants
@inject StudentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Periods> Logger
@inject IDialogService DialogService
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<PageTitle>Periods</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" class="page-container">
            <div class="title-row">
                <h1 class="page-title">Periods</h1>
            </div>
            <TenantGate>
                <ChildContent>
                    <div class="action-bar">
                        <FluentButton Appearance="Appearance.Accent" OnClick="@ShowCreatePanel">+ New Period</FluentButton>
                    </div>

                    @if (_showCreate)
            {
                <div class="create-panel">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                                 VerticalAlignment="VerticalAlignment.Center"
                                 class="panel-head">
                        <h2 class="panel-title">New period</h2>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@FluentIcons.Dismiss"
                                      Title="Close"
                                      OnClick="@HideCreatePanel" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalGap="8"
                                 VerticalAlignment="VerticalAlignment.Top"
                                 class="panel-tip">
                        <FluentIcon Icon="@(Icons.Regular.Size20.Calendar)" />
                        <span>
                            Pre-filled with the <strong>current academic year</strong> (1 Sep – 31 Aug) as an editable template.
                            Use the buttons to suggest or backfill, then adjust as needed.
                        </span>
                    </FluentStack>

                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="4">
                            <label class="form-label" for="createName">Period name *</label>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="8">
                            <FluentStack Orientation="Orientation.Horizontal"
                                         Wrap="true"
                                         HorizontalGap="8"
                                         VerticalGap="8"
                                         VerticalAlignment="VerticalAlignment.Center">
                                <FluentTextField Id="createName"
                                                  @bind-Value="_createName"
                                                  Required
                                                  Placeholder="e.g. 2026/2027"
                                                  Style="flex:1; min-width:0" />
                                <FluentButton IconStart="@FluentIcons.Calendar"
                                              Title="Fill the period name with the current academic year (editable template)"
                                              OnClick="@SuggestAcademicYearAsync" />
                                <FluentButton IconStart="@FluentIcons.ArrowClockwise"
                                              Title="Fill the form with the next academic year after the latest period"
                                              OnClick="@BackfillAsync" />
                            </FluentStack>
                        </FluentGridItem>

                        <FluentGridItem xs="12" md="4">
                            <label class="form-label" for="createStart">Start date *</label>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="8">
                            <FluentTextField Id="createStart"
                                              @bind-Value="_createStartDate"
                                              Required
                                              Placeholder="e.g. 2026-09-01"
                                              Style="width:12rem" />
                        </FluentGridItem>

                        <FluentGridItem xs="12" md="4">
                            <label class="form-label" for="createEnd">End date *</label>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="8">
                            <FluentTextField Id="createEnd"
                                              @bind-Value="_createEndDate"
                                              Required
                                              Placeholder="e.g. 2027-08-31"
                                              Style="width:12rem" />
                        </FluentGridItem>
                    </FluentGrid>

                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalGap="8"
                                 VerticalGap="8"
                                 class="form-actions">
                        <FluentButton Appearance="Appearance.Accent" OnClick="@OnCreateAsync">Create period</FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="@HideCreatePanel">Cancel</FluentButton>
                    </FluentStack>
                </div>
            }

            @if (_items is null)
            {
                <div class="spinner-container">
                    <FluentProgressRing />
                </div>
            }
            else if (_items.Length == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Info">No periods yet.</FluentMessageBar>
            }
            else
            {
                <div class="grid-container">
                    <FluentDataGrid Items="@_items.AsQueryable()"
                                    GridTemplateColumns="minmax(160px,2fr) 110px 110px 120px 140px auto"
                                    MultiLine="true"
                                    TGridItem="PeriodDto">
                        <PropertyColumn Property="@(x => x.Name)" Sortable="true" Title="Name" />
                        <TemplateColumn Title="Start Date">
                            @context.StartDate.ToString("d")
                        </TemplateColumn>
                        <TemplateColumn Title="End Date">
                            @context.EndDate.ToString("d")
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            @GetStatusBadge(context.Status)
                        </TemplateColumn>
                        <TemplateColumn Title="Actions">
                            @if (context.Status == "Draft")
                            {
                                <FluentAnchor Href="#" OnClick="@(() => OnActivateAsync(context.Id))">Activate</FluentAnchor>
                            }
                            else if (context.Status == "Active")
                            {
                                <FluentAnchor Href="#" OnClick="@(() => OnCompleteAsync(context.Id))">Complete</FluentAnchor>
                            }
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
            }
                </ChildContent>
                <Fallback>
                    <FluentMessageBar Intent="MessageIntent.Warning">
                        You have no tenant assigned. Period records are tenant-scoped — pick a tenant to continue.
                    </FluentMessageBar>
                </Fallback>
            </TenantGate>
        </FluentStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private PeriodDto[]? _items;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    // Create form state
    private bool _showCreate;
    private string _createName = string.Empty;
    private string _createStartDate = string.Empty;
    private string _createEndDate = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            return;
        }

        Logger.LogInformation("Loading periods list");
        try
        {
            _items = await Api.ListPeriodsAsync(token);

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} periods", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load periods");
            _error = ex.Message;
        }
    }



    private void ShowCreatePanel()
    {
        if (!_isRealTenant) return;

        _showCreate = true;
        // Prefill with the current academic year as an editable template.
        ApplySuggestion(AcademicYearSuggestion.ForDate(DateOnly.FromDateTime(DateTime.Today)));
    }

    private void SuggestAcademicYearAsync()
    {
        ApplySuggestion(AcademicYearSuggestion.ForDate(DateOnly.FromDateTime(DateTime.Today)));
    }

    private void BackfillAsync()
    {
        // Auto-populate from the latest existing period (next academic year after it).
        ApplySuggestion(AcademicYearSuggestion.BackfillFrom(_items));
    }

    private void ApplySuggestion((string Name, DateOnly StartDate, DateOnly EndDate) suggestion)
    {
        _createName = suggestion.Name;
        _createStartDate = suggestion.StartDate.ToString("yyyy-MM-dd");
        _createEndDate = suggestion.EndDate.ToString("yyyy-MM-dd");
    }

    private void HideCreatePanel()
    {
        _showCreate = false;
    }

    private async Task OnCreateAsync()
    {
        if (!_isRealTenant) return;

        if (!DateOnly.TryParse(_createStartDate, out var startDate))
        {
            _error = "Invalid start date format. Use yyyy-MM-dd.";
            StateHasChanged();
            return;
        }
        if (!DateOnly.TryParse(_createEndDate, out var endDate))
        {
            _error = "Invalid end date format. Use yyyy-MM-dd.";
            StateHasChanged();
            return;
        }

        var request = new CreatePeriodRequest(_createName, startDate, endDate);

        Logger.LogInformation("Creating period {Name}", request.Name);
        try
        {
            await Api.CreatePeriodAsync(request);

            if (_disposed) return;

            Logger.LogInformation("Period {Name} created", request.Name);
            _showCreate = false;
            _error = null;

            // Reload list
            _items = await Api.ListPeriodsAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create period {Name}", request.Name);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnActivateAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            "Activate this period? Once active, enrollments can begin.",
            "Activate",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { Status = "Active" };
        StateHasChanged();

        Logger.LogInformation("Activating period {Id}", id);
        try
        {
            await Api.ActivatePeriodAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to activate period {Id}", id);
            if (_items is not null)
            {
                var i = Array.FindIndex(_items, x => x.Id == id);
                if (i >= 0) _items[i] = previous;
            }
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnCompleteAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            "Complete this period? This will finalize the period.",
            "Complete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { Status = "Completed" };
        StateHasChanged();

        Logger.LogInformation("Completing period {Id}", id);
        try
        {
            await Api.CompletePeriodAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to complete period {Id}", id);
            if (_items is not null)
            {
                var i = Array.FindIndex(_items, x => x.Id == id);
                if (i >= 0) _items[i] = previous;
            }
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private static RenderFragment GetStatusBadge(string status) => builder =>
    {
        var (appearance, label) = status switch
        {
            "Draft"     => ((Appearance)Appearance.Neutral, "Draft"),
            "Active"    => ((Appearance)Appearance.Accent, "Active"),
            "Completed" => ((Appearance)Appearance.Outline, "Completed"),
            "Archived"  => ((Appearance)Appearance.Neutral, "Archived"),
            _           => ((Appearance)Appearance.Neutral, status)
        };
        builder.OpenComponent<FluentBadge>(0);
        builder.AddAttribute(1, "Appearance", appearance);
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(b =>
            b.AddContent(0, label)));
        builder.CloseComponent();
    };

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}