@page "/students"
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Admin.Shared.Components.Landing
@inject StudentsApiClient Api
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@implements IDisposable

<LandingPage TItem="StudentDto"
             Title="Students"
             CreateLabel="+ New Student"
             CreateRoute="/students/create"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_filteredItems"
             Loading="@(_items is null)"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search students…">
    <ToolbarFilters>
        <FluentCheckbox @bind-Value="@_showDeleted" @bind-Value:after="OnShowDeletedChanged"
                        Label="Show deleted" />
    </ToolbarFilters>
    <Columns>
        <TemplateColumn TGridItem="StudentDto" Title="Student #" SortBy="@_sortByStudentNumber" Sortable="true">
            <code>@context.StudentNumber</code>
        </TemplateColumn>
        <PropertyColumn TGridItem="StudentDto" TProp="string" Property="@(x => x.FirstName)" Sortable="true" />
        <PropertyColumn TGridItem="StudentDto" TProp="string" Property="@(x => x.LastName)" Sortable="true" />
        <PropertyColumn TGridItem="StudentDto" TProp="string" Property="@(x => x.ContactEmail)" />
        <TemplateColumn TGridItem="StudentDto" Title="Date of Birth">
            @(context.DateOfBirth?.ToShortDateString() ?? "—")
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Status">
            @if (context.IsDeleted)
            {
                <FluentBadge Appearance="Appearance.Neutral">Deleted</FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Actions">
            <FluentAnchor Href="@($"/students/{context.Id}")">View</FluentAnchor>
            @if (!context.IsDeleted)
            {
                <FluentAnchor Href="#" OnClick="@(() => OnDeleteAsync(context.Id, context.StudentNumber))" class="ms-2">Delete</FluentAnchor>
            }
            else
            {
                <FluentAnchor Href="#" OnClick="@(() => OnRecoverAsync(context.Id, context.StudentNumber))" class="ms-2">Recover</FluentAnchor>
            }
        </TemplateColumn>
    </Columns>
</LandingPage>

@code {
    private StudentDto[]? _items;
    private StudentDto[]? _deletedItems;
    private bool _showDeleted;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private string _searchText = string.Empty;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "120px minmax(180px,2fr) minmax(180px,2fr) minmax(200px,2fr) 120px 100px auto"
    };

    /// <summary>
    /// The array bound to the grid: the active list plus the deleted list when
    /// "Show deleted" is on (the deleted rows render with a Deleted status badge
    /// and a Recover action via the per-row column templates), then narrowed by
    /// the client-side search filter.
    /// </summary>
    private StudentDto[] _filteredItems
    {
        get
        {
            var baseItems = _showDeleted
                ? (_items ?? []).Concat(_deletedItems ?? []).ToArray()
                : (_items ?? []);

            return string.IsNullOrWhiteSpace(_searchText)
                ? baseItems
                : baseItems.Where(MatchesSearch).ToArray();
        }
    }

    /// <summary>
    /// Empty-state message. While loading the wrapper shows the spinner (Loading
    /// is true), so this is only read when _items is populated. A non-empty
    /// search with no matches yields "No students match …"; otherwise "No
    /// students yet."
    /// </summary>
    private string CurrentEmptyMessage =>
        !string.IsNullOrWhiteSpace(_searchText) && _filteredItems.Length == 0
            ? $"No students match '{_searchText}'."
            : "No students yet.";

    private readonly GridSort<StudentDto> _sortByStudentNumber =
        GridSort<StudentDto>.ByAscending(x => x.StudentNumber);

    private bool MatchesSearch(StudentDto s)
    {
        var search = _searchText.Trim();
        return s.StudentNumber.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.FirstName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.LastName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.ContactEmail.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        Logger.LogInformation("Loading students list");
        try
        {
            _items = await Api.ListStudentsAsync(token);

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} students", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load students");
            _error = ex.Message;
        }
    }

    private async Task OnShowDeletedChanged()
    {
        if (_showDeleted && _deletedItems is null)
        {
            try
            {
                _deletedItems = await Api.ListDeletedStudentsAsync();
                if (_disposed) return;
            }
            catch (Exception ex)
            {
                if (_disposed) return;
                Logger.LogError(ex, "Failed to load deleted students");
                _error = ex.Message;
            }
        }
    }

    private async Task OnDeleteAsync(Guid id, string studentNumber)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete student '{studentNumber}'? This will soft-delete the student.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        if (_items is null) return;
        var previous = _items;
        _items = _items.Where(x => x.Id != id).ToArray();
        StateHasChanged();

        try
        {
            await Api.DeleteStudentAsync(id);
            if (_disposed) return;

            if (_showDeleted)
            {
                _deletedItems = await Api.ListDeletedStudentsAsync();
                if (_disposed) return;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete student {Id}", id);
            _items = previous; // rollback
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnRecoverAsync(Guid id, string studentNumber)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Recover student '{studentNumber}'? This will restore the student to the active list.",
            "Recover",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.RecoverStudentAsync(id);
            if (_disposed) return;
            // Remove from deleted list, re-fetch active list
            _deletedItems = _deletedItems?.Where(x => x.Id != id).ToArray();
            _items = await Api.ListStudentsAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to recover student {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private void OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}