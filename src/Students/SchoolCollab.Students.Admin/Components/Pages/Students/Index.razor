@page "/students"
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Admin.Shared.Components.Landing
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using SchoolCollab.Admin.Shared.Services
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<LandingPage TItem="StudentDto"
             Title="Students"
             CreateLabel="+ New Student"
             CreateRoute="/students/create"
             CreateEnabled="@_isRealTenant"
             SearchEnabled="@_isRealTenant"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_filteredItems"
             Loading="@(_items is null || _gradeLevels is null && _filterGradeLevelId.HasValue)"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search students…">
    <ToolbarFilters>
        @if (_filterGradeLevel is not null)
        {
            <FluentBadge Appearance="Appearance.Neutral" Style="margin-right: 8px;">
                Grade: @_filterGradeLevel.Name
                <FluentButton Appearance="Appearance.Neutral"
                             Style="margin-left: 4px; padding: 0; min-width: 20px; height: 20px;"
                             OnClick="ClearGradeFilter">
                    <FluentIcon Icon="@(Icons.Regular.Size16.Dismiss)" Size="IconSize.Small" />
                </FluentButton>
            </FluentBadge>
        }
        <FluentCheckbox @bind-Value="@_showDeleted" @bind-Value:after="OnShowDeletedChanged"
                        Label="Show deleted" />
    </ToolbarFilters>
    <Columns>
        <TemplateColumn TGridItem="StudentDto" Title="Student #" SortBy="@_sortByStudentNumber" Sortable="true">
            <code>@context.StudentNumber</code>
        </TemplateColumn>
        <PropertyColumn TGridItem="StudentDto" TProp="string" Property="@(x => x.FirstName)" Sortable="true" />
        <PropertyColumn TGridItem="StudentDto" TProp="string" Property="@(x => x.LastName)" Sortable="true" />
        <TemplateColumn TGridItem="StudentDto" Title="Date of Birth">
            @(context.DateOfBirth?.ToShortDateString() ?? "—")
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Status">
            @if (context.IsDeleted)
            {
                <FluentBadge Appearance="Appearance.Neutral">Deleted</FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Actions">
            <FluentAnchor Href="@($"/students/{context.Id}")">View</FluentAnchor>
            @if (!context.IsDeleted)
            {
                <FluentAnchor Href="#" OnClick="@(() => OnDeleteAsync(context.Id, context.StudentNumber))" class="ms-2">Delete</FluentAnchor>
            }
            else
            {
                <FluentAnchor Href="#" OnClick="@(() => OnRecoverAsync(context.Id, context.StudentNumber))" class="ms-2">Recover</FluentAnchor>
            }
        </TemplateColumn>
    </Columns>
</LandingPage>

@code {
    [SupplyParameterFromQuery] public Guid? GradeLevelId { get; set; }
    [SupplyParameterFromQuery] public Guid? PeriodId { get; set; }

    private StudentDto[]? _items;
    private StudentDto[]? _deletedItems;
    private GradeLevelDto[]? _gradeLevels;
    private GradeLevelDto? _filterGradeLevel;
    private bool _showDeleted;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    private string _searchText = string.Empty;
    private Guid? _filterGradeLevelId;
    private Guid? _filterPeriodId;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "120px minmax(180px,2fr) minmax(180px,2fr) minmax(200px,2fr) 120px 100px auto"
    };

    private StudentDto[] _filteredItems
    {
        get
        {
            var baseItems = _showDeleted
                ? (_items ?? []).Concat(_deletedItems ?? []).ToArray()
                : (_items ?? []);

            return string.IsNullOrWhiteSpace(_searchText)
                ? baseItems
                : baseItems.Where(MatchesSearch).ToArray();
        }
    }

    private string CurrentEmptyMessage
    {
        get
        {
            if (!_isRealTenant)
                return "Select a tenant to manage students.";

            if (_filterGradeLevelId.HasValue && (_items is null || _items.Length == 0))
                return "No students enrolled in this grade level for the current period.";

            if (!string.IsNullOrWhiteSpace(_searchText) && _filteredItems.Length == 0)
                return $"No students match '{_searchText}'.";

            return "No students yet.";
        }
    }

    private static readonly GridSort<StudentDto> _sortByStudentNumber =
        GridSort<StudentDto>.ByAscending(x => x.StudentNumber);

    private bool MatchesSearch(StudentDto s)
    {
        var search = _searchText.Trim();
        return s.StudentNumber.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.FirstName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.LastName.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        // Resolve visible tenancy up front. Student is strict-tenant, so when
        // there is no real tenant we skip all tenant-scoped API calls and show
        // an explanatory empty state instead of triggering the server guard.
        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            _gradeLevels = [];
            return;
        }

        Logger.LogInformation("Loading students list");

        try
        {
            // Load grade levels for filter resolution
            _gradeLevels = await Api.ListGradeLevelsAsync(token);
            if (_disposed) return;

            // Apply query params if present
            if (GradeLevelId.HasValue)
            {
                _filterGradeLevelId = GradeLevelId;
                _filterPeriodId = PeriodId;
                _filterGradeLevel = _gradeLevels?.FirstOrDefault(gl => gl.Id == GradeLevelId.Value);

                // Load students filtered by grade
                _items = await Api.ListStudentsByGradeAsync(GradeLevelId.Value, PeriodId, token);
            }
            else
            {
                // Load all students
                _items = await Api.ListStudentsAsync(token);
            }

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} students", _items?.Length ?? 0);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load students");
            _error = ex.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isRealTenant) return;

        // If query params change, reload with filter
        if (GradeLevelId != _filterGradeLevelId && GradeLevelId.HasValue)
        {
            _filterGradeLevelId = GradeLevelId;
            _filterPeriodId = PeriodId;
            _filterGradeLevel = _gradeLevels?.FirstOrDefault(gl => gl.Id == GradeLevelId.Value);

            _loadCts ??= new CancellationTokenSource();
            try
            {
                _items = await Api.ListStudentsByGradeAsync(GradeLevelId.Value, PeriodId, _loadCts.Token);
                if (_disposed) return;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                if (_disposed) return;
                Logger.LogError(ex, "Failed to load students by grade");
                _error = ex.Message;
            }
        }
    }

    private async Task OnShowDeletedChanged()
    {
        if (!_isRealTenant) return;

        if (_showDeleted && _deletedItems is null)
        {
            try
            {
                _deletedItems = await Api.ListDeletedStudentsAsync();
                if (_disposed) return;
            }
            catch (Exception ex)
            {
                if (_disposed) return;
                Logger.LogError(ex, "Failed to load deleted students");
                _error = ex.Message;
            }
        }
    }

    private void ClearGradeFilter()
    {
        _filterGradeLevelId = null;
        _filterPeriodId = null;
        _filterGradeLevel = null;

        // Navigate to clear the query params
        Nav.NavigateTo("/students");
    }

    private async Task OnDeleteAsync(Guid id, string studentNumber)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete student '{studentNumber}'? This will soft-delete the student.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        if (_items is null) return;
        var previous = _items;
        _items = _items.Where(x => x.Id != id).ToArray();
        StateHasChanged();

        try
        {
            await Api.DeleteStudentAsync(id);
            if (_disposed) return;

            if (_showDeleted)
            {
                _deletedItems = await Api.ListDeletedStudentsAsync();
                if (_disposed) return;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete student {Id}", id);
            _items = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnRecoverAsync(Guid id, string studentNumber)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Recover student '{studentNumber}'? This will restore the student to the active list.",
            "Recover",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.RecoverStudentAsync(id);
            if (_disposed) return;
            _deletedItems = _deletedItems?.Where(x => x.Id != id).ToArray();
            _items = await Api.ListStudentsAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to recover student {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private void OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}