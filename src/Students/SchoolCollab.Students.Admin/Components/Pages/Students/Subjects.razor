@page "/students/subjects"
@using SchoolCollab.Students.Admin.Services
@inject StudentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Subjects> Logger
@implements IDisposable

<PageTitle>Subjects</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" class="page-container">
            <div class="title-row">
                <h1 class="page-title">Subjects</h1>
            </div>
            @if (_items is null)
            {
                <div class="spinner-container">
                    <FluentProgressRing />
                </div>
            }
            else if (_items.Length == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Info">No subjects yet.</FluentMessageBar>
            }
            else
            {
                <div class="grid-container">
                    <FluentDataGrid Items="@_items.AsQueryable()"
                                    GridTemplateColumns="100px minmax(200px,2fr) 120px 140px minmax(160px,1fr)"
                                    MultiLine="true"
                                    TGridItem="SubjectDto">
                        <TemplateColumn Title="Code" SortBy="@_sortByCode" Sortable="true">
                            <code>@context.Code</code>
                        </TemplateColumn>
                        <PropertyColumn Property="@(x => x.Name)" Sortable="true" Title="Name" />
                        <PropertyColumn Property="@(x => x.DisplayOrder)" Sortable="true" Title="Display Order" />
                        <TemplateColumn Title="CodedValueId">
                            <code>@context.CodedValueId.ToString()[..8]…</code>
                        </TemplateColumn>
                        <TemplateColumn Title="Created">
                            @context.CreatedAt.ToLocalTime().ToString("d")
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
            }
        </FluentStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private SubjectDto[]? _items;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private readonly GridSort<SubjectDto> _sortByCode =
        GridSort<SubjectDto>.ByAscending(x => x.Code);

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        Logger.LogInformation("Loading subjects list");
        try
        {
            _items = await Api.ListSubjectsAsync(token);

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} subjects", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load subjects");
            _error = ex.Message;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}