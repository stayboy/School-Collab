@page "/students/grade-levels"
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Students.Admin.Components.Students
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Components.Landing
@using SchoolCollab.Admin.Shared.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<GradeLevels> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<LandingPage TItem="GradeLevelLandingDto"
             Title="Grade Levels"
             CreateLabel="+ New Grade Level"
             CreateRoute="/students/grade-levels/create"
             CreateEnabled="@_isRealTenant"
             SearchEnabled="@_isRealTenant"
             OnCreate="@OpenCreateDialogAsync"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_filteredItems"
             Loading="@(_items is null)"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search grade levels…">
    <Columns>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Name" Sortable="true" SortBy="@_sortByName">
            @(_resolvedNames.TryGetValue(context.Id, out var name) ? name : context.Name)
        </TemplateColumn>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Age range">
            @if (context.MinAge.HasValue || context.MaxAge.HasValue)
            {
                <span class="age-range">@FormatAgeRange(context.MinAge, context.MaxAge)</span>
            }
            else
            {
                <span class="muted" title="No age restriction set">Any age</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Gender">
            @if (context.AllowedGenderCodedValueId is { } gid
                 && _resolvedGenderNames.TryGetValue(gid, out var gname))
            {
                <FluentBadge Appearance="Appearance.Neutral">@gname</FluentBadge>
            }
            else if (context.AllowedGenderCodedValueId is not null)
            {
                <span class="muted" title="Gender id @(context.AllowedGenderCodedValueId) — name not resolved">—</span>
            }
            else
            {
                <span class="muted" title="No gender restriction set">Co-ed</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Topics">
            @if (context.CurrentPeriodId.HasValue)
            {
                <FluentAnchor Appearance="Appearance.Lightweight"
                              Href="@($"/students/subjects?gradeLevelId={context.Id}&periodId={context.CurrentPeriodId}")">
                    @context.TopicCount
                </FluentAnchor>
            }
            else
            {
                <span class="muted">0</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Students">
            @if (context.CurrentPeriodId.HasValue)
            {
                <FluentAnchor Appearance="Appearance.Lightweight"
                              Href="@($"/students?gradeLevelId={context.Id}&periodId={context.CurrentPeriodId}")">
                    @context.StudentCount
                </FluentAnchor>
            }
            else
            {
                <span class="muted">0</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Period">
            @if (context.CurrentPeriodId.HasValue)
            {
                <FluentBadge Appearance="Appearance.Accent">@context.CurrentPeriodName</FluentBadge>
            }
            else
            {
                <span class="muted">No current period</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="GradeLevelLandingDto" Title="Actions">
            <RowActionsMenu AriaLabel="Grade actions"
                            UseMenuService="false"
                            Actions="@BuildRowActions(context)" />
        </TemplateColumn>
    </Columns>
</LandingPage>

<style>
    .muted {
        color: var(--neutral-foreground-hint);
    }
    .age-range {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
</style>

@code {
    private GradeLevelLandingDto[]? _items;
    private Dictionary<Guid, string> _resolvedNames = new();
    private Dictionary<Guid, string> _resolvedGenderNames = new();
    private string _searchText = string.Empty;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    /// <summary>
    /// Cached current-period id from the most recent landing load. Passed into
    /// the Create dialog so it knows which period to assign topics to.
    /// Null when there is no current period (Create dialog then hides the
    /// Topics section).
    /// </summary>
    private Guid? _currentPeriodId;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        // 2fr Name | 80px Age range | 90px Gender | 80px Topics | 80px Students | 140px Period | auto Actions
        GridTemplateColumns = "minmax(200px,2fr) 80px 90px 80px 80px 140px auto"
    };

    private static readonly GridSort<GradeLevelLandingDto> _sortByName =
        GridSort<GradeLevelLandingDto>.ByAscending(x => x.Name);

    private GradeLevelLandingDto[] _filteredItems =>
        string.IsNullOrWhiteSpace(_searchText)
            ? (_items ?? [])
            : (_items ?? []).Where(MatchesSearch).ToArray();

    private string CurrentEmptyMessage =>
        !_isRealTenant
            ? "Select a tenant to manage grade levels."
            : (!string.IsNullOrWhiteSpace(_searchText) && _filteredItems.Length == 0
                ? $"No grade levels match '{_searchText}'."
                : "No grade levels yet. Create one to get started.");

    private bool MatchesSearch(GradeLevelLandingDto g)
    {
        var search = _searchText.Trim();
        var name = _resolvedNames.TryGetValue(g.Id, out var resolved) ? resolved : g.Name;
        return name.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Renders the Min/Max age range as a compact "min–max" string. Three shapes:
    /// min + max → "10–12"; min only → "10+"; max only → "≤12". A null/blank
    /// pair is handled by the caller (renders "Any age").
    /// </summary>
    private static string FormatAgeRange(int? min, int? max)
    {
        if (min.HasValue && max.HasValue) return $"{min}–{max}";
        if (min.HasValue) return $"{min}+";
        return $"≤{max}";
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    /// <summary>
    /// (Re)loads the landing data — called on initial mount and again after
    /// the Create dialog reports success so the new row shows up. Always
    /// re-reads the tenant scope so a tenant switch mid-session is honored
    /// (the same as the original OnInitializedAsync).
    /// </summary>
    private async Task ReloadAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            _currentPeriodId = null;
            return;
        }

        Logger.LogInformation("Loading grade levels landing");
        try
        {
            // Load grade levels with current-period stats
            _items = await Api.ListGradeLevelsForLandingAsync(token);

            if (_disposed) return;

            _currentPeriodId = _items?.FirstOrDefault()?.CurrentPeriodId;

            // Load tenant-resolved names for display
            var gradeCodedValues = await CodedValuesApi.GetChildrenByParentCodeAsync("GRADE", token);
            if (gradeCodedValues is not null)
            {
                foreach (var cv in gradeCodedValues)
                {
                    foreach (var gl in _items ?? [])
                    {
                        if (gl.CodedValueId == cv.Id)
                        {
                            _resolvedNames[gl.Id] = cv.Name; // tenant-resolved name
                        }
                    }
                }
            }

            // Resolve gender names for the AllowedGenderCodedValueId chips. We
            // batch all referenced gender ids into one round-trip via
            // GetByIdsAsync instead of one GetByIdAsync per row.
            var genderIds = (_items ?? [])
                .Select(g => g.AllowedGenderCodedValueId)
                .OfType<Guid>()
                .Distinct()
                .ToArray();
            if (genderIds.Length > 0)
            {
                var genders = await CodedValuesApi.GetByIdsAsync(genderIds, token);
                foreach (var g in genders)
                {
                    _resolvedGenderNames[g.Id] = g.Name;
                }
            }

            Logger.LogInformation("Loaded {Count} grade levels", _items?.Length ?? 0);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load grade levels");
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Opens the Create dialog (DialogShellBase-derived) and refreshes the
    /// landing on success. Wired into LandingPage.OnCreate so the + New
    /// button invokes this instead of navigating to a dedicated route.
    /// <see cref="CreateRoute"/> is left set as a fallback for any deep link
    /// / browser refresh that bypasses the LandingPage chrome.
    /// </summary>
    private async Task OpenCreateDialogAsync()
    {
        if (_disposed) return;

        var model = new GradeLevelCreateDialog.GradeLevelCreateModel
        {
        };

        var created = await DialogService.ShowShellDialogAsync<
            GradeLevelCreateDialog,
            GradeLevelCreateDialog.GradeLevelCreateModel,
            GradeLevelDto>(
            model, "Create grade level", DialogSize.Medium);

        if (_disposed) return;
        if (created is not null)
        {
            // Refresh the landing so the new (or reused) grade row appears.
            await ReloadAsync();
        }
    }

    /// <summary>
    /// Builds the kebab-menu actions for a single grade row. Edit opens the
    /// Edit dialog (which carries the validation rules + topic multi-select
    /// + tenant override pencil icon — see plan §4); Delete keeps the existing
    /// confirmation pattern. No system-wide coded-value edit surfaces from
    /// this menu (all edits target tenancy override, per the plan).
    /// </summary>
    private IReadOnlyList<RowAction> BuildRowActions(GradeLevelLandingDto row)
    {
        var name = _resolvedNames.TryGetValue(row.Id, out var resolved) ? resolved : row.Name;
        return new List<RowAction>
        {
            RowAction.Callback("Edit", () => OpenEditDialogAsync(row), FluentIcons.Edit),
            RowAction.Callback("Delete", () => OnDeleteAsync(row.Id, name), FluentIcons.Delete),
        };
    }

    /// <summary>
    /// Opens the Edit dialog (DialogShellBase-derived) pre-seeded with the
    /// grade's current validation rules + topic assignments for the current
    /// period. Refreshes the landing on success.
    /// </summary>
    private async Task OpenEditDialogAsync(GradeLevelLandingDto row)
    {
        if (_disposed) return;

        var model = new GradeLevelEditDialog.GradeLevelEditModel
        {
            Id = row.Id,
            CodedValueId = row.CodedValueId,
            CurrentName = _resolvedNames.TryGetValue(row.Id, out var n) ? n : row.Name,
            MinAge = row.MinAge,
            MaxAge = row.MaxAge,
            AllowedGenderCodedValueId = row.AllowedGenderCodedValueId,
        };

        var updated = await DialogService.ShowShellDialogAsync<
            GradeLevelEditDialog,
            GradeLevelEditDialog.GradeLevelEditModel,
            GradeLevelDto>(
            model, $"Edit grade — {model.CurrentName}", DialogSize.Medium);

        if (_disposed) return;
        if (updated is not null)
        {
            await ReloadAsync();
        }
    }

    private async Task OnDeleteAsync(Guid id, string name)
    {
        if (_disposed) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete grade level '{name}'? This cannot be undone if students or topics are assigned.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var previous = _items;
        _items = _items?.Where(x => x.Id != id).ToArray();
        StateHasChanged();

        try
        {
            await Api.DeleteGradeLevelAsync(id);
            if (_disposed) return;
            Logger.LogInformation("Deleted grade level {Id}", id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete grade level {Id}", id);
            _items = previous;
            _error = ex.Message.Contains("referenced", StringComparison.OrdinalIgnoreCase)
                ? "Cannot delete: students or topics are assigned to this grade level."
                : ex.Message;
            StateHasChanged();
        }
    }

    private void OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}