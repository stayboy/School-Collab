@page "/students/grade-levels/create"
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Students.Core.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject VisibleTenantService VisibleTenant
@inject ILogger<GradeLevelWizard> Logger
@implements IDisposable

<PageTitle>New Grade Level</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <TenantGate>
            <ChildContent>
        @if (_activePeriod is null)
        {
            <section class="open-term-panel">
                <FluentCard Style="overflow: visible; height: auto;">
                    <div class="wizard-section-header">
                        <div>
                            <h3>Open a term</h3>
                            <p class="wizard-hint">Before you can add students to a grade, open an academic period for this tenant.</p>
                        </div>
                    </div>

                    @if (_draftPeriods.Count > 0)
                    {
                        <div class="assigned-list">
                            <h4>Existing draft periods</h4>
                            <ul>
                                @foreach (var d in _draftPeriods)
                                {
                                    <li>
                                        <span>@d.Name (@d.StartDate – @d.EndDate)</span>
                                        <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => OpenDraftAsync(d.Id))">Open</FluentButton>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <PeriodForm AutoActivateOnCreate="true"
                                SubmitLabel="Create & Open"
                                CancelRoute="/students/grade-levels"
                                ShowHeader="false"
                                ShowTip="false"
                                ExistingPeriods="_periods"
                                OnSaved="OnPeriodFormSaved" />
                </FluentCard>
            </section>
        }
        else
        {
        <FluentWizard StepperPosition="StepperPosition.Top"
                      StepSequence="WizardStepSequence.Visited"
                      Width="960px"
                      Height="auto"
                      @ref="_wizard"
                      @bind-Value="_stepIndex">
            <Steps>
                @* ── Step 1: Pick a grade coded value, optionally override the tenant name ── *@
                <FluentWizardStep Label="Grade &amp; Subjects"
                                  Summary="Pick a grade and assign subjects"
                                  IconPrevious="@FluentIcons.CheckmarkCircleFilled"
                                  OnChange="OnStep1ChangingAsync">
                    @* Each section below uses a 1/3 + 2/3 split (FluentGrid 12-col
                       system: md="4" for the header + inputs, md="8" for the wider
                       list area on the subject section). The inputs and action
                       buttons live in the first column directly under the section
                       title. *@
                    <FluentGrid Spacing="3" class="wizard-split-section">
                        <FluentGridItem xs="12" md="4">
                            <div class="wizard-split-header">
                                <div class="wizard-split-header-title">
                                    <FluentIcon Icon="@(Icons.Regular.Size24.BuildingGovernment)" Color="@Color.Accent" />
                                    <h3>Grade coded value</h3>
                                </div>
                                <p class="wizard-hint">Pick an existing grade, create a new one, or override the displayed name for your tenant.</p>
                            </div>
                            <div class="wizard-split-inputs">
                                <div class="coded-value-row">
                                    <div class="coded-value-picker">
                                        <CodedValueDropdown @ref="_codedValueDropdown"
                                                            Parent="CodedValueParent.Grades"
                                                            @bind-SelectedId="_codedValueIdNullable"
                                                            @bind-SelectedId:after="OnCodedValueChanged" />
                                    </div>
                                    <div class="coded-value-actions">

                                            <FluentButton Appearance="Appearance.Neutral"
                                                          Title="Override the default name for this tenant"
                                                          OnClick="OpenOverrideDialogAsync"
                                                          Disabled="@(!_codedValueIdNullable.HasValue)">
                                                Override Name
                                            </FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral"
                                                      Title="Create a new grade coded value"
                                                      OnClick="OpenCreateDialogAsync">
                                            New grade
                                        </FluentButton>
                                    </div>
                                </div>
                            </div>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="8">
                            @* Selected grade confirmation lives in the wider
                               second column so the name and override status have
                               room to breathe. Uses native FluentCard /
                               FluentLabel / FluentBadge / FluentMessageBar. *@
                            @if (_selectedCodedValue is not null)
                            {
                                <FluentCard class="grade-confirm-card">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                        <FluentLabel class="grade-confirm-name-large">
                                            @_selectedCodedValue.Name
                                        </FluentLabel>
                                        <FluentStack Orientation="Orientation.Horizontal"
                                                     HorizontalAlignment="HorizontalAlignment.Start"
                                                     VerticalAlignment="VerticalAlignment.Center"
                                                     HorizontalGap="10">
                                            <FluentLabel class="grade-confirm-meta-text">
                                                Code: <strong>@_selectedCodedValue.Code</strong>
                                            </FluentLabel>
                                            @if (_selectedCodedValue.IsOverridden)
                                            {
                                                <FluentBadge Appearance="Appearance.Accent" class="grade-confirm-badge">Overridden</FluentBadge>

                                                    <FluentAnchor Href="#" OnClick="OpenOverrideDialogAsync" class="grade-confirm-reset">Reset to default</FluentAnchor>
                                            }
                                        </FluentStack>
                                    </FluentStack>
                                </FluentCard>
                            }
                            else
                            {
                                <FluentMessageBar Intent="MessageIntent.Info" class="grade-confirm-empty">
                                    No grade selected. Pick a grade coded value on the left to see the selected name and override status here.
                                </FluentMessageBar>
                            }
                        </FluentGridItem>
                    </FluentGrid>

                    <div class="wizard-section-gap" aria-hidden="true"></div>

                    <FluentGrid Spacing="3" class="wizard-split-section">
                        <FluentGridItem xs="12" md="4">
                            <div class="wizard-split-header">
                                <div class="wizard-split-header-title">
                                    <FluentIcon Icon="@(Icons.Regular.Size24.BookmarkMultiple)" Color="@Color.Accent" />
                                    <h3>Assign Subjects</h3>
                                </div>
                                <p class="wizard-hint">Pick a subject coded value to add it to this grade, or create a new one.</p>
                            </div>
                            <div class="wizard-split-inputs">
                                <div class="coded-value-row">
                                    <div class="coded-value-picker">
                                        <CodedValueDropdown @ref="_subjectCodedValueDropdown"
                                                            Parent="CodedValueParent.Subjects"
                                                            @bind-SelectedId="_selectedSubjectCodedValueId"
                                                            @bind-SelectedId:after="OnSubjectCodedValueChanged" />
                                    </div>

                                    @* Last-added subject chip — confirms the most
                                       recent auto-add so the user can see what was
                                       just wired to the grade. Shows an Override
                                       button and Reset link when a real tenant is
                                       in scope (the override is a per-tenant
                                       concept; in default-tenant mode the handler
                                       rewrites the global coded value). *@
                                    @if (_lastAddedSubjectCodedValue is not null)
                                    {
                                        <FluentCard class="grade-confirm-chip">
                                            <FluentStack Orientation="Orientation.Horizontal"
                                                         HorizontalAlignment="HorizontalAlignment.Start"
                                                         VerticalAlignment="VerticalAlignment.Center"
                                                         HorizontalGap="8">
                                                <FluentIcon Icon="@(Icons.Regular.Size20.CheckmarkCircle)" Color="@Color.Accent" />
                                                <span class="grade-confirm-name">@_lastAddedSubjectCodedValue.Name added</span>
                                                @if (_lastAddedSubjectCodedValue.IsOverridden)
                                                {
                                                    <FluentBadge Appearance="Appearance.Accent" class="grade-confirm-badge">Overridden</FluentBadge>
                                                }
                                            </FluentStack>
                                        </FluentCard>
                                    }

                                    <div class="coded-value-actions">
                                        <FluentButton Appearance="Appearance.Neutral"
                                                      Title="Create a new subject coded value"
                                                      OnClick="OpenCreateSubjectDialogAsync">
                                            New subject
                                        </FluentButton>
                                    </div>
                                </div>
                            </div>
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="8">
                            @* List of subjects already assigned to this grade. Lives
                               in the wider second column so long lists can scroll
                               without squeezing the picker column. *@
                            @if (_assignedSubjects.Count > 0)
                            {
                                <div class="assigned-list">
                                    <h4>Subjects assigned to this grade</h4>
                                    <ul>
                                        @foreach (var s in _assignedSubjects)
                                        {
                                            <li>
                                                <span>@s.Name</span>
                                                @if (s.IsOverridden)
                                                {
                                                    <FluentBadge Appearance="Appearance.Accent" class="grade-confirm-badge">Overridden</FluentBadge>
                                                }
                                                <span class="assigned-subject-actions">

                                                        <FluentButton Appearance="Appearance.Lightweight" Title="Override the default name for this tenant" OnClick="@(() => OverrideSubjectAsync(s))" Disabled="@(_overridingSubjectId == s.Id)"><FluentIcon Icon="@(Icons.Regular.Size20.Edit)" /></FluentButton>
                                                    <FluentButton Appearance="Appearance.Lightweight" Title="Remove subject" OnClick="@(() => RemoveSubject(s))" Disabled="@(_overridingSubjectId == s.Id)"><FluentIcon Icon="@(Icons.Regular.Size20.Delete)" /></FluentButton>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <FluentMessageBar Intent="MessageIntent.Info" class="assigned-list-empty">
                                    No subjects assigned yet. Pick a subject coded value on the left to add it to this grade.
                                </FluentMessageBar>
                            }
                        </FluentGridItem>
                    </FluentGrid>

                    @if (!string.IsNullOrEmpty(_step1Error))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_step1Error</FluentMessageBar>
                    }
                </FluentWizardStep>

                @* ── Step 2: Enrol students against the current period ── *@
                <FluentWizardStep Label="Students"
                                  Summary="Enrol students in this grade"
                                  IconPrevious="@FluentIcons.CheckmarkCircleFilled"
                                  OnChange="OnStep2ChangingAsync">
                    @if (_activePeriod is null)
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning">
                            No active period. Open a period before enrolling students.
                        </FluentMessageBar>
                    }
                    else
                    {
                        <section class="wizard-section">
                            <div class="wizard-section-header">
                                <FluentIcon Icon="@(Icons.Regular.Size24.People)" Color="@Color.Accent" />
                                <div>
                                    <h3>Enrol Students</h3>
                                    <p class="wizard-hint">Enrol students into this grade level for the active period (@_activePeriod.Name).</p>
                                </div>
                            </div>

                            @* Inline "new student" form. Collapsed by default so it
                               doesn't crowd the grid; expands when the user clicks
                               "+ New student". This avoids the round-trip out of the
                               wizard to /students/create and back, which was the
                               only way to seed students for a fresh tenant. The
                               toggle button is hidden while the form is open — the
                               form has its own Cancel button (at the bottom of the
                               card) that closes the form, so showing two stacked
                               Cancellable controls would be confusing. The form
                               itself is the shared <StudentFormFields> component
                               used by /students/create and /students/{id}/edit, so
                               the field set and validation stay in lockstep across
                               the three entry points. *@
                            @if (!_showNewStudentForm)
                            {
                                <div class="coded-value-actions">
                                    <FluentButton Appearance="Appearance.Neutral"
                                                  IconStart="@FluentIcons.PersonAdd"
                                                  OnClick="ToggleNewStudentForm">
                                        New student
                                    </FluentButton>
                                </div>
                            }

                            @if (_showNewStudentForm)
                            {
                                <FluentCard class="new-student-card">
                                    <div class="form-section-header">
                                        <div>
                                            <h3>New student</h3>
                                            <p class="form-hint">Required fields are marked with <span class="required-marker">*</span>. The student will be enrolled in this grade as soon as you submit.</p>
                                        </div>
                                    </div>
                                    @* The form uses the shared <StudentFormFields>
                                       component — it owns the date picker, the
                                       CodedValueDropdown for gender, the
                                       equal-width label column, and the action
                                       row. The wizard only contributes the
                                       wrapper card and the hint text. *@
                                    <StudentFormFields Model="_newStudentModel"
                                                       ErrorMessage="@_newStudentError"
                                                       OnValidSubmit="OnCreateStudentAsync">
                                        <Actions>
                                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_creatingStudent">
                                                @(_creatingStudent ? "Creating…" : "Create & enrol")
                                            </FluentButton>
                                            <FluentButton Appearance="Appearance.Outline" OnClick="ToggleNewStudentForm">Cancel</FluentButton>
                                        </Actions>
                                    </StudentFormFields>
                                </FluentCard>
                            }

                            @* Available students grid. The "Enrol" button is
                               disabled for students already enrolled in another
                               grade for this active period (pre-loaded into
                               _alreadyEnrolledStudentIds in OnStep2ChangingAsync).
                               This prevents the user from clicking through to
                               review and only learning on save that the
                               backend rejected the second enrollment. *@
                            @if (_availableStudents.Length == 0 && _assignedStudents.Count == 0 && !_showNewStudentForm)
                            {
                                <FluentMessageBar Intent="MessageIntent.Info" class="mt-3">
                                    No students in this tenant yet. Click <strong>New student</strong> to add the first one.
                                </FluentMessageBar>
                            }
                            else if (_availableStudents.Length > 0)
                            {
                                <div class="grid-container">
                                    <FluentDataGrid Items="@_availableStudents.AsQueryable()" TGridItem="SchoolCollab.Students.Core.DTOs.StudentDto">
                                        <PropertyColumn Property="@(x => x.StudentNumber)" Title="Number" />
                                        <PropertyColumn Property="@(x => x.FirstName)" Title="First Name" />
                                        <PropertyColumn Property="@(x => x.LastName)" Title="Last Name" />
                                        <TemplateColumn Title="Status">
                                            @if (_alreadyEnrolledStudentIds.Contains(context.Id))
                                            {
                                                <span class="muted" title="Already enrolled in another grade for this period.">Already enrolled</span>
                                            }
                                            else
                                            {
                                                <span class="muted">Available</span>
                                            }
                                        </TemplateColumn>
                                        <TemplateColumn Title="Action">
                                            <FluentButton Appearance="Appearance.Lightweight"
                                                          Disabled="@_alreadyEnrolledStudentIds.Contains(context.Id)"
                                                          OnClick="@(() => AddStudent(context))">Enrol</FluentButton>
                                        </TemplateColumn>
                                    </FluentDataGrid>
                                </div>
                            }

                            @if (_assignedStudents.Count > 0)
                            {
                                <div class="assigned-list">
                                    <h4>Enrolled in this grade (@_assignedStudents.Count)</h4>
                                    <ul>
                                        @foreach (var s in _assignedStudents)
                                        {
                                            <li>
                                                <span><strong>@s.StudentNumber</strong> — @s.FirstName @s.LastName</span>
                                                <FluentButton Appearance="Appearance.Lightweight"
                                                              OnClick="@(() => RemoveStudent(s))">Remove</FluentButton>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </section>
                    }

                    @if (!string.IsNullOrEmpty(_step2Error))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_step2Error</FluentMessageBar>
                    }
                </FluentWizardStep>

                @* ── Step 3: Review and save ── *@
                <FluentWizardStep Label="Review"
                                  Summary="Verify and save"
                                  IconPrevious="@FluentIcons.CheckmarkCircleFilled"
                                  DeferredLoading="true">
                    <section class="wizard-section">
                        <div class="wizard-section-header">
                            <FluentIcon Icon="@(Icons.Regular.Size24.Eye)" Color="@Color.Accent" />
                            <div>
                                <h3>Review &amp; Save</h3>
                                <p class="wizard-hint">Verify the details before creating this grade level.</p>
                            </div>
                        </div>

                        <div class="review-card">
                            <div class="review-grid">
                                <div class="review-row">
                                    <span class="review-label">Name</span>
                                    <span class="review-value">@(string.IsNullOrWhiteSpace(ResolvedName) ? "—" : ResolvedName)</span>
                                </div>
                                @if (_selectedCodedValue is not null && !string.IsNullOrWhiteSpace(_selectedCodedValue.Code))
                                {
                                    <div class="review-row">
                                        <span class="review-label">Coded value code</span>
                                        <span class="review-value"><code>@_selectedCodedValue.Code</code></span>
                                    </div>
                                }
                                <div class="review-row">
                                    <span class="review-label">Tenant override</span>
                                    <span class="review-value">
                                        @if (_selectedCodedValue?.IsOverridden == true)
                                        {
                                            <FluentBadge Appearance="Appearance.Accent">Overridden</FluentBadge>
                                        }
                                        else
                                        {
                                            <FluentBadge Appearance="Appearance.Lightweight">None</FluentBadge>
                                        }
                                    </span>
                                </div>
                                <div class="review-row">
                                    <span class="review-label">Current period</span>
                                    <span class="review-value">@(_activePeriod?.Name ?? "No active period")</span>
                                </div>
                            </div>
                        </div>

                        @* Surface what will be wired up at save time, not just
                           the counts — the user must see the actual students and
                           subjects so they can sanity-check before clicking Save. *@
                        <div class="review-card">
                            <h4>Subjects to assign (@_assignedSubjects.Count)</h4>
                            @if (_assignedSubjects.Count == 0)
                            {
                                <FluentMessageBar Intent="MessageIntent.Info">No subjects will be assigned to this grade.</FluentMessageBar>
                            }
                            else
                            {
                                <ul class="review-list">
                                    @foreach (var s in _assignedSubjects)
                                    {
                                        <li>
                                            <span><strong>@s.Code</strong> — @s.Name</span>
                                            @if (s.IsOverridden)
                                            {
                                                <FluentBadge Appearance="Appearance.Accent" class="grade-confirm-badge">Overridden</FluentBadge>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="review-card">
                            <h4>Students to enrol (@_assignedStudents.Count)</h4>
                            @if (_activePeriod is null && _assignedStudents.Count > 0)
                            {
                                <FluentMessageBar Intent="MessageIntent.Warning" class="mb-3">
                                    No active period — these students will be <strong>added to the list but NOT enrolled</strong> on save. Open an active period first, then re-save.
                                </FluentMessageBar>
                            }
                            @if (_assignedStudents.Count == 0)
                            {
                                <FluentMessageBar Intent="MessageIntent.Info">No students will be enrolled in this grade.</FluentMessageBar>
                            }
                            else
                            {
                                <ul class="review-list">
                                    @foreach (var st in _assignedStudents)
                                    {
                                        <li>
                                            <span><strong>@st.StudentNumber</strong> — @st.FirstName @st.LastName</span>
                                        </li>
                                    }
                                </ul>
                            }
                            @if (_enrollSkippedCount > 0)
                            {
                                <FluentMessageBar Intent="MessageIntent.Info" class="mt-3">
                                    @_enrollSkippedCount student(s) were skipped during a previous save attempt (already enrolled in another grade for this period).
                                </FluentMessageBar>
                            }
                        </div>

                        @* Per-phase save status (populated by SaveAsync as it
                           runs). Shows what succeeded, what was skipped, and
                           what failed — much clearer than a single boolean
                           "did the save work". *@
                        @if (_savePhases.Count > 0)
                        {
                            <div class="review-card">
                                <h4>Save status</h4>
                                <ul class="review-list">
                                    @foreach (var phase in _savePhases)
                                    {
                                        <li>
                                            <span><strong>@phase.Name</strong></span>
                                            <FluentBadge Appearance="@PhaseAppearance(phase.Outcome)">@PhaseLabel(phase)</FluentBadge>
                                            @if (!string.IsNullOrEmpty(phase.Detail))
                                            {
                                                <span class="muted"> — @phase.Detail</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" class="mt-3 mb-3">@_error</FluentMessageBar>
                        }
                    </section>
                </FluentWizardStep>
            </Steps>

            <ButtonTemplate Context="stepIndex">
                <div class="wizard-actions">
                    @if (stepIndex > 0)
                    {
                        <FluentButton Appearance="Appearance.Neutral"
                                      IconStart="@FluentIcons.ArrowLeft"
                                      OnClick="@(() => GoToStepAsync(stepIndex - 1))">
                            Back
                        </FluentButton>
                    }

                    <span class="wizard-actions-spacer" aria-hidden="true"></span>

                    @* The wizard footer's own Cancel button is hidden while the
                       inline "new student" form is open — the form has its own
                       Cancel button (toggles the form closed) and showing two
                       Cancellable controls stacked vertically is confusing. The
                       other footer buttons (Back / Continue) stay available so
                       the user can still navigate around the wizard without
                       first having to dismiss the form. *@
                    @if (!_showNewStudentForm)
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="Cancel">Cancel</FluentButton>
                    }

                    @if (stepIndex < 2)
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@FluentIcons.ArrowRight"
                                      OnClick="@(() => GoToStepAsync(stepIndex + 1))"
                                      class="ms-2">
                            Continue
                        </FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@FluentIcons.Save"
                                      Disabled="@_saving" OnClick="SaveAsync"
                                      class="ms-2">
                            @(_saving ? "Saving…" : "Save and Finish")
                        </FluentButton>
                    }
                </div>
            </ButtonTemplate>
        </FluentWizard>
        }
        </ChildContent>
        <Fallback>
            <FluentMessageBar Intent="MessageIntent.Warning">
                You have no tenant assigned. Grade level records are tenant-scoped — pick a tenant to continue.
            </FluentMessageBar>
        </Fallback>
        </TenantGate>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private FluentWizard? _wizard;
    private int _stepIndex;
    private CodedValueDropdown? _codedValueDropdown;
    private Guid? _codedValueIdNullable;
    private CodedValueDto? _selectedCodedValue;
    private string? _error;
    private string? _step1Error;
    private string? _step2Error;
    private bool _saving;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // Current period (date-derived, display only) — same rule as the server:
    // StartDate <= today && EndDate >= today.
    private SchoolCollab.Students.Admin.Services.PeriodDto? _currentPeriod;

    // Active period (status-derived) — gates the wizard's step rendering. When
    // null the wizard shows the "Open a term" entry gate instead of its steps
    // (FR-A6 / Idea C), because Step 2 (enrolment) and Step 3 (review) both
    // require a tenant-scoped period. When a period already exists the user
    // is not asked to confirm it here — the global ActiveTermToolbar in the
    // app header is the single source of truth for "which term is in scope",
    // so the wizard proceeds straight to its steps.
    private SchoolCollab.Students.Admin.Services.PeriodDto? _activePeriod;

    // Draft periods available to "Open" from the entry gate (FR-A6).
    private List<SchoolCollab.Students.Admin.Services.PeriodDto> _draftPeriods = new();

    // Full period list (all statuses) — surfaced to the shared PeriodForm (via
    // ExistingPeriods) so its Backfill action can advance past the latest period.
    private SchoolCollab.Students.Admin.Services.PeriodDto[]? _periods;

    // The resolved name to write into GradeLevel.Name on save (the mirror
    // field). Sourced from the selected coded value, not user-typed.
    private string ResolvedName => _selectedCodedValue?.Name ?? string.Empty;

    // True when the current tenant is a real tenant (not the default/system
    // tenant). Drives the <TenantGate> re-render when the tenant changes
    // mid-session (AuthenticationStateChanged), and guards OnInitializedAsync
    // (skip tenant-scoped loads) and SaveAsync. The wizard's override
    // buttons are no longer gated here — the parent <TenantGate> hides the
    // entire wizard when there is no real tenant.
    //
    // The value is read from the authenticated user's tenant_id claim in
    // OnInitializedAsync (via AuthenticationStateProvider) because the
    // shared ITenantProvider is backed by AsyncLocal and is not reliably
    // available inside a Blazor Server circuit.
    private bool _isRealTenant;

    // Subject coded-value picker (step 1, "Assign Subjects" section). Picking
    // a subject coded value auto-adds it to the grade's assigned list — no
    // separate "Add to grade" button. The picker resets to null after each add
    // so the user can pick another subject immediately.
    private CodedValueDropdown? _subjectCodedValueDropdown;
    private Guid? _selectedSubjectCodedValueId;
    private CodedValueDto? _selectedSubjectCodedValue;

    // Most recently auto-added subject — shown as a compact chip under the
    // picker to confirm the add. Cleared when the user picks a different one.
    private CodedValueDto? _lastAddedSubjectCodedValue;

    // Tracks which subject row is currently opening the override dialog so
    // the row actions can be disabled and the dialog is not reopened.
    private Guid? _overridingSubjectId;

    private List<SchoolCollab.Students.Admin.Services.SubjectDto> _assignedSubjects = new();
    private SchoolCollab.Students.Core.DTOs.StudentDto[] _availableStudents = [];
    private List<SchoolCollab.Students.Core.DTOs.StudentDto> _assignedStudents = new();

    // Students already enrolled in ANOTHER grade for the current active period
    // (populated when entering step 2 via ListEnrollmentsByPeriod). Used to
    // disable the "Enrol" button on the available grid and to skip them in
    // SaveAsync, so the user never reaches a save that the backend will reject
    // with a duplicate-enrollment conflict.
    private HashSet<Guid> _alreadyEnrolledStudentIds = new();

    // Inline "new student" form (step 2). Collapsed by default — clicking
    // "New student" expands the shared <StudentFormFields> EditForm bound to
    // _newStudentModel. On submit we call CreateStudentAsync, refresh
    // _availableStudents, and auto-enrol the new student. The model is the
    // shared <StudentFormModel> used by /students/create and
    // /students/{id}/edit so the three entry points stay in lockstep.
    private bool _showNewStudentForm;
    private bool _creatingStudent;
    private string? _newStudentError;
    private readonly StudentFormModel _newStudentModel = new();

    // Per-phase save status (step 3). Populated by SaveAsync as the save
    // progresses. Cleared on each new save attempt. Shown as a list of badges
    // in the review step so the user can see exactly which phase succeeded,
    // was skipped, or failed.
    private readonly List<SavePhaseStatus> _savePhases = new();
    private int _enrollSkippedCount;

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        // Resolve the tenant from the auth state. The ITenantProvider singleton
        // uses AsyncLocal and is not reliably available in a Blazor Server
        // circuit, so the override actions must read tenant_id directly from
        // the authenticated user's claims.
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RefreshTenantFromAuthStateAsync();

        // No visible tenancy: do not load tenant-scoped data (periods, students)
        // or render the wizard steps. The markup below shows the tenant prompt
        // instead, and SaveAsync is also guarded as defense-in-depth.
        if (!_isRealTenant)
            return;

        // Derive the active/current period once on load (§6.3 / FR-A6) — used by step 2.
        await DerivePeriodsAsync(ct);

        // Eagerly load the students list we'll need in step 2 so the user
        // doesn't see an empty grid the first time they navigate there.
        await LoadStudentsAsync(ct);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        if (_disposed) return;

        try
        {
            // Observe the change (so the awaited task's exception, if any, is
            // observed) then re-resolve the tenant rule from the shared service.
            await task;
            var current = (await VisibleTenant.GetScopeAsync()).IsRealTenant;
            if (current != _isRealTenant)
            {
                _isRealTenant = current;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to handle authentication state change in GradeLevelWizard");
        }
    }

    private async Task RefreshTenantFromAuthStateAsync()
    {
        // Delegate the "real tenant" rule to the shared VisibleTenantService
        // (single source of truth, mirrors GradeLevelWizard's prior claim check).
        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;

        Logger.LogDebug("GradeLevelWizard.RefreshTenantFromAuthStateAsync: _isRealTenant={IsRealTenant}", _isRealTenant);
    }

    private async Task DerivePeriodsAsync(CancellationToken ct)
    {
        try
        {
            var periods = await Api.ListPeriodsAsync(ct) ?? [];
            _periods = periods;
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            // Date-derived "current" — display only.
            _currentPeriod = periods.FirstOrDefault(p => p.StartDate <= today && p.EndDate >= today);
            // Status-derived "active" — gates enrollment / the wizard (FR-A3 / FR-A6).
            _activePeriod = periods.FirstOrDefault(p => p.Status == "Active");
            _draftPeriods = periods.Where(p => p.Status == "Draft").ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to derive periods");
        }
    }

    /// <summary>
    /// Callback fired by the shared <c>PeriodForm</c> after it creates (and, in
    /// the wizard, activates) a period via the "Open a term" gate. Re-derives
    /// the active/current period so the entry gate closes and the wizard steps
    /// render.
    /// </summary>
    private async Task OnPeriodFormSaved(SchoolCollab.Students.Admin.Services.PeriodDto saved)
    {
        var ct = _loadCts?.Token ?? CancellationToken.None;
        await DerivePeriodsAsync(ct);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Maps a period status to a Fluent badge appearance (mirrors the
    /// Periods landing page).</summary>
    private static Appearance GetStatusAppearance(string status) => status switch
    {
        "Draft" => Appearance.Neutral,
        "Active" => Appearance.Accent,
        "Completed" => Appearance.Outline,
        "Archived" => Appearance.Neutral,
        _ => Appearance.Neutral
    };

    /// <summary>
    /// Entry-gate action: activates an existing Draft period, opening it for the
    /// tenant (FR-A6). The create+activate path now lives in the shared
    /// <c>PeriodForm</c> (see <see cref="OnPeriodFormSaved"/>).
    /// </summary>
    private async Task OpenDraftAsync(Guid id)
    {
        try
        {
            await Api.ActivatePeriodAsync(id);

            var ct = _loadCts?.Token ?? CancellationToken.None;
            await DerivePeriodsAsync(ct);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to open draft period {Id}", id);
        }
    }

    private Task OnStep1ChangingAsync(FluentWizardStepChangeEventArgs args)
    {
        if (!_codedValueIdNullable.HasValue || _selectedCodedValue is null)
        {
            args.IsCancelled = true;
            _step1Error = "Please select a grade coded value before continuing.";
        }
        else
        {
            _step1Error = null;
        }
        return Task.CompletedTask;
    }

    private async Task OnStep2ChangingAsync(FluentWizardStepChangeEventArgs args)
    {
        if (_activePeriod is null)
        {
            args.IsCancelled = true;
            _step2Error = "An active period is required to assign subjects and enrol students.";
            return;
        }

        _step2Error = null;

        // Eagerly load the set of students already enrolled in another grade
        // for the current active period, so step 2 can show "Already enrolled"
        // on the available grid and SaveAsync can skip them. Done here (not on
        // mount) because periods are loaded on mount but the per-period
        // enrollment list is the only thing the step 2 grid cares about.
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            var existing = await Api.ListEnrollmentsByPeriodAsync(_activePeriod.Id, ct) ?? [];
            // Only count enrollments that are still active (no exit date) for a
            // *different* grade than the one we're about to create. Since the
            // grade doesn't exist yet, anything in this list is "another grade".
            _alreadyEnrolledStudentIds = existing
                .Where(e => e.ExitDate is null)
                .Select(e => e.StudentId)
                .ToHashSet();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to load already-enrolled students for the active period");
            // Non-fatal — fall through; the worst case is a save that the
            // backend rejects, and the per-phase status will surface it.
        }
    }

    private void OnCodedValueChanged()
    {
        // The bound field (_codedValueIdNullable) is already updated by
        // the @bind-SelectedId binder before :after runs, so we read it
        // directly from the field — no parameter needed. Declared `void`
        // (not `async Task`) so it converts directly to the `Action` that
        // @bind-SelectedId:after expects — call site is a bare method
        // group, no lambda wrapper. The synchronous error-clear runs here
        // so the UI is responsive immediately; the async fetch (or the
        // sync clear-selection null-out) is fire-and-forget.
        _error = null;
        _step1Error = null;

        if (_codedValueIdNullable.HasValue)
        {
            _ = FetchCodedValueAsync();
        }
        else
        {
            _selectedCodedValue = null;
        }
    }

    private async Task FetchCodedValueAsync()
    {
        // Async helper that owns the real work (fetch the CodedValueDto so
        // the review card can show the resolved name + override badge).
        // Fire-and-forget from the :after handler; the try/catch keeps any
        // failure (including the benign navigation/disposal cancellation)
        // out of the unobserved-Task path and surfaces real errors via the
        // logger + the wizard's error banner.
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            _selectedCodedValue = await CodedValuesApi.GetByIdAsync(_codedValueIdNullable!.Value, ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load coded value {CodedValueId}", _codedValueIdNullable);
            _error = ex.Message;
        }
    }

    // ── Grade-coded-value dialog (§6.2) ──────────────────────────────────────

    private async Task OpenOverrideDialogAsync()
    {
        if (!_codedValueIdNullable.HasValue) return;

        // Refresh the dropdown first so the dialog sees the current resolved
        // name (e.g. after a prior override) rather than a stale snapshot.
        if (_codedValueDropdown is not null)
        {
            await _codedValueDropdown.RefreshAsync();
        }

        var cv = await CodedValuesApi.GetByIdAsync(_codedValueIdNullable.Value);
        if (cv is null) return;

        var result = await DialogService.ShowShellDialogAsync<CodedValueDialog, CodedValueFormModel, CodedValueDto>(
            CodedValueFormModel.ForOverride(cv, cv.IsOverridden),
            title: "Override Grade Name");

        if (result is not null)
        {
            if (_codedValueDropdown is not null)
            {
                await _codedValueDropdown.RefreshAsync();
            }
            _selectedCodedValue = await CodedValuesApi.GetByIdAsync(_codedValueIdNullable.Value);
        }
    }

    /// <summary>
    /// Opens the CodedValueDialog in Override mode for a specific subject
    /// coded value and updates the matching row in the assigned-subjects list.
    /// </summary>
    private async Task OverrideSubjectAsync(SchoolCollab.Students.Admin.Services.SubjectDto subject)
    {
        if (_overridingSubjectId == subject.Id) return;
        _overridingSubjectId = subject.Id;

        try
        {
            var updatedCv = await OpenSubjectOverrideDialogCoreAsync(subject.CodedValueId);
            if (updatedCv is not null)
            {
                // Keep the last-added chip in sync if it points to the same
                // coded value that was just overridden from the list.
                if (_lastAddedSubjectCodedValue?.Id == updatedCv.Id)
                {
                    _lastAddedSubjectCodedValue = updatedCv;
                }

                var index = _assignedSubjects.FindIndex(s => s.Id == subject.Id);
                if (index >= 0)
                {
                    _assignedSubjects[index] = _assignedSubjects[index] with
                    {
                        Name = updatedCv.Name,
                        IsOverridden = updatedCv.IsOverridden
                    };
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to override subject {SubjectId}", subject.Id);
            _step1Error = ex.Message;
        }
        finally
        {
            _overridingSubjectId = null;
        }
    }

    /// <summary>
    /// Shared core that opens the subject override dialog for a given coded
    /// value id and returns the freshly resolved coded value after a successful
    /// override/reset. Returns null if the dialog was cancelled or errored.
    /// </summary>
    private async Task<CodedValueDto?> OpenSubjectOverrideDialogCoreAsync(Guid codedValueId)
    {
        // Refresh the dropdown first so the dialog sees the current resolved
        // name (e.g. after a prior override) rather than a stale snapshot.
        if (_subjectCodedValueDropdown is not null)
        {
            await _subjectCodedValueDropdown.RefreshAsync();
        }

        var cv = await CodedValuesApi.GetByIdAsync(codedValueId);
        if (cv is null) return null;

        var updated = await DialogService.ShowShellDialogAsync<CodedValueDialog, CodedValueFormModel, CodedValueDto>(
            CodedValueFormModel.ForOverride(cv, cv.IsOverridden),
            title: "Override Subject Name");

        if (updated is not null)
        {
            if (_subjectCodedValueDropdown is not null)
            {
                await _subjectCodedValueDropdown.RefreshAsync();
            }
            // Return the freshly resolved coded value so callers can update
            // their local UI (chip or assigned-subjects row).
            return await CodedValuesApi.GetByIdAsync(codedValueId);
        }

        return null;
    }

    private async Task OpenCreateDialogAsync()
    {
        var parent = await CodedValuesApi.GetByCodeAsync(CodedValueParent.Grades.ToCode());

        var cvResult = await DialogService.ShowShellDialogAsync<CodedValueDialog, CodedValueFormModel, CodedValueDto>(
            CodedValueFormModel.ForCreate(parent?.Id),
            title: "Create Grade Coded Value");

        if (cvResult is not null)
        {
            if (_codedValueDropdown is not null)
            {
                await _codedValueDropdown.RefreshAsync();
            }
            _codedValueIdNullable = cvResult.Id;
            _selectedCodedValue = cvResult;
        }
    }

    // ── Subjects (coded-value picker pattern) ───────────────────────────────

    /// <summary>
    /// Called by the subject CodedValueDropdown when the user picks a subject
    /// coded value. Auto-adds the subject to the grade's assigned list
    /// (find-or-create by CodedValueId via the API) and shows a compact
    /// confirmation chip. The picker is then reset to null so the user can
    /// pick another subject immediately. Duplicate picks for the same coded
    /// value are no-ops.
    /// </summary>
    private void OnSubjectCodedValueChanged()
    {
        // The bound field (_selectedSubjectCodedValueId) is already updated
        // by the @bind-SelectedId binder before :after runs, so we read it
        // directly from the field — no parameter needed. Declared `void`
        // (not `async Task`) so it converts directly to the `Action` that
        // @bind-SelectedId:after expects — call site is a bare method
        // group, no lambda wrapper. The synchronous guards + error-clear
        // run here so the UI is responsive immediately; the async
        // find-or-create + add is fire-and-forget.
        if (!_selectedSubjectCodedValueId.HasValue) return;
        if (_assignedSubjects.Any(s => s.CodedValueId == _selectedSubjectCodedValueId)) return;

        _step1Error = null;
        _ = AddSubjectFromCodedValueAsync();
    }

    private async Task AddSubjectFromCodedValueAsync()
    {
        // Async helper that owns the real work (fetch the CodedValueDto,
        // find-or-create the Subject, add it to the grade's assignment
        // list). Fire-and-forget from the :after handler; the try/catch
        // keeps any failure (including the benign navigation/disposal
        // cancellation) out of the unobserved-Task path and surfaces
        // real errors via the logger + the wizard's step 1 error banner.
        // The finally resets the picker so the next pick is a fresh
        // selection — without it the dropdown would stay on the same
        // value and the user couldn't re-pick the same subject to add
        // it again (the duplicate guard above would also kick in).
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            // Fetch the coded value so we have the code/name/displayOrder for
            // the Subject entity and for the confirmation chip.
            var cv = await CodedValuesApi.GetByIdAsync(_selectedSubjectCodedValueId!.Value, ct);
            if (cv is null) return;

            // Find-or-create the Subject by CodedValueId so we can add it to
            // the grade's assignment list. If there's no current period we
            // still allow the local add — the GradeSubjectAssignment will be
            // skipped on save and the user can add the assignment later.
            var subject = await Api.GetOrCreateSubjectAsync(new CreateSubjectRequest(
                cv.Id, cv.Code, cv.Name, cv.DisplayOrder), ct);

            _assignedSubjects.Add(subject with { IsOverridden = cv.IsOverridden });
            _lastAddedSubjectCodedValue = cv;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to assign subject {CodedValueId}", _selectedSubjectCodedValueId);
            _step1Error = ex.Message;
        }
        finally
        {
            // Always reset the picker so the next pick is a fresh selection.
            // Without this the dropdown would stay on the same value and the
            // user couldn't re-pick the same subject to add it again (the
            // duplicate guard above would also kick in).
            _selectedSubjectCodedValueId = null;
            _selectedSubjectCodedValue = null;
        }
    }

    private void RemoveSubject(SchoolCollab.Students.Admin.Services.SubjectDto subject)
    {
        _assignedSubjects.Remove(subject);
    }

    /// <summary>
    /// Opens the generic CodedValueDialog in Create mode for a new SUBJECT
    /// coded value. On success, the dropdown is refreshed and the new value
    /// is auto-selected — the picker's SelectedIdChanged handler then
    /// auto-adds the new subject to the grade's assigned list.
    /// </summary>
    private async Task OpenCreateSubjectDialogAsync()
    {
        var parent = await CodedValuesApi.GetByCodeAsync(CodedValueParent.Subjects.ToCode());

        var cvResult = await DialogService.ShowShellDialogAsync<CodedValueDialog, CodedValueFormModel, CodedValueDto>(
            CodedValueFormModel.ForCreate(parent?.Id),
            title: "Create Subject Coded Value");

        if (cvResult is not null)
        {
            // Refresh the subject dropdown so the new value is visible, then
            // select it so the user sees the inline confirmation.
            if (_subjectCodedValueDropdown is not null)
            {
                await _subjectCodedValueDropdown.RefreshAsync();
            }
            _selectedSubjectCodedValueId = cvResult.Id;
            _selectedSubjectCodedValue = cvResult;
        }
    }

    private async Task LoadStudentsAsync(CancellationToken ct)
    {
        try
        {
            var students = await Api.ListStudentsAsync(ct) ?? [];
            // Project to the Core DTO type the wizard state uses (the Api
            // client returns its own StudentDto, but AddStudent and the grid
            // bind against the Core DTO). Hide students already enrolled in
            // another grade for the active period from the available grid —
            // re-enrolling them would fail on the server. They're still in
            // the tenant, just not eligible for THIS grade in THIS period.
            var hidden = _alreadyEnrolledStudentIds;
            _availableStudents = students
                .Select(s => new SchoolCollab.Students.Core.DTOs.StudentDto(
                    s.Id, s.StudentNumber, s.FirstName, s.LastName, s.DateOfBirth, s.GenderCodedValueId, s.IsDeleted, s.CreatedAt, s.UpdatedAt))
                .Where(s => !_assignedStudents.Contains(s) && !hidden.Contains(s.Id))
                .ToArray();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load students");
        }
    }

    private void AddStudent(SchoolCollab.Students.Core.DTOs.StudentDto student)
    {
        if (_assignedStudents.Any(s => s.Id == student.Id)) return;
        if (_alreadyEnrolledStudentIds.Contains(student.Id)) return; // belt-and-braces — grid also disables this row
        _assignedStudents.Add(student);
        _availableStudents = _availableStudents.Where(s => s.Id != student.Id).ToArray();
    }

    private async Task RemoveStudent(SchoolCollab.Students.Core.DTOs.StudentDto student)
    {
        _assignedStudents.Remove(student);
        // Re-derive the available grid in case the removed student wasn't there
        // (defensive — AddStudent moves them out, but a prior save failure or
        // a hot-reload could leave the lists out of sync).
        var ct = _loadCts?.Token ?? CancellationToken.None;
        await LoadStudentsAsync(ct);
    }

    // ── Inline "new student" form (step 2) ──────────────────────────────────

    private void ToggleNewStudentForm()
    {
        _showNewStudentForm = !_showNewStudentForm;
        _newStudentError = null;
        if (!_showNewStudentForm)
        {
            // Reset the form when the user cancels, so a half-filled form
            // doesn't leak into the next open.
            _newStudentModel.StudentNumber = null;
            _newStudentModel.FirstName = null;
            _newStudentModel.LastName = null;
            _newStudentModel.DateOfBirth = null;
            _newStudentModel.GenderCodedValueId = null;
        }
    }

    private async Task OnCreateStudentAsync()
    {
        // The shared form component does all the parsing + validation
        // (date picker, gender dropdown, DataAnnotations). By the time
        // we get here every field on _newStudentModel is already in its
        // final type — DateOnly? for the date, Guid? for the gender —
        // so the request goes out without any string round-tripping.
        _newStudentError = null;

        _creatingStudent = true;
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            var request = new CreateStudentRequest(
                _newStudentModel.StudentNumber!,
                _newStudentModel.FirstName!,
                _newStudentModel.LastName!,
                _newStudentModel.DateOfBirth,
                _newStudentModel.GenderCodedValueId);

            await Api.CreateStudentAsync(request, ct);

            // Refresh the available grid so the just-created student is in it,
            // then auto-enrol them in this grade. The create+enrol pattern
            // matches the "Pick and add" affordance the subjects section uses
            // — minimise the number of clicks to go from "no students" to
            // "students enrolled".
            await LoadStudentsAsync(ct);
            var created = _availableStudents.FirstOrDefault(s => s.StudentNumber == _newStudentModel.StudentNumber);
            if (created is not null)
            {
                AddStudent(created);
            }

            _showNewStudentForm = false;
            _newStudentModel.StudentNumber = null;
            _newStudentModel.FirstName = null;
            _newStudentModel.LastName = null;
            _newStudentModel.DateOfBirth = null;
            _newStudentModel.GenderCodedValueId = null;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create student in wizard");
            _newStudentError = ex.Message;
        }
        finally
        {
            if (!_disposed) _creatingStudent = false;
        }
    }

    // ── Navigation & save ───────────────────────────────────────────────────

    private Task GoToStepAsync(int stepIndex) =>
        _wizard?.GoToStepAsync(stepIndex) ?? Task.CompletedTask;

    private void Cancel() => Nav.NavigateTo("/students/grade-levels");

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _savePhases.Clear();
        _enrollSkippedCount = 0;
        _loadCts ??= new CancellationTokenSource();
        var ct = _loadCts.Token;

        if (!_isRealTenant)
        {
            _error = "You have no tenant assigned. Grade level records are tenant-scoped — pick a tenant to continue.";
            return;
        }

        if (_codedValueIdNullable is null || _selectedCodedValue is null)
        {
            _error = "Please select a grade coded value.";
            return;
        }

        Logger.LogInformation("User initiated create for grade {CodedValueId}", _codedValueIdNullable);

        // Phase 1: grade level. If this fails we don't touch subjects or
        // students — the user can correct and retry without partial state.
        Guid? gradeId = null;
        var gradeError = await RunPhaseAsync("Grade level", async () =>
        {
            var gradeLevel = await Api.GetOrCreateGradeLevelAsync(
                new GetOrCreateGradeLevelRequest(
                    _codedValueIdNullable!.Value,
                    _selectedCodedValue!.DisplayOrder,
                    ResolvedName,
                    _selectedCodedValue.DisplayOrder), ct);
            gradeId = gradeLevel.Id;
            return $"{(gradeLevel.Id == Guid.Empty ? "new" : "existing")} grade level";
        });
        if (gradeError is not null || gradeId is null)
        {
            // Don't proceed — no point wiring subjects/students to a grade
            // that didn't get created.
            return;
        }

        // Phase 2: subjects. We persist these even if there's no active
        // period (subjects are grade-level, not period-scoped), so the user
        // can see the wiring once they open a period. The backend's
        // AssignGradeSubjectAsync requires a period though — guard it.
        if (_activePeriod is not null)
        {
            var subjectFailures = 0;
            foreach (var s in _assignedSubjects)
            {
                try
                {
                    await Api.AssignGradeSubjectAsync(
                        new AssignGradeSubjectRequest(gradeId.Value, s.Id, _activePeriod.Id), ct);
                }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex)
                {
                    if (_disposed) return;
                    subjectFailures++;
                    Logger.LogError(ex, "Failed to assign subject {SubjectId} to grade {GradeId}", s.Id, gradeId);
                }
            }
            var subjectOutcome = subjectFailures == 0
                ? SavePhaseOutcome.Success
                : (subjectFailures == _assignedSubjects.Count ? SavePhaseOutcome.Failed : SavePhaseOutcome.Partial);
            _savePhases.Add(new SavePhaseStatus(
                "Subjects",
                subjectOutcome,
                subjectFailures == 0
                    ? $"{_assignedSubjects.Count} subject(s) assigned for period {_activePeriod.Name}"
                    : $"{_assignedSubjects.Count - subjectFailures}/{_assignedSubjects.Count} assigned; {subjectFailures} failed"));
        }
        else if (_assignedSubjects.Count > 0)
        {
            _savePhases.Add(new SavePhaseStatus(
                "Subjects",
                SavePhaseOutcome.Skipped,
                "No active period — subjects NOT assigned. Open a period then re-save."));
        }

        // Phase 3: students. Pre-skip any student already enrolled in another
        // grade for this period (populated in OnStep2ChangingAsync) — trying
        // to re-enrol them would just blow up with a conflict and confuse the
        // user. The grid disables those rows already; this is defence in depth.
        var studentsToEnrol = _assignedStudents
            .Where(st => !_alreadyEnrolledStudentIds.Contains(st.Id))
            .ToList();
        var skipped = _assignedStudents.Count - studentsToEnrol.Count;
        _enrollSkippedCount = skipped;

        if (_activePeriod is not null && studentsToEnrol.Count > 0)
        {
            var enrolledCount = 0;
            var enrollFailures = 0;
            foreach (var st in studentsToEnrol)
            {
                try
                {
                    await Api.EnrollStudentAsync(
                        new EnrollStudentRequest(st.Id, _activePeriod.Id, gradeId.Value, DateOnly.FromDateTime(DateTime.UtcNow)), ct);
                    enrolledCount++;
                }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex)
                {
                    if (_disposed) return;
                    enrollFailures++;
                    Logger.LogError(ex, "Failed to enrol student {StudentId} in grade {GradeId}", st.Id, gradeId);
                }
            }
            var enrollOutcome = enrollFailures == 0
                ? SavePhaseOutcome.Success
                : (enrollFailures == studentsToEnrol.Count ? SavePhaseOutcome.Failed : SavePhaseOutcome.Partial);
            _savePhases.Add(new SavePhaseStatus(
                "Students",
                enrollOutcome,
                BuildEnrolDetail(studentsToEnrol.Count, enrolledCount, enrollFailures, skipped, _activePeriod.Name)));
        }
        else if (_activePeriod is null && _assignedStudents.Count > 0)
        {
            _savePhases.Add(new SavePhaseStatus(
                "Students",
                SavePhaseOutcome.Skipped,
                $"No active period — {_assignedStudents.Count} student(s) NOT enrolled. Open a period then re-save."));
        }
        else if (skipped > 0)
        {
            _savePhases.Add(new SavePhaseStatus(
                "Students",
                SavePhaseOutcome.Partial,
                BuildEnrolDetail(0, 0, 0, skipped, _activePeriod?.Name ?? "—")));
        }

        Logger.LogInformation("Grade {GradeId} save attempt: subjects={SubjectCount} students={StudentCount}",
            gradeId, _assignedSubjects.Count, _assignedStudents.Count);

        // Don't auto-navigate away on partial failure — the user needs to see
        // the per-phase status in the review step. On full success, navigate.
        var anyFailure = _savePhases.Any(p => p.Outcome is SavePhaseOutcome.Failed or SavePhaseOutcome.Partial);
        if (!anyFailure)
        {
            Nav.NavigateTo("/students/grade-levels");
        }

        // Always reset the save flag at the end so the user can click Save
        // again from the review step (e.g. after fixing a partial failure).
        if (!_disposed) _saving = false;
    }

    /// <summary>
    /// Runs a save phase and wraps the result in a <see cref="SavePhaseStatus"/>.
    /// Returns the phase's error message (if any) so the caller can decide
    /// whether to short-circuit the rest of the save. The phase is added to
    /// <see cref="_savePhases"/> either way so the user always sees what
    /// happened.
    /// </summary>
    private async Task<string?> RunPhaseAsync(string name, Func<Task<string>> action)
    {
        try
        {
            var detail = await action();
            _savePhases.Add(new SavePhaseStatus(name, SavePhaseOutcome.Success, detail));
            return null;
        }
        catch (OperationCanceledException)
        {
            _savePhases.Add(new SavePhaseStatus(name, SavePhaseOutcome.Failed, "Cancelled"));
            return "Cancelled";
        }
        catch (Exception ex)
        {
            if (_disposed) return ex.Message;
            Logger.LogError(ex, "Save phase {Phase} failed", name);
            _error = ex.Message;
            _savePhases.Add(new SavePhaseStatus(name, SavePhaseOutcome.Failed, ex.Message));
            return ex.Message;
        }
    }

    private static string BuildEnrolDetail(int requested, int enrolled, int failed, int skipped, string periodName)
    {
        var parts = new List<string>();
        if (enrolled > 0) parts.Add($"{enrolled} enrolled");
        if (failed > 0) parts.Add($"{failed} failed");
        if (skipped > 0) parts.Add($"{skipped} skipped (already in another grade)");
        if (parts.Count == 0) parts.Add("0 of " + requested);
        parts.Add($"for period {periodName}");
        return string.Join("; ", parts);
    }

    private static Appearance PhaseAppearance(SavePhaseOutcome outcome) => outcome switch
    {
        SavePhaseOutcome.Success => Appearance.Accent,
        SavePhaseOutcome.Partial => Appearance.Neutral,
        SavePhaseOutcome.Skipped => Appearance.Lightweight,
        SavePhaseOutcome.Failed => Appearance.Outline,
        _ => Appearance.Lightweight
    };

    private static string PhaseLabel(SavePhaseStatus phase) => phase.Outcome switch
    {
        SavePhaseOutcome.Success => "Done",
        SavePhaseOutcome.Partial => "Partial",
        SavePhaseOutcome.Skipped => "Skipped",
        SavePhaseOutcome.Failed => "Failed",
        _ => phase.Outcome.ToString()
    };

    public void Dispose()
    {
        _disposed = true;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    // ── Nested types ────────────────────────────────────────────────────────

    /// <summary>
    /// Result of one phase of the save (grade level / subjects / students).
    /// Surfaced in the review step so the user can see exactly which phase
    /// succeeded, was skipped (e.g. no active period), or partially failed.
    /// </summary>
    private sealed record SavePhaseStatus(string Name, SavePhaseOutcome Outcome, string Detail);

    private enum SavePhaseOutcome
    {
        Success,   // every item in the phase was persisted
        Partial,   // some items succeeded, others failed or were skipped
        Skipped,   // the phase was bypassed (e.g. no items, or no active period)
        Failed     // every item failed
    }
}
