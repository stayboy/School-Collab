@* Guardian assignment list for the GradeLevelWizard's Guardians step.
   Mirrors the student enrolled-list UX: a compact per-student list of
   assigned guardians with far-right Edit/Remove icon buttons, plus a single
   "Add guardian" button that opens the GuardianPickerDialog (owned by the
   parent wizard). The component is presentational — it owns the assignment
   state and raises request events; the wizard performs the dialog + API work. *@
@using StudentDto = SchoolCollab.Students.Core.DTOs.StudentDto
@using SchoolCollab.Students.Admin.Components.Students
@using SchoolCollab.Admin.Shared.Constants
@inject ILogger<GuardianAssignmentList> Logger

@if (_students.Count == 0)
{
    <FluentMessageBar Intent="MessageIntent.Info">
        No students enrolled yet. Add students in the previous step, then return here to attach guardians.
    </FluentMessageBar>
}
else
{
    <div class="guardian-assignment-list">
        @foreach (var s in _students)
        {
            var assignments = _assignments.TryGetValue(s.Id, out var list) ? list : null;
            <div class="guardian-student-card">
                <h4><strong>@s.StudentNumber</strong> — @s.FirstName @s.LastName</h4>

                @if (assignments is { Count: > 0 })
                {
                    <ul class="guardian-assigned-list">
                        @for (var i = 0; i < assignments.Count; i++)
                        {
                            var idx = i;
                            var a = assignments[i];
                            <li>
                                <span class="guardian-row-name">
                                    <strong>@a.FirstName @a.LastName</strong>
                                    @if (RelationshipNameLookup is not null)
                                    {
                                        var rel = RelationshipNameLookup(a.RelationshipCodedValueId);
                                        if (!string.IsNullOrEmpty(rel))
                                        {
                                            <span class="muted"> — @rel</span>
                                        }
                                    }
                                    @if (a.ContactValue is not null)
                                    {
                                        <span class="muted"> · @a.ContactChannel: @a.ContactValue</span>
                                    }
                                </span>
                                <span class="guardian-actions">
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  Title="Edit guardian"
                                                  IconStart="@FluentIcons.Edit"
                                                  OnClick="@(() => OnRequestEdit.InvokeAsync((s.Id, idx)))" />
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  Title="Remove guardian"
                                                  IconStart="@FluentIcons.Delete"
                                                  OnClick="@(() => RemoveAssignment(s.Id, idx))" />
                                </span>
                            </li>
                        }
                    </ul>
                }

                <FluentButton Appearance="Appearance.Outline"
                              IconStart="@FluentIcons.PersonAdd"
                              OnClick="@(() => OnRequestAdd.InvokeAsync(s.Id))">
                    Add guardian
                </FluentButton>
                <span class="visually-hidden" aria-live="polite">@GetAddAnnouncement(s.Id)</span>
            </div>
        }
    </div>
}

@code {
    /// <summary>The students enrolled in the current grade; one assignment list per student.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<StudentDto> Students { get; set; } = [];

    /// <summary>Raised when the user clicks "Add guardian" for a student.</summary>
    [Parameter] public EventCallback<Guid> OnRequestAdd { get; set; }

    /// <summary>Raised when the user clicks Edit on an assigned guardian.</summary>
    [Parameter] public EventCallback<(Guid StudentId, int Index)> OnRequestEdit { get; set; }

    /// <summary>Optional resolver for a relationship coded-value id → display name.</summary>
    [Parameter] public Func<Guid?, string?>? RelationshipNameLookup { get; set; }

    private readonly Dictionary<Guid, List<GuardianAssignment>> _assignments = new();
    private readonly Dictionary<Guid, string> _addAnnouncements = new();
    private IReadOnlyList<StudentDto> _students = [];

    protected override void OnParametersSet() => _students = Students;

    /// <summary>Adds an assignment for a student and re-renders the row.</summary>
    public void AddAssignment(Guid studentId, GuardianAssignment assignment)
    {
        if (!_assignments.TryGetValue(studentId, out var list))
        {
            list = new List<GuardianAssignment>();
            _assignments[studentId] = list;
        }
        list.Add(assignment);
        // Brief screen-reader announcement (nonce forces the live region to
        // re-announce on repeated adds).
        _addAnnouncements[studentId] = $"Guardian added. ({Guid.NewGuid():N})";
        StateHasChanged();
    }

    /// <summary>Replaces an existing assignment (edit flow).</summary>
    public void UpdateAssignment(Guid studentId, int index, GuardianAssignment assignment)
    {
        if (_assignments.TryGetValue(studentId, out var list) && index >= 0 && index < list.Count)
        {
            list[index] = assignment;
            StateHasChanged();
        }
    }

    /// <summary>Removes an assignment (kept internal — the list owns its state).</summary>
    public void RemoveAssignment(Guid studentId, int index)
    {
        if (_assignments.TryGetValue(studentId, out var list) && index >= 0 && index < list.Count)
        {
            list.RemoveAt(index);
            if (list.Count == 0) _assignments.Remove(studentId);
            StateHasChanged();
        }
    }

    private string GetAddAnnouncement(Guid studentId)
        => _addAnnouncements.TryGetValue(studentId, out var msg) ? msg : string.Empty;

    /// <summary>
    /// Returns a read-only snapshot of the per-student assignments. Used by the
    /// parent wizard's SaveAsync Phase 4 and Review step.
    /// </summary>
    public IReadOnlyDictionary<Guid, IReadOnlyList<GuardianAssignment>> GetDrafts()
    {
        var snapshot = new Dictionary<Guid, IReadOnlyList<GuardianAssignment>>(_assignments.Count);
        foreach (var kv in _assignments)
            snapshot[kv.Key] = kv.Value;
        return snapshot;
    }

    /// <summary>Drops all assignment state for a single student (called when a student is un-enrolled).</summary>
    public void ClearForStudent(Guid studentId)
    {
        _assignments.Remove(studentId);
        _addAnnouncements.Remove(studentId);
    }
}
