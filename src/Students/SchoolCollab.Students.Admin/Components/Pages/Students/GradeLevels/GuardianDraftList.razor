@* Guardian draft list — the per-student "add guardians" form embedded
   in the GradeLevelWizard's Guardians step (deferred Tier-3, #9; see
   student-guardian-plan.md).

   Owns
   ─────
   * the per-student draft list (GuardianDraft records)
   * the per-student mutable in-progress form (GuardianForm)
   * the per-student screen-reader announcement (re-announces on add)

   Exposes
   ───────
   * GetDrafts() — read-only snapshot of the drafts for the parent
     (used by the wizard's SaveAsync Phase 4 and Review step)
   * ClearForStudent(id) — drop a student's drafts (used by the
     wizard's RemoveStudent to keep the draft dict in sync with
     _assignedStudents)

   Design notes
   ────────────
   * No async load, no API surface, no IDisposable lifecycle —
     the component is purely a stateful presentational helper.
     State is fully scoped to the component instance and
     discarded when the parent re-renders without Students.
   * The state is held in plain dictionaries keyed by StudentDto.Id
     so the component survives a re-render of the parent (e.g.
     when the user toggles a wizard step). When the parent removes
     a student via the public ClearForStudent(id), we drop the
     student's drafts and form state in lockstep.
   * The screen-reader announcement uses a Guid nonce so aria-live
     re-fires on repeated adds (browsers only re-read identical
     live-region text on value change). See PR #77 / Phase 5.

   CSS for this component lives in GuardianDraftList.razor.css
   (scoped via Blazor CSS isolation; the wizard's CSS file no
   longer carries the .guardian-* rules). *@

@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Core.DTOs
@using StudentDto = SchoolCollab.Students.Core.DTOs.StudentDto
@inject ILogger<GuardianDraftList> Logger

@if (_assignedStudents.Count == 0)
{
    <FluentMessageBar Intent="MessageIntent.Info">
        No students enrolled yet. Add students in the previous step, then return here to attach guardians.
    </FluentMessageBar>
}
else
{
    <div class="guardian-student-list">
        @foreach (var s in _assignedStudents)
        {
            var drafts = _drafts.TryGetValue(s.Id, out var d) ? d : null;
            <div class="guardian-student-card">
                <h4><strong>@s.StudentNumber</strong> — @s.FirstName @s.LastName</h4>

                @if (d is { Count: > 0 })
                {
                    <ul class="guardian-draft-list">
                        @for (var i = 0; i < d.Count; i++)
                        {
                            var idx = i;
                            var g = d[i];
                            <li>
                                <span><strong>@g.FirstName @g.LastName</strong> — @g.Role.ToString()</span>
                                @if (g.RelationshipCodedValueId is not null)
                                {
                                    <span class="muted">(relationship set)</span>
                                }
                                <FluentButton Appearance="Appearance.Lightweight"
                                              Title="Remove guardian"
                                              IconStart="@FluentIcons.Delete"
                                              OnClick="@(() => RemoveDraft(s.Id, idx))" />
                            </li>
                        }
                    </ul>
                }

                <div class="guardian-form">
                    <CodedValueDropdown Parent="CodedValueParent.Salutations"
                                        SelectedId="GetForm(s.Id).TitleCodedValueId"
                                        SelectedIdChanged="@(id => GetForm(s.Id).TitleCodedValueId = id)"
                                        Placeholder="Title (optional)" />
                    <FluentTextField @bind-Value="GetForm(s.Id).FirstName" Placeholder="First name" class="gw-guardian-first" />
                    <FluentTextField @bind-Value="GetForm(s.Id).LastName" Placeholder="Last name" class="gw-guardian-last" />
                    <CodedValueDropdown Parent="CodedValueParent.Relationships"
                                        SelectedId="GetForm(s.Id).RelationshipCodedValueId"
                                        SelectedIdChanged="@(id => GetForm(s.Id).RelationshipCodedValueId = id)"
                                        Placeholder="Relationship" />
                    <DropdownForEnum TEnum="GuardianRole"
                                     @bind-SelectedValue="GetForm(s.Id).Role"
                                     Placeholder="Role"
                                     Class="gw-guardian-role" />
                    <DropdownForEnum TEnum="ContactChannel"
                                     @bind-SelectedValue="GetForm(s.Id).Channel"
                                     Placeholder="Channel"
                                     Class="gw-guardian-channel" />
                    <FluentTextField @bind-Value="GetForm(s.Id).ContactValue" Placeholder="Contact value (optional)" class="gw-guardian-contact" />
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@FluentIcons.PersonAdd"
                                  OnClick="@(() => AddDraft(s.Id))"
                                  Disabled="@(string.IsNullOrWhiteSpace(GetForm(s.Id).FirstName) || string.IsNullOrWhiteSpace(GetForm(s.Id).LastName))">
                        Add guardian
                    </FluentButton>
                    <span class="visually-hidden" aria-live="polite">@GetAddAnnouncement(s.Id)</span>
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>The students enrolled in the current grade; one draft list per student.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<StudentDto> Students { get; set; } = [];

    private readonly Dictionary<Guid, List<GuardianDraft>> _drafts = new();
    private readonly Dictionary<Guid, GuardianForm> _forms = new();
    private readonly Dictionary<Guid, string> _addAnnouncements = new();

    private IReadOnlyList<StudentDto> _assignedStudents = [];

    protected override void OnParametersSet()
    {
        // Mirror the parameter to a private field so the @foreach in the
        // template doesn't re-allocate on every render — the field is only
        // reassigned when Students changes.
        _assignedStudents = Students;
    }

    private GuardianForm GetForm(Guid studentId)
    {
        if (!_forms.TryGetValue(studentId, out var form))
        {
            form = new GuardianForm();
            _forms[studentId] = form;
        }
        return form;
    }

    private void AddDraft(Guid studentId)
    {
        var f = GetForm(studentId);
        if (string.IsNullOrWhiteSpace(f.FirstName) || string.IsNullOrWhiteSpace(f.LastName))
            return;
        if (!_drafts.TryGetValue(studentId, out var list))
        {
            list = new List<GuardianDraft>();
            _drafts[studentId] = list;
        }
        list.Add(new GuardianDraft(
            f.FirstName.Trim(),
            f.LastName.Trim(),
            f.RelationshipCodedValueId,
            f.Role,
            string.IsNullOrWhiteSpace(f.ContactValue) ? null : f.Channel,
            string.IsNullOrWhiteSpace(f.ContactValue) ? null : f.ContactValue.Trim(),
            f.TitleCodedValueId));
        _forms[studentId] = new GuardianForm();
        // Brief screen-reader announcement. A nonce forces the live region
        // to re-announce on subsequent adds (browsers only re-read identical
        // live-region text if the value changes).
        _addAnnouncements[studentId] = $"Guardian added. ({Guid.NewGuid():N})";
    }

    private void RemoveDraft(Guid studentId, int index)
    {
        if (_drafts.TryGetValue(studentId, out var list) && index >= 0 && index < list.Count)
        {
            list.RemoveAt(index);
            if (list.Count == 0) _drafts.Remove(studentId);
        }
    }

    private string GetAddAnnouncement(Guid studentId)
        => _addAnnouncements.TryGetValue(studentId, out var msg) ? msg : string.Empty;

    /// <summary>
    /// Returns a read-only snapshot of the per-student draft list. Used by
    /// the parent wizard's SaveAsync Phase 4 and Review step.
    /// </summary>
    public IReadOnlyDictionary<Guid, IReadOnlyList<GuardianDraft>> GetDrafts()
    {
        // Wrap the inner List<GuardianDraft> in a IReadOnlyList to prevent
        // the caller from mutating the child's state. The caller iterates
        // and reads only.
        var snapshot = new Dictionary<Guid, IReadOnlyList<GuardianDraft>>(_drafts.Count);
        foreach (var kv in _drafts)
        {
            snapshot[kv.Key] = kv.Value;
        }
        return snapshot;
    }

    /// <summary>
    /// Drops all draft state (drafts, in-progress form, announcement) for
    /// a single student. Called by the parent when a student is un-enrolled
    /// from the grade.
    /// </summary>
    public void ClearForStudent(Guid studentId)
    {
        _drafts.Remove(studentId);
        _forms.Remove(studentId);
        _addAnnouncements.Remove(studentId);
    }

    // Mutable in-progress form state for one student's "add guardian" row.
    // Internal to the component — not exposed to the parent.
    private sealed class GuardianForm
    {
        public Guid? TitleCodedValueId { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public Guid? RelationshipCodedValueId { get; set; }
        public GuardianRole Role { get; set; } = GuardianRole.Primary;
        // Named "Channel" (not "ContactChannel") so the initializer doesn't
        // shadow the ContactChannel enum type.
        public ContactChannel Channel { get; set; } = ContactChannel.Email;
        public string? ContactValue { get; set; }
    }
}
