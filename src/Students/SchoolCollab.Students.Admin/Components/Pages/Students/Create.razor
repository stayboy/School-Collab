@page "/students/create"
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Admin.Shared.Services
@inject StudentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Create> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<PageTitle>New Student</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" class="page-container">
            <div class="title-row">
                <h1 class="page-title">New Student</h1>
            </div>

            @if (_isRealTenant)
            {
                <EditForm Model="_model" OnValidSubmit="OnSaveAsync" class="form-container">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <FluentTextField Label="Student Number"
                                 @bind-Value="_model.StudentNumber"
                                 Required class="full-width" />
                <FluentTextField Label="First Name"
                                 @bind-Value="_model.FirstName"
                                 Required class="full-width" />
                <FluentTextField Label="Last Name"
                                 @bind-Value="_model.LastName"
                                 Required class="full-width" />
                <FluentTextField Label="Date of Birth (YYYY-MM-DD)"
                                 @bind-Value="_dobString"
                                 class="full-width" />
                <FluentTextField Label="Contact Email"
                                 @bind-Value="_model.ContactEmail"
                                 Required class="full-width" />
                <FluentTextField Label="Contact Phone"
                                 @bind-Value="_model.ContactPhone"
                                 class="full-width" />
                <FluentTextField Label="Gender Coded Value ID (optional)"
                                 @bind-Value="_genderIdString"
                                 class="full-width" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
                }

                <div class="action-bar">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                        @(_saving ? "Saving…" : "Create Student")
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => Nav.NavigateTo("/students"))">Cancel</FluentButton>
                </div>
                </EditForm>
            }
            else
            {
                <FluentMessageBar Intent="MessageIntent.Warning">
                    You have no tenant assigned. Student records are tenant-scoped — pick a tenant to continue.
                </FluentMessageBar>
            }
        </FluentStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private readonly FormModel _model = new();
    private string? _dobString;
    private string? _genderIdString;
    private bool _saving;
    private string? _error;
    private CancellationTokenSource? _saveCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    protected override async Task OnInitializedAsync()
    {
        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
    }

    private async Task OnSaveAsync()
    {
        _saving = true;
        _error = null;

        if (!_isRealTenant) return;

        DateOnly? dateOfBirth = null;
        if (!string.IsNullOrWhiteSpace(_dobString))
        {
            if (!DateOnly.TryParse(_dobString, out var dob))
            {
                _error = "Invalid date format for Date of Birth. Use YYYY-MM-DD.";
                _saving = false;
                return;
            }
            dateOfBirth = dob;
        }

        Guid? genderCodedValueId = null;
        if (!string.IsNullOrWhiteSpace(_genderIdString))
        {
            if (!Guid.TryParse(_genderIdString, out var genderId))
            {
                _error = "Invalid GUID format for Gender Coded Value ID.";
                _saving = false;
                return;
            }
            genderCodedValueId = genderId;
        }

        _saveCts?.Cancel();
        _saveCts?.Dispose();
        _saveCts = new CancellationTokenSource();
        var ct = _saveCts.Token;

        try
        {
            Logger.LogInformation("User initiated create for student {StudentNumber}", _model.StudentNumber);
            var request = new CreateStudentRequest(
                _model.StudentNumber!,
                _model.FirstName!,
                _model.LastName!,
                dateOfBirth,
                genderCodedValueId,
                _model.ContactEmail!,
                _model.ContactPhone);

            await Api.CreateStudentAsync(request, ct);
            Nav.NavigateTo("/students");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create student");
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _saveCts?.Cancel();
        _saveCts?.Dispose();
        _saveCts = null;
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? StudentNumber { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? FirstName { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? LastName { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? ContactEmail { get; set; }

        public string? ContactPhone { get; set; }
    }
}