@* Read-only list of a student's guardian links. Shared by the page-side
   callers (Edit.razor and Detail.razor) — the page owns the API calls and
   the dialog opens (Manage / Edit / Remove) and just passes the data +
   callbacks down to this component.

   This component is intentionally PRESENTATIONAL ONLY:
     - No API calls (the parent calls Api.ListGuardiansByStudentAsync /
       LinkGuardianAsync / UpdateGuardianLinkAsync / UnlinkGuardianAsync).
     - No dialog opens (the parent opens GuardianPickerDialog /
       GuardianFormDialog via ShowShellDialogAsync and reloads on result).
     - No EditForm (the page-level form is the owning EditForm, and
       re-nesting would be invalid HTML; the existing dialog-ui skill
       explicitly forbids nested EditForms / nested dialogs).

   Layout matches the existing per-row pattern used in GuardianAssignmentList
   (the wizard's per-student compact list): each row surfaces
   First / Last / Relationship / Emergency badge / Edit / Remove icon
   buttons in a single flex row, with the count surfaced in a small
   header. The list is empty-state-aware ("No guardians linked yet.").

   The data shape is <see cref="StudentGuardianViewDto"/> — the same
   projection every other guardian list already consumes
   (GuardiansTab.razor, the StudentFormFields linked grid, the wizard's
   GuardianAssignmentList). Carries the link metadata (Role, Relationship,
   EmergencyContact) AND the guardian's display name, so the list renders
   without a second round-trip per guardian. *@
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Students.Core.DTOs
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Landing
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@if (Items is null)
{
    <div class="spinner-container"><FluentProgressRing /></div>
}
else if (Items.Length == 0)
{
    <FluentMessageBar Intent="MessageIntent.Info">@(EmptyMessage ?? "No guardians linked yet.")</FluentMessageBar>
}
else
{
    <div class="student-guardians-list">
        <EntityGrid TItem="StudentGuardianViewDto"
                    Items="Items"
                    GridSettings="GridSettings"
                    EmptyMessage="@(EmptyMessage ?? "No guardians linked yet.")">
            <Columns>
                <TemplateColumn TGridItem="StudentGuardianViewDto" Title="Name" Context="cell">
                    <span class="guardian-name-cell">
                        <span>@(string.IsNullOrWhiteSpace(cell.DisplayName) ? $"{cell.FirstName} {cell.LastName}" : cell.DisplayName)</span>
                        @if (cell.IsEmergencyContact)
                        {
                            <FluentBadge Appearance="Appearance.Accent">Emergency</FluentBadge>
                        }
                    </span>
                </TemplateColumn>
                <TemplateColumn TGridItem="StudentGuardianViewDto" Title="Relationship" Context="cell">
                    @if (cell.RelationshipCodedValueId is { } id
                        && RelationshipNameLookup is not null
                        && !string.IsNullOrEmpty(RelationshipNameLookup(id)))
                    {
                        <span>@RelationshipNameLookup(id)</span>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </TemplateColumn>
                <TemplateColumn TGridItem="StudentGuardianViewDto" Title="Preferred contact" Context="cell">
                    <span>@(cell.PrimaryContactChannel?.ToString() ?? "—")</span>
                </TemplateColumn>
                <TemplateColumn TGridItem="StudentGuardianViewDto" Title="Contact value" Context="cell">
                    <span>@FormatContact(cell)</span>
                </TemplateColumn>
                <TemplateColumn TGridItem="StudentGuardianViewDto" Title="Primary" Context="cell">
                    @if (cell.Role == GuardianRole.Primary)
                    {
                        <FluentIcon Icon="@(Icons.Regular.Size20.CheckmarkCircle)" Color="@Color.Accent" Title="Primary guardian" />
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </TemplateColumn>
                <TemplateColumn TGridItem="StudentGuardianViewDto" Title="" Sortable="false" Context="cell">
                    <FluentStack Orientation="Orientation.Horizontal" Spacing="4">
                        @if (OnEdit.HasDelegate)
                        {
                            <FluentButton Appearance="Appearance.Lightweight"
                                          Title="Edit guardian link"
                                          OnClick="@(() => OnEdit.InvokeAsync(cell))">
                                <FluentIcon Icon="@(Icons.Regular.Size20.Edit)" />
                            </FluentButton>
                        }
                        <FluentButton Appearance="Appearance.Lightweight"
                                      Title="Remove guardian link"
                                      OnClick="@(() => OnRemove.InvokeAsync(cell))">
                            <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                        </FluentButton>
                    </FluentStack>
                </TemplateColumn>
            </Columns>
        </EntityGrid>
    </div>
}

@code {
    /// <summary>The student's currently-linked guardians. Null = loading;
    /// empty array = "no guardians linked yet" (renders the empty state
    /// message). The parent owns the load and passes the projected
    /// <see cref="StudentGuardianViewDto"/> array down.</summary>
    [Parameter] public StudentGuardianViewDto[]? Items { get; set; }

    /// <summary>Optional override for the empty-state message. The
    /// Edit page (which always has the form) uses the default;
    /// the Detail page (which is the dedicated view) passes its
    /// own copy if it wants to vary the wording.</summary>
    [Parameter] public string? EmptyMessage { get; set; }

    /// <summary>Optional resolver for a relationship coded-value id →
    /// display name. Same signature as
    /// <c>GuardianAssignmentList.RelationshipNameLookup</c> so the
    /// wizard and the page share the same name-resolution path.</summary>
    [Parameter] public Func<Guid?, string?>? RelationshipNameLookup { get; set; }

    /// <summary>Fired when the user clicks the per-row Edit button.
    /// Not delegated to → button is hidden (Edit is optional from
    /// pages that only allow link / unlink, e.g. a future bulk
    /// admin view). The page opens <c>GuardianFormDialog</c> in
    /// <c>ForEdit</c> mode and reloads on a non-null result.</summary>
    [Parameter] public EventCallback<StudentGuardianViewDto> OnEdit { get; set; }

    /// <summary>Fired when the user clicks the per-row Remove
    /// button. Always delegated to — removing a link is part of
    /// every page-side flow. The page calls
    /// <c>UnlinkGuardianAsync</c> and reloads.</summary>
    [Parameter] public EventCallback<StudentGuardianViewDto> OnRemove { get; set; }

    private static readonly LandingGridSettings GridSettings = new()
    {
        GridTemplateColumns = "minmax(170px,2fr) minmax(120px,1fr) minmax(120px,1fr) minmax(160px,2fr) minmax(72px,0.5fr) 90px"
    };

    /// <summary>Formats a linked guardian's primary contact value for the
    /// grid's "Contact value" column. Prepends the country dial code (e.g.
    /// "+233") for phone contacts when present (mirrors
    /// <c>ContactsEditor.FormatValue</c>); renders an em-dash placeholder
    /// when the guardian has no contact on file so the column never reads
    /// as blank.</summary>
    private static string FormatContact(StudentGuardianViewDto g)
    {
        if (string.IsNullOrWhiteSpace(g.PrimaryContactValue)) return "—";
        return !string.IsNullOrWhiteSpace(g.PrimaryContactCountryCode)
            ? $"{g.PrimaryContactCountryCode} {g.PrimaryContactValue}"
            : g.PrimaryContactValue!;
    }
}
