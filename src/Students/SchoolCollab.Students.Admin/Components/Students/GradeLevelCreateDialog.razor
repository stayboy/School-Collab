@*
    GradeLevelCreateDialog — opens from the Grade Levels landing's + New
    button. Renders the GRADE picker (required), the enrollment-validation
    guard clauses, and a Subjects multi-select that the admin can fill in
    up front (diff-applied on submit after the grade is created).

    Submit flow (see plan §4.1.3):
      1. Resolve the picked coded value via CodedValuesApi.GetByIdAsync
         (for Name / Level / DisplayOrder mirroring).
      2. Api.GetOrCreateGradeLevelAsync — returns the resolved DTO with
         its Id (works for both brand-new and reused grade rows).
      3. Api.ListGradeSubjectAssignmentsByGradeLevel(gradeId, currentPeriodId)
         → baseline for the diff.
      4. Apply the diff via AssignGradeSubjectAsync / RemoveGradeSubjectAsync.

    The Subjects section is hidden when CurrentPeriodId is null (no active
    period). The grade + validation fields save regardless.
*@
@inherits DialogShellBase<GradeLevelCreateDialog.GradeLevelCreateModel, GradeLevelDto>
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Students.Admin.Services
@using SchoolCollab.Admin.Shared.Constants
@using Microsoft.FluentUI.AspNetCore.Components
@inject CodedValuesApiClient CodedValuesApi
@inject StudentsApiClient Api

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <FormRow Label="Grade" For="grade-level-coded-value" Required="true">
            <CodedValueDropdown Parent="CodedValueParent.Grades"
                                @bind-SelectedId="Model.CodedValueId"
                                @bind-SelectedId:after="OnCodedValueChanged" />
        </FormRow>

        <FormRow Label="Age range" AlignTop>
            <FluentNumberField @bind-Value="Model.MinAge"
                               Id="grade-level-min-age"
                               Min="0"
                               Max="150"
                               Placeholder="No minimum"
                               Style="flex:1; min-width:0"
                               Title="Minimum age (inclusive) for enrolling in this grade. Leave blank for no minimum." />
            <span aria-hidden="true" style="opacity:0.6; padding:0 6px;">–</span>
            <FluentNumberField @bind-Value="Model.MaxAge"
                               Id="grade-level-max-age"
                               Min="0"
                               Max="150"
                               Placeholder="No maximum"
                               Style="flex:1; min-width:0"
                               Title="Maximum age (inclusive) for enrolling in this grade. Leave blank for no maximum." />
        </FormRow>

        <FormRow Label="Allowed Gender" For="grade-level-allowed-gender">
            <CodedValueDropdown Parent="CodedValueParent.Genders"
                                @bind-SelectedId="Model.AllowedGenderCodedValueId"
                                Placeholder="No restriction (co-ed)" />
        </FormRow>

        @if (Model.CurrentPeriodId.HasValue && _allSubjects.Length > 0)
        {
            <FormRow Label="@($"Subjects ({Model.SubjectIds.Count})")" AlignTop>
                <FluentListbox Items="@_allSubjects"
                               @bind-SelectedValues="Model.SubjectIds"
                               OptionText="@(s => s.Name)"
                               OptionValue="@(s => s.Id.ToString())"
                               Multiple="true"
                               Style="width: 100%; min-height: 160px;"
                               Title="Pick which subjects belong to this grade for the current period. Existing assignments will be added; unselected ones will be removed." />
            </FormRow>
        }
        else if (Model.CurrentPeriodId.HasValue && _allSubjects.Length == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info" class="mb-3">
                No subjects exist yet. Create subjects first from the Subjects landing, then reopen this dialog to assign them.
            </FluentMessageBar>
        }
        else
        {
            <FluentMessageBar Intent="MessageIntent.Warning" class="mb-3">
                No active period — open a period before assigning subjects to this grade.
            </FluentMessageBar>
        }

        <DialogShellFooter Saving="@Saving"
                           Error="@Error"
                           SubmitText="Create"
                           SavingText="Creating..."
                           OnCancel="HandleCancelAsync" />
    </EditForm>
</div>

<style>
    .dialog-container { padding: 16px; box-sizing: border-box; width: 100%; }
</style>

@code {
    private SubjectDto[] _allSubjects = [];
    private bool _subjectsLoaded;

    /// <summary>
    /// Editable form model for the Create dialog. Plain class (not record)
    /// because every field is two-way bound (FluentNumberField / FluentSelect
    /// / CodedValueDropdown / FluentListbox) — init-only record properties
    /// reject the @bind-Value assignments the Razor compiler emits.
    /// </summary>
    public sealed class GradeLevelCreateModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public Guid? CodedValueId { get; set; }

        public int? MinAge { get; set; }
        public int? MaxAge { get; set; }
        public Guid? AllowedGenderCodedValueId { get; set; }

        /// <summary>Picked subject ids; bound to the FluentListbox.</summary>
        public IReadOnlyList<Guid> SubjectIds { get; set; } = [];

        /// <summary>
        /// subject id → grade-subject-assignment id for already-assigned subjects
        /// (used by RemoveGradeSubjectAsync on Edit; empty on a brand-new grade).
        /// </summary>
        public IReadOnlyDictionary<Guid, Guid> SubjectIdToAssignmentId { get; set; }
            = new Dictionary<Guid, Guid>();

        public Guid? CurrentPeriodId { get; set; }
    }

    protected override string SubmitText => "Create";

    protected override void OnModelInitialized(GradeLevelCreateModel model)
    {
        // Defensive: nothing extra to seed on Create. The subjects catalog
        // load below runs in OnAfterRenderAsync so the API client has been
        // resolved by the DI scope (the dialog is rendered via ShowDialogAsync
        // which sets up its own scope).
    }

    private async Task LoadSubjectsAsync()
    {
        try
        {
            var all = await Api.ListSubjectsAsync();
            _allSubjects = all ?? [];
            _subjectsLoaded = true;
        }
        catch (Exception ex)
        {
            _allSubjects = [];
            _subjectsLoaded = true;
            Error = $"Could not load subjects: {ex.Message}";
        }
    }

    /// <summary>
    /// The CodedValueDropdown's binder has already updated <c>Model.CodedValueId</c>
    /// by the time this fires. We don't fetch the coded value here — the submit
    /// handler does it in step 1.
    /// </summary>
    private void OnCodedValueChanged() { }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_subjectsLoaded)
        {
            await LoadSubjectsAsync();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task<GradeLevelDto?> SubmitAsync(GradeLevelCreateModel model)
    {
        if (model.CodedValueId is null)
        {
            Error = "Pick a grade coded value.";
            return null;
        }

        // 1. Resolve the picked coded value for Name / Level / DisplayOrder.
        var cv = await CodedValuesApi.GetByIdAsync(model.CodedValueId.Value);
        if (cv is null)
        {
            Error = $"Grade coded value '{model.CodedValueId}' not found.";
            return null;
        }

        // 2. Create-or-reuse the grade row (carries the validation fields too).
        var grade = await Api.GetOrCreateGradeLevelAsync(new GetOrCreateGradeLevelRequest(
            model.CodedValueId.Value,
            cv.DisplayOrder,
            cv.Name,
            cv.DisplayOrder,
            model.MinAge,
            model.MaxAge,
            model.AllowedGenderCodedValueId));

        // 3+4. Apply subject diff for the current period. Failures are non-fatal:
        // surface as a warning above the form but do not block the grade save.
        if (model.CurrentPeriodId.HasValue)
        {
            var warnings = await ApplySubjectDiffAsync(grade.Id, model.CurrentPeriodId.Value, model);
            if (!string.IsNullOrEmpty(warnings))
            {
                Error = warnings; // surfacing via Error message keeps it visible
                                  // inside the dialog footer until the admin
                                  // reviews and dismisses.
            }
        }

        return grade;
    }

    /// <summary>
    /// Applies the picked subject set against the current assignments for the
    /// given grade + period. Returns a non-empty string with any non-fatal
    /// per-subject failure messages (so the dialog footer can show them).
    /// </summary>
    private async Task<string?> ApplySubjectDiffAsync(
        Guid gradeLevelId, Guid periodId, GradeLevelCreateModel model)
    {
        var baseline = await Api.ListGradeSubjectsByGradeAsync(gradeLevelId, periodId) ?? [];
        var assignedSubjectIds = new HashSet<Guid>(baseline.Select(a => a.SubjectId));
        var desiredIds = new HashSet<Guid>(model.SubjectIds);

        var warnings = new List<string>();

        // Add: each desired subject id that isn't already assigned.
        foreach (var sid in desiredIds.Except(assignedSubjectIds))
        {
            try
            {
                await Api.AssignGradeSubjectAsync(
                    new AssignGradeSubjectRequest(gradeLevelId, sid, periodId));
            }
            catch (Exception ex)
            {
                warnings.Add($"Could not assign subject {sid}: {ex.Message}");
            }
        }

        // Remove: each assigned subject id that isn't in the desired set.
        var baselineBySubjectId = baseline.ToDictionary(a => a.SubjectId, a => a.Id);
        foreach (var sid in assignedSubjectIds.Except(desiredIds))
        {
            if (!baselineBySubjectId.TryGetValue(sid, out var assignmentId)) continue;
            try
            {
                await Api.RemoveGradeSubjectAsync(assignmentId);
            }
            catch (Exception ex)
            {
                warnings.Add($"Could not unassign subject {sid}: {ex.Message}");
            }
        }

        return warnings.Count == 0 ? null : string.Join(" • ", warnings);
    }
}