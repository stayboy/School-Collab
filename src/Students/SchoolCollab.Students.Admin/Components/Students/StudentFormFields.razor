@*
    Shared student form fields. Renders the standard "create / edit student"
    field set used by:
      - /students/create  (Create.razor)
      - /students/{id}/edit (Edit.razor)
      - the inline "new student" form inside the GradeLevelWizard step 2

    The component owns the <EditForm>, the <DataAnnotationsValidator />, the
    field rows, AND the action row (Submit / Cancel buttons). Parents supply:
      - the model (bound to <EditForm Model>)
      - the OnValidSubmit handler
      - the action buttons via parameters (SubmitLabel, Submitting,
        SubmittingLabel, ShowCancel, CancelLabel, OnCancel). The action row
        is rendered by the component itself — calling pages do NOT need to
        pass an external <Actions> block for the common case.
      - the horizontal alignment of those buttons via ActionsAlignment
        (Left = default, Right = trailing edge)
      - any visible error message via ErrorMessage

    Advanced: a calling page may still override the entire action row by
    supplying an <Actions> RenderFragment (e.g. a dialog that needs its own
    footer component such as DialogShellFooter). When present, the override
    replaces the built-in buttons.

    Each field row uses the canonical <FormRow> primitive from
    SchoolCollab.Admin.Shared — the repo-wide fixed-width (180px) label
    cell + flexible input cell pattern that guarantees all labels are
    equal-width and every input's left edge lands on the same vertical
    axis. See FormRow.razor for the full pattern.

    A CSS border-top on .form-actions draws the horizontal line that
    separates the field block from the action buttons below (matches
    the established PeriodForm pattern).

    Field types match the server contract directly:
      - DateOfBirth: DateOnly?  (bound to a FluentDatePicker via a
        DateTime? bridge — the picker API only takes DateTime?)
      - GenderCodedValueId: Guid?  (bound to a CodedValueDropdown for
        the GENDER parent)
*@
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Students.Core.DTOs
@using SchoolCollab.Students.Core.Domain
@using StudentDto = SchoolCollab.Students.Admin.Services.StudentDto

<EditForm Model="@Model" OnValidSubmit="@OnValidSubmit" class="@FormClass">
    <DataAnnotationsValidator />

    @* Layout wrapper. Always rendered (even in Bottom mode) so the markup
       is a single shape — the Bottom vs Right difference is purely a
       CSS-Grid-vs-vertical-stack toggle via the .student-form-fields
       (or .student-form-fields--sidebar) class on the EditForm. The
       wrapper itself is display:contents by default in Bottom mode, so
       it doesn't add an extra DOM layer; in Sidebar mode it's
       display:grid with two columns. *@
    <div class="student-form-fields__layout">
        <div class="student-form-fields__fields">

    @* The parent vertical stack controls the row rhythm. Spacing="3" gives
       a comfortable 12px gap between rows — modern forms have generous
       breathing room rather than tight packing. *@
    <FluentStack Orientation="Orientation.Vertical" Spacing="3">
        @* Student number. ReadOnly when editing an existing student (the
           student number is the stable identifier the rest of the app
           keys off; it can't be changed after creation). *@
        <FormRow Label="Student number"
                 Required="@(!ReadOnlyStudentNumber)"
                 For="studentFormNumber">
            <FluentTextField Id="studentFormNumber"
                             @bind-Value="Model.StudentNumber"
                             ReadOnly="@ReadOnlyStudentNumber"
                             Required="@(!ReadOnlyStudentNumber)"
                             Placeholder="e.g. S-2026-001"
                             class="student-form-input--student-number" />
        </FormRow>

        @* Name. First + last sit side-by-side inside the input cell. *@
        <FormRow Label="Name" Required For="studentFormFirstName">
            <FluentTextField Id="studentFormFirstName"
                             @bind-Value="Model.FirstName"
                             Required
                             Placeholder="First name"
                             class="student-form-input--name" />
            <FluentTextField @bind-Value="Model.LastName"
                             Required
                             Placeholder="Last name"
                             class="student-form-input--name" />
        </FormRow>

        @* Date of birth. FluentDatePicker binds to DateTime?, so we
           convert from the model's DateOnly? on the way in and back on
           the way out. Narrow input (160px) — a date picker doesn't
           need more room than that. Required (spec: DOB mandatory). *@
        <FormRow Label="Date of birth" Required For="studentFormDob">
            <FluentDatePicker Id="studentFormDob"
                              Value="@DateOfBirthAsDateTime"
                              ValueChanged="@OnDateOfBirthChanged"
                              Required
                              class="student-form-input--dob" />
        </FormRow>

        @* Gender. Required coded-value dropdown for the GENDER parent
           (spec: gender mandatory). Simple two-way binding — the binder
           updates Model.GenderCodedValueId directly; no callback boilerplate
           needed (the previous OnGenderChanged did nothing but mirror
           the new value into the model). *@
        <FormRow Label="Gender" Required>
            <CodedValueDropdown Parent="CodedValueParent.Genders"
                                @bind-SelectedId="Model.GenderCodedValueId"
                                Placeholder="Select gender"
                                class="student-form-input--gender" />
        </FormRow>

        @* Guardians. Create mode keeps a draft list on the model that the
           parent links after the student is saved; edit mode loads the links
           from the API and links/unlinks immediately. Adding a guardian is an
           INLINE section switch (no nested dialog): "New guardian" reveals the
           shared <GuardianFormFields> component; "Add existing" uses the shared
           <EntityGrid> to search by contact or by student and select guardians.
           The linked/draft list is also rendered with <EntityGrid>. *@
        @if (ShowGuardians)
        {
            <div class="">
                <FluentDivider Orientation="Orientation.Horizontal" Style="width:100%" />
            </div>
            <FormRow Label="Guardians">
                <div class="student-guardians">
                    @if (_loadingGuardians)
                    {
                        <FluentProgressRing />
                    }
                    else
                    {
                        @* ── Linked / drafted guardians (grid list) ── *@
                        <EntityGrid TItem="GuardianGridRow"
                                    Items="GuardianGridRows"
                                    GridSettings="@LinkedGridSettings"
                                    EmptyMessage="@(IsEditMode ? "No guardians linked yet." : "No guardians added yet.")">
                            <Columns>
                                <PropertyColumn Property="@(r => r.FirstName)" Title="First name" TGridItem="GuardianGridRow" TProp="string" />
                                <PropertyColumn Property="@(r => r.LastName)" Title="Last name" TGridItem="GuardianGridRow" TProp="string" />
                                <TemplateColumn TGridItem="GuardianGridRow" Title="Relationship" Context="cell">
                                    <span>@(cell.RelationshipCodedValueId is { } id && _relNames.TryGetValue(id, out var rn) ? rn : "")</span>
                                </TemplateColumn>
                                <TemplateColumn TGridItem="GuardianGridRow" Title="" Sortable="false" Context="cell">
                                    @if (cell.IsEmergencyContact)
                                    {
                                        <FluentBadge Appearance="Appearance.Accent">Emergency</FluentBadge>
                                    }
                                </TemplateColumn>
                                <TemplateColumn TGridItem="GuardianGridRow" Title="" Sortable="false" Context="cell">
                                    <FluentButton Appearance="Appearance.Lightweight" Title="Remove guardian"
                                                  OnClick="@(() => RemoveGuardianRow(cell.Key))">
                                        <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                                    </FluentButton>
                                </TemplateColumn>
                            </Columns>
                        </EntityGrid>

                        @if (!string.IsNullOrEmpty(_guardianError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_guardianError</FluentMessageBar>
                        }

                        @* ── Panel switch: list actions, or the add section ── *@
                        @if (_panelMode == GuardianPanelMode.List)
                        {
                            <FluentStack Orientation="Orientation.Horizontal" Spacing="8" class="guardian-add-buttons">
                                <FluentButton Appearance="Appearance.Outline"
                                              IconStart="@FluentIcons.PersonAdd"
                                              OnClick="StartNewGuardian">New guardian</FluentButton>
                                <FluentButton Appearance="Appearance.Neutral"
                                              IconStart="@FluentIcons.PersonAdd"
                                              OnClick="StartAddExisting">Add existing</FluentButton>
                            </FluentStack>
                        }
                        else
                        {
                            <div class="guardian-add-section">
                                @if (_panelMode == GuardianPanelMode.New)
                                {
                                    <h4 class="guardian-add-title">New guardian</h4>
                                    <GuardianFormFields Model="_newGuardian" />
                                    <FluentStack Orientation="Orientation.Horizontal" Spacing="8" class="guardian-add-actions">
                                        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Button" OnClick="SaveNewGuardianAsync">Add to list</FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral" Type="ButtonType.Button" OnClick="CancelPanel">Cancel</FluentButton>
                                    </FluentStack>
                                }
                                else
                                {
                                    <h4 class="guardian-add-title">Add existing guardian</h4>
                                    <FluentStack Orientation="Orientation.Horizontal" Spacing="4" class="guardian-tabs">
                                        <FluentButton Appearance="@(_existingTab == ExistingTab.Contact ? Appearance.Accent : Appearance.Neutral)"
                                                      Type="ButtonType.Button" OnClick="@(() => SwitchExistingTab(ExistingTab.Contact))">By contact</FluentButton>
                                        <FluentButton Appearance="@(_existingTab == ExistingTab.Student ? Appearance.Accent : Appearance.Neutral)"
                                                      Type="ButtonType.Button" OnClick="@(() => SwitchExistingTab(ExistingTab.Student))">By student</FluentButton>
                                    </FluentStack>

                                    @if (_existingTab == ExistingTab.Contact)
                                    {
                                        <EntityGrid TItem="GuardianPickerRow"
                                                    Items="_pickerRows"
                                                    GridSettings="@PickerGridSettings"
                                                    Loading="_contactLoading"
                                                    EmptyMessage="Type a contact email or phone to search."
                                                    ShowSearch="true"
                                                    SearchChanged="@OnContactSearchAsync"
                                                    SearchPlaceholder="Search by email or phone"
                                                    Selected="_selectedRows"
                                                    SelectedChanged="@OnSelectedRowsChanged"
                                                    GetKey="@(r => r.Id)"
                                                    GetDisplayName="@(r => $"{r.FirstName} {r.LastName}")"
                                                    GetSubtitle="@(r => r.Subtitle)"
                                                    ShowChips="false">
                                            <Columns>
                                                <PropertyColumn Property="@(r => r.FirstName)" Title="First name" TGridItem="GuardianPickerRow" TProp="string" />
                                                <PropertyColumn Property="@(r => r.LastName)" Title="Last name" TGridItem="GuardianPickerRow" TProp="string" />
                                                <TemplateColumn TGridItem="GuardianPickerRow" Title="Contact" Context="cell">
                                                    <span>@cell.Subtitle</span>
                                                </TemplateColumn>
                                            </Columns>
                                        </EntityGrid>
                                    }
                                    else
                                    {
                                        @if (_selectedStudentId is null)
                                        {
                                            <EntityGrid TItem="StudentDto"
                                                        Items="_studentResults"
                                                        GridSettings="@StudentGridSettings"
                                                        Loading="_studentLoading"
                                                        EmptyMessage="Type a student name or number to search."
                                                        ShowSearch="true"
                                                        SearchChanged="@OnStudentSearchAsync"
                                                        SearchPlaceholder="Search students by name or number">
                                                <Columns>
                                                    <PropertyColumn Property="@(s => s.StudentNumber)" Title="Number" TGridItem="StudentDto" TProp="string" />
                                                    <PropertyColumn Property="@(s => s.FirstName)" Title="First name" TGridItem="StudentDto" TProp="string" />
                                                    <PropertyColumn Property="@(s => s.LastName)" Title="Last name" TGridItem="StudentDto" TProp="string" />
                                                    <TemplateColumn TGridItem="StudentDto" Title="" Sortable="false" Context="cell">
                                                        <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => SelectStudentAsync(cell.Id))">Choose</FluentButton>
                                                    </TemplateColumn>
                                                </Columns>
                                            </EntityGrid>
                                        }
                                        else
                                        {
                                            <EntityGrid TItem="GuardianPickerRow"
                                                        Items="_pickerRows"
                                                        GridSettings="@PickerGridSettings"
                                                        EmptyMessage="This student has no guardians."
                                                        Selected="_selectedRows"
                                                        SelectedChanged="@OnSelectedRowsChanged"
                                                        GetKey="@(r => r.Id)"
                                                        GetDisplayName="@(r => $"{r.FirstName} {r.LastName}")"
                                                        GetSubtitle="@(r => r.Subtitle)"
                                                        ShowChips="false">
                                                <Columns>
                                                    <PropertyColumn Property="@(r => r.FirstName)" Title="First name" TGridItem="GuardianPickerRow" TProp="string" />
                                                    <PropertyColumn Property="@(r => r.LastName)" Title="Last name" TGridItem="GuardianPickerRow" TProp="string" />
                                                    <TemplateColumn TGridItem="GuardianPickerRow" Title="Relationship" Context="cell">
                                                        <span>@(cell.RelationshipCodedValueId is { } id && _relNames.TryGetValue(id, out var rn) ? rn : "")</span>
                                                    </TemplateColumn>
                                                </Columns>
                                            </EntityGrid>
                                            <FluentButton Appearance="Appearance.Neutral" Type="ButtonType.Button" OnClick="BackToStudentSearch">Back</FluentButton>
                                        }
                                    }

                                    <FluentStack Orientation="Orientation.Horizontal" Spacing="8" class="guardian-add-actions">
                                        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Button"
                                                      Disabled="@(_selectedRows.Count == 0)"
                                                      OnClick="AddSelectedGuardiansAsync">Add selected</FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral" Type="ButtonType.Button" OnClick="CancelPanel">Cancel</FluentButton>
                                    </FluentStack>
                                }
                            </div>
                        }
                    }
                </div>
            </FormRow>
        }
    </FluentStack>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="student-form-error">@ErrorMessage</FluentMessageBar>
    }

        </div>
        <div class="student-form-fields__sidebar">

    @* Action row. The .form-actions CSS class draws the horizontal line
       (border-top) that separates the field block above from the action
       buttons below, and adds comfortable margin/padding so the line
       breathes. The action buttons are rendered by THIS component (not by
       the calling page): a built-in Submit / Cancel pair driven by the
       SubmitLabel / CancelLabel / OnCancel / Submitting / ShowCancel
       parameters. The ActionsAlignment parameter controls whether the
       buttons hug the left edge (default) or the right / trailing edge
       (via the .form-actions--right modifier). A calling page may still
       override the whole row via the optional <Actions> RenderFragment
       (e.g. a dialog that supplies its own DialogShellFooter). *@
    <div class="form-actions @FormActionsClass">
        @if (Actions is not null)
        {
            @Actions
        }
        else
        {
            <FluentStack Orientation="Orientation.Horizontal" Spacing="8">
                @if (ShowCancel)
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  OnClick="@OnCancel"
                                  Disabled="@Submitting"
                                  class="form-actions__button">
                        @CancelLabel
                    </FluentButton>
                }
                <FluentButton Type="ButtonType.Submit"
                              Appearance="Appearance.Accent"
                              Disabled="@Submitting"
                              class="form-actions__button">
                    @(Submitting ? SubmittingLabel : SubmitLabel)
                </FluentButton>
            </FluentStack>
        }
    </div>

        </div>
    </div>
</EditForm>

@code {
    /// <summary>The class attribute on the rendered <c>&lt;EditForm&gt;</c>.
    /// Composed from the static <c>student-form-fields</c> base plus the
    /// optional <c>student-form-fields--sidebar</c> modifier. Computed in
    /// C# rather than inlined in the attribute value because the EditForm
    /// component's tag-helper parser doesn't tolerate the
    /// <c>class="... @(cond ? ... : null)"</c> pattern (it tries to parse
    /// the whole attribute as a literal string and emits RZ9986).</summary>
    private string FormClass => ActionsPlacement == StudentFormActionsPlacement.Right
        ? "student-form-fields student-form-fields--sidebar"
        : "student-form-fields";

    /// <summary>The class attribute on the rendered <c>.form-actions</c>
    /// div. Composed from the static <c>form-actions</c> base plus the
    /// optional <c>form-actions--right</c> (horizontal alignment) and
    /// <c>form-actions--sidebar</c> (vertical sidebar stack) modifiers.
    /// Computed in C# for the same reason as <see cref="FormClass"/>:
    /// the tag-helper parser doesn't tolerate the
    /// <c>class="... @(cond ? ... : null)"</c> pattern.</summary>
    private string FormActionsClass
    {
        get
        {
            var parts = new List<string> { "form-actions" };
            if (ActionsAlignment == StudentFormActionsAlignment.Right)
                parts.Add("form-actions--right");
            if (ActionsPlacement == StudentFormActionsPlacement.Right)
                parts.Add("form-actions--sidebar");
            return string.Join(" ", parts);
        }
    }

    /// <summary>The form model. Required — the EditForm binds to it.</summary>
    [Parameter, EditorRequired] public StudentFormModel Model { get; set; } = default!;

    /// <summary>Submit handler. Fires only when DataAnnotations validation passes.</summary>
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }

    /// <summary>Action buttons (Submit, Cancel) rendered in the bottom row.
    /// Optional. When supplied, it REPLACES the built-in button row (use this
    /// for special cases such as a dialog that needs its own footer component
    /// like <c>DialogShellFooter</c>). When omitted, the component renders its
    /// own Submit / Cancel buttons driven by the parameters below.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Label on the built-in Submit button. Default: "Save".</summary>
    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>Label shown on the built-in Submit button while <see cref="Submitting"/> is true. Default: "Saving…".</summary>
    [Parameter] public string SubmittingLabel { get; set; } = "Saving…";

    /// <summary>When true, disables the built-in buttons and shows <see cref="SubmittingLabel"/> on Submit. Use to reflect an in-flight save.</summary>
    [Parameter] public bool Submitting { get; set; }

    /// <summary>Whether the built-in Cancel button is shown. Default: true.</summary>
    [Parameter] public bool ShowCancel { get; set; } = true;

    /// <summary>Label on the built-in Cancel button. Default: "Cancel".</summary>
    [Parameter] public string CancelLabel { get; set; } = "Cancel";

    /// <summary>Invoked when the built-in Cancel button is clicked. Optional.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Horizontal alignment of the action buttons. Defaults to
    /// <see cref="StudentFormActionsAlignment.Right"/> so the buttons sit
    /// at the trailing edge of the form (matches the dialog footer);
    /// set to <see cref="StudentFormActionsAlignment.Left"/> to keep them
    /// at the leading edge.</summary>
    [Parameter] public StudentFormActionsAlignment ActionsAlignment { get; set; } = StudentFormActionsAlignment.Right;

    /// <summary>Horizontal alignment of the action buttons.</summary>
    public enum StudentFormActionsAlignment { Left, Right }

    /// <summary>Where the Save / Cancel action buttons are placed. Defaults
    /// to <see cref="StudentFormActionsPlacement.Bottom"/> so the buttons
    /// sit in a horizontal row below the form fields, separated by a
    /// CSS <c>border-top</c>. Set to <see cref="StudentFormActionsPlacement.Right"/>
    /// on long forms (e.g. <c>Edit.razor</c>) so the buttons render in a
    /// sticky vertical sidebar to the right of the fields and stay visible
    /// as the user scrolls.</summary>
    [Parameter] public StudentFormActionsPlacement ActionsPlacement { get; set; } = StudentFormActionsPlacement.Bottom;

    /// <summary>Where the action buttons are placed relative to the form
    /// fields. See <see cref="ActionsPlacement"/>.</summary>
    public enum StudentFormActionsPlacement
    {
        /// <summary>Save / Cancel render in a horizontal row BELOW the
        /// form fields, separated by a border-top on .form-actions. The
        /// original behavior. Use for short forms where a bottom-anchored
        /// action bar makes sense (e.g. Create.razor, the inline
        /// GradeLevelWizard "new student" form).</summary>
        Bottom,

        /// <summary>Save / Cancel render in a vertical column to the RIGHT
        /// of the form fields, inside a CSS Grid two-column layout. The
        /// column is position:sticky so the buttons stay visible as the
        /// user scrolls. Use for long forms where a bottom action bar
        /// can scroll off-screen (e.g. Edit.razor with its identity,
        /// guardians, and direct-contact sub-sections).</summary>
        Right
    }

    /// <summary>When true, the student number field is read-only (used by Edit.razor).</summary>
    [Parameter] public bool ReadOnlyStudentNumber { get; set; }

    /// <summary>Error message to surface above the action row. Optional.</summary>
    [Parameter] public string? ErrorMessage { get; set; }

    // ── DOB bridge: Model.DateOfBirth is DateOnly? but
    //    FluentDatePicker.Value is DateTime?. Convert on the way in
    //    and out so the model keeps the server's contract type. *@

    private DateTime? DateOfBirthAsDateTime => Model.DateOfBirth?.ToDateTime(TimeOnly.MinValue);

    private async Task OnDateOfBirthChanged(DateTime? value)
    {
        Model.DateOfBirth = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
        await Task.CompletedTask;
    }

    // ── Guardians ──────────────────────────────────────────────────────────
    // Create mode: drafts live on Model.GuardianLinks and are linked by the
    // parent after the student is created. Edit mode (StudentId set): links are
    // loaded from the API and added/removed immediately, mirroring the
    // GradeLevelWizard's Phase 4 guardian logic.

    /// <summary>When true, renders the guardian list + add controls. Opt-in so
    /// the shared form can be embedded where guardians are managed elsewhere
    /// (e.g. the GradeLevelWizard inline edit form). Enabled by /students/create
    /// and /students/{id}/edit.</summary>
    [Parameter] public bool ShowGuardians { get; set; }

    /// <summary>Student id for edit mode. Null (default) ⇒ create mode.</summary>
    [Parameter] public Guid? StudentId { get; set; }

    [Inject] private StudentsApiClient Api { get; set; } = default!;
    [Inject] private CodedValuesApiClient CodedValuesApi { get; set; } = default!;
    [Inject] private ILogger<StudentFormFields> Logger { get; set; } = default!;

    private bool IsEditMode => StudentId.HasValue;
    private bool _loadingGuardians;
    private string? _guardianError;
    private List<StudentGuardianViewDto> _links = new();
    private Dictionary<Guid, string> _relNames = new();

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            _loadingGuardians = true;
            try
            {
                await LoadGuardiansAsync(StudentId!.Value, CancellationToken.None);
            }
            finally
            {
                _loadingGuardians = false;
            }
        }
    }

    private async Task LoadGuardiansAsync(Guid studentId, CancellationToken ct)
    {
        _guardianError = null;
        try
        {
            var links = await Api.ListGuardiansByStudentAsync(studentId, ct) ?? [];
            _links = links.ToList();
            _relNames = new Dictionary<Guid, string>();
            foreach (var link in _links.Where(l => l.RelationshipCodedValueId.HasValue))
            {
                var cv = await CodedValuesApi.GetByIdAsync(link.RelationshipCodedValueId!.Value, ct);
                if (cv is not null) _relNames[cv.Id] = cv.Name;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load guardians for student {StudentId}", studentId);
            _guardianError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    // ── Inline guardian add panel (replaces the old nested dialogs) ──
    private enum GuardianPanelMode { List, New, Existing }
    private enum ExistingTab { Contact, Student }

    private GuardianPanelMode _panelMode = GuardianPanelMode.List;
    private ExistingTab _existingTab = ExistingTab.Contact;

    private GuardianAssignmentModel _newGuardian = GuardianAssignmentModel.ForAdd();

    private bool _contactLoading;
    private GuardianPickerRow[] _pickerRows = [];
    private Dictionary<object, GuardianPickerRow> _selectedRows = new();

    private bool _studentLoading;
    private StudentDto[] _studentResults = [];
    private Guid? _selectedStudentId;

    private static readonly LandingGridSettings LinkedGridSettings = new()
    {
        GridTemplateColumns = "minmax(140px,1.5fr) minmax(140px,1.5fr) minmax(120px,1fr) 96px 44px"
    };

    private static readonly LandingGridSettings PickerGridSettings = new()
    {
        GridTemplateColumns = "minmax(160px,2fr) minmax(160px,2fr) minmax(160px,2fr)"
    };

    private static readonly LandingGridSettings StudentGridSettings = new()
    {
        GridTemplateColumns = "minmax(120px,1fr) minmax(160px,2fr) minmax(160px,2fr) 80px"
    };

    /// <summary>Display row for the linked/draft guardian grid.</summary>
    private sealed record GuardianGridRow(
        object Key,
        string FirstName,
        string LastName,
        Guid? RelationshipCodedValueId,
        bool IsEmergencyContact);

    /// <summary>Display row for the "add existing" picker grid.</summary>
    private sealed record GuardianPickerRow(
        Guid Id,
        string FirstName,
        string LastName,
        Guid? RelationshipCodedValueId,
        string? Subtitle);

    // ── Panel navigation ─────────────────────────────────────────────────────
    private void StartNewGuardian() => _panelMode = GuardianPanelMode.New;

    private void StartAddExisting()
    {
        _panelMode = GuardianPanelMode.Existing;
        _existingTab = ExistingTab.Contact;
        _pickerRows = [];
        _selectedRows = new();
        _selectedStudentId = null;
    }

    private void CancelPanel()
    {
        _panelMode = GuardianPanelMode.List;
        _newGuardian = GuardianAssignmentModel.ForAdd();
        _pickerRows = [];
        _selectedRows = new();
        _studentResults = [];
        _selectedStudentId = null;
    }

    private void SwitchExistingTab(ExistingTab tab)
    {
        _existingTab = tab;
        _pickerRows = [];
        _selectedRows = new();
        _selectedStudentId = null;
    }

    private void OnSelectedRowsChanged(Dictionary<object, GuardianPickerRow> next) => _selectedRows = next;

    private GuardianGridRow[] GuardianGridRows
        => IsEditMode
            ? _links.Select(l => new GuardianGridRow(l.GuardianId, l.FirstName, l.LastName, l.RelationshipCodedValueId, l.IsEmergencyContact)).ToArray()
            : Model.GuardianLinks.Select((g, i) => new GuardianGridRow(i, g.FirstName, g.LastName, g.RelationshipCodedValueId, false)).ToArray();

    private async Task RemoveGuardianRow(object key)
    {
        if (IsEditMode && key is Guid gId) await RemoveGuardianAsync(gId);
        else if (!IsEditMode && key is int idx) await RemoveGuardianAsync(idx);
    }

    private void BackToStudentSearch()
    {
        _selectedStudentId = null;
        _pickerRows = [];
    }

    // ── Search: by contact (matches guardian name OR contact value) ───────────
    private async Task OnContactSearchAsync(string? search)
    {
        _selectedRows = new();
        _contactLoading = true;
        var ct = CancellationToken.None;
        try
        {
            var guardians = (await Api.ListGuardiansAsync(ct, string.IsNullOrWhiteSpace(search) ? null : search))?.Take(30).ToArray() ?? [];
            var rows = new List<GuardianPickerRow>();
            foreach (var g in guardians)
            {
                string? contact = null;
                try
                {
                    var contacts = await Api.ListContactsAsync(ContactOwnerType.Guardian, g.Id, ct);
                    contact = contacts?.FirstOrDefault(c => c.IsPrimary)?.Value
                           ?? contacts?.FirstOrDefault()?.Value;
                }
                catch
                {
                    // Non-fatal: contact display is a nicety.
                }
                rows.Add(new GuardianPickerRow(g.Id, g.FirstName, g.LastName, null, contact));
            }
            _pickerRows = rows.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Guardian contact search failed");
            _pickerRows = [];
        }
        finally
        {
            _contactLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Search: by student → list that student's guardians ───────────────────
    private async Task OnStudentSearchAsync(string? search)
    {
        _studentLoading = true;
        var ct = CancellationToken.None;
        try
        {
            _studentResults = await Api.ListStudentsAsync(ct, string.IsNullOrWhiteSpace(search) ? null : search) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Student search failed");
            _studentResults = [];
        }
        finally
        {
            _studentLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectStudentAsync(Guid studentId)
    {
        _selectedStudentId = studentId;
        _selectedRows = new();
        _studentLoading = true;
        var ct = CancellationToken.None;
        try
        {
            var links = await Api.ListGuardiansByStudentAsync(studentId, ct) ?? [];
            var rows = new List<GuardianPickerRow>();
            foreach (var l in links)
            {
                if (l.RelationshipCodedValueId is { } relId)
                    await EnsureRelNameAsync(relId);
                rows.Add(new GuardianPickerRow(l.GuardianId, l.FirstName, l.LastName, l.RelationshipCodedValueId, null));
            }
            _pickerRows = rows.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load the student's guardians");
            _pickerRows = [];
        }
        finally
        {
            _studentLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Add handlers ─────────────────────────────────────────────────────────
    private async Task SaveNewGuardianAsync()
    {
        if (string.IsNullOrWhiteSpace(_newGuardian.FirstName) || string.IsNullOrWhiteSpace(_newGuardian.LastName))
        {
            _guardianError = "First and last name are required.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        _guardianError = null;
        try
        {
            var assignment = new GuardianAssignment(
                null,
                _newGuardian.FirstName!.Trim(),
                _newGuardian.LastName!.Trim(),
                _newGuardian.RelationshipCodedValueId,
                _newGuardian.ContactChannel,
                string.IsNullOrWhiteSpace(_newGuardian.ContactValue) ? null : _newGuardian.ContactValue.Trim(),
                _newGuardian.TitleCodedValueId);
            await AddDraftAsync(assignment);
            _panelMode = GuardianPanelMode.List;
            _newGuardian = GuardianAssignmentModel.ForAdd();
            _pickerRows = [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add new guardian");
            _guardianError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AddSelectedGuardiansAsync()
    {
        _guardianError = null;
        try
        {
            foreach (var row in _selectedRows.Values)
            {
                var assignment = new GuardianAssignment(row.Id, row.FirstName, row.LastName, row.RelationshipCodedValueId, null, null, null);
                await AddDraftAsync(assignment);
            }
            _panelMode = GuardianPanelMode.List;
            _pickerRows = [];
            _selectedRows = new();
            _studentResults = [];
            _selectedStudentId = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add selected guardians");
            _guardianError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Create mode: append a draft to the model. Edit mode: create the
    /// guardian (if new) and link it to the student immediately.</summary>
    private async Task AddDraftAsync(GuardianAssignment assignment)
    {
        if (IsEditMode)
        {
            var ct = CancellationToken.None;
            var guardianId = assignment.ExistingGuardianId
                ?? await Api.CreateGuardianAsync(new CreateGuardianRequest(
                    assignment.TitleCodedValueId, assignment.FirstName, assignment.LastName, null, null, null), ct);
            await Api.LinkGuardianAsync(new LinkGuardianRequest(
                StudentId!.Value, guardianId, assignment.RelationshipCodedValueId, assignment.Role, false, null), ct);
            await LoadGuardiansAsync(StudentId.Value, ct);
        }
        else
        {
            if (assignment.ExistingGuardianId is { } id && Model.GuardianLinks.Any(g => g.ExistingGuardianId == id))
                return;
            Model.GuardianLinks.Add(assignment);
            if (assignment.RelationshipCodedValueId is { } relId)
                await EnsureRelNameAsync(relId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveGuardianAsync(Guid guardianId)
    {
        if (!IsEditMode) return;
        _guardianError = null;
        try
        {
            await Api.UnlinkGuardianAsync(StudentId!.Value, guardianId);
            await LoadGuardiansAsync(StudentId.Value, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to unlink guardian {GuardianId}", guardianId);
            _guardianError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveGuardianAsync(int index)
    {
        if (IsEditMode) return;
        if (index < 0 || index >= Model.GuardianLinks.Count) return;
        Model.GuardianLinks.RemoveAt(index);
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureRelNameAsync(Guid relId)
    {
        if (_relNames.ContainsKey(relId)) return;
        try
        {
            var cv = await CodedValuesApi.GetByIdAsync(relId, CancellationToken.None);
            if (cv is not null) _relNames[cv.Id] = cv.Name;
        }
        catch
        {
            // Non-fatal: the relationship name is only a display nicety.
        }
    }
}
