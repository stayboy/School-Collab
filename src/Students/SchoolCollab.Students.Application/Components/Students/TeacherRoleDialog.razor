@* TeacherRoleDialog — small role-selection dialog for the Teachers card kebab
   "Role" action (section-card-lessons-adoption.md §9 dec 5). Shows a single
   grade-level role dropdown (reusing GradeTeachersDialog's CodedValueDropdown
   binding) and saves via a page-owned callback so the page keeps ownership of
   the SetTeacherGradeLevelRoleAsync call. *@
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Components
@using Microsoft.FluentUI.AspNetCore.Components

<DialogShellBody>
<div class="teacher-role-dialog">
    <FormRow Label="Role">
        <CodedValueDropdown Parent="CodedValueParent.TeacherRoles"
                            @bind-SelectedId="_roleId"
                            Placeholder="No role" />
    </FormRow>
    <div class="dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="CancelAsync">Cancel</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveAsync" class="ms-2">Save</FluentButton>
    </div>
</div>
</DialogShellBody>

@code {
    /// <summary>Keys used in <c>DialogOptions.Parameters</c>. Exposed so
    /// callers set the same keys this dialog binds to — each key MUST match a
    /// <c>[Parameter]</c> name (FluentUI 5.x spreads the entries).</summary>
    public const string CurrentRoleIdKey = nameof(CurrentRoleId);
    public const string SaveKey = nameof(Save);

    /// <summary>The teacher's current grade-level role (to prefill the dropdown).</summary>
    [Parameter] public Guid? CurrentRoleId { get; set; }

    /// <summary>Page-owned save callback (invoked with the chosen role id).</summary>
    [Parameter] public Func<Guid?, Task>? Save { get; set; }

    /// <summary>The hosting dialog instance provided by the dialog host as a
    /// cascading parameter. Nullable so unit tests that render the component
    /// without a host do not NRE.</summary>
    [CascadingParameter] public IDialogInstance? DialogInstance { get; set; }

    private Guid? _roleId;

    protected override void OnInitialized()
    {
        _roleId = CurrentRoleId;
    }

    private async Task SaveAsync()
    {
        if (Save is not null) await Save(_roleId);
        if (DialogInstance is not null) await DialogInstance.CloseAsync();
    }

    private Task CancelAsync() => DialogInstance is null ? Task.CompletedTask : DialogInstance.CloseAsync();
}
