@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@using GradeTopicCurriculumDto = SchoolCollab.Students.Application.Services.GradeTopicCurriculumDto

@* Full list of topics assigned to a grade, shown from the Topics section card's
   "View all" anchor (grade-detail-modern-ui-plan.md §0.4). The page owns the
   API/enrichment and passes the data + action callbacks so this dialog stays
   thin. Each row shows the subject's ENROLLMENT EXCEPTION COUNT
   (subject-period-exception-model.md v8 §5.2), resolved from exceptions, not from
   the bridge row (which carries no period meaning any more) and rendered
   READ-ONLY: the exceptions themselves are managed in the
   EnrollmentExceptionsDialog, which the kebab OPENS with this grade + topic as the
   scope. Reuses the per-topic Strands (strands + lessons, unified) / Teachers dialogs and the Remove flow
   (RemoveTopicAsync on the page).

   The list is a FluentDataGrid (the SubPeriodsListDialog read-only precedent):
   Order | Subject | Strands | Lessons | Exceptions | Actions. The Actions column
   holds ONE control per row — the shared RowActionsMenu kebab — because the repo
   rule puts the row's secondary + destructive actions in the kebab and never in
   duplicated standalone icon buttons (.github/copilot/rules/section-card.md
   §"Kebab actions (RowActionsMenu)"). The kebab carries Edit (→ the page's
   OpenTopicEditAsync, the same flow the card's item name opens) / Strands /
   Teachers / Enrollment exceptions / Remove, and Remove is declared
   destructive: true with a confirmMessage so the SHARED RowActionsMenu enforces
   the prompt — this dialog holds no confirmation logic of its own
   (.github/copilot/rules/blazor-components.md §"Destructive actions require a
   confirmation prompt"). The kebab ALSO carries the explicit-enrolment switch
   (subject-enrollment-requirement-flag.md round B, owner Q39/Q44): it belongs to
   the bridge ROW, because one topic can be assigned to several grades with
   different flags, so the topic edit dialog is the wrong home for it. Its label
   states the state it will produce (never a bare "Toggle") and its confirm names
   the grandfather consequence before the write — a false → true flip enrols the
   whole current roster server-side (FR-ER-7/10), so the admin is told that nobody
   loses the subject rather than finding out afterwards.

   WHY THIS DIALOG READS THE AUDIENCE ITSELF while every WRITE is the page's
   callback: RowActionsMenu shows the confirmation it was HANDED, and the action
   list is built during render — so the count must be known before the click, not
   fetched between the click and the prompt. The switch's write stays the page's,
   like every other action here.

   MANUAL REORDER is the Order column — the row's FIRST
   column, icon-only (move-up/move-down buttons, no position text; the repo's
   reorder affordance — there is no drag-and-drop) — which invokes the page's
   MoveUp/MoveDown callbacks with the row, then swaps the two neighbours locally
   so the grid reflects the move at once. *@
@inject StudentsApiClient Api
@inject ILogger<GradeTopicsDialog> Logger

<DialogShellBody>
<ReadOnlyDialogShell Class="topic-dialog">
    @* The picker and the move error are FIXED above the scroll region, so assigning
       and reordering stay reachable however long the subject list is. The shell wraps
       only the grid below and keeps it at its natural height. *@
    <Toolbar>
        <div class="picker-row">
            <FluentSelect TOption="TopicDto"
                          TValue="TopicDto"
                          Items="UnassignedTopics"
                          OptionText="@(t => t.Name)"
                          OptionValueToString="@(t => t.Id.ToString())"
                          @bind-Value="_topicToAdd"
                          Placeholder="Add a topic…" />
            <FluentButton Appearance="ButtonAppearance.Primary" Size="ButtonSize.Small"
                          OnClick="ConfirmAssignAsync" Disabled="@(_topicToAdd is null || _adding)">Assign</FluentButton>
        </div>

        @if (_moveError is { } moveError)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@moveError</FluentMessageBar>
        }

        @* The switch's own failure — a plain sentence from the seam, never the exception's text. *@
        <FriendlyErrorBar Message="@_switchError" />
    </Toolbar>

    <ChildContent>
        @if (Topics.Length == 0)
        {
            <FluentMessageBar Intent="MessageBarIntent.Info">No topics assigned to this grade yet.</FluentMessageBar>
        }
        else
        {
            @* The grid keeps its NATURAL height (no flex grow — see the shell) and
               GenerateHeaderOption.Sticky marks the header row `row-type="sticky-header"`,
               so only the BODY scrolls under a fixed header, inside the shell's one scroll
               region. *@
            <FluentDataGrid TGridItem="GradeTopicCurriculumDto"
                            Items="Topics.AsQueryable()"
                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                            GridTemplateColumns="auto minmax(140px,2fr) 90px 80px 110px 130px"
                            Class="topic-dialog__grid"
                            AriaLabel="Subjects">
                <TemplateColumn TGridItem="GradeTopicCurriculumDto" Title="Order">
                    <div class="topic-dialog__order">
                        @if (ReorderEnabled)
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                          IconStart="@FluentIcons.ChevronUp"
                                          Title="Move up"
                                          AriaLabel="@($"Move {context.Name} up")"
                                          Disabled="@(_adding || OrderOf(context) <= 0)"
                                          OnClick="@(() => MoveAsync(OrderOf(context), OrderOf(context) - 1, MoveUp))" />
                            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                          IconStart="@FluentIcons.ChevronDown"
                                          Title="Move down"
                                          AriaLabel="@($"Move {context.Name} down")"
                                          Disabled="@(_adding || OrderOf(context) >= Topics.Length - 1)"
                                          OnClick="@(() => MoveAsync(OrderOf(context), OrderOf(context) + 1, MoveDown))" />
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn TGridItem="GradeTopicCurriculumDto" Title="Subject">
                    <div class="topic-dialog__main">
                        <span class="topic-name">@context.Name</span>
                        @if (!string.IsNullOrWhiteSpace(context.Code))
                        {
                            <span class="topic-code">@context.Code</span>
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn TGridItem="GradeTopicCurriculumDto" Title="Strands">
                    <FluentLink Appearance="LinkAppearance.Default" OnClick="@(() => OpenStrandsAsync(context))" Title="Strands">
                        @context.StrandCount
                    </FluentLink>
                </TemplateColumn>
                <TemplateColumn TGridItem="GradeTopicCurriculumDto" Title="Lessons">
                    <span class="topic-dialog__count" title="@context.LessonCount lessons">@context.LessonCount</span>
                </TemplateColumn>
                <TemplateColumn TGridItem="GradeTopicCurriculumDto" Title="Exceptions">
                    @if (ExceptionCount(context.TopicId) is var exceptionCount and > 0)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Filled" Title="Enrollment exceptions">
                            @EnrollmentExceptionLabels.FormatCount(exceptionCount)
                        </FluentBadge>
                    }
                </TemplateColumn>
                <TemplateColumn TGridItem="GradeTopicCurriculumDto" Title="Actions">
                    <div class="topic-dialog__actions">
                        <RowActionsMenu Actions="@BuildRowActions(context)"
                                        AriaLabel="Topic actions"
                                        UseMenuService="false" />
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        }
    </ChildContent>
    <Footer>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CloseAsync">Close</FluentButton>
    </Footer>
</ReadOnlyDialogShell>
</DialogShellBody>

@code {
    /// <summary>Keys used in <c>DialogOptions.Parameters</c>. Exposed so
    /// callers set the same keys this dialog binds to — each key MUST match a
    /// <c>[Parameter]</c> name (FluentUI 5.x spreads the entries).</summary>
    public const string TopicsKey = nameof(Topics);
    public const string UnassignedTopicsKey = nameof(UnassignedTopics);
    public const string OpenStrandsKey = nameof(OpenStrands);
    public const string OpenTeachersKey = nameof(OpenTeachers);
    public const string RemoveKey = nameof(Remove);
    public const string AssignKey = nameof(Assign);
    public const string OnChangedKey = nameof(OnChanged);
    public const string EditKey = nameof(Edit);
    public const string MoveUpKey = nameof(MoveUp);
    public const string MoveDownKey = nameof(MoveDown);

    /// <summary>The grade whose subject list this is, from its host page. The enrolment
    /// switch needs it to ask <c>GET /students/topic-enrollment</c> how many students a
    /// <c>false → true</c> flip would grandfather (FR-ER-8).</summary>
    public const string GradeLevelIdKey = nameof(GradeLevelId);

    /// <summary>Receives the enrolment switch's write: (row, newValue). The PAGE performs it —
    /// one callback per action, like every other write here.</summary>
    public const string SetRequiresEnrollmentKey = nameof(SetRequiresEnrollment);

    /// <summary>Receives the callback that OPENS the EnrollmentExceptionsDialog for a
    /// topic id, scoped to this dialog's grade owner. Provided by the page (which owns
    /// the dialog service), like the other callbacks here.</summary>
    public const string OpenEnrollmentExceptionsKey = nameof(OpenEnrollmentExceptions);

    /// <summary>Topic id → how many enrollment exceptions it carries, so the row can show
    /// the count badge. A COUNT, not the exception list: the badge never lists spans, and
    /// a count map cannot collide on a repeated topic key.</summary>
    public const string ExceptionCountsByTopicKey = nameof(ExceptionCountsByTopic);

    // Topics / UnassignedTopics are mutable (the dialog reassigns them on
    // remove/assign/move), so they are field-backed [Parameter]s: Blazor only
    // re-applies a parameter whose value reference changed, so the local
    // reassignment survives the next render.
    private GradeTopicCurriculumDto[] _topics = [];
    private TopicDto[] _unassigned = [];

    /// <summary>The topics assigned to the grade. Required — no default.</summary>
    [Parameter] public GradeTopicCurriculumDto[] Topics { get => _topics; set => _topics = value; }

    /// <summary>The grade's topics not yet assigned, offered by the picker.</summary>
    [Parameter] public TopicDto[] UnassignedTopics { get => _unassigned; set => _unassigned = value; }

    [Parameter] public Func<GradeTopicCurriculumDto, Task>? OpenStrands { get; set; }
    [Parameter] public Func<GradeTopicCurriculumDto, Task>? OpenTeachers { get; set; }
    [Parameter] public Func<GradeTopicCurriculumDto, Task>? Edit { get; set; }
    [Parameter] public Func<GradeTopicCurriculumDto, Task>? MoveUp { get; set; }
    [Parameter] public Func<GradeTopicCurriculumDto, Task>? MoveDown { get; set; }

    /// <summary>The grade whose subjects these are. Supplied by the host page so the enrolment
    /// switch can read the subject's audience size for its confirm. Absent (empty) only in a unit
    /// test that does not exercise the switch — the switch's confirm then states the consequence
    /// without a number rather than failing.</summary>
    [Parameter] public Guid GradeLevelId { get; set; }

    /// <summary>Performs the explicit-enrolment switch: <c>(row, newValue)</c>. The page writes it
    /// (the row's bridge <c>AssignmentId</c> identifies the grade's entry). A THROWN exception means
    /// the write failed and is what this dialog turns into the user's plain sentence — the callback
    /// must not swallow it, or the failure would have no surface (unlike <see cref="Assign"/>, which
    /// has to return an id either way).</summary>
    [Parameter] public Func<GradeTopicCurriculumDto, bool, Task>? SetRequiresEnrollment { get; set; }
    [Parameter] public Func<Guid, Task>? Remove { get; set; }

    /// <summary>Assigns the picked topic and RETURNS the created bridge assignment id,
    /// so the row appended below carries the real id its reorder buttons PUT against.</summary>
    [Parameter] public Func<Guid, Task<Guid>>? Assign { get; set; }
    [Parameter] public Func<Task>? OnChanged { get; set; }
    [Parameter] public Func<Guid, Task>? OpenEnrollmentExceptions { get; set; }
    [Parameter] public Dictionary<Guid, int>? ExceptionCountsByTopic { get; set; }

    /// <summary>Reorder controls render only when BOTH move callbacks arrived —
    /// a caller that wires just one has no coherent move semantics.</summary>
    private bool ReorderEnabled => MoveUp is not null && MoveDown is not null;

    /// <summary>The hosting dialog instance provided by the dialog host as a
    /// cascading parameter. Nullable so unit tests that render the component
    /// without a host do not NRE.</summary>
    [CascadingParameter] public IDialogInstance? DialogInstance { get; set; }

    private TopicDto? _topicToAdd;
    private bool _adding;
    private string? _moveError;
    private string? _switchError;

    /// <summary>Topic id → how many students the subject's grade holds today (the enrolment
    /// audience). Read once when the dialog opens, so the switch's confirm can name the number
    /// it would grandfather — see the file's comment on why this is not a page callback.</summary>
    private readonly Dictionary<Guid, int> _audienceSizeByTopic = new();

    protected override async Task OnInitializedAsync()
    {
        if (GradeLevelId == Guid.Empty) return;

        var readings = await Task.WhenAll(_topics.Select(async topic =>
            (topic.TopicId, Audience: await ReadAudienceSizeAsync(topic.TopicId))));

        foreach (var (topicId, audience) in readings)
        {
            if (audience is { } size) _audienceSizeByTopic[topicId] = size;
        }
    }

    /// <summary>The subject's audience size, or null when the read failed. A count is not worth
    /// failing a dialog open over: the confirm then states the consequence without a number.</summary>
    private async Task<int?> ReadAudienceSizeAsync(Guid topicId)
    {
        try
        {
            var enrollment = await Api.GetTopicEnrollmentAsync(GradeLevelId, topicId);
            return enrollment?.Audience.Length;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Could not read the enrolment audience for topic {TopicId} in grade {GradeLevelId}",
                topicId, GradeLevelId);
            return null;
        }
    }

    /// <summary>The row's 0-based position in the grid's own list — the order the
    /// curriculum read returned, i.e. the bridge <c>DisplayOrder</c>.</summary>
    private int OrderOf(GradeTopicCurriculumDto topic) =>
        Array.FindIndex(_topics, t => t.AssignmentId == topic.AssignmentId);

    private async Task OpenStrandsAsync(GradeTopicCurriculumDto topic)
    {
        if (OpenStrands is not null) await OpenStrands(topic);
    }

    private async Task OpenTeachersAsync(GradeTopicCurriculumDto topic)
    {
        if (OpenTeachers is not null) await OpenTeachers(topic);
    }

    /// <summary>The kebab's Edit action — the page's existing topic edit dialog,
    /// the same flow the card's item name opens.</summary>
    private async Task EditAsync(GradeTopicCurriculumDto topic)
    {
        if (Edit is not null) await Edit(topic);
    }

    private IReadOnlyList<RowAction> BuildRowActions(GradeTopicCurriculumDto topic)
    {
        var actions = new List<RowAction>();

        // Edit LEADS the kebab: with the standalone icon shortcut gone it is the
        // row's only edit affordance, so it renders whenever the page wired the
        // callback — the same conditional shape as the Enrollment-exceptions entry.
        if (Edit is not null)
        {
            actions.Add(RowAction.Callback("Edit", () => EditAsync(topic), FluentIcons.Edit));
        }

        actions.Add(RowAction.Callback("Strands", () => OpenStrandsAsync(topic), FluentIcons.TextBulletList));
        actions.Add(RowAction.Callback("Teachers", () => OpenTeachersAsync(topic), FluentIcons.People));

        // OPENS the EnrollmentExceptionsDialog (spec §5.2 row 3, v8) — the shell already
        // owns the chrome, so the dialog shows a count only and nothing is edited inline.
        if (OpenEnrollmentExceptions is { } openExceptions)
        {
            actions.Add(RowAction.Callback("Enrollment exceptions", () => openExceptions(topic.TopicId), FluentIcons.Calendar));
        }

        // The explicit-enrolment switch (round B, owner Q39/Q44). The LABEL states what the click
        // will DO — "Require…" when it is off, "Stop requiring…" when it is on — so the row's
        // current state is readable from the menu and no bare "Toggle" is offered.
        // `destructive: true` is the shared menu's ONLY confirmation switch; the write is not
        // destructive (a false → true flip grandfathers instead of removing), but it changes who
        // receives the subject, so it must be confirmed — see the round doc P4.
        if (SetRequiresEnrollment is not null)
        {
            actions.Add(RowAction.Callback(
                topic.RequiresEnrollment ? "Stop requiring explicit enrolment" : "Require explicit enrolment",
                () => SwitchRequiresEnrollmentAsync(topic),
                topic.RequiresEnrollment ? FluentIcons.People : FluentIcons.PersonAdd,
                disabled: _adding,
                destructive: true,
                confirmMessage: RequiresEnrollmentConfirmation(topic)));
        }

        actions.Add(RowAction.Separator());
        actions.Add(RowAction.Callback(
            "Remove",
            () => RemoveAsync(topic),
            FluentIcons.Delete,
            destructive: true,
            confirmMessage: RemoveConfirmation(topic)));

        return actions;
    }

    private static string RemoveConfirmation(GradeTopicCurriculumDto topic) =>
        $"Remove subject '{topic.Name}' from this grade? The subject stays in the catalog; only this grade's assignment is removed.";

    /// <summary>
    /// The switch's confirm, naming the GRANDFATHER consequence before the write (FR-ER-8/10):
    /// flipping to <c>true</c> enrols every current grade member, so nobody loses the subject;
    /// flipping back to <c>false</c> keeps the rows as history and enrols the grade by implication
    /// (FR-ER-9). The audience number is the pre-write count read when the dialog opened; without it
    /// (a failed read) the sentence states the same consequence without a number.
    /// </summary>
    private string RequiresEnrollmentConfirmation(GradeTopicCurriculumDto topic) =>
        topic.RequiresEnrollment
            ? $"Stop requiring explicit enrolment for '{topic.Name}'? Every student in this grade gets the "
              + "subject again. The enrolment records already made are kept as history, so nothing is lost."
            : $"Require explicit enrolment for '{topic.Name}'? {GrandfatherSentence(topic)} Then only the "
              + "students you enrol will get it.";

    private string GrandfatherSentence(GradeTopicCurriculumDto topic) =>
        _audienceSizeByTopic.TryGetValue(topic.TopicId, out var size)
            ? $"This enrols all {size} student{(size == 1 ? string.Empty : "s")} in this grade now, so nobody "
              + "loses the subject."
            : "This enrols every student in this grade now, so nobody loses the subject.";

    /// <summary>
    /// Flips the row's flag through the page's callback, then reflects the change in the dialog's own
    /// list so the row reads its new state without reopening anything. A failure leaves the row
    /// untouched and renders the site's plain sentence — the exception itself is logged, never shown.
    /// </summary>
    private async Task SwitchRequiresEnrollmentAsync(GradeTopicCurriculumDto topic)
    {
        if (_adding || SetRequiresEnrollment is null) return;

        var next = !topic.RequiresEnrollment;
        _adding = true;
        _switchError = null;
        try
        {
            await SetRequiresEnrollment(topic, next);

            Topics = Topics
                .Select(t => t.AssignmentId == topic.AssignmentId ? t with { RequiresEnrollment = next } : t)
                .ToArray();
            // The kebab is a CHILD component, so its click re-renders RowActionsMenu only — without
            // this the row would keep offering the action it has just performed
            // (section-card.md §"Reload after child-triggered mutations").
            StateHasChanged();
            if (OnChanged is not null) await OnChanged();
        }
        catch (Exception ex)
        {
            _switchError = FriendlyError.Describe(
                ex,
                $"The enrolment setting for '{topic.Name}' could not be changed. Try again.",
                Logger);
            // The click came from the kebab (a CHILD component), so nothing re-renders this dialog on
            // failure — without this the sentence would be set and never shown.
            StateHasChanged();
        }
        finally
        {
            _adding = false;
        }
    }

    /// <summary>
    /// How many exceptions the subject carries — zero renders no badge, because the
    /// absence of an exception is the normal state.
    /// </summary>
    private int ExceptionCount(Guid topicId) =>
        ExceptionCountsByTopic is { } map && map.TryGetValue(topicId, out var count) ? count : 0;

    private async Task RemoveAsync(GradeTopicCurriculumDto topic)
    {
        if (_adding || Remove is null) return;
        _adding = true;
        try
        {
            await Remove(topic.TopicId);
            Topics = Topics.Where(t => t.TopicId != topic.TopicId).ToArray();
            // The kebab is a CHILD component, so its click re-renders
            // RowActionsMenu only — without this the removed row would stay in the
            // grid (section-card.md §"Reload after child-triggered mutations").
            StateHasChanged();
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _adding = false;
        }
    }

    /// <summary>
    /// Moves the row at <paramref name="from"/> to <paramref name="to"/>: the
    /// page's callback performs the move server-side (it owns the target
    /// position), then the two neighbours trade places locally so the grid
    /// reflects the new order immediately. A failing callback leaves the order
    /// untouched and surfaces the message instead of silently desyncing the grid.
    /// </summary>
    private async Task MoveAsync(int from, int to, Func<GradeTopicCurriculumDto, Task>? move)
    {
        if (_adding || move is null) return;
        if (from < 0 || to < 0 || from >= Topics.Length || to >= Topics.Length) return;

        _adding = true;
        _moveError = null;
        try
        {
            await move(Topics[from]);

            var next = Topics.ToArray();
            (next[from], next[to]) = (next[to], next[from]);
            Topics = next;

            if (OnChanged is not null) await OnChanged();
        }
        catch (Exception ex)
        {
            _moveError = $"Could not reorder: {ex.Message}";
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task ConfirmAssignAsync()
    {
        if (_adding || _topicToAdd is not { } topic || Assign is null) return;
        _adding = true;
        try
        {
            // The callback returns the REAL bridge row id, so the row appended below
            // can reorder itself (an empty id would 404 on its first move).
            var assignmentId = await Assign(topic.Id);
            if (assignmentId == Guid.Empty)
            {
                // The page surfaced the failure (it owns the error state); appending a
                // row whose move buttons would PUT an empty id must be skipped.
                return;
            }

            // Reflect the assignment in the dialog's own lists so the topic moves
            // from the picker into the assigned list without reopening the dialog.
            Topics = Topics.Append(new GradeTopicCurriculumDto(
                assignmentId, topic.Id, topic.Name, topic.Code, 0, 0,
                // A grade assignment is created with the flag OFF (FR-ER-2: implied enrolment is
                // the default, so the appended row claims the state the server just created).
                RequiresEnrollment: false)).ToArray();
            UnassignedTopics = UnassignedTopics.Where(t => t.Id != topic.Id).ToArray();
            _topicToAdd = null;
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _adding = false;
        }
    }

    private Task CloseAsync() => DialogInstance is null ? Task.CompletedTask : DialogInstance.CloseAsync();
}
