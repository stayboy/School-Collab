@using Microsoft.FluentUI.AspNetCore.Components
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@using GradeTopicCurriculumDto = SchoolCollab.Students.Application.Services.GradeTopicCurriculumDto
@implements IDialogContentComponent<DialogParameters>

@* Full list of topics assigned to a grade, shown from the Topics section card's
   "View all" anchor (grade-detail-modern-ui-plan.md §0.4). The page owns the
   API/enrichment and passes the data + action callbacks so this dialog stays
   thin. Reuses the per-topic Strands (strands + lessons, unified) / Teachers
   dialogs and the Remove flow (RemoveTopicAsync on the page). *@
<div class="topic-dialog">
    <div class="picker-row">
        <FluentSelect TOption="TopicDto"
                      Items="UnassignedTopics"
                      OptionText="@(t => t.Name)"
                      OptionValue="@(t => t.Id.ToString())"
                      @bind-SelectedOption="_topicToAdd"
                      Placeholder="Add a topic…" />
        <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                      OnClick="ConfirmAssignAsync" Disabled="@(_topicToAdd is null || _adding)">Assign</FluentButton>
    </div>

    @if (Topics.Length == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">No topics assigned to this grade yet.</FluentMessageBar>
    }
    else
    {
        <div class="topic-dialog__list">
            @foreach (var topic in Topics)
            {
                <div class="topic-dialog__row">
                    <div class="topic-dialog__main">
                        <span class="topic-name">@topic.Name</span>
                        @if (!string.IsNullOrWhiteSpace(topic.Code))
                        {
                            <span class="topic-code">@topic.Code</span>
                        }
                    </div>
                    <div class="topic-dialog__counts">
                        <FluentAnchor Appearance="Appearance.Hypertext" OnClick="@(() => OpenStrandsAsync(topic))" Title="Strands">
                            @topic.StrandCount strands
                        </FluentAnchor>
                        <span class="topic-dialog__count" title="@topic.LessonCount lessons">@topic.LessonCount lessons</span>
                        <span class="topic-dialog__period" title="Delivery period">@PeriodLabel(topic.TopicId)</span>
                    </div>
                    <RowActionsMenu Actions="@BuildRowActions(topic)"
                                    AriaLabel="Topic actions"
                                    UseMenuService="false" />
                </div>
            }
        </div>
    }
    <div class="dialog-footer">
        <FluentButton Appearance="Appearance.Accent" OnClick="CloseAsync">Close</FluentButton>
    </div>
</div>

@code {
    /// <summary>
    /// Per-assignment references passed from the page so the dialog can show the
    /// subject's delivery periods and invoke the period-edit flow. A LIST, because
    /// a subject can be delivered in several terms at once (one bridge row per
    /// period) — see subject-topic-delivery-periods.md §1.
    /// </summary>
    public sealed record AssignedTopicRef(Guid TopicId, Guid AssignmentId, Guid? PeriodId);

    /// <summary>Keys used in <see cref="Content"/> (the DialogParameters
    /// indexer). Exposed so callers set the same keys they read here.</summary>
    public const string TopicsKey = nameof(Topics);
    public const string UnassignedTopicsKey = nameof(UnassignedTopics);
    public const string OpenStrandsKey = nameof(OpenStrands);
    public const string OpenTeachersKey = nameof(OpenTeachers);
    public const string RemoveKey = nameof(Remove);
    public const string AssignKey = nameof(Assign);
    public const string OnChangedKey = nameof(OnChanged);
    public const string AssignmentByKeyKey = nameof(AssignmentByKey);
    public const string EditPeriodKey = nameof(EditPeriod);

    /// <summary>Period id → display name, so the label shows "Term 1", not a GUID.</summary>
    public const string PeriodNamesKey = nameof(PeriodNames);

    // Read from Content (the DialogParameters indexer) — FluentUI renders dialog
    // content via DynamicComponent with only { "Content": <DialogParameters> } and
    // does NOT spread indexer entries onto separate [Parameter]s. Topics /
    // UnassignedTopics are mutable (the dialog reassigns them on remove/assign),
    // so they back onto fields initialized from Content in OnInitialized.
    private GradeTopicCurriculumDto[] _topics = [];
    private TopicDto[] _unassigned = [];
    private GradeTopicCurriculumDto[] Topics { get => _topics; set => _topics = value; }
    private TopicDto[] UnassignedTopics { get => _unassigned; set => _unassigned = value; }

    /// <summary>Safely reads a key from <see cref="Content"/> (the DialogParameters
    /// indexer throws <see cref="KeyNotFoundException"/> for a missing key, so use
    /// <c>TryGet</c>). Returns default when absent.</summary>
    private T? Get<T>(string key) => Content is { } c ? c.TryGet<T>(key) : default;

    private Func<GradeTopicCurriculumDto, Task>? OpenStrands => Get<Func<GradeTopicCurriculumDto, Task>>(OpenStrandsKey);
    private Func<GradeTopicCurriculumDto, Task>? OpenTeachers => Get<Func<GradeTopicCurriculumDto, Task>>(OpenTeachersKey);
    private Func<Guid, Task>? Remove => Get<Func<Guid, Task>>(RemoveKey);
    private Func<Guid, Task>? Assign => Get<Func<Guid, Task>>(AssignKey);
    private Func<Task>? OnChanged => Get<Func<Task>>(OnChangedKey);
    private Dictionary<Guid, List<AssignedTopicRef>>? AssignmentByKey =>
        Get<Dictionary<Guid, List<AssignedTopicRef>>>(AssignmentByKeyKey);
    private Dictionary<Guid, string>? PeriodNames => Get<Dictionary<Guid, string>>(PeriodNamesKey);
    private Func<Guid, Task>? EditPeriod => Get<Func<Guid, Task>>(EditPeriodKey);

    [CascadingParameter] public FluentDialog? Dialog { get; set; }
    [Parameter] public DialogParameters Content { get; set; } = default!;

    private TopicDto? _topicToAdd;
    private bool _adding;

    protected override void OnInitialized()
    {
        _topics = Get<GradeTopicCurriculumDto[]>(TopicsKey) ?? [];
        _unassigned = Get<TopicDto[]>(UnassignedTopicsKey) ?? [];
    }

    private async Task OpenStrandsAsync(GradeTopicCurriculumDto topic)
    {
        if (OpenStrands is not null) await OpenStrands(topic);
    }

    private async Task OpenTeachersAsync(GradeTopicCurriculumDto topic)
    {
        if (OpenTeachers is not null) await OpenTeachers(topic);
    }

    private IReadOnlyList<RowAction> BuildRowActions(GradeTopicCurriculumDto topic) =>
        new List<RowAction>
        {
            RowAction.Callback("Strands", () => OpenStrandsAsync(topic), FluentIcons.TextBulletList),
            RowAction.Callback("Teachers", () => OpenTeachersAsync(topic), FluentIcons.People),
            RowAction.Callback("Edit periods", () => EditPeriodAsync(topic), FluentIcons.Calendar),
            RowAction.Separator(),
            RowAction.Callback(
                "Remove",
                () => RemoveAsync(topic),
                FluentIcons.Delete,
                destructive: true,
                confirmMessage: $"Remove subject '{topic.Name}' from this grade? The subject stays in the catalog; only this grade's assignment is removed."),
        };

    /// <summary>
    /// The subject's delivery periods, resolved to names. A subject can run in
    /// several terms at once, so this lists all of them; a null PeriodId means
    /// year-spanning.
    /// </summary>
    private string PeriodLabel(Guid topicId)
    {
        if (AssignmentByKey is not { } map || !map.TryGetValue(topicId, out var rows) || rows.Count == 0)
            return "Year-spanning";

        var labels = rows
            .Select(r => r.PeriodId is { } pid
                ? (PeriodNames is { } names && names.TryGetValue(pid, out var n) ? n : pid.ToString()[..8])
                : "Whole academic year")
            .Distinct()
            .ToArray();

        return string.Join(" · ", labels);
    }

    private async Task EditPeriodAsync(GradeTopicCurriculumDto topic)
    {
        if (EditPeriod is null) return;
        // Topic-scoped: the page opens the multi-period editor for this subject.
        await EditPeriod(topic.TopicId);
    }

    private async Task RemoveAsync(GradeTopicCurriculumDto topic)
    {
        if (_adding || Remove is null) return;
        _adding = true;
        try
        {
            await Remove(topic.TopicId);
            Topics = Topics.Where(t => t.TopicId != topic.TopicId).ToArray();
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task ConfirmAssignAsync()
    {
        if (_adding || _topicToAdd is not { } topic || Assign is null) return;
        _adding = true;
        try
        {
            await Assign(topic.Id);
            // Reflect the assignment in the dialog's own lists so the topic moves
            // from the picker into the assigned list without reopening the dialog.
            Topics = Topics.Append(new GradeTopicCurriculumDto(topic.Id, topic.Name, topic.Code, 0, 0)).ToArray();
            UnassignedTopics = UnassignedTopics.Where(t => t.Id != topic.Id).ToArray();
            _topicToAdd = null;
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _adding = false;
        }
    }

    private Task CloseAsync() => Dialog is null ? Task.CompletedTask : Dialog.CloseAsync();
}
