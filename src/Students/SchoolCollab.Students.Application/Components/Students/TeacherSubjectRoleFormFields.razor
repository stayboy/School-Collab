@* Shared subject+role management form for a teacher, used by TeacherSubjectsDialog
   (kebab "Subjects") and GradeTeachersDialog (View all) — section-card-lessons-adoption.md
   §9 dec 7. Renders the topic list with per-topic checkboxes, role dropdowns, and
   assignment dates (start + open-ended end). The owning dialog supplies the
   Assignments dictionary + callbacks, so it controls how changes persist
   (save-on-submit in the kebab dialog, immediate in the View-all dialog). *@
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Components
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@using Microsoft.FluentUI.AspNetCore.Components

@if (Topics is null || Topics.Length == 0)
{
    <FluentMessageBar Intent="MessageIntent.Info">No subjects in this tenant yet.</FluentMessageBar>
}
else
{
    <div class="topic-role-list">
        @foreach (var topic in Topics)
        {
            var has = Assignments.ContainsKey(topic.Id);
            <div class="topic-role-row">
                <FluentCheckbox Value="@has"
                                ValueChanged="@(v => Toggle(topic.Id, v))" />
                <span class="check-name">@topic.Name <span class="muted">@topic.Code</span></span>
                @if (has)
                {
                    <CodedValueDropdown Parent="CodedValueParent.TeacherRoles"
                                        SelectedId="@Assignments[topic.Id].RoleCodedValueId"
                                        SelectedIdChanged="@(v => RoleChanged(topic.Id, v))"
                                        Placeholder="No role" />
                    <FluentDatePicker Class="w-3" Label="Start"
                                      Value="@ToDateTime(Assignments[topic.Id].StartDate)"
                                      ValueChanged="@(v => StartDateChanged(topic.Id, FromDateTime(v)))" />
                    <FluentDatePicker Class="w-3" Label="End (open-ended)"
                                      Value="@ToDateTime(Assignments[topic.Id].EndDate)"
                                      ValueChanged="@(v => EndDateChanged(topic.Id, FromDateTime(v)))" />
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>The assignable topic catalog.</summary>
    [Parameter] public TopicDto[]? Topics { get; set; }

    /// <summary>The teacher's current topic+role assignments, keyed by topic id.</summary>
    [Parameter] public Dictionary<Guid, TeacherTopicAssignment> Assignments { get; set; } = new();

    /// <summary>Invoked when a topic is checked/unchecked.</summary>
    [Parameter] public Func<Guid, bool, Task>? OnToggle { get; set; }

    /// <summary>Invoked when a topic's role changes.</summary>
    [Parameter] public Func<Guid, Guid?, Task>? OnRoleChanged { get; set; }

    /// <summary>Invoked when a topic's start date changes.</summary>
    [Parameter] public Func<Guid, DateOnly?, Task>? OnStartDateChanged { get; set; }

    /// <summary>Invoked when a topic's end date changes (null = open-ended).</summary>
    [Parameter] public Func<Guid, DateOnly?, Task>? OnEndDateChanged { get; set; }

    private Task Toggle(Guid topicId, bool selected) => OnToggle?.Invoke(topicId, selected) ?? Task.CompletedTask;
    private Task RoleChanged(Guid topicId, Guid? role) => OnRoleChanged?.Invoke(topicId, role) ?? Task.CompletedTask;
    private Task StartDateChanged(Guid topicId, DateOnly? date) => OnStartDateChanged?.Invoke(topicId, date) ?? Task.CompletedTask;
    private Task EndDateChanged(Guid topicId, DateOnly? date) => OnEndDateChanged?.Invoke(topicId, date) ?? Task.CompletedTask;

    private static DateTime? ToDateTime(DateOnly? d) => d?.ToDateTime(TimeOnly.MinValue);
    private static DateOnly? FromDateTime(DateTime? v) => v.HasValue ? DateOnly.FromDateTime(v.Value) : null;
}
