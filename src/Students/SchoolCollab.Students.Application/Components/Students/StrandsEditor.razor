@* StrandsEditor - unified inline strands CRUD for a topic. A lesson is a strand
   with a parent (strand-lesson-unification-plan.md), so this single editor manages
   root strands AND their lessons: each root strand is listed with its lessons
   (parented strands) beneath it, and a "New Lesson" affordance creates a parented
   strand under that root. Self-contained: loads on first render and manages
   create / update / delete via the StudentsApiClient. Replaces the separate
   LessonsEditor. *@
@using SchoolCollab.Students.Application.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject StudentsApiClient Api
@inject ILogger<StrandsEditor> Logger

<div class="editor-block">
    <div class="editor-header">
        <h4>Strands (@(_roots.Length))</h4>
        <FluentButton Appearance="Appearance.Lightweight" Size="ButtonSize.Small"
                      IconStart="@FluentIcons.Add" OnClick="ToggleNewStrand">New Strand</FluentButton>
    </div>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="mb-2">@_error</FluentMessageBar>
    }
    @if (_items is null)
    {
        <FluentProgressRing />
    }
    else if (_roots.Length == 0)
    {
        <p class="muted">No strands yet.</p>
    }
    else
    {
        <div class="strand-list">
            @foreach (var root in _roots)
            {
                <div class="strand-group">
                    @if (_editingId == root.Id)
                    {
                        <div class="strand-row">
                            <FluentTextField @bind-Value="_editName" Placeholder="Strand name" class="strand-input" />
                            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" OnClick="@(() => SaveEditAsync(root))">Save</FluentButton>
                            <FluentButton Appearance="Appearance.Neutral" Size="ButtonSize.Small" OnClick="CancelEdit">Cancel</FluentButton>
                        </div>
                    }
                    else
                    {
                        <div class="strand-row">
                            <span class="strand-name">@root.Name</span>
                            <span class="strand-actions">
                                <FluentButton Appearance="Appearance.Lightweight" Size="ButtonSize.Small"
                                              IconStart="@FluentIcons.Edit" Title="Rename strand"
                                              OnClick="@(() => StartEdit(root))" />
                                <FluentButton Appearance="Appearance.Lightweight" Size="ButtonSize.Small"
                                              IconStart="@FluentIcons.Delete" Title="Delete strand"
                                              OnClick="@(() => DeleteAsync(root))" />
                            </span>
                        </div>
                    }

                    <div class="lesson-block">
                        @if (_lessonsOf(root.Id).Length > 0)
                        {
                            <div class="lesson-list">
                                @foreach (var lesson in _lessonsOf(root.Id))
                                {
                                    @if (_editingId == lesson.Id)
                                    {
                                        <div class="lesson-row">
                                            <FluentTextField @bind-Value="_editName" Placeholder="Lesson name" class="lesson-input" />
                                            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" OnClick="@(() => SaveEditAsync(lesson))">Save</FluentButton>
                                            <FluentButton Appearance="Appearance.Neutral" Size="ButtonSize.Small" OnClick="CancelEdit">Cancel</FluentButton>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="lesson-row">
                                            <span class="lesson-name">@lesson.Name</span>
                                            <span class="lesson-actions">
                                                <FluentButton Appearance="Appearance.Lightweight" Size="ButtonSize.Small"
                                                              IconStart="@FluentIcons.Edit" Title="Rename lesson"
                                                              OnClick="@(() => StartEdit(lesson))" />
                                                <FluentButton Appearance="Appearance.Lightweight" Size="ButtonSize.Small"
                                                              IconStart="@FluentIcons.Delete" Title="Delete lesson"
                                                              OnClick="@(() => DeleteAsync(lesson))" />
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @if (_newLessonParentId == root.Id)
                        {
                            <div class="new-form">
                                <FluentTextField @bind-Value="_newLessonName" Placeholder="Lesson name" class="lesson-input" />
                                <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                                              OnClick="@(() => CreateLessonAsync(root.Id))" Disabled="@string.IsNullOrWhiteSpace(_newLessonName)">Add</FluentButton>
                                <FluentButton Appearance="Appearance.Neutral" Size="ButtonSize.Small" OnClick="CancelNewLesson">Cancel</FluentButton>
                            </div>
                        }
                        else
                        {
                            <FluentButton Appearance="Appearance.Lightweight" Size="ButtonSize.Small"
                                          IconStart="@FluentIcons.Add" OnClick="@(() => ToggleNewLesson(root.Id))">New Lesson</FluentButton>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (_showNewStrand)
    {
        <div class="new-form">
            <FluentTextField @bind-Value="_newStrandName" Placeholder="Strand name" class="strand-input" />
            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                          OnClick="CreateStrandAsync" Disabled="@string.IsNullOrWhiteSpace(_newStrandName)">Add</FluentButton>
            <FluentButton Appearance="Appearance.Neutral" Size="ButtonSize.Small" OnClick="CancelNewStrand">Cancel</FluentButton>
        </div>
    }
</div>

<style>
    .editor-header { display: flex; align-items: center; justify-content: space-between; }
    .editor-header h4 { margin: 0 0 0.25rem; }
    .muted { color: var(--neutral-foreground-hint); }
    .strand-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .strand-group { border-top: 1px solid var(--neutral-stroke-rest); padding-top: 0.5rem; }
    .strand-row { display: flex; align-items: center; gap: 0.5rem; }
    .strand-name { font-weight: 600; }
    .strand-actions { margin-left: auto; display: flex; align-items: center; }
    .strand-input { max-width: 260px; }
    .lesson-block { margin-left: 1.25rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-start; }
    .lesson-list { display: flex; flex-direction: column; gap: 0.25rem; width: 100%; }
    .lesson-row { display: flex; align-items: center; gap: 0.5rem; }
    .lesson-name { font-weight: 500; }
    .lesson-actions { margin-left: auto; display: flex; align-items: center; }
    .lesson-input { max-width: 220px; }
    .new-form { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; }
</style>

@code {
    [Parameter, EditorRequired] public Guid TopicId { get; set; }
    [Parameter, EditorRequired] public string TopicName { get; set; } = string.Empty;

    private TopicStrandDto[]? _items;
    private string? _error;
    private bool _showNewStrand;
    private string _newStrandName = string.Empty;
    private Guid? _newLessonParentId;
    private string _newLessonName = string.Empty;
    private Guid? _editingId;
    private string _editName = string.Empty;

    private TopicStrandDto[] _roots =>
        (_items ?? []).Where(s => s.ParentStrandId is null).OrderBy(s => s.DisplayOrder).ToArray();

    private TopicStrandDto[] _lessonsOf(Guid parentId) =>
        (_items ?? []).Where(s => s.ParentStrandId == parentId).OrderBy(s => s.DisplayOrder).ToArray();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await Api.ListTopicStrandsAsync(TopicId) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load strands for topic {TopicId}", TopicId);
            _error = ex.Message;
        }
    }

    private void ToggleNewStrand()
    {
        _showNewStrand = !_showNewStrand;
        _newStrandName = string.Empty;
        _error = null;
    }

    private void CancelNewStrand()
    {
        _showNewStrand = false;
        _newStrandName = string.Empty;
    }

    private void ToggleNewLesson(Guid parentId)
    {
        _newLessonParentId = _newLessonParentId == parentId ? null : parentId;
        _newLessonName = string.Empty;
        _error = null;
    }

    private void CancelNewLesson()
    {
        _newLessonParentId = null;
        _newLessonName = string.Empty;
    }

    private async Task CreateStrandAsync()
    {
        if (string.IsNullOrWhiteSpace(_newStrandName)) return;
        try
        {
            await Api.CreateTopicStrandAsync(new CreateTopicStrandRequest(TopicId, _newStrandName.Trim()));
            _showNewStrand = false;
            _newStrandName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateLessonAsync(Guid parentId)
    {
        if (string.IsNullOrWhiteSpace(_newLessonName)) return;
        try
        {
            await Api.CreateTopicStrandAsync(new CreateTopicStrandRequest(
                TopicId, _newLessonName.Trim(), ParentStrandId: parentId));
            _newLessonParentId = null;
            _newLessonName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEdit(TopicStrandDto strand)
    {
        _editingId = strand.Id;
        _editName = strand.Name;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editName = string.Empty;
    }

    private async Task SaveEditAsync(TopicStrandDto strand)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        try
        {
            // Preserve the strand's parent (root strands stay null; lessons keep theirs).
            await Api.UpdateTopicStrandAsync(strand.Id, new UpdateTopicStrandRequest(
                _editName.Trim(), strand.Description, strand.DisplayOrder, strand.ParentStrandId));
            _editingId = null;
            _editName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(TopicStrandDto strand)
    {
        try
        {
            await Api.DeleteTopicStrandAsync(strand.Id);
            if (_editingId == strand.Id) CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
