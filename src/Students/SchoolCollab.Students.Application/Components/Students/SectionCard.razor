@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager Nav
@typeparam TItem

<FluentCard class="section-card-wrapper" AreaRestricted="false">
    <div class="section-card @Class">
        <div class="section-card__header">
        @if (Icon is { } icon)
        {
            <FluentIcon Value="@icon" />
        }
        <span class="section-card__title">@Title</span>
        <span class="section-card__count">@Count</span>
        @if (ShowAddButton)
        {
            <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small"
                        IconStart="@AddIcon" Title="@AddTitle"
                        AriaLabel="@AddAriaLabel" OnClick="HandleAddClickAsync" />
        }
    </div>
    <div class="section-card__body">
        @if (Loading)
        {
            <FluentProgressRing class="section-card__spinner" />
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="section-card__empty section-card__error">@ErrorMessage</div>
        }
        else if (Items is null || Items.Length == 0)
        {
            <div class="section-card__empty">@EmptyMessage</div>
        }
        else
        {
            @foreach (var item in Items.Take(MaxPreviewItems))
            {
                if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    <div class="section-card__item">
                        <div class="section-card__item-main">
                            @if (ItemTextSelector is { } textSel)
                            {
                                if (ItemHrefSelector is { } hrefSel && hrefSel(item) is { } href)
                                {
                                    <FluentAnchor Appearance="Appearance.Hypertext" Class="item-name"
                                                  Href="@href" Title="@(ItemNameTitle ?? textSel(item))">
                                        @textSel(item)
                                    </FluentAnchor>
                                }
                                else if (ItemOnClick is { } onClick)
                                {
                                    <FluentAnchor Appearance="Appearance.Hypertext" Class="item-name"
                                                  Href="#" OnClick="() => onClick(item)" Title="@(ItemNameTitle ?? textSel(item))">
                                        @textSel(item)
                                    </FluentAnchor>
                                }
                                else
                                {
                                    <span class="item-name">@textSel(item)</span>
                                }
                            }
                            @if (ItemMetaSelector is { } metaSel && metaSel(item) is { } metaItems)
                            {
                                <div class="item-meta">
                                    @for (var i = 0; i < metaItems.Length; i++)
                                    {
                                        <span class="item-meta__count">@metaItems[i]</span>
                                        @if (i < metaItems.Length - 1)
                                        {
                                            <span class="item-meta__separator" aria-hidden="true">|</span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @if (ItemActions is not null)
                        {
                            @ItemActions(item)
                        }
                    </div>
                }
            }
        }
    </div>
    <div class="section-card__footer">
        @if (ViewAllNavigationUrl is { } url)
        {
            <FluentAnchor Appearance="Appearance.Hypertext" Href="@url" IconEnd="@FluentIcons.ArrowRight">
                @ViewAllText (@Count)
            </FluentAnchor>
        }
        else if (OnViewAllClick is not null)
        {
            <FluentAnchor Appearance="Appearance.Hypertext" Href="#" OnClick="OnViewAllClick" IconEnd="@FluentIcons.ArrowRight">
                @ViewAllText (@Count)
            </FluentAnchor>
        }
    </div>
</div>
</FluentCard>

@code {
    /// <summary>
    /// CSS class to add to the card (optional).
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Card title (e.g., "Subjects", "Teachers", "Students").
    /// </summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Icon to display in the header.
    /// </summary>
    [Parameter] public Icon? Icon { get; set; }

    /// <summary>
    /// Item count to display in the header badge.
    /// </summary>
    [Parameter] public int Count { get; set; }

    /// <summary>
    /// Whether to show the "Add" icon button in the header.
    /// </summary>
    [Parameter] public bool ShowAddButton { get; set; } = true;

    /// <summary>
    /// Icon for the "Add" button (defaults to Add).
    /// </summary>
    [Parameter] public Icon AddIcon { get; set; } = new global::Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add();

    /// <summary>
    /// Title attribute for the "Add" button.
    /// </summary>
    [Parameter] public string AddTitle { get; set; } = "Add";

    /// <summary>
    /// Aria-label for the "Add" button.
    /// </summary>
    [Parameter] public string AddAriaLabel { get; set; } = "Add";

    /// <summary>
    /// Items to display in the preview list.
    /// </summary>
    [Parameter] public TItem[]? Items { get; set; }

    /// <summary>
    /// Maximum number of items to show in the preview (default: 15).
    /// </summary>
    [Parameter] public int MaxPreviewItems { get; set; } = 15;

    /// <summary>
    /// Template for rendering each item in the preview list. Provide this for
    /// fully custom items, or omit it and drive the standard item layout via the
    /// selector parameters (ItemTextSelector / ItemMetaSelector / href / click).
    /// </summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>
    /// Primary display text for each item (shown as a hypertext link or span).
    /// Used by the built-in item layout when <see cref="ItemTemplate"/> is null.
    /// </summary>
    [Parameter] public Func<TItem, string?>? ItemTextSelector { get; set; }

    /// <summary>
    /// Secondary/meta line parts for each item (e.g. role, demographics, counts).
    /// Return an array of parts; the component renders them separated by a "|" divider.
    /// </summary>
    [Parameter] public Func<TItem, string[]?>? ItemMetaSelector { get; set; }

    /// <summary>
    /// Returns the navigation URL for each item; when set, the item name renders
    /// as a real hypertext link that navigates to this URL.
    /// </summary>
    [Parameter] public Func<TItem, string?>? ItemHrefSelector { get; set; }

    /// <summary>
    /// Click handler for each item; when set, the item name renders as a
    /// hypertext link (Href="#") that invokes this callback. Mutually exclusive
    /// with <see cref="ItemHrefSelector"/>.
    /// </summary>
    [Parameter] public Func<TItem, Task>? ItemOnClick { get; set; }

    /// <summary>
    /// Tooltip (title) for the item name link; falls back to the item text.
    /// </summary>
    [Parameter] public string? ItemNameTitle { get; set; }

    /// <summary>
    /// Optional extra content rendered at the right of the built-in item layout
    /// (e.g. a row-actions menu). Ignored when <see cref="ItemTemplate"/> is used.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? ItemActions { get; set; }

    /// <summary>
    /// Loading state - shows a progress ring when true.
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Error message to display (if any).
    /// </summary>
    [Parameter] public string? ErrorMessage { get; set; }

    /// <summary>
    /// Message to display when no items are available.
    /// </summary>
    [Parameter] public string EmptyMessage { get; set; } = "No items yet.";

    /// <summary>
    /// Text for the "View all" link (default: "View all").
    /// </summary>
    [Parameter] public string ViewAllText { get; set; } = "View all";

    /// <summary>
    /// URL to navigate to for "View all" (if navigation-based).
    /// </summary>
    [Parameter] public string? ViewAllNavigationUrl { get; set; }

    /// <summary>
    /// Callback for "View all" click (if dialog-based).
    /// </summary>
    [Parameter] public Func<Task>? OnViewAllClick { get; set; }

    /// <summary>
    /// Callback for "Add" button click.
    /// </summary>
    [Parameter, EditorRequired] public Func<Task>? OnAddClick { get; set; }

    /// <summary>
    /// Invokes <see cref="OnAddClick"/> when the header Add button is clicked.
    /// The callback is optional (a card may show the button without wiring an
    /// action), so a missing callback resolves to a no-op task instead of a
    /// null reference at the event-binder level.
    /// </summary>
    private Task HandleAddClickAsync() => OnAddClick?.Invoke() ?? Task.CompletedTask;
}

