@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Services
@using TeacherWithRoleDto = SchoolCollab.Students.Core.DTOs.TeacherWithRoleDto
@using TeacherDto = SchoolCollab.Students.Application.Services.TeacherDto
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@implements IDialogContentComponent<DialogParameters>
@inject StudentsApiClient Api
@inject ILogger<GradeTeachersDialog> Logger

@* Full list of teachers linked to a grade, shown from the Teachers section card's
   "View all" anchor (grade-detail-modern-ui-plan.md §0.4). The page owns the
   link/unlink/role/remove callbacks; this dialog owns the per-teacher subject+role
   management (topics + roles + dates) via the shared TeacherSubjectRoleFormFields.

   UI rules: (1) the teachers render in a FluentDataGrid so rows stay compact;
   (2) the subject+role editor is an IN-PAGE section toggle (expandable div below
   the grid), NOT a nested dialog — never open a dialog from another dialog instance.
   Toggling "Edit subjects" on a row selects that teacher and expands the section. *@
<div class="teacher-dialog">
    <div class="picker-row">
        <FluentSelect TOption="TeacherDto"
                      Items="UnlinkedTeachers"
                      OptionText="@(t => $"{t.FirstName} {t.LastName}")"
                      OptionValue="@(t => t.Id.ToString())"
                      @bind-SelectedOption="_teacherToAdd"
                      Placeholder="Link a teacher…" />
        <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                      OnClick="ConfirmLinkAsync" Disabled="@(_teacherToAdd is null || _busy)">Link</FluentButton>
    </div>

    @if (Teachers.Length == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">No teachers linked to this grade yet.</FluentMessageBar>
    }
    else
    {
        <FluentDataGrid Items="@(Teachers.AsQueryable())"
                        TGridItem="TeacherWithRoleDto"
                        MultiLine="true"
                        Class="teacher-grid">
            <TemplateColumn Title="Teacher">
                <FluentAnchor Appearance="Appearance.Hypertext"
                              Href="@($"/students/teachers/{context.Id}")"
                              class="teacher-dialog__name">
                    @(context.TitleCodedValueId is { } tid && SalutationNames.TryGetValue(tid, out var sal) ? $"{sal} " : "")@context.FirstName @context.LastName
                </FluentAnchor>
                <div class="teacher-dialog__meta">
                    <span>@(context.GenderCodedValueId is { } gid && GenderNames.TryGetValue(gid, out var g) ? g : "—")</span>
                    <span>·</span>
                    <span>@(context.LevelOfEducationCodedValueId is { } lid && LevelNames.TryGetValue(lid, out var l) ? l : "—")</span>
                </div>
                @if ((context.QualificationCodedValueIds ?? []).Length > 0)
                {
                    <div class="teacher-dialog__quals">
                        @foreach (var qid in context.QualificationCodedValueIds ?? [])
                        {
                            <span class="chip">@(QualificationNames is { } qn && qn.TryGetValue(qid, out var qv) ? qv : "•")</span>
                        }
                    </div>
                }
            </TemplateColumn>
            <TemplateColumn Title="Grade role">
                <CodedValueDropdown Parent="CodedValueParent.TeacherRoles"
                                    SelectedId="@context.TeacherRoleCodedValueId"
                                    SelectedIdChanged="@((Guid? v) => RoleChangedAsync(context, v))"
                                    Placeholder="No role" />
            </TemplateColumn>
            <TemplateColumn Title="Subjects">
                <div class="teacher-dialog__topics">
                    @foreach (var tp in context.AssignedTopics)
                    {
                        <span class="chip" title="Click to unlink" @onclick="() => UnlinkTopicAsync(context, tp.Id)">
                            @tp.Name <span class="chip-x">×</span>
                        </span>
                    }
                    @if (context.AssignedTopics.Length == 0)
                    {
                        <span class="muted">No subjects</span>
                    }
                </div>
                <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small"
                              IconStart="@FluentIcons.Book"
                              Title="Edit subjects (in-page)"
                              OnClick="() => ToggleSubjectsAsync(context)">
                    @(_subjectsTeacherId == context.Id ? "Hide" : "Edit")
                </FluentButton>
            </TemplateColumn>
            <TemplateColumn Title="">
                <RowActionsMenu Actions="@BuildRowActions(context)"
                                AriaLabel="Teacher actions"
                                UseMenuService="false" />
            </TemplateColumn>
        </FluentDataGrid>

        @* In-page subject+role editor (toggle, NOT a nested dialog). Shown below
           the grid for the selected teacher; hosts the shared
           TeacherSubjectRoleFormFields with the teacher's topic+role assignments
           and dates (open-ended allowed). *@
        @if (_subjectsTeacherId is { } editId && _subjectsForTeacher is not null)
        {
            var editTeacher = Teachers.FirstOrDefault(t => t.Id == editId);
            <div class="teacher-subjects-section">
                <div class="teacher-subjects-section__title">
                    <FluentIcon Value="@FluentIcons.Book" />
                    <span>Subjects · @(editTeacher is not null ? $"{editTeacher.FirstName} {editTeacher.LastName}" : "teacher")</span>
                    <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small"
                                  IconStart="@FluentIcons.Dismiss"
                                  Title="Hide"
                                  OnClick="HideSubjects" />
                </div>
                @if (_subjectsError is not null)
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@_subjectsError</FluentMessageBar>
                }
                <TeacherSubjectRoleFormFields Topics="@_allTopics"
                                              Assignments="_subjectsForTeacher"
                                              OnToggle="OnSubjectsToggleAsync"
                                              OnRoleChanged="OnSubjectsRoleAsync"
                                              OnStartDateChanged="OnSubjectsStartAsync"
                                              OnEndDateChanged="OnSubjectsEndAsync" />
                <div class="teacher-subjects-section__actions">
                    <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                                  Disabled="@_subjectsSaving" OnClick="SaveSubjectsAsync">
                        @(_subjectsSaving ? "Saving…" : "Save")
                    </FluentButton>
                </div>
            </div>
        }
    }
    <div class="dialog-footer">
        <FluentButton Appearance="Appearance.Accent" OnClick="CloseAsync">Close</FluentButton>
    </div>
</div>

@code {
    [Parameter] public TeacherWithRoleDto[] Teachers { get; set; } = [];
    [Parameter] public TeacherDto[] UnlinkedTeachers { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<Guid, string>? SalutationNames { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, string>? GenderNames { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, string>? LevelNames { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, string>? QualificationNames { get; set; }
    [Parameter] public Func<Guid, Task>? Link { get; set; }
    [Parameter] public Func<TeacherWithRoleDto, Guid?, Task>? RoleChanged { get; set; }
    [Parameter] public Func<TeacherWithRoleDto, Guid, Task>? UnlinkTopic { get; set; }
    [Parameter] public Func<TeacherWithRoleDto, Task>? Remove { get; set; }
    [Parameter] public Func<Task>? OnChanged { get; set; }

    [CascadingParameter] public FluentDialog? Dialog { get; set; }
    [Parameter] public DialogParameters Content { get; set; } = default!;

    private TeacherDto? _teacherToAdd;
    private bool _busy;

    // ── In-page subject+role editor (toggle) ──────────────────────────────
    private Guid? _subjectsTeacherId;
    private Dictionary<Guid, TeacherTopicAssignment> _subjectsForTeacher = new();
    private Dictionary<Guid, TeacherTopicAssignment> _subjectsOriginal = new();
    private TopicDto[]? _allTopics;
    private bool _subjectsSaving;
    private string? _subjectsError;

    private async Task RoleChangedAsync(TeacherWithRoleDto teacher, Guid? roleId)
    {
        if (RoleChanged is not null) await RoleChanged(teacher, roleId);
    }

    private async Task UnlinkTopicAsync(TeacherWithRoleDto teacher, Guid topicId)
    {
        if (_busy || UnlinkTopic is null) return;
        _busy = true;
        try
        {
            await UnlinkTopic(teacher, topicId);
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Toggles the in-page subject+role editor for a teacher. First open loads
    /// the topic catalog + the teacher's current topic+role assignments (with
    /// dates); toggling the same teacher again hides it.
    /// </summary>
    private async Task ToggleSubjectsAsync(TeacherWithRoleDto teacher)
    {
        if (_subjectsTeacherId == teacher.Id)
        {
            HideSubjects();
            return;
        }
        _subjectsError = null;
        try
        {
            _allTopics ??= await Api.ListTopicsAsync() ?? [];
            var roles = await Api.ListTeacherTopicRolesAsync(teacher.Id) ?? [];
            _subjectsForTeacher = roles.ToDictionary(
                r => r.TopicId,
                r => new TeacherTopicAssignment(r.TopicId, r.RoleCodedValueId, r.StartDate, r.EndDate));
            _subjectsOriginal = new Dictionary<Guid, TeacherTopicAssignment>(_subjectsForTeacher);
            _subjectsTeacherId = teacher.Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load subjects for teacher {TeacherId}", teacher.Id);
            _subjectsError = $"Could not load: {ex.Message}";
            _subjectsTeacherId = teacher.Id;
        }
    }

    private void HideSubjects()
    {
        _subjectsTeacherId = null;
        _subjectsForTeacher = new();
        _subjectsOriginal = new();
        _subjectsError = null;
    }

    private Task OnSubjectsToggleAsync(Guid topicId, bool selected)
    {
        if (selected)
        {
            if (!_subjectsForTeacher.ContainsKey(topicId))
                _subjectsForTeacher[topicId] = new TeacherTopicAssignment(topicId);
        }
        else
        {
            _subjectsForTeacher.Remove(topicId);
        }
        return Task.CompletedTask;
    }

    private Task OnSubjectsRoleAsync(Guid topicId, Guid? role)
    {
        if (_subjectsForTeacher.TryGetValue(topicId, out var a))
            _subjectsForTeacher[topicId] = a with { RoleCodedValueId = role };
        return Task.CompletedTask;
    }

    private Task OnSubjectsStartAsync(Guid topicId, DateOnly? date)
    {
        if (_subjectsForTeacher.TryGetValue(topicId, out var a))
            _subjectsForTeacher[topicId] = a with { StartDate = date };
        return Task.CompletedTask;
    }

    private Task OnSubjectsEndAsync(Guid topicId, DateOnly? date)
    {
        if (_subjectsForTeacher.TryGetValue(topicId, out var a))
            _subjectsForTeacher[topicId] = a with { EndDate = date };
        return Task.CompletedTask;
    }

    /// <summary>
    /// Persists the in-page subject+role edits for the selected teacher:
    /// reconciles topic links + roles + dates (start, open-ended end) against
    /// the original snapshot. Reloads the page's teacher list on success so the
    /// Subjects chips refresh.
    /// </summary>
    private async Task SaveSubjectsAsync()
    {
        if (_subjectsSaving || _subjectsTeacherId is not { } teacherId) return;
        _subjectsSaving = true;
        _subjectsError = null;
        try
        {
            foreach (var id in _subjectsForTeacher.Keys.Except(_subjectsOriginal.Keys))
            {
                var a = _subjectsForTeacher[id];
                await Api.LinkTeacherTopicAsync(teacherId, id, a.RoleCodedValueId, a.StartDate, a.EndDate);
            }
            foreach (var id in _subjectsOriginal.Keys.Except(_subjectsForTeacher.Keys))
                await Api.UnlinkTeacherTopicAsync(teacherId, id);
            foreach (var id in _subjectsForTeacher.Keys.Intersect(_subjectsOriginal.Keys))
            {
                var a = _subjectsForTeacher[id];
                var orig = _subjectsOriginal[id];
                if (a.RoleCodedValueId != orig.RoleCodedValueId || a.StartDate != orig.StartDate || a.EndDate != orig.EndDate)
                    await Api.SetTeacherTopicRoleAsync(teacherId, id, a.RoleCodedValueId, a.StartDate, a.EndDate);
            }
            if (OnChanged is not null) await OnChanged();
            HideSubjects();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save subjects for teacher {TeacherId}", teacherId);
            _subjectsError = $"Could not save: {ex.Message}";
        }
        finally
        {
            _subjectsSaving = false;
        }
    }

    private IReadOnlyList<RowAction> BuildRowActions(TeacherWithRoleDto teacher) =>
        new List<RowAction>
        {
            RowAction.Callback(
                "Remove",
                () => RemoveAsync(teacher),
                FluentIcons.Delete,
                destructive: true,
                confirmMessage: $"Remove teacher '{teacher.FirstName} {teacher.LastName}' from this grade? Only the grade assignment is removed — the teacher stays in the catalog."),
        };

    private async Task RemoveAsync(TeacherWithRoleDto teacher)
    {
        if (_busy || Remove is null) return;
        _busy = true;
        try
        {
            await Remove(teacher);
            Teachers = Teachers.Where(t => t.Id != teacher.Id).ToArray();
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmLinkAsync()
    {
        if (_busy || _teacherToAdd is not { } teacher || Link is null) return;
        _busy = true;
        try
        {
            await Link(teacher.Id);
            // Reflect the link in the dialog's own lists so the teacher moves
            // from the picker into the linked list without reopening the dialog.
            Teachers = Teachers.Append(ToWithRole(teacher)).ToArray();
            UnlinkedTeachers = UnlinkedTeachers.Where(t => t.Id != teacher.Id).ToArray();
            _teacherToAdd = null;
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Converts a picker <see cref="TeacherDto"/> into a linked
    /// <see cref="TeacherWithRoleDto"/> (no role / no topics yet) so the newly
    /// linked teacher can be appended to the dialog's linked list.</summary>
    private static TeacherWithRoleDto ToWithRole(TeacherDto t) =>
        new(t.Id, t.TitleCodedValueId, t.FirstName, t.LastName, t.DisplayName,
            t.GenderCodedValueId, t.DateOfBirth, t.LevelOfEducationCodedValueId,
            t.QualificationCodedValueIds ?? [], t.IsDeleted, null, [],
            t.CreatedAt, t.UpdatedAt);

    private Task CloseAsync() => Dialog is null ? Task.CompletedTask : Dialog.CloseAsync();
}