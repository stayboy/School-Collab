@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using TeacherWithRoleDto = SchoolCollab.Students.Core.DTOs.TeacherWithRoleDto
@using TeacherDto = SchoolCollab.Students.Application.Services.TeacherDto
@implements IDialogContentComponent<DialogParameters>
@inject IDialogService DialogService

@* Full list of teachers linked to a grade, shown from the Teachers section card's
   "View all" anchor (grade-detail-modern-ui-plan.md §0.4). The page owns the
   API/enrichment and passes the data + action callbacks so this dialog stays
   thin. Renders the teachers in a FluentDataGrid so each row stays compact; the
   per-teacher subject+role management (topics + roles + dates) is opened via the
   shared TeacherSubjectsDialog (which hosts TeacherSubjectRoleFormFields), so the
   grid rows don't grow a full topic list. *@
<div class="teacher-dialog">
    <div class="picker-row">
        <FluentSelect TOption="TeacherDto"
                      Items="UnlinkedTeachers"
                      OptionText="@(t => $"{t.FirstName} {t.LastName}")"
                      OptionValue="@(t => t.Id.ToString())"
                      @bind-SelectedOption="_teacherToAdd"
                      Placeholder="Link a teacher…" />
        <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small"
                      OnClick="ConfirmLinkAsync" Disabled="@(_teacherToAdd is null || _busy)">Link</FluentButton>
    </div>

    @if (Teachers.Length == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info">No teachers linked to this grade yet.</FluentMessageBar>
    }
    else
    {
        <FluentDataGrid Items="@(Teachers.AsQueryable())"
                        TGridItem="TeacherWithRoleDto"
                        MultiLine="true"
                        Class="teacher-grid">
            <TemplateColumn Title="Teacher">
                <FluentAnchor Appearance="Appearance.Hypertext"
                              Href="@($"/students/teachers/{context.Id}")"
                              class="teacher-dialog__name">
                    @(context.TitleCodedValueId is { } tid && SalutationNames.TryGetValue(tid, out var sal) ? $"{sal} " : "")@context.FirstName @context.LastName
                </FluentAnchor>
                <div class="teacher-dialog__meta">
                    <span>@(context.GenderCodedValueId is { } gid && GenderNames.TryGetValue(gid, out var g) ? g : "—")</span>
                    <span>·</span>
                    <span>@(context.LevelOfEducationCodedValueId is { } lid && LevelNames.TryGetValue(lid, out var l) ? l : "—")</span>
                </div>
                @if ((context.QualificationCodedValueIds ?? []).Length > 0)
                {
                    <div class="teacher-dialog__quals">
                        @foreach (var qid in context.QualificationCodedValueIds ?? [])
                        {
                            <span class="chip">@(QualificationNames is { } qn && qn.TryGetValue(qid, out var qv) ? qv : "•")</span>
                        }
                    </div>
                }
            </TemplateColumn>
            <TemplateColumn Title="Grade role">
                <CodedValueDropdown Parent="CodedValueParent.TeacherRoles"
                                    SelectedId="@context.TeacherRoleCodedValueId"
                                    SelectedIdChanged="@((Guid? v) => RoleChangedAsync(context, v))"
                                    Placeholder="No role" />
            </TemplateColumn>
            <TemplateColumn Title="Subjects">
                <div class="teacher-dialog__topics">
                    @foreach (var tp in context.AssignedTopics)
                    {
                        <span class="chip" title="Click to unlink" @onclick="() => UnlinkTopicAsync(context, tp.Id)">
                            @tp.Name <span class="chip-x">×</span>
                        </span>
                    }
                    @if (context.AssignedTopics.Length == 0)
                    {
                        <span class="muted">No subjects</span>
                    }
                </div>
                <FluentButton Appearance="Appearance.Stealth" Size="ButtonSize.Small"
                              IconStart="@FluentIcons.Book"
                              Title="Edit subjects"
                              OnClick="() => OpenSubjectsAsync(context)">
                    Edit
                </FluentButton>
            </TemplateColumn>
            <TemplateColumn Title="">
                <RowActionsMenu Actions="@BuildRowActions(context)"
                                AriaLabel="Teacher actions"
                                UseMenuService="false" />
            </TemplateColumn>
        </FluentDataGrid>
    }
    <div class="dialog-footer">
        <FluentButton Appearance="Appearance.Accent" OnClick="CloseAsync">Close</FluentButton>
    </div>
</div>

@code {
    [Parameter] public TeacherWithRoleDto[] Teachers { get; set; } = [];
    [Parameter] public TeacherDto[] UnlinkedTeachers { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<Guid, string>? SalutationNames { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, string>? GenderNames { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, string>? LevelNames { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, string>? QualificationNames { get; set; }
    [Parameter] public Func<Guid, Task>? Link { get; set; }
    [Parameter] public Func<TeacherWithRoleDto, Guid?, Task>? RoleChanged { get; set; }
    [Parameter] public Func<TeacherWithRoleDto, Guid, Task>? UnlinkTopic { get; set; }
    [Parameter] public Func<TeacherWithRoleDto, Task>? Remove { get; set; }
    [Parameter] public Func<Task>? OnChanged { get; set; }

    [CascadingParameter] public FluentDialog? Dialog { get; set; }
    public DialogParameters Content { get; set; } = default!;

    private TeacherDto? _teacherToAdd;
    private bool _busy;

    private async Task RoleChangedAsync(TeacherWithRoleDto teacher, Guid? roleId)
    {
        if (RoleChanged is not null) await RoleChanged(teacher, roleId);
    }

    private async Task UnlinkTopicAsync(TeacherWithRoleDto teacher, Guid topicId)
    {
        if (_busy || UnlinkTopic is null) return;
        _busy = true;
        try
        {
            await UnlinkTopic(teacher, topicId);
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Opens the shared TeacherSubjectsDialog (hosting TeacherSubjectRoleFormFields)
    /// for the row's teacher, so the grid row stays compact while the full
    /// subject+role management (topics + roles + dates) is edited in a focused
    /// dialog. Reloads the teacher list on close so the chips refresh.
    /// </summary>
    private async Task OpenSubjectsAsync(TeacherWithRoleDto teacher)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await DialogService.ShowReadonlyDialogAsync<TeacherSubjectsDialog>(
                $"Subjects · {teacher.FirstName} {teacher.LastName}",
                new Dictionary<string, object?>
                {
                    { nameof(TeacherSubjectsDialog.TeacherId), teacher.Id },
                },
                DialogSize.Medium);
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    private IReadOnlyList<RowAction> BuildRowActions(TeacherWithRoleDto teacher) =>
        new List<RowAction>
        {
            RowAction.Callback(
                "Remove",
                () => RemoveAsync(teacher),
                FluentIcons.Delete,
                destructive: true,
                confirmMessage: $"Remove teacher '{teacher.FirstName} {teacher.LastName}' from this grade? Only the grade assignment is removed — the teacher stays in the catalog."),
        };

    private async Task RemoveAsync(TeacherWithRoleDto teacher)
    {
        if (_busy || Remove is null) return;
        _busy = true;
        try
        {
            await Remove(teacher);
            Teachers = Teachers.Where(t => t.Id != teacher.Id).ToArray();
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmLinkAsync()
    {
        if (_busy || _teacherToAdd is not { } teacher || Link is null) return;
        _busy = true;
        try
        {
            await Link(teacher.Id);
            // Reflect the link in the dialog's own lists so the teacher moves
            // from the picker into the linked list without reopening the dialog.
            Teachers = Teachers.Append(ToWithRole(teacher)).ToArray();
            UnlinkedTeachers = UnlinkedTeachers.Where(t => t.Id != teacher.Id).ToArray();
            _teacherToAdd = null;
            if (OnChanged is not null) await OnChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Converts a picker <see cref="TeacherDto"/> into a linked
    /// <see cref="TeacherWithRoleDto"/> (no role / no topics yet) so the newly
    /// linked teacher can be appended to the dialog's linked list.</summary>
    private static TeacherWithRoleDto ToWithRole(TeacherDto t) =>
        new(t.Id, t.TitleCodedValueId, t.FirstName, t.LastName, t.DisplayName,
            t.GenderCodedValueId, t.DateOfBirth, t.LevelOfEducationCodedValueId,
            t.QualificationCodedValueIds ?? [], t.IsDeleted, null, [],
            t.CreatedAt, t.UpdatedAt);

    private Task CloseAsync() => Dialog is null ? Task.CompletedTask : Dialog.CloseAsync();
}
