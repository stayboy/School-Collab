@* Dialog hosting the shared <StrandsEditor> for a single topic. The editor is
   self-contained (loads + CRUD via the StudentsApiClient) and manages root
   strands AND their lessons (lessons are parented strands — strand-lesson-
   unification-plan.md), so this dialog is the single place to view/edit a topic's
   curriculum. Replaces the separate lessons dialog. Only passes TopicId/TopicName
   through and owns the Close affordance. Not a DialogShellBase (no
   model/form/result) — mirrors GuardianContactsDialog and is opened via
   ShowReadonlyDialogAsync. *@
@implements IDialogContentComponent<DialogParameters>
@using SchoolCollab.Students.Application.Components.Students
@using Microsoft.FluentUI.AspNetCore.Components

<div class="topic-dialog">
    <StrandsEditor TopicId="@TopicId" TopicName="@TopicName" />
    <div class="dialog-footer">
        <FluentButton Appearance="Appearance.Accent" OnClick="CloseAsync">Close</FluentButton>
    </div>
</div>

@code {
    /// <summary>Keys used in <see cref="Content"/> (the DialogParameters
    /// indexer). Exposed so callers set the same keys they read here.</summary>
    public const string TopicIdKey = nameof(TopicId);
    public const string TopicNameKey = nameof(TopicName);
    public const string OnChangedKey = nameof(OnChanged);

    /// <summary>Read from <see cref="Content"/> — FluentUI renders dialog
    /// content via DynamicComponent with only { "Content": &lt;DialogParameters&gt; }
    /// and does NOT spread indexer entries onto separate <c>[Parameter]</c>s.</summary>
    private Guid TopicId => Content is { } c ? c.TryGet<Guid>(TopicIdKey) : Guid.Empty;
    private string? TopicName => Content is { } c ? c.TryGet<string>(TopicNameKey) : null;
    private Func<Task>? OnChanged => Content is { } c ? c.TryGet<Func<Task>>(OnChangedKey) : null;

    [CascadingParameter] public FluentDialog? Dialog { get; set; }
    [Parameter] public DialogParameters Content { get; set; } = default!;

    private async Task CloseAsync()
    {
        if (OnChanged is not null) await OnChanged.Invoke();
        if (Dialog is not null) await Dialog.CloseAsync();
    }
}
