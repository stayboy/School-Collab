@* Dialog hosting the shared <StrandsEditor> for a single topic. The editor is
   self-contained (loads + CRUD via the StudentsApiClient) and manages root
   strands AND their lessons (lessons are parented strands — strand-lesson-
   unification-plan.md), so this dialog is the single place to view/edit a topic's
   curriculum. Replaces the separate lessons dialog. Only passes TopicId/TopicName
   through and owns the Close affordance. Not a DialogShellBase (no
   model/form/result) — mirrors GuardianContactsDialog and is opened via
   ShowReadonlyDialogAsync. *@
@using SchoolCollab.Students.Application.Components.Students
@using Microsoft.FluentUI.AspNetCore.Components

<DialogShellBody>
<div class="topic-dialog">
    <StrandsEditor TopicId="@TopicId" TopicName="@TopicName" />
    <div class="dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CloseAsync">Close</FluentButton>
    </div>
</div>
</DialogShellBody>

@code {
    /// <summary>Keys used in <c>DialogOptions.Parameters</c>. Exposed so
    /// callers set the same keys this dialog binds to — each key MUST match a
    /// <c>[Parameter]</c> name (FluentUI 5.x spreads the entries).</summary>
    public const string TopicIdKey = nameof(TopicId);
    public const string TopicNameKey = nameof(TopicName);
    public const string OnChangedKey = nameof(OnChanged);

    /// <summary>The topic whose curriculum to edit. Required — no default.</summary>
    [Parameter] public Guid TopicId { get; set; }

    /// <summary>The topic name, shown by the editor.</summary>
    [Parameter] public string? TopicName { get; set; }

    /// <summary>Optional callback the parent runs when the dialog closes, so
    /// it can refresh the card the editor mutated.</summary>
    [Parameter] public Func<Task>? OnChanged { get; set; }

    /// <summary>The hosting dialog instance provided by the dialog host as a
    /// cascading parameter. Nullable so unit tests that render the component
    /// without a host do not NRE.</summary>
    [CascadingParameter] public IDialogInstance? DialogInstance { get; set; }

    private async Task CloseAsync()
    {
        if (OnChanged is not null) await OnChanged.Invoke();
        if (DialogInstance is not null) await DialogInstance.CloseAsync();
    }
}
