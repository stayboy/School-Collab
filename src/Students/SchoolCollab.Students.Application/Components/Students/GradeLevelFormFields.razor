@*
    Shared grade-level form fields. Renders the single-page "create / edit
    grade level" field set used by:
      - /students/grade-levels/create  (Create.razor)
      - /students/grade-levels/{id}/edit (Edit.razor)

    The component owns the <EditForm>, the <DataAnnotationsValidator />, the
    field rows, AND the action row (Submit / Cancel buttons). Parents supply:
      - the model (bound to <EditForm Model>)
      - the OnValidSubmit handler
      - the action buttons via parameters (SubmitLabel, Submitting,
        SubmittingLabel, ShowCancel, CancelLabel, OnCancel).
      - any visible error message via ErrorMessage

    The simplified form (spec §3) collapses the old multi-step
    GradeLevelWizard into a single page. It does NOT cover:
      - Student enrolment (handled in the Students page / StudentTransferDialog)
      - Guardian assignment (removed per spec §6.2)
      - Active period setup (the global ActiveTermToolbar is the source of truth)

    Each field row uses the canonical <FormRow> primitive from
    SchoolCollab.Admin.Shared — the repo-wide fixed-width (180px) label
    cell + flexible input cell pattern that guarantees all labels are
    equal-width and every input's left edge lands on the same vertical
    axis.

    A CSS border-top on .form-actions draws the horizontal line that
    separates the field block from the action buttons below (matches
    the established PeriodForm / StudentFormFields pattern).
*@
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Students.Core.DTOs
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Core.Contracts
@using SchoolCollab.Admin.Shared.Services
@using CodedValueDto = SchoolCollab.Admin.Shared.Services.CodedValueDto
@using GradeLevelDto = SchoolCollab.Students.Application.Services.GradeLevelDto
@using SubjectDto = SchoolCollab.Students.Application.Services.SubjectDto
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<EditForm Model="@Model" OnValidSubmit="@OnValidSubmit" @ref="_editForm" class="grade-level-form-fields">
    <DataAnnotationsValidator />

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        <FormRow Label="Grade" For="grade-level-coded-value" Required="true">
            <CodedValueDropdown Parent="CodedValueParent.Grades"
                                @bind-SelectedId="Model.CodedValueId"
                                @bind-SelectedId:after="OnCodedValueChanged" />
        </FormRow>

        <FormRow Label="Name" For="grade-level-name" Required="true">
            <FluentTextField @bind-Value="Model.Name"
                             Id="grade-level-name"
                             Required="true"
                             Placeholder="Display name for this grade"
                             Style="width: 100%;" />
        </FormRow>

        <FormRow Label="Level" For="grade-level-level">
            <FluentNumberField @bind-Value="Model.Level"
                               Id="grade-level-level"
                               ReadOnly="true"
                               Style="width: 100%;"
                               Title="Mirrors the grade's coded value DisplayOrder. Read-only." />
        </FormRow>

        <FormRow Label="Display Order" For="grade-level-display-order">
            <FluentNumberField @bind-Value="Model.DisplayOrder"
                               Id="grade-level-display-order"
                               ReadOnly="true"
                               Style="width: 100%;"
                               Title="Mirrors the grade's coded value DisplayOrder. Read-only." />
        </FormRow>

        @* ── Enrollment validation guard clauses (plan §2/§10) ──
           Optional. Age range and Allowed Gender restrict which students can
           enroll in this grade level; both default to no restriction. The age
           range is presented as a single "range" row (Min–Max), mirroring the
           two-input "Dates *" row pattern from PeriodForm. These rules are
           enforced by EnrollStudentHandler when FEATURE:EnableEnrollmentValidation
           is on (default off); the domain (GradeLevel.Create/Update) also
           rejects MinAge > MaxAge. *@
        <FormRow Label="Age range" AlignTop>
            <FluentNumberField @bind-Value="Model.MinAge"
                               Id="grade-level-min-age"
                               Min="0"
                               Max="150"
                               Placeholder="No minimum"
                               Style="flex:1; min-width:0"
                               Title="Minimum age (inclusive) for enrolling in this grade. Leave blank for no minimum." />
            <span aria-hidden="true" style="opacity:0.6; padding:0 6px;">–</span>
            <FluentNumberField @bind-Value="Model.MaxAge"
                               Id="grade-level-max-age"
                               Min="0"
                               Max="150"
                               Placeholder="No maximum"
                               Style="flex:1; min-width:0"
                               Title="Maximum age (inclusive) for enrolling in this grade. Leave blank for no maximum." />
        </FormRow>

        <FormRow Label="Allowed Gender" For="grade-level-allowed-gender">
            <CodedValueDropdown Parent="CodedValueParent.Genders"
                                @bind-SelectedId="Model.AllowedGenderCodedValueId"
                                Placeholder="No restriction (co-ed)" />
        </FormRow>
    </FluentStack>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@ErrorMessage</FluentMessageBar>
    }

    <div class="form-actions">
        <FluentButton Type="ButtonType.Submit"
                      Appearance="Appearance.Accent"
                      Disabled="@Submitting"
                      IconStart="@FluentIcons.Save">
            @(Submitting ? (SubmittingLabel ?? "Saving…") : (SubmitLabel ?? "Save"))
        </FluentButton>
        @if (ShowCancel)
        {
            <FluentButton Appearance="Appearance.Outline"
                          OnClick="OnCancel"
                          Disabled="@Submitting"
                          class="ms-2">
                @(CancelLabel ?? "Cancel")
            </FluentButton>
        }
        @Actions
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public GradeLevelFormModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }

    /// <summary>Label for the submit button (e.g. "Create" vs "Save").</summary>
    [Parameter] public string? SubmitLabel { get; set; }

    /// <summary>Label shown while the submit is in flight.</summary>
    [Parameter] public string? SubmittingLabel { get; set; }

    [Parameter] public bool Submitting { get; set; }
    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public string? CancelLabel { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Visible error message rendered above the action row.</summary>
    [Parameter] public string? ErrorMessage { get; set; }

    /// <summary>Optional advanced override for the action row (e.g. dialog footer).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    private EditForm? _editForm;

    /// <summary>
    /// Syncs the model's Name and Level/DisplayOrder with the picked coded
    /// value. Called from the <CodedValueDropdown>'s @bind-SelectedId:after.
    /// </summary>
    private void OnCodedValueChanged()
    {
        // The CodedValueDropdown raises after SelectedId changes; the calling
        // page resolves the full CodedValueDto via the API and updates Model
        // properties (Name, Level, DisplayOrder) through the OnCodedValuePicked
        // callback if provided. We don't fetch here — the parent owns the
        // data layer.
    }

    public sealed class GradeLevelFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public Guid? CodedValueId { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string? Name { get; set; }

        public int Level { get; set; }
        public int DisplayOrder { get; set; }

        // Enrollment validation guard clauses (plan §2/§10).
        public int? MinAge { get; set; }
        public int? MaxAge { get; set; }
        public Guid? AllowedGenderCodedValueId { get; set; }
    }
}