@* StudentEditDialog — edit a student's core profile in a modal dialog
   (section-card-lessons-adoption.md §9 dec 2). Wraps the shared
   <StudentFormFields> (same field set + validation as /students/{id}/edit)
   and saves the whole student (profile + guardians + contacts) atomically via
   UpdateStudentWithLinkedDataAsync. Opens from the Students card kebab Edit
   action via ShowReadonlyDialogAsync. *@
@implements IDialogContentComponent<DialogParameters>
@using System.Net
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject ILogger<StudentEditDialog> Logger

@* The dialog content lives inside .fluent-dialog-body (the 1fr grid row
   of the FluentDialog). We wrap the whole dialog body in
   .student-edit-dialog-root so it is the positioned ancestor (position:
   relative; height: 100%) for the shared <DialogDrawer>, which fills the
   dialog body content area exactly — between the title bar (above) and
   the actions bar (below). *@
<div class="student-edit-dialog-root @RootModifierClasses">
@if (!_loaded)
{
    @* The student profile is still loading. We gate the whole form on
       _loaded so the <FluentTextField @bind-Value> components are created
       AFTER the model is populated. FluentUI's fluent-text-field Web
       Component does not re-sync its internal value when the Blazor Value
       attribute changes after initial connection — rendering it against an
       empty model (the pre-load state) leaves the inputs blank even though
       the model is populated a tick later. Gating on _loaded avoids that
       entirely: the fields connect with the real values on first render. *@
    <div class="student-edit-loading">
        <FluentProgressRing />
    </div>
}
else
{
    @if (_concurrencyConflict)
    {
        <FluentMessageBar Intent="MessageIntent.Warning" class="mb-3">
            This student was changed by someone else. Reload to see the latest and retry.
            <FluentButton Appearance="Appearance.Accent" Size="ButtonSize.Small" OnClick="ReloadAsync">Reload</FluentButton>
        </FluentMessageBar>
    }
    <StudentFormFields Model="_model"
                       ShowGuardians="true"
                       ShowContacts="true"
                       Wide="true"
                       ReadOnlyStudentNumber="true"
                       StudentId="@StudentId"
                       ErrorMessage="@_error"
                       OnValidSubmit="OnSaveAsync"
                       SubmitLabel="Save Changes"
                       SubmittingLabel="Saving…"
                       Submitting="@_saving"
                       OnCancel="CancelAsync"
                       SectionsReadonly="true"
                       ProfileFieldsDisabled="@(_editor != ActiveEditor.None)"
                       OnEditContact="OpenEditContactAsync"
                       OnAddContact="OpenAddContactFormAsync"
                       OnEditGuardian="OpenEditGuardianAsync"
                       OnAddGuardian="OpenAddGuardianAsync" />

    @* Shared dialog-content drawer. Hosted by the dialog: it slides in over
       the dialog body whenever a section editor is open, hosting a focused
       per-item edit form for the selected contact / guardian (View="Edit" with
       InitialEditKey / InitialEditIndex / IsAdd). Save/Cancel mutate the shared
       in-memory lists so the Readonly summary behind it stays in sync. *@
    <DialogDrawer Open="@(_editor != ActiveEditor.None)"
                  OpenChanged="OnDrawerOpenChangedAsync"
                  Title="@GetDrawerTitle()"
                  Side="DialogDrawerSide.Right"
                  Width="420px"
                  ShowCancel="true"
                  CancelText="Close">
        @if (_editor == ActiveEditor.Contacts)
        {
            <ContactsEditor View="ContactsEditor.ContactsView.Edit"
                            Mode="ContactsEditor.EditorMode.Buffered"
                            OwnerType="ContactOwnerType.Student"
                            Contacts="_model.Contacts"
                            IsAdd="@_isAdd"
                            InitialEditKey="@_editingContactKey"
                            ContactsChanged="OnDraftContactsChanged" />
        }
        else if (_editor == ActiveEditor.Guardians)
        {
            <GuardianSection View="GuardianSection.GuardianView.Edit"
                             GuardianLinks="_model.GuardianLinks"
                             Mode="StudentFormFieldsMode.Inline"
                             StudentId="StudentId"
                             IsAdd="@_isAdd"
                             InitialEditIndex="@_editingGuardianIndex"
                             OnContactSubScreenChanged="OnGuardianContactSubScreenChanged" />
        }
    </DialogDrawer>
}
</div>

@code {
    /// <summary>Key used in <see cref="Content"/> for the student being edited.
    /// Exposed so callers (Detail.razor) set the same key they read here.</summary>
    public const string StudentIdKey = nameof(StudentId);

    /// <summary>
    /// The student being edited.
    ///
    /// Read from <see cref="Content"/> (the <see cref="DialogParameters"/>
    /// indexer) rather than a separate <c>[Parameter]</c>: FluentUI renders the
    /// dialog content via <c>DynamicComponent</c> with only
    /// <c>Parameters = { "Content": &lt;DialogParameters&gt; }</c> — it does NOT
    /// spread <c>DialogParameters</c> indexer entries onto the component's
    /// <c>[Parameter]</c> properties. So a separate <c>[Parameter] Guid StudentId</c>
    /// is never set and would silently default to <see cref="Guid.Empty"/>
    /// (an empty-guid edit load).
    /// </summary>
    private Guid StudentId =>
        Content is { } c ? c.TryGet<Guid>(StudentIdKey) : Guid.Empty;

    [CascadingParameter] public FluentDialog? Dialog { get; set; }
    [Parameter] public DialogParameters Content { get; set; } = default!;

    private readonly StudentFormModel _model = new();
    private bool _saving;
    private bool _loaded;
    private bool _concurrencyConflict;
    private string? _error;

    // ── Focused section-edit state ──
    // The dialog owns the section-edit state machine. While a section reports
    // that it is editing, the form hides the other section, disables the
    // profile fields, and disables the dialog's Save/Cancel. The sections'
    // own Cancel/Save buttons remain usable.
    /// <summary>Which section editor, if any, is open in the shared drawer.
    /// The dialog owns this switch; the sections never report their edit state
    /// up to the host. While a drawer is open the dialog disables the profile
    /// fields + action row (via ProfileFieldsDisabled) and the sibling trigger.</summary>
    private ActiveEditor _editor = ActiveEditor.None;

    private enum ActiveEditor { None, Contacts, Guardians }

    // Focused per-item edit state. The dialog owns the "what's open" pointer;
    // the section editors (Contacts / Guardians) read it via their InitialEdit*
    // parameters and re-initialize their working copy on every parameter set.
    // _isAdd = true → blank focused form (Add); _isAdd = false → focused edit
    // for the selected existing item. _editingGuardianIndex follows
    // GuardianSection's "no target" convention of -1.
    private Guid? _editingContactKey;
    private int _editingGuardianIndex = -1;
    private bool _isAdd;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var student = await Api.GetStudentByIdAsync(StudentId);
            if (student is not null)
            {
                var guardians = await Api.ListGuardiansByStudentAsync(StudentId) ?? [];
                var contacts = await Api.ListContactsAsync(ContactOwnerType.Student, StudentId) ?? [];
                // All-inclusive load: profile + guardians + contacts + the concurrency
                // snapshot (RowVersion + loaded-id sets) so ToUpdateRequest can echo them back.
                _model.LoadFrom(student, guardians, contacts);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load student {StudentId} for edit", StudentId);
            _error = $"Could not load: {ex.Message}";
        }
        finally
        {
            // Always mark loaded so the form renders even on failure (the
            // error surfaces via ErrorMessage and the user can still save a
            // manually-entered profile, or cancel).
            _loaded = true;
        }
    }

    private async Task OnSaveAsync()
    {
        if (_saving) return;
        // Safety guard: never persist while a section drawer is open. The
        // dialog's Save button is disabled during a section edit, but this
        // also covers an Enter-key form submit that bypasses the button.
        if (_editor != ActiveEditor.None) return;
        _saving = true;
        _error = null;
        try
        {
            var request = _model.ToUpdateRequest();
            await Api.UpdateStudentWithLinkedDataAsync(StudentId, request);
            if (Dialog is not null) await Dialog.CloseAsync(StudentId);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            Logger.LogWarning(ex, "Concurrent edit on student {StudentId}", StudentId);
            _concurrencyConflict = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update student {StudentId}", StudentId);
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadAsync()
    {
        _concurrencyConflict = false;
        _error = null;
        _loaded = false;
        await LoadAsync();
    }

    private Task CancelAsync() => Dialog is null ? Task.CompletedTask : Dialog.CloseAsync();

    // --- Section-editor open/close orchestration ---

    /// <summary>Opens the Contacts focused edit form for the given contact in
    /// the shared drawer. Fired by the per-card "Edit" button on the Readonly
    /// contacts summary.</summary>
    private Task OpenEditContactAsync(Guid key)
    {
        _editor = ActiveEditor.Contacts;
        _isAdd = false;
        _editingContactKey = key;
        return Task.CompletedTask;
    }

    /// <summary>Opens the Contacts focused add form (blank) in the shared
    /// drawer. Fired by the "Add contact" FluentAnchor on the Readonly
    /// contacts summary.</summary>
    private Task OpenAddContactFormAsync()
    {
        _editor = ActiveEditor.Contacts;
        _isAdd = true;
        _editingContactKey = null;
        return Task.CompletedTask;
    }

    /// <summary>Opens the Guardians focused edit form for the given guardian in
    /// the shared drawer. Fired by the per-card "Edit" button on the Readonly
    /// guardians summary. The argument is the guardian's index in
    /// <see cref="StudentFormModel.GuardianLinks"/>.</summary>
    private Task OpenEditGuardianAsync(int index)
    {
        _editor = ActiveEditor.Guardians;
        _isAdd = false;
        _editingGuardianIndex = index;
        return Task.CompletedTask;
    }

    /// <summary>Opens the Guardians focused add form (blank) in the shared
    /// drawer. Fired by the "Add guardian" FluentAnchor on the Readonly
    /// guardians summary.</summary>
    private Task OpenAddGuardianAsync()
    {
        _editor = ActiveEditor.Guardians;
        _isAdd = true;
        _editingGuardianIndex = -1;
        return Task.CompletedTask;
    }

    /// <summary>Drawer title. Reflects which editor is open, whether this is
    /// an add or edit of an existing item, and — for the guardians editor —
    /// which contact sub-screen is active. The sub-screen has no in-body
    /// heading (it reclaims vertical space), so the chrome title names the
    /// mode: "Add Guardian Contact" / "Edit Guardian Contact" /
    /// "Remove Guardian Contact" while a contact sub-screen is open, otherwise
    /// the base guardian title.</summary>
    private string GetDrawerTitle() => _editor switch
    {
        ActiveEditor.Contacts => _isAdd ? "Add contact" : "Edit contact",
        ActiveEditor.Guardians => _guardianContactSubScreen switch
        {
            GuardianSection.GuardianContactSubScreen.Add => "Add Guardian Contact",
            GuardianSection.GuardianContactSubScreen.Edit => "Edit Guardian Contact",
            GuardianSection.GuardianContactSubScreen.Remove => "Remove Guardian Contact",
            _ => _isAdd ? "Add guardian" : "Edit Guardian",
        },
        _ => ""
    };

    /// <summary>The guardian contact sub-screen the drawer is currently showing
    /// (None = the guardian list surface). Reported up by <c>GuardianSection</c>
    /// so the chrome title can name the sub-screen. Defaults to None so the
    /// drawer opens with the base guardian title.</summary>
    private GuardianSection.GuardianContactSubScreen _guardianContactSubScreen =
        GuardianSection.GuardianContactSubScreen.None;

    /// <summary>Extra CSS modifier classes for the dialog-content root wrapper.
    /// While a guardian contact sub-screen (Add / Edit / Remove) is open the
    /// drawer body needs more vertical room for the contact form + inline reason
    /// than the default 320px floor provides, so we raise the root's min-height
    /// to avoid a scrollbar in the drawer (the content-filled dialog box then
    /// grows to fit and re-collapses on return to the guardian list). Driven by
    /// the same reported sub-screen state that keys the chrome title, and toggles
    /// on the same re-render.</summary>
    private string RootModifierClasses =>
        _editor == ActiveEditor.Guardians
        && _guardianContactSubScreen != GuardianSection.GuardianContactSubScreen.None
            ? "student-edit-dialog-root--guardian-contact"
            : string.Empty;

    /// <summary>Receives the guardian contact sub-screen mode when it changes
    /// so the drawer title can reflect Add / Edit / Remove. Re-renders so the
    /// <c>DialogDrawer</c> <c>Title</c> binding re-evaluates.</summary>
    private Task OnGuardianContactSubScreenChanged(GuardianSection.GuardianContactSubScreen mode)
    {
        _guardianContactSubScreen = mode;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Drawer OpenChanged handler. Cancel / backdrop / Escape arrive
    /// here. Clears the active editor + focused-edit state so the drawer
    /// closes; the dialog remains open. Re-renders so the Readonly summary
    /// behind it reflects the latest in-memory lists and so the per-card
    /// triggers on the summary re-enable (they're tied to _editor == None via
    /// ProfileFieldsDisabled / EditDisabled).</summary>
    private Task OnDrawerOpenChangedAsync(bool open)
    {
        if (!open)
        {
            _editor = ActiveEditor.None;
            _isAdd = false;
            _editingContactKey = null;
            _editingGuardianIndex = -1;
            _guardianContactSubScreen = GuardianSection.GuardianContactSubScreen.None;
        }
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Re-render bridge for the Buffered ContactsEditor in the drawer.
    /// The editor mutates Model.Contacts in place; this re-renders the dialog
    /// so the Readonly contacts summary stays in sync.</summary>
    private Task OnDraftContactsChanged() => InvokeAsync(StateHasChanged);
}
