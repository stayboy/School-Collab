@*
    JoinGroupsDialog — opens from the student Detail page's Activity Groups
    section header "Join Group" button (spec §3.6 FR-29/FR-30). Presents a
    searchable, multi-select list of available activity groups in the tenant
    (Status = Active, not at capacity, excluding groups the student is already
    an active member of). Submitting joins the selected groups in a single
    operation; partial failures are reported per-group.
*@
@inherits DialogShellBase<JoinGroupsDialog.JoinGroupsModel, JoinGroupsDialog.JoinGroupsResult>
@using System.ComponentModel.DataAnnotations
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Core.Features
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject IFeatureFlagService FeatureFlags

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <FluentStack Orientation="Orientation.Vertical" Spacing="3">
            <FluentTextField @bind-Value="_search"
                             Placeholder="Search available groups…" />

            @if (_loadingGroups)
            {
                <div class="spinner-container"><FluentProgressRing /></div>
            }
            else if (_availableGroups.Count == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Info">
                    No other groups are available to join right now.
                </FluentMessageBar>
            }
            else
            {
                @* Raw FluentSelect with Multiple (not a wrapper): dropdown-ui/SKILL.md routes
                   multi-select pickers to the raw control and asks for the reason to be
                   documented here — every shared dropdown wrapper is single-value. The
                   selection binds the supported SelectedOptions/SelectedOptionsChanged pair
                   over the group objects; Model.SelectedGroupIds stays the single source of
                   truth for the join loop. (Round fluentui-dead-binding: this element bound
                   the SelectedValues / SelectedValuesChanged pair — neither of which exists on FluentUI 4.14.2 list
                   components, so the binding fell into AdditionalAttributes — a stray
                   selectedvalues HTML attribute — and the picker neither showed nor
                   reported a selection.) *@
                <FluentSelect TOption="ActivityGroupDto" Items="@_filteredGroups"
                              OptionText="@(g => GroupOptionText(g))"
                              OptionValue="@(g => g.Id.ToString())"
                              Multiple="true"
                              SelectedOptions="@SelectedGroupOptions"
                              SelectedOptionsChanged="@OnSelectedGroupsChanged" />
            }
        </FluentStack>

        <DialogShellFooter Saving="@Saving"
                           Error="@Error"
                           SubmitText="Join"
                           SavingText="Joining…"
                           OnCancel="HandleCancelAsync" />
    </EditForm>
</div>


@code {
    public sealed class JoinGroupsModel
    {
        [Required] public HashSet<Guid> SelectedGroupIds { get; set; } = new();
        public Guid StudentId { get; set; }
    }

    public sealed record JoinGroupsResult(IReadOnlyList<Guid> GroupIds);

    private string? _search;
    private List<ActivityGroupDto> _availableGroups = new();
    private bool _loadingGroups = true;
    private string _activePeriodKind = "AcademicYear";

    /// <summary>
    /// The picker's selected option objects, projected from
    /// <see cref="JoinGroupsModel.SelectedGroupIds"/>. The ids stay the single source
    /// of truth (the join loop reads them); FluentSelect highlights the options it is
    /// handed. Projected over the full joinable list, not the search-filtered view,
    /// so a group hidden by the current search stays part of the selection.
    /// </summary>
    private IEnumerable<ActivityGroupDto> SelectedGroupOptions =>
        _availableGroups.Where(g => Model.SelectedGroupIds.Contains(g.Id));

    /// <summary>
    /// Writes the picker's option objects back to the model's ids field, preserving the
    /// groups the active search has filtered out of the picker's <c>Items</c>.
    /// </summary>
    private void OnSelectedGroupsChanged(IEnumerable<ActivityGroupDto>? selected)
    {
        // Hidden-selection preservation. FluentSelect renders only the search-filtered
        // _filteredGroups and reports only what it renders; if it re-derives its
        // selection from those rendered options, replacing the ids wholesale would
        // silently drop a group the user picked before typing a search that hides it.
        // Union the ids that are not currently rendered with the incoming selection:
        // idempotent when the control already preserves the passed selection, and a
        // repair when it does not.
        var renderedIds = _filteredGroups.Select(g => g.Id).ToHashSet();
        var hidden = Model.SelectedGroupIds.Where(id => !renderedIds.Contains(id));
        Model.SelectedGroupIds = hidden.Concat((selected ?? []).Select(g => g.Id)).ToHashSet();
    }

    private IEnumerable<ActivityGroupDto> _filteredGroups =>
        string.IsNullOrWhiteSpace(_search)
            ? _availableGroups
            : _availableGroups.Where(g =>
                g.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (g.Category?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private static string FormatMembers(ActivityGroupDto g) =>
        g.Capacity.HasValue
            ? $"{g.ActiveMemberCount}/{g.Capacity} members"
            : $"{g.ActiveMemberCount} members";

    private static string GroupOptionText(ActivityGroupDto g) =>
        $"{g.Name}  ·  {g.Category ?? "General"} · {g.Span} · {FormatMembers(g)}";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadingGroups = true;
        try
        {
            // Defense in depth. The Activity Groups section that opens this dialog is
            // already gated by FEATURE:EnableActivityGroups (Students/Detail.razor —
            // the *student* detail page, not GradeLevels/Detail.razor), but
            // /activity-groups is only mapped when the flag is on — so if the flag is
            // off (or flipped between open and load) say so plainly instead of
            // surfacing a raw 404 as the dialog's error.
            if (!await FeatureFlags.IsEnabledAsync(FeatureFlagKeys.EnableActivityGroups))
            {
                _availableGroups = new();
                Error = "Activity groups are not enabled for this tenant.";
                return;
            }

            // All groups, then current memberships to exclude + capacity check.
            var all = await Api.ListActivityGroupsAsync();
            var current = await Api.ListStudentGroupsAsync(Model.StudentId);
            var currentIds = new HashSet<Guid>(current?.Select(g => g.Id) ?? Array.Empty<Guid>());

            // Resolve the active period kind so period-aligned spans can be
            // filtered to the currently-open period (spec FR-43).
            var activeSub = await Api.GetActiveSubPeriodAsync();
            var activeYear = await Api.GetActiveAcademicYearAsync();
            _activePeriodKind = activeSub is not null ? KindOf(activeSub)
                : activeYear is not null ? KindOf(activeYear)
                : "AcademicYear";

            _availableGroups = (all ?? Array.Empty<ActivityGroupDto>())
                .Where(g => g.IsActive
                    && !currentIds.Contains(g.Id)
                    && (!g.Capacity.HasValue || g.ActiveMemberCount < g.Capacity.Value)
                    && SpanCompatible(g))
                .OrderBy(g => g.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            _loadingGroups = false;
        }
    }

    private static string KindOf(PeriodDto p)
        => p.ParentPeriodId is null ? "AcademicYear" : p.Division == "Semesters" ? "Semester" : "Term";

    /// <summary>
    /// Span-aware joinability (spec FR-28..32, FR-40/43/52). OpenEnded is always
    /// joinable; DateRange only while its window is open; period-aligned spans
    /// only when the active period matches the span's required period kind.
    /// </summary>
    private bool SpanCompatible(ActivityGroupDto g)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return g.Span switch
        {
            "OpenEnded" => true,
            "DateRange" => g.EnrollmentStartDate.HasValue && g.EnrollmentEndDate.HasValue
                && today >= g.EnrollmentStartDate.Value && today <= g.EnrollmentEndDate.Value,
            "WholeAcademicYear" => _activePeriodKind == "AcademicYear",
            "Termly" => _activePeriodKind == "Term",
            "Semester" => _activePeriodKind == "Semester",
            _ => true
        };
    }

    protected override async Task<JoinGroupsResult?> SubmitAsync(JoinGroupsModel model)
    {
        if (model.SelectedGroupIds.Count == 0)
        {
            Error = "Select at least one group to join.";
            return null;
        }

        var failures = new List<string>();
        foreach (var groupId in model.SelectedGroupIds)
        {
            try
            {
                await Api.AddGroupMemberAsync(groupId, new AddActivityGroupMemberRequest(Model.StudentId));
            }
            catch (Exception ex)
            {
                var group = _availableGroups.FirstOrDefault(g => g.Id == groupId);
                failures.Add($"{group?.Name ?? groupId.ToString()}: {ex.Message}");
            }
        }

        if (failures.Count > 0)
        {
            Error = $"Some groups could not be joined: {string.Join("; ", failures)}";
            return null;
        }

        return new JoinGroupsResult(model.SelectedGroupIds.ToList());
    }
}