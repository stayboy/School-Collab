@*
    StrandsDialog - opens from the Grade Levels landing
*@
@inherits DialogShellBase<StrandsDialog.StrandsDialogModel, StrandsDialog.StrandsDialogResult>
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <span>Strands dialog content.</span>
        <DialogShellFooter SubmitText="Close" />
    </EditForm>
</div>
@code {
    private bool _loading = true;
    private string? _error;
    public sealed class StrandsDialogModel
    {
        public Guid GradeLevelId { get; set; }
        public string? GradeLevelName { get; set; }
    }
    public sealed class StrandsDialogResult { }
    protected override Task<StrandsDialogResult?> SubmitAsync(StrandsDialogModel model)
    {
        return Task.FromResult<StrandsDialogResult?>(new StrandsDialogResult());
    }
}
