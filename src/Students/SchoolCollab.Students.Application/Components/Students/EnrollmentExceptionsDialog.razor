@inherits DialogShellBase<EnrollmentExceptionsDialog.EnrollmentExceptionsModel, EnrollmentExceptionsDialog.EnrollmentExceptionsResult>
@using System.Globalization
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using EnrollmentExceptionDto = SchoolCollab.Students.Core.DTOs.SubjectEnrollmentExceptionDto
@inject StudentsApiClient Api
@inject ILogger<EnrollmentExceptionsDialog> Logger
@implements IDisposable

@*  EnrollmentExceptionsDialog — the ONE place subject enrollment exceptions are edited
    (subject-period-exception-model.md v8 §5.1). It replaces the retired
    /students/enrollment-exceptions page: every other surface (the Topics landing, the
    grade-detail Subjects card, the View-all dialog) only carries a count badge and a kebab
    that opens THIS dialog (§5.2).

    Shape (D5, owner decision 2026-09-29): the scope is LOCKED — one owner + one subject come
    from the call site and render read-only. There is no owner toggle, no grade/subject filter
    row and no "All subjects": that filter chrome is exactly what the dialog exists to delete,
    and the dialog is opened per-subject by each call site.

    D2: ONE dialog, two regions — the subject's exception list on top and the add form below,
    both always visible. No mode swap, no SideDrawer. D3: the add form IS the shell's
    EditForm (DialogShellBase), so the write rides the shared footer; a successful submit
    returns null — the dialog STAYS OPEN, because it is a management surface, not a
    single-shot form — after re-reading the list. Error is set only on failure.

    D4 keeps the add-form logic of v6/v7 unchanged: the period part is CHOSEN as an academic
    division ("Fill from"), only where the tenant can write it (FR-56 for a group owner,
    "a period exists for it" for a grade), the position is a MULTI-select ladder of 1st–4th
    plus any higher declared position writing one row per ticked sequence through
    POST /students/enrollment-exceptions/bulk, a position the tenant has no period for renders
    DISABLED, and the date range belongs to "Any date" alone.

    An exception is a period PART (descriptive only, never matched against dates, §0
    decision 9) plus a nullable date span, at least one bound. The span is ONE range whose open
    ends read "(any start)" / "(any end)" (§0 decision 12, kept). Zero exceptions is the NORMAL
    state, so the empty list is plain prose, not a warning (§5.4). D8: a rejected write shows the
    SERVER's own sentence verbatim, which the client extracts from the 409/422 body.
*@

<div class="exceptions-dialog">
    <section class="exceptions-section" aria-label="Enrollment exceptions">
        <div class="section-head">
            <h2 class="section-title">@Model.TopicName</h2>
            @* The owner is the dialog's scope made visible: the header title names the subject,
               so the owner reads as the description line beneath it rather than as a second
               heading. *@
            <span class="section-owner">@Model.OwnerName</span>
            @if (_exceptions is { Length: > 0 })
            {
                <FluentBadge Appearance="Appearance.Accent" Title="Enrollment exceptions">
                    @EnrollmentExceptionLabels.FormatCount(_exceptions.Length)
                </FluentBadge>
            }
        </div>

        @if (_exceptions is null)
        {
            <FluentProgressRing aria-label="Loading enrollment exceptions" />
        }
        else if (_loadError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error">@_loadError</FluentMessageBar>
        }
        else if (_exceptions.Length > 0)
        {
            <div class="exceptions-list">
                @foreach (var exception in _exceptions)
                {
                    <div class="exception-row" @key="exception.Id">
                        @* The subject column is omitted: the dialog is already one subject
                           (D5), so repeating the name in every row would say nothing. *@
                        <FluentBadge Appearance="Appearance.Neutral" Title="Period part">
                            @PartLabel(DivisionOf(exception.Division))
                        </FluentBadge>
                        <span class="exception-span">@SpanLabel(exception.StartDate, exception.EndDate)</span>
                        @if (!string.IsNullOrWhiteSpace(exception.Reason))
                        {
                            <span class="exception-reason" title="Reason">@exception.Reason</span>
                        }
                        <FluentButton Appearance="Appearance.Stealth"
                                      Class="exception-remove"
                                      IconStart="@FluentIcons.Delete"
                                      Title="Remove this exception"
                                      aria-label="@($"Remove exception for {Model.TopicName}")"
                                      Disabled="@_busy"
                                      OnClick="@(() => RemoveAsync(exception))" />
                    </div>
                }
            </div>
        }
        else
        {
            @* Zero exceptions is the expected state (FR-ED-14 dissolved): plain prose, never a
               warning. The sentence is the subject-scoped one, because the dialog always HAS a
               subject — "every subject is offered on every date" would be a different claim. *@
            <p class="exceptions-empty" role="status" aria-live="polite">No exceptions for @Model.TopicName — this subject is offered on every date.</p>
        }

        @* Add section — one form, the subject fixed by the dialog's scope (D5). The region is
           SEPARATED from the list above by .add-panel's own CSS border-top (dialog-ui §2 — a
           border-top, never a FluentDivider/<hr>). It is GATED while there is a list to read
           (F1/F2): the heading row carries the trigger that arms it, and the entry fields render
           disabled rather than collapsing. *@
        <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />
            <div class="add-panel">
                <div class="add-head">
                    @* The heading names the region only: the subject is already the dialog's scope
                       title above, so repeating it here would say nothing (F6). *@
                    <h3 class="add-title">Add exception</h3>
                    @* The trigger (F2) — the action that arms the form while a list is being read.
                       A FluentButton defaults to ButtonType.Button, so it cannot submit the
                       EditForm it sits in (unlike the footer's own Add exception). *@
                    @if (ShowAddTrigger)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      Title="Add a new exception"
                                      OnClick="OnAddTrigger">
                            + Add exception
                        </FluentButton>
                    }
                    @* The Reset (F7) — the armed form's own escape. It is the trigger's exact
                       inverse in the SAME heading-row slot, so the control does not move between
                       the two states; before it existed, the only way out of an armed form was the
                       footer's Close, which dismisses the whole dialog. Also Type=Button, so it
                       neither submits the form nor touches the footer's own Add exception. *@
                    @if (ShowAddReset)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      Title="Cancel adding an exception"
                                      OnClick="OnAddReset">
                            Reset
                        </FluentButton>
                    }
                </div>

                @* One horizontal row, built in FluentUI's OWN layout primitive — per
                   .github/copilot/rules/blazor-components.md (“prefer FluentUI's built-in
                   parameters over custom CSS for spacing, alignment, and layout”). Orientation +
                   Wrap + VerticalAlignment.Stretch + the two gaps express the row natively;
                   Stretch is what makes the cells EQUAL HEIGHT so every label lands on one line.
                   Wrap is deliberate: the row is ~980px of controls and must reflow rather than
                   overflow in the dialog. `add-form` stays as the DOM hook the tests select on. *@
                <FluentStack Orientation="Orientation.Horizontal"
                             Wrap="true"
                             VerticalAlignment="VerticalAlignment.Stretch"
                             HorizontalGap="16"
                             VerticalGap="16"
                             Class="add-form">
                    @* The part is CHOSEN, not derived (v5 §0 decision 13 reversed) and offered only
                       where it can be written: the divisions this tenant actually has periods for,
                       plus "Any date" for a free window. For a group owner FR-56 permits exactly
                       ONE division, so exactly one is offered. *@
                    <FormRow Label="Fill from" LabelPosition="RowLabelPosition.Below">
                        <DropdownComponent TItem="DivisionOption" TValue="AcademicYearDivision"
                                          Items="@DivisionOptions"
                                          Disabled="@(!FormActive)"
                                          @bind-SelectedValue="Division"
                                          @bind-SelectedValue:after="OnDivisionChangedAsync"
                                          OptionText="@(d => d.Label)"
                                          OptionValue="@(d => d.Value)"
                                          Width="FieldWidth.W3" />
                    </FormRow>

                    @if (PositionOptions.Length > 0)
                    {
                        @* The sequences are STRUCTURAL (Q1) and MULTI-SELECT (v6 §11.3): 1st–4th
                           always rendered, extended by any higher position the tenant declared,
                           writing one row per ticked sequence in ONE request. v7: a position with
                           no period behind it is DISABLED rather than hidden. The binding is the
                           inherited Value/ValueChanged pair (`FluentCheckbox :
                           FluentInputBase<bool>`), NOT CheckState, which THROWS unless
                           ThreeState is true. `Width=""` disables FluentStack's default width:100%,
                           which inside a content-sized cell is a circular percentage. *@
                        <FormRow Label="Position" LabelPosition="RowLabelPosition.Below">
                            <FluentStack Orientation="Orientation.Horizontal"
                                         Width=""
                                         HorizontalGap="12"
                                         role="group"
                                         aria-label="Position">
                                @foreach (var position in PositionOptions)
                                {
                                    <FluentCheckbox Value="@(_positions.Contains(position))"
                                                    Disabled="@(!FormActive || !PositionIsDerivable(position))"
                                                    ValueChanged="@(selected => SetPositionAsync(position, selected))">
                                        @PeriodPositionLabels.Number(position)
                                    </FluentCheckbox>
                                }
                            </FluentStack>
                        </FormRow>
                    }

                    @* The span inputs belong to the FREE WINDOW only (v7): with a real part chosen
                       the Position row is the only control and the range is removed ENTIRELY — no
                       derived-span text either ("keep span fully silent", v6 §11.2). The ends
                       reuse FormRow's label-below variant because FluentUI 4.14.2 has no
                       LabelPosition type and no Below value. *@
                    @if (!SpanIsDerived)
                    {
                        <div class="span-group" role="group" aria-label="Not offered">
                            <FormRow Label="Not offered from" For="exception-start-date" LabelPosition="RowLabelPosition.Below">
                                <FluentDatePicker Id="exception-start-date"
                                                  @bind-Value="_startDate"
                                                  @bind-Value:after="OnSpanChangedAsync"
                                                  Disabled="@(!FormActive)"
                                                  Placeholder="(any start)"
                                                  Class="w-3" />
                            </FormRow>
                            <FormRow Label="Not offered to" For="exception-end-date" LabelPosition="RowLabelPosition.Below">
                                <FluentDatePicker Id="exception-end-date"
                                                  @bind-Value="_endDate"
                                                  @bind-Value:after="OnSpanChangedAsync"
                                                  Disabled="@(!FormActive)"
                                                  Placeholder="(any end)"
                                                  Class="w-3" />
                            </FormRow>
                        </div>
                    }

                    <FormRow Label="Reason (optional)" LabelPosition="RowLabelPosition.Below">
                        <FluentTextField @bind-Value="_reason" Placeholder="Why?" Class="w-5" Disabled="@(!FormActive)" />
                    </FormRow>
                </FluentStack>

                @if (Error is null && _alreadyExcepted is true)
                {
                    <p class="add-note">
                        This subject is already excepted on @AnchorDateLabel — the server will reject an identical span.
                    </p>
                }
                else if (FormActive && Division != AcademicYearDivision.None && _positions.Count == 0)
                {
                    @* v7: a real part arms only on a POSITION now that the range is silent, so say
                       so rather than leaving a disabled button unexplained. Silent while the form
                       is gated: the advice is not yet reachable, and the controls are disabled. *@
                    <p class="add-note" role="status" aria-live="polite">
                        Choose a position to add an exception.
                    </p>
                }

                @* The shared shell footer carries the error bar and the Cancel / "Add exception"
                   row — including the §2 border-top separator, so this dialog draws no line of its
                   own. Placed INSIDE the EditForm: the footer's Submit is Type=Submit and fires
                   OnValidSubmit → HandleSubmitAsync → SubmitAsync. *@
                <DialogShellFooter Saving="@Saving"
                                   Error="@Error"
                                   SavingText="Adding..."
                                   SubmitText="Add exception"
                                   CancelText="Close"
                                   SubmitDisabled="@(!FormActive || !CanAdd)"
                                   OnCancel="HandleCancelAsync" />
            </div>
        </EditForm>
    </section>
</div>

@code {
    private const string ActivityGroupOwner = "ActivityGroup";

    /// <summary>
    /// How many positions the ladder offers before it starts extending: 1st–4th are always
    /// available, and a higher one the tenant has declared extends it — the same ladder as the
    /// period form's Sequence row (<c>PeriodFormFields</c>).
    /// </summary>
    private const int StandardPositionCount = 4;

    /// <summary>
    /// The dialog's scope (D5): one owner — grade or activity group — and one subject, both
    /// supplied by the call site and rendered read-only. Nothing here is a control.
    /// </summary>
    public sealed class EnrollmentExceptionsModel
    {
        /// <summary>The owner KIND: <c>GradeLevel</c> (default) or <c>ActivityGroup</c>.
        /// <see cref="OwnerName"/> is what the dialog renders; this decides which owner id
        /// travels on every read and write.</summary>
        public string OwnerType { get; set; } = "GradeLevel";

        /// <summary>The owner's id, interpreted through <see cref="OwnerType"/>.</summary>
        public Guid OwnerId { get; set; }

        /// <summary>The owner's display name — the dialog's description line, so the list is
        /// never context-free.</summary>
        public string OwnerName { get; set; } = string.Empty;

        /// <summary>The subject the dialog is scoped to; every row it lists and every row it
        /// writes belongs to it.</summary>
        public Guid TopicId { get; set; }

        /// <summary>The subject's display name — the dialog's heading and the write's target
        /// named in words.</summary>
        public string TopicName { get; set; } = string.Empty;
    }

    /// <summary>
    /// The dialog's result payload. It is deliberately EMPTY: a successful add keeps the dialog
    /// open (D3 — a management surface, not a single-shot form), so <see cref="SubmitAsync"/>
    /// always returns <c>null</c> and only the awaited <c>null</c> of a cancel carries meaning to
    /// the caller, which reloads its count badge after the dialog closes.
    /// </summary>
    public sealed record EnrollmentExceptionsResult;

    /// <summary>A choice on the add section's "Fill from" control — the period PART the exception
    /// is expressed in (v5: chosen, `AcademicYearDivision`). A record rather than binding the enum
    /// directly because the LABEL has to come from the dialog's one part spelling
    /// (<see cref="PartLabel"/>).</summary>
    public sealed record DivisionOption(AcademicYearDivision Value, string Label);

    private EnrollmentExceptionDto[]? _exceptions;
    private string? _loadError;

    /// <summary>The tenant's period hierarchy: which divisions exist, and which period backs a
    /// chosen position (its dates fill that item's span).</summary>
    private PeriodDto[] _periods = [];

    /// <summary>The owner's activity group, when the owner IS one — its <see cref="EnrollmentSpan"/>
    /// is what FR-56 keys the permitted period part on. Loaded from the group's own definition,
    /// because the call site supplies an id and a name, not a span.</summary>
    private ActivityGroupDto? _ownerGroup;

    private AcademicYearDivision _chosenDivision = AcademicYearDivision.None;
    private readonly HashSet<int> _positions = [];
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string? _reason;

    /// <summary>True when the span's anchor date is already excepted for this subject — the
    /// range's <c>/check</c> answer. Null = not (yet) known or the check could not run.</summary>
    private bool? _alreadyExcepted;

    /// <summary>
    /// Whether the reader has ASKED to add (F1) — the trigger's answer, and the only piece of
    /// state the gate below needs. A successful add sets it back to <c>false</c>, so the add form
    /// returns to being derived from the list rather than switched by a mode.
    /// </summary>
    private bool _addTriggered;

    private bool _busy;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private bool IsGroupOwner =>
        string.Equals(Model.OwnerType, ActivityGroupOwner, StringComparison.OrdinalIgnoreCase);

    private Guid? OwnerGradeLevelId => IsGroupOwner ? null : Model.OwnerId;

    private Guid? OwnerActivityGroupId => IsGroupOwner ? Model.OwnerId : null;

    protected override string SavingText => "Adding...";

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        if (IsGroupOwner)
        {
            await LoadOwnerGroupAsync(token);
            if (_disposed) return;
        }

        await LoadPeriodsAsync(token);
        if (_disposed) return;
        await LoadExceptionsAsync(token);
    }

    /// <summary>
    /// Reads the group's own definition — best effort, self-contained: only the FR-56 division
    /// narrowing depends on it, and an unloaded definition degrades to the same <c>None</c> the
    /// server's validator uses.
    /// </summary>
    private async Task LoadOwnerGroupAsync(CancellationToken token)
    {
        try
        {
            var groups = await Api.ListActivityGroupsAsync(token) ?? [];
            if (_disposed) return;
            _ownerGroup = groups.FirstOrDefault(g => g.Id == Model.OwnerId);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Could not load activity group {GroupId}; FR-56 narrows the parts to Any date", Model.OwnerId);
            _ownerGroup = null;
        }
    }

    /// <summary>
    /// Loads the tenant's periods — best effort: they are the source of the divisions the add
    /// section may express an exception in and of the dates a chosen position fills its span from.
    /// A failure leaves "Any date" and typed dates (still a complete, legal write), and the server
    /// validator remains the gate.
    /// </summary>
    private async Task LoadPeriodsAsync(CancellationToken token)
    {
        try
        {
            _periods = await Api.ListPeriodsAsync(token) ?? [];
            if (_disposed) return;
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Could not load the tenant's periods; the add section offers 'Any date' and typed dates only");
            _periods = [];
        }
    }

    /// <summary>
    /// Populates the exception list directly — it returns early instead of raising an error when
    /// the first load fails, so the two failure paths (first load, re-read after a mutation) report
    /// the same way.
    /// </summary>
    private async Task LoadExceptionsAsync(CancellationToken token)
    {
        _exceptions = null;
        _loadError = null;

        try
        {
            var exceptions = await Api.ListSubjectEnrollmentExceptionsAsync(
                gradeLevelId: OwnerGradeLevelId,
                activityGroupId: OwnerActivityGroupId,
                topicId: Model.TopicId,
                ct: token);
            if (_disposed) return;
            _exceptions = exceptions ?? [];
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load enrollment exceptions for topic {TopicId}", Model.TopicId);
            _loadError = ex.Message;
            _exceptions = [];
        }
    }

    /// <summary>
    /// The divisions the add section may express the exception in.
    ///
    /// <para>For a GROUP, FR-56 permits exactly ONE — <c>Termly</c>→Terms,
    /// <c>Semester</c>→Semesters, everything else→<c>None</c> — so the control offers exactly that
    /// one and no invalid write is reachable from it.</para>
    ///
    /// <para>For a GRADE the options are the divisions the tenant actually has periods for, plus
    /// <c>None</c>: "Any date" is always expressible, while a Term/Semester with no periods behind
    /// it is a part the tenant cannot fill from and would only invite a mistyped span.</para>
    /// </summary>
    private AcademicYearDivision[] AvailableDivisions
    {
        get
        {
            if (IsGroupOwner)
            {
                return [RequiredDivision(_ownerGroup?.Span ?? string.Empty)];
            }

            var divisions = new List<AcademicYearDivision>();
            if (_periods.Any(p => IsDivision(p, AcademicYearDivision.Terms)))
            {
                divisions.Add(AcademicYearDivision.Terms);
            }
            if (_periods.Any(p => IsDivision(p, AcademicYearDivision.Semesters)))
            {
                divisions.Add(AcademicYearDivision.Semesters);
            }
            divisions.Add(AcademicYearDivision.None);
            return [.. divisions];
        }
    }

    /// <summary>The "Fill from" options, labelled through the dialog's ONE part spelling
    /// (<see cref="PartLabel"/>), so the control and the list rows say the same words for the same
    /// concept (decision 14, kept from v4).</summary>
    private DivisionOption[] DivisionOptions =>
        [.. AvailableDivisions.Select(division => new DivisionOption(division, PartLabel(division)))];

    /// <summary>
    /// The division in force: the chosen one when the current owner may write it, otherwise the
    /// first one it may — one value for BOTH the control and the write, so a stale choice cannot
    /// reach the server (FR-56).
    /// </summary>
    private AcademicYearDivision Division
    {
        get => AvailableDivisions.Contains(_chosenDivision) ? _chosenDivision : AvailableDivisions[0];
        set => _chosenDivision = value;
    }

    /// <summary>
    /// The positions the control RENDERS: 1st–4th always, extended by any higher position the
    /// tenant has declared on a period of the same division (Q5) — the ladder is structural (Q1).
    /// Empty for <c>Any date</c>: a free window has no position in a run of terms or semesters, and
    /// the server rejects an ordinal on it.
    /// </summary>
    private int[] PositionOptions => Division == AcademicYearDivision.None
        ? []
        : [.. Enumerable.Range(1, Math.Max(StandardPositionCount, HighestDeclaredPosition))];

    /// <summary>The highest position the tenant has declared for the division in force, read across
    /// ALL its years (a position is structural, so a 5th term existing anywhere makes a 5th term
    /// nameable). The <c>DefaultIfEmpty</c> is load-bearing: a GROUP owner is offered the one
    /// division FR-56 permits whether or not the tenant has any period of it, and <c>Max</c> over an
    /// empty sequence throws rather than returning 0.</summary>
    private int HighestDeclaredPosition =>
        _periods.Where(p => IsDivision(p, Division)).Select(p => p.Sequence ?? 0).DefaultIfEmpty(0).Max();

    /// <summary>
    /// True for EVERY real part (v7): the range belongs to the free window, and a Term/Semester is
    /// written from the periods behind its positions, never from typed bounds. That is why the
    /// Position row and the range are mutually exclusive — and why a position the tenant has no
    /// period for is rendered but DISABLED (<see cref="PositionIsDerivable"/>).
    /// </summary>
    private bool SpanIsDerived => Division != AcademicYearDivision.None;

    /// <summary>Whether the offered <paramref name="position"/> has a period behind it and may
    /// therefore be chosen: the range is silent for every real part, so an unbacked position could
    /// never produce a write (§2.2 — an exception needs at least one bound).</summary>
    private bool PositionIsDerivable(int position) => PeriodForPosition(Division, position) is not null;

    /// <summary>
    /// The period the chosen division + position fills the span from, or null when the tenant has no
    /// such period. Several years may each hold a "3rd term" (a position is per year, §0 decision
    /// 15), so the pick is deterministic: the one inside the tenant's ACTIVE academic year first,
    /// otherwise the latest-starting one. The dates are a convenience — the span is what matches
    /// (§2.3) and the position is a label beside it.
    /// </summary>
    private PeriodDto? PeriodForPosition(AcademicYearDivision division, int position)
    {
        if (position < 1 || division == AcademicYearDivision.None)
        {
            return null;
        }

        return _periods
            .Where(p => IsDivision(p, division) && p.Sequence == position)
            .OrderByDescending(p => p.ParentPeriodId is { } parentId
                && _periods.Any(year => year.Id == parentId
                    && string.Equals(year.Status, nameof(PeriodStatus.Active), StringComparison.OrdinalIgnoreCase)))
            .ThenByDescending(p => p.StartDate)
            .FirstOrDefault();
    }

    /// <summary>
    /// The batch an add would write: ONE ITEM PER CHOSEN SEQUENCE (v6 §11.3 decision 18), each
    /// carrying its OWN span — always the period's dates, because v7 makes a position selectable
    /// only when a period backs it. On <c>Any date</c>, or in the pre-write state where no position
    /// is ticked yet, the batch is the single free window with no ordinal.
    ///
    /// <para>The ordinal is <b>descriptive</b>: availability never reads it (§2.3), it is not part of
    /// the duplicate key, and it is deliberately NOT cross-checked against the span. This is the
    /// single point where the dialog turns its own state into the request.</para>
    /// </summary>
    private IReadOnlyList<CreateSubjectEnrollmentExceptionItemRequest> BuildItems()
    {
        if (Division == AcademicYearDivision.None || _positions.Count == 0)
        {
            return [new CreateSubjectEnrollmentExceptionItemRequest(ToDateOnly(_startDate), ToDateOnly(_endDate))];
        }

        return
        [
            .. _positions
                .Order()
                .Select(position =>
                {
                    var period = PeriodForPosition(Division, position);
                    return new CreateSubjectEnrollmentExceptionItemRequest(
                        StartDate: period?.StartDate ?? ToDateOnly(_startDate),
                        EndDate: period?.EndDate ?? ToDateOnly(_endDate),
                        Ordinal: position);
                }),
        ];
    }

    /// <summary>
    /// Whether the add form is ARMED (F1) — ONE derived property, no mode flag beyond the
    /// trigger's own: an EMPTY list is armed by construction (there is nothing to read and adding
    /// is the only thing left to do), while a list has to be read first and needs the trigger.
    /// A list that is still LOADING (<c>null</c>) is deliberately NOT armed, so a dialog that has
    /// not answered yet never offers a form. Deleting the last row re-arms the form for free,
    /// because the empty-list clause is the first one rather than a special case.
    /// </summary>
    private bool FormActive => _exceptions is { Length: 0 } || _addTriggered;

    /// <summary>
    /// Whether the trigger is on offer (F2): only when there is a list to read AND the form is
    /// still gated — so it is never on screen beside an armed form, and never competes with the
    /// footer's own <c>Add exception</c>.
    /// </summary>
    private bool ShowAddTrigger => _exceptions is { Length: > 0 } && !_addTriggered;

    /// <summary>
    /// Whether the Reset is on offer (F7): shown iff the reader explicitly ARMED the form AND there
    /// is still a list to have armed it against. Both clauses are load-bearing: the trigger needs a
    /// list AND an unarmed form, so the two controls can never be on screen together; and the armed
    /// flag alone can OUTLIVE its list, because a row's own Remove is gated by the busy state rather
    /// than by the armed one, so removing the LAST row re-reads an EMPTY list under an armed form.
    /// That list is live by construction with nothing to cancel (F1/R5), so it offers no Reset.
    /// </summary>
    private bool ShowAddReset => _addTriggered && _exceptions is { Length: > 0 };

    /// <summary>
    /// A write happens only when it can be complete: EVERY item in the batch carries at least one
    /// bound (the entity invariant — neither bound would mean "never offered", a different concept).
    /// The subject is fixed by the dialog's scope, so it is not part of this guard; the server
    /// re-checks the rest, and this only keeps the affordance honest.
    /// </summary>
    private bool CanAdd => !_busy && BuildItems().All(item => item.StartDate is not null || item.EndDate is not null);

    /// <summary>The date the pickers' containment check runs against — the anchor of the batch's
    /// FIRST item that has a bound, mirroring the server's rule for a one-bound span.</summary>
    private DateOnly? SpanAnchor => BuildItems()
        .Select(item => item.StartDate ?? item.EndDate)
        .FirstOrDefault(onDate => onDate is not null);

    private string? AnchorDateLabel => SpanAnchor is { } d ? d.ToString("d MMM yyyy", CultureInfo.InvariantCulture) : null;

    /// <summary>
    /// The bulk create (D3): the shell's submit performs the write, re-reads the list — so it shows
    /// the server's own answer rather than a hopeful local append — and returns <c>null</c>, which
    /// keeps the dialog open. A rejection sets <see cref="Error"/>, which the shared footer renders;
    /// the client has already extracted the server's sentence from the 409/422 body (D8).
    /// </summary>
    protected override async Task<EnrollmentExceptionsResult?> SubmitAsync(EnrollmentExceptionsModel model)
    {
        if (!CanAdd)
        {
            return null;
        }

        _busy = true;
        try
        {
            // ONE request, one row per chosen sequence (v6 §11.3 decision 18); the server writes the
            // batch in a single transaction, so a rejection anywhere leaves nothing behind.
            await Api.CreateSubjectEnrollmentExceptionsAsync(new CreateSubjectEnrollmentExceptionsRequest(
                GradeLevelId: OwnerGradeLevelId,
                ActivityGroupId: OwnerActivityGroupId,
                TopicId: model.TopicId,
                Division: Division,
                Items: BuildItems(),
                Reason: string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim()));

            if (_disposed) return null;

            // The entry fields were CONSUMED by this write and the form goes back to its gated
            // state (F5): ClearAddForm returns every one of them to the default the dialog opens
            // on, and the trigger is reset, which is what makes the disabled state DERIVED again
            // rather than a second thing to keep in step. The list itself is re-read, so the reader
            // sees the server's answer before deciding whether to add another one.
            ClearAddForm();
            _addTriggered = false;
            await LoadExceptionsAsync(_loadCts?.Token ?? CancellationToken.None);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return null;
            Logger.LogError(ex, "Failed to create an enrollment exception for topic {TopicId}", model.TopicId);
            Error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        return null;
    }

    private async Task RemoveAsync(EnrollmentExceptionDto exception)
    {
        if (_busy) return;
        _busy = true;
        _loadError = null;

        try
        {
            await Api.RemoveSubjectEnrollmentExceptionAsync(exception.Id);
            if (_disposed) return;
            await LoadExceptionsAsync(_loadCts?.Token ?? CancellationToken.None);

            // The armed flag is armed AGAINST a row set. When the reload leaves none, the form left
            // standing is the EMPTY list's own (F1), which nothing can be cancelled out of (R5), so
            // the flag goes with the rows rather than insisting on a state the list no longer
            // supports. With rows still left, the reader stays armed exactly as they were.
            if (_exceptions is { Length: 0 })
            {
                _addTriggered = false;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to remove enrollment exception {ExceptionId}", exception.Id);
            _loadError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The trigger's action (F2): arm the add form. The GATE itself is derived
    /// (<see cref="FormActive"/>), so there is no second piece of state to keep in step, and a
    /// successful add simply sets this back to <c>false</c>.
    /// </summary>
    private void OnAddTrigger() => _addTriggered = true;

    /// <summary>
    /// The Reset's action (F7): abandon the pending add. It discards the in-progress input through
    /// the ONE clear a consumed write also uses (<see cref="ClearAddForm"/>), then re-gates the form
    /// by resetting the trigger — which is exactly what puts the trigger back on offer. It writes
    /// NOTHING (no request, no submit) and closes NOTHING: the reader keeps the dialog and the list
    /// they were reading, which is the escape an armed form otherwise has none of.
    /// </summary>
    private void OnAddReset()
    {
        if (_disposed) return;

        ClearAddForm();
        _addTriggered = false;
    }

    /// <summary>
    /// Returns the add form's entry fields to the state the dialog opens on: the ticked sequences,
    /// both range ends, the reason, the chosen division and the containment hint. ONE implementation
    /// for the two ways the fields are spent — a write that consumed them
    /// (<see cref="SubmitAsync"/>, F5) and a Reset that abandons them (<see cref="OnAddReset"/>, F7)
    /// — so the two can never drift apart. The trigger flag is deliberately NOT part of this: a
    /// write re-gates the form and a Reset re-gates it too, but each says so at its own call site.
    /// </summary>
    private void ClearAddForm()
    {
        _positions.Clear();
        _startDate = null;
        _endDate = null;
        _reason = null;
        _chosenDivision = AcademicYearDivision.None;
        _alreadyExcepted = null;
    }

    /// <summary>
    /// The "Fill from" division changed. The sequences AND the typed range belong to the division
    /// that produced them — a Terms "3rd" is not a Semesters one — so both are cleared rather than
    /// carried across. Choosing "Any date" leaves no sequence at all (the control is not rendered),
    /// which is what the write needs: an ordinal on a free window is rejected by the server.
    /// </summary>
    private async Task OnDivisionChangedAsync()
    {
        if (_disposed) return;
        _positions.Clear();
        _startDate = null;
        _endDate = null;
        await RefreshExceptedHintAsync();
    }

    /// <summary>A sequence was ticked or unticked. The typed range is untouched because a real part
    /// never has one (v7): every selectable position derives its own span.</summary>
    private async Task SetPositionAsync(int position, bool selected)
    {
        if (_disposed) return;

        if (selected)
        {
            _positions.Add(position);
        }
        else
        {
            _positions.Remove(position);
        }

        await RefreshExceptedHintAsync();
    }

    private async Task OnSpanChangedAsync() => await RefreshExceptedHintAsync();

    /// <summary>
    /// Asks the server (<c>GET /students/enrollment-exceptions/check</c>) whether this subject is
    /// already excepted on the span's anchor date. Best effort by design: a check that cannot run
    /// leaves the hint absent and never blocks the write — the server is the gate (a duplicate is
    /// still a 409, and its message is surfaced).
    /// </summary>
    private async Task RefreshExceptedHintAsync()
    {
        _alreadyExcepted = null;

        if (SpanAnchor is not { } onDate)
        {
            return;
        }

        try
        {
            _alreadyExcepted = await Api.IsSubjectExceptedAsync(
                Model.TopicId,
                onDate,
                gradeLevelId: OwnerGradeLevelId,
                activityGroupId: OwnerActivityGroupId,
                ct: _loadCts?.Token ?? CancellationToken.None);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not check whether topic {TopicId} is already excepted on {OnDate}", Model.TopicId, onDate);
            _alreadyExcepted = null;
        }
    }

    /// <summary>
    /// The FR-56 division a group's <see cref="EnrollmentSpan"/> requires — the same mapping as
    /// <c>TopicAssignmentPeriodValidator.ValidateGroupExceptionDivisionAsync</c>. This is what
    /// narrows the add section's "Fill from" list to exactly one option for a group owner.
    /// </summary>
    private static AcademicYearDivision RequiredDivision(string span) => span switch
    {
        nameof(EnrollmentSpan.Termly) => AcademicYearDivision.Terms,
        nameof(EnrollmentSpan.Semester) => AcademicYearDivision.Semesters,
        _ => AcademicYearDivision.None
    };

    private static bool IsDivision(PeriodDto period, AcademicYearDivision division) =>
        string.Equals(period.Division, division.ToString(), StringComparison.OrdinalIgnoreCase);

    private static DateOnly? ToDateOnly(DateTime? value) =>
        value is { } date ? DateOnly.FromDateTime(date.Date) : null;

    /// <summary>
    /// The period part: the vocabulary the user reads, never the enum member — ONE spelling per
    /// concept (v4 decision 14), shared by the control's options and the list rows' badges.
    /// </summary>
    private static string PartLabel(AcademicYearDivision division) => division switch
    {
        AcademicYearDivision.Terms => "Term",
        AcademicYearDivision.Semesters => "Semester",
        _ => "Any date"
    };

    /// <summary>The wire form of <see cref="PartLabel"/>'s input: the DTO carries <c>Division</c> as
    /// a string, so a row's badge parses it once here. Unparseable or absent division reads as
    /// "Any date" rather than throwing in a list render.</summary>
    private static AcademicYearDivision DivisionOf(string division) =>
        Enum.TryParse<AcademicYearDivision>(division, true, out var parsed) ? parsed : AcademicYearDivision.None;

    /// <summary>
    /// The span in words (§5.1): <c>1–14 Mar 2027</c>, <c>from 1 Mar 2027</c> (open start),
    /// <c>to 14 Mar 2027</c> (open end). An exception is never unbounded on both sides, so the dash
    /// is unreachable in practice — kept so a malformed row renders quietly instead of throwing.
    /// </summary>
    private static string SpanLabel(DateOnly? start, DateOnly? end)
    {
        if (start is { } s && end is { } e)
        {
            return s.Year == e.Year && s.Month == e.Month
                ? $"{s.Day}–{e.Day} {Month(e)}"
                : $"{Day(s)} – {Day(e)}";
        }
        if (start is { } openStart)
        {
            return $"from {Day(openStart)}";
        }
        if (end is { } openEnd)
        {
            return $"to {Day(openEnd)}";
        }
        return "—";
    }

    private static string Day(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private static string Month(DateOnly date) => date.ToString("MMM yyyy", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
