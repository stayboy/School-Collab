@* StudentCreateDialog — create a new student in a modal dialog
   (section-card-lessons-adoption.md §9 dec 2). Wraps the shared
   <StudentFormFields> (same field set + validation as /students/create) and
   creates the student via CreateStudentAsync, linking any guardians drafted
   on the form. Opens from the Students card Add button via
   ShowReadonlyDialogAsync. *@
@implements IDialogContentComponent<DialogParameters>
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Components
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject ILogger<StudentCreateDialog> Logger

<StudentFormFields Model="_model"
                   ShowGuardians="true"
                   ShowContacts="true"
                   Wide="true"
                   ErrorMessage="@_error"
                   OnValidSubmit="OnSaveAsync"
                   SubmitLabel="Create Student"
                   SubmittingLabel="Creating…"
                   Submitting="@_saving"
                   OnCancel="CancelAsync" />

@code {
    [CascadingParameter] public FluentDialog? Dialog { get; set; }
    [Parameter] public DialogParameters Content { get; set; } = default!;

    /// <summary>Keys used in <see cref="Content"/> for the optional enrollment
    /// target. Exposed so callers (Detail.razor) set the same keys they read here.</summary>
    public const string EnrollmentGradeLevelIdKey = nameof(EnrollmentGradeLevelId);
    public const string EnrollmentPeriodIdKey = nameof(EnrollmentPeriodId);

    // Optional enrollment target. When set (e.g. the grade-detail "Add" passes the
    // grade id), the student is enrolled in the same atomic create — no separate
    // EnrollStudentAsync round-trip, no "created but not on the grade card" state.
    //
    // Read from Content (the DialogParameters indexer) rather than separate
    // [Parameter] properties: FluentUI renders dialog content via DynamicComponent
    // with only { "Content": <DialogParameters> } and does NOT spread the indexer
    // entries onto [Parameter] properties, so separate parameters would silently
    // default to null.
    private Guid? EnrollmentGradeLevelId => Content is { } c ? c.TryGet<Guid?>(EnrollmentGradeLevelIdKey) : null;
    private Guid? EnrollmentPeriodId => Content is { } c ? c.TryGet<Guid?>(EnrollmentPeriodIdKey) : null;

    private readonly StudentFormModel _model = new();
    private bool _saving;
    private string? _error;

    private async Task OnSaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _error = null;
        try
        {
            // Single atomic call: student + drafted guardians + drafted contacts
            // (+ optional enrollment) are created together, all-or-nothing (Unit of Work).
            // The model→request projection (incl. the guardian emergency flag) is on
            // StudentFormModel.ToCreateRequest — symmetric with the edit dialog's
            // ToUpdateRequest (see documents/solution/dto-form-model-mapping.md).
            var request = _model.ToCreateRequest(EnrollmentGradeLevelId, EnrollmentPeriodId);
            var studentId = await Api.CreateStudentWithLinkedDataAsync(request);
            if (Dialog is not null) await Dialog.CloseAsync(studentId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create student");
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task CancelAsync() => Dialog is null ? Task.CompletedTask : Dialog.CloseAsync();
}
