@* Transfer a student to another grade level. This is the unified promote/demote
   mechanism: picking a higher-level grade promotes, a lower-level grade demotes,
   and an equal level is a lateral move. Records a reason and an audit entry. *@
@inherits DialogShellBase<StudentTransferModel, StudentTransferResult>
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Constants
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject ILogger<StudentTransferDialog> Logger

<div class="transfer-dialog">
    @if (_loading)
    {
        <FluentProgressRing />
    }
    else if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error">@_error</FluentMessageBar>
    }
    else if (_enrollment is null)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            This student has no active enrollment to transfer.
        </FluentMessageBar>
    }
    else if (_gradeOptions.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            There are no other grade levels to transfer @(_currentGradeName) students to.
        </FluentMessageBar>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
            <FluentStack Orientation="Orientation.Vertical" Spacing="3">
                <FluentTextField Value="@_currentGradeName" Label="Current grade" ReadOnly="true" />

                @if (DirectionHint is { } hint)
                {
                    <FluentMessageBar Intent="MessageIntent.Info">@hint</FluentMessageBar>
                }

                <DropdownComponent TItem="GradeLevelDto" TValue="Guid?"
                                  Items="_gradeOptions"
                                  @bind-SelectedValue="_selectedGradeId"
                                  @bind-SelectedValue:after="OnGradeSelectedValueChanged"
                                  OptionText="@(g => g.Name)"
                                  OptionValue="@(g => g.Id)"
                                  Label="Transfer to grade" />

                <CodedValueDropdown Parent="CodedValueParent.GradeStrands"
                                    AttributeFilter="@(SelectedGrade is null ? null : ("gradeLevel", SelectedGrade.CodedValueId.ToString()))"
                                    EmptyFilterPlaceholder="No strands for this grade"
                                    Placeholder="Select strand…"
                                    Label="Transfer to strand"
                                    @bind-SelectedId="_selectedStrand" />

                <FluentTextArea @bind-Value="_model.Reason" Label="Reason" Required="true" />
            </FluentStack>

            <DialogShellFooter Saving="@Saving"
                               Error="@Error"
                               SubmitText="Transfer"
                               SavingText="Transferring…"
                               OnCancel="HandleCancelAsync" />
        </EditForm>
    }
</div>

@code {
    private sealed class TransferModel
    {
        public string Reason { get; set; } = "";
    }

    private readonly TransferModel _model = new();
    private bool _loading = true;
    private string? _error;
    private string? _currentGradeName;
    private StudentEnrollmentDto? _enrollment;
    private List<GradeLevelDto> _allGrades = new();
    private List<GradeLevelDto> _gradeOptions = new();
    /// <summary>The transfer-target grade's id, bound to the grade
    /// <see cref="DropdownComponent{TItem, TValue}"/>. The full
    /// <see cref="GradeLevelDto"/> is resolved lazily via
    /// <see cref="SelectedGrade"/> for callers that need it
    /// (DirectionHint, AttributeFilter on the strand picker, API call).
    /// </summary>
    private Guid? _selectedGradeId;
    private Guid? _selectedStrand;

    /// <summary>Resolves the transfer-target <see cref="GradeLevelDto"/>
    /// from <see cref="_selectedGradeId"/>. Null when the id is null or
    /// no matching row is in <see cref="_gradeOptions"/> (e.g. the list
    /// was reloaded and the old id is no longer present).</summary>
    private GradeLevelDto? SelectedGrade => _selectedGradeId is null
        ? null
        : _gradeOptions.FirstOrDefault(g => g.Id == _selectedGradeId);

    /// <summary>
    /// Handles the transfer-grade <see cref="DropdownComponent{TItem, TValue}"/>'s
    /// <c>@bind-SelectedValue:after</c> side-effect. Runs after the binder has
    /// written the new <see cref="_selectedGradeId"/>, so we can read the
    /// post-bind value via the property. The strand picker's <c>AttributeFilter</c>
    /// value is derived from <see cref="SelectedGrade"/>'s <c>CodedValueId</c>,
    /// so a grade change re-filters the strand list automatically. We must also
    /// clear <see cref="_selectedStrand"/> here: a strand from the previous grade
    /// is no longer valid (the strand's <c>gradeLevel</c> attribute must match
    /// the new grade; spec §4.3 / FR-9). Without this clear the consumer's
    /// strand id would persist through the re-render and reach the API as a
    /// stale value.
    /// <para>
    /// Parameterless void per the repo rule: <see cref="DropdownComponent{TItem, TValue}"/>'s
    /// <c>SelectedValueChanged</c> is the binder's internal callback; do NOT
    /// pass it directly. Use <c>@bind-SelectedValue:after</c> for side-effects
    /// (mirrors the rule documented on <see cref="CodedValueDropdown"/>).
    /// </para>
    /// </summary>
    private void OnGradeSelectedValueChanged() => _selectedStrand = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var enrollments = await Api.ListEnrollmentsByStudentAsync(Model.StudentId, CancellationToken.None) ?? [];
            _enrollment = enrollments.FirstOrDefault(e => e.Status == "Active" && e.ExitDate is null)
                ?? enrollments.FirstOrDefault(e => e.ExitDate is null);

            if (_enrollment is null)
            {
                _loading = false;
                return;
            }

            _allGrades = (await Api.ListGradeLevelsAsync(CancellationToken.None) ?? []).ToList();
            _currentGradeName = _allGrades.FirstOrDefault(g => g.Id == _enrollment.GradeLevelId)?.Name ?? "—";

            _gradeOptions = _allGrades
                .Where(g => g.Id != _enrollment.GradeLevelId)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load transfer data for student {StudentId}", Model.StudentId);
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private string? DirectionHint
    {
        get
        {
            if (_enrollment is null || SelectedGrade is null) return null;
            var current = _allGrades.FirstOrDefault(g => g.Id == _enrollment.GradeLevelId);
            if (current is null) return null;
            if (SelectedGrade.Level > current.Level) return $"This will PROMOTE the student to {SelectedGrade.Name}.";
            if (SelectedGrade.Level < current.Level) return $"This will DEMOTE the student to {SelectedGrade.Name}.";
            return $"This is a lateral transfer to {SelectedGrade.Name}.";
        }
    }

    protected override async Task<StudentTransferResult?> SubmitAsync(StudentTransferModel model)
    {
        // Surface a specific, actionable error on each null-guard instead of a
        // silent no-op. The EditForm has no DataAnnotationsValidator (the
        // FluentSelect / FluentTextArea Required is display-only), so Blazor
        // validation does NOT block submit when the grade is unset — without
        // these guards a missing enrollment/grade would silently return null
        // and the user would see "clicking Transfer does nothing". Setting
        // <Error> turns the silent no-op into a visible message bar (footer).
        if (_enrollment is null)
        {
            Error = "This student has no active enrollment to transfer.";
            return null;
        }
        if (SelectedGrade is null)
        {
            Error = "Select a grade to transfer to.";
            return null;
        }

        try
        {
            await Api.TransferStudentAsync(_enrollment.Id, new TransferStudentRequest(SelectedGrade.Id, _selectedStrand, null, _model.Reason));
            return new StudentTransferResult(true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to transfer student {StudentId}", model.StudentId);
            Error = ex.Message;
            return null;
        }
    }
}
