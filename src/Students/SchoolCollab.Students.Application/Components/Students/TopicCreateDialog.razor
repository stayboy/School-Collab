@*
    TopicCreateDialog — opens from the grade-detail Subjects card's Add
    button. Creates a brand-new topic (displayed as a subject) and wires it
    to the grade in one atomic call via CreateTopicForGradeAsync.

    This mirrors the TopicEditDialog pattern (DialogShellBase +
    ShowShellDialogAsync) used for editing a subject on the same card, and
    shares the same form fields via <TopicFormFields>. The subject is
    display-only — the underlying entity is a Topic, and creating one never
    renames an existing topic.

    An optional <CodedValueDropdown> (SUBJECT parent) lets the user pick an
    existing subject to pre-fill the fields below. The fields are shown read-only
    (via <TopicFormFields> + FieldDisplay) by default; an edit button next to the
    dropdown switches to the editable inputs. The dialog footer toggles like the
    edit dialog: in display mode the Submit is a server "Create"; in edit mode it
    becomes a LOCAL "Update Fields" that reflects edits back into the read-only
    display section WITHOUT submitting, and Cancel reverts the user's edits.
    Edits are saved as tenant overrides (or new coded-value rows) via
    TopicCodedValueSaver. A refresh icon next to the Code display regenerates the
    template code from the name via the TOPIC_CODE rule (the one edit that is NOT
    persisted as an override).

    Code is optional: when left blank the server generates it from the name
    via the TOPIC_CODE entity-code rule (e.g. "computer science" → CS01).
*@
@inherits DialogShellBase<TopicCreateDialog.TopicCreateModel, TopicDto>
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Core.Features
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject IFeatureFlagService FeatureFlags
@inject CodedValuesApiClient CodedValues
@inject EntityCodeRulesApiClient EntityCodeRules
@inject ILogger<TopicCreateDialog> Logger

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <FormRow Label="Pick existing subject" For="topic-create-coded-value">
            <div class="topic-create-pick-row">
                <CodedValueDropdown @ref="_codedValueDropdown"
                                    Parent="CodedValueParent.Subjects"
                                    @bind-SelectedId="Model.CodedValueId"
                                    @bind-SelectedId:after="OnCodedValuePicked"
                                    ShowEmptyOption="true"
                                    EmptyOptionText="None — custom topic"
                                    Placeholder="Optional — pick an existing subject to pre-fill" />
                <FluentButton Appearance="Appearance.Stealth"
                              Class="topic-icon-button"
                              IconStart="@FluentIcons.Edit"
                              Title="Edit the topic fields"
                              aria-label="Edit topic fields"
                              OnClick="StartEditing" />
            </div>
            <p class="hint">Optional. Picking an existing subject pre-fills the fields below; you can still edit them. Leave blank to create a new subject with a generated code.</p>
            @if (_duplicateCodedValue)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" class="mb-2">
                    This subject is already linked to the grade. A coded value can only be used once.
                </FluentMessageBar>
            }
        </FormRow>

        @* Horizontal separator (CSS border-top, per dialog-ui §2) between the
           CodedValueDropdown picker section and the topic fields below. *@
        <div class="topic-fields-section">
            <FormRow Label="Owner" For="topic-create-owner">
                <FluentSelect TOption="string" @bind-Value="Model.OwnerType" Id="topic-create-owner" Style="flex:1; min-width:0">
                    <FluentOption Value="GradeLevel">Grade Level</FluentOption>
                    @if (_activityGroupsEnabled)
                    {
                        <FluentOption Value="ActivityGroup">Activity Group</FluentOption>
                    }
                </FluentSelect>
            </FormRow>

            @if (Model.OwnerType == "ActivityGroup")
            {
                <FormRow Label="Activity group" For="topic-create-group" Required="true">
                    <FluentSelect TOption="string" @bind-Value="_activityGroupIdText" @bind-Value:after="OnActivityGroupChangedAsync" Id="topic-create-group" Style="flex:1; min-width:0">
                        <FluentOption Value="">— Select activity group —</FluentOption>
                        @foreach (var g in _activityGroups)
                        {
                            <FluentOption Value="@g.Id.ToString()">@g.Name</FluentOption>
                        }
                    </FluentSelect>
                </FormRow>
                @if (SelectedGroup is { } selectedGroup)
                {
                    <FormRow Label="Enrollment span" For="topic-create-group-span">
                        <FluentBadge Appearance="Appearance.Neutral">@selectedGroup.Span</FluentBadge>
                    </FormRow>
                }
                @if (_groupDuplicateCodedValue)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning" class="mb-2">
                        This subject is already assigned to this activity group.
                    </FluentMessageBar>
                }
            }

            <TopicFormFields Model="Model"
                             Mode="@(_editing ? TopicFormFields.TopicFormMode.Edit : TopicFormFields.TopicFormMode.Display)"
                             CodeDisabled="@(Model.CodedValueId.HasValue)"
                             CodePlaceholder="e.g. CS01 (optional — generated from name if blank)">
                <CodeActions>
                    <FluentButton Appearance="Appearance.Stealth"
                                  Class="topic-icon-button"
                                  IconStart="@FluentIcons.ArrowClockwise"
                                  Title="Regenerate template code from the name"
                                  aria-label="Regenerate template code"
                                  OnClick="@RegenerateCodeAsync"
                              Disabled="@_regeneratingCode" />
            </CodeActions>
        </TopicFormFields>
        </div>

        @* The dialog footer is always rendered. In display mode the Submit is a
           server action ("Create" → SubmitAsync). In edit mode it becomes a LOCAL
           action ("Update Fields") that reflects the edits back into the read-only
           display section WITHOUT submitting to the server; Cancel reverts the
           user's edits before switching back to display mode. The Create button
           is disabled when a duplicate coded value is selected (warning above) or
           when in display mode with no name to create. *@
        <DialogShellFooter Saving="@Saving"
                           Error="@Error"
                           SubmitText="@(_editing ? "Update Fields" : SubmitText)"
                           SavingText="Creating..."
                           SubmitIsServerSubmit="@(!_editing)"
                           OnSubmit="UpdateFields"
                           SubmitDisabled="@(_duplicateCodedValue || _groupDuplicateCodedValue || (!_editing && string.IsNullOrWhiteSpace(Model.Name)))"
                           OnCancel="HandleCancel" />
    </EditForm>
</div>


@code {
    private CodedValueDropdown? _codedValueDropdown;
    private CodedValueDto? _pickedCodedValue;
    private bool _regeneratingCode;
    private bool _editing;
    private bool _duplicateCodedValue;
    private bool _groupDuplicateCodedValue;
    private string _activityGroupIdText = "";
    private ActivityGroupDto[] _activityGroups = [];

    /// <summary>
    /// Mirrors <c>FEATURE:EnableActivityGroups</c>. The <c>/activity-groups</c>
    /// route group is only mapped when the flag is on, so an off flag means the
    /// group owner simply is not available here. It must never prevent the dialog
    /// from opening or the grade-level owner from working.
    /// </summary>
    private bool _activityGroupsEnabled;
    private SubjectDto[] _groupExistingTopics = [];

    /// <summary>
    /// The activity group currently selected in the group picker (or null when
    /// none is selected / the id does not resolve). Used to display the group's
    /// enrollment span (FR-56).
    /// </summary>
    private ActivityGroupDto? SelectedGroup =>
        Guid.TryParse(_activityGroupIdText, out var id)
            ? _activityGroups.FirstOrDefault(g => g.Id == id)
            : null;

    // Snapshot of the pre-edit values so Cancel can revert the user's edits.
    private string _origName = string.Empty;
    private string? _origCode;
    private string? _origDescription;
    private Guid? _origCodedValueId;
    private CodedValueDto? _origPickedCodedValue;

    /// <summary>
    /// Editable form model for the topic create dialog. Carries the grade
    /// context so the new topic is wired to the grade in the same call.
    /// </summary>
    public sealed class TopicCreateModel : TopicFormFields.ITopicFormModel
    {
        /// <summary>The grade level the new topic (subject) is wired to.</summary>
        public Guid GradeLevelId { get; set; }

        /// <summary>
        /// Coded value IDs already used by topics linked to this grade. Used to
        /// reject picking a subject's coded value that would duplicate an
        /// existing subject in the grade.
        /// </summary>
        public HashSet<Guid> ExistingTopicCodedValueIds { get; set; } = new();

        /// <summary>
        /// Optional SUBJECT coded value picked from the dropdown. When set, the
        /// Code input is disabled (it derives from the coded value).
        /// </summary>
        public Guid? CodedValueId { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;

        public string? Code { get; set; }

        public string? Description { get; set; }

        public int DisplayOrder { get; set; }

        /// <summary>Owner kind: <c>GradeLevel</c> (default) or <c>ActivityGroup</c>.</summary>
        public string OwnerType { get; set; } = "GradeLevel";

        /// <summary>The activity group the new topic is wired to (when <see cref="OwnerType"/> is <c>ActivityGroup</c>).</summary>
        public Guid? ActivityGroupId { get; set; }
    }

    protected override string SubmitText => "Create";

    protected override async Task OnInitializedAsync()
    {
        // Activity groups first, but fully isolated: /activity-groups is only
        // mapped when FEATURE:EnableActivityGroups is on, so with the flag off the
        // call would 404 and — being unguarded here previously — take the whole
        // dialog down, including the grade-level owner path.
        _activityGroupsEnabled = await FeatureFlags.IsEnabledAsync(FeatureFlagKeys.EnableActivityGroups);
        if (_activityGroupsEnabled)
        {
            try
            {
                _activityGroups = await Api.ListActivityGroupsAsync() ?? [];
            }
            catch (Exception ex)
            {
                // Contained: fall back to the grade-level owner rather than
                // failing the dialog.
                Logger.LogWarning(ex, "Failed to load activity groups; the Activity Group owner is unavailable");
                _activityGroupsEnabled = false;
                _activityGroups = [];
            }
        }

        if (!_activityGroupsEnabled)
        {
            // The caller may have pre-seeded a group owner (e.g. Subjects.razor);
            // fall back to the grade-level owner that is always available.
            Model.OwnerType = "GradeLevel";
            Model.ActivityGroupId = null;
            _activityGroupIdText = "";
        }

        if (_activityGroupsEnabled && Model.ActivityGroupId.HasValue)
        {
            _activityGroupIdText = Model.ActivityGroupId.Value.ToString();
            // Fire the same group-topic load the user-path selection uses, so
            // the Item-3 duplicate guard is effective when the dialog opens
            // pre-seeded with an activity group (e.g. from Subjects.razor).
            _ = LoadGroupExistingTopicsAsync();
        }
    }

    private void OnActivityGroupChangedAsync()
    {
        _groupDuplicateCodedValue = false;
        _ = LoadGroupExistingTopicsAsync();
    }

    /// <summary>
    /// Loads the topics already assigned to the selected activity group so the
    /// create flow can reject a coded value that would duplicate an existing
    /// group assignment (mirrors the grade-path <c>_duplicateCodedValue</c>
    /// guard). Cleared when the selection is invalid/empty. Failures degrade to
    /// an empty set (no hard block on the load path).
    /// </summary>
    private async Task LoadGroupExistingTopicsAsync()
    {
        if (!Guid.TryParse(_activityGroupIdText, out var groupId))
        {
            _groupExistingTopics = [];
            _groupDuplicateCodedValue = false;
            return;
        }

        try
        {
            _groupExistingTopics = await Api.ListSubjectsByGroupAsync(groupId, null) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load existing topics for activity group {GroupId}", groupId);
            _groupExistingTopics = [];
        }

        _groupDuplicateCodedValue = Model.CodedValueId is { } id
            && _groupExistingTopics.Any(t => t.CodedValueId == id);
    }

    /// <summary>Switches from display mode to edit mode, snapshotting the
    /// current values so Cancel can revert.</summary>
    private void StartEditing()
    {
        _origName = Model.Name;
        _origCode = Model.Code;
        _origDescription = Model.Description;
        _origCodedValueId = Model.CodedValueId;
        _origPickedCodedValue = _pickedCodedValue;
        _editing = true;
    }

    /// <summary>
    /// Edit-mode "Update Fields" action: reflects the edited values back into
    /// the read-only display section WITHOUT submitting to the server. The
    /// actual creation happens later via the display-mode "Create".
    /// </summary>
    private void UpdateFields()
    {
        _editing = false;
    }

    /// <summary>
    /// Cancel button: while editing, reverts the user's edits (restoring the
    /// pre-edit snapshot) and switches back to display mode; otherwise closes
    /// the dialog.
    /// </summary>
    private Task HandleCancel()
    {
        if (_editing)
        {
            Model.Name = _origName;
            Model.Code = _origCode;
            Model.Description = _origDescription;
            Model.CodedValueId = _origCodedValueId;
            _pickedCodedValue = _origPickedCodedValue;
            _editing = false;
            return Task.CompletedTask;
        }
        return HandleCancelAsync();
    }

    /// <summary>
    /// Pre-fills Name / Code / Description from the picked
    /// SUBJECT coded value (resolved from the dropdown's already-loaded items,
    /// no extra API round-trip). Also validates that the picked coded value is
    /// not already used by a topic in the grade — if it is, a warning is shown
    /// and the Create button is disabled.
    /// </summary>
    private void OnCodedValuePicked()
    {
        if (Model.CodedValueId is not { } id)
        {
            // "None — custom topic" selected: clear any duplicate warning.
            _duplicateCodedValue = false;
            _pickedCodedValue = null;
            return;
        }

        if (_codedValueDropdown is not null
            && _codedValueDropdown.TryFindItem(id, out var cv)
            && cv is not null)
        {
            _pickedCodedValue = cv;
            Model.Name = cv.Name;
            Model.Code = cv.Code;
            Model.Description = cv.Description;
        }

        // Reject a coded value already used by another subject in this grade.
        _duplicateCodedValue = Model.ExistingTopicCodedValueIds.Contains(id);

        // For an activity-group owner, also reject a coded value already assigned
        // to the selected group (mirrors the grade-path guard).
        _groupDuplicateCodedValue = Model.OwnerType == "ActivityGroup"
            && _groupExistingTopics.Any(t => t.CodedValueId == id);
    }

    /// <summary>
    /// Regenerates the template code from the current name via the TOPIC_CODE
    /// rule. This is the one edit that is NOT persisted as a tenant override —
    /// it is a pure regenerate action.
    /// </summary>
    private async Task RegenerateCodeAsync()
    {
        if (_regeneratingCode) return;
        _regeneratingCode = true;
        try
        {
            Model.Code = await EntityCodeRules.GenerateAsync("TOPIC_CODE", Model.Name);
        }
        catch (Exception ex)
        {
            Error = $"Could not generate code: {ex.Message}";
        }
        finally
        {
            _regeneratingCode = false;
        }
    }

    protected override async Task<TopicDto?> SubmitAsync(TopicCreateModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            Error = "Enter a subject name.";
            return null;
        }

        // Resolve the picked coded value (if any).
        CodedValueDto? cv = null;
        if (model.CodedValueId is { } id)
        {
            cv = _pickedCodedValue is { } p && p.Id == id ? p : await CodedValues.GetByIdAsync(id);
            if (cv is null)
            {
                Error = "Could not load the subject coded value.";
                return null;
            }
        }

        // Save the field edits as tenant overrides / new coded-value rows (the
        // exception is template-code generation, handled by RegenerateCodeAsync).
        var (resolvedCvId, effectiveCode) = await TopicCodedValueSaver.SaveAsync(
            CodedValues, cv, model.Name, model.Code, model.Description, model.DisplayOrder);

        // Create (or reuse) the shared topic and wire it to the owner in one
        // atomic call. Code is optional — the server generates it from the name
        // when blank. A brand-new topic is created; existing topics are never
        // renamed by this flow.
        //
        // No period is sent: the period picker was removed in the
        // subject-period-blocks round. A bridge row means "this topic is offered
        // for this owner" and carries no period meaning any more — the period
        // is now an EXCEPTION (a SubjectEnrollmentException, managed in
        // TopicEditDialog). The wire contract still accepts PeriodId for
        // back-compat; the server ignores it.
        if (model.OwnerType == "ActivityGroup")
        {
            if (!Guid.TryParse(_activityGroupIdText, out var groupId))
            {
                Error = "Select an activity group.";
                return null;
            }

            // Guard against a stale group-topic list: re-check immediately before
            // assigning so a duplicate coded value never reaches the assign call.
            if (model.CodedValueId is { } dupId
                && _groupExistingTopics.Any(t => t.CodedValueId == dupId))
            {
                Error = "This subject is already assigned to this activity group.";
                return null;
            }

            var topicId = await Api.CreateTopicAsync(new CreateTopicRequest(
                resolvedCvId ?? Guid.Empty, effectiveCode ?? "", model.Name.Trim(), model.DisplayOrder));
            await Api.AssignActivityGroupTopicAsync(new AssignActivityGroupTopicRequest(
                groupId, topicId, DateOnly.FromDateTime(DateTime.UtcNow), null));
            return await Api.GetTopicByIdAsync(topicId);
        }

        var topic = await Api.CreateTopicForGradeAsync(new CreateTopicForGradeRequest(
            model.GradeLevelId,
            resolvedCvId,
            effectiveCode,
            model.Name.Trim(),
            model.DisplayOrder));
        return topic;
    }
}
