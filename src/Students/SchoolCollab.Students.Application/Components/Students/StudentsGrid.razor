@using SchoolCollab.Students.Application.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@* Shared student grid used on the grade-level detail page (and any page that
   needs to list students). Renders a FluentDataGrid over the supplied
   students; the caller owns loading/enrichment and passes the rows in. *@
<FluentDataGrid Items="@(Students.AsQueryable())"
                TGridItem="StudentDto"
                MultiLine="true"
                Class="students-grid">
    <TemplateColumn Title="Name">
        <FluentAnchor Appearance="Appearance.Lightweight"
                      Href="@($"/students/{context.Id}")">
            @context.FirstName @context.LastName
        </FluentAnchor>
    </TemplateColumn>
    <TemplateColumn Title="Student #">@context.StudentNumber</TemplateColumn>
    <TemplateColumn Title="Gender">@(string.IsNullOrWhiteSpace(context.GenderName) ? "—" : context.GenderName)</TemplateColumn>
    <TemplateColumn Title="Age">@(context.Age?.ToString() ?? "—")</TemplateColumn>
    <TemplateColumn Title="Status">
        @if (context.IsDeleted)
        {
            <FluentBadge Appearance="Appearance.Neutral">Deleted</FluentBadge>
        }
        else
        {
            <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
        }
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StudentDto> Students { get; set; } = [];

    [Parameter] public bool ShowGradeColumn { get; set; } = false;
}
