@namespace SchoolCollab.Students.Application.Components.Students
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Core.Notifications
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.DTOs
@using System.ComponentModel
@inject StudentsApiClient Api
@inject NotificationPolicyApiClient SettingsApi
@inject IDialogService DialogService
@inject ILogger<GradeNotificationPolicyEditor> Logger

@* Per-grade Notification & Delivery policy editor (notification-delivery-plan.md §5).
   A single grid lists each setting with its tenant-global value and per-grade override.
   Row actions: Edit (opens a dialog with Global / This-grade scope) and Reset
   (clears the per-grade override back to "inherit global"). *@

@if (_loading)
{
    <div class="spinner-container"><FluentProgressRing /></div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
}
else
{
    <FluentDataGrid Items="_rows.AsQueryable()" TGridItem="FieldRow" Class="policy-grid">
        <TemplateColumn Title="Setting">
            <FluentAnchor Appearance="Appearance.Hypertext" Href="#" Class="setting-label"
                          Title="@($"Edit {context.Def.Label}")"
                          OnClick="() => EditAsync(context)">@context.Def.Label</FluentAnchor>
        </TemplateColumn>
        <TemplateColumn Title="Global settings">
            <span class="global-value">@context.GlobalDisplay</span>
        </TemplateColumn>
        <TemplateColumn Title="Grade override">
            @if (context.GradeSet)
            {
                <span class="grade-value">@context.GradeDisplay</span>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Lightweight" Class="inherit-badge">Inherit global</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn Title="Actions">
            <RowActionsMenu AriaLabel="@($"Actions for {context.Def.Label}")"
                            UseMenuService="false"
                            Actions="@BuildRowActions(context)" />
        </TemplateColumn>
    </FluentDataGrid>
    <p class="muted grid-hint">
        <strong>Edit</strong> opens a dialog where you can change the value for this grade or the tenant-global default.
        <strong>Reset</strong> clears the per-grade override so the global value applies.
    </p>
}

<style>
    .muted { color: var(--neutral-foreground-hint); }
    .policy-grid { width: 100%; }
    .setting-label { font-weight: 500; }
    .global-value { color: var(--neutral-foreground-hint); }
    .grade-value { font-weight: 500; }
    .inherit-badge { }
    .grid-hint { margin-top: 0.75rem; font-size: 0.85rem; }
</style>

@code {
    private sealed record FieldDef(string Key, string Label, NotificationPolicyFieldEditDialog.FieldKind Kind);
    private sealed record FieldRow(FieldDef Def, string GlobalDisplay, string GradeDisplay, bool GradeSet);

    private static readonly FieldDef[] Fields =
    [
        new("PreferredChannelOrder", "Preferred Mode of Contact", NotificationPolicyFieldEditDialog.FieldKind.Channels),
        new("BlockedChannels", "Blocked Mode of Contact", NotificationPolicyFieldEditDialog.FieldKind.Channels),
        new("MaxNotifications", "Max notifications per sendout", NotificationPolicyFieldEditDialog.FieldKind.Int),
        new("MaxReminders", "Max reminders", NotificationPolicyFieldEditDialog.FieldKind.Int),
        new("ReminderIntervalHours", "Reminder interval (hours)", NotificationPolicyFieldEditDialog.FieldKind.Int),
        new("LinkValidityDays", "Link validity (days)", NotificationPolicyFieldEditDialog.FieldKind.Int),
        new("SendoutTimeOfDay", "Sendout time of day", NotificationPolicyFieldEditDialog.FieldKind.Time),
        new("SendoutIntervalMinutes", "Sendout interval (minutes)", NotificationPolicyFieldEditDialog.FieldKind.Int),
    ];

    [Parameter] public Guid GradeLevelId { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private TenantNotificationPolicyDto? _tenantDefault;
    private GradeNotificationPolicyDto? _gradeOverride;
    private FieldRow[] _rows = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var tenantTask = SettingsApi.GetAsync();
            var gradeTask = Api.GetGradeNotificationPolicyAsync(GradeLevelId);
            await Task.WhenAll(tenantTask, gradeTask);

            _tenantDefault = tenantTask.Result;
            _gradeOverride = gradeTask.Result;
            BuildRows();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load notification policy for grade {Grade}", GradeLevelId);
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void BuildRows() => _rows = Fields.Select(GetRow).ToArray();

    private FieldRow GetRow(FieldDef def)
    {
        var global = GetValue(def.Key, _tenantDefault);
        var grade = GetValue(def.Key, _gradeOverride);
        return new FieldRow(
            def,
            FormatDisplay(def, global),
            grade is null ? "Inherit global" : FormatDisplay(def, grade),
            grade is not null);
    }

    private async Task EditAsync(FieldRow row)
    {
        try
        {
            var model = new NotificationPolicyFieldEditDialog.EditModel(
                row.Def.Key, row.Def.Label, row.Def.Kind, GradeLevelId, _tenantDefault, _gradeOverride);
            var result = await DialogService.ShowShellDialogAsync<NotificationPolicyFieldEditDialog,
                NotificationPolicyFieldEditDialog.EditModel,
                NotificationPolicyFieldEditDialog.EditResult>(model, $"Edit {row.Def.Label}", DialogSize.Large);
            if (result is not null)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to edit notification policy field {Field} for grade {Grade}", row.Def.Key, GradeLevelId);
            _error = ex.Message;
        }
    }

    private IReadOnlyList<RowAction> BuildRowActions(FieldRow row) =>
        new List<RowAction>
        {
            RowAction.Callback("Edit", () => EditAsync(row), FluentIcons.Edit),
            RowAction.Callback("Reset", () => ResetAsync(row), FluentIcons.ArrowClockwise,
                disabled: !row.GradeSet || _saving),
        };

    private async Task ResetAsync(FieldRow row)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            await Api.UpsertGradeNotificationPolicyAsync(GradeLevelId, BuildResetRequest(row.Def.Key));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset notification policy field {Field} for grade {Grade}", row.Def.Key, GradeLevelId);
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private UpsertGradeNotificationPolicyRequest BuildResetRequest(string key) =>
        new(
            key == "PreferredChannelOrder" ? null : _gradeOverride?.PreferredChannelOrder,
            key == "BlockedChannels" ? null : _gradeOverride?.BlockedChannels,
            key == "MaxNotifications" ? null : _gradeOverride?.MaxNotifications,
            key == "MaxReminders" ? null : _gradeOverride?.MaxReminders,
            key == "ReminderIntervalHours" ? null : _gradeOverride?.ReminderIntervalHours,
            key == "LinkValidityDays" ? null : _gradeOverride?.LinkValidityDays,
            key == "SendoutTimeOfDay" ? null : _gradeOverride?.SendoutTimeOfDay,
            key == "SendoutIntervalMinutes" ? null : _gradeOverride?.SendoutIntervalMinutes);

    private static string FormatDisplay(FieldDef def, object? value)
    {
        if (value is null) return "Not set";
        return def.Kind switch
        {
            NotificationPolicyFieldEditDialog.FieldKind.Channels => FormatChannels((NotificationChannel[])value),
            NotificationPolicyFieldEditDialog.FieldKind.Time => ((TimeOnly)value).ToString("HH:mm"),
            _ => ((int)value).ToString("N0"),
        };
    }

    private static object? GetValue(string key, TenantNotificationPolicyDto? p) => key switch
    {
        "PreferredChannelOrder" => p?.PreferredChannelOrder,
        "BlockedChannels" => p?.BlockedChannels,
        "MaxNotifications" => p?.MaxNotifications,
        "MaxReminders" => p?.MaxReminders,
        "ReminderIntervalHours" => p?.ReminderIntervalHours,
        "LinkValidityDays" => p?.LinkValidityDays,
        "SendoutTimeOfDay" => p?.SendoutTimeOfDay,
        "SendoutIntervalMinutes" => p?.SendoutIntervalMinutes,
        _ => null,
    };

    private static object? GetValue(string key, GradeNotificationPolicyDto? p) => key switch
    {
        "PreferredChannelOrder" => p?.PreferredChannelOrder,
        "BlockedChannels" => p?.BlockedChannels,
        "MaxNotifications" => p?.MaxNotifications,
        "MaxReminders" => p?.MaxReminders,
        "ReminderIntervalHours" => p?.ReminderIntervalHours,
        "LinkValidityDays" => p?.LinkValidityDays,
        "SendoutTimeOfDay" => p?.SendoutTimeOfDay,
        "SendoutIntervalMinutes" => p?.SendoutIntervalMinutes,
        _ => null,
    };

    private static string FormatChannels(NotificationChannel[] channels) =>
        channels.Length == 0 ? "None" : string.Join(", ", channels.Select(ChannelName));

    private static string ChannelName(NotificationChannel ch)
    {
        var member = ch.GetType().GetMember(ch.ToString())[0];
        var attr = member.GetCustomAttributes(typeof(DescriptionAttribute), false).FirstOrDefault() as DescriptionAttribute;
        return attr?.Description ?? ch.ToString();
    }
}

