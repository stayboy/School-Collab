@* TeacherEditDialog — create / edit a teacher in a modal dialog (v4).
   Profile + qualifications + a teaching-assignments grid. Each assignment row is
   a grade + optional subject + role, OR an activity + role + optional grades.
   Subjects are grade-scoped (no standalone subject links). Rows render read-only;
   Edit converts a row to editable inline; Save/Cancel commit or revert.

   v4 spec §3.4–§3.7: one dialog, two modes (TeacherId null = create); DialogShellBase;
   context grade (ContextGradeLevelId) pre-sets a default grade row; save reconciles
   grade + activity assignments through StudentsApiClient. *@
@inherits DialogShellBase<TeacherEditDialog.TeacherFormModel, TeacherDto>
@using System.ComponentModel.DataAnnotations
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@using GradeLevelDto = SchoolCollab.Students.Application.Services.GradeLevelDto
@using ActivityGroupDto = SchoolCollab.Students.Application.Services.ActivityGroupDto
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject ILogger<TeacherEditDialog> Logger

<div class="teacher-dialog">
    @if (_loading)
    {
        <div class="spinner-container"><FluentProgressRing /></div>
    }
    else
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="teacher-dialog-section">
                <div class="teacher-dialog-section-title">
                    <FluentIcon Icon="@(Icons.Regular.Size24.Person)" Color="@Color.Accent" />
                    <span>Profile</span>
                </div>
                <FormRow Label="Title">
                    <CodedValueDropdown Parent="CodedValueParent.Salutations"
                                        @bind-SelectedId="Model.TitleCodedValueId" />
                </FormRow>
                <FormRow Label="Name" Required For="teacherFirstName">
                    <div class="name-fields">
                        <FluentTextField Id="teacherFirstName" @bind-Value="Model.FirstName" Placeholder="First name" />
                        <FluentTextField Id="teacherLastName" @bind-Value="Model.LastName" Placeholder="Last name" />
                    </div>
                </FormRow>
                <FormRow Label="Display name">
                    <FluentTextField @bind-Value="Model.DisplayName" Placeholder="e.g. Mr. Smith (optional)" />
                </FormRow>
                <FormRow Label="Gender">
                    <CodedValueDropdown Parent="CodedValueParent.Genders"
                                        @bind-SelectedId="Model.GenderCodedValueId" />
                </FormRow>
                <FormRow Label="Date of birth">
                    <FluentDatePicker Id="teacherDialogDob"
                                      Value="@DateOfBirthAsDateTime"
                                      ValueChanged="@OnDateOfBirthChanged"
                                      Placeholder="Select date" />
                </FormRow>
                <FormRow Label="Level of education">
                    <CodedValueDropdown Parent="CodedValueParent.EducLevel"
                                        @bind-SelectedId="Model.LevelOfEducationCodedValueId" />
                </FormRow>
                <FormRow Label="Qualifications" AlignTop>
                    @if (_allQualifications is null)
                    {
                        <FluentProgressRing />
                    }
                    else if (_allQualifications.Length == 0)
                    {
                        <span class="muted">No qualification options in this tenant yet.</span>
                    }
                    else
                    {
                        @if (UnselectedQualifications.Length > 0)
                        {
                            <FluentCombobox @key="_qualKey" TOption="CodedValueDto"
                                            Items="@UnselectedQualifications"
                                            OptionText="@(q => q.Name)"
                                            SelectedOption="@_qualToAdd"
                                            SelectedOptionChanged="@OnQualificationPicked"
                                            Autocomplete="ComboboxAutocomplete.List"
                                            Placeholder="Add qualification…" Height="240px" />
                        }
                        else
                        {
                            <span class="muted">All qualifications selected.</span>
                        }
                        @if (SelectedQualifications.Length > 0)
                        {
                            <div class="chip-list">
                                @foreach (var q in SelectedQualifications)
                                {
                                    <Chip Label="@q.Name" OnDismiss="() => RemoveQualification(q.Id)" />
                                }
                            </div>
                        }
                    }
                </FormRow>
            </div>

            <div class="teacher-dialog-section">
                <div class="teacher-dialog-section-title">
                    <FluentIcon Icon="@(Icons.Regular.Size24.Book)" Color="@Color.Accent" />
                    <span>Teaching assignments (@Model.Assignments.Count)</span>
                </div>

                <div class="assignments-toolbar">
                    <FluentButton Appearance="Appearance.Outline" Size="Size.Small" OnClick="AddGradeAssignment">+ Grade</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" Size="Size.Small" OnClick="AddActivityAssignment">+ Activity</FluentButton>
                </div>

                @if (Model.Assignments.Count == 0)
                {
                    <p class="muted">No teaching assignments yet.</p>
                }
                else
                {
                    <div class="assignment-grid">
                        @foreach (var row in Model.Assignments)
                        {
                            <div class="assignment-row @(row.Editing ? "assignment-row--editing" : null)">
                                @if (row.Editing)
                                {
                                    @if (row.IsActivity)
                                    {
                                        <span class="row-type">Activity</span>
                                        <FluentSelect TOption="ActivityGroupDto" Items="@_allActivities"
                                                      OptionText="@(a => a.Name)" OptionValue="@(a => a.Id.ToString())"
                                                      Value="@(row.ActivityGroupId?.ToString())"
                                                      ValueChanged="@((string? v) => SetRowActivity(row, ParseGuid(v)))"
                                                      Placeholder="Activity" />
                                        <CodedValueDropdown Parent="CodedValueParent.TeacherRoles"
                                                            SelectedId="@row.RoleCodedValueId"
                                                            SelectedIdChanged="@((Guid? v) => SetRowRole(row, v))"
                                                            Placeholder="No role" />
                                        <FluentSelect TOption="GradeLevelDto" Multiple Items="@_allGradeLevels"
                                                      OptionText="@(g => g.Name)" OptionValue="@(g => g.Id.ToString())"
                                                      SelectedOptions="@(SelectedGradeObjects(row))"
                                                      SelectedOptionsChanged="@((IEnumerable<GradeLevelDto>? v) => SetRowGrades(row, v))"
                                                      Placeholder="Grades (optional)" />
                                    }
                                    else
                                    {
                                        <span class="row-type">Grade</span>
                                        <FluentSelect TOption="GradeLevelDto" Items="@_allGradeLevels"
                                                      OptionText="@(g => g.Name)" OptionValue="@(g => g.Id.ToString())"
                                                      Value="@(row.GradeLevelId?.ToString())"
                                                      ValueChanged="@((string? v) => SetRowGrade(row, ParseGuid(v)))"
                                                      Placeholder="Grade" />
                                        <FluentSelect TOption="TopicDto" Items="@SubjectsForGrade(row.GradeLevelId)"
                                                      OptionText="@(t => t.Name)" OptionValue="@(t => t.Id.ToString())"
                                                      Value="@(row.SubjectId?.ToString())"
                                                      ValueChanged="@((string? v) => SetRowSubject(row, ParseGuid(v)))"
                                                      Placeholder="Subject (optional)" />
                                        <CodedValueDropdown Parent="CodedValueParent.TeacherRoles"
                                                            SelectedId="@row.RoleCodedValueId"
                                                            SelectedIdChanged="@((Guid? v) => SetRowRole(row, v))"
                                                            Placeholder="No role" />
                                    }
                                    <FluentButton Appearance="Appearance.Accent" Size="Size.Small" OnClick="() => SaveRow(row)">Save</FluentButton>
                                    <FluentButton Appearance="Appearance.Outline" Size="Size.Small" OnClick="() => CancelRow(row)">Cancel</FluentButton>
                                }
                                else
                                {
                                    <span class="row-type">@(row.IsActivity ? "Activity" : "Grade")</span>
                                    <span class="row-display">@DisplayText(row)</span>
                                    <FluentButton Appearance="Appearance.Stealth" Size="Size.Small" OnClick="() => row.Editing = true">Edit</FluentButton>
                                    <FluentButton Appearance="Appearance.Stealth" Size="Size.Small"
                                                  IconStart="@FluentIcons.Delete" Title="Remove assignment"
                                                  OnClick="() => RemoveRow(row)">Remove</FluentButton>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <DialogShellFooter Saving="@Saving"
                               Error="@Error"
                               SubmitText="@SubmitText"
                               SavingText="@SavingText"
                               OnCancel="HandleCancelAsync" />
        </EditForm>
    }
</div>


@code {
    /// <summary>Form-state model for the teacher create/edit dialog.</summary>
    public sealed class TeacherFormModel
    {
        public Guid? TeacherId { get; set; }
        public Guid? ContextGradeLevelId { get; set; }
        public string? ContextGradeLevelName { get; set; }

        [Required] public string FirstName { get; set; } = string.Empty;
        [Required] public string LastName { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public Guid? TitleCodedValueId { get; set; }
        public Guid? GenderCodedValueId { get; set; }
        public DateOnly? DateOfBirth { get; set; }
        public Guid? LevelOfEducationCodedValueId { get; set; }
        public HashSet<Guid> QualificationCodedValueIds { get; set; } = new();

        public List<AssignmentRow> Assignments { get; set; } = new();
    }

    /// <summary>One teaching-assignment grid row (grade + optional subject + role, or activity + role + grades).</summary>
    public sealed class AssignmentRow
    {
        public Guid Key { get; set; } = Guid.NewGuid();
        public Guid? RowId { get; set; }                 // existing assignment row id (null = new)
        public bool IsActivity { get; set; }
        public bool Editing { get; set; } = true;        // new rows open in edit mode
        public Guid? GradeLevelId { get; set; }
        public Guid? SubjectId { get; set; }
        public Guid? ActivityGroupId { get; set; }
        public Guid? RoleCodedValueId { get; set; }
        public HashSet<Guid> GradeLevelIds { get; set; } = new();
    }

    private bool _isEdit => Model.TeacherId.HasValue;
    private bool InGradeContext => Model.ContextGradeLevelId.HasValue;
    private bool _loading = true;

    private TopicDto[]? _allTopics;
    private GradeLevelDto[]? _allGradeLevels;
    private ActivityGroupDto[]? _allActivities;
    private CodedValueDto[]? _allQualifications;
    private CodedValueDto[]? _allTeacherRoles;
    /// <summary>Maps grade level id → set of enrolled topic ids (for filtering subject pickers).</summary>
    private Dictionary<Guid, HashSet<Guid>>? _gradeEnrolledTopicIdsByGrade;

    private CodedValueDto? _qualToAdd;
    private int _qualKey;

    // Original assignment state for edit-mode reconciliation.
    private readonly List<AssignmentRow> _originalRows = new();

    protected override string SubmitText => _isEdit ? "Save Changes" : "Create Teacher";
    protected override string SavingText => _isEdit ? "Saving…" : "Creating…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadAsync()
    {
        try
        {
            _allTopics = await Api.ListTopicsAsync() ?? [];
            _allGradeLevels = await Api.ListGradeLevelsAsync() ?? [];
            _allActivities = await Api.ListActivityGroupsAsync() ?? [];
            _allQualifications = await CodedValuesApi.GetChildrenByParentCodeAsync(CodedValueParent.Qualification.ToCode()) ?? [];
            _allTeacherRoles = await CodedValuesApi.GetChildrenByParentCodeAsync(CodedValueParent.TeacherRoles.ToCode()) ?? [];

            // Load topic assignments for ALL grades so each grade row's subject picker
            // is filtered to that grade's enrolled subjects (v4 spec §3.2).
            _gradeEnrolledTopicIdsByGrade = new();
            foreach (var g in _allGradeLevels ?? [])
            {
                var assignments = await Api.ListGradeTopicsByGradeAsync(g.Id) ?? [];
                _gradeEnrolledTopicIdsByGrade[g.Id] = assignments.Select(a => a.TopicId).ToHashSet();
            }

            if (Model.TeacherId is { } teacherId)
            {
                var t = await Api.GetTeacherByIdAsync(teacherId);
                if (t is not null)
                {
                    Model.TitleCodedValueId = t.TitleCodedValueId;
                    Model.FirstName = t.FirstName;
                    Model.LastName = t.LastName;
                    Model.DisplayName = t.DisplayName ?? string.Empty;
                    Model.GenderCodedValueId = t.GenderCodedValueId;
                    Model.DateOfBirth = t.DateOfBirth;
                    Model.LevelOfEducationCodedValueId = t.LevelOfEducationCodedValueId;
                    Model.QualificationCodedValueIds = (t.QualificationCodedValueIds ?? []).ToHashSet();
                }

                Model.Assignments.Clear();
                foreach (var g in await Api.ListTeacherGradeAssignmentsAsync(teacherId) ?? [])
                {
                    Model.Assignments.Add(new AssignmentRow
                    {
                        RowId = g.RowId, IsActivity = false, Editing = false,
                        GradeLevelId = g.GradeLevelId, SubjectId = g.SubjectId, RoleCodedValueId = g.RoleCodedValueId
                    });
                }
                foreach (var a in await Api.ListTeacherActivityAssignmentsAsync(teacherId) ?? [])
                {
                    Model.Assignments.Add(new AssignmentRow
                    {
                        RowId = a.RowId, IsActivity = true, Editing = false,
                        ActivityGroupId = a.ActivityGroupId, RoleCodedValueId = a.RoleCodedValueId,
                        GradeLevelIds = a.GradeLevelIds.ToHashSet()
                    });
                }
                CopyOriginals();
            }
            else
            {
                Model.Assignments.Clear();
                if (InGradeContext && Model.ContextGradeLevelId is { } ctx)
                    Model.Assignments.Add(new AssignmentRow { GradeLevelId = ctx, SubjectId = null });
                CopyOriginals();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load data for teacher dialog (TeacherId={TeacherId})", Model.TeacherId);
            Error = $"Could not load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void CopyOriginals()
    {
        _originalRows.Clear();
        foreach (var r in Model.Assignments)
            _originalRows.Add(CloneRow(r));
    }

    private static AssignmentRow CloneRow(AssignmentRow r) => new()
    {
        Key = r.Key, RowId = r.RowId, IsActivity = r.IsActivity, Editing = r.Editing,
        GradeLevelId = r.GradeLevelId, SubjectId = r.SubjectId, ActivityGroupId = r.ActivityGroupId,
        RoleCodedValueId = r.RoleCodedValueId, GradeLevelIds = new HashSet<Guid>(r.GradeLevelIds)
    };

    // ---- Computed lists ----

    private CodedValueDto[] SelectedQualifications
        => _allQualifications?.Where(q => Model.QualificationCodedValueIds.Contains(q.Id)).ToArray() ?? [];

    private CodedValueDto[] UnselectedQualifications
        => _allQualifications?.Where(q => !Model.QualificationCodedValueIds.Contains(q.Id)).ToArray() ?? [];

    /// <summary>Subjects a grade row may choose: the grade's enrolled subjects (empty if grade has no assigned subjects).</summary>
    private TopicDto[] SubjectsForGrade(Guid? gradeLevelId)
    {
        if (_allTopics is null) return [];
        if (gradeLevelId is null) return [];
        if (_gradeEnrolledTopicIdsByGrade is not { } map) return [];
        if (!map.TryGetValue(gradeLevelId.Value, out var enrolled)) return [];
        return _allTopics.Where(t => enrolled.Contains(t.Id)).ToArray();
    }

    private IEnumerable<GradeLevelDto> SelectedGradeObjects(AssignmentRow row)
        => (_allGradeLevels ?? []).Where(g => row.GradeLevelIds.Contains(g.Id));

    // ---- Grid mutation handlers (each updates the component's own list state) ----

    private void AddGradeAssignment()
        => Model.Assignments.Add(new AssignmentRow { GradeLevelId = InGradeContext ? Model.ContextGradeLevelId : null });

    private void AddActivityAssignment()
        => Model.Assignments.Add(new AssignmentRow { IsActivity = true });

    private void RemoveRow(AssignmentRow row)
        => Model.Assignments.Remove(row);

    private void SaveRow(AssignmentRow row)
    {
        if (row.IsActivity)
        {
            if (row.ActivityGroupId is null) return; // require an activity
        }
        else
        {
            if (row.GradeLevelId is null) return; // require a grade
        }
        row.Editing = false;
    }

    private void CancelRow(AssignmentRow row)
    {
        var original = _originalRows.FirstOrDefault(o => o.Key == row.Key);
        if (original is not null)
        {
            var idx = Model.Assignments.IndexOf(row);
            Model.Assignments[idx] = CloneRow(original);
        }
        else
        {
            Model.Assignments.Remove(row);
        }
    }

    private void SetRowGrade(AssignmentRow row, Guid? gradeLevelId)
    {
        row.GradeLevelId = gradeLevelId;
        row.SubjectId = null; // subject is scoped to the grade — reset when grade changes
    }

    private void SetRowSubject(AssignmentRow row, Guid? subjectId) => row.SubjectId = subjectId;
    private void SetRowActivity(AssignmentRow row, Guid? activityGroupId) => row.ActivityGroupId = activityGroupId;
    private void SetRowRole(AssignmentRow row, Guid? role) => row.RoleCodedValueId = role;

    private void SetRowGrades(AssignmentRow row, IEnumerable<GradeLevelDto>? grades)
    {
        row.GradeLevelIds = new HashSet<Guid>(grades?.Select(g => g.Id) ?? []);
    }

    private string DisplayText(AssignmentRow row)
    {
        if (row.IsActivity)
        {
            var name = _allActivities?.FirstOrDefault(a => a.Id == row.ActivityGroupId)?.Name;
            var grades = string.Join(", ", (_allGradeLevels ?? []).Where(g => row.GradeLevelIds.Contains(g.Id)).Select(g => g.Name));
            var role = _allTeacherRoles?.FirstOrDefault(r => r.Id == row.RoleCodedValueId)?.Name;
            return $"{name ?? "Activity"}{(string.IsNullOrEmpty(grades) ? "" : $" · {grades}")}{(string.IsNullOrEmpty(role) ? "" : $" · {role}")}";
        }
        else
        {
            var grade = _allGradeLevels?.FirstOrDefault(g => g.Id == row.GradeLevelId)?.Name;
            var subject = _allTopics?.FirstOrDefault(t => t.Id == row.SubjectId)?.Name;
            var role = _allTeacherRoles?.FirstOrDefault(r => r.Id == row.RoleCodedValueId)?.Name;
            return $"{grade ?? "Grade"}{(string.IsNullOrEmpty(subject) ? "" : $" · {subject}")}{(string.IsNullOrEmpty(role) ? "" : $" · {role}")}";
        }
    }

    private static Guid? ParseGuid(string? s) => Guid.TryParse(s, out var g) ? g : null;

    private void OnQualificationPicked(CodedValueDto? q)
    {
        if (q is null) return;
        if (!Model.QualificationCodedValueIds.Add(q.Id)) return;
        _qualToAdd = null;
        _qualKey++;
    }

    private void RemoveQualification(Guid codedValueId)
        => Model.QualificationCodedValueIds.Remove(codedValueId);

    private DateTime? DateOfBirthAsDateTime => Model.DateOfBirth?.ToDateTime(TimeOnly.MinValue);

    private void OnDateOfBirthChanged(DateTime? value)
        => Model.DateOfBirth = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;

    private Guid[]? QualificationIds()
        => Model.QualificationCodedValueIds.Count == 0 ? null : Model.QualificationCodedValueIds.ToArray();

    protected override async Task<TeacherDto?> SubmitAsync(TeacherFormModel model)
    {
        Guid teacherId;
        if (model.TeacherId is { } editId)
        {
            teacherId = editId;
            await Api.UpdateTeacherAsync(teacherId, new UpdateTeacherRequest(
                model.FirstName.Trim(), model.LastName.Trim(),
                string.IsNullOrWhiteSpace(model.DisplayName) ? null : model.DisplayName.Trim(),
                model.GenderCodedValueId, model.DateOfBirth, model.LevelOfEducationCodedValueId,
                QualificationIds()));
            await ReconcileAssignmentsAsync(teacherId, model);
        }
        else
        {
            teacherId = await Api.CreateTeacherAsync(new CreateTeacherRequest(
                model.TitleCodedValueId,
                model.FirstName.Trim(), model.LastName.Trim(),
                string.IsNullOrWhiteSpace(model.DisplayName) ? null : model.DisplayName.Trim(),
                model.GenderCodedValueId, model.DateOfBirth, model.LevelOfEducationCodedValueId,
                QualificationIds()));
            await ReconcileAssignmentsAsync(teacherId, model);

            // Context grade is force-included on create if the user removed the pre-created row.
            if (model.ContextGradeLevelId is { } ctx
                && !model.Assignments.Any(a => !a.IsActivity && a.GradeLevelId == ctx))
                await Api.LinkTeacherGradeAssignmentAsync(teacherId, ctx, null, null);
        }

        return await Api.GetTeacherByIdAsync(teacherId);
    }

    private async Task ReconcileAssignmentsAsync(Guid teacherId, TeacherFormModel model)
    {
        var currentGrade = model.Assignments.Where(a => !a.IsActivity).ToList();
        var originalGrade = _originalRows.Where(a => !a.IsActivity).ToList();
        foreach (var o in originalGrade.Where(o => currentGrade.All(c => c.Key != o.Key)))
            await Api.DeleteTeacherGradeAssignmentAsync(teacherId, o.RowId!.Value);
        foreach (var c in currentGrade.Where(c => c.RowId is null))
            await Api.LinkTeacherGradeAssignmentAsync(teacherId, c.GradeLevelId!.Value, c.SubjectId, c.RoleCodedValueId);
        foreach (var c in currentGrade.Where(c => c.RowId is not null))
        {
            var o = originalGrade.First(o => o.Key == c.Key);
            if (o.GradeLevelId != c.GradeLevelId || o.SubjectId != c.SubjectId || o.RoleCodedValueId != c.RoleCodedValueId)
            {
                await Api.DeleteTeacherGradeAssignmentAsync(teacherId, c.RowId!.Value);
                await Api.LinkTeacherGradeAssignmentAsync(teacherId, c.GradeLevelId!.Value, c.SubjectId, c.RoleCodedValueId);
            }
        }

        var currentActivity = model.Assignments.Where(a => a.IsActivity).ToList();
        var originalActivity = _originalRows.Where(a => a.IsActivity).ToList();
        foreach (var o in originalActivity.Where(o => currentActivity.All(c => c.Key != o.Key)))
            await Api.DeleteTeacherActivityAssignmentAsync(teacherId, o.RowId!.Value);
        foreach (var c in currentActivity.Where(c => c.RowId is null))
            await Api.LinkTeacherActivityAssignmentAsync(teacherId, c.ActivityGroupId!.Value, c.RoleCodedValueId, c.GradeLevelIds.ToArray());
        foreach (var c in currentActivity.Where(c => c.RowId is not null))
        {
            var o = originalActivity.First(o => o.Key == c.Key);
            if (o.ActivityGroupId != c.ActivityGroupId || o.RoleCodedValueId != c.RoleCodedValueId
                || !o.GradeLevelIds.SetEquals(c.GradeLevelIds))
            {
                await Api.DeleteTeacherActivityAssignmentAsync(teacherId, c.RowId!.Value);
                await Api.LinkTeacherActivityAssignmentAsync(teacherId, c.ActivityGroupId!.Value, c.RoleCodedValueId, c.GradeLevelIds.ToArray());
            }
        }
    }
}
