@* Read-only dialog displaying every contact for ONE guardian. Opened by
   the student view page's guardians grid when the user clicks the
   "View all (N) contacts" anchor in a row that has more than 3 contacts
   (spec 2026-07-27 §4.5 — replaces the legacy <GuardianContactsList>
   section on the view page).

   Data: loads via IContactsClient.ListContactsAsync(Guardian, guardianId)
   on every OnParametersSetAsync, ordered by DisplayOrder ascending
   (then CreatedAt as a stable tiebreaker). The shared <ContactsEditor>
   on GuardianDetail.razor is still the editor; this dialog is
   display-only.

   Close mechanism: the dialog host (FluentUI) cascades an IDialogInstance
   reference into the body. The footer Close button calls
   DialogInstance.CloseAsync(); the user can also click the dialog's
   default close (X) affordance.

   This component is intentionally NOT a DialogShellBase (no model, no
   OK/Cancel result, no form). It is opened via
   DialogServiceExtensions.ShowReadonlyDialogAsync, which passes the shell
   options (title + width + no built-in footer actions + blocked
   overlay/ESC dismissal) plus the content entries (GuardianId /
   GuardianName / Subtitle) under the matching key names.

   CONTRACT (FluentUI 5.x): the dialog declares typed [Parameter]
   properties, and the key constants are `nameof(<Parameter>)` — FluentUI
   spreads DialogOptions.Parameters onto [Parameter] properties by name, so
   a key that does not match a parameter throws at render and a parameter
   the caller never passes silently defaults (the empty-guid edit-dialog
   bug). Keep documents/solution/dialog-parameter-binding.md in sync.

   Test plan (spec §5): covered by GuardianContactsDialogTests
   (source-level). Cancellation mirrors ContactsEditor / GuardianContactsList. *@
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components
@using SchoolCollab.Students.Core.Contracts
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Core.DTOs
@using Microsoft.FluentUI.AspNetCore.Components
@inject IContactsClient ContactsApi
@inject ILogger<GuardianContactsDialog> Logger

@* The cascading IDialogInstance reference comes from the FluentUI dialog
   host that renders this component. It is the handle the footer Close
   button (and any future in-dialog actions) use to dismiss the dialog.
   Declared in the @code block below. *@

<DialogShellBody>
<div class="guardian-contacts-dialog">
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <p class="guardian-contacts-subtitle muted">@Subtitle</p>
    }

    @if (_loading)
    {
        <div class="spinner-container"><FluentSpinner /></div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
    }
    else if (_contacts.Count == 0)
    {
        <FluentMessageBar Intent="MessageBarIntent.Info">
            No contacts on file for this guardian.
        </FluentMessageBar>
    }
    else
    {
        <ul class="guardian-contact-list">
            @foreach (var c in _contacts)
            {
                <li class="@(c.DisplayOrder == 0 ? "guardian-contact-row guardian-contact-row--primary" : "guardian-contact-row")">
                    <span class="guardian-contact-channel" title="@c.Channel">@ChannelGlyph(c.Channel) @c.Channel</span>
                    <span class="guardian-contact-value">@(string.IsNullOrWhiteSpace(c.CountryCode) ? c.Value : $"{c.CountryCode} {c.Value}")</span>
                    @if (!string.IsNullOrWhiteSpace(c.Label))
                    {
                        <span class="muted guardian-contact-label">(@c.Label)</span>
                    }
                    <span class="guardian-contact-badges">
                        @if (c.DisplayOrder == 0)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Filled" Class="guardian-contact-badge">Primary</FluentBadge>
                        }
                        @if (c.IsVerified)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Filled" Class="guardian-contact-badge">Verified</FluentBadge>
                        }
                        else
                        {
                            <FluentBadge Appearance="BadgeAppearance.Filled" Class="guardian-contact-badge">Unverified</FluentBadge>
                        }
                    </span>
                </li>
            }
        </ul>
    }

    @* Footer — a single Close button. The dialog host has no
       PrimaryAction/SecondaryAction (set by BuildShellParameters), so
       the body must own the close affordance. The separator line above
       mirrors the dialog-ui skill's content/actions split. *@
    <div class="guardian-contacts-footer">
        <FluentButton Appearance="ButtonAppearance.Primary"
                      OnClick="CloseAsync">
            Close
        </FluentButton>
    </div>
</div>
</DialogShellBody>

@code {
    /// <summary>Keys used in <c>DialogOptions.Parameters</c>. Exposed so
    /// callers set the same keys the dialog binds to — each key MUST match a
    /// <c>[Parameter]</c> name above (FluentUI 5.x spreads the entries).</summary>
    public const string GuardianIdKey = nameof(GuardianId);
    public const string GuardianNameKey = nameof(GuardianName);
    public const string SubtitleKey = nameof(Subtitle);

    /// <summary>The guardian whose full contact list to display. Required —
    /// no default. Changing it (e.g. re-opening for a different guardian)
    /// triggers a reload.</summary>
    [Parameter] public Guid GuardianId { get; set; }

    /// <summary>Dialog title (set by the shell options' header title; this
    /// value is available inside the body, e.g. to render in the subtitle).</summary>
    [Parameter] public string? GuardianName { get; set; }

    /// <summary>Optional subtitle rendered under the dialog title — e.g.
    /// <c>"Father · Primary"</c>.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>The hosting dialog instance provided by the dialog host as a
    /// cascading parameter. Used by the footer Close button to dismiss the
    /// dialog. Nullable so unit tests that render the component without a
    /// dialog host do not NRE (<see cref="CloseAsync"/> short-circuits when
    /// null).</summary>
    [CascadingParameter] public IDialogInstance? DialogInstance { get; set; }

    private List<ContactDto> _contacts = new();
    private bool _loading;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private Guid? _loadedFor;

    /// <summary>Reload whenever GuardianId changes (re-opening for a
    /// different guardian while the same component instance is reused).</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == GuardianId) return;
        _loadedFor = GuardianId;

        _disposed = false;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        _loading = true;
        _error = null;
        _contacts = new();
        try
        {
            var result = await ContactsApi.ListContactsAsync(ContactOwnerType.Guardian, GuardianId, ct);
            _contacts = (result ?? Array.Empty<ContactDto>())
                .OrderBy(c => c.DisplayOrder)
                .ThenBy(c => c.CreatedAt)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            // Expected on rapid re-open / dispose.
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to load contacts for guardian {GuardianId}", GuardianId);
                _error = "Couldn't load contacts. Try again.";
            }
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    /// <summary>Close the hosting dialog. Safe to call before the cascade is
    /// wired — the cascade is guaranteed by the dialog host, but we guard so
    /// unit tests without a host don't NRE.</summary>
    private Task CloseAsync()
    {
        return DialogInstance is null ? Task.CompletedTask : DialogInstance.CloseAsync();
    }

    /// <summary>Emoji glyph preceding each contact channel. Mirrors the
    /// helper used by the (now-deleted) GuardianContactsList so the dialog
    /// and the grid's contact cells read consistently.</summary>
    private static string ChannelGlyph(ContactChannel channel) => channel switch
    {
        ContactChannel.Email => "✉",
        ContactChannel.SMS => "📱",
        ContactChannel.WhatsApp => "💬",
        _ => "•",
    };

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
