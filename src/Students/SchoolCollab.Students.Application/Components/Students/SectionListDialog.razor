@* Read-only "View all" list dialog backing a &lt;SectionCard&gt; footer anchor
   when the card is opened in ViewAllAsDialog mode. It renders THIS card's
   full item list — the same data source the card preview shows — so the list
   is always the page's own (already scope-filtered) data. Use it when no
   dedicated filtered list page exists for the card's entity (e.g. the
   grade-detail Streams card, whose source is the GradeStreamAssignment
   bridge and NOT the cross-grade GRSTREAMS coded-value catalogue).

   Layout — the dialog's height authority, its ONE scroll region and the pinned
   Close row — is the shared ReadOnlyDialogShell, so this file declares no
   height/scroll/footer CSS of its own (§7 of .github/skills/dialog-ui/SKILL.md).
   The list below is therefore NOT given a max-height/overflow: it keeps its natural
   height and the SHELL scrolls it.

   Follows the established read-only dialog pattern (SubPeriodsListDialog /
   GuardianContactsDialog / GradeTopicsDialog): NOT a DialogShellBase (no
   model/form/result), opened via DialogServiceExtensions.ShowReadonlyDialogAsync,
   and declares typed [Parameter]s whose key constants are
   nameof(&lt;Parameter&gt;) — FluentUI 5.x spreads DialogOptions.Parameters onto
   [Parameter] properties by name (see
   documents/solution/dialog-parameter-binding.md) — closing via the cascading
   IDialogInstance reference.

   Presentational only: rows are not clickable and carry no actions. The card
   itself owns edit/add affordances for the same items.

   OPTIONAL reorder: when the caller supplies BOTH MoveUp and MoveDown
   callbacks, each row gains icon-only move-up/move-down buttons in a leading
   order column, BEFORE the name (the repo's mandated reorder affordance — there
   is no drag-and-drop).
   The callback moves ONE item (the one whose button was clicked) to the
   neighbour position; this dialog swaps the two neighbours locally in the same
   order so the list reflects the move without a re-fetch, then invokes the
   optional OnChanged so the hosting page/card refreshes too. A failing callback
   leaves the local order untouched and surfaces the message in an error bar.
   Without those keys every existing caller renders exactly as before. *@
@using Microsoft.FluentUI.AspNetCore.Components
@typeparam TItem

<DialogShellBody>
<ReadOnlyDialogShell Class="section-list-dialog">
    <Toolbar>
        @if (_moveError is { } moveError)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@moveError</FluentMessageBar>
        }
    </Toolbar>
    <ChildContent>
        @if (_items.Length == 0)
        {
            <div class="section-list-dialog__empty">@_emptyMessage</div>
        }
        else
        {
            <div class="section-list-dialog__list">
                @for (var index = 0; index < _items.Length; index++)
                {
                    var item = _items[index];
                    var position = index;
                    <div class="section-list-dialog__row">
                        @if (ReorderEnabled)
                        {
                            <div class="section-list-dialog__order">
                                <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                              IconStart="@FluentIcons.ChevronUp"
                                              Title="Move up"
                                              AriaLabel="@($"Move {_textSelector(item)} up")"
                                              Disabled="@(_moving || position == 0)"
                                              OnClick="@(() => MoveAsync(position, position - 1, _moveUp))" />
                                <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                              IconStart="@FluentIcons.ChevronDown"
                                              Title="Move down"
                                              AriaLabel="@($"Move {_textSelector(item)} down")"
                                              Disabled="@(_moving || position == _items.Length - 1)"
                                              OnClick="@(() => MoveAsync(position, position + 1, _moveDown))" />
                            </div>
                        }
                        <div class="section-list-dialog__main">
                            <span class="section-list-dialog__name">@_textSelector(item)</span>
                            @if (_metaSelector?.Invoke(item) is { } metaParts && metaParts.Length > 0)
                            {
                                <div class="section-list-dialog__meta">
                                    @for (var i = 0; i < metaParts.Length; i++)
                                    {
                                        <span>@metaParts[i]</span>
                                        @if (i < metaParts.Length - 1)
                                        {
                                            <span class="section-list-dialog__meta-sep" aria-hidden="true">|</span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CloseAsync">Close</FluentButton>
    </Footer>
</ReadOnlyDialogShell>
</DialogShellBody>

@code {
    /// <summary>Keys used in <c>DialogOptions.Parameters</c>. Exposed so
    /// callers (SectionCard) set the same keys this dialog binds to — each key
    /// MUST match a <c>[Parameter]</c> name (FluentUI 5.x spreads the
    /// entries).</summary>
    public const string ItemsKey = nameof(Items);
    public const string TextSelectorKey = nameof(TextSelector);
    public const string MetaSelectorKey = nameof(MetaSelector);
    public const string EmptyMessageKey = nameof(EmptyMessage);
    public const string MoveUpKey = nameof(MoveUp);
    public const string MoveDownKey = nameof(MoveDown);
    public const string OnChangedKey = nameof(OnChanged);

    [CascadingParameter] public IDialogInstance? DialogInstance { get; set; }

    /// <summary>The card's items to list. Required — no default.</summary>
    [Parameter] public TItem[] Items { get; set; } = [];

    /// <summary>Selector for each row's display text. Optional: an empty
    /// selector renders blank rows.</summary>
    [Parameter] public Func<TItem, string?> TextSelector { get; set; } = static _ => string.Empty;

    /// <summary>Optional selector for each row's secondary (meta) line.</summary>
    [Parameter] public Func<TItem, string[]?>? MetaSelector { get; set; }

    /// <summary>Shown when the caller supplies no items.</summary>
    [Parameter] public string EmptyMessage { get; set; } = "No items yet.";

    /// <summary>Optional reorder callback: move this item one position up.
    /// Reorder controls render only when BOTH <see cref="MoveUp"/> and
    /// <see cref="MoveDown"/> arrive.</summary>
    [Parameter] public Func<TItem, Task>? MoveUp { get; set; }

    /// <summary>Optional reorder callback: move this item one position down.</summary>
    [Parameter] public Func<TItem, Task>? MoveDown { get; set; }

    /// <summary>Optional callback the hosting page/card passes so it can
    /// refresh after a local reorder.</summary>
    [Parameter] public Func<Task>? OnChanged { get; set; }

    // Snapshot fields: the dialog is presentational and opened once with the
    // card's current data, so everything is snapshotted in OnInitialized
    // (the card owns refreshes; it re-opens the dialog with fresh entries).
    // _items is re-assigned (never mutated in place) on a move, so the caller's
    // own array is left alone.
    private TItem[] _items = [];
    private Func<TItem, string?> _textSelector = static _ => string.Empty;
    private Func<TItem, string[]?>? _metaSelector;
    private string _emptyMessage = "No items yet.";
    private Func<TItem, Task>? _moveUp;
    private Func<TItem, Task>? _moveDown;
    private Func<Task>? _onChanged;
    private string? _moveError;
    private bool _moving;

    /// <summary>Reorder controls render only when BOTH move callbacks arrived —
    /// a card that wires just one has no coherent move semantics.</summary>
    private bool ReorderEnabled => _moveUp is not null && _moveDown is not null;

    /// <summary>Invokes the footer Close anchor (and the X dismiss, which the
    /// shell options keep enabled for read-only dialogs).
    /// <see cref="CloseAsync"/> short-circuits when null.</summary>
    private Task CloseAsync() => DialogInstance is null ? Task.CompletedTask : DialogInstance.CloseAsync();

    protected override void OnInitialized()
    {
        _items = Items;
        _textSelector = TextSelector;
        _metaSelector = MetaSelector;
        _emptyMessage = EmptyMessage;
        _moveUp = MoveUp;
        _moveDown = MoveDown;
        _onChanged = OnChanged;
    }

    /// <summary>
    /// Moves the item at <paramref name="from"/> to <paramref name="to"/>: the
    /// caller's callback performs the move server-side (it owns the target
    /// position), then the two neighbours trade places locally so the dialog
    /// reflects the new order immediately. A failing callback leaves the order
    /// untouched and surfaces the message instead of silently desyncing the list.
    /// </summary>
    private async Task MoveAsync(int from, int to, Func<TItem, Task>? move)
    {
        if (_moving || move is null) return;
        if (from < 0 || to < 0 || from >= _items.Length || to >= _items.Length) return;

        _moving = true;
        _moveError = null;
        try
        {
            await move(_items[from]);

            var next = _items.ToArray();
            (next[from], next[to]) = (next[to], next[from]);
            _items = next;

            if (_onChanged is not null) await _onChanged();
        }
        catch (Exception ex)
        {
            _moveError = $"Could not reorder: {ex.Message}";
        }
        finally
        {
            _moving = false;
        }
    }
}
