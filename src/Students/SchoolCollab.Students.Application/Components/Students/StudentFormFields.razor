    private static string ChannelGlyph(ContactChannel channel) => channel switch
    {
        ContactChannel.Email => "✉",
        ContactChannel.SMS => "📱",
        ContactChannel.WhatsApp => "💬",
        _ => "•",
    };

    private static string FormatContactValue(ContactModel c) =>
        (c.Channel is ContactChannel.SMS or ContactChannel.WhatsApp
         && !string.IsNullOrWhiteSpace(c.CountryCode))
            ? $"{c.CountryCode} {c.Value}"
            : c.Value;



