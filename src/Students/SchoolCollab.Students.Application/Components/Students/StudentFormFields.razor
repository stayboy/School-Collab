    /// <summary>UI-only sentinel Guid for the "Add Existing Guardian"
    /// trigger line item in the local relationship dropdown. Never reaches
    /// the save path — AddInlineGuardianAsync resolves it to the picked
    /// real relationship (or null) before constructing the
    /// <see cref="GuardianAssignment"/> (plan §2.1 guard, wired in Phase 5).
    /// Picked as a random v4 Guid (not Guid.Empty, which collides with
    /// nullable Guid defaults and the CodedValueDropdown "none" sentinel).
    /// Stability asserted by a unit test (plan §9.3).</summary>
    internal static readonly Guid ExistingGuardianSentinel =
        new("e1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c");

    /// <summary>Discriminator for entries in the local relationship
    /// dropdown's option list (plan §2). <see cref="Sentinel"/> is the
    /// selectable "Add Existing Guardian" trigger; <see cref="Divider"/> is
    /// the non-selectable horizontal rule that visually separates the
    /// trigger from the real relationship types; <see cref="Relationship"/>
    /// is a real relationship coded value (RELATSHIPS child).</summary>
    internal enum RelationshipOptionKind { Relationship, Sentinel, Divider }

    /// <summary>One entry in the local relationship dropdown's option list.
    /// For <see cref="Kind"/> == <see cref="RelationshipOptionKind.Sentinel"/>
    /// <see cref="Id"/> equals <see cref="ExistingGuardianSentinel"/>;
    /// for <see cref="RelationshipOptionKind.Divider"/> <see cref="Id"/>
    /// is null and <see cref="IsDisabled"/> is true (FluentSelect guarantees
    /// a disabled option can never be selected, so the divider is excluded
    /// from value-mapping and the §6 duplicate-link checks automatically);
    /// for <see cref="RelationshipOptionKind.Relationship"/> <see cref="Id"/>
    /// is the coded value id and <see cref="IsDisabled"/> mirrors the
    /// coded value's own disabled flag so tenant-disabled relationships
    /// stay non-selectable.</summary>
    internal sealed record RelationshipOption(
        Guid? Id,
        string Label,
        RelationshipOptionKind Kind,
        bool IsDisabled);

    /// <summary>One row in the "add existing guardian" typeahead results
    /// (plan §4.1). <see cref="RelationshipName"/> is set in by-student
    /// mode (resolved from <c>StudentGuardianViewDto.RelationshipCodedValueId</c>)
    /// and null in by-contact mode — a relationship is per student↔guardian
    /// link, not a guardian property (plan §3.2). <see cref="WardCount"/>
    /// is <c>null</c> when enrichment failed (renders "—" per plan §4).</summary>
    internal sealed record GuardianSearchRow(
        Guid Id,
        string FullName,
        string? RelationshipName,
        int? WardCount,
        // Phase 5 prefill source — NOT part of the §4.1 display shape. Appended
        // after the four §4.1 positions so the documented display order stays
        // stable; the markup only reads FullName/RelationshipName/WardCount.
        // Carried on the row (rather than refetched on pick) so
        // PickExistingGuardianAsync can prefill name/title/relationship without
        // a second API round-trip.
        string FirstName,
        string LastName,
        Guid? TitleCodedValueId,
        Guid? RelationshipCodedValueId,
        // §11 Student-mode match context (null in Contact mode):
        string? MatchedStudentName,
        string? MatchedStudentNumber);

    /// <summary>The loaded option list for the local relationship dropdown
    /// (sentinel + divider + RELATSHIPS coded values, in that order).
    /// Populated by <see cref="BuildRelationshipOptionsAsync"/> in
    /// OnInitializedAsync when <see cref="ShowGuardians"/> is true.
    /// Null while loading; empty after a load failure (the dropdown falls
    /// back to no options — non-fatal, matches the CodedValueDropdown's
    /// own error UX).</summary>
    private RelationshipOption[]? _relationshipOptions;

    // Existing-mode state for the typeahead (plan §3 / §11).
    private bool _inExistingMode;

    /// <summary>Which typeahead search dimension is active. Per §11 both
    /// modes are single-step (the §10 two-step student flow was superseded):
    /// <see cref="Contact"/> searches tenants-wide by guardian name;
    /// <see cref="Student"/> searches by student name and lists that
    /// student's guardians directly. Rendered as a <c>FluentRadioGroup</c>
    /// on the far right of the typeahead input. A pick persists across a
    /// mode toggle (no reset — §11 review decision).</summary>
    private enum SearchMode { Contact, Student }
    private SearchMode _searchMode = SearchMode.Contact;





    /// <summary>The id of the existing guardian currently picked from the
    /// typeahead, or null when no pick is made yet. Set by the row click
    /// handler in Phase 5; read by the §2.1 guard in
    /// <see cref="AddInlineGuardianAsync"/> and the Add-disabled predicate
    /// (§6.3).</summary>
    private Guid? _existingGuardianId;

    /// <summary>The relationship the typeahead picked up for the chosen
    /// existing guardian, used to seed the relationship dropdown after a
    /// pick (Phase 5) and as the fallback when the sentinel is resolved
    /// (§2.1 guard). Null in by-contact mode (the user picks); set in
    /// by-student mode from <c>StudentGuardianViewDto.RelationshipCodedValueId</c>.</summary>
    private Guid? _pickedRelationshipId;

    /// <summary>The salutation title id the typeahead picked up for the
    /// chosen existing guardian, used to prefill the model on a pick
    /// (Phase 5). Null when the picked guardian has no title.</summary>
    private Guid? _pickedTitleId;



    /// <summary>Debounce CTS for the typeahead's search handler (Phase 4).
    /// Cancel-and-restart on each keystroke for the ~300 ms debounce
    /// window declared in plan §9.1. Null until Phase 4 creates it;
    /// <see cref="DisposeAsync"/> handles the null case.</summary>
    private CancellationTokenSource? _searchCts;

    /// <summary>Reference to the typeahead component, used to focus + re-open
    /// programmatically if needed (e.g. to reset the popup). Currently
    /// unused at runtime — kept for future keyboard-nav helpers.</summary>
    private FluentAutocomplete<GuardianSearchRow>? _typeahead;

    /// <summary>Equality comparer for <see cref="GuardianSearchRow"/> used by
    /// <c>FluentAutocomplete.OptionComparer</c> (§11.2). Compares by
    /// <see cref="GuardianSearchRow.Id"/> so a re-search returns fresh
    /// record instances without the component dropping the selected row.
    /// NOTE: a guardian linked to two matching students yields two rows
    /// (different relationship / match context) — both are kept; the
    /// user picks the specific (guardian, student) link.</summary>
    internal sealed class GuardianSearchRowComparer : IEqualityComparer<GuardianSearchRow>
    {
        public static readonly GuardianSearchRowComparer Instance = new();
        public bool Equals(GuardianSearchRow? x, GuardianSearchRow? y) =>
            x is null ? y is null : y is not null && x.Id == y.Id;
        public int GetHashCode(GuardianSearchRow obj) => obj.Id.GetHashCode();
    }

    /// <summary>True when the sentinel trigger is selected — Phase 3 swaps
    /// the free-text name fields for the typeahead input + radio. The
    /// getter (not the raw field) is what Phase 3's markup binds to so
    /// the sentinel-flip in Phase 2's SelectedOptionChanged handler reads
    /// cleanly.</summary>
    private bool InExistingMode => _inExistingMode;

    /// <summary>The currently selected option in the local relationship
    /// dropdown. Synced from the add-row state so the dropdown reflects
    /// <see cref="_newRelId"/> (Phase 2: set by the handler; Phase 5: also
    /// set when the typeahead prefill assigns <see cref="_pickedRelationshipId"/>).
    /// The web-component select manages DOM-level selection via its
    /// <c>SelectedOption</c> parameter; this field mirrors it for re-render
    /// consistency and round-trips.</summary>
    private RelationshipOption? _selectedRelOption;

    /// <summary>Handles the local relationship dropdown's selection change
    /// (plan §10 Phase 2). Maps the picked option back to the add-row state:
    ///   - <see cref="RelationshipOptionKind.Sentinel"/> → enter existing-
    ///     guardian mode, set <see cref="_newRelId"/> to the sentinel (the
    ///     §2.1 guard in AddInlineGuardianAsync resolves it to the picked
    ///     real relationship in Phase 5, or null until then — defensive,
    ///     prevents the sentinel leaking as a saved relationship Guid),
    ///     clear the typeahead pick state so the Add button stays disabled
    ///     until a real pick (§6.3), and reset the search results.
    ///   - <see cref="RelationshipOptionKind.Relationship"/> → real
    ///     relationship: bind the id, identical to the old CodedValueDropdown's
    ///     two-way bind — UNLESS a guardian has already been picked in existing
    ///     mode, in which case keep existing mode + the typeahead (plan §3.2
    ///     by-contact: the user picks the relationship AFTER the guardian, so
    ///     selecting a relationship must not discard the pick).
    ///   - <see cref="RelationshipOptionKind.Divider"/> → unreachable
    ///     (Disabled guarantees FluentSelect cannot pick it); guard anyway.
    ///   - <c>null</c> → user cleared the dropdown back to placeholder
    ///     (no-op on state, mirrors CodedValueDropdown's clear behaviour).</summary>
    private void OnRelationshipOptionChanged(RelationshipOption? opt)
    {
        _selectedRelOption = opt;
        switch (opt?.Kind)
        {
            case RelationshipOptionKind.Sentinel:
                _inExistingMode = true;
                _newRelId = ExistingGuardianSentinel;
                _existingGuardianId = null;
                _pickedRelationshipId = null;
                _pickedTitleId = null;
                ClearTypeaheadState();
                break;
            case RelationshipOptionKind.Relationship when opt.Id is { } relId:
                _newRelId = relId;
                if (_existingGuardianId is null)
                {
                    // Free-text new-guardian flow: exit existing mode and
                    // discard any typeahead search state (Phase 5 review
                    // Finding 1 — previously left _searchRows/
                    // _studentSearchResults/_pickedStudent/_searchCts lingering).
                    _inExistingMode = false;
                    ClearTypeaheadState();
                }
                // else: a guardian was picked in existing mode — keep the
                // typeahead visible and just swap the sentinel for this real
                // relationship (plan §3.2 by-contact path).
                break;
            case RelationshipOptionKind.Divider:
            case null:
            default:
                break;
        }
    }


    /// <summary>Resets the transient typeahead search state (plan §10
    /// Phase 5 — rolled in from the Phase-4 review's Finding 1).
    /// Cancels any in-flight debounce CTS and clears the search results /
    /// query / loading flag / picked-student step-2 state. Does NOT touch
    /// the add-row selection (_inExistingMode, _selectedRelOption,
    /// _newRelId, _existingGuardianId, _pickedRelationshipId,
    /// _pickedTitleId, _newFirstName, _newLastName) — those are add-row
    /// state that persists across navigation and is reset separately on
    /// sentinel re-select / relationship change / post-add.
    /// Called from: OnRelationshipOptionChanged (both branches), the
    /// post-add reset, and CancelPanel.</summary>
    private void ClearTypeaheadState()
    {
        // §11: cancel any in-flight typeahead search. The FluentAutocomplete
        // owns its popup Items + ValueText; we only cancel the shared search
        // CTS here. The pick (_existingGuardianId) persists until the next
        // pick or the post-add reset in AddInlineGuardianAsync.
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }

    /// <summary>Formats the per-guardian ward count cell (plan §4).
    /// Null → "—" (enrichment failure or pending). 1 → "+1 ward".
    /// n → "+N wards". Pure function; lives here so the result row
    /// markup stays a one-liner and the Phase 7 test can pin the labels
    /// without rendering the component.</summary>
    internal static string WardLabel(int? n) => n switch
    {
        null => "—",
        1 => "+1 ward",
        _ => $"+{n} wards",
    };

    // ── Typeahead search handlers (§11) ──
    // A single FluentAutocomplete owns the popup, the 300 ms debounce
    // (ImmediateDelay="300"), keyboard nav, and ARIA combobox role. These
    // handlers only supply options + resolve the pick. The handler-internal
    // CancellationTokenSource provides cancel-on-supersede (the component's
    // OptionsSearchEventArgs carries no CancellationToken). Min 2 chars
    // before any API call (§9.1). Radio toggle switches the search
    // dimension; a pick persists across the toggle (§11 review decision).









    /// <summary>The set of guardian ids already linked or drafted for this
    /// student, used as the client-side duplicate filter (§6.1). The
    /// server-side <c>excludeStudentId</c> hides already-linked guardians;
    /// this catches drafted-but-not-yet-saved guardians that the server
    /// filter can't see (create + all-inclusive edit dialogs).</summary>
    private HashSet<Guid> DraftedGuardianIds()
        => Model.GuardianLinks
            .Where(g => g.ExistingGuardianId is { })
            .Select(g => g.ExistingGuardianId!.Value)
            .ToHashSet();
    /// <summary>The single typeahead callback (plan §11.3). Switches on
    /// <see cref="_searchMode"/>: Contact → <see cref="SearchContactRowsAsync"/>
    /// (guardian-name search); Student → <see cref="SearchGuardiansByStudentNameRowsAsync"/>
    /// (student-name → their guardians, single-step, §11). Min 2 chars (§9.1).
    /// Cancellation is handler-internal (<see cref="OptionsSearchEventArgs{T}"/>
    /// carries no <see cref="System.Threading.CancellationToken"/>); the
    /// component-level debounce is <c>ImmediateDelay="300"</c>.</summary>
    private async Task OnTypeaheadSearchAsync(OptionsSearchEventArgs<GuardianSearchRow> e)
    {
        var q = (e.Text ?? string.Empty).Trim();
        if (q.Length < 2) { e.Items = []; return; }      // §9.1

        _searchCts?.Cancel(); _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;
        try
        {
            e.Items = _searchMode == SearchMode.Contact
                ? await SearchContactRowsAsync(q, ct)
                : await SearchGuardiansByStudentNameRowsAsync(q, ct);
            if (ct.IsCancellationRequested) e.Items = [];
        }
        catch (OperationCanceledException) { e.Items = []; }
    }

    /// <summary>Contact-mode search (plan §11.3). Calls
    /// <c>Api.ListGuardiansAsync(ct, search: q, excludeStudentId: StudentId)</c>
    /// so already-linked guardians are hidden server-side (§3.1 / §6.1).
    /// Relationship is null (§3.2 by-contact omits it); matched-student
    /// context is null (Contact mode). Ward counts from the client-enriched
    /// <c>GuardianDto.StudentCount</c>. Capped at 30 rows.</summary>
    private async Task<GuardianSearchRow[]> SearchContactRowsAsync(string q, CancellationToken ct)
    {
        var items = await Api.ListGuardiansAsync(ct, search: q, excludeStudentId: StudentId) ?? [];
        var linkedIds = DraftedGuardianIds();
        return items
            .Where(g => !linkedIds.Contains(g.Id))
            .Take(30)
            .Select(g => new GuardianSearchRow(
                g.Id,
                FormatGuardianName(g.TitleName, g.FirstName, g.LastName, g.DisplayName),
                RelationshipName: null,
                WardCount: g.StudentCount,
                FirstName: g.FirstName,
                LastName: g.LastName,
                TitleCodedValueId: g.TitleCodedValueId,
                RelationshipCodedValueId: null,
                MatchedStudentName: null,
                MatchedStudentNumber: null))
            .ToArray();
    }

    /// <summary>Student-mode search (plan §11.3). Single-step: type a
    /// <em>student</em> name → list <em>guardians</em> of matching students.
    /// Orchestration: <c>Api.ListStudentsAsync</c> (exclude current
    /// <see cref="StudentId"/>, §6.2) → <see cref="Task.WhenAll"/> of
    /// <c>Api.ListGuardiansByStudentAsync</c> per match (N+1, bounded by
    /// the <c>Take(10)</c> cap; §11.8) → flatten to guardian rows carrying
    /// the matched student + the link's relationship + bulk ward counts.
    /// A guardian linked to two matching students appears twice (different
    /// relationship / match context) — intended; the user picks the specific
    /// link. Capped at 30 rows.</summary>
    private async Task<GuardianSearchRow[]> SearchGuardiansByStudentNameRowsAsync(string q, CancellationToken ct)
    {
        var students = await Api.ListStudentsAsync(ct, search: q) ?? [];
        students = students
            .Where(s => StudentId is null || s.Id != StudentId.Value)
            .Take(10)   // §11.8 N+1 cap
            .ToArray();
        if (students.Length == 0) return [];

        // Parallelize the N+1 guardian loads.
        var linkArrays = await Task.WhenAll(students.Select(s => Api.ListGuardiansByStudentAsync(s.Id, ct)));
        ct.ThrowIfCancellationRequested();

        var linkedIds = DraftedGuardianIds();
        var rows = new List<GuardianSearchRow>();
        foreach (var (student, links) in students.Zip(linkArrays, (s, l) => (s, l ?? [])))
        {
            // Ensure any new relationship coded-value ids are resolved for the
            // (Relationship) label.
            var newRelIds = links
                .Where(l => l.RelationshipCodedValueId is { } rid && !_relNames.ContainsKey(rid))
                .Select(l => l.RelationshipCodedValueId!.Value)
                .Distinct();
            foreach (var rid in newRelIds)
                await EnsureRelNameAsync(rid);

            foreach (var l in links)
            {
                if (linkedIds.Contains(l.GuardianId)) continue;
                string? relName = l.RelationshipCodedValueId is { } id && _relNames.TryGetValue(id, out var rn) ? rn : null;
                rows.Add(new GuardianSearchRow(
                    l.GuardianId,
                    $"{l.FirstName} {l.LastName}".Trim(),
                    relName,
                    WardCount: null,   // filled below from bulk
                    FirstName: l.FirstName,
                    LastName: l.LastName,
                    TitleCodedValueId: l.TitleCodedValueId,
                    RelationshipCodedValueId: l.RelationshipCodedValueId,
                    MatchedStudentName: $"{student.FirstName} {student.LastName}".Trim(),
                    MatchedStudentNumber: student.StudentNumber));
            }
        }

        // Bulk-load ward counts (§11.3 last bullet). Failure non-fatal.
        if (rows.Count > 0)
        {
            try
            {
                var counts = await Api.ListStudentCountsByGuardiansAsync(rows.Select(r => r.Id).Distinct(), ct);
                var dict = counts.ToDictionary(c => c.GuardianId, c => c.Count);
                for (var i = 0; i < rows.Count; i++)
                {
                    var r = rows[i];
                    rows[i] = r with { WardCount = dict.TryGetValue(r.Id, out var c) ? c : null };
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to enrich guardian ward counts");
            }
        }
        return rows.Take(30).ToArray();
    }

    /// <summary>Selection → draft (plan §11.4). Single branch — every row is a
    /// guardian. By-student: prefill relationship + sync the relationship
    /// dropdown to the real relationship (swaps the sentinel). By-contact:
    /// leave relationship null for the user to pick (§3.2).</summary>
    private async Task OnTypeaheadSelectedAsync(GuardianSearchRow? row)
    {
        if (row is null) return;
        _existingGuardianId = row.Id;
        _newFirstName = row.FirstName;
        _newLastName = row.LastName;
        _pickedTitleId = row.TitleCodedValueId;
        if (_searchMode == SearchMode.Student && row.RelationshipCodedValueId is { } relId)
        {
            _pickedRelationshipId = relId;
            _newRelId = relId;
            _selectedRelOption = _relationshipOptions?.FirstOrDefault(
                o => o.Kind == RelationshipOptionKind.Relationship && o.Id == relId);
        }
        else
        {
            _pickedRelationshipId = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Per-option row template (plan §11.2). Two-line:
    /// line 1 = <c>FullName (Relationship) +N wards</c> (green far-right);
    /// line 2 = matched student <c>Name #Number</c> (muted, Student mode only).</summary>
    private RenderFragment<GuardianSearchRow> RowTemplate => context =>
    @<div class="guardian-search-row">
        <div class="guardian-search-primary">
            <span class="guardian-search-name">@context.FullName</span>
            @if (context.RelationshipName is { } rel)
            {
                <span class="guardian-search-rel">(@rel)</span>
            }
            <span class="guardian-search-wards">@WardLabel(context.WardCount)</span>
        </div>
        @if (context.MatchedStudentName is { } stu)
        {
            <div class="guardian-search-student">
                @stu
                @if (context.MatchedStudentNumber is { } num)
                {
                    <span class="muted"> #@num</span>
                }
            </div>
        }
    </div>;


    /// <summary>Formats a guardian's display name for the typeahead row
    /// (plan §4 "title + name via the existing salutations/_relNames").
    /// Mirrors the existing card head-line format: title + first + last,
    /// trimmed; falls back to DisplayName when title is missing; falls
    /// back to FirstLast when DisplayName is also missing.</summary>
    private static string FormatGuardianName(string? titleName, string firstName, string lastName, string? displayName)
    {
        if (!string.IsNullOrWhiteSpace(titleName))
            return $"{titleName} {firstName} {lastName}".Trim();
        if (!string.IsNullOrWhiteSpace(displayName))
            return displayName;
        return $"{firstName} {lastName}".Trim();
    }

    /// <summary>Loads RELATSHIPS coded values and prepends the sentinel +
    /// divider option. Called from <see cref="OnInitializedAsync"/> when
    /// <see cref="ShowGuardians"/> is true. Failures are non-fatal: the
    /// dropdown falls back to an empty list and the load error is logged
    /// (matches the CodedValueDropdown's own error UX — the add row is
    /// still usable for free-text entry with no relationship picked).</summary>
    private async Task BuildRelationshipOptionsAsync()
    {
        try
        {
            var items = await CodedValuesApi.GetChildrenByParentCodeAsync(
                CodedValueParent.Relationships.ToCode(), CancellationToken.None) ?? [];
            var options = new List<RelationshipOption>(items.Length + 2)
            {
                // Top of the list: the selectable "Add Existing Guardian" trigger.
                new(ExistingGuardianSentinel, "Add Existing Guardian",
                    RelationshipOptionKind.Sentinel, IsDisabled: false),
                // Non-selectable divider (Disabled guarantees FluentSelect can
                // never pick it; rendered as a 1px horizontal rule via the
                // option class, Phase 2).
                new(null, string.Empty,
                    RelationshipOptionKind.Divider, IsDisabled: true),
            };
            foreach (var cv in items)
            {
                options.Add(new(cv.Id, cv.Name,
                    RelationshipOptionKind.Relationship, IsDisabled: cv.IsDisabled));
            }
            _relationshipOptions = options.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load relationship coded values");
            _relationshipOptions = [];
        }
    }

    /// <summary>Disposes the typeahead debounce CTS (Phase 4). The CTS is
    /// null in Phase 1 (no handler yet); the null-check makes DisposeAsync
    /// safe regardless of which phase the component is torn down at.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_searchCts is { } cts)
        {
            cts.Cancel();
            cts.Dispose();
            _searchCts = null;
        }
        await ValueTask.CompletedTask;
        GC.SuppressFinalize(this);
    }
}
