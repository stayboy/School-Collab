    protected override async Task OnInitializedAsync()
    {
        // Resolve relationship display names for any pre-loaded guardians. The
        // all-inclusive edit dialog populates Model.GuardianLinks via LoadFrom
        // before this component renders (the dialog gates on its own _loaded),
        // and the Inline grid's Relationship column reads _relNames. Drafted
        // guardians (create) resolve on add via AddDraftAsync -> EnsureRelNameAsync.
        if (Model.GuardianLinks.Count == 0) return;
        _loadingGuardians = true;
        try
        {
            foreach (var g in Model.GuardianLinks)
            {
                if (g.RelationshipCodedValueId is { } relId)
                    await EnsureRelNameAsync(relId);
            }
        }
        finally
        {
            _loadingGuardians = false;
        }
    }

