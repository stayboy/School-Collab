    // ── Contact-chip formatting helpers (mirrors ContactsEditor) ────────
    private static string ChannelGlyph(ContactChannel channel) => channel switch
    {
        ContactChannel.Email => "✉",
        ContactChannel.SMS => "📱",
        ContactChannel.WhatsApp => "💬",
        _ => "•",
    };

    private static string FormatContactValue(ContactModel c) =>
        (c.Channel is ContactChannel.SMS or ContactChannel.WhatsApp
         && !string.IsNullOrWhiteSpace(c.CountryCode))
            ? $"{c.CountryCode} {c.Value}"
            : c.Value;

    private void BackToStudentSearch()
    {
        _selectedStudentId = null;
        _pickerRows = [];
    }

    // ── Search: by contact (matches guardian name OR contact value) ───────────
    private async Task OnContactSearchAsync(string? search)
    {
        _selectedRows = new();
        _contactLoading = true;
        var ct = CancellationToken.None;
        try
        {
            var guardians = (await Api.ListGuardiansAsync(ct, string.IsNullOrWhiteSpace(search) ? null : search))?.Take(30).ToArray() ?? [];
            var rows = new List<GuardianPickerRow>();
            foreach (var g in guardians)
            {
                string? contact = null;
                try
                {
                    var contacts = await Api.ListContactsAsync(ContactOwnerType.Guardian, g.Id, ct);
                    // Spec §4.9: preferred contact is the one with the
                    // lowest DisplayOrder; fall back to the first contact.
                    contact = contacts?
                        .OrderBy(c => c.DisplayOrder)
                        .FirstOrDefault()?.Value;
                }
                catch
                {
                    // Non-fatal: contact display is a nicety.
                }
                rows.Add(new GuardianPickerRow(g.Id, g.FirstName, g.LastName, null, contact));
            }
            _pickerRows = rows.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Guardian contact search failed");
            _pickerRows = [];
        }
        finally
        {
            _contactLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Search: by student → list that student's guardians ───────────────────
    private async Task OnStudentSearchAsync(string? search)
    {
        _studentLoading = true;
        var ct = CancellationToken.None;
        try
        {
            _studentResults = await Api.ListStudentsAsync(ct, string.IsNullOrWhiteSpace(search) ? null : search) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Student search failed");
            _studentResults = [];
        }
        finally
        {
            _studentLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectStudentAsync(Guid studentId)
    {
        _selectedStudentId = studentId;
        _selectedRows = new();
        _studentLoading = true;
        var ct = CancellationToken.None;
        try
        {
            var links = await Api.ListGuardiansByStudentAsync(studentId, ct) ?? [];
            var rows = new List<GuardianPickerRow>();
            foreach (var l in links)
            {
                if (l.RelationshipCodedValueId is { } relId)
                    await EnsureRelNameAsync(relId);
                rows.Add(new GuardianPickerRow(l.GuardianId, l.FirstName, l.LastName, l.RelationshipCodedValueId, null));
            }
            _pickerRows = rows.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load the student's guardians");
            _pickerRows = [];
        }
        finally
        {
            _studentLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Add handlers ─────────────────────────────────────────────────────────
    /// <summary>Add a guardian drafted in the inline add row directly to the
    /// student's guardian links (no panel switch — the card list re-renders with
    /// the new card). Captures only Relationship / Last name / First name (the
    /// add-row field set); role defaults to Primary and the guardian starts with
    /// no contacts / title. After a successful add the row fields clear so the
    /// next entry starts fresh. Mirrors the ContactsEditor's add-contact
    /// behaviour (inline form + Add, fields cleared on add).</summary>
    private async Task AddInlineGuardianAsync()
    {
        if (string.IsNullOrWhiteSpace(_newFirstName) || string.IsNullOrWhiteSpace(_newLastName))
        {
            _guardianError = "First and last name are required.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        _guardianError = null;
        _adding = true;
        try
        {
            var assignment = new GuardianAssignment(
                null,
                _newFirstName!.Trim(),
                _newLastName!.Trim(),
                _newRelId,
                ContactChannel: null,
                ContactValue: null,
                TitleCodedValueId: null,
                CountryCode: null);
            await AddDraftAsync(assignment);
            // Clear the add row for the next entry.
            _newFirstName = null;
            _newLastName = null;
            _newRelId = null;
            // Switch to Edit view so the user can add more fields (title, role,
            // contacts) before the card is finalized. The newly-added guardian
            // is the last entry in GuardianLinks.
            _editingIndex = Model.GuardianLinks.Count - 1;
            if (_editingIndex >= 0 && _editingIndex < Model.GuardianLinks.Count)
            {
                var a = Model.GuardianLinks[_editingIndex];
                _editTitleId = a.TitleCodedValueId;
                _editFirstName = a.FirstName;
                _editLastName = a.LastName;
                _editRelationshipId = a.RelationshipCodedValueId;
                _editRole = a.Role;
                _editContacts = (a.Contacts ?? []).ToList();
                if (_editRelationshipId is { } relId)
                    await EnsureRelNameAsync(relId);
                _panelMode = GuardianPanelMode.Edit;
            }
            else
            {
                _panelMode = GuardianPanelMode.List;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add new guardian inline");
            _guardianError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _adding = false;
        }
    }

    /// <summary>Re-render callback for the Buffered-mode ContactsEditor in
    /// the Edit panel. The editor mutates <see cref="_editContacts"/> in
    /// place; this just triggers a state change so the UI reflects the
    /// mutation (e.g. the list re-renders).</summary>
    private Task OnEditContactsChanged() => InvokeAsync(StateHasChanged);

    private async Task AddSelectedGuardiansAsync()
    {
        _guardianError = null;
        try
        {
            foreach (var row in _selectedRows.Values)
            {
                var assignment = new GuardianAssignment(row.Id, row.FirstName, row.LastName, row.RelationshipCodedValueId, null, null, null);
                await AddDraftAsync(assignment);
            }
            _panelMode = GuardianPanelMode.List;
            _pickerRows = [];
            _selectedRows = new();
            _studentResults = [];
            _selectedStudentId = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add selected guardians");
            _guardianError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Appends a guardian draft to the model (create + all-inclusive edit
    /// dialog both draft; the parent flushes the whole set on save).</summary>
    private async Task AddDraftAsync(GuardianAssignment assignment)
    {
        if (assignment.ExistingGuardianId is { } id && Model.GuardianLinks.Any(g => g.ExistingGuardianId == id))
            return;
        Model.GuardianLinks.Add(assignment);
        if (assignment.RelationshipCodedValueId is { } relId)
            await EnsureRelNameAsync(relId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveGuardianAsync(int index)
    {
        if (index < 0 || index >= Model.GuardianLinks.Count) return;
        Model.GuardianLinks.RemoveAt(index);
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureRelNameAsync(Guid relId)
    {
        if (_relNames.ContainsKey(relId)) return;
        try
        {
            var cv = await CodedValuesApi.GetByIdAsync(relId, CancellationToken.None);
            if (cv is not null) _relNames[cv.Id] = cv.Name;
        }
        catch
        {
            // Non-fatal: the relationship name is only a display nicety.
        }
    }

    // ── Contacts (create-mode Buffered editor) ────────────────────────────────
    // The Buffered ContactsEditor mutates Model.Contacts in place and raises
    // ContactsChanged after every mutation. We re-render so the count / list
    // stays in sync; the parent flushes the list on save.
    private async Task OnDraftContactsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }
}
