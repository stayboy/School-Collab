@* Shared student form fields. Renders the standard "create / edit student"
    field set used by:
      - /students/create  (Create.razor)
      - /students/{id}/edit (Edit.razor)
      - the inline "new student" form inside the GradeLevelWizard step 2

    The component owns the <EditForm>, the <DataAnnotationsValidator />, the
    field rows, AND the action row (Submit / Cancel buttons). Parents supply:
      - the model (bound to <EditForm Model>)
      - the OnValidSubmit handler
      - the action buttons via parameters (SubmitLabel, Submitting,
        SubmittingLabel, ShowCancel, CancelLabel, OnCancel). The action row
        is rendered by the component itself — calling pages do NOT need to
        pass an external <Actions> block for the common case.
      - the horizontal alignment of those buttons via ActionsAlignment
        (Left = default, Right = trailing edge)
      - any visible error message via ErrorMessage

    Advanced: a calling page may still override the entire action row by
    supplying an <Actions> RenderFragment (e.g. a dialog that needs its own
    footer component such as DialogShellFooter). When present, the override
    replaces the built-in buttons.

    Each field row uses the canonical <FormRow> primitive from
    SchoolCollab.Admin.Shared — the repo-wide fixed-width (180px) label
    cell + flexible input cell pattern that guarantees all labels are
    equal-width and every input's left edge lands on the same vertical
    axis. See FormRow.razor for the full pattern.

    The Guardians section is NOT owned by this component — it lives in the
    extracted <GuardianSection> component, hosted inside the "Guardians"
    <FormRow> below. This form keeps the ShowGuardians gate and the
    pass-through parameters (Mode / StudentId / LinkedItems /
    OnManageGuardians / OnRemoveGuardian) and forwards them to
    GuardianSection, which owns the whole guardian state machine.

    A CSS border-top on .form-actions draws the horizontal line that
    separates the field block from the action buttons below (matches
    the established PeriodForm pattern).

    Field types match the server contract directly:
      - DateOfBirth: DateOnly?  (bound to a FluentDatePicker via a
        DateTime? bridge — the picker API only takes DateTime?)
      - GenderCodedValueId: Guid?  (bound to a CodedValueDropdown for
        the GENDER parent)
*@
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Students.Core.DTOs
@using SchoolCollab.Students.Core.Domain

<EditForm Model="@Model" OnValidSubmit="@OnValidSubmit" @ref="_editForm" class="@FormClass">
    <DataAnnotationsValidator />

    @* The parent vertical stack controls the row rhythm. Spacing="3" gives
       a comfortable 12px gap between rows. Profile FormRows are wrapped in
       divs so the section-edit UX can dim them as a block without breaking
       the FluentStack spacing. The Contacts / Guardians sections are also
       wrapped in divs so the focused section-edit UX can hide the sibling
       section and restyle the active section via CSS while keeping the same
       component instance mounted. *@
    <FluentStack Orientation="Orientation.Vertical" Spacing="3">
        <div class="@ProfileRowClass">
            @* Student number. ReadOnly when editing an existing student (the
               student number is the stable identifier the rest of the app
               keys off; it can't be changed after creation). *@
            <FormRow Label="Student number"
                     Required="@(!ReadOnlyStudentNumber)"
                     For="studentFormNumber">
                <FluentTextField Id="studentFormNumber"
                                 @bind-Value="Model.StudentNumber"
                                 ReadOnly="@ReadOnlyStudentNumber"
                                 Required="@(!ReadOnlyStudentNumber)"
                                 Disabled="@AreProfileFieldsDisabled"
                                 Placeholder="e.g. S-2026-001"
                                 class="w-5" />
            </FormRow>
        </div>

        <div class="@ProfileRowClass">
            @* Name. First + last sit side-by-side inside the input cell. *@
            <FormRow Label="Name"
                     Required
                     For="studentFormFirstName">
                <FluentTextField Id="studentFormFirstName"
                                 @bind-Value="Model.FirstName"
                                 Required
                                 Disabled="@AreProfileFieldsDisabled"
                                 Placeholder="First name"
                                 class="w-9" />
                <FluentTextField @bind-Value="Model.LastName"
                                 Required
                                 Disabled="@AreProfileFieldsDisabled"
                                 Placeholder="Last name"
                                 class="w-9" />
            </FormRow>
        </div>

        <div class="@ProfileRowClass">
            @* Title. Optional salutation (SALUTS parent) — shared demographic field.
               Simple two-way binding into the model. *@
            <FormRow Label="Title">
                <CodedValueDropdown Parent="CodedValueParent.Salutations"
                                    @bind-SelectedId="Model.TitleCodedValueId"
                                    Disabled="@AreProfileFieldsDisabled"
                                    Placeholder="Select title"
                                    Width="FieldWidth.W4" />
            </FormRow>
        </div>

        <div class="@ProfileRowClass">
            @* Date of birth + Gender. Side-by-side in one row (mirrors the
               First/Last name row above) so the profile block takes less vertical
               space and the Contacts + Guardians sections below have room to grow.
               DOB is a FluentDatePicker (binds to DateTime? via a bridge); Gender
               is a required CodedValueDropdown. Both are required — the single
               row asterisk marks the row as having required fields. *@
            <FormRow Label="DOB/Gender"
                     Required
                     For="studentFormDob">
                <FluentDatePicker Id="studentFormDob"
                                  Value="@DateOfBirthAsDateTime"
                                  ValueChanged="@OnDateOfBirthChanged"
                                  Required
                                  Disabled="@AreProfileFieldsDisabled"
                                  class="w-3" />
                <CodedValueDropdown Parent="CodedValueParent.Genders"
                                    @bind-SelectedId="Model.GenderCodedValueId"
                                    Disabled="@AreProfileFieldsDisabled"
                                    Placeholder="Select gender"
                                    Width="FieldWidth.W4" />
            </FormRow>
        </div>

        @* Contacts + Guardians sections. When <see cref="EnableSectionEdit"/>
           is true the form uses the focused section-edit UX: when a child
           component starts editing, it raises IsEditingChanged(true). The
           parent then hides the OTHER section via CSS, dims the profile
           block, disables the dialog action row, and restyles the active
           section as a dedicated edit-view section ("Update contact" /
           "Update guardian"). The same component instance stays mounted,
           so its inline-edit state is preserved. When <see cref="EnableSectionEdit"/>
           is false (default) the sections render side-by-side exactly as before.
           The section switch uses CSS on a wrapper div so the same component
           instances are preserved and the FormRow label is hidden in active state. *@
        @if (ShowContacts)
        {
            <div class="@SectionRowClass(StudentEditSection.Contacts)">
                <FluentDivider class="student-form-fields__section-divider" Orientation="Orientation.Horizontal" Style="width:100%" />
                @if (ActiveEditSection == StudentEditSection.Contacts)
                {
                    <h4 class="student-form-fields__edit-title">Update contact</h4>
                }
                <FormRow Label="Contacts">
                    <div class="student-contacts">
                        <ContactsEditor Mode="ContactsEditor.EditorMode.Buffered"
                                        OwnerType="ContactOwnerType.Student"
                                        Contacts="Model.Contacts"
                                        ContactsChanged="OnDraftContactsChanged"
                                        IsEditingChanged="OnContactsEditingChanged" />
                    </div>
                </FormRow>
            </div>
        }
        @if (ShowGuardians)
        {
            <div class="@SectionRowClass(StudentEditSection.Guardians)">
                <FluentDivider class="student-form-fields__section-divider" Orientation="Orientation.Horizontal" Style="width:100%" />
                @if (ActiveEditSection == StudentEditSection.Guardians)
                {
                    <h4 class="student-form-fields__edit-title">Update guardian</h4>
                }
                <FormRow Label="Guardians">
                    <div class="student-guardians-wrap">
                        <GuardianSection GuardianLinks="Model.GuardianLinks"
                                         Mode="Mode"
                                         StudentId="StudentId"
                                         LinkedItems="LinkedItems"
                                         OnManageGuardians="OnManageGuardians"
                                         OnRemoveGuardian="OnRemoveGuardian"
                                         IsEditingChanged="OnGuardiansEditingChanged" />
                    </div>
                </FormRow>
            </div>
        }
    </FluentStack>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="student-form-error">@ErrorMessage</FluentMessageBar>
    }

    @* Action row. The .form-actions CSS class draws the horizontal line
       (border-top) that separates the field block above from the action
       buttons below, and adds comfortable margin/padding so the line
       breathes. The action buttons are rendered by THIS component (not by
       the calling page): a built-in Submit / Cancel pair driven by the
       SubmitLabel / CancelLabel / OnCancel / Submitting / ShowCancel
       parameters. The ActionsAlignment parameter controls whether the
       buttons hug the left edge (default) or the right / trailing edge
       (via the .form-actions--right modifier). A calling page may still
       override the whole row via the optional <Actions> RenderFragment
       (e.g. a dialog that supplies its own DialogShellFooter), or
       suppress the built-in row entirely via RenderActions="false" and
       drive validation+submit externally via @ref.SubmitAsync() (used
       by the long-form /students/{id}/edit page where the buttons sit
       in a page-level right-column stack alongside the Direct contact
       editor). *@
    @if (RenderActions)
    {
        <div class="form-actions @FormActionsClass">
            @if (Actions is not null)
            {
                @Actions
            }
            else
            {
                @* The FluentStack renders at width:100% with justify-content
                   start, so the OUTER .form-actions--right flex-end has no
                   effect (the stack already fills the row). To actually right-
                   align the buttons, set HorizontalAlignment=End on the stack
                   itself when ActionsAlignment is Right. *@
                <FluentStack Orientation="Orientation.Horizontal" Spacing="8"
                             HorizontalAlignment="@(ActionsAlignment == StudentFormActionsAlignment.Right ? HorizontalAlignment.End : HorizontalAlignment.Start)">
                    @if (ShowCancel)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@OnCancel"
                                      Disabled="@(Submitting || AreProfileFieldsDisabled)"
                                      class="form-actions__button">
                            @CancelLabel
                        </FluentButton>
                    }
                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="Appearance.Accent"
                                  Disabled="@(Submitting || AreProfileFieldsDisabled)"
                                  class="form-actions__button">
                        @(Submitting ? SubmittingLabel : SubmitLabel)
                    </FluentButton>
                </FluentStack>
            }
        </div>
    }
</EditForm>

@code {
    /// <summary>The class attribute on the rendered <c>.form-actions</c>
    /// div. Composed from the static <c>form-actions</c> base plus the
    /// optional <c>form-actions--right</c> (horizontal alignment)
    /// modifier. Computed in C# rather than inlined in the attribute
    /// value because the EditForm component's tag-helper parser doesn't
    /// tolerate the <c>class="... @(cond ? ... : null)"</c> pattern.</summary>
    private string FormActionsClass => ActionsAlignment == StudentFormActionsAlignment.Right
        ? "form-actions form-actions--right"
        : "form-actions";

    /// <summary>The class attribute on the rendered <c>EditForm</c>. The
    /// base <c>student-form-fields</c> caps the form at 600px (compact
    /// page forms). The <c>student-form-fields--wide</c> modifier removes
    /// that cap so the form fills a wide dialog (used by the create/edit
    /// dialogs, which host the guardians section + contacts editor and need
    /// the full dialog width). The <c>student-form-fields--section-editing</c>
    /// modifier is added while a section edit is active so the form can dim
    /// the profile block and highlight the active edit-view section.</summary>
    private string FormClass
    {
        get
        {
            var cls = Wide ? "student-form-fields student-form-fields--wide" : "student-form-fields";
            if (EnableSectionEdit && ActiveEditSection != StudentEditSection.None)
                cls += " student-form-fields--section-editing";
            return cls;
        }
    }

    /// <summary>When true, removes the 600px max-width cap so the form
    /// fills the full dialog width. Used by the create/edit dialogs, which
    /// host the guardians section + contacts editor and need the extra room.
    /// Page forms (Create.razor / Edit.razor / the wizard inline form) keep
    /// the default compact width.</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>The form model. Required — the EditForm binds to it.</summary>
    [Parameter, EditorRequired] public StudentFormModel Model { get; set; } = default!;

    /// <summary>Submit handler. Fires only when DataAnnotations validation passes.</summary>
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }

    /// <summary>Action buttons (Submit, Cancel) rendered in the bottom row.
    /// Optional. When supplied, it REPLACES the built-in button row (use this
    /// for special cases such as a dialog that needs its own footer component
    /// like <c>DialogShellFooter</c>). When omitted, the component renders its
    /// own Submit / Cancel buttons driven by the parameters below.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Label on the built-in Submit button. Default: "Save".</summary>
    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>Label shown on the built-in Submit button while <see cref="Submitting"/> is true. Default: "Saving…".</summary>
    [Parameter] public string SubmittingLabel { get; set; } = "Saving…";

    /// <summary>When true, disables the built-in buttons and shows <see cref="SubmittingLabel"/> on Submit. Use to reflect an in-flight save.</summary>
    [Parameter] public bool Submitting { get; set; }

    /// <summary>Whether the built-in Cancel button is shown. Default: true.</summary>
    [Parameter] public bool ShowCancel { get; set; } = true;

    /// <summary>Label on the built-in Cancel button. Default: "Cancel".</summary>
    [Parameter] public string CancelLabel { get; set; } = "Cancel";

    /// <summary>Invoked when the built-in Cancel button is clicked. Optional.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Horizontal alignment of the action buttons. Defaults to
    /// <see cref="StudentFormActionsAlignment.Right"/> so the buttons sit
    /// at the trailing edge of the form (matches the dialog footer);
    /// set to <see cref="StudentFormActionsAlignment.Left"/> to keep them
    /// at the leading edge.</summary>
    [Parameter] public StudentFormActionsAlignment ActionsAlignment { get; set; } = StudentFormActionsAlignment.Right;

    /// <summary>Horizontal alignment of the action buttons.</summary>
    public enum StudentFormActionsAlignment { Left, Right }

    /// <summary>Whether the built-in bottom-horizontal action row is
    /// rendered. Default <c>true</c> — the form renders its own Submit
    /// and Cancel pair below the fields, separated by a border-top, which
    /// matches the established dialog-ui pattern (e.g. the inline
    /// GradeLevelWizard "new student" form, the StudentPickerDialog
    /// "create" view, and /students/create). Set to <c>false</c> on
    /// long forms (e.g. /students/{id}/edit) where the page hosts the
    /// action buttons in a right-column page-level sidebar that also
    /// spans the Direct contact editor below the form. The caller
    /// captures the form via <c>@ref</c> and drives validation+submit
    /// through <see cref="SubmitAsync"/>, which mimics the EditForm's
    /// private HandleSubmitAsync: validates, then fires
    /// <see cref="OnValidSubmit"/> on success.</summary>
    [Parameter] public bool RenderActions { get; set; } = true;

    /// <summary>Validate the form and fire <see cref="OnValidSubmit"/>
    /// when valid. Mirrors the standard Blazor pattern for triggering
    /// an EditForm submit from a button that sits OUTSIDE the form
    /// (e.g. a sidebar action stack). Returns <c>true</c> when the
    /// validation passed and the submit handler ran; <c>false</c>
    /// when validation failed (DataAnnotations errors are shown next
    /// to the offending fields and the submit handler is NOT called).
    /// Idempotent under repeated calls while a submit is in flight
    /// (the guard <c>if (Submitting) return false</c> prevents
    /// double-submit when the caller also disables the button).</summary>
    public async Task<bool> SubmitAsync()
    {
        if (Submitting) return false;
        var ctx = _editForm?.EditContext;
        if (ctx is null) return false;
        if (!ctx.Validate()) return false;
        await OnValidSubmit.InvokeAsync();
        return true;
    }

    private EditForm? _editForm;

    /// <summary>When true, the student number field is read-only (used by Edit.razor).</summary>
    [Parameter] public bool ReadOnlyStudentNumber { get; set; }

    /// <summary>Error message to surface above the action row. Optional.</summary>
    [Parameter] public string? ErrorMessage { get; set; }

    // ── Focused section-edit UX ──────────────────────────────────────────────
    // When EnableSectionEdit is true the form uses the focused section-edit
    // UX: the child components (ContactsEditor / GuardianSection) raise their
    // existing edit/remove affordances and report editing-state changes back
    // to this form via IsEditingChanged. While a section reports that it is
    // editing, the OTHER section is hidden, the profile fields are disabled,
    // and the dialog action row is disabled. The section's own Cancel/Save
    // buttons remain usable. Opt-in so existing callers (Create.razor,
    // Edit.razor, the wizard) keep the always-editable form.

    /// <summary>Which section of the student form is in focused edit mode.</summary>
    public enum StudentEditSection { None, Contacts, Guardians }

    /// <summary>When true, the form uses the focused section-edit UX described
    /// above. Default false — existing callers render the always-editable form.</summary>
    [Parameter] public bool EnableSectionEdit { get; set; }

    /// <summary>Which section, if any, is in focused edit mode. Only meaningful
    /// when <see cref="EnableSectionEdit"/> is true. The parent owns this state
    /// and binds it two-way via <see cref="ActiveEditSectionChanged"/>.</summary>
    [Parameter] public StudentEditSection ActiveEditSection { get; set; } = StudentEditSection.None;

    /// <summary>Two-way binding callback for <see cref="ActiveEditSection"/>.
    /// Fired when a child section starts or stops editing so the parent can
    /// switch the form in and out of the focused section-edit UX.</summary>
    [Parameter] public EventCallback<StudentEditSection> ActiveEditSectionChanged { get; set; }

    /// <summary>True while a section edit is active — disables the profile fields
    /// and the dialog action row.</summary>
    private bool AreProfileFieldsDisabled => EnableSectionEdit && ActiveEditSection != StudentEditSection.None;

    /// <summary>Class applied to every profile FormRow. Adds a disabled modifier
    /// while a section edit is active so the row dims and ignores pointer events.</summary>
    private string ProfileRowClass => AreProfileFieldsDisabled
        ? "student-form-fields__profile-row student-form-fields__profile-row--disabled"
        : "student-form-fields__profile-row";

    /// <summary>Class applied to the Contacts / Guardians FormRows. When the row's
    /// section is active the label cell is hidden and the input cell fills the row
    /// so the section reads as a dedicated edit-view. When the OTHER section is
    /// active this row is hidden entirely. Only applies when EnableSectionEdit is
    /// true; existing callers keep the normal side-by-side display.</summary>
    private string SectionRowClass(StudentEditSection section)
    {
        var cls = "student-form-fields__section-row";
        if (!EnableSectionEdit || ActiveEditSection == StudentEditSection.None)
            return cls;
        if (ActiveEditSection == section)
            cls += " student-form-fields__section-row--active";
        else
            cls += " student-form-fields__section-row--hidden";
        return cls;
    }

    private async Task OnContactsEditingChanged(bool isEditing)
        => await ActiveEditSectionChanged.InvokeAsync(isEditing ? StudentEditSection.Contacts : StudentEditSection.None);

    private async Task OnGuardiansEditingChanged(bool isEditing)
        => await ActiveEditSectionChanged.InvokeAsync(isEditing ? StudentEditSection.Guardians : StudentEditSection.None);

    // ── DOB bridge: Model.DateOfBirth is DateOnly? but
    //    FluentDatePicker.Value is DateTime?. Convert on the way in
    //    and out so the model keeps the server's contract type. *@

    private DateTime? DateOfBirthAsDateTime => Model.DateOfBirth?.ToDateTime(TimeOnly.MinValue);

    private async Task OnDateOfBirthChanged(DateTime? value)
    {
        Model.DateOfBirth = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
        await Task.CompletedTask;
    }

    // ── Guardians pass-through parameters ──
    // The guardian section is owned by the extracted <GuardianSection>
    // component (hosted in the "Guardians" FormRow above). These parameters
    // are kept on this form so callers keep the same surface, and are
    // forwarded to GuardianSection. The form no longer owns any guardian
    // state, API calls, or CSS.

    /// <summary>When true, renders the guardian section (hosted inside a
    /// "Guardians" <see cref="FormRow"/>). Opt-in so the shared form can be
    /// embedded where guardians are managed elsewhere (e.g. the
    /// GradeLevelWizard inline edit form). Enabled by /students/create and
    /// /students/{id}/edit. Forwarded to <see cref="GuardianSection"/>.</summary>
    [Parameter] public bool ShowGuardians { get; set; }

    /// <summary>The id of the student being edited, or <c>null</c> when the
    /// form is creating a new student (no server-linked guardians to exclude).
    /// Forwarded to <see cref="GuardianSection"/> for the "add existing
    /// guardian" typeahead's <c>excludeStudentId</c>.</summary>
    [Parameter] public Guid? StudentId { get; set; }

    /// <summary>When true, renders the contacts section (the shared
    /// <see cref="ContactsEditor"/>). Opt-in so the shared form can be embedded
    /// where contacts are managed elsewhere. The editor runs Buffered,
    /// collecting into <see cref="StudentFormModel.Contacts"/> for the parent
    /// to flush atomically. Enabled by the create/edit dialogs.</summary>
    [Parameter] public bool ShowContacts { get; set; }

    /// <summary>How the guardians section is rendered — <see cref="StudentFormFieldsMode.Inline"/>
    /// (default) or <see cref="StudentFormFieldsMode.Linked"/>. Forwarded to
    /// <see cref="GuardianSection"/>.</summary>
    [Parameter] public StudentFormFieldsMode Mode { get; set; } = StudentFormFieldsMode.Inline;

    /// <summary>Linked-mode only: the current links for the student, as
    /// projected by <c>GET /students/{id}/guardians</c>. Forwarded to
    /// <see cref="GuardianSection"/>.</summary>
    [Parameter] public StudentGuardianViewDto[]? LinkedItems { get; set; }

    /// <summary>Linked-mode only: fires when the user clicks the "Manage"
    /// button. Forwarded to <see cref="GuardianSection"/>.</summary>
    [Parameter] public EventCallback OnManageGuardians { get; set; }

    /// <summary>Linked-mode only: fires when the user clicks the per-row
    /// Remove button. Forwarded to <see cref="GuardianSection"/>.</summary>
    [Parameter] public EventCallback<StudentGuardianViewDto> OnRemoveGuardian { get; set; }

    // ── Contacts (create-mode Buffered editor) ────────────────────────────────
    // The Buffered ContactsEditor mutates Model.Contacts in place and raises
    // ContactsChanged after every mutation. We re-render so the count / list
    // stays in sync; the parent flushes the list on save.
    private async Task OnDraftContactsChanged()
    {
        await InvokeAsync(StateHasChanged);
    }
}
