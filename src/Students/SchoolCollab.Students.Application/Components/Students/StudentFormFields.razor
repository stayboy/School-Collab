    // emergency-contact flag is also not surfaced (see the Edit panel
    // comment). Editing relationship + role is the always-persisting
    // surface (UpdateStudentWithLinkedDataHandler → link.Update(...)).
    private int _editingIndex = -1;
    private Guid? _editRelationshipId;
    private GuardianRole _editRole = GuardianRole.Primary;
