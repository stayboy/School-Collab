    /// <summary>Open the inline Edit panel for the guardian at
    /// <paramref name="index"/> in <see cref="StudentFormModel.GuardianLinks"/>.
    /// Loads the link's current relationship / role into the edit fields.
    /// The guardian's name + title are not surfaced here — see the Edit
    /// panel comment for why.</summary>
    private async Task StartEditGuardian(int index)
    {
        if (index < 0 || index >= Model.GuardianLinks.Count) return;
        var a = Model.GuardianLinks[index];
        _editingIndex = index;
        _editRelationshipId = a.RelationshipCodedValueId;
        _editRole = a.Role;
        _editTitleId = a.TitleCodedValueId;
        _editFirstName = a.FirstName;
        _editLastName = a.LastName;
        _editContacts = (a.Contacts ?? []).ToList();
        if (_editRelationshipId is { } relId)
            await EnsureRelNameAsync(relId);
        _panelMode = GuardianPanelMode.Edit;
        await InvokeAsync(StateHasChanged);
