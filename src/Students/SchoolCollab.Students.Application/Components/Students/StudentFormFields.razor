@*
    Shared student form fields. Renders the standard "create / edit student"
    field set used by:
      - /students/create  (Create.razor)
      - /students/{id}/edit (Edit.razor)
      - the inline "new student" form inside the GradeLevelWizard step 2

    The component owns the <EditForm>, the <DataAnnotationsValidator />, the
    field rows, AND the action row (Submit / Cancel buttons). Parents supply:
      - the model (bound to <EditForm Model>)
      - the OnValidSubmit handler
      - the action buttons via parameters (SubmitLabel, Submitting,
        SubmittingLabel, ShowCancel, CancelLabel, OnCancel). The action row
        is rendered by the component itself — calling pages do NOT need to
        pass an external <Actions> block for the common case.
      - the horizontal alignment of those buttons via ActionsAlignment
        (Left = default, Right = trailing edge)
      - any visible error message via ErrorMessage

    Advanced: a calling page may still override the entire action row by
    supplying an <Actions> RenderFragment (e.g. a dialog that needs its own
    footer component such as DialogShellFooter). When present, the override
    replaces the built-in buttons.

    Each field row uses the canonical <FormRow> primitive from
    SchoolCollab.Admin.Shared — the repo-wide fixed-width (180px) label
    cell + flexible input cell pattern that guarantees all labels are
    equal-width and every input's left edge lands on the same vertical
    axis. See FormRow.razor for the full pattern.

    A CSS border-top on .form-actions draws the horizontal line that
    separates the field block from the action buttons below (matches
    the established PeriodForm pattern).

    Field types match the server contract directly:
      - DateOfBirth: DateOnly?  (bound to a FluentDatePicker via a
        DateTime? bridge — the picker API only takes DateTime?)
      - GenderCodedValueId: Guid?  (bound to a CodedValueDropdown for
        the GENDER parent)
*@
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Students.Core.DTOs
@using SchoolCollab.Students.Core.Domain
@using StudentDto = SchoolCollab.Students.Application.Services.StudentDto

@implements IAsyncDisposable

<EditForm Model="@Model" OnValidSubmit="@OnValidSubmit" @ref="_editForm" class="@FormClass">
    <DataAnnotationsValidator />

    @* The parent vertical stack controls the row rhythm. Spacing="3" gives
       a comfortable 12px gap between rows — modern forms have generous
       breathing room rather than tight packing. *@
    <FluentStack Orientation="Orientation.Vertical" Spacing="3">
        @* Student number. ReadOnly when editing an existing student (the
           student number is the stable identifier the rest of the app
           keys off; it can't be changed after creation). *@
        <FormRow Label="Student number"
                 Required="@(!ReadOnlyStudentNumber)"
                 For="studentFormNumber">
            <FluentTextField Id="studentFormNumber"
                             @bind-Value="Model.StudentNumber"
                             ReadOnly="@ReadOnlyStudentNumber"
                             Required="@(!ReadOnlyStudentNumber)"
                             Placeholder="e.g. S-2026-001"
                             class="w-5" />
        </FormRow>

        @* Name. First + last sit side-by-side inside the input cell. *@
        <FormRow Label="Name" Required For="studentFormFirstName">
            <FluentTextField Id="studentFormFirstName"
                             @bind-Value="Model.FirstName"
                             Required
                             Placeholder="First name"
                             class="w-9" />
            <FluentTextField @bind-Value="Model.LastName"
                             Required
                             Placeholder="Last name"
                             class="w-9" />
        </FormRow>

        @* Title. Optional salutation (SALUTS parent) — shared demographic field.
           Simple two-way binding into the model. *@
        <FormRow Label="Title">
            <CodedValueDropdown Parent="CodedValueParent.Salutations"
                                @bind-SelectedId="Model.TitleCodedValueId"
                                Placeholder="Select title"
                                Width="FieldWidth.W4" />
        </FormRow>

        @* Date of birth. FluentDatePicker binds to DateTime?, so we
           convert from the model's DateOnly? on the way in and back on
           the way out. Narrow input (160px) — a date picker doesn't
           need more room than that. Required (spec: DOB mandatory). *@
        <FormRow Label="Date of birth" Required For="studentFormDob">
            <FluentDatePicker Id="studentFormDob"
                              Value="@DateOfBirthAsDateTime"
                              ValueChanged="@OnDateOfBirthChanged"
                              Required
                              class="w-3" />
        </FormRow>

        @* Gender. Required coded-value dropdown for the GENDER parent
           (spec: gender mandatory). Simple two-way binding — the binder
           updates Model.GenderCodedValueId directly; no callback boilerplate
           needed (the previous OnGenderChanged did nothing but mirror
           the new value into the model). *@
        <FormRow Label="Gender" Required>
            <CodedValueDropdown Parent="CodedValueParent.Genders"
                                @bind-SelectedId="Model.GenderCodedValueId"
                                Placeholder="Select gender"
                                Width="FieldWidth.W4" />
        </FormRow>

        @* Contacts section. Sits between the profile fields and the guardians
           section so the student's own contact channels are captured first.
           The editor is the shared <ContactsEditor> in Buffered mode,
           collecting into Model.Contacts. The parent flushes the list to the
           API as part of the atomic create/update. *@
        @if (ShowContacts)
        {
            <div class="">
                <FluentDivider Orientation="Orientation.Horizontal" Style="width:100%" />
            </div>
            <FormRow Label="Contacts">
                <div class="student-contacts">
                    <ContactsEditor Mode="ContactsEditor.EditorMode.Buffered"
                                    OwnerType="ContactOwnerType.Student"
                                    Contacts="Model.Contacts"
                                    ContactsChanged="OnDraftContactsChanged" />
                </div>
            </FormRow>
        }

        @* Guardians section. Two modes (gated by the Mode parameter):

           - Inline (DEFAULT): the historical panel-switch UX. Create
             mode keeps a draft list on the model that the parent links
             after the student is saved; edit mode loads the links from
             the API and links / unlinks immediately. Adding a guardian
             is an INLINE section switch (no nested dialog): "New
             guardian" reveals the shared GuardianFormFields component;
             "Add existing" uses the shared EntityGrid to search by
             contact or by student and select guardians. The
             linked/draft list is also rendered with EntityGrid.

             This is the right UX inside DIALOGS — the user is already
             modal inside a wizard / picker flow, an in-place panel
             keeps them oriented, and nested dialogs (a dialog opening
             a dialog) is the anti-pattern the dialog-ui skill
             explicitly warns against. The wizard's inline "new
             student" form, the StudentPickerDialog's create flow, and
             any future dialog that embeds StudentFormFields stay on
             this mode.

           - Linked: the page-side compact section. Used by
             /students/{id}/edit (and any future page that owns its own
             Save flow + DialogService). Instead of the panel switch,
             renders a "Guardians (N) — Manage" header with a button
             that fires OnManageGuardians. The parent page opens
             GuardianPickerDialog on click, calls the link APIs on
             confirm, and reloads. The per-row delete button fires
             OnRemoveGuardian — the page calls UnlinkGuardianAsync +
             reload. No inline create, no nested dialog, no per-form
             EditForm (the owning page EditForm wraps this whole
             component). *@
        @if (ShowGuardians)
        {
            <div class="">
                <FluentDivider Orientation="Orientation.Horizontal" Style="width:100%" />
            </div>
            <FormRow Label="Guardians">
                @* Single container div for both modes (page-side and
                   dialog-side). The Linked modifier (`.student-form-guardians--linked`)
                   re-styles it as a compact "Manage" + read-only grid
                   for the page-side caller; the default styling
                   (`.student-guardians`) is the historical dialog
                   panel-switch layout. Wrapping both in a single
                   `<div class="student-guardians">` avoids the
                   if/else that would otherwise need a paired open /
                   close and is easier to reason about. *@
                <div class="student-guardians @(Mode == StudentFormFieldsMode.Linked ? "student-form-guardians--linked" : null)">
                    @if (Mode == StudentFormFieldsMode.Linked)
                    {
                        <div class="student-guardians-linked-header">
                            <span class="student-guardians-linked-count">
                                <strong>@GuardianCount</strong> @(GuardianCount == 1 ? "guardian" : "guardians")
                            </span>
                            <FluentButton Appearance="Appearance.Accent"
                                          Size="ButtonSize.Small"
                                          IconStart="@FluentIcons.PersonAdd"
                                          Disabled="@_loadingGuardians"
                                          OnClick="OnManageGuardians">
                                Manage
                            </FluentButton>
                        </div>
                        @if (!string.IsNullOrEmpty(_guardianError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">@_guardianError</FluentMessageBar>
                        }
                        <StudentGuardiansList Items="LinkedItems"
                                               RelationshipNameLookup="ResolveRelName"
                                               SalutationLookup="ResolveSalutation"
                                               OnRemove="OnLinkedRemoveAsync" />
                    }
                    else
                    {
                    @if (_loadingGuardians)
                    {
                        <FluentProgressRing />
                    }
                    else
                    {
                        @* ── Inline "add guardian" row (List mode) ──
                           Mimics the <ContactsEditor> add-contact form: an inline
                           horizontal row of fields + an Accent Add button, always
                           visible in List mode (no separate panel switch). Field
                           set is the guardian's identity + link relationship only
                           (Relationship / Last name / First name). Role defaults
                           to Primary; title/salutation, emergency and contacts are
                           NOT captured here — they're guardian-surface operations
                           (GuardianDetail), so a newly-added guardian starts with
                           zero contacts (the card shows "— no contacts —") until
                           its contacts are added on the guardian surface. *@
                        @if (_panelMode == GuardianPanelMode.List)
                        {
                            <div class="guardian-add-row">
                                @* Local FluentSelect wrapper for the relationship picker (plan §10 Phase 2).
                                   Renders the sentinel "Add Existing Guardian" + a non-selectable divider
                                   + the RELATSHIPS coded values. Replaces the old CodedValueDropdown.
                                   The sentinel sets _inExistingMode and routes through the §2.1 guard
                                   (resolved to _pickedRelationshipId in Phase 5, null until then).
                                   §9.2 visual divider: rendered as an <hr> inside a disabled
                                   <fluent-option> via OptionTemplate — verify at runtime;
                                   FluentOptionGroup is not available in FluentUI Blazor 4.14.2.
                                   Width shrunk to 150px (from the old W4/200px) via inline Style so the Add stays inline (scoped CSS
                                   would lose to the web component's host width, mirroring the
                                   CodedValueDropdown's Width=FieldWidth.W4 inline-style pattern). *@
                                <FluentSelect TOption="RelationshipOption"
                                              Items="@(_relationshipOptions ?? [])"
                                              SelectedOption="@_selectedRelOption"
                                              SelectedOptionChanged="@OnRelationshipOptionChanged"
                                              OptionValue="@(o => o.Id?.ToString() ?? "divider")"
                                              Placeholder="@(_relationshipOptions is null ? "Loading…" : "Relationship")"
                                              Style="width: 150px"
                                              Disabled="@(_relationshipOptions is null)"
                                              class="guardian-rel-select">
                                    <OptionTemplate Context="opt">
                                        @if (opt.Kind == RelationshipOptionKind.Divider)
                                        {
                                            <hr class="guardian-rel-divider" />
                                        }
                                        else
                                        {
                                            @opt.Label
                                        }
                                    </OptionTemplate>
                                </FluentSelect>
                                @* Name fields (free-text new guardian) vs. typeahead (existing guardian).
                                   Plan §10 Phase 3: hide the name inputs when the sentinel is picked and
                                   render the debounced typeahead input + far-right Student/Contact radio.
                                   Phase 4 wires the debounced search handler; Phase 5 wires pick → prefill. *@
                                @if (!InExistingMode)
                                {
                                    <FluentTextField @bind-Value="_newLastName"
                                                     Placeholder="Last name"
                                                     class="guardian-add-field" />
                                    <FluentTextField @bind-Value="_newFirstName"
                                                     Placeholder="First name"
                                                     class="guardian-add-field" />
                                }
                                else
                                {
                                    <div class="guardian-typeahead-stack">
                                    <FluentAutocomplete TOption="GuardianSearchRow"
                                                        @ref="_typeahead"
                                                        Multiple="false"
                                                        MaximumOptionsSearch="30"
                                                        ImmediateDelay="300"
                                                        ShowProgressIndicator="true"
                                                        AutoComplete="off"
                                                        Placeholder="Search by guardian or student name…"
                                                        OptionText="@(r => r.FullName)"
                                                        OptionComparer="@GuardianSearchRowComparer.Instance"
                                                        OptionTemplate="@RowTemplate"
                                                        OnOptionsSearch="@OnTypeaheadSearchAsync"
                                                        SelectedOptionChanged="@OnTypeaheadSelectedAsync"
                                                        Style="width: 100%"
                                                        class="guardian-typeahead" />
                                    <FluentRadioGroup @bind-Value="_searchMode"
                                                      class="guardian-search-mode"
                                                      aria-label="Search mode">
                                        <FluentRadio Value="@SearchMode.Contact">Contact</FluentRadio>
                                        <FluentRadio Value="@SearchMode.Student">Student</FluentRadio>
                                    </FluentRadioGroup>
                                    </div>
                                }
                                <FluentButton Appearance="Appearance.Accent"
                                              IconStart="@FluentIcons.PersonAdd"
                                              OnClick="AddInlineGuardianAsync"
                                              Disabled="@(_adding
                                                         || (InExistingMode && _existingGuardianId is null)
                                                         || (!InExistingMode && (string.IsNullOrWhiteSpace(_newFirstName) || string.IsNullOrWhiteSpace(_newLastName))))">
                                    Add
                                </FluentButton>

                            </div>


                        }

                        @* ── Linked / drafted guardians (card list) ──
                           A vertical list of cards that mimics the
                           <ContactsEditor> contact-item visual: each
                           guardian is a bordered card with a head line
                           (person glyph + name + relationship + role /
                           emergency badges) and a contact-summary line
                           (up to 3 contact chips). The primary guardian's
                           card gets the accent-tinted highlight so the
                           primary link is the visual anchor — same
                           convention the contacts list uses for the
                           preferred contact. Display-only: the per-guardian
                           contact chips are loaded from the student's
                           guardian links' top-3 contacts and cannot be
                           edited here (guardian contact editing still
                           lives on the guardian surface). *@
                        <div class="guardian-cards">
                            @foreach (var g in GuardianGridRows)
                            {
                                // While the Edit panel is open, all OTHER guardian
                                // cards hide — only the card currently being edited
                                // stays visible (its Key is its index into
                                // Model.GuardianLinks). Save/Cancel restores the list.
                                if (_panelMode == GuardianPanelMode.Edit && (int)g.Key != _editingIndex)
                                {
                                    continue;
                                }
                                var relName = g.RelationshipCodedValueId is { } rid && _relNames.TryGetValue(rid, out var rn) ? rn : null;
                                var salName = g.TitleCodedValueId is { } tid && _salutations.TryGetValue(tid, out var sn) ? sn : null;
                                var name = string.IsNullOrWhiteSpace(salName) ? $"{g.FirstName} {g.LastName}".Trim() : $"{salName} {g.FirstName} {g.LastName}".Trim();
                                var contacts = g.Contacts;
                                var isPrimary = g.Role == GuardianRole.Primary;
                                <FluentCard class="@(isPrimary ? "guardian-card guardian-card--primary" : "guardian-card")">
                                    <div class="guardian-card-head">
                                        <span class="guardian-card-name">👤 @name</span>
                                        @if (!string.IsNullOrWhiteSpace(relName))
                                        {
                                            <span class="guardian-card-rel">(@relName)</span>
                                        }
                                        @if (isPrimary)
                                        {
                                            <FluentBadge Appearance="Appearance.Accent" class="guardian-card-badge">Primary</FluentBadge>
                                        }
                                        @if (g.IsEmergencyContact)
                                        {
                                            <FluentBadge Appearance="Appearance.Accent" class="guardian-card-badge">Emergency</FluentBadge>
                                        }
                                        <span class="guardian-card-actions">
                                            <FluentButton Appearance="Appearance.Lightweight" Title="Edit guardian"
                                                          OnClick="@(() => StartEditGuardian((int)g.Key))">
                                                <FluentIcon Icon="@(Icons.Regular.Size20.Edit)" />
                                            </FluentButton>
                                            <FluentButton Appearance="Appearance.Lightweight" Title="Remove guardian"
                                                          OnClick="@(() => RemoveGuardianRow(g.Key))">
                                                <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                                            </FluentButton>
                                        </span>
                                    </div>
                                    <div class="guardian-card-contacts">
                                        @if (contacts.Count == 0)
                                        {
                                            <span class="muted">— no contacts —</span>
                                        }
                                        else
                                        {
                                            @foreach (var c in contacts.Take(3))
                                            {
                                                <span class="guardian-contact-chip">
                                                    <span>@ChannelGlyph(c.Channel)</span>
                                                    <span>@FormatContactValue(c)</span>
                                                </span>
                                            }
                                        }
                                    </div>
                                </FluentCard>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_guardianError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_guardianError</FluentMessageBar>
                        }

                        @* ── Panel switch: edit panel, or existing search ── *@
                        @if (_panelMode == GuardianPanelMode.Edit)
                        {
                            <div class="guardian-add-section">
                                @{ var editedGuardian = (_editingIndex >= 0 && _editingIndex < Model.GuardianLinks.Count) ? Model.GuardianLinks[_editingIndex] : null; }
                                <h4 class="guardian-add-title">Edit guardian</h4>
                                <FluentStack Orientation="Orientation.Vertical" Spacing="3">
                                    @* Draft-only fields: title + name are editable only for
                                       not-yet-persisted guardians (ExistingGuardianId is null).
                                       For existing guardians these don't persist through the
                                       student save (guardian-surface operation), so they're
                                       hidden to avoid misleading the user. *@
                                    @if (editedGuardian is { } eg && eg.ExistingGuardianId is null)
                                    {
                                        <FormRow Label="Title">
                                            <CodedValueDropdown Parent="CodedValueParent.Salutations"
                                                                @bind-SelectedId="_editTitleId"
                                                                Placeholder="Optional"
                                                                Width="FieldWidth.W3" />
                                        </FormRow>
                                        <FormRow Label="First name" Required>
                                            <FluentTextField @bind-Value="_editFirstName" Required Placeholder="First name" class="w-5" />
                                        </FormRow>
                                        <FormRow Label="Last name" Required>
                                            <FluentTextField @bind-Value="_editLastName" Required Placeholder="Last name" class="w-5" />
                                        </FormRow>
                                    }
                                    <FormRow Label="Relationship">
                                        <CodedValueDropdown Parent="CodedValueParent.Relationships"
                                                            @bind-SelectedId="_editRelationshipId"
                                                            Placeholder="Select relationship"
                                                            Width="FieldWidth.W4" />
                                    </FormRow>
                                    <FormRow Label="Role">
                                        <DropdownForEnum TEnum="GuardianRole"
                                                          @bind-SelectedValue="_editRole"
                                                          @key="@($"role-{_editingIndex}")"
                                                          Placeholder="Select role"
                                                          Width="FieldWidth.W3" />
                                    </FormRow>
                                </FluentStack>
                                @* Contacts editor: Live mode for existing guardians
                                   (immediate API calls), Buffered mode for drafts
                                   (in-memory, persisted at student save time). *@
                                @if (editedGuardian is { } eg2 && eg2.ExistingGuardianId is { } gid)
                                {
                                    <div class="guardian-edit-contacts">
                                        <ContactsEditor OwnerType="ContactOwnerType.Guardian" OwnerId="@gid" />
                                    </div>
                                }
                                else if (editedGuardian is not null)
                                {
                                    <div class="guardian-edit-contacts">
                                        <ContactsEditor Mode="ContactsEditor.EditorMode.Buffered"
                                                        OwnerType="ContactOwnerType.Guardian"
                                                        Contacts="_editContacts"
                                                        ContactsChanged="OnEditContactsChanged" />
                                    </div>
                                }
                                <FluentStack Orientation="Orientation.Horizontal" Spacing="8" class="guardian-add-actions">
                                    <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Button" OnClick="SaveEditGuardianAsync">Save</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" Type="ButtonType.Button" OnClick="CancelPanel">Cancel</FluentButton>
                                </FluentStack>
                            </div>
                                }

                    }
                }
                </div>
            </FormRow>
        }
    </FluentStack>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="student-form-error">@ErrorMessage</FluentMessageBar>
    }

    @* Action row. The .form-actions CSS class draws the horizontal line
       (border-top) that separates the field block above from the action
       buttons below, and adds comfortable margin/padding so the line
       breathes. The action buttons are rendered by THIS component (not by
       the calling page): a built-in Submit / Cancel pair driven by the
       SubmitLabel / CancelLabel / OnCancel / Submitting / ShowCancel
       parameters. The ActionsAlignment parameter controls whether the
       buttons hug the left edge (default) or the right / trailing edge
       (via the .form-actions--right modifier). A calling page may still
       override the whole row via the optional <Actions> RenderFragment
       (e.g. a dialog that supplies its own DialogShellFooter), or
       suppress the built-in row entirely via RenderActions="false" and
       drive validation+submit externally via @ref.SubmitAsync() (used
       by the long-form /students/{id}/edit page where the buttons sit
       in a page-level right-column stack alongside the Direct contact
       editor). *@
    @if (RenderActions)
    {
        <div class="form-actions @FormActionsClass">
            @if (Actions is not null)
            {
                @Actions
            }
            else
            {
                @* The FluentStack renders at width:100% with justify-content
                   start, so the OUTER .form-actions--right flex-end has no
                   effect (the stack already fills the row). To actually right-
                   align the buttons, set HorizontalAlignment=End on the stack
                   itself when ActionsAlignment is Right. *@
                <FluentStack Orientation="Orientation.Horizontal" Spacing="8"
                             HorizontalAlignment="@(ActionsAlignment == StudentFormActionsAlignment.Right ? HorizontalAlignment.End : HorizontalAlignment.Start)">
                    @if (ShowCancel)
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@OnCancel"
                                      Disabled="@Submitting"
                                      class="form-actions__button">
                            @CancelLabel
                        </FluentButton>
                    }
                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="Appearance.Accent"
                                  Disabled="@Submitting"
                                  class="form-actions__button">
                        @(Submitting ? SubmittingLabel : SubmitLabel)
                    </FluentButton>
                </FluentStack>
            }
        </div>
    }
</EditForm>

@code {
    /// <summary>The class attribute on the rendered <c>.form-actions</c>
    /// div. Composed from the static <c>form-actions</c> base plus the
    /// optional <c>form-actions--right</c> (horizontal alignment)
    /// modifier. Computed in C# rather than inlined in the attribute
    /// value because the EditForm component's tag-helper parser doesn't
    /// tolerate the <c>class="... @(cond ? ... : null)"</c> pattern.</summary>
    private string FormActionsClass => ActionsAlignment == StudentFormActionsAlignment.Right
        ? "form-actions form-actions--right"
        : "form-actions";

    /// <summary>The class attribute on the rendered <c>EditForm</c>. The
    /// base <c>student-form-fields</c> caps the form at 600px (compact
    /// page forms). The <c>student-form-fields--wide</c> modifier removes
    /// that cap so the form fills a wide dialog (used by the create/edit
    /// dialogs, which host the guardians grid + contacts editor and need
    /// the full dialog width).</summary>
    private string FormClass => Wide
        ? "student-form-fields student-form-fields--wide"
        : "student-form-fields";

    /// <summary>When true, removes the 600px max-width cap so the form
    /// fills the full dialog width. Used by the create/edit dialogs, which
    /// host the guardians grid + contacts editor and need the extra room.
    /// Page forms (Create.razor / Edit.razor / the wizard inline form) keep
    /// the default compact width.</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>The form model. Required — the EditForm binds to it.</summary>
    [Parameter, EditorRequired] public StudentFormModel Model { get; set; } = default!;

    /// <summary>Submit handler. Fires only when DataAnnotations validation passes.</summary>
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }

    /// <summary>Action buttons (Submit, Cancel) rendered in the bottom row.
    /// Optional. When supplied, it REPLACES the built-in button row (use this
    /// for special cases such as a dialog that needs its own footer component
    /// like <c>DialogShellFooter</c>). When omitted, the component renders its
    /// own Submit / Cancel buttons driven by the parameters below.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Label on the built-in Submit button. Default: "Save".</summary>
    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>Label shown on the built-in Submit button while <see cref="Submitting"/> is true. Default: "Saving…".</summary>
    [Parameter] public string SubmittingLabel { get; set; } = "Saving…";

    /// <summary>When true, disables the built-in buttons and shows <see cref="SubmittingLabel"/> on Submit. Use to reflect an in-flight save.</summary>
    [Parameter] public bool Submitting { get; set; }

    /// <summary>Whether the built-in Cancel button is shown. Default: true.</summary>
    [Parameter] public bool ShowCancel { get; set; } = true;

    /// <summary>Label on the built-in Cancel button. Default: "Cancel".</summary>
    [Parameter] public string CancelLabel { get; set; } = "Cancel";

    /// <summary>Invoked when the built-in Cancel button is clicked. Optional.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Horizontal alignment of the action buttons. Defaults to
    /// <see cref="StudentFormActionsAlignment.Right"/> so the buttons sit
    /// at the trailing edge of the form (matches the dialog footer);
    /// set to <see cref="StudentFormActionsAlignment.Left"/> to keep them
    /// at the leading edge.</summary>
    [Parameter] public StudentFormActionsAlignment ActionsAlignment { get; set; } = StudentFormActionsAlignment.Right;

    /// <summary>Horizontal alignment of the action buttons.</summary>
    public enum StudentFormActionsAlignment { Left, Right }

    /// <summary>Whether the built-in bottom-horizontal action row is
    /// rendered. Default <c>true</c> — the form renders its own Submit
    /// and Cancel pair below the fields, separated by a border-top, which
    /// matches the established dialog-ui pattern (e.g. the inline
    /// GradeLevelWizard "new student" form, the StudentPickerDialog
    /// "create" view, and /students/create). Set to <c>false</c> on
    /// long forms (e.g. /students/{id}/edit) where the page hosts the
    /// action buttons in a right-column page-level sidebar that also
    /// spans the Direct contact editor below the form. The caller
    /// captures the form via <c>@ref</c> and drives validation+submit
    /// through <see cref="SubmitAsync"/>, which mimics the EditForm's
    /// private HandleSubmitAsync: validates, then fires
    /// <see cref="OnValidSubmit"/> on success.</summary>
    [Parameter] public bool RenderActions { get; set; } = true;

    /// <summary>Validate the form and fire <see cref="OnValidSubmit"/>
    /// when valid. Mirrors the standard Blazor pattern for triggering
    /// an EditForm submit from a button that sits OUTSIDE the form
    /// (e.g. a sidebar action stack). Returns <c>true</c> when the
    /// validation passed and the submit handler ran; <c>false</c>
    /// when validation failed (DataAnnotations errors are shown next
    /// to the offending fields and the submit handler is NOT called).
    /// Idempotent under repeated calls while a submit is in flight
    /// (the guard <c>if (Submitting) return false</c> prevents
    /// double-submit when the caller also disables the button).</summary>
    public async Task<bool> SubmitAsync()
    {
        if (Submitting) return false;
        var ctx = _editForm?.EditContext;
        if (ctx is null) return false;
        if (!ctx.Validate()) return false;
        await OnValidSubmit.InvokeAsync();
        return true;
    }

