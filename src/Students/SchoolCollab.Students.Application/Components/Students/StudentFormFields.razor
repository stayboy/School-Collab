    private void CancelPanel()
    {
        _panelMode = GuardianPanelMode.List;
        // The inline add-row fields are intentionally NOT cleared here — they
        // persist across panel navigation (mimics ContactsEditor's add row).
        _editingIndex = -1;
        // Phase 5/§11: cancel any in-flight typeahead search and clear the
        // transient search session. The add-row selection persists.
        ClearTypeaheadState();
    }

    /// <summary>Apply the edited link metadata (relationship / role) back
    /// to the drafted <see cref="GuardianAssignment"/> at
    /// <see cref="_editingIndex"/>. Replaces the immutable record via a
    /// <c>with</c> expression, preserving the guardian's identity (id /
    /// name / title), its contact summary, and its emergency-contact flag
    /// (not surfaced — see the Edit panel comment). No API call — the
    /// change is drafted and persisted atomically with the rest of the
    /// student on Save (UpdateStudentWithLinkedDataHandler →
    /// link.Update(...)).</summary>
    private async Task SaveEditGuardianAsync()
    {
        if (_editingIndex < 0 || _editingIndex >= Model.GuardianLinks.Count)
        {
            _panelMode = GuardianPanelMode.List;
            return;
        }
        _guardianError = null;
        try
        {
            var original = Model.GuardianLinks[_editingIndex];
            var updated = original with
            {
                RelationshipCodedValueId = _editRelationshipId,
                Role = _editRole,
                TitleCodedValueId = _editTitleId,
                FirstName = _editFirstName ?? original.FirstName,
                LastName = _editLastName ?? original.LastName,
                Contacts = _editContacts.Count == 0 ? original.Contacts : _editContacts,
            };
            Model.GuardianLinks[_editingIndex] = updated;
            if (_editRelationshipId is { } relId)
                await EnsureRelNameAsync(relId);
            _panelMode = GuardianPanelMode.List;
            _editingIndex = -1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to edit guardian at index {Index}", _editingIndex);
            _guardianError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }





    private GuardianGridRow[] GuardianGridRows
        => Model.GuardianLinks.Select((g, i) => new GuardianGridRow(
            i,
            g.FirstName ?? string.Empty,
            g.LastName ?? string.Empty,
            g.TitleCodedValueId,
            g.RelationshipCodedValueId,
            g.Role,
            g.IsEmergencyContact,
            BuildRowContacts(g))).ToArray();

    /// <summary>Build the contact list rendered as chips under a guardian
    /// card. Combines two sources:
    ///   - The assignment's <c>Contacts</c> list (populated by
    ///     <see cref="StudentFormModel"/> from the link's top-3 contacts
    ///     for already-linked guardians).
    ///   - The legacy single-contact fields (<c>ContactChannel</c> /
    ///     <c>ContactValue</c> / <c>CountryCode</c>) used by the inline
    ///     "New guardian" panel for not-yet-persisted drafts. Appended
    ///     after the multi-contact list, so newly-added guardians show
    ///     the value they were drafted with as the last chip.
    /// Result is ordered by <c>Order</c> then by legacy-single to keep
    /// the preferred (lowest Order) contact first.</summary>
    private static List<ContactModel> BuildRowContacts(GuardianAssignment g)
    {
        var source = g.Contacts ?? (IReadOnlyList<ContactModel>)Array.Empty<ContactModel>();
        var result = new List<ContactModel>(source.Count + 1);
        result.AddRange(source);
        if (g.ContactChannel is { } ch
            && !string.IsNullOrWhiteSpace(g.ContactValue)
            && !result.Any(c => c.Channel == ch && c.Value == g.ContactValue))
        {
            result.Add(new ContactModel
            {
                Channel = ch,
                Value = g.ContactValue!,
                CountryCode = g.CountryCode,
                Order = result.Count,
            });
        }
        return result;
    }

