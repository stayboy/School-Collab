    /// <summary>The current guardian count surfaced in the Linked-mode
    /// header. In <see cref="StudentFormFieldsMode.Linked"/> mode the
    /// count is <see cref="LinkedItems"/>.<see cref="Array.Length"/>;
    /// in Inline mode the count is <c>Model.GuardianLinks.Count</c> (the
    /// draft list) — but Inline mode doesn't render the Linked header so
    /// the value is unused there.</summary>
    private int GuardianCount => Mode == StudentFormFieldsMode.Linked
        ? LinkedItems?.Length ?? 0
        : Model.GuardianLinks.Count;

    /// <summary>Resolves a relationship coded-value id to its display name
    /// using the already-loaded <c>_relNames</c> map. Returns null when
    /// the id is unset or the name hasn't been resolved yet — the
    /// <c>StudentGuardiansList</c> treats a null/empty result as "no
    /// relationship to display" and renders the cell blank. The map is
    /// populated on demand by <see cref="EnsureRelNameAsync"/>.</summary>
    private string? ResolveRelName(Guid? id)
        => id is { } g && _relNames.TryGetValue(g, out var n) ? n : null;

    private string? ResolveSalutation(Guid? id)
        => id is { } g && _salutations.TryGetValue(g, out var n) ? n : null;

    /// <summary>Linked-mode per-row delete handler. Fire-and-forget
    /// the async <see cref="OnRemoveGuardian"/> callback; the form
    /// doesn't await its own completion (the page owns the actual
    /// unlink + reload). The current task is captured only so the
    /// compiler doesn't warn about an unawaited async call inside
    /// a synchronous handler — the EventCallback semantics ensure
    /// the page is invoked synchronously even if the page's handler
    /// is async.</summary>
    private async Task OnLinkedRemoveAsync(StudentGuardianViewDto row)
    {
        await OnRemoveGuardian.InvokeAsync(row);
    }

    /// <summary>Display row for a single guardian card. Carries the
    /// link-level metadata (Role, Relationship, Emergency) and the
    /// display fields (Title, Name) needed by the card head line, plus
    /// the per-guardian contact list rendered as chips on the second
    /// line. <see cref="Contacts"/> already includes both the
    /// multi-contact list (populated by <see cref="StudentFormModel"/>
    /// from the link's top-3 contacts) AND the legacy single-contact
    /// fields for newly-created (not yet persisted) guardians — see
    /// <see cref="BuildRowContacts"/>.</summary>
    private sealed record GuardianGridRow(
        object Key,
        string FirstName,
        string LastName,
        Guid? TitleCodedValueId,
        Guid? RelationshipCodedValueId,
        GuardianRole Role,
        bool IsEmergencyContact,
        IReadOnlyList<ContactModel> Contacts);

    /// <summary>Display row for the "add existing" picker grid.</summary>
    private sealed record GuardianPickerRow(
