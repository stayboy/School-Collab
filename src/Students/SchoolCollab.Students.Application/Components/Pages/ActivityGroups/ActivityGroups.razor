@page "/activity-groups"
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Components.Landing
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Core.Features
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<ActivityGroups> Logger
@inject VisibleTenantService VisibleTenant
@inject IToastService Toast
@implements IDisposable

<FeatureFlagGate Key="@FeatureFlagKeys.EnableActivityGroups">
    <LandingPage TItem="ActivityGroupDto"
                 Title="Activity Groups"
                 CreateLabel="+ New Activity Group"
                 CreateEnabled="@_isRealTenant"
                 SearchEnabled="@_isRealTenant"
                 OnCreate="@OpenCreateDialogAsync"
                 EmptyMessage="@CurrentEmptyMessage"
                 Items="@_filteredItems"
                 Loading="@(_items is null)"
                 GridSettings="@_gridSettings"
                 SearchText="@_searchText"
                 SearchTextChanged="@OnSearchValueChanged"
                 SearchPlaceholder="Search activity groups…"
                 RowActions="@BuildRowActions"
                 RowActionsAriaLabel="Group actions"
                 RowActionsUseMenuService="false">
        <Columns>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Name" Sortable="true" SortBy="@_sortByName">
                <FluentAnchor Appearance="Appearance.Lightweight"
                              Href="@($"/activity-groups/{context.Id}")">
                    @context.Name
                </FluentAnchor>
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Category">
                @if (string.IsNullOrWhiteSpace(context.Category))
                {
                    <span class="muted">—</span>
                }
                else
                {
                    @context.Category
                }
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Status">
                <FluentBadge Appearance="@(context.IsActive ? Appearance.Accent : Appearance.Neutral)">@(context.IsActive ? "Active" : "Inactive")</FluentBadge>
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Span">
                <FluentBadge Appearance="Appearance.Neutral">@context.Span</FluentBadge>
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Window">
                @if (context.Span == "DateRange" && context.EnrollmentStartDate.HasValue)
                {
                    @($"{context.EnrollmentStartDate:yyyy-MM-dd} → {context.EnrollmentEndDate:yyyy-MM-dd}")
                }
                else
                {
                    <span class="muted">—</span>
                }
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Auto-renew">
                @(context.AutoRenewDefault ? "Yes" : "No")
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Eligible grades">
                @if (context.EligibleGradeIds.Length == 0)
                {
                    <span class="muted">All</span>
                }
                else
                {
                    @string.Join(", ", context.EligibleGradeIds.Select(id => _gradeNames.TryGetValue(id, out var n) ? n : id.ToString()[..8]))
                }
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Capacity">
                @(context.Capacity?.ToString() ?? "Unlimited")
            </TemplateColumn>
            <TemplateColumn TGridItem="ActivityGroupDto" Title="Members">
                <FluentAnchor Appearance="Appearance.Lightweight"
                              Href="@($"/activity-groups/{context.Id}")">
                    @context.ActiveMemberCount
                </FluentAnchor>
            </TemplateColumn>
        </Columns>
    </LandingPage>
</FeatureFlagGate>


@code {
    private ActivityGroupDto[]? _items;
    private string _searchText = string.Empty;
    private string? _error;
    private Dictionary<Guid, string> _gradeNames = new();
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "minmax(180px,2fr) 110px 90px 120px 150px 90px 150px 90px 80px auto"
    };

    private static readonly GridSort<ActivityGroupDto> _sortByName =
        GridSort<ActivityGroupDto>.ByAscending(x => x.Name);

    private ActivityGroupDto[] _filteredItems =>
        string.IsNullOrWhiteSpace(_searchText)
            ? (_items ?? [])
            : (_items ?? []).Where(g => g.Name.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

    private string CurrentEmptyMessage =>
        !_isRealTenant
            ? "Select a tenant to manage activity groups."
            : (!string.IsNullOrWhiteSpace(_searchText) && _filteredItems.Length == 0
                ? $"No activity groups match '{_searchText}'."
                : "No activity groups yet. Create one to get started.");

    private static Appearance StatusBadge(bool isActive) => isActive ? Appearance.Accent : Appearance.Neutral;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            return;
        }

        try
        {
            _items = await Api.ListActivityGroupsAsync(token);
            if (_disposed) return;

            // Resolve eligible-grade names (grade level id → name) for the chips.
            var gradeLevels = await Api.ListGradeLevelsForLandingAsync(token);
            if (gradeLevels is not null)
            {
                _gradeNames = gradeLevels.ToDictionary(g => g.Id, g => g.Name);
            }

            Logger.LogInformation("Loaded {Count} activity groups", _items?.Length ?? 0);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load activity groups");
            _error = ex.Message;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        if (_disposed) return;

        var model = new ActivityGroupCreateDialog.ActivityGroupCreateModel();
        var created = await DialogService.ShowShellDialogAsync<
            ActivityGroupCreateDialog,
            ActivityGroupCreateDialog.ActivityGroupCreateModel,
            ActivityGroupDto>(
            model, "Create activity group", DialogSize.Medium);

        if (_disposed) return;
        if (created is not null)
        {
            await ReloadAsync();
        }
    }


    private IReadOnlyList<RowAction> BuildRowActions(ActivityGroupDto row)
    {
        var actions = new List<RowAction>
        {
            RowAction.Navigate("Open", $"/activity-groups/{row.Id}", FluentIcons.Open),
            RowAction.Callback("Edit", () => OpenEditDialogAsync(row), FluentIcons.Edit),
            RowAction.Separator(),
        };

        if (row.IsActive)
            actions.Add(RowAction.Callback("Deactivate", () => OnToggleActiveAsync(row.Id, false), null));
        else
            actions.Add(RowAction.Callback("Activate", () => OnToggleActiveAsync(row.Id, true), null));

        actions.Add(RowAction.Separator());
        actions.Add(RowAction.Callback("Delete", () => OnDeleteAsync(row.Id, row.Name), FluentIcons.Delete));

        return actions;
    }

    private async Task OpenEditDialogAsync(ActivityGroupDto row)
    {
        if (_disposed) return;

        var model = new ActivityGroupEditDialog.ActivityGroupEditModel
        {
            Id = row.Id,
            Name = row.Name,
            Description = row.Description,
            Category = row.Category,
            Capacity = row.Capacity,
            Span = row.Span,
            EnrollmentStartDate = row.EnrollmentStartDate?.ToDateTime(TimeOnly.MinValue),
            EnrollmentEndDate = row.EnrollmentEndDate?.ToDateTime(TimeOnly.MinValue),
            AutoRenewDefault = row.AutoRenewDefault,
            EligibleGradeIds = row.EligibleGradeIds,
        };

        var updated = await DialogService.ShowShellDialogAsync<
            ActivityGroupEditDialog,
            ActivityGroupEditDialog.ActivityGroupEditModel,
            ActivityGroupDto>(
            model, $"Edit activity group — {row.Name}", DialogSize.Medium);

        if (_disposed) return;
        if (updated is not null)
        {
            await ReloadAsync();
        }
    }

    private async Task OnToggleActiveAsync(Guid id, bool active)
    {
        if (_disposed) return;
        try
        {
            if (active)
                await Api.ActivateActivityGroupAsync(id);
            else
                await Api.DeactivateActivityGroupAsync(id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
    }


    private async Task OnDeleteAsync(Guid id, string name)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete activity group '{name}'? This cannot be undone if it has members or linked assignments.",
            "Delete", "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var previous = _items;
        _items = _items?.Where(x => x.Id != id).ToArray();
        StateHasChanged();

        try
        {
            await Api.DeleteActivityGroupAsync(id);
            if (_disposed) return;
            Logger.LogInformation("Deleted activity group {Id}", id);
            Toast.ShowSuccess($"Activity group '{name}' deleted.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _items = previous;
            _error = ex.Message.Contains("referenced", StringComparison.OrdinalIgnoreCase)
                ? "Cannot delete: members or assignments reference this group. Archive it instead."
                : ex.Message;
            StateHasChanged();
        }
    }

    private void OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}

