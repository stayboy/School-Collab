@page "/activity-groups/{Id:guid}"
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Core.Features
@inject StudentsApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<ActivityGroupDetails> Logger
@implements IDisposable

<FeatureFlagGate Key="@FeatureFlagKeys.EnableActivityGroups">
    <SectionContent SectionName="page-toolbar">
        <div class="title-row">
            <h1 class="page-title">@(_group?.Name ?? "Activity Group")</h1>
            @if (_group is not null)
            {
                <FluentBadge Appearance="@(_group.IsActive ? Appearance.Accent : Appearance.Neutral)">@(_group.IsActive ? "Active" : "Inactive")</FluentBadge>
            }
        </div>
        <div class="action-bar">
            <FluentButton Appearance="Appearance.Neutral"
                          Icon="@FluentIcons.ArrowLeft"
                          OnClick="@(() => Nav.NavigateTo("/activity-groups"))">
                Back
            </FluentButton>
            @if (_group is not null && _group.IsActive)
            {
                <FluentButton Appearance="Appearance.Accent"
                              Icon="@FluentIcons.PersonAdd"
                              Disabled="@_loading"
                              OnClick="@OpenAddMemberDialogAsync">
                    Add members
                </FluentButton>
                @if (_group.Span != "OpenEnded")
                {
                    <FluentButton Appearance="Appearance.Outline"
                                  Icon="@FluentIcons.ArrowClockwise"
                                  Disabled="@(_loading || _saving)"
                                  OnClick="@OnRolloverAsync">
                        Roll over
                    </FluentButton>
                }
            }
        </div>
    </SectionContent>

    @if (_loading && _group is null)
    {
        <div class="spinner-container"><FluentProgressRing /></div>
    }
    else if (_group is null)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">Activity group not found.</FluentMessageBar>
        <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Nav.NavigateTo("/activity-groups"))">Back</FluentButton>
    }
    else
    {
        <FluentCard class="pa-4 mt-3">
            <FluentStack Orientation="Orientation.Vertical" Spacing="2">
                @if (!string.IsNullOrWhiteSpace(_group.Description))
                {
                    <p class="group-description">@_group.Description</p>
                }
                <FluentStack Orientation="Orientation.Horizontal" Spacing="4">
                    <span class="muted">Category:</span><span>@(_group.Category ?? "—")</span>
                    <span class="muted">Capacity:</span><span>@(_group.Capacity?.ToString() ?? "Unlimited")</span>
                    <span class="muted">Members:</span><span>@(_group.ActiveMemberCount)</span>
                </FluentStack>
            </FluentStack>
        </FluentCard>

        <h2 class="section-heading mt-4">Members</h2>

        @if (_error is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_error</FluentMessageBar>
        }

        @if (_members is null)
        {
            <div class="spinner-container"><FluentProgressRing /></div>
        }
        else if (_members.Length == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info" class="mt-2">
                No members yet. Use “Add members” to enrol students.
            </FluentMessageBar>
        }
        else
        {
            <FluentDataGrid TGridItem="MembershipDto"
                            Items="@_members.AsQueryable()"
                            GridTemplateColumns="2fr 130px 150px 120px 100px auto">
                <TemplateColumn Title="Student" Context="m">
                    <span>@m.StudentName</span>
                </TemplateColumn>
                <TemplateColumn Title="Joined" Context="m">
                    <span class="muted">@m.JoinedOn.ToString("d MMM yyyy")</span>
                </TemplateColumn>
                <TemplateColumn Title="Window" Context="m">
                    @if (m.WindowStartDate.HasValue)
                    {
                        @($"{m.WindowStartDate:yyyy-MM-dd} → {m.WindowEndDate:yyyy-MM-dd}")
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Auto-renew" Context="m">
                    <FluentSwitch Value="@m.AutoRenew"
                                  ValueChanged="@(v => OnToggleAutoRenewAsync(m, v))"
                                  Disabled="@_saving"
                                  Title="Admin-settable: re-enrol this member into the next window on rollover" />
                </TemplateColumn>
                <TemplateColumn Title="Status" Context="m">
                    <FluentBadge Appearance="@MemberStatusBadge(m.Status)">@m.Status</FluentBadge>
                </TemplateColumn>
                <TemplateColumn Title="" Context="m">
                    @if (m.Status == "Active")
                    {
                        <FluentButton Appearance="Appearance.Lightweight"
                                      Icon="@FluentIcons.ArrowRight"
                                      Disabled="@_saving"
                                      OnClick="@(() => OnExitMemberAsync(m.StudentId))">
                            Exit
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Lightweight"
                                      Icon="@FluentIcons.Delete"
                                      Disabled="@_saving"
                                      OnClick="@(() => OnRemoveMemberAsync(m.StudentId))">
                            Remove
                        </FluentButton>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        }
    }
</FeatureFlagGate>


@code {
    [Parameter] public Guid Id { get; set; }

    private ActivityGroupDto? _group;
    private MembershipDto[]? _members;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _loading;
    private bool _saving;

    private static Appearance StatusBadge(bool isActive) => isActive ? Appearance.Accent : Appearance.Neutral;

    private static Appearance MemberStatusBadge(string status) =>
        status == "Active" ? Appearance.Accent : Appearance.Neutral;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;
        _loading = true;
        _error = null;
        try
        {
            _group = await Api.GetActivityGroupByIdAsync(Id, token);
            if (_disposed) return;
            if (_group is not null)
            {
                _members = await Api.ListGroupMembersAsync(Id, token);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load activity group {Id}", Id);
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task OpenAddMemberDialogAsync()
    {
        if (_disposed || _saving) return;

        var selected = await DialogService.ShowShellDialogAsync<
            StudentPickerDialog,
            StudentPickerModel,
            SchoolCollab.Students.Core.DTOs.StudentDto[]>(
            new StudentPickerModel(), "Add members", DialogSize.Medium);

        if (_disposed || selected is null || selected.Length == 0) return;

        _saving = true;
        try
        {
            foreach (var student in selected)
            {
                try
                {
                    await Api.AddGroupMemberAsync(Id, new AddActivityGroupMemberRequest(student.Id));
                }
                catch (Exception ex)
                {
                    _error = $"Could not add {student.FirstName} {student.LastName}: {ex.Message}";
                }
            }
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnRemoveMemberAsync(Guid studentId)
    {
        if (_disposed || _saving) return;
        _saving = true;
        try
        {
            await Api.RemoveGroupMemberAsync(Id, studentId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnExitMemberAsync(Guid studentId)
    {
        if (_disposed || _saving) return;
        _saving = true;
        try
        {
            await Api.ExitGroupMemberAsync(Id, studentId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnToggleAutoRenewAsync(MembershipDto m, bool autoRenew)
    {
        if (_disposed || _saving) return;
        _saving = true;
        try
        {
            await Api.SetMembershipAutoRenewAsync(m.Id, autoRenew);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnRolloverAsync()
    {
        if (_disposed || _saving) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            "Roll over this group? This closes the current window and re-enrols auto-renew members into the next window.",
            "Roll over", "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        _saving = true;
        try
        {
            await Api.RolloverActivityGroupAsync(Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}

