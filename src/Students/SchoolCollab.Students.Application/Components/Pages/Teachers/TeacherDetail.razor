@page "/students/teachers/{Id:guid}"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Students.Core.Domain
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ILogger<TeacherDetail> Logger
@implements IDisposable

<PageTitle>Teacher</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <TenantGate>
            <ChildContent>
                @if (_loading)
                {
                    <div class="spinner-container"><FluentProgressRing /></div>
                }
                else if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
                    <div class="mt-3">
                        <FluentButton Appearance="Appearance.Neutral" IconStart="@FluentIcons.ArrowLeft" OnClick="Back">Back to teachers</FluentButton>
                    </div>
                }
                else if (_teacher is null)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning">Teacher not found.</FluentMessageBar>
                    <div class="mt-3">
                        <FluentButton Appearance="Appearance.Neutral" IconStart="@FluentIcons.ArrowLeft" OnClick="Back">Back to teachers</FluentButton>
                    </div>
                }
                else
                {
                    <div class="detail-toolbar">
                        <FluentButton Appearance="Appearance.Neutral" IconStart="@FluentIcons.ArrowLeft" OnClick="Back">Back</FluentButton>
                        <FluentButton Appearance="Appearance.Accent" IconStart="@FluentIcons.Edit" OnClick="OpenEditAsync">Edit</FluentButton>
                    </div>

                    <section class="detail-header">
                        <h2>@_teacher.FirstName @_teacher.LastName</h2>
                        @if (!string.IsNullOrWhiteSpace(_teacher.DisplayName))
                        {
                            <p class="muted">@_teacher.DisplayName</p>
                        }
                    </section>

                    <div class="review-card">
                        <div class="profile-grid">
                            <FieldDisplay Label="Title" Orientation="FieldDisplayOrientation.Horizontal">@(_titleName ?? "—")</FieldDisplay>
                            <FieldDisplay Label="Date of birth" Orientation="FieldDisplayOrientation.Horizontal">@(_teacher.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</FieldDisplay>
                        </div>
                    </div>

                    <div class="review-card">
                        <h4>Contacts</h4>
                        <ContactsEditor OwnerType="ContactOwnerType.Teacher" OwnerId="@_teacher.Id" />
                    </div>

                    <div class="review-card">
                        <h4>Grade levels (@(_gradeLevels?.Length ?? 0))</h4>
                        @if (_gradeLevels is null || _gradeLevels.Length == 0)
                        {
                            <FluentMessageBar Intent="MessageIntent.Info">No grade levels linked.</FluentMessageBar>
                        }
                        else
                        {
                            <ul class="review-list">
                                @foreach (var gl in _gradeLevels)
                                {
                                    <li>@gl.Name <span class="muted">Level @gl.Level</span></li>
                                }
                            </ul>
                        }
                    </div>
                }
            </ChildContent>
            <Fallback>
                <FluentMessageBar Intent="MessageIntent.Warning">
                    You have no tenant assigned. Teacher records are tenant-scoped — pick a tenant to continue.
                </FluentMessageBar>
            </Fallback>
        </TenantGate>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>


@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private TeacherDto? _teacher;
    private GradeLevelDto[]? _gradeLevels;
    private string? _titleName;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            // Run the reads in parallel — the page is read-only and
            // there are no dependencies between them.
            var teacherTask = Api.GetTeacherByIdAsync(Id, ct);
            var gradesTask = Api.ListGradeLevelsForTeacherAsync(Id, ct);
            await Task.WhenAll(teacherTask, gradesTask);

            _teacher = teacherTask.Result;
            _gradeLevels = gradesTask.Result ?? [];

            if (_teacher is not null && _teacher.TitleCodedValueId is { } titleId)
            {
                _titleName = (await CodedValuesApi.GetByIdAsync(titleId, ct))?.Name;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load teacher {Id}", Id);
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void Back() => Nav.NavigateTo("/students/teachers");

    private async Task OpenEditAsync()
    {
        if (_disposed) return;
        var saved = await DialogService.ShowShellDialogAsync<TeacherEditDialog, TeacherEditDialog.TeacherFormModel, TeacherDto>(
            new TeacherEditDialog.TeacherFormModel { TeacherId = Id },
            "Edit Teacher",
            DialogSize.Large);
        if (_disposed || saved is null) return;
        Nav.NavigateTo($"/students/teachers/{Id}");
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
