@page "/students/teachers"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Components.Landing
@using SchoolCollab.Admin.Shared.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Teachers> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<LandingPage TItem="TeacherDto"
             Title="Teachers"
             CreateLabel="+ New Teacher"
             CreateRoute="/students/teachers/create"
             CreateEnabled="@_isRealTenant"
             SearchEnabled="@_isRealTenant"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_filteredItems"
             Loading="@(_items is null)"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search teachers…"
             Error="@_error"
             RowActions="@BuildTeacherActions"
             RowActionsAriaLabel="Teacher actions">
    <Columns>
        <TemplateColumn TGridItem="TeacherDto" Title="Name" Sortable="true" SortBy="@_sortByName">
            <strong>@context.FirstName @context.LastName</strong>
            @if (!string.IsNullOrWhiteSpace(context.DisplayName))
            {
                <span class="muted"> — @context.DisplayName</span>
            }
        </TemplateColumn>
    </Columns>
</LandingPage>

<style>
    .muted {
        color: var(--neutral-foreground-hint);
    }
</style>

@code {
    private TeacherDto[]? _items;
    private string _searchText = string.Empty;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "minmax(200px,2fr) auto"
    };

    private static readonly GridSort<TeacherDto> _sortByName =
        GridSort<TeacherDto>.ByAscending(x => x.LastName);

    private TeacherDto[] _filteredItems =>
        string.IsNullOrWhiteSpace(_searchText)
            ? (_items ?? [])
            : (_items ?? []).Where(MatchesSearch).ToArray();

    private string CurrentEmptyMessage =>
        !_isRealTenant
            ? "Select a tenant to manage teachers."
            : (!string.IsNullOrWhiteSpace(_searchText) && _filteredItems.Length == 0
                ? $"No teachers match '{_searchText}'."
                : "No teachers yet. Create one to get started.");

    private bool MatchesSearch(TeacherDto t)
    {
        var search = _searchText.Trim();
        var name = $"{t.FirstName} {t.LastName} {t.DisplayName}".Trim();
        return name.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            return;
        }

        try
        {
            _items = await Api.ListTeachersAsync(token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load teachers");
            _error = ex.Message;
            _items = [];
        }
    }

    private async Task OnDeleteAsync(Guid id, string name)
    {
        if (_disposed) return;
        _error = null;

        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete teacher '{name}'? This blocks the record but keeps its subject and grade-level links.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        var previous = _items;
        _items = _items?.Where(x => x.Id != id).ToArray();
        StateHasChanged();

        try
        {
            await Api.DeleteTeacherAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete teacher {Id}", id);
            _items = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private IReadOnlyList<RowAction> BuildTeacherActions(TeacherDto t)
    {
        var name = $"{t.FirstName} {t.LastName}".Trim();
        return new List<RowAction>
        {
            RowAction.Navigate("View", $"/students/teachers/{t.Id}", FluentIcons.Open),
            RowAction.Navigate("Edit", $"/students/teachers/{t.Id}/edit", FluentIcons.Edit),
            RowAction.Separator(),
            RowAction.Callback("Delete", () => OnDeleteAsync(t.Id, name), FluentIcons.Delete),
        };
    }

    private void OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
