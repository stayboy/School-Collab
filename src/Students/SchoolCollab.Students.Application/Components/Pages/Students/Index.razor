@page "/students"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Components.Landing
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Students.Application.Components.Students
@using GuardianDto = SchoolCollab.Students.Core.DTOs.GuardianDto
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject VisibleTenantService VisibleTenant
@inject IToastService Toast
@implements IDisposable

<LandingPage TItem="StudentDto"
             Title="Students"
             CreateLabel="+ New Student"
             CreateRoute="/students/create"
             CreateEnabled="@_isRealTenant"
             SearchEnabled="@_isRealTenant"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_filteredItems"
             Loading="@(_items is null || _gradeLevels is null && _filterGradeLevelId.HasValue)"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search students…"
             Error="@_error"
             RowActions="@BuildStudentActions"
             RowActionsAriaLabel="Student actions">
        <ToolbarFilters>
        @if (_filterGuardian is not null)
        {
            <div class="landing-filter-chips">
                <Chip Label="Guardian"
                      Subtitle="@_filterGuardianName"
                      DismissTitle="Clear guardian filter"
                      OnDismiss="ClearGuardianFilter" />
            </div>
        }
        @if (_filterGradeLevel is not null)
        {
            <div class="landing-filter-chips">
                <Chip Label="Grade"
                      Subtitle="@_filterGradeLevel.Name"
                      DismissTitle="Clear grade filter"
                      OnDismiss="ClearGradeFilter" />
            </div>
        }
        <FluentCheckbox @bind-Value="@_showDeleted" @bind-Value:after="OnShowDeletedChanged"
                        Label="Show deleted" />
    </ToolbarFilters>
    <Columns>
        <TemplateColumn TGridItem="StudentDto" Title="#" SortBy="@_sortByStudentNumber" Sortable="true">
            <code>@context.StudentNumber</code>
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Student" SortBy="@_sortByFullName" Sortable="true">
            <HeaderCellTitleTemplate>
                <span class="grid-header-wrap" title="Student">Student</span>
            </HeaderCellTitleTemplate>
            <ChildContent>
                <FluentAnchor Appearance="Appearance.Lightweight"
                              Href="@($"/students/{context.Id}")"
                              Class="student-full-name">
                    <span class="student-full-name__name">@context.FirstName @context.LastName</span>
                    <span class="student-full-name__demographics">(@GetDemographics(context))</span>
                </FluentAnchor>
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Date of Birth">
            @(context.DateOfBirth?.ToShortDateString() ?? "—")
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Status">
            @if (context.IsDeleted)
            {
                <FluentBadge Appearance="Appearance.Neutral">Deleted</FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Current Grade" Class="student-current-grade-col">
            <HeaderCellTitleTemplate>
                <span class="grid-header-wrap" title="Current Grade">Current Grade</span>
            </HeaderCellTitleTemplate>
            <ChildContent>
                <span class="student-current-grade">@(context.CurrentGrade?.Name ?? "—")</span>
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn TGridItem="StudentDto" Title="Guardians" Class="student-guardians-col">
            <HeaderCellTitleTemplate>
                <span class="grid-header-wrap" title="Guardians">Guardians</span>
            </HeaderCellTitleTemplate>
            <ChildContent>
                @if (context.GuardianCount is > 0)
                {
                    <FluentAnchor Appearance="Appearance.Lightweight"
                                  Href="@($"/students/guardians?studentId={context.Id}")"
                                  Class="student-guardians-link">
                        @context.GuardianCount guardians
                    </FluentAnchor>
                }
                else
                {
                    <span class="student-guardians-none">@(context.GuardianCount is 0 ? "0 guardians" : "—")</span>
                }
            </ChildContent>
        </TemplateColumn>

    </Columns>
</LandingPage>

@code {
    [SupplyParameterFromQuery] public Guid? GradeLevelId { get; set; }
    [SupplyParameterFromQuery] public Guid? PeriodId { get; set; }
    [SupplyParameterFromQuery] public Guid? GuardianId { get; set; }

    private StudentDto[]? _items;
    private StudentDto[]? _deletedItems;
    private GradeLevelDto[]? _gradeLevels;
    private GradeLevelDto? _filterGradeLevel;
    private bool _showDeleted;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    private string _searchText = string.Empty;
    private Guid? _filterGradeLevelId;
    private Guid? _filterPeriodId;
    private GuardianDto? _filterGuardian;
    private string? _filterGuardianName;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "80px minmax(120px,2fr) minmax(100px,1fr) 110px 180px 130px 102px"
    };

    private StudentDto[] _filteredItems
    {
        get
        {
            var baseItems = _showDeleted
                ? (_items ?? []).Concat(_deletedItems ?? []).ToArray()
                : (_items ?? []);

            return string.IsNullOrWhiteSpace(_searchText)
                ? baseItems
                : baseItems.Where(MatchesSearch).ToArray();
        }
    }

    private string CurrentEmptyMessage
    {
        get
        {
            if (!_isRealTenant)
                return "Select a tenant to manage students.";

            if (_filterGradeLevelId.HasValue && (_items is null || _items.Length == 0))
                return "No students enrolled in this grade level for the current period.";

            if (!string.IsNullOrWhiteSpace(_searchText) && _filteredItems.Length == 0)
                return $"No students match '{_searchText}'.";

            return "No students yet.";
        }
    }

    private static readonly GridSort<StudentDto> _sortByStudentNumber =
        GridSort<StudentDto>.ByAscending(x => x.StudentNumber);

    private static readonly GridSort<StudentDto> _sortByFullName =
        GridSort<StudentDto>.ByAscending(x => x.LastName).ThenAscending(x => x.FirstName);

    /// <summary>
    /// Renders the parenthetical "Gender, Age" suffix for the Full Name column.
    /// Returns a non-empty string only when at least one of Gender/Age is
    /// known, so the column never shows a stray empty "()" when both are null.
    /// Em-dash fills the missing slot so the format stays consistent.
    /// </summary>
    private static string GetDemographics(StudentDto s)
    {
        var gender = string.IsNullOrWhiteSpace(s.GenderName) ? "—" : s.GenderName;
        var age = s.Age.HasValue ? s.Age.Value.ToString() : "—";
        // Always show both slots (with em-dashes) so the column shape is stable.
        return $"{gender}, {age}";
    }

    /// <summary>
    /// Builds the kebab-menu actions for a single student row. Active students
    /// get View / Edit / Transfer / Delete; deleted students get View / Edit /
    /// Recover. A separator divides the navigation actions from the data-mutation
    /// actions. Each menu item carries a matching FluentUI icon.
    /// </summary>
    private IReadOnlyList<RowAction> BuildStudentActions(StudentDto s)
    {
        var actions = new List<RowAction>
        {
            RowAction.Navigate("View", $"/students/{s.Id}", FluentIcons.Open),
            RowAction.Navigate("Edit", $"/students/{s.Id}/edit", FluentIcons.Edit),
            RowAction.Separator(),
        };

        if (!s.IsDeleted)
        {
            actions.Add(RowAction.Callback("Transfer", () => OnTransferAsync(s.Id), FluentIcons.ArrowExportUp));
            actions.Add(RowAction.Callback("Delete", () => OnDeleteAsync(s.Id, s.StudentNumber), FluentIcons.Delete));
        }
        else
        {
            actions.Add(RowAction.Callback("Recover", () => OnRecoverAsync(s.Id, s.StudentNumber), FluentIcons.ArrowClockwise));
        }

        return actions;
    }

    private bool MatchesSearch(StudentDto s)
    {
        var search = _searchText.Trim();
        return s.StudentNumber.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.FirstName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.LastName.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        // Resolve visible tenancy up front. Student is strict-tenant, so when
        // there is no real tenant we skip all tenant-scoped API calls and show
        // an explanatory empty state instead of triggering the server guard.
        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            _gradeLevels = [];
            return;
        }

        Logger.LogInformation("Loading students list");
        _error = null;

        try
        {
            // Load grade levels for filter resolution
            _gradeLevels = await Api.ListGradeLevelsAsync(token);
            if (_disposed) return;

            // Load students filtered by grade
            if (GradeLevelId.HasValue)
            {
                _filterGradeLevelId = GradeLevelId;
                _filterPeriodId = PeriodId;
                _filterGradeLevel = _gradeLevels?.FirstOrDefault(gl => gl.Id == GradeLevelId.Value);

                // Load students filtered by grade
                _items = await Api.ListStudentsByGradeAsync(GradeLevelId.Value, PeriodId, token);
            }
            else if (GuardianId.HasValue)
            {
                _filterGuardian = await Api.GetGuardianByIdAsync(GuardianId.Value, token);
                _filterGuardianName = _filterGuardian is null
                    ? GuardianId.Value.ToString("D")
                    : FormatGuardianDisplayName(_filterGuardian);

                // Load students linked to this guardian (the reverse of the
                // guardians landing page's "N students" cell).
                _items = await Api.ListStudentsForGuardianAsync(GuardianId.Value, token);
            }
            else
            {
                // Load all students
                _items = await Api.ListStudentsAsync(token);
            }

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} students", _items?.Length ?? 0);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load students");
            _error = ex.Message;
            // Stop the spinner so the bound Error message bar is visible instead of
            // an infinite loading ring. (Previously _items stayed null → spinner
            // forever, swallowing the error — the reported symptom.)
            _items ??= [];
            _gradeLevels ??= [];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isRealTenant) return;

        // React to ANY query-param change — a filter was applied, switched, or
        // CLEARED (dismissing a pill navigates to /students with no params, so
        // the params go null here). The previous gate on GradeLevelId.HasValue /
        // GuardianId.HasValue meant a cleared filter never reloaded and the stale
        // filtered _items stayed on screen.
        var gradeChanged = GradeLevelId != _filterGradeLevelId;
        var guardianChanged = GuardianId != _filterGuardian?.Id;
        if (!gradeChanged && !guardianChanged) return;

        _loadCts ??= new CancellationTokenSource();

        try
        {
            if (GradeLevelId.HasValue)
            {
                // Grade (optionally period) filter applied or switched to.
                _filterGradeLevelId = GradeLevelId;
                _filterPeriodId = PeriodId;
                _filterGradeLevel = _gradeLevels?.FirstOrDefault(gl => gl.Id == GradeLevelId.Value);
                _filterGuardian = null;
                _filterGuardianName = null;

                _items = await Api.ListStudentsByGradeAsync(GradeLevelId.Value, PeriodId, _loadCts.Token);
            }
            else if (GuardianId.HasValue)
            {
                // Guardian filter applied or switched to.
                _filterGuardian = await Api.GetGuardianByIdAsync(GuardianId.Value, default);
                _filterGuardianName = _filterGuardian is null
                    ? GuardianId.Value.ToString("D")
                    : FormatGuardianDisplayName(_filterGuardian);
                _filterGradeLevelId = null;
                _filterPeriodId = null;
                _filterGradeLevel = null;

                _items = await Api.ListStudentsForGuardianAsync(GuardianId.Value, _loadCts.Token);
            }
            else
            {
                // No filter — a filter was cleared, so reload the full list.
                _filterGradeLevelId = null;
                _filterPeriodId = null;
                _filterGradeLevel = null;
                _filterGuardian = null;
                _filterGuardianName = null;

                _items = await Api.ListStudentsAsync(_loadCts.Token);
            }

            if (_disposed) return;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload students after filter change");
            _error = ex.Message;
            _items ??= [];
            _gradeLevels ??= [];
            StateHasChanged();
        }
    }

    private void ClearGuardianFilter()
    {
        // Just navigate to clear the ?guardianId= query param. OnParametersSetAsync
        // detects the param changed (now null vs the previously-set filter) and
        // reloads the full list + resets the filter state. Do NOT null the filter
        // fields here — doing so makes the change invisible to OnParametersSetAsync
        // (both sides null) and leaves the stale filtered rows on screen.
        Nav.NavigateTo("/students");
    }

    private static string FormatGuardianDisplayName(GuardianDto g)
    {
        var baseName = string.IsNullOrWhiteSpace(g.DisplayName)
            ? $"{g.FirstName} {g.LastName}".Trim()
            : g.DisplayName;
        return string.IsNullOrWhiteSpace(g.TitleName) ? baseName : $"{g.TitleName} {baseName}";
    }

    private async Task OnShowDeletedChanged()
    {
        if (!_isRealTenant) return;

        if (_showDeleted && _deletedItems is null)
        {
            try
            {
                _deletedItems = await Api.ListDeletedStudentsAsync();
                if (_disposed) return;
            }
            catch (Exception ex)
            {
                if (_disposed) return;
                Logger.LogError(ex, "Failed to load deleted students");
                _error = ex.Message;
            }
        }
    }

    private void ClearGradeFilter()
    {
        // Just navigate to clear the query params. OnParametersSetAsync detects
        // the change (param null vs the previously-set filter) and reloads the
        // full list + resets the filter state. Do NOT null the filter fields here —
        // doing so makes the change invisible to OnParametersSetAsync (both sides
        // null) and leaves the stale filtered rows on screen.
        Nav.NavigateTo("/students");
    }

    private async Task OnDeleteAsync(Guid id, string studentNumber)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete student '{studentNumber}'? This will soft-delete the student.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        if (_items is null) return;
        var previous = _items;
        _items = _items.Where(x => x.Id != id).ToArray();
        StateHasChanged();

        try
        {
            await Api.DeleteStudentAsync(id);
            if (_disposed) return;
            Toast.ShowSuccess($"Student '{studentNumber}' deleted.");

            if (_showDeleted)
            {
                _deletedItems = await Api.ListDeletedStudentsAsync();
                if (_disposed) return;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete student {Id}", id);
            _items = previous;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnRecoverAsync(Guid id, string studentNumber)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Recover student '{studentNumber}'? This will restore the student to the active list.",
            "Recover",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.RecoverStudentAsync(id);
            if (_disposed) return;
            _deletedItems = _deletedItems?.Where(x => x.Id != id).ToArray();
            _items = await Api.ListStudentsAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to recover student {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnTransferAsync(Guid studentId)
    {
        if (_disposed) return;
        var result = await DialogService.ShowShellDialogAsync<StudentTransferDialog, StudentTransferModel, StudentTransferResult>(
            new StudentTransferModel(studentId), "Transfer student", DialogSize.Medium);
        if (result is not { Success: true }) return;

        // Reload the current view (respecting the active grade filter, if any).
        try
        {
            _items = _filterGradeLevelId.HasValue
                ? await Api.ListStudentsByGradeAsync(_filterGradeLevelId.Value, _filterPeriodId, default)
                : await Api.ListStudentsAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload students after transfer");
            _error = ex.Message;
        }
    }

    private void OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}