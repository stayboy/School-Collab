            : [];

    /// <summary>One action, so <see cref="RowActionsMenu"/> renders it as a labelled button rather than a
    /// kebab — the repo's own rule (one action ⇒ visible control).</summary>
    private IReadOnlyList<RowAction> GuardianPanelActions =>
        [new RowAction { Label = "Manage guardians…", OnClick = OnManageGuardiansAsync }];

    private IReadOnlyList<RowAction> GuardianRowActions(SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto link) =>
    [
        new RowAction { Label = "Edit link…", OnClick = () => OnEditGuardianAsync(link) },
