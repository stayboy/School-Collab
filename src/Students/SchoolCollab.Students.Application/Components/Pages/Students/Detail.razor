@page "/students/{id:guid}"
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Core.Features
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Core.Contracts
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Detail> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<PageTitle>Student — @(_student?.FirstName ?? "Loading…") @_student?.LastName</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" class="page-container">
            <TenantGate>
                <ChildContent>
                    @if (_student is null)
                    {
                        <div class="spinner-container">
                            <FluentProgressRing />
                        </div>
                    }
                    else
                    {
                        @* ── Title row ─────────────────────────────────────────── *@
                        <div class="title-row">
                            <div class="title-block">
                                <h1 class="page-title">@TitleLine</h1>
                                <p class="page-subtitle">
                                    <code>@_student.StudentNumber</code>
                                    <span class="title-sep">·</span>
                                    @StatusBadge
                                    <span class="title-sep">·</span>
                                    Current: <strong>@(CurrentGradeName ?? "—")</strong>
                                </p>
                            </div>
                            <FluentButton Appearance="Appearance.Outline"
                                          OnClick='() => Nav.NavigateTo($"/students/{Id}/edit")'>
                                Edit
                            </FluentButton>
                        </div>

                        @* ── Profile (FluentCard, single-page section) ─────────── *@
                        <FluentCard class="detail-card">
                            <div class="profile-grid">
                                <FieldDisplay Label="Student #">@_student.StudentNumber</FieldDisplay>
                                <FieldDisplay Label="Full name">@_student.FirstName @_student.LastName</FieldDisplay>
                                <FieldDisplay Label="Date of birth">@(_student.DateOfBirth?.ToString("d") ?? "—")</FieldDisplay>
                                <FieldDisplay Label="Gender">@(string.IsNullOrWhiteSpace(_student.GenderName) ? "—" : _student.GenderName)</FieldDisplay>
                                <FieldDisplay Label="Status">@StatusBadge</FieldDisplay>
                                <FieldDisplay Label="Created">@_student.CreatedAt.ToLocalTime().ToString("g")</FieldDisplay>
                                <FieldDisplay Label="Updated">@_student.UpdatedAt.ToLocalTime().ToString("g")</FieldDisplay>
                            </div>
                        </FluentCard>

                        @* ── Enrollments section ──────────────────────────────────
                           Enroll lives in the section header (always available,
                           the only action that creates a new row). Transfer and
                           Withdraw are row-level actions on the active
                           enrollment (the Actions column) — they only make
                           sense for the row they affect, and the "no active
                           enrollment" case is naturally expressed by the row
                           not having the Actions cell. *@
                        <div class="section-header">
                            <h3>Enrollments</h3>
                            <FluentButton Appearance="Appearance.Accent"
                                          OnClick="OnEnrollAsync"
                                          Disabled="@_savingEnrollment">
                                <FluentIcon Icon="@(Icons.Regular.Size16.Add)" Slot="start" />
                                Enroll
                            </FluentButton>
                        </div>
                        @if (_enrollments is null)
                        {
                            <div class="spinner-container">
                                <FluentProgressRing />
                            </div>
                        }
                        else if (_enrollments.Length == 0)
                        {
                            <FluentMessageBar Intent="MessageIntent.Info">
                                No enrollments yet — use Enroll to add the first one.
                            </FluentMessageBar>
                        }
                        else
                        {
                            <FluentDataGrid Items="@_enrollments.AsQueryable()"
                                            TGridItem="StudentEnrollmentDto"
                                            MultiLine="true"
                                            Class="enrollments-grid">
                                <TemplateColumn Title="Period">
                                    @(_periodNames.TryGetValue(context.PeriodId, out var pn)
                                        ? pn
                                        : context.PeriodId.ToString()[..8])
                                </TemplateColumn>
                                <TemplateColumn Title="Grade">
                                    @(_gradeLevelNames.TryGetValue(context.GradeLevelId, out var gn)
                                        ? gn
                                        : context.GradeLevelId.ToString()[..8])
                                </TemplateColumn>
                                <TemplateColumn Title="Enrolled on">@context.EnrolledOn.ToString("d")</TemplateColumn>
                                <TemplateColumn Title="Exit date">@(context.ExitDate?.ToString("d") ?? "—")</TemplateColumn>
                                <TemplateColumn Title="Status">
                                    @{ var isActive = IsActiveEnrollment(context); }
                                    @if (isActive)
                                    {
                                        <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentBadge Appearance="Appearance.Neutral">@context.Status</FluentBadge>
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Actions" Class="enrollment-actions-col">
                                    @{ var rowActive = IsActiveEnrollment(context); }
                                    @if (rowActive)
                                    {
                                        <FluentStack Orientation="Orientation.Horizontal" Spacing="4">
                                            <FluentButton Appearance="Appearance.Lightweight"
                                                          Size="ButtonSize.Small"
                                                          OnClick="OnTransferAsync"
                                                          Title="Transfer to a different grade level"
                                                          Disabled="@_savingEnrollment">
                                                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowSwap)" />
                                                Transfer
                                            </FluentButton>
                                            <FluentButton Appearance="Appearance.Lightweight"
                                                          Size="ButtonSize.Small"
                                                          OnClick="OnWithdrawAsync"
                                                          Title="Set an exit date on this enrollment"
                                                          Disabled="@_savingEnrollment">
                                                <FluentIcon Icon="@(Icons.Regular.Size16.ArrowExit)" />
                                                Withdraw
                                            </FluentButton>
                                        </FluentStack>
                                    }
                                </TemplateColumn>
                            </FluentDataGrid>
                        }

                        @* ── Activity Groups (spec §3.6 FR-28..32) ───────────────
                           Lists the groups the student is an active member of,
                           below the Enrollments section. The "Join Group"
                           accent button opens the JoinGroupsDialog (multi-select
                           of available groups); each active row has a "Leave"
                           lightweight button. Gated behind the
                           FEATURE:EnableActivityGroups flag (NFR-11). *@
                        <FeatureFlagGate Key="@FeatureFlagKeys.EnableActivityGroups">
                            <div class="section-header">
                                <h3>Activity Groups</h3>
                                <FluentButton Appearance="Appearance.Accent"
                                              Size="ButtonSize.Small"
                                              IconStart="@FluentIcons.PersonAdd"
                                              OnClick="OnJoinGroupAsync">
                                    Join Group
                                </FluentButton>
                            </div>
                            @if (!string.IsNullOrEmpty(_activityGroupsError))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error">@_activityGroupsError</FluentMessageBar>
                            }
                            @if (_studentGroups is null)
                            {
                                <div class="spinner-container">
                                    <FluentProgressRing />
                                </div>
                            }
                            else if (_studentGroups.Length == 0)
                            {
                                <FluentMessageBar Intent="MessageIntent.Info">
                                    Not a member of any activity groups yet — use Join Group to add one.
                                </FluentMessageBar>
                            }
                            else
                            {
                                <FluentDataGrid Items="@_studentGroups.AsQueryable()"
                                                TGridItem="ActivityGroupDto"
                                                Class="activity-groups-grid">
                                    <TemplateColumn Title="Group">
                                        <a href="/activity-groups/@context.Id">@context.Name</a>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Category">@(context.Category ?? "—")</TemplateColumn>
                                    <TemplateColumn Title="Status">
                                        <FluentBadge Appearance="@GroupStatusBadge(context.Status)">@context.Status</FluentBadge>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Members">@context.ActiveMemberCount</TemplateColumn>
                                    <TemplateColumn Title="Actions" Class="activity-group-actions-col">
                                        <FluentButton Appearance="Appearance.Lightweight"
                                                      Size="ButtonSize.Small"
                                                      Disabled="@_savingGroupAction"
                                                      OnClick="@(() => OnLeaveGroupAsync(context.Id))">
                                            Leave
                                        </FluentButton>
                                    </TemplateColumn>
                                </FluentDataGrid>
                            }
                        </FeatureFlagGate>

                        @* ── Guardians (embedded, not in a tab) ───────────────────
                           Replaces the deprecated <GuardiansTab>. The
                           page owns the link list + the dialog opens
                           + the API calls. The "Manage" button opens
                           GuardianPickerDialog; the per-row "Edit"
                           button opens GuardianFormDialog in ForEdit
                           mode. Each action is IMMEDIATE (the view
                           page has no Save flow of its own) — the
                           page reloads the link list on success. The
                           dedicated StudentGuardiansList component
                           is presentational only (no API calls, no
                           dialog opens) and is shared with Edit.razor. *@
                        <div class="section-header">
                            <h3>Guardians</h3>
                            <FluentButton Appearance="Appearance.Accent"
                                          Size="ButtonSize.Small"
                                          IconStart="@FluentIcons.PersonAdd"
                                          OnClick="OnManageGuardiansAsync">
                                Manage
                            </FluentButton>
                        </div>
                        @if (!string.IsNullOrEmpty(_guardianError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">@_guardianError</FluentMessageBar>
                        }
                        <StudentGuardiansList Items="_links.ToArray()"
                                               RelationshipNameLookup="ResolveRelName"
                                               SalutationLookup="ResolveSalutation"
                                               OnEdit="OnEditGuardianAsync"
                                               OnRemove="OnRemoveGuardianAsync"
                                               OnViewAllContacts="OnViewAllContactsAsync" />

                        @* ── Contact history ─────────────────────────────────────
                           Append-only log of contact edits/deletes against this
                           student. Loaded from the new /contacts/audit endpoint and
                           rendered as a compact timeline. Empty state is shown
                           when no changes have been recorded yet. *@
                        <div class="section-header">
                            <h3>Contact history <FluentBadge Appearance="Appearance.Neutral">@_contactHistory.Length</FluentBadge></h3>
                        </div>
                        @if (_contactHistoryLoading)
                        {
                            <div class="spinner-container"><FluentProgressRing /></div>
                        }
                        else if (!string.IsNullOrEmpty(_contactHistoryError))
                        {
                            <FluentMessageBar Intent="MessageIntent.Error">@_contactHistoryError</FluentMessageBar>
                        }
                        else if (_contactHistory.Length == 0)
                        {
                            <FluentMessageBar Intent="MessageIntent.Info">
                                No contact changes recorded yet.
                            </FluentMessageBar>
                        }
                        else
                        {
                            <ul class="student-contact-history">
                                @foreach (var entry in _contactHistory)
                                {
                                    <li class="student-contact-history__entry">
                                        <div class="student-contact-history__meta">
                                            <span class="student-contact-history__actor">@entry.ActorDisplayName</span>
                                            <span class="muted">· @entry.OccurredAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                        <div class="student-contact-history__change">
                                            <FluentBadge Appearance="@ChangeKindBadgeAppearance(entry.ChangeKind)">@entry.ChangeKind</FluentBadge>
                                            <span class="student-contact-history__value-line">
                                                @FormatHistoryValue(entry.PreviousChannel, entry.PreviousValue, entry.PreviousCountryCode)
                                                @if (entry.ChangeKind == "Updated")
                                                {
                                                    <text> → @FormatHistoryValue(entry.NewChannel, entry.NewValue, entry.NewCountryCode)</text>
                                                }
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                        {
                                            <div class="student-contact-history__reason muted">Reason: @entry.Reason</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }

                    }
                </ChildContent>
                <Fallback>
                    <FluentMessageBar Intent="MessageIntent.Warning">
                        You have no tenant assigned. Student records are tenant-scoped — pick a tenant to continue.
                    </FluentMessageBar>
                </Fallback>
            </TenantGate>

            <div class="action-bar">
                <FluentButton Appearance="Appearance.Outline" OnClick='() => Nav.NavigateTo("/students")'>Back to Students</FluentButton>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
            }
        </FluentStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public Guid Id { get; set; }

    private StudentDto? _student;
    private StudentEnrollmentDto[]? _enrollments;
    private Dictionary<Guid, string> _gradeLevelNames = new();
    private Dictionary<Guid, string> _periodNames = new();
    private string? _error;
    private bool _savingEnrollment;
    private bool _isRealTenant;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // ── Guardian link state (page-owned; replaces the deprecated
    //    <GuardiansTab>) ──
    //
    // The view page has no Save flow of its own, so every
    // link / unlink / edit is IMMEDIATE. The page owns the link
    // list, the dialog opens, and the API calls. The dedicated
    // <StudentGuardiansList> component is a thin presenter that
    // fires the EventCallback<StudentGuardianViewDto> handlers
    // below on every user action.
    private List<SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto> _links = new();
    private Dictionary<Guid, string> _relNames = new();
    // Spec §4.8: salutation (title) lookup for the guardian grid Name cell.
    // Loaded once per page load; covers Mr/Mrs/Ms/etc. across all linked
    // guardians. Empty when salutations aren't configured for the tenant.
    private Dictionary<Guid, string> _salutations = new();
    private string? _guardianError;

    // ── Contact history state (append-only audit log) ──
    private SchoolCollab.Students.Core.DTOs.ContactAuditEntryDto[] _contactHistory = [];
    private bool _contactHistoryLoading;
    private string? _contactHistoryError;

    // ── Activity Groups section state (spec §3.6 FR-28..32) ──
    // Groups the student is an active member of, loaded in parallel with the
    // guardians list. Join Group opens JoinGroupsDialog; Leave exits the
    // student from that group. Both actions are immediate (view page has no
    // Save flow) and reload the list on success.
    private ActivityGroupDto[]? _studentGroups;
    private string? _activityGroupsError;
    private bool _savingGroupAction;

    /// <summary>
    /// The student's currently-active enrollment. Active = no exit date AND
    /// status == "Active". Falls back to the most recent enrollment that
    /// has no exit date when none is strictly "Active" (e.g. mid-transfer
    /// transient states).
    /// </summary>
    private StudentEnrollmentDto? ActiveEnrollment =>
        _enrollments?.FirstOrDefault(e => e.ExitDate is null
            && string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase))
        ?? _enrollments?.FirstOrDefault(e => e.ExitDate is null);

    /// <summary>
    /// Predicate form of <see cref="ActiveEnrollment"/> for use in grid row
    /// templates, where we have a specific row's enrollment in scope rather
    /// than the whole list. Same criteria (no exit date AND status == "Active").
    /// </summary>
    private static bool IsActiveEnrollment(StudentEnrollmentDto e) =>
        e.ExitDate is null
        && string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase);

    private string? CurrentGradeName =>
        ActiveEnrollment is { } e && _gradeLevelNames.TryGetValue(e.GradeLevelId, out var n)
            ? n
            : null;

    /// <summary>
    /// Enriched title line: "First Last (Gender, Age)". Uses em-dash for
    /// missing demographics so the visual shape is stable. Age is computed
    /// from DateOfBirth against today.
    /// </summary>
    private string TitleLine
    {
        get
        {
            if (_student is null) return "Loading…";
            var name = $"{_student.FirstName} {_student.LastName}".Trim();
            var gender = string.IsNullOrWhiteSpace(_student.GenderName) ? "—" : _student.GenderName;
            var age = AgeFromDob(_student.DateOfBirth);
            var ageText = age.HasValue ? age.Value.ToString() : "—";
            return string.IsNullOrEmpty(name) ? _student.StudentNumber : $"{name} ({gender}, {ageText})";
        }
    }

    private static int? AgeFromDob(DateOnly? dob)
    {
        if (dob is null) return null;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var age = today.Year - dob.Value.Year;
        if (today < dob.Value.AddYears(age)) age--;
        return age < 0 ? null : age;
    }

    private RenderFragment StatusBadge => __builder =>
    {
        if (_student is null) return;
        if (_student.IsDeleted)
        {
            <FluentBadge Appearance="Appearance.Neutral">Deleted</FluentBadge>
            ;
        }
        else
        {
            <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
            ;
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant) return;

        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        Logger.LogInformation("Loading student {StudentId}", Id);
        try
        {
            // 1. Student + enrollments in parallel (unchanged from the prior
            //    behavior).
            var studentTask = Api.GetStudentByIdAsync(Id, ct);
            var enrollmentsTask = Api.ListEnrollmentsByStudentAsync(Id, ct);
            await Task.WhenAll(studentTask, enrollmentsTask);
            if (_disposed) return;

            _student = studentTask.Result;
            _enrollments = enrollmentsTask.Result;

            if (_student is null)
            {
                _error = $"Student {Id} not found.";
                Logger.LogWarning("Student {StudentId} not found", Id);
            }
            else
            {
                Logger.LogInformation(
                    "Loaded student {StudentNumber} with {Count} enrollments",
                    _student.StudentNumber,
                    _enrollments?.Length ?? 0);
            }

            // 2. Build the period + grade name lookups the new single-page
            //    sections need. The collections are bounded (≤ number of
            //    periods the student has been in, typically < 12) so a
            //    single round-trip per list is fine.
            var gradeIds = (_enrollments ?? Array.Empty<StudentEnrollmentDto>())
                .Select(e => e.GradeLevelId).Distinct().ToArray();
            var periodIds = (_enrollments ?? Array.Empty<StudentEnrollmentDto>())
                .Select(e => e.PeriodId).Distinct().ToArray();

            var gradesTask = gradeIds.Length > 0
                ? Api.ListGradeLevelsAsync(ct)
                : Task.FromResult<GradeLevelDto[]?>(Array.Empty<GradeLevelDto>());
            var periodsTask = periodIds.Length > 0
                ? Api.ListPeriodsAsync(ct)
                : Task.FromResult<PeriodDto[]?>(Array.Empty<PeriodDto>());
            await Task.WhenAll(gradesTask, periodsTask);
            if (_disposed) return;

            _gradeLevelNames = (gradesTask.Result ?? Array.Empty<GradeLevelDto>())
                .ToDictionary(g => g.Id, g => g.Name);
            _periodNames = (periodsTask.Result ?? Array.Empty<PeriodDto>())
                .ToDictionary(p => p.Id, p => p.Name);

            // 3. Guardian link list (page-owned, replaces the deprecated
            //    <GuardiansTab>). The list is used by the StudentGuardiansList
            //    below the title row.
            await LoadGuardiansAsync(ct);

            // 3b. Contact change history for this student.
            await LoadContactHistoryAsync(ct);

            // 4. Activity Groups the student is an active member of (spec
            //    §3.6 FR-28). Loaded alongside the guardians list; the section
            //    grid + Leave/Join actions live below Enrollments.
            await LoadStudentGroupsAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load student {StudentId}", Id);
            _error = ex.Message;
        }
    }

    // ── Enrollment / transfer / withdraw actions ────────────────────────

    private async Task OnEnrollAsync()
    {
        if (_disposed || _student is null) return;
        var model = new EnrollStudentModel(
            StudentId: Id,
            SuggestedPeriodId: ActiveEnrollment?.PeriodId,
            SuggestedGradeLevelId: ActiveEnrollment?.GradeLevelId);
        var result = await DialogService.ShowShellDialogAsync<EnrollStudentDialog, EnrollStudentModel, EnrollStudentResult>(
            model, "Enroll student", DialogSize.Medium);
        if (result is { Success: true })
        {
            await ReloadEnrollmentsAsync();
        }
    }

    private async Task OnTransferAsync()
    {
        if (_disposed) return;
        var result = await DialogService.ShowShellDialogAsync<StudentTransferDialog, StudentTransferModel, StudentTransferResult>(
            new StudentTransferModel(Id), "Transfer student", DialogSize.Medium);
        if (result is { Success: true })
        {
            await ReloadEnrollmentsAsync();
        }
    }

    private async Task OnWithdrawAsync()
    {
        if (_disposed || ActiveEnrollment is not { } active) return;
        var result = await DialogService.ShowShellDialogAsync<WithdrawEnrollmentDialog, WithdrawEnrollmentModel, WithdrawEnrollmentResult>(
            new WithdrawEnrollmentModel(
                EnrollmentId: active.Id,
                StudentName: $"{_student?.FirstName} {_student?.LastName}".Trim(),
                GradeName: _gradeLevelNames.TryGetValue(active.GradeLevelId, out var gn) ? gn : null,
                DefaultExitDate: DateOnly.FromDateTime(DateTime.UtcNow)),
            "Withdraw student",
            DialogSize.Medium);
        if (result is { Success: true })
        {
            await ReloadEnrollmentsAsync();
        }
    }

    private async Task ReloadEnrollmentsAsync()
    {
        if (_disposed) return;
        _savingEnrollment = true;
        try
        {
            _enrollments = await Api.ListEnrollmentsByStudentAsync(Id) ?? Array.Empty<StudentEnrollmentDto>();

            // Rebuild lookup dicts if the mutation introduced a fresh
            // period or grade we hadn't seen.
            var gradeIds = _enrollments.Select(e => e.GradeLevelId).Distinct().ToArray();
            var periodIds = _enrollments.Select(e => e.PeriodId).Distinct().ToArray();

            if (gradeIds.Except(_gradeLevelNames.Keys).Any())
            {
                foreach (var g in await Api.ListGradeLevelsAsync() ?? Array.Empty<GradeLevelDto>())
                {
                    _gradeLevelNames[g.Id] = g.Name;
                }
            }
            if (periodIds.Except(_periodNames.Keys).Any())
            {
                foreach (var p in await Api.ListPeriodsAsync() ?? Array.Empty<PeriodDto>())
                {
                    _periodNames[p.Id] = p.Name;
                }
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload enrollments for student {StudentId}", Id);
            _error = ex.Message;
        }
        finally
        {
            _savingEnrollment = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Guardian link handlers (page-owned, immediate persist) ──
    //
    // Replaces the deprecated <GuardiansTab>. Each action is
    // IMMEDIATE — the view page has no Save flow of its own, so
    // the link / unlink / edit lands the moment the user confirms
    // the dialog. The page reloads the list on success so the
    // StudentGuardiansList re-renders without a full page refresh.
    //
    // "Manage" opens GuardianPickerDialog (the same dialog the
    // wizard uses for adding multiple guardians to a student);
    // "Edit" opens GuardianFormDialog in ForEdit mode; "Remove"
    // is a single API call. The per-row relationship / role /
    // emergency flag changes go through
    // Api.UpdateGuardianLinkAsync (PUT /students/{studentId}/guardians/{guardianId}).

    private async Task OnManageGuardiansAsync()
    {
        if (_disposed) return;
        _guardianError = null;
        try
        {
            var results = await DialogService.ShowShellDialogAsync<GuardianPickerDialog, GuardianPickerModel, GuardianAssignment[]>(
                new GuardianPickerModel(Id), "Manage guardians", DialogSize.Large);
            if (results is null) return;

            var ct = _loadCts?.Token ?? CancellationToken.None;
            foreach (var a in results)
            {
                var guardianId = a.ExistingGuardianId
                    ?? await Api.CreateGuardianAsync(new CreateGuardianRequest(
                        a.TitleCodedValueId, a.FirstName, a.LastName, null, null, null), ct);
                await Api.LinkGuardianAsync(new LinkGuardianRequest(
                    Id, guardianId, a.RelationshipCodedValueId, a.Role, false, null), ct);
                // Seed the contact captured in the picker for a newly-created
                // Seed contacts for a newly-created guardian. The picker's
                // multi-contact editor (Buffered ContactsEditor) populates
                // a.Contacts; the legacy single-contact path (StudentFormFields
                // inline create) populates a.ContactChannel/ContactValue/
                // CountryCode. Prefer the multi-contact list when present;
                // fall back to the single-contact shortcut otherwise.
                if (a.ExistingGuardianId is null)
                {
                    if (a.Contacts is { Count: > 0 })
                    {
                        var ordered = a.Contacts.OrderBy(x => x.Order).ToList();
                        for (var i = 0; i < ordered.Count; i++)
                        {
                            var c = ordered[i];
                            try
                            {
                                await Api.AddContactAsync(new AddContactRequest(
                                    ContactOwnerType.Guardian, guardianId,
                                    c.Channel, c.Value, c.Label)
                                    { CountryCode = c.CountryCode, DisplayOrder = i }, ct);
                            }
                            catch (OperationCanceledException) { throw; }
                            catch (Exception contactEx)
                            {
                                Logger.LogError(contactEx, "Failed to seed contact for guardian {GuardianId}", guardianId);
                            }
                        }
                    }
                    else if (a.ContactValue is not null)
                    {
                        try
                        {
                            await Api.AddContactAsync(new AddContactRequest(
                                ContactOwnerType.Guardian, guardianId,
                                a.ContactChannel ?? ContactChannel.Email, a.ContactValue, null)
                                { CountryCode = a.CountryCode }, ct);
                        }
                        catch (OperationCanceledException) { throw; }
                        catch (Exception contactEx)
                        {
                            Logger.LogError(contactEx, "Failed to seed contact for guardian {GuardianId}", guardianId);
                        }
                    }
                }
            }
            await LoadGuardiansAsync(ct);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to link guardian(s) for student {StudentId}", Id);
            _guardianError = ex.Message;
        }
    }

    private async Task OnEditGuardianAsync(SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto link)
    {
        if (_disposed) return;
        _guardianError = null;
        try
        {
            // The shared <GuardianFormDialog> (used by the wizard's
            // per-link edit) collects Title / First / Last /
            // Relationship — not Role or the emergency flag, and not
            // contacts (contacts are managed on GuardianDetail.razor;
            // the dialog carries the draft's Contacts through unchanged).
            // We pre-populate it from the
            // <see cref="StudentGuardianViewDto"/> read shape (the
            // <c>GuardianAssignment</c> draft is the wizard's per-link
            // payload, with Role defaulting to Primary since the
            // dialog doesn't surface it). On confirm we apply the
            // relationship change via
            // <c>UpdateGuardianLinkAsync</c>; Role and
            // IsEmergencyContact stay as the link's current values
            // (PUT requires the full link metadata, so we mirror
            // them through).
            var draft = new GuardianAssignment(
                link.GuardianId,
                link.FirstName,
                link.LastName,
                link.RelationshipCodedValueId,
                ContactChannel: null,
                ContactValue: null,
                TitleCodedValueId: link.TitleCodedValueId);
            var result = await DialogService.ShowShellDialogAsync<GuardianFormDialog, GuardianAssignmentModel, GuardianAssignment>(
                GuardianAssignmentModel.ForEdit(draft), "Edit guardian", DialogSize.Large);
            if (result is null) return;

            var ct = _loadCts?.Token ?? CancellationToken.None;
            await Api.UpdateGuardianLinkAsync(Id, link.GuardianId, new UpdateGuardianLinkRequest(
                link.Role, result.RelationshipCodedValueId, link.IsEmergencyContact), ct);
            await LoadGuardiansAsync(ct);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to update guardian link for student {StudentId} guardian {GuardianId}",
                Id, link.GuardianId);
            _guardianError = ex.Message;
        }
    }

    private async Task OnRemoveGuardianAsync(SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto link)
    {
        if (_disposed) return;
        _guardianError = null;
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            await Api.UnlinkGuardianAsync(Id, link.GuardianId, ct);
            await LoadGuardiansAsync(ct);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to unlink guardian {GuardianId} from student {StudentId}",
                link.GuardianId, Id);
            _guardianError = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Opens the read-only <see cref="GuardianContactsDialog"/> for a
    /// guardian whose row shows the <c>View all (N) contacts</c> anchor
    /// (TotalContactCount &gt; 3 — spec 2026-07-27 §4.4 / §4.5). The
    /// grid raises this callback; the page owns the dialog open since
    /// <see cref="StudentGuardiansList"/> is presentational only.
    /// Title is the salutation-aware guardian name; subtitle is
    /// <c>"Relationship · Role"</c> when the relationship name resolves,
    /// otherwise just the role. Mirrors the name-format used by the
    /// guardians grid (title + DisplayName-or-First+Last).
    /// </summary>
    private async Task OnViewAllContactsAsync(SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto link)
    {
        if (_disposed) return;

        // Mirrors StudentGuardiansList.FormatGuardianName: prefer
        // DisplayName; fall back to "First Last"; prepend salutation.
        var baseName = string.IsNullOrWhiteSpace(link.DisplayName)
            ? $"{link.FirstName} {link.LastName}".Trim()
            : link.DisplayName;
        var titleText = ResolveSalutation(link.TitleCodedValueId) is { } salutation
                       && !string.IsNullOrWhiteSpace(salutation)
            ? $"{salutation} {baseName}"
            : baseName;

        var relName = ResolveRelName(link.RelationshipCodedValueId);
        var subtitle = string.IsNullOrWhiteSpace(relName)
            ? link.Role.ToString()
            : $"{relName} · {link.Role}";

        var parameters = new Dictionary<string, object?>
        {
            { GuardianContactsDialog.GuardianIdKey, link.GuardianId },
            { GuardianContactsDialog.GuardianNameKey, titleText },
            { GuardianContactsDialog.SubtitleKey, subtitle },
        };

        await DialogService.ShowReadonlyDialogAsync<GuardianContactsDialog>(
            titleText, parameters, DialogSize.Medium);
    }

    private async Task LoadGuardiansAsync(CancellationToken ct)
    {
        try
        {
            var links = await Api.ListGuardiansByStudentAsync(Id, ct) ?? [];
            _links = links.ToList();

            _relNames = new Dictionary<Guid, string>();
            foreach (var link in _links.Where(l => l.RelationshipCodedValueId.HasValue))
            {
                var cv = await CodedValuesApi.GetByIdAsync(link.RelationshipCodedValueId!.Value, ct);
                if (cv is not null) _relNames[cv.Id] = cv.Name;
            }

            // Spec §4.8: batch-load all salutations so the Name cell can
            // prepend "Mr", "Mrs", etc. for any linked guardian without a
            // per-row API call. Failure is non-fatal — the Name cell falls
            // back to FirstName + LastName when the lookup is empty.
            try
            {
                var sals = await CodedValuesApi.GetChildrenByParentCodeAsync(
                    CodedValueParent.Salutations.ToCode(), ct) ?? [];
                _salutations = sals.ToDictionary(s => s.Id, s => s.Name);
            }
            catch
            {
                _salutations = new Dictionary<Guid, string>();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load guardians for student {StudentId}", Id);
            _guardianError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private string? ResolveRelName(Guid? id)
        => id is { } g && _relNames.TryGetValue(g, out var n) ? n : null;

    private string? ResolveSalutation(Guid? id)
        => id is { } g && _salutations.TryGetValue(g, out var n) ? n : null;

    // ── Contact history ────────────────────────────────────────────────

    private async Task LoadContactHistoryAsync(CancellationToken ct)
    {
        _contactHistoryLoading = true;
        _contactHistoryError = null;
        try
        {
            var entries = await Api.ListContactAuditEntriesAsync(
                ownerType: ContactOwnerType.Student,
                ownerId: Id,
                ct: ct) ?? [];
            _contactHistory = entries;
        }
        catch (OperationCanceledException)
        {
            // Expected on navigation away.
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load contact history for student {StudentId}", Id);
            _contactHistoryError = ex.Message;
        }
        finally
        {
            _contactHistoryLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static Appearance ChangeKindBadgeAppearance(string changeKind)
        => changeKind == "Deleted" ? Appearance.Accent : Appearance.Neutral;

    private static string FormatHistoryValue(string? channel, string? value, string? countryCode)
    {
        if (string.IsNullOrWhiteSpace(channel) || string.IsNullOrWhiteSpace(value))
            return "—";
        var prefix = channel == ContactChannel.SMS.ToString() || channel == ContactChannel.WhatsApp.ToString()
            ? (string.IsNullOrWhiteSpace(countryCode) ? null : countryCode)
            : null;
        return prefix is null ? value : $"{prefix} {value}";
    }

    // ── Activity Groups actions (spec §3.6 FR-28..32) ────────────────────

    private async Task LoadStudentGroupsAsync(CancellationToken ct)
    {
        try
        {
            _studentGroups = await Api.ListStudentGroupsAsync(Id, ct) ?? Array.Empty<ActivityGroupDto>();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load activity groups for student {StudentId}", Id);
            _activityGroupsError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Opens the JoinGroupsDialog (FR-29/FR-30) — a searchable multi-select of
    /// available groups the student is not already an active member of.
    /// Accepted groups create memberships; per-group failures are surfaced in
    /// the dialog. On any success the section reloads.
    /// </summary>
    private async Task OnJoinGroupAsync()
    {
        if (_disposed || _student is null || _savingGroupAction) return;
        _activityGroupsError = null;
        try
        {
            var result = await DialogService.ShowShellDialogAsync<
                JoinGroupsDialog,
                JoinGroupsDialog.JoinGroupsModel,
                JoinGroupsDialog.JoinGroupsResult>(
                new JoinGroupsDialog.JoinGroupsModel { StudentId = Id },
                "Join group",
                DialogSize.Medium);

            if (result is null || _disposed) return;
            await LoadStudentGroupsAsync(_loadCts?.Token ?? CancellationToken.None);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to join group for student {StudentId}", Id);
            _activityGroupsError = ex.Message;
        }
    }

    /// <summary>
    /// Exits the student from the given group (FR-31). The group is passed as
    /// the activity-group id; the membership is looked up by the API.
    /// </summary>
    private async Task OnLeaveGroupAsync(Guid groupId)
    {
        if (_disposed || _savingGroupAction) return;
        _activityGroupsError = null;
        _savingGroupAction = true;
        try
        {
            await Api.RemoveGroupMemberAsync(groupId, Id);
            await LoadStudentGroupsAsync(_loadCts?.Token ?? CancellationToken.None);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to leave group {GroupId} for student {StudentId}", groupId, Id);
            _activityGroupsError = ex.Message;
        }
        finally
        {
            _savingGroupAction = false;
        }
    }

    /// <summary>
    /// Badge appearance for a group status in the Activity Groups section.
    /// Active groups are accented; Exited/Removed/Suspended fall back to
    /// neutral so the section's visual language matches the group details page.
    /// </summary>
    private static Appearance GroupStatusBadge(string status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            ? Appearance.Accent
            : Appearance.Neutral;

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
