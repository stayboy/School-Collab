@page "/students/{id:guid}"
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Authoring
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Core.Features
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Students.Core.Contracts
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Detail> Logger
@inject VisibleTenantService VisibleTenant
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Student — @(_student?.FirstName ?? "Loading…") @_student?.LastName</PageTitle>

<ErrorBoundary>
    <ChildContent>
        @* TenantGate wraps the whole page: student records are tenant-scoped, so there is nothing to draw
           an identity header from without a tenant. *@
        <TenantGate>
            <ChildContent>
                @if (_student is null)
                {
                    <div class="spinner-container">
                        <FluentSpinner />
                    </div>
                }
                else
                {
                    @* The page action header owns the identity and the page kebab (§4 of
                       documents/solution/panel-layout-pattern.md). This surface has no primary action —
                       the view page commits nothing, so PrimaryLabel stays null and the kebab carries the
                       page-level actions (owner Q120: back-navigation moves up here, out of a footer). *@
                    <AuthoringShell Crumbs="@ShellCrumbs">
                        <TitleContent>
                            <span class="student-monogram" style="@MonogramStyle" aria-hidden="true">@MonogramInitials</span>
                            <span class="student-title">@FullName</span>
                        </TitleContent>

                        <Badge>
                            @if (_student.IsDeleted)
                            {
                                <span class="status-pill status-pill--danger">
                                    <span class="status-pill__dot" aria-hidden="true"></span>Archived
                                </span>
                            }
                            else if (ActiveEnrollment is not null)
                            {
                                <span class="status-pill status-pill--success">
                                    <span class="status-pill__dot" aria-hidden="true"></span>Enrolled
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--warning">
                                    <span class="status-pill__dot" aria-hidden="true"></span>Not enrolled
                                </span>
                            }
                            @if (CurrentGradeLabel is { } grade)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Tint">@grade</FluentBadge>
                            }
                            @if (CurrentPeriodLabel is { } period)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Tint">@period</FluentBadge>
                            }
                        </Badge>

                        <TitleMenu>
                            <RowActionsMenu UseMenuService="false"
                                            ForceKebab="true"
                                            Actions="@PageActions"
                                            AriaLabel="Page actions" />
                        </TitleMenu>

                        <ChildContent>
                            <p class="student-meta" id="student-view-meta">
                                <code>@_student.StudentNumber</code>
                                <span class="student-meta__sep" aria-hidden="true">·</span>
                                <span>@AgeText</span>
                                <span class="student-meta__sep" aria-hidden="true">·</span>
                                <span>@GenderText</span>
                                <span class="student-meta__sep" aria-hidden="true">·</span>
                                <span>@GuardianCountText</span>
                                <span class="student-meta__sep" aria-hidden="true">·</span>
                                <span>@GroupCountText</span>
                            </p>

                            <div class="region-grid-host">
                                <div class="region-grid">

                                    @* ── Main column: the student's own data, then its people ───────── *@
                                    <div class="region-grid__main">

                                        <PanelSection Id="student-view-details"
                                                      Title="Details"
                                                      TitleId="student-view-details-title"
                                                      ShowBorder="false">
                                            <div class="fact-grid">
                                                <FieldDisplay Label="Student #"><code>@_student.StudentNumber</code></FieldDisplay>
                                                <FieldDisplay Label="Date of birth">@(_student.DateOfBirth?.ToString("d MMM yyyy") ?? "—")</FieldDisplay>
                                                <FieldDisplay Label="Age">@AgeText</FieldDisplay>
                                                <FieldDisplay Label="Gender">@GenderText</FieldDisplay>
                                                <FieldDisplay Label="Record created">@_student.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</FieldDisplay>
                                                <FieldDisplay Label="Last updated">@_student.UpdatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</FieldDisplay>
                                            </div>
                                        </PanelSection>

                                        @* ── Enrollment: where the student is now, then where they have been ── *@
                                        <PanelSection Id="student-view-enrollment"
                                                      Title="Enrollment"
                                                      TitleId="student-view-enrollment-title"
                                                      ShowBorder="false"
                                                      Count="@_enrollments?.Length">
                                            <HeaderActions>
                                                <RowActionsMenu UseMenuService="false"
                                                                ForceKebab="true"
                                                                Actions="@EnrollmentPanelActions"
                                                                AriaLabel="Enrollment actions" />
                                            </HeaderActions>
                                            <ChildContent>
                                                @if (_enrollments is null)
                                                {
                                                    <div class="spinner-container">
                                                        <FluentSpinner />
                                                    </div>
                                                }
                                                else if (_enrollments.Length == 0)
                                                {
                                                    <FluentMessageBar Intent="MessageBarIntent.Info">
                                                        No enrollments yet — use Enroll to add the first one.
                                                    </FluentMessageBar>
                                                }
                                                else
                                                {
                                                    @if (ActiveEnrollment is { } current)
                                                    {
                                                        @* An inline zone, not a panel (§3): the current placement as
                                                           three labelled facts plus how long it has been in force. *@
                                                        <div class="placement" id="student-view-placement">
                                                            <div class="placement__cell">
                                                                <span class="placement__label">Current grade</span>
                                                                <span class="placement__value">@PlacementLabel(current)</span>
                                                            </div>
                                                            <div class="placement__cell">
                                                                <span class="placement__label">Period</span>
                                                                <span class="placement__value">@PeriodLabel(current)</span>
                                                            </div>
                                                            <div class="placement__cell">
                                                                <span class="placement__label">Enrolled since</span>
                                                                <span class="placement__value">@current.EnrolledOn.ToString("d MMM yyyy")</span>
                                                            </div>
                                                            @if (DaysInPlacement(current) is { } days)
                                                            {
                                                                <div class="placement__gap"></div>
                                                                <div class="placement__aside">@DaysText(days) in this placement</div>
                                                            }
                                                        </div>
                                                    }

                                                    <div class="subrule">Placement history</div>

                                                    <ul class="tl">
                                                        @foreach (var enrollment in _enrollments.OrderByDescending(e => e.EnrolledOn))
                                                        {
                                                            var isCurrent = IsActiveEnrollment(enrollment);
                                                            <li class="tl__item @(isCurrent ? "tl__item--current" : null)">
                                                                <span class="tl__node" aria-hidden="true"></span>
                                                                <div class="tl__row">
                                                                    <span class="tl__grade">@PlacementLabel(enrollment)</span>
                                                                    @if (isCurrent)
                                                                    {
                                                                        <span class="status-pill status-pill--success">
                                                                            <span class="status-pill__dot" aria-hidden="true"></span>Current
                                                                        </span>
                                                                    }
                                                                    else if (enrollment.ExitDate is { } exit)
                                                                    {
                                                                        <span class="status-pill status-pill--neutral">
                                                                            <span class="status-pill__dot" aria-hidden="true"></span>Exited @exit.ToString("d MMM yyyy")
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="status-pill status-pill--neutral">
                                                                            <span class="status-pill__dot" aria-hidden="true"></span>@enrollment.Status
                                                                        </span>
                                                                    }
                                                                    @{
                                                                        var nodeActions = NodeActions(enrollment);
                                                                    }
                                                                    @if (nodeActions.Count > 0)
                                                                    {
                                                                        <span class="tl__actions">
                                                                            <RowActionsMenu UseMenuService="false"
                                                                                            Actions="@nodeActions"
                                                                                            AriaLabel="Placement actions" />
                                                                        </span>
                                                                    }
                                                                </div>
                                                                <div class="tl__meta">@PlacementMeta(enrollment)</div>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                        @* ── Contacts: the student's OWN contacts (§1.6 of the redesign doc).
                                           The page used to render contact HISTORY without ever showing the current
                                           list; these two blocks answer one question and must stay adjacent. *@
                                        <PanelSection Id="student-view-contacts"
                                                      Title="Contacts"
                                                      TitleId="student-view-contacts-title"
                                                      ShowBorder="false"
                                                      Count="@_contacts?.Length">
                                            <ChildContent>
                                                @if (!string.IsNullOrEmpty(_contactsError))
                                                {
                                                    <FriendlyErrorBar Message="@_contactsError" />
                                                }
                                                @if (_contacts is null)
                                                {
                                                    <div class="spinner-container">
                                                        <FluentSpinner />
                                                    </div>
                                                }
                                                else if (_contacts.Length == 0)
                                                {
                                                    <p class="muted-note" id="student-view-contacts-empty">
                                                        No contacts recorded for this student. Guardians below carry
                                                        their own.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <div class="contact-chips">
                                                        @foreach (var contact in _contacts)
                                                        {
                                                            <span class="contact-chip" @key="contact.Id">
                                                                <span class="contact-chip__channel">@ContactChannelLabel(contact.Channel)</span>
                                                                @ContactValue(contact)
                                                                @if (!string.IsNullOrWhiteSpace(contact.Label))
                                                                {
                                                                    <span class="contact-chip__note">@contact.Label</span>
                                                                }
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                @if (_contacts is { Length: > 0 })
                                                {
                                                    <p class="muted-note">
                                                        This student's <strong>own</strong> contacts — guardians' contacts live on
                                                        their cards below. Edited on <strong>Edit</strong>.
                                                    </p>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                        <PanelSection Id="student-view-guardians"
                                                      Title="Guardians"
                                                      TitleId="student-view-guardians-title"
                                                      ShowBorder="false"
                                                      Count="@_links.Count">
                                            <HeaderActions>
                                                <RowActionsMenu UseMenuService="false"
                                                                Actions="@GuardianPanelActions"
                                                                AriaLabel="Guardian actions" />
                                            </HeaderActions>
                                            <ChildContent>
                                                @if (!string.IsNullOrEmpty(_guardianError))
                                                {
                                                    <FluentMessageBar Intent="MessageBarIntent.Error">@_guardianError</FluentMessageBar>
                                                }
                                                @if (_links.Count == 0)
                                                {
                                                    <p class="muted-note" id="student-view-guardians-empty">
                                                        No guardians linked yet — use Manage to add one.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <ul class="guardian-cards">
                                                        @foreach (var link in _links)
                                                        {
                                                            <li class="guardian-card" @key="link.GuardianId">
                                                                <span class="student-monogram student-monogram--sm"
                                                                      style="@GuardianMonogramStyle(link)" aria-hidden="true">@GuardianInitials(link)</span>
                                                                <div class="guardian-card__body">
                                                                    <div class="guardian-card__top">
                                                                        <span class="guardian-card__name">@GuardianName(link)</span>
                                                                        @if (ResolveRelName(link.RelationshipCodedValueId) is { } rel)
                                                                        {
                                                                            <FluentBadge Appearance="BadgeAppearance.Tint">@rel</FluentBadge>
                                                                        }
                                                                        @if (link.IsEmergencyContact)
                                                                        {
                                                                            <FluentBadge Appearance="BadgeAppearance.Tint">Emergency contact</FluentBadge>
                                                                        }
                                                                        @if (link.Role == GuardianRole.Primary)
                                                                        {
                                                                            <span class="guardian-card__primary">Primary</span>
                                                                        }
                                                                        <span class="guardian-card__actions">
                                                                            <RowActionsMenu UseMenuService="false"
                                                                                            Actions="@GuardianRowActions(link)"
                                                                                            AriaLabel="@($"Actions for {GuardianName(link)}")" />
                                                                        </span>
                                                                    </div>
                                                                    <div class="contact-chips">
                                                                        @foreach (var contact in link.Contacts.Take(3))
                                                                        {
                                                                            <span class="contact-chip">
                                                                                <span class="contact-chip__channel">@ContactChannelLabel(contact.Channel)</span>
                                                                                @GuardianContactValue(contact)
                                                                            </span>
                                                                        }
                                                                        @if (link.HasMoreContacts)
                                                                        {
                                                                            <button type="button"
                                                                                    class="contact-chip__more"
                                                                                    @onclick="() => OnViewAllContactsAsync(link)">
                                                                                View all @link.TotalContactCount contacts
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                    </div>

                                    @* ── Rail: relationships and the audit trail ─────────────────────── *@
                                    <div class="region-grid__rail">

                                        @* ── Assignments: the student's six counts (issue #444, layer L2b). FIRST in the
                                           rail (owner Q124) — it is what a form tutor opens this page to check. A
                                           DERIVED panel, admissible in the rail by §5: it presents counts over other
                                           aggregates. The funnel is computed here from the six counts (Q155), and a
                                           payload that contradicts itself renders unavailable — never a clamped chart. *@
                                        <PanelSection Id="student-view-assignments"
                                                      Title="Assignments"
                                                      TitleId="student-view-assignments-title"
                                                      Count="@AssignmentStatsCount">
                                            <ChildContent>
                                                @if (_assignmentStatsUnavailable || (_assignmentStats is not null && Funnel is null))
                                                {
                                                    @* A failed hop, or a payload whose counts contradict each other, states the
                                                       FACT and shows no numbers at all: zeros are a claim, unavailable is a fact
                                                       (Q153). No count chip either — AssignmentStatsCount is null here. *@
                                                    <p class="muted-note" id="student-view-assignments-unavailable">
                                                        Assignment stats are unavailable right now.
                                                    </p>
                                                }
                                                else if (_assignmentStats is not { } stats)
                                                {
                                                    <div class="spinner-container">
                                                        <FluentSpinner />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="stat-grid">
                                                        <div class="stat">
                                                            <div class="stat__value">@stats.Assigned</div>
                                                            <div class="stat__label">Assigned</div>
                                                        </div>
                                                        <div class="stat">
                                                            <div class="stat__value">@stats.SentOut</div>
                                                            <div class="stat__label">Sent out</div>
                                                        </div>
                                                        <div class="stat">
                                                            <div class="stat__value">@stats.Submitted</div>
                                                            <div class="stat__label">Submitted</div>
                                                        </div>
                                                        <div class="stat stat--marked">
                                                            <div class="stat__value">@stats.Marked</div>
                                                            <div class="stat__label">Marked</div>
                                                        </div>
                                                    </div>

                                                    @if (stats.Assigned == 0)
                                                    {
                                                        @* No bars at zero (Q154): a bar at 0% implies "0% of something", and
                                                           the counts above already say the whole truth. *@
                                                        <p class="muted-note" id="student-view-assignments-empty">
                                                            No assignments for this student yet.
                                                        </p>
                                                    }
                                                    else
                                                    {
                                                        var funnel = Funnel!.Value;

                                                        @* Axis 1 — the work's progress, totalling Assigned. *@
                                                        <div class="stat-bar" role="img" aria-label="@FunnelLabel(stats, funnel)">
                                                            <span class="stat-bar__seg stat-bar__seg--not-sent" style="@SegmentFlex(funnel.NotSent)"></span>
                                                            <span class="stat-bar__seg stat-bar__seg--awaiting-submission" style="@SegmentFlex(funnel.AwaitingSubmission)"></span>
                                                            <span class="stat-bar__seg stat-bar__seg--awaiting-marking" style="@SegmentFlex(funnel.AwaitingMarking)"></span>
                                                            <span class="stat-bar__seg stat-bar__seg--marked" style="@SegmentFlex(funnel.Marked)"></span>
                                                        </div>

                                                        @* Every segment is named in text as well as coloured (Q141 of the page
                                                           round): the swatch is the only decoration it owns. *@
                                                        <div class="stat-legend">
                                                            <span class="stat-legend__item"><i class="stat-bar__seg stat-bar__seg--not-sent" aria-hidden="true"></i><b>@funnel.NotSent</b> not sent</span>
                                                            <span class="stat-legend__item"><i class="stat-bar__seg stat-bar__seg--awaiting-submission" aria-hidden="true"></i><b>@funnel.AwaitingSubmission</b> awaiting submission</span>
                                                            <span class="stat-legend__item"><i class="stat-bar__seg stat-bar__seg--awaiting-marking" aria-hidden="true"></i><b>@funnel.AwaitingMarking</b> awaiting marking</span>
                                                            <span class="stat-legend__item"><i class="stat-bar__seg stat-bar__seg--marked" aria-hidden="true"></i><b>@funnel.Marked</b> marked</span>
                                                        </div>

                                                        @* Axis 2 — the guardian-review gate, over its OWN denominator. It is an overlay on
                                                           the sent set, not the next step after marking, so it never reads "of Assigned".
                                                           Rendering nothing when nothing requires review follows Q154: a bar at 0% implies
                                                           "0% of something". *@
                                                        @if (stats.ReviewRequired > 0)
                                                        {
                                                            <div class="stat-caption">Guardian review</div>
                                                            <div class="stat-bar" role="img" aria-label="@ReviewBarLabel(stats, funnel)">
                                                                <span class="stat-bar__seg stat-bar__seg--reviewed" style="@SegmentFlex(funnel.Reviewed)"></span>
                                                                <span class="stat-bar__seg stat-bar__seg--awaiting-review" style="@SegmentFlex(funnel.AwaitingReview)"></span>
                                                            </div>
                                                            <p class="stat-foot" id="student-view-assignments-review-foot">
                                                                <b>@funnel.Reviewed of @stats.ReviewRequired</b> reviewed · <b>@funnel.AwaitingReview</b> awaiting — required on @stats.ReviewRequired of the @stats.SentOut sent.
                                                            </p>
                                                        }
                                                    }
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                        <PanelSection Id="student-view-groups"
                                                      Title="Activity groups"
                                                      TitleId="student-view-groups-title"
                                                      Collapsible="true"
                                                      Count="@_studentGroups?.Length">
                                            <HeaderActions>
                                                <RowActionsMenu UseMenuService="false"
                                                                ForceKebab="true"
                                                                Actions="@GroupPanelActions"
                                                                AriaLabel="Activity group actions" />
                                            </HeaderActions>
                                            <ChildContent>
                                                @if (!string.IsNullOrEmpty(_activityGroupsError))
                                                {
                                                    <FluentMessageBar Intent="MessageBarIntent.Error">@_activityGroupsError</FluentMessageBar>
                                                }
                                                @if (_studentGroups is null)
                                                {
                                                    <div class="spinner-container">
                                                        <FluentSpinner />
                                                    </div>
                                                }
                                                else if (_studentGroups.Length == 0)
                                                {
                                                    <p class="muted-note" id="student-view-groups-empty">
                                                        Not a member of any activity groups yet.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <RailChips>
                                                        @foreach (var group in _studentGroups)
                                                        {
                                                            @* Category is OPTIONAL free text (ActivityGroup.cs FR-1), so an
                                                               empty one renders nothing — never an em dash. *@
                                                            <RailChip @key="group.Id"
                                                                      Text="@group.Name"
                                                                      Disabled="@_savingGroupAction"
                                                                      OnRemove="() => OnLeaveGroupAsync(group.Id)">
                                                                <span class="group-chip">
                                                                    <span>@group.Name</span>
                                                                    @if (!string.IsNullOrWhiteSpace(group.Category))
                                                                    {
                                                                        <span class="group-chip__category">@group.Category</span>
                                                                    }
                                                                </span>
                                                            </RailChip>
                                                        }
                                                    </RailChips>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                        @* ── Subjects: the §6 union for the active placement's grade. Reuse —
                                           GET /students/{id}/subjects and both RailBand variants already exist;
                                           the view page simply never called them. *@
                                        <PanelSection Id="student-view-subjects"
                                                      Title="Subjects"
                                                      TitleId="student-view-subjects-title"
                                                      Count="@_subjects?.Count">
                                            <ChildContent>
                                                @if (!string.IsNullOrEmpty(_subjectsError))
                                                {
                                                    <FriendlyErrorBar Message="@_subjectsError" />
                                                }
                                                @if (_subjects is null)
                                                {
                                                    <div class="spinner-container">
                                                        <FluentSpinner />
                                                    </div>
                                                }
                                                else if (_subjects.Count == 0)
                                                {
                                                    <p class="muted-note" id="student-view-subjects-empty">
                                                        @* States the OUTCOME, not a fact about the grade: "nothing
                                                           resolved for this placement" is true both when the grade has no
                                                           subjects and when the placement's period matched none — this branch
                                                           cannot tell those apart (owner ruling, round 13: sub-periods are
                                                           informational, and belong on the assignment, not here). Do not
                                                           restate it as "the grade has no subjects". *@
                                                        @(ActiveEnrollment is null
                                                            ? "Subjects follow the placement — this student has no active enrollment."
                                                            : "No subjects could be resolved for this placement.")
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="muted-note" id="student-view-subjects-source">
                                                        From <strong>@CurrentGradeLabel</strong> — the grade of the current placement.
                                                    </p>

                                                    @if (RequiredSubjects.Count > 0)
                                                    {
                                                        <RailBand Id="student-view-subjects-required"
                                                                  Label="Needs explicit enrolment"
                                                                  Hint="@RequiredHint"
                                                                  Variant="RailBandVariant.Required">
                                                            <RailChips>
                                                                @foreach (var subject in RequiredSubjects)
                                                                {
                                                                    @* Enrolled = a fact; missing = struck WITH the
                                                                       reason, and not actionable here: FR-ER-24 makes the
                                                                       edit page the enrolment surface. *@
                                                                    @if (subject.IsEnrolled)
                                                                    {
                                                                        <RailChip @key="@($"{subject.TopicId}-in")" Text="@subject.Name" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <RailChip @key="@($"{subject.TopicId}-missing")"
                                                                                  Text="@subject.Name"
                                                                                  Blocked="true"
                                                                                  Reason="choose it on the Edit page" />
                                                                    }
                                                                }
                                                            </RailChips>
                                                        </RailBand>
                                                    }

                                                    @if (AssumedSubjects.Count > 0)
                                                    {
                                                        <RailBand Id="student-view-subjects-assumed"
                                                                  Label="Assumed"
                                                                  Hint="@AssumedHint"
                                                                  Variant="RailBandVariant.Assumed">
                                                            <RailChips>
                                                                @foreach (var subject in AssumedSubjects)
                                                                {
                                                                    @* Implied enrolment (FR-ER-1): membership IS the
                                                                       enrolment, so there is no record and nothing to act on. *@
                                                                    <RailChip @key="subject.TopicId" Text="@subject.Name" />
                                                                }
                                                            </RailChips>
                                                        </RailBand>
                                                    }
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                        <PanelSection Id="student-view-contact-history"
                                                      Title="Contact history"
                                                      TitleId="student-view-contact-history-title"
                                                      Collapsible="true"
                                                      Count="@_contactHistory.Length">
                                            <ChildContent>
                                                <p class="muted-note" id="student-view-contact-history-source">
                                                    Audit of the <strong>student's own</strong> contacts — guardian edits do
                                                    not appear here.
                                                </p>
                                                @if (_contactHistoryLoading)
                                                {
                                                    <div class="spinner-container"><FluentSpinner /></div>
                                                }
                                                else if (!string.IsNullOrEmpty(_contactHistoryError))
                                                {
                                                    <FluentMessageBar Intent="MessageBarIntent.Error">@_contactHistoryError</FluentMessageBar>
                                                }
                                                else if (_contactHistory.Length == 0)
                                                {
                                                    <p class="muted-note" id="student-view-contact-history-empty">
                                                        No contact changes recorded yet.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <ul class="student-contact-history">
                                                        @foreach (var entry in _contactHistory)
                                                        {
                                                            <li class="student-contact-history__entry">
                                                                <div class="student-contact-history__meta">
                                                                    <span class="student-contact-history__actor">@entry.ActorDisplayName</span>
                                                                    <span class="muted">· @entry.OccurredAt.ToLocalTime().ToString("g")</span>
                                                                </div>
                                                                <div class="student-contact-history__change">
                                                                    @* A change KIND is a state, so it is a pill — the same four-variant
                                                                       vocabulary the page header uses. Not a FluentBadge: a deletion must
                                                                       read as destructive, and v5's BadgeColor is only reliable for the
                                                                       four colours it actually paints (Success is a dead rule). *@
                                                                    <span class="status-pill @ChangeKindPillClass(entry.ChangeKind)">
                                                                        <span class="status-pill__dot" aria-hidden="true"></span>@entry.ChangeKind
                                                                    </span>
                                                                    <span class="student-contact-history__value-line">
                                                                        @FormatHistoryValue(entry.PreviousChannel, entry.PreviousValue, entry.PreviousCountryCode)
                                                                        @if (entry.ChangeKind == "Updated")
                                                                        {
                                                                            <text> → @FormatHistoryValue(entry.NewChannel, entry.NewValue, entry.NewCountryCode)</text>
                                                                        }
                                                                    </span>
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                                                {
                                                                    <div class="student-contact-history__reason muted">Reason: @entry.Reason</div>
                                                                }
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(_error))
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-3">@_error</FluentMessageBar>
                            }
                        </ChildContent>
                    </AuthoringShell>
                }
            </ChildContent>
            <Fallback>
                <FluentMessageBar Intent="MessageBarIntent.Warning">
                    You have no tenant assigned. Student records are tenant-scoped — pick a tenant to continue.
                </FluentMessageBar>
            </Fallback>
        </TenantGate>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageBarIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public Guid Id { get; set; }

    private StudentDto? _student;
    private StudentEnrollmentDto[]? _enrollments;
    private Dictionary<Guid, string> _gradeLevelNames = new();
    private Dictionary<Guid, string> _periodNames = new();
    private Dictionary<Guid, string> _streamNames = new();
    private string? _error;
    private bool _savingEnrollment;
    private bool _isRealTenant;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // ── Guardian link state (page-owned) ──
    //
    // The view page has no Save flow of its own, so every
    // link / unlink / edit is IMMEDIATE. The page owns the link
    // list, the dialog opens, and the API calls; each guardian
    // renders as a card whose kebab raises the handlers below.
    private List<SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto> _links = new();
    private Dictionary<Guid, string> _relNames = new();
    // Spec §4.8: salutation (title) lookup for the guardian card's name,
    // in the card's accessible label and in the contacts dialog's title.
    // Loaded once per page load; covers Mr/Mrs/Ms/etc. across all linked
    // guardians. Empty when salutations aren't configured for the tenant.
    private Dictionary<Guid, string> _salutations = new();
    private string? _guardianError;

    // ── Contact history state (append-only audit log) ──
    private SchoolCollab.Students.Core.DTOs.ContactAuditEntryDto[] _contactHistory = [];
    private bool _contactHistoryLoading;
    private string? _contactHistoryError;

    // ── Activity Groups section state (spec §3.6 FR-28..32) ──
    // Groups the student is an active member of, loaded in parallel with the
    // guardians list. Join Group opens JoinGroupsDialog; Leave exits the
    // student from that group. Both actions are immediate (view page has no
    // Save flow) and reload the list on success.
    private SchoolCollab.Students.Core.DTOs.ContactDto[]? _contacts;
    private string? _contactsError;

    // ── Subject bands (subject-enrollment-requirement-flag.md §6 union, FR-ER-16/17) ──
    // Same query the edit rail uses. Null = not loaded yet, so "not loaded" never reads as
    // "no subjects"; the two bands render nothing until it arrives.
    private List<SchoolCollab.Students.Core.DTOs.StudentSubjectEnrollmentDto>? _subjects;
    private string? _subjectsError;

    private ActivityGroupDto[]? _studentGroups;
    private string? _activityGroupsError;
    private bool _savingGroupAction;

    // ── Assignment stats state (issue #444, layer L2b) ──
    // A TRI-STATE, and it needs two fields: `null` alone means both "not loaded yet" and "the hop failed",
    // so it cannot drive three render states. `null` + this flag false = spinner; `null` + true = the
    // unavailable line; non-null = the panel. Without the flag the panel either flashes "unavailable"
    // during every load or never shows it at all.
    private SchoolCollab.Students.Core.DTOs.StudentAssignmentStats? _assignmentStats;
    private bool _assignmentStatsUnavailable;

    /// <summary>
    /// The funnel segments, derived HERE from the six counts (owner Q155) — never sent pre-computed, because a
    /// <c>Draft</c> field on the wire could disagree with <c>Assigned − SentOut</c>. <c>null</c> means either
    /// "not loaded" or "the payload contradicts itself": a negative difference (<c>Marked &gt; Submitted</c>,
    /// <c>SentOut &gt; Assigned</c>, <c>Reviewed &gt; ReviewRequired</c>) is inconsistent data, and the panel
    /// renders the unavailable state instead of a chart that lies. Never clamped.
    /// </summary>
    private AssignmentFunnel? Funnel
    {
        get
        {
            if (_assignmentStats is not { } stats) return null;

            var notSent = stats.Assigned - stats.SentOut;
            var awaitingSubmission = stats.SentOut - stats.Submitted;
            var awaitingMarking = stats.Submitted - stats.Marked;
            var awaitingReview = stats.ReviewRequired - stats.Reviewed;

            if (notSent < 0 || awaitingSubmission < 0 || awaitingMarking < 0 || awaitingReview < 0)
                return null;

            return new AssignmentFunnel(
                notSent, awaitingSubmission, awaitingMarking, stats.Marked,
                stats.Reviewed, awaitingReview);
        }
    }

    /// <summary>
    /// The panel's header count — <c>Assigned</c> while the count set is coherent, otherwise nothing at all:
    /// the unavailable state carries NO numbers, not even in the header (Q153).
    /// </summary>
    private int? AssignmentStatsCount =>
        !_assignmentStatsUnavailable && Funnel is not null ? _assignmentStats?.Assigned : null;

    /// <summary>The four funnel segments plus the two review-axis ones, all derived (see <see cref="Funnel"/>).</summary>
    private readonly record struct AssignmentFunnel(
        int NotSent,
        int AwaitingSubmission,
        int AwaitingMarking,
        int Marked,
        int Reviewed,
        int AwaitingReview);

    /// <summary>A segment's share of its bar: the count IS the weight, so the bar is proportional without any
    /// percentage arithmetic a reader cannot check against the legend.</summary>
    private static string SegmentFlex(int count) => $"flex: {count} 1 0;";

    /// <summary>The funnel bar's accessible label, naming the four counts rather than relying on colour.</summary>
    private static string FunnelLabel(
        SchoolCollab.Students.Core.DTOs.StudentAssignmentStats stats, AssignmentFunnel funnel) =>
        $"{stats.Assigned} assigned: {funnel.NotSent} not sent, {funnel.AwaitingSubmission} awaiting submission, "
        + $"{funnel.AwaitingMarking} awaiting marking, {funnel.Marked} marked";

    /// <summary>The review bar's accessible label, stated over its own denominator."</summary>
    private static string ReviewBarLabel(
        SchoolCollab.Students.Core.DTOs.StudentAssignmentStats stats, AssignmentFunnel funnel) =>
        $"Guardian review: {funnel.Reviewed} reviewed, {funnel.AwaitingReview} awaiting review, "
        + $"required on {stats.ReviewRequired} of the {stats.SentOut} sent";

    /// <summary>
    /// The student's currently-active enrollment. Active = no exit date AND
    /// status == "Active". Falls back to the most recent enrollment that
    /// has no exit date when none is strictly "Active" (e.g. mid-transfer
    /// transient states).
    /// </summary>
    private StudentEnrollmentDto? ActiveEnrollment =>
        _enrollments?.FirstOrDefault(e => e.ExitDate is null
            && string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase))
        ?? _enrollments?.FirstOrDefault(e => e.ExitDate is null);

    /// <summary>
    /// Predicate form of <see cref="ActiveEnrollment"/> for use in grid row
    /// templates, where we have a specific row's enrollment in scope rather
    /// than the whole list. Same criteria (no exit date AND status == "Active").
    /// </summary>
    private static bool IsActiveEnrollment(StudentEnrollmentDto e) =>
        e.ExitDate is null
        && string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase);

    private string? CurrentGradeName =>
        ActiveEnrollment is { } e && _gradeLevelNames.TryGetValue(e.GradeLevelId, out var n)
            ? n
            : null;

    /// <summary>
    /// Enriched title line: "First Last (Gender, Age)". Uses em-dash for
    /// missing demographics so the visual shape is stable. Age is computed
    /// from DateOfBirth against today.
    /// </summary>
    private string TitleLine
    {
        get
        {
            if (_student is null) return "Loading…";
            var name = $"{_student.FirstName} {_student.LastName}".Trim();
            var gender = string.IsNullOrWhiteSpace(_student.GenderName) ? "—" : _student.GenderName;
            var age = AgeFromDob(_student.DateOfBirth);
            var ageText = age.HasValue ? age.Value.ToString() : "—";
            return string.IsNullOrEmpty(name) ? _student.StudentNumber : $"{name} ({gender}, {ageText})";
        }
    }

    private static int? AgeFromDob(DateOnly? dob)
    {
        if (dob is null) return null;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var age = today.Year - dob.Value.Year;
        if (today < dob.Value.AddYears(age)) age--;
        return age < 0 ? null : age;
    }

    // ── Identity header ──────────────────────────────────────────────────────────────────────

    /// <summary>The trail (§4 of panel-layout-pattern.md). "Students" links back; Q120 moved the old
    /// footer "Back to Students" button up here, so the page has no navigation control below the fold.</summary>
    private IReadOnlyList<AuthoringCrumb> ShellCrumbs =>
        [new AuthoringCrumb("Students", "/students"), new AuthoringCrumb(FullName)];

    private string FullName => _student is null
        ? "…"
        : $"{_student.FirstName} {_student.LastName}".Trim();

    private string AgeText => AgeFromDob(_student?.DateOfBirth) is { } age ? $"{age} years" : "—";

    private string GenderText => string.IsNullOrWhiteSpace(_student?.GenderName) ? "—" : _student!.GenderName!;

    private string GuardianCountText => _links.Count == 1 ? "1 guardian" : $"{_links.Count} guardians";

    private string GroupCountText => _studentGroups is null
        ? "activity groups …"
        : _studentGroups.Length == 1 ? "1 activity group" : $"{_studentGroups.Length} activity groups";

    private string CurrentGradeLabel => ActiveEnrollment is { } e ? PlacementLabel(e) : null;

    private string CurrentPeriodLabel =>
        ActiveEnrollment is { } e && _periodNames.TryGetValue(e.PeriodId, out var p) ? p : null;

    /// <summary>Initials for the monogram. Two letters, derived — never a stored avatar (Q117: inline
    /// markup, not a component; there is no image upload behind it).</summary>
    private string MonogramInitials
    {
        get
        {
            if (_student is null) return "?";
            var first = _student.FirstName.Trim();
            var last = _student.LastName.Trim();
            return $"{(first.Length > 0 ? first[0] : '?')}{(last.Length > 0 ? last[0] : '?')}".ToUpperInvariant();
        }
    }

    /// <summary>
    /// The monogram's tint comes from ONE token pair, never a fixed hue (the dark render of the mock
    /// showed a hue-only disc staying pale lavender on a dark page). The hue is derived from the name so a
    /// student keeps the same colour across visits without storing anything.
    /// </summary>
    private string MonogramStyle => $"--monogram-hue: {HueFor(FullName)}";

    private string GuardianMonogramStyle(SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto link) =>
        $"--monogram-hue: {HueFor(GuardianName(link))}";

    private string GuardianInitials(SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto link)
    {
        var first = link.FirstName.Trim();
        var last = link.LastName.Trim();
        return $"{(first.Length > 0 ? first[0] : '?')}{(last.Length > 0 ? last[0] : '?')}".ToUpperInvariant();
    }

    private static int HueFor(string text)
    {
        var hash = 0;
        foreach (var c in text)
        {
            hash = (hash * 31 + c) & 0x7FFFFFFF;
        }
        return hash % 360;
    }

    // ── Page / panel / row menus ─────────────────────────────────────────────────────────────

    private IReadOnlyList<RowAction> PageActions =>
    [
        new RowAction { Label = "Edit student…", Href = $"/students/{Id}/edit" },
        new RowAction { Label = "Copy student number", OnClick = CopyStudentNumberAsync, Disabled = _student is null },
        new RowAction { Label = "Back to students", Href = "/students" },
