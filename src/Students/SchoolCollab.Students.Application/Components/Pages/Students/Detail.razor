    // A contact-history entry is Added / Updated / Deleted. A removal is the destructive one and must
    // read as such; the other two are ordinary events. These are STATES, so they use the shared pill
    // vocabulary rather than a FluentBadge whose Success rule is misspelled in v5.
    private static string ChangeKindPillClass(string changeKind) => changeKind switch
    {
        "Deleted" => "status-pill--danger",
        "Added" => "status-pill--success",
        _ => "status-pill--neutral",
    };

    private static string FormatHistoryValue(string? channel, string? value, string? countryCode)
    {
        if (string.IsNullOrWhiteSpace(channel) || string.IsNullOrWhiteSpace(value))
            return "—";
        var prefix = channel == ContactChannel.SMS.ToString() || channel == ContactChannel.WhatsApp.ToString()
            ? (string.IsNullOrWhiteSpace(countryCode) ? null : countryCode)
            : null;
        return prefix is null ? value : $"{prefix} {value}";
    }

