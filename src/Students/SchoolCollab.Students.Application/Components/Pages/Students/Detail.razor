    /// <summary>Transfer / Withdraw belong to the row they change; a closed placement has no actions at
    /// all, so <see cref="RowActionsMenu"/> renders nothing for it (it renders nothing for an empty list).</summary>
    private IReadOnlyList<RowAction> NodeActions(StudentEnrollmentDto enrollment) =>
        IsActiveEnrollment(enrollment)
            ? [
                new RowAction { Label = "Transfer…", OnClick = OnTransferAsync, Disabled = _savingEnrollment },
                new RowAction { Label = "Withdraw…", OnClick = OnWithdrawAsync, Disabled = _savingEnrollment },
