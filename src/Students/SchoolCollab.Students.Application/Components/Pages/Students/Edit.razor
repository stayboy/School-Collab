@page "/students/{id:guid}/edit"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Authoring
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Students.Core.Domain
@using StudentGuardianViewDto = SchoolCollab.Students.Core.DTOs.StudentGuardianViewDto
@using SchoolCollab.Students.Core.Contracts
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Constants
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Edit> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<PageTitle>Edit Student — @(_student?.StudentNumber ?? "Loading…")</PageTitle>

<ErrorBoundary>
    <ChildContent>
        @* The page action header owns Cancel + Save Changes (§4, owner 2026-10-24). The pair used to sit in a
           right-hand sidebar; with it gone that column becomes the sticky RELATIONSHIP RAIL (§5/§6), and the
           grid is the shared `.region-grid` pair from SchoolCollab.Admin.Shared/wwwroot/app.css — nothing
           is re-invented here. *@
        <AuthoringShell Crumbs="@ShellCrumbs"
                       Title="Edit Student"
                       PrimaryId="authoring-primary-action"
                       PrimaryLabel="@(_saving ? "Saving…" : "Save Changes")"
                       PrimaryDisabled="@(_saving || _student is null || !_isRealTenant)"
                       OnPrimaryAction="OnSidebarSaveAsync"
                       LeadingActions="@PageCancel">
            <ChildContent>
                <TenantGate>
                    <ChildContent>
                        @if (_student is null)
                        {
                            <div class="spinner-container">
                                <FluentSpinner />
                            </div>
                        }
                        else
                        {
                            <div class="region-grid-host">
                                <div class="region-grid">

                                    @* ── Main column: the student's own fields, then its contacts ── *@
                                    <div class="region-grid__main">

                                        <PanelSection Id="student-edit-details"
                                                      Title="Details"
                                                      TitleId="student-edit-details-title"
                                                      ShowHeader="false"
                                                      ShowBorder="false">
                                            @* Guardians leave this block for the rail (§5): they present another
                                               aggregate. ShowGuardians="false" — the rail panel renders them. *@
                                            <StudentFormFields @ref="_form"
                                                               Model="_model"
                                                               ShowGuardians="false"
                                                               Mode="StudentFormFieldsMode.Linked"
                                                               StudentId="Id"
                                                               LinkedItems="_links.ToArray()"
                                                               OnManageGuardians="OnManageGuardiansAsync"
                                                               OnRemoveGuardian="OnRemoveGuardianAsync"
                                                               ReadOnlyStudentNumber="true"
                                                               ErrorMessage="@_error"
                                                               OnValidSubmit="OnSaveAsync"
                                                               RenderActions="false" />
                                        </PanelSection>

                                        @* Contacts stay in the MAIN column (owner Q81): they are the student's own
                                           reachability detail rather than a separate relationship, and the editor is a
                                           full inline form — it does not fit a rail. Non-collapsible, like every main block,
                                           and BOXED (owner, 2026-10-24): it is a titled block with its own editor, not a
                                           card-less form row, so it keeps the same frame the create page gives it. *@
                                        <PanelSection Id="student-edit-contacts"
                                                      Title="Contacts"
                                                      TitleId="student-edit-contacts-title">
                                            <ContactsEditor OwnerType="ContactOwnerType.Student"
                                                             OwnerId="@Id"
                                                             ShowSubscription="false" />
                                        </PanelSection>

                                        @* Guardians left this column (owner, 2026-10-24, mock v3): it is a rail
                                           relationship and both pages must present it under Enrollment. *@
                                    </div>

                                    @* ── Rail: one panel per relationship; sticky, never a second pinned row ── *@
                                    <div class="region-grid__rail" id="student-edit-rail">

                                        @* Enrollment — the first rail relationship, and NOT collapsible (owner,
                                           2026-10-24): one read-only fact set with its actions in a kebab. The record
                                           is shown, never edited here; Transfer / Withdraw write a new enrollment.
                                           Guardians sits BELOW it (owner, 2026-10-24, mock v3). *@
                                        <PanelSection Id="student-edit-enrollment"
                                                      Title="Enrollment"
                                                      TitleId="student-edit-enrollment-title">
                                            <HeaderActions>
                                                <RowActionsMenu UseMenuService="false"
                                                                ForceKebab="true"
                                                                Actions="@EnrollmentPanelActions"
                                                                AriaLabel="Enrollment actions" />
                                            </HeaderActions>
                                            <ChildContent>
                                                @if (_enrollments is null)
                                                {
                                                    <div class="spinner-container">
                                                        <FluentSpinner />
                                                    </div>
                                                }
                                                else if (PrimaryActiveEnrollment is { } active)
                                                {
                                                    @* Two BANDS, one kind of fact each (owner, 2026-10-25, mock v4/v5):
                                                       Placement is what the enrolment IS; Activity groups is the
                                                       membership set. Both are RailBand (component-first policy,
                                                       Q22a) so round B adds call sites, not markup. *@
                                                    <RailBand Id="student-edit-enrollment-facts" Label="Placement" Hint="read-only">
                                                        <RailChips>
                                                            <RailChip Text="@(_gradeLevelNames.TryGetValue(active.GradeLevelId, out var gn) ? gn : active.GradeLevelId.ToString()[..8])" />
                                                            <RailChip Text="@(_periodNames.TryGetValue(active.PeriodId, out var pn) ? pn : active.PeriodId.ToString()[..8])" />
                                                            <RailChip Text="Active" />
                                                            <RailChip Text="@($"enrolled {active.EnrolledOn:d}")" />
                                                        </RailChips>
                                                    </RailBand>

                                                    <RailBand Id="student-edit-activity-groups"
                                                              Label="Activity groups"
                                                              Hint="@_groupCountHint"
                                                              Variant="RailBandVariant.Groups">
                                                        <RailChips>
                                                            @if (_activityGroups is null)
                                                            {
                                                                <RailChip Text="Loading…" />
                                                            }
                                                            else if (_activityGroups.Count == 0)
                                                            {
                                                                @* An empty band is a WORD, never a struck-through chip:
                                                                   a blocked chip here would make "nothing" read as
                                                                   "rejected". *@
                                                                <span class="rail-empty">No groups yet</span>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var group in _activityGroups)
                                                                {
                                                                    @* Q26a: the rail shows what IS — joined groups only.
                                                                       Blocked chips belong to the picker, and to round B's
                                                                       "needs explicit enrolment" band. *@
                                                                    <RailChip @key="group.Id"
                                                                              Text="@group.Name"
                                                                              GroupStyle="true"
                                                                              Disabled="@_savingGroup"
                                                                              OnRemove="() => RemoveActivityGroupAsync(group)" />
                                                                }
                                                            }
                                                            <button type="button"
                                                                    class="rail-add-link"
                                                                    id="student-edit-add-group"
                                                                    disabled="@(_savingGroup || _activityGroups is null)"
                                                                    @onclick="AddActivityGroupsAsync">＋ Add group</button>
                                                        </RailChips>
                                                        @if (!string.IsNullOrEmpty(_groupError))
                                                        {
                                                            <FluentMessageBar Intent="MessageBarIntent.Error">@_groupError</FluentMessageBar>
                                                        }
                                                    </RailBand>
                                                }
                                                else
                                                {
                                                    <p class="rail-empty" id="student-edit-enrollment-empty">
                                                        This student has no active enrollment. Use <strong>Enroll</strong> to add one.
                                                    </p>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                        @* Guardians — the second rail relationship, and the ONLY way to add one is this
                                           panel's kebab (owner, 2026-10-24, mock v3): no inline add row anywhere in the
                                           body. A collection, so it is collapsible with a count (§6); each row's own
                                           kebab unlinks. Same panel, same order, on /students/create. *@
                                        <PanelSection Id="student-edit-guardians"
                                                      Title="Guardians"
                                                      TitleId="student-edit-guardians-title"
                                                      Collapsible="true"
                                                      Count="@_links.Count"
                                                      CountId="student-edit-guardians-count">
                                            <HeaderActions>
                                                <RowActionsMenu UseMenuService="false"
                                                                ForceKebab="true"
                                                                Actions="@GuardianPanelActions"
                                                                AriaLabel="Guardian actions" />
                                            </HeaderActions>
                                            <ChildContent>
                                                @if (_links.Count == 0)
                                                {
                                                    <p class="rail-empty" id="student-edit-guardians-empty">
                                                        No guardians linked yet — use the ⋮ menu to link one.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <ul class="rail-list" id="student-edit-guardians-list">
                                                        @foreach (var link in _links)
                                                        {
                                                            <li class="rail-list__row" @key="link.GuardianId">
                                                                <span class="rail-list__who">@GuardianName(link)</span>
                                                                <span class="rail-list__meta">@link.Role</span>
                                                                <RowActionsMenu UseMenuService="false"
                                                                                ForceKebab="true"
                                                                                Actions="@GuardianRowActions(link)"
                                                                                AriaLabel="@GuardianRowAriaLabel(link)" />
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                                @if (!string.IsNullOrEmpty(_guardianError))
                                                {
                                                    <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-2">@_guardianError</FluentMessageBar>
                                                }
                                            </ChildContent>
                                        </PanelSection>

                                    </div>
                                </div>
                            </div>
                        }
                    </ChildContent>
                    <Fallback>
                        <FluentMessageBar Intent="MessageBarIntent.Warning">
                            You have no tenant assigned. Student records are tenant-scoped — pick a tenant to continue.
                        </FluentMessageBar>
                    </Fallback>
                </TenantGate>
            </ChildContent>
        </AuthoringShell>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageBarIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>The trail (§4). The current crumb stays sentence case; only the page title is Title Case.</summary>
    private IReadOnlyList<AuthoringCrumb> ShellCrumbs => _student is null
        ? [new AuthoringCrumb("Students", "/students"), new AuthoringCrumb("…")]
        : [new AuthoringCrumb("Students", "/students"),
           new AuthoringCrumb(StudentCrumbLabel(), $"/students/{Id}"),
           new AuthoringCrumb("Edit")];

    private string StudentCrumbLabel() =>
        string.IsNullOrWhiteSpace(_student?.StudentNumber) ? Id.ToString()[..8] : _student!.StudentNumber;

    /// <summary>Cancel leaves without saving — the same destination the sidebar's Cancel used.</summary>
    private RenderFragment PageCancel => @<FluentButton Appearance="ButtonAppearance.Outline"
                                                         Id="authoring-cancel"
                                                         Disabled="@_saving"
                                                         OnClick="@(() => Nav.NavigateTo($"/students/{Id}"))">
        Cancel
    </FluentButton>;

    /// <summary>The Guardians panel's own menu (§6 item 3) — the only add path (owner, 2026-10-24):
    /// the panel adds, each row's kebab unlinks.</summary>
    private IReadOnlyList<RowAction> GuardianPanelActions =>
        [new RowAction { Label = "Add guardian…", OnClick = OnManageGuardiansAsync }];

    /// <summary>One row's actions — unlinking is the row's, and it is destructive, so it confirms.</summary>
    private IReadOnlyList<RowAction> GuardianRowActions(StudentGuardianViewDto link) =>
        [new RowAction
        {
            Label = "Unlink guardian…",
            Destructive = true,
            ConfirmMessage = $"Unlink {GuardianName(link)} from this student? The guardian record itself is kept.",
            OnClick = () => OnRemoveGuardianAsync(link)
        }];

    private string GuardianRowAriaLabel(StudentGuardianViewDto link) => $"Actions for {GuardianName(link)}";

    /// <summary>Enrollment's panel menu: Enroll adds a record; Transfer / Withdraw act on the current one.</summary>
    private IReadOnlyList<RowAction> EnrollmentPanelActions
    {
        get
        {
            var actions = new List<RowAction>
            {
                new() { Label = "Enroll…", OnClick = OnEnrollAsync, Disabled = _enrollments is null || _savingEnrollment }
            };
            if (PrimaryActiveEnrollment is not null)
            {
                actions.Add(new RowAction { Label = "Transfer…", OnClick = OnTransferAsync, Disabled = _savingEnrollment });
                actions.Add(new RowAction { Label = "Withdraw…", OnClick = OnWithdrawAsync, Disabled = _savingEnrollment });
            }
            return actions;
        }
    }

    private static string GuardianName(StudentGuardianViewDto link) =>
        string.IsNullOrWhiteSpace(link.DisplayName)
            ? $"{link.FirstName} {link.LastName}".Trim()
            : link.DisplayName;

    private StudentDto? _student;
    private readonly StudentFormModel _model = new();
    private bool _saving;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    /// <summary>Reference to the <see cref="StudentFormFields"/>
    /// instance. The right-column Save button calls
    /// <see cref="StudentFormFields.SubmitAsync"/> through this
    /// reference to drive the form's validation + OnValidSubmit
    /// (DataAnnotations + the caller's OnSaveAsync delegate). The
    /// Cancel button navigates back to the view page.</summary>
    private StudentFormFields? _form;

    /// <summary>Click handler for the right-column Save button. Delegates
    /// to <see cref="StudentFormFields.SubmitAsync"/>, which validates
    /// the form and fires <see cref="OnSaveAsync"/> on success.
    /// Idempotent under double-clicks: <c>SubmitAsync</c> is a no-op
    /// while <c>Submitting</c> is true.</summary>
    private async Task OnSidebarSaveAsync()
    {
        if (_form is null) return;
        await _form.SubmitAsync();
    }

    // ── Enrollment display + actions (read-only primary active) ──────────
    //
    // The primary active enrollment is the one with Status == "Active" and
    // ExitDate == null. If multiple match (shouldn't, but is a safe fallback
    // while transfers are mid-flight) the most-recent by EnrolledOn wins.
    // These mirror Detail.razor's helpers; kept private+local so the two
    // pages can evolve independently.

    private StudentEnrollmentDto[]? _enrollments;
    private Dictionary<Guid, string> _gradeLevelNames = new();
    private Dictionary<Guid, string> _periodNames = new();
    private bool _savingEnrollment;

    // ── Guardian link state (page-owned; form is in Linked mode) ──
    //
    // The page owns the link list + the link / unlink API calls +
    // the dialog opens (GuardianPickerDialog / GuardianFormDialog
    // via ShowShellDialogAsync). The form component is a thin
    // presenter in Linked mode: it renders the count + Manage
    // button + read-only grid + per-row delete, and fires
    // OnManageGuardians / OnRemoveGuardian back to the page.
    //
    // This is the OPPOSITE of the wizard's semantics: the wizard
    // collects guardians as DRAFTS and persists them in Phase 4
    // (deferred to save). On a page the link is IMMEDIATE — the
    // user expects the action to land as soon as they confirm
    // the dialog, not wait for a page-level Save.

    private List<StudentGuardianViewDto> _links = new();

    /// <summary>The student's active activity-group memberships, shown in the Enrollment rail band.
    /// Null while loading — the band renders "Loading…" rather than an empty set, so "not loaded yet"
    /// never reads as "belongs to nothing".</summary>
    private List<ActivityGroupDto>? _activityGroups;

    private bool _savingGroup;
    private string? _groupError;

    /// <summary>"2 of 6 valid" — the band's own total, which is what a count means here (owner Q19:
    /// the panel itself carries no count chip).</summary>
    private string _groupCountHint => _activityGroups is null ? string.Empty : $"{_activityGroups.Count} joined";

    /// <summary>Loads the student's memberships. Called after the page's own loads and again after any
    /// add/remove, because the band is a projection of the server's state, never a local guess.</summary>
    private async Task LoadActivityGroupsAsync(CancellationToken ct)
    {
        try
        {
            _activityGroups = (await Api.ListStudentGroupsAsync(Id, ct))?.ToList() ?? [];
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Loading activity groups for student {StudentId} failed", Id);
            _groupError = ex.Message;
            _activityGroups ??= [];
        }
    }

    /// <summary>"＋ Add group" — the picker offers only what the display mirror considers addable, and
    /// each confirmed pick becomes one membership write (the server re-checks every rule).</summary>
    private async Task AddActivityGroupsAsync()
    {
        if (_disposed || PrimaryActiveEnrollment is not { } active) return;
        _groupError = null;
        try
        {
            var ids = await DialogService.ShowShellDialogAsync<ActivityGroupPickerDialog, ActivityGroupPickerModel, Guid[]>(
                new ActivityGroupPickerModel(Id, active.GradeLevelId), "Add activity groups", DialogWidth.Medium);
            if (ids is null || ids.Length == 0) return;

            _savingGroup = true;
            var ct = _loadCts?.Token ?? CancellationToken.None;
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            foreach (var groupId in ids)
            {
                // The request carries only the student + join date: the SERVER resolves the period and
                // window from the group's EnrollmentSpan (FR-44/47/52) and re-checks every rule.
                await Api.AddGroupMemberAsync(groupId, new AddActivityGroupMemberRequest(Id, today), ct);
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Adding activity groups for student {StudentId} failed", Id);
            _groupError = ex.Message;
        }
        finally
        {
            _savingGroup = false;
            if (!_disposed) await LoadActivityGroupsAsync(_loadCts?.Token ?? CancellationToken.None);
        }
    }

    /// <summary>A chip's ✕ — removes the membership (the group itself is untouched), then reloads.</summary>
    private async Task RemoveActivityGroupAsync(ActivityGroupDto group)
    {
        if (_disposed) return;
        _groupError = null;
        try
        {
            _savingGroup = true;
            await Api.RemoveGroupMemberAsync(group.Id, Id, _loadCts?.Token ?? CancellationToken.None);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Removing student {StudentId} from group {GroupId} failed", Id, group.Id);
            _groupError = ex.Message;
        }
        finally
        {
            _savingGroup = false;
            if (!_disposed) await LoadActivityGroupsAsync(_loadCts?.Token ?? CancellationToken.None);
        }
    }
    private Dictionary<Guid, string> _relNames = new();
    private string? _guardianError;

    private StudentEnrollmentDto? PrimaryActiveEnrollment
    {
        get
        {
            if (_enrollments is null || _enrollments.Length == 0) return null;
            return _enrollments
                .Where(e => e.ExitDate is null
                    && string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(e => e.EnrolledOn)
                .FirstOrDefault();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant) return;

        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        Logger.LogInformation("Loading student {StudentId} for edit", Id);
        try
        {
            // Load the student + their enrollments in parallel. The enrollment
            // list is needed by the new "Active enrollment" section below the
            // direct-contact editor; we also need it for the per-section
            // grade-level / period name lookups (built below).
            var studentTask = Api.GetStudentByIdAsync(Id, ct);
            var enrollmentsTask = Api.ListEnrollmentsByStudentAsync(Id, ct);
            await Task.WhenAll(studentTask, enrollmentsTask);
            if (_disposed) return;

            _student = studentTask.Result;
            _enrollments = enrollmentsTask.Result;

            if (_student is null)
            {
                _error = $"Student {Id} not found.";
                Logger.LogWarning("Student {StudentId} not found for edit", Id);
            }
            else
            {
                // Project the DTO into the shared form model via the tested
                // on-model mapping (see StudentFormModel.LoadFrom). Types match
                // (string / string / string / DateOnly? / Guid? / Guid?) so the
                // projection is a straight copy — no string parsing needed now
                // that the form uses FluentDatePicker and CodedValueDropdown
                // for the typed fields.
                _model.LoadFrom(_student);
                Logger.LogInformation(
                    "Loaded student {StudentNumber} for edit with {Count} enrollment(s)",
                    _student.StudentNumber, _enrollments?.Length ?? 0);
            }

            // Build the grade-level / period name lookups the "Active
            // enrollment" display needs. One round-trip per list, bounded
            // by the number of distinct grade/period rows in the student's
            // enrollment history.
            var gradeIds = (_enrollments ?? Array.Empty<StudentEnrollmentDto>())
                .Select(e => e.GradeLevelId).Distinct().ToArray();
            var periodIds = (_enrollments ?? Array.Empty<StudentEnrollmentDto>())
                .Select(e => e.PeriodId).Distinct().ToArray();

            if (gradeIds.Length > 0)
            {
                var grades = await Api.ListGradeLevelsAsync(ct) ?? Array.Empty<GradeLevelDto>();
                _gradeLevelNames = grades.ToDictionary(g => g.Id, g => g.Name);
            }
            if (periodIds.Length > 0)
            {
                var periods = await Api.ListPeriodsAsync(ct) ?? Array.Empty<PeriodDto>();
                _periodNames = periods.ToDictionary(p => p.Id, p => p.Name);
            }

            // The Enrollment rail band projects the student's activity-group memberships.
            await LoadActivityGroupsAsync(ct);

            // Page-owned link list (the form is in Linked mode and is
            // a thin presenter — the page must hand the projected
            // StudentGuardianViewDto[] down via the LinkedItems
            // parameter so the form's read-only grid + Manage button
            // have data on first render).
            await LoadGuardiansAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load student {StudentId} for edit", Id);
            _error = ex.Message;
        }
    }

    // ── Enrollment action handlers ────────────────────────────────────────
    //
    // The primary active enrollment is read-only on this page. To change
    // the student's grade / period the user opens one of three dialogs:
    //   - Enroll  → creates a brand-new active enrollment in the tenant's
    //               current active period. (Does NOT close the existing
    //               one; if there's already an active enrollment in the
    //               same period the server will reject it with a
    //               duplicate-enrollment conflict and the dialog surfaces
    //               the error.)
    //   - Transfer → marks the current active enrollment as Transferred
    //               and points it at the new grade (same period).
    //   - Withdraw → marks the current active enrollment as Withdrawn
    //               with an exit date.
    //
    // All three dialogs use the shared EnrollStudentDialog /
    // StudentTransferDialog / WithdrawEnrollmentDialog components that the
    // Detail page already uses, so the behavior is consistent across pages.
    // On success we reload the enrollment list so the read-only display
    // reflects the new state without a full page refresh.

    private async Task OnEnrollAsync()
    {
        if (_disposed || _student is null) return;
        // Same race guard as Detail.razor: no enrollments yet means we cannot
        // seed SuggestedGradeLevelId/SuggestedStreamCodedValueId, so the dialog
        // would open as a NEW enrollment instead of pre-selecting the current
        // grade/stream.
        if (_enrollments is null) return;
        var model = new EnrollStudentModel(
            StudentId: Id,
            SuggestedPeriodId: PrimaryActiveEnrollment?.PeriodId,
            SuggestedGradeLevelId: PrimaryActiveEnrollment?.GradeLevelId,
            SuggestedStreamCodedValueId: PrimaryActiveEnrollment?.StreamCodedValueId);
        // Title reflects the upsert semantics (same as Detail.razor): an active
        // enrollment means the submit updates that row in place server-side.
        var result = await DialogService.ShowShellDialogAsync<EnrollStudentDialog, EnrollStudentModel, EnrollStudentResult>(
            model, PrimaryActiveEnrollment is null ? "Enroll student" : "Update enrollment", DialogWidth.Medium);
        if (result is { Success: true })
        {
            await ReloadEnrollmentsAsync();
        }
    }

    private async Task OnTransferAsync()
    {
        if (_disposed) return;
        var result = await DialogService.ShowShellDialogAsync<StudentTransferDialog, StudentTransferModel, StudentTransferResult>(
            new StudentTransferModel(Id), "Transfer student", DialogWidth.Medium);
        if (result is { Success: true })
        {
            await ReloadEnrollmentsAsync();
        }
    }

    private async Task OnWithdrawAsync()
    {
        if (_disposed || PrimaryActiveEnrollment is not { } active) return;
        var result = await DialogService.ShowShellDialogAsync<WithdrawEnrollmentDialog, WithdrawEnrollmentModel, WithdrawEnrollmentResult>(
            new WithdrawEnrollmentModel(
                EnrollmentId: active.Id,
                StudentName: $"{_student?.FirstName} {_student?.LastName}".Trim(),
                GradeName: _gradeLevelNames.TryGetValue(active.GradeLevelId, out var gn) ? gn : null,
                DefaultExitDate: DateOnly.FromDateTime(DateTime.UtcNow)),
            "Withdraw student",
            DialogWidth.Medium);
        if (result is { Success: true })
        {
            await ReloadEnrollmentsAsync();
        }
    }

    private async Task ReloadEnrollmentsAsync()
    {
        if (_disposed) return;
        _savingEnrollment = true;
        try
        {
            _enrollments = await Api.ListEnrollmentsByStudentAsync(Id)
                ?? Array.Empty<StudentEnrollmentDto>();

            // Rebuild lookup dicts if a mutation introduced a new grade or
            // period we hadn't seen (Transfer/Enroll/Withdraw can't introduce
            // a new period; Transfer/Enroll CAN introduce a new grade).
            var gradeIds = _enrollments.Select(e => e.GradeLevelId).Distinct().ToArray();
            var periodIds = _enrollments.Select(e => e.PeriodId).Distinct().ToArray();
            if (gradeIds.Except(_gradeLevelNames.Keys).Any())
            {
                foreach (var g in await Api.ListGradeLevelsAsync() ?? Array.Empty<GradeLevelDto>())
                {
                    _gradeLevelNames[g.Id] = g.Name;
                }
            }
            if (periodIds.Except(_periodNames.Keys).Any())
            {
                foreach (var p in await Api.ListPeriodsAsync() ?? Array.Empty<PeriodDto>())
                {
                    _periodNames[p.Id] = p.Name;
                }
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload enrollments for student {StudentId}", Id);
            _error = ex.Message;
        }
        finally
        {
            _savingEnrollment = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Guardian link handlers (page-owned, immediate persist) ──
    //
    // Linked-mode semantics for the page:
    //   - Manage → opens GuardianPickerDialog (which itself exposes
    //     "New guardian" → GuardianFormDialog). On non-null the
    //     page iterates the returned GuardianAssignment[] and links
    //     each (creating first if ExistingGuardianId is null) via
    //     LinkGuardianAsync. Then reloads the list.
    //   - Remove → calls UnlinkGuardianAsync for the picked row's
    //     GuardianId and reloads.
    //
    // The page OWNS these calls because the wizard's "defer to save"
    // pattern does not apply on a page — the user expects the
    // action to land as soon as they confirm the dialog. The form
    // component (in Linked mode) is a thin presenter: it only
    // fires EventCallback<Guid> / EventCallback<StudentGuardianViewDto>
    // back to the page; the page does the actual API work.
    //
    // Both handlers re-load via LoadGuardiansAsync so the new
    // state is reflected without a full page refresh. The error
    // bar below the form surfaces the most recent failure (link
    // or unlink) without losing the form's per-field errors.

    private async Task OnManageGuardiansAsync()
    {
        if (_disposed) return;
        _guardianError = null;
        try
        {
            var results = await DialogService.ShowShellDialogAsync<GuardianPickerDialog, GuardianPickerModel, GuardianAssignment[]>(
                new GuardianPickerModel(Id), "Manage guardians", DialogWidth.Large);
            if (results is null) return;

            var ct = _loadCts?.Token ?? CancellationToken.None;
            foreach (var a in results)
            {
                var guardianId = a.ExistingGuardianId
                    ?? await Api.CreateGuardianAsync(new CreateGuardianRequest(
                        a.TitleCodedValueId, a.FirstName, a.LastName, null, null, null), ct);
                await Api.LinkGuardianAsync(new LinkGuardianRequest(
                    Id, guardianId, a.RelationshipCodedValueId, a.Role, false, null), ct);
                // Seed contacts for a newly-created guardian. The picker's
                // multi-contact editor (Buffered ContactsEditor) populates
                // a.Contacts; the legacy single-contact path (StudentFormFields
                // inline create) populates a.ContactChannel/ContactValue/
                // CountryCode. Prefer the multi-contact list when present;
                // fall back to the single-contact shortcut otherwise.
                if (a.ExistingGuardianId is null)
                {
                    if (a.Contacts is { Count: > 0 })
                    {
                        var ordered = a.Contacts.OrderBy(x => x.Order).ToList();
                        for (var i = 0; i < ordered.Count; i++)
                        {
                            var c = ordered[i];
                            try
                            {
                                await Api.AddContactAsync(new AddContactRequest(
                                    ContactOwnerType.Guardian, guardianId,
                                    c.Channel, c.Value, c.Label)
                                    { CountryCode = c.CountryCode, DisplayOrder = i }, ct);
                            }
                            catch (OperationCanceledException) { throw; }
                            catch (Exception contactEx)
                            {
                                Logger.LogError(contactEx, "Failed to seed contact for guardian {GuardianId}", guardianId);
                            }
                        }
                    }
                    else if (a.ContactValue is not null)
                    {
                        try
                        {
                            await Api.AddContactAsync(new AddContactRequest(
                                ContactOwnerType.Guardian, guardianId,
                                a.ContactChannel ?? ContactChannel.Email, a.ContactValue, null)
                                { CountryCode = a.CountryCode }, ct);
                        }
                        catch (OperationCanceledException) { throw; }
                        catch (Exception contactEx)
                        {
                            Logger.LogError(contactEx, "Failed to seed contact for guardian {GuardianId}", guardianId);
                        }
                    }
                }
            }
            await LoadGuardiansAsync(ct);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to link guardian(s) for student {StudentId}", Id);
            _guardianError = ex.Message;
        }
    }

    private async Task OnRemoveGuardianAsync(StudentGuardianViewDto row)
    {
        if (_disposed) return;
        _guardianError = null;
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            await Api.UnlinkGuardianAsync(Id, row.GuardianId, ct);
            await LoadGuardiansAsync(ct);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to unlink guardian {GuardianId} from student {StudentId}",
                row.GuardianId, Id);
            _guardianError = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadGuardiansAsync(CancellationToken ct)
    {
        try
        {
            var links = await Api.ListGuardiansByStudentAsync(Id, ct) ?? [];
            _links = links.ToList();

            // Resolve the relationship coded-value ids to display names so
            // the StudentGuardiansList inside the form can render the
            // "Relationship" column without a second round-trip per row.
            // Bounded by the number of distinct relationships the student
            // currently has, so a sequential loop is fine.
            _relNames = new Dictionary<Guid, string>();
            foreach (var link in _links.Where(l => l.RelationshipCodedValueId.HasValue))
            {
                var cv = await CodedValuesApi.GetByIdAsync(link.RelationshipCodedValueId!.Value, ct);
                if (cv is not null) _relNames[cv.Id] = cv.Name;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load guardians for student {StudentId}", Id);
            _guardianError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private string? ResolveRelName(Guid? id)
        => id is { } g && _relNames.TryGetValue(g, out var n) ? n : null;

    private async Task OnSaveAsync()
    {
        if (!_isRealTenant || _student is null || _disposed) return;

        _error = null;

        var req = new UpdateStudentRequest(
            _model.FirstName!, _model.LastName!,
            _model.DateOfBirth, _model.GenderCodedValueId,
            _model.TitleCodedValueId);

        _saving = true;
        try
        {
            var ct = _loadCts?.Token ?? CancellationToken.None;
            await Api.UpdateStudentAsync(Id, req, ct);
            if (_disposed) return;

            Logger.LogInformation("Updated student {StudentId}", Id);
            Nav.NavigateTo($"/students/{Id}");
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to update student {StudentId}", Id);
            _error = ex.Message;
            _saving = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
