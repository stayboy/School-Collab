    {
        if (_disposed) return;
        try
        {
            await Api.UnlinkTeacherGradeLevelAsync(teacher.Id, Id);
            if (_disposed) return;
            await ReloadTeachersAsync();
            Toast.ShowSuccess($"Teacher '{teacher.FirstName} {teacher.LastName}' removed from grade.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _teachersError = $"Could not remove teacher: {ex.Message}";
        }
    }

    private async Task OnRoleChangedAsync(TeacherWithRoleDto teacher, Guid? roleCodedValueId)
    {
        if (_disposed) return;
        try
        {
            await Api.SetTeacherGradeLevelRoleAsync(teacher.Id, Id, roleCodedValueId);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _teachersError = $"Could not update role: {ex.Message}";
        }
    }

    private async Task UnlinkTeacherTopicAsync(TeacherWithRoleDto teacher, Guid topicId)
    {
        if (_disposed) return;
        try
        {
            await Api.UnlinkTeacherTopicAsync(teacher.Id, topicId);
            if (_disposed) return;
            await ReloadTeachersAsync();
            Toast.ShowSuccess("Teacher unlinked from topic.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _teachersError = $"Could not unlink topic: {ex.Message}";
        }
    }

    private async Task ReloadTeachersAsync()
    {
        try
        {
            _teachers = await Api.ListTeachersForGradeLevelAsync(Id) ?? [];
            _teachersError = null;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _teachersError = $"Could not reload teachers: {ex.Message}";
        }
        // Invoked from child components (the kebab menu, the grade teachers
        // dialog) whose events re-render THEMSELVES, not this page. Without this,
        // the SectionCard never receives the refreshed Items after a mutation.
        if (!_disposed) StateHasChanged();
    }

    // ── Students: add (enroll) ───────────────────────────────────────────────
    private async Task OpenAddStudentsAsync()
    {
        if (_disposed || _grade is null) return;
        _studentsError = null;
        try
        {
            var periods = await Api.ListPeriodsAsync() ?? [];
            var active = periods.FirstOrDefault(p => p.Status == "Active");
            if (active is null)
            {
                _studentsError = "No active period to enroll students into.";
                return;
            }
            var model = new StudentPickerModel(
                ExcludedStudentIds: _students?.Select(s => s.Id) ?? [],
                PeriodId: active.Id);
            var selected = await DialogService.ShowShellDialogAsync<StudentPickerDialog, StudentPickerModel, StudentDto[]>(
                model, $"Enroll students · {_grade.Name}", DialogSize.Large);
            if (selected is null || selected.Length == 0) return;
            foreach (var s in selected)
            {
                await Api.EnrollStudentAsync(new EnrollStudentRequest(
                    s.Id, active.Id, Id, StreamCodedValueId: null, DateOnly.FromDateTime(DateTime.UtcNow)));
            }
            if (_disposed) return;
            await ReloadStudentsAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to enroll students in grade {Id}", Id);
            _studentsError = $"Could not enroll students: {ex.Message}";
        }
    }

    private async Task ReloadStudentsAsync()
    {
        try
        {
            _students = await Api.ListStudentsByGradeAsync(Id) ?? [];
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _studentsError = $"Could not reload students: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
