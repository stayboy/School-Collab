    /// <summary>
    /// Students card kebab "Withdraw" — resolves the student's active
    /// enrollment id (§11.2) and opens the shared WithdrawEnrollmentDialog
    /// (end-date + reason). Reloads the card on a successful withdraw.
    /// </summary>
    private async Task OpenStudentWithdrawAsync(StudentDto student)
    {
        if (_disposed) return;
        try
        {
            var enrollments = await Api.ListEnrollmentsByStudentAsync(student.Id) ?? [];
            var active = enrollments
                .Where(e => e.ExitDate is null && string.Equals(e.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(e => e.EnrolledOn)
                .FirstOrDefault();
            if (active is null)
            {
                _studentsError = "This student has no active enrollment to withdraw.";
                return;
            }

            var result = await DialogService.ShowShellDialogAsync<WithdrawEnrollmentDialog, WithdrawEnrollmentModel, WithdrawEnrollmentResult>(
                new WithdrawEnrollmentModel(
                    EnrollmentId: active.Id,
                    StudentName: $"{student.FirstName} {student.LastName}".Trim(),
                    DefaultExitDate: DateOnly.FromDateTime(DateTime.UtcNow)),
                "Withdraw student",
                DialogSize.Medium);
            if (result is { Success: true } && !_disposed)
            {
                await ReloadStudentsAsync();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _studentsError = $"Could not withdraw student: {ex.Message}";
        }
    }

    /// <summary>
    /// Students card kebab "Remove" — soft-deletes the whole student record
    /// (Student.Delete() → DELETE /students/{id}), NOT an enrollment-withdraw.
    /// Gated by the kebab's destructive confirmation prompt.
    /// </summary>
    private async Task RemoveStudentAsync(StudentDto student)
    {
        if (_disposed) return;
        try
        {
            await Api.DeleteStudentAsync(student.Id);
            if (_disposed) return;
            await ReloadStudentsAsync();
            Toast.ShowSuccess($"Student '{student.FirstName} {student.LastName}' removed.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _studentsError = $"Could not remove student: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Row kebab for a Students-card preview item. The student name is the
    /// primary affordance (navigates to the student view page); the kebab holds
    /// the secondary actions (Transfer, Withdraw, View profile, Edit) and the
    /// destructive Remove (soft-delete the whole student).
    /// </summary>
    private IReadOnlyList<RowAction> BuildStudentRowActions(StudentDto student) =>
        new List<RowAction>
        {
            RowAction.Callback("Transfer", () => OpenStudentTransferAsync(student), FluentIcons.ArrowExportUp),
            RowAction.Callback("Withdraw", () => OpenStudentWithdrawAsync(student), FluentIcons.ArrowClockwise),
            RowAction.Navigate("View profile", $"/students/{student.Id}", FluentIcons.Open),
            RowAction.Callback("Edit", () => OpenStudentEditAsync(student), FluentIcons.Edit),
            RowAction.Separator(),
            RowAction.Callback(
                "Remove",
                () => RemoveStudentAsync(student),
                FluentIcons.Delete,
                destructive: true,
                confirmMessage: $"Remove student '{student.FirstName} {student.LastName}'? This soft-deletes the whole student record."),
        };

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
