    /// <summary>
    /// Students card "Add" affordance — opens the shared StudentCreateDialog
    /// (new student). Reloads the card on a non-cancelled result.
    /// </summary>
    private async Task OpenStudentCreateAsync()
    {
        if (_disposed) return;

        // Resolve the active academic year up front. When one is open, pass the
        // grade so the new student is enrolled atomically as part of the compound
        // create (no separate EnrollStudentAsync round-trip, no "created but not on
        // the grade card" state). When no active year is open, the student is still
        // created (with its guardians) but without an enrollment — preserving the
        // previous "create even without a period" behavior. Using the active
        // AcademicYear (not just any active period) matches the period-hierarchy
        // gate (active-period-per-tenancy.md FR-A6).
        var active = await Api.GetActiveAcademicYearAsync();

        var parameters = new Dictionary<string, object?>();
        if (active is not null)
            parameters[StudentCreateDialog.EnrollmentGradeLevelIdKey] = Id;
        else
            _studentsError = "No active academic year is open — the new student will be created without enrolling them to this grade.";

        var dialog = await DialogService.ShowReadonlyDialogAsync<StudentCreateDialog>(
            "New Student",
            parameters,
            DialogSize.ExtraLarge);
        if (_disposed) return;
        var result = await dialog.Result;
        if (_disposed || result.Cancelled || result.Data is not Guid) return;
        await ReloadStudentsAsync();
    }

    /// <summary>
    /// Section-card edit-action guard callbacks (wired to each edit card's
    /// <c>OnItemActionBlocked</c>). SectionCard centralizes the guard (an edit
    /// action requires a non-empty item key); these handlers surface the block
    /// as a per-card error. The message is also reused by the kebab Edit actions
    /// (which bypass SectionCard's subitem guard).
    /// </summary>
    private Task OnTopicEditBlocked(string name) { _topicsError = $"{name} is missing an Id and cannot be edited."; return Task.CompletedTask; }
    private Task OnStudentEditBlocked(string name) { _studentsError = $"{name} is missing an Id and cannot be edited."; return Task.CompletedTask; }
    private Task OnStreamEditBlocked(string name) { _streamsError = $"{name} is missing an Id and cannot be edited."; return Task.CompletedTask; }

    /// <summary>
    /// Students card kebab "Edit" — opens the shared StudentEditDialog for the
    /// row's student. Reloads the card on a non-cancelled result.
    /// </summary>
    private async Task OpenStudentEditAsync(StudentDto student)
    {
        if (_disposed) return;

        // Defense-in-depth for the kebab Edit action (which calls this handler
        // directly and bypasses SectionCard's central ItemKeySelector guard):
        // never open the edit dialog with an empty student Id — that would 404
        // and leave a blank form. Surfaced via the same OnStudentEditBlocked
        // path the section-card subitem uses.
        if (student.Id == Guid.Empty)
        {
            await OnStudentEditBlocked($"{student.FirstName} {student.LastName}".Trim());
            return;
        }

        var dialog = await DialogService.ShowReadonlyDialogAsync<StudentEditDialog>(
            $"Edit Student · {student.FirstName} {student.LastName}",
            new Dictionary<string, object?>
            {
                { StudentEditDialog.StudentIdKey, student.Id },
            },
            DialogSize.ExtraLarge);
        if (_disposed) return;
        var result = await dialog.Result;
        if (_disposed || result.Cancelled) return;
        await ReloadStudentsAsync();
    }

