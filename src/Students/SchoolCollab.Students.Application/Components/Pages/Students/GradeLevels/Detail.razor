@page "/students/grade-levels/{Id:guid}"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Application.Components.Students
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Services
@using TopicDto = SchoolCollab.Students.Core.DTOs.TopicDto
@using TeacherWithRoleDto = SchoolCollab.Students.Core.DTOs.TeacherWithRoleDto
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject CodedValuesApiClient CodedValuesApi
@inject IDialogService DialogService
@inject IToastService Toast
@inject NavigationManager Nav
@inject ILogger<Detail> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<PageTitle>Grade Level — @(_grade?.Name ?? "Loading…")</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" class="page-container">
            <TenantGate>
                <ChildContent>
                    @if (_loading)
                    {
                        <div class="spinner-container"><FluentProgressRing /></div>
                    }
                    else if (!string.IsNullOrEmpty(_error))
                    {
                        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
                        <div class="mt-3">
                            <FluentButton Appearance="Appearance.Neutral" IconStart="@FluentIcons.ArrowLeft" OnClick="Back">Back to grade levels</FluentButton>
                        </div>
                    }
                    else if (_grade is null)
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning">Grade level not found.</FluentMessageBar>
                        <div class="mt-3">
                            <FluentButton Appearance="Appearance.Neutral" IconStart="@FluentIcons.ArrowLeft" OnClick="Back">Back to grade levels</FluentButton>
                        </div>
                    }
                    else
                    {
                        @* ── Title row ─────────────────────────────────────── *@
                        <div class="title-row">
                            <div class="title-block">
                                <h1 class="page-title">@_grade.Name</h1>
                            </div>
                            <RowActionsMenu AriaLabel="Actions"
                                            UseMenuService="false"
                                            Actions="@BuildGradeActions()" />
                        </div>

                        @* ── Overview card ─────────────────────────────────── *@
                        <FluentCard class="detail-card">
                            <div class="profile-grid">
                                <FieldDisplay Label="Name">@_grade.Name</FieldDisplay>
                                <FieldDisplay Label="Age range">@FormatAgeRange(_grade.MinAge, _grade.MaxAge)</FieldDisplay>
                                <FieldDisplay Label="Gender">@(_genderName ?? "—")</FieldDisplay>
                                <FieldDisplay Label="Enrollment">
                                    <FluentBadge Appearance="@(_grade.IsBlockedFromEnrollment ? Appearance.Neutral : Appearance.Accent)">
                                        @(_grade.IsBlockedFromEnrollment ? "Blocked" : "Allowed")
                                    </FluentBadge>
                                </FieldDisplay>
                                <FieldDisplay Label="Students" Href="@($"/students?gradeLevelId={_grade.Id}")">
                                    @_grade.StudentCount students
                                </FieldDisplay>
                            </div>
                        </FluentCard>

                        @* ── Section cards (shared component) ──────────────── *@
                        <FluentGrid Spacing="2" class="section-cards">
                            @* Subjects card *@
                            <FluentGridItem xs="12" sm="6" lg="3">
                            @if (!string.IsNullOrEmpty(_topicsError))
                            {
                                <FluentMessageBar Intent="MessageIntent.Error" class="mb-2">@_topicsError</FluentMessageBar>
                            }
                            <SectionCard TItem="GradeTopicCurriculumDto" Title="Subjects"
                                         Icon="@FluentIcons.Book"
                                         Count="@(_curriculum?.Length ?? 0)"
                                         OnAddClick="OpenTopicCreateAsync"
                                         OnViewAllClick="OpenTopicsDialogAsync"
                                         ViewAllText="View all subjects"
                                         Items="@(_curriculum ?? [])"
                                         EmptyMessage="No subjects assigned to this curriculum yet."
                                         Loading="@(_curriculum is null)"
                                         ItemTextSelector="t => t.Name"
                                         ItemMetaSelector="@(t => [ $"{t.StrandCount} strands", $"{t.LessonCount} lessons" ])"
                                         ItemOnClick="t => OpenTopicEditAsync(t)"
                                         ItemNameTitle="Edit topic">
                                <ItemActions Context="t">
                                    <RowActionsMenu AriaLabel="@($"Actions for {t.Name}")"
                                                    UseMenuService="false"
                                                    Actions="@BuildTopicRowActions(t)" />
                                </ItemActions>
                            </SectionCard>
                            </FluentGridItem>

                            @* Teachers card *@
                            <FluentGridItem xs="12" sm="6" lg="3">
                            <SectionCard TItem="TeacherWithRoleDto" Title="Teachers"
                                         Icon="@FluentIcons.People"
                                         Count="@(_teachers?.Length ?? 0)"
                                         OnAddClick="OpenTeacherCreateAsync"
                                         OnViewAllClick="OpenTeachersDialogAsync"
                                         ViewAllText="View all teachers"
                                         Items="@(_teachers ?? [])"
                                         EmptyMessage="No teachers linked to this grade yet."
                                         ErrorMessage="@_teachersError"
                                         Loading="@(_teachers is null)"
                                         ItemTextSelector="t => GetTeacherDisplayName(t)"
                                         ItemMetaSelector="@(t => [ GetTeacherRole(t) ])"
                                         ItemHrefSelector="@(t => $"/students/teachers/{t.Id}")">
                                <ItemActions Context="t">
                                    <RowActionsMenu AriaLabel="@($"Actions for {t.FirstName} {t.LastName}")"
                                                    UseMenuService="false"
                                                    Actions="@BuildTeacherRowActions(t)" />
                                </ItemActions>
                            </SectionCard>
                            </FluentGridItem>

                            @* Students card *@
                            <FluentGridItem xs="12" sm="6" lg="3">
                            <SectionCard TItem="StudentDto" Title="Students"
                                         Icon="@FluentIcons.Person"
                                         Count="@(_students?.Length ?? 0)"
                                         AddTitle="Add student"
                                         AddAriaLabel="Add student"
                                         OnAddClick="OpenAddStudentsAsync"
                                         ViewAllNavigationUrl="@($"/students?gradeLevelId={Id}")"
                                         ViewAllText="View all students"
                                         Items="@(_students ?? [])"
                                         EmptyMessage="No active students in this grade for the current period."
                                         ErrorMessage="@_studentsError"
                                         Loading="@(_students is null)"
                                         ItemTextSelector="@(st => $"{st.FirstName} {st.LastName}")"
                                         ItemMetaSelector="@(st => [ GetStudentDemographics(st) ])"
                                         ItemHrefSelector="@(st => $"/students/{st.Id}")"
                                         ItemNameTitle="View student">
                            </SectionCard>
                            </FluentGridItem>

                            @* Streams card *@
                            <FluentGridItem xs="12" sm="6" lg="3">
                            <SectionCard TItem="CodedValueDto" Title="Streams"
                                         Icon="@FluentIcons.TextBulletList"
                                         Count="@(_streams?.Length ?? 0)"
                                         AddTitle="Add stream"
                                         AddAriaLabel="Add stream"
                                         OnAddClick="OpenStreamCreateAsync"
                                         ViewAllNavigationUrl="/coded-values/GRSTREAMS/children"
                                         ViewAllText="Manage streams"
                                         Items="@(_streams ?? [])"
                                         EmptyMessage="No streams defined for this grade yet."
                                         ErrorMessage="@_streamsError"
                                         Loading="@(_streams is null)"
                                         ItemTextSelector="s => s.Name"
                                         ItemOnClick="s => OpenStreamEditAsync(s)"
                                         ItemNameTitle="Edit stream">
                                <ItemActions Context="s">
                                    <RowActionsMenu AriaLabel="@($"Actions for {s.Name}")"
                                                    UseMenuService="false"
                                                    Actions="@BuildStreamRowActions(s)" />
                                </ItemActions>
                            </SectionCard>
                            </FluentGridItem>
                        </FluentGrid>

                        @* ── Notification & Delivery card (nd/4) ─────────── *@
                        <FluentCard class="detail-card notification-card">
                            <div class="notification-title">
                                <FluentIcon Icon="@(Icons.Regular.Size20.SlideText)" />
                                <h3>Notification &amp; Delivery</h3>
                            </div>
                            <GradeNotificationPolicyEditor GradeLevelId="@Id" />
                        </FluentCard>
                    }
                </ChildContent>
                <Fallback>
                    <FluentMessageBar Intent="MessageIntent.Warning">
                        You have no tenant assigned. Grade level records are tenant-scoped — pick a tenant to continue.
                    </FluentMessageBar>
                </Fallback>
            </TenantGate>

            <div class="action-bar">
                <FluentButton Appearance="Appearance.Outline" OnClick="Back">Back to Grade Levels</FluentButton>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
            }
        </FluentStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>


@code {
    [Parameter] public Guid Id { get; set; }

    private GradeLevelDto? _grade;
    private string? _genderName;
    private string? _error;
    private bool _loading = true;
    private bool _isRealTenant;
    private bool _savingEnrollment;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    // ── Topics ──────────────────────────────────────────────────────────────
    private List<AssignedTopic> _assignedTopics = new();
    private GradeTopicCurriculumDto[]? _curriculum;
    private Dictionary<Guid, TopicDto> _catalog = new();
    private string? _topicsError;

    // ── Teachers / Students ────────────────────────────────────────────────
    private TeacherWithRoleDto[]? _teachers;
    private StudentDto[]? _students;
    private CodedValueDto[]? _streams;
    private string? _streamsError;
    private TeacherDto[]? _allTeachers;
    private readonly Dictionary<Guid, string> _salutationNames = new();
    private readonly Dictionary<Guid, string> _genderNames = new();
    private readonly Dictionary<Guid, string> _levelNames = new();
    private readonly Dictionary<Guid, string> _qualificationNames = new();
    private readonly Dictionary<Guid, string> _roleNames = new();
    private string? _teachersError;
    private string? _studentsError;

    private sealed class AssignedTopic
    {
        public Guid TopicId { get; init; }
        public Guid AssignmentId { get; init; }
        public string Name { get; init; } = string.Empty;
        public string? Code { get; init; }
    }

    private TopicDto[] _unassignedTopics =>
        _catalog.Values
            .Where(t => _assignedTopics.All(a => a.TopicId != t.Id))
            .OrderBy(t => t.Name)
            .ToArray();

    private TeacherDto[] _unlinkedTeachers =>
        (_allTeachers ?? [])
            .Where(t => _teachers is null || _teachers.All(x => x.Id != t.Id))
            .OrderBy(t => t.FirstName)
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        _loading = true;
        StateHasChanged();

        try
        {
            var scope = await VisibleTenant.GetScopeAsync();
            _isRealTenant = scope.IsRealTenant;
            if (!_isRealTenant)
            {
                _loading = false;
                return;
            }

            var gradeTask = Api.GetGradeLevelByIdAsync(Id, ct);
            var catalogTask = Api.ListTopicsAsync(ct);
            var teachersTask = Api.ListTeachersForGradeLevelAsync(Id, ct);
            var allTeachersTask = Api.ListTeachersAsync(ct);
            var studentsTask = Api.ListStudentsByGradeAsync(Id, ct: ct);
            await Task.WhenAll(gradeTask, catalogTask, teachersTask, allTeachersTask, studentsTask);

            _grade = gradeTask.Result;
            _catalog = (catalogTask.Result ?? []).ToDictionary(t => t.Id);
            _teachers = teachersTask.Result ?? [];
            _allTeachers = allTeachersTask.Result ?? [];
            _students = studentsTask.Result ?? [];

            if (_teachers is { Length: > 0 })
            {
                await EnrichTeacherNamesAsync(ct);
            }

            if (_grade is null) return;

            await ReloadStreamsAsync(ct);

            if (_grade.AllowedGenderCodedValueId is { } gid)
            {
                _genderName = (await CodedValuesApi.GetByIdAsync(gid, ct))?.Name;
            }

            var assignments = await Api.ListGradeTopicsByGradeAsync(Id, ct: ct) ?? [];
            _assignedTopics = assignments
                .Select(a => new AssignedTopic
                {
                    TopicId = a.TopicId,
                    AssignmentId = a.Id,
                    Name = _catalog.TryGetValue(a.TopicId, out var t) ? t.Name : a.TopicId.ToString()[..8],
                    Code = _catalog.TryGetValue(a.TopicId, out var tc) ? tc.Code : null,
                })
                .OrderBy(t => t.Name)
                .ToList();
            _curriculum = await Api.ListGradeTopicCurriculumByGradeAsync(Id, ct: ct) ?? [];
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load grade level {Id}", Id);
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatAgeRange(int? min, int? max)
    {
        if (min.HasValue && max.HasValue) return $"{min}–{max}";
        if (min.HasValue) return $"{min}+";
        if (max.HasValue) return $"≤{max}";
        return "Any age";
    }

    private static string GetStudentDemographics(StudentDto s)
    {
        var gender = string.IsNullOrWhiteSpace(s.GenderName) ? "—" : s.GenderName;
        var age = s.Age.HasValue ? s.Age.Value.ToString() : "—";
        return $"{gender}, {age}";
    }

    /// <summary>
    /// Formats a teacher's display name, prefixing the salutation title when
    /// known (e.g. "Dr. Jane Smith"). Used by the Teachers card's built-in item
    /// layout (ItemTextSelector).
    /// </summary>
    private string GetTeacherDisplayName(TeacherWithRoleDto t)
    {
        var salutation = t.TitleCodedValueId is { } tid && _salutationNames.TryGetValue(tid, out var sal) ? $"{sal} " : "";
        return $"{salutation}{t.FirstName} {t.LastName}";
    }

    /// <summary>
    /// Resolves a teacher's role display name, or "No role" when unset. Used by
    /// the Teachers card's built-in item layout (ItemMetaSelector).
    /// </summary>
    private string GetTeacherRole(TeacherWithRoleDto t) =>
        t.TeacherRoleCodedValueId is { } rid && _roleNames.TryGetValue(rid, out var r) ? r : "No role";

    /// <summary>
    /// Resolves the coded-value display names (salutation, gender, level of
    /// education, qualifications) for the loaded teachers in one round-trip, so
    /// the grid can render them without per-cell lookups. The Students DB has no
    /// CodedValue table — names come from the Admin coded-values API (mirrors
    /// EnrichStudentsAsync).
    /// </summary>
    private async Task EnrichTeacherNamesAsync(CancellationToken ct)
    {
        var ids = new List<Guid>();
        foreach (var t in _teachers!)
        {
            if (t.TitleCodedValueId is { } ti) ids.Add(ti);
            if (t.GenderCodedValueId is { } gi) ids.Add(gi);
            if (t.LevelOfEducationCodedValueId is { } li) ids.Add(li);
            foreach (var q in t.QualificationCodedValueIds ?? []) ids.Add(q);
            if (t.TeacherRoleCodedValueId is { } ri) ids.Add(ri);
        }
        if (ids.Count == 0) return;

        try
        {
            var resolved = await CodedValuesApi.GetByIdsAsync(ids, ct) ?? [];
            foreach (var cv in resolved)
            {
                if (cv.Id == Guid.Empty) continue;
                if (cv.Name is null) continue;
                if (_teachers!.Any(x => x.TitleCodedValueId == cv.Id)) _salutationNames[cv.Id] = cv.Name;
                if (_teachers!.Any(x => x.GenderCodedValueId == cv.Id)) _genderNames[cv.Id] = cv.Name;
                if (_teachers!.Any(x => x.LevelOfEducationCodedValueId == cv.Id)) _levelNames[cv.Id] = cv.Name;
                if (_teachers!.Any(x => (x.QualificationCodedValueIds ?? []).Contains(cv.Id))) _qualificationNames[cv.Id] = cv.Name;
                if (_teachers!.Any(x => x.TeacherRoleCodedValueId == cv.Id)) _roleNames[cv.Id] = cv.Name;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to resolve teacher coded-value names for grade {Id}", Id);
            // Leave the name maps empty; the grid renders "—" for unresolved cells.
        }
    }

    private void Back() => Nav.NavigateTo("/students/grade-levels");

    /// <summary>
    /// Streams card "Add" affordance — opens the shared CodedValueDialog in
    /// Create mode to add a new stream under GRSTREAMS, then tags it with this
    /// grade's <c>gradeLevel</c> attribute so it shows up in the card (the card
    /// filters GRSTREAMS children by that attribute).
    /// </summary>
    private async Task OpenStreamCreateAsync()
    {
        if (_disposed || _grade is null) return;
        try
        {
            var parent = await CodedValuesApi.GetByCodeAsync(CodedValueParent.Streams.ToCode());
            if (parent is null)
            {
                _error = "Could not locate the GRSTREAMS parent to create a stream under.";
                return;
            }

            var created = await DialogService.ShowShellDialogAsync<
                CodedValueDialog,
                CodedValueFormModel,
                CodedValueDto>(
                CodedValueFormModel.ForCreate(parent.Id),
                title: $"Add stream · {_grade.Name}",
                size: DialogSize.Medium);

            if (created is not null && !_disposed)
            {
                // Tag the new stream with this grade so it appears in the card.
                await CodedValuesApi.SetAttributeAsync(created.Id, "gradeLevel", _grade.CodedValueId.ToString());
                await ReloadStreamsAsync();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create stream for grade {Id}", Id);
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Loads the grade's streams (GRSTREAMS coded values whose gradeLevel
    /// attribute references this grade). Loaded separately so a failure here
    /// only empties the Streams card rather than failing the whole page.
    /// </summary>
    private async Task ReloadStreamsAsync(CancellationToken ct = default)
    {
        try
        {
            _streams = await CodedValuesApi.GetChildrenByParentCodeFilteredByAttributeAsync(
                CodedValueParent.Streams.ToCode(), "gradeLevel", _grade!.CodedValueId.ToString(), ct) ?? [];
            _streamsError = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load grade streams for grade {Id}", Id);
            _streams = [];
            _streamsError = $"Could not load streams: {ex.Message}";
        }
    }

    /// <summary>
    /// Streams card item primary affordance — opens the shared CodedValueDialog
    /// in Override mode to edit the stream's tenant display name. Reloads the
    /// card on a save.
    /// </summary>
    private async Task OpenStreamEditAsync(CodedValueDto stream)
    {
        var updated = await DialogService.ShowShellDialogAsync<
            CodedValueDialog,
            CodedValueFormModel,
            CodedValueDto>(
            CodedValueFormModel.ForOverride(stream, stream.IsOverridden),
            title: $"Edit stream · {stream.Name}",
            size: DialogSize.Medium);
        if (updated is not null && !_disposed)
        {
            await ReloadStreamsAsync();
        }
    }

    /// <summary>
    /// Row kebab for a Streams-card preview item. The stream name is the primary
    /// affordance (opens the edit dialog); the kebab holds the secondary actions
    /// (Edit for discoverability + destructive Remove). Remove means disable —
    /// the coded value is marked <c>isDisabled</c> (kept in the catalog, not hard
    /// deleted), matching the coded-value lifecycle.
    /// </summary>
    private IReadOnlyList<RowAction> BuildStreamRowActions(CodedValueDto stream) =>
        new List<RowAction>
        {
            RowAction.Callback("Edit", () => OpenStreamEditAsync(stream), FluentIcons.Edit),
            RowAction.Separator(),
            RowAction.Callback(
                "Remove",
                () => RemoveStreamAsync(stream),
                FluentIcons.Delete,
                destructive: true,
                confirmMessage: $"Remove stream '{stream.Name}'? The stream is disabled and hidden from this grade."),
        };

    /// <summary>
    /// Streams card Remove — disables the stream (coded-value lifecycle, not a
    /// hard delete) and reloads the card. Gated by the kebab's destructive
    /// confirmation prompt.
    /// </summary>
    private async Task RemoveStreamAsync(CodedValueDto stream)
    {
        if (_disposed) return;
        try
        {
            await CodedValuesApi.DisableAsync(stream.Id);
            if (_disposed) return;
            await ReloadStreamsAsync();
            Toast.ShowSuccess($"Stream '{stream.Name}' removed.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _streamsError = $"Could not remove stream: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Builds the grade-level header "Actions" menu: Edit (navigate) and the
    /// enrollment-block toggle. Positioned far-right of the title row via the
    /// RowActionsMenu trigger.
    /// </summary>
    private IReadOnlyList<RowAction> BuildGradeActions()
    {
        var blocked = _grade!.IsBlockedFromEnrollment;
        return new List<RowAction>
        {
            RowAction.Callback("Edit", () => Nav.NavigateTo($"/students/grade-levels/{Id}/edit"), FluentIcons.Edit),
            RowAction.Separator(),
            RowAction.Callback(
                blocked ? "Allow enrollment" : "Block enrollment",
                () => ToggleEnrollmentBlockedAsync(!blocked),
                blocked ? FluentIcons.Checkmark : FluentIcons.Dismiss),
        };
    }

    private async Task ToggleEnrollmentBlockedAsync(bool blocked)
    {
        if (_disposed || _grade is null || _savingEnrollment) return;
        _savingEnrollment = true;
        try
        {
            await Api.SetGradeLevelEnrollmentBlockedAsync(_grade.Id, blocked);
            if (_disposed) return;
            _grade = _grade with { IsBlockedFromEnrollment = blocked };
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to set enrollment-blocked for grade {Id}", _grade.Id);
            _error = ex.Message;
        }
        finally
        {
            _savingEnrollment = false;
        }
    }

    // ── Topics: assign / remove ─────────────────────────────────────────────
    /// <summary>
    /// Subjects card "Add" affordance — opens the shared TopicCreateDialog in
    /// Create mode with this grade's context so a new topic (displayed as a
    /// subject) is created and wired to the grade in one atomic call
    /// (CreateTopicForGradeAsync). This mirrors the TopicEditDialog pattern
    /// (DialogShellBase + ShowShellDialogAsync) used for editing a subject on
    /// this card, and creates a brand-new topic rather than renaming an existing
    /// one. Reloads the curriculum on a non-null result so the card reflects the
    /// new subject.
    /// </summary>
    private async Task OpenTopicCreateAsync()
    {
        if (_disposed || _grade is null) return;
        try
        {
            var model = new TopicCreateDialog.TopicCreateModel
            {
                GradeLevelId = _grade.Id,
                // Prevent adding a subject whose coded value is already used by
                // another subject linked to this grade (duplicate coded values).
                ExistingTopicCodedValueIds = _assignedTopics
                    .Select(a => a.TopicId)
                    .Where(_catalog.ContainsKey)
                    .Select(id => _catalog[id].CodedValueId)
                    .Where(id => id.HasValue)
                    .Select(id => id!.Value)
                    .ToHashSet(),
            };
            var created = await DialogService.ShowShellDialogAsync<
                TopicCreateDialog,
                TopicCreateDialog.TopicCreateModel,
                TopicDto>(
                model,
                $"Add subject · {_grade.Name}",
                DialogSize.Large);
            if (created is not null && !_disposed)
            {
                await ReloadAssignedTopicsAsync();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to create topic for grade {Id}", Id);
            _error = ex.Message;
        }
    }

    private async Task AssignTopicAsync(Guid topicId)
    {
        if (_disposed) return;
        try
        {
            await Api.AssignGradeTopicAsync(
                new AssignGradeTopicRequest(Id, topicId, DateOnly.FromDateTime(DateTime.UtcNow)));
            if (_disposed) return;
            await ReloadAssignedTopicsAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _topicsError = $"Could not assign topic: {ex.Message}";
        }
    }

    private async Task OpenTopicsDialogAsync()
    {
        await DialogService.ShowReadonlyDialogAsync<GradeTopicsDialog>(
            $"Subjects · {_grade!.Name}",
            new Dictionary<string, object?>
            {
                { nameof(GradeTopicsDialog.Topics), _curriculum ?? [] },
                { nameof(GradeTopicsDialog.UnassignedTopics), _unassignedTopics },
                { nameof(GradeTopicsDialog.OpenStrands), new Func<GradeTopicCurriculumDto, Task>(OpenStrandsAsync) },
                { nameof(GradeTopicsDialog.OpenTeachers), new Func<GradeTopicCurriculumDto, Task>(OpenTopicTeachersAsync) },
                { nameof(GradeTopicsDialog.Remove), new Func<Guid, Task>(RemoveTopicAsync) },
                { nameof(GradeTopicsDialog.Assign), new Func<Guid, Task>(AssignTopicAsync) },
                { nameof(GradeTopicsDialog.OnChanged), new Func<Task>(ReloadAssignedTopicsAsync) },
            },
            DialogSize.Medium);
        if (_disposed) return;
        await ReloadAssignedTopicsAsync();
    }

    private async Task RemoveTopicAsync(Guid topicId)
    {
        if (_disposed) return;
        var assignment = _assignedTopics.FirstOrDefault(a => a.TopicId == topicId);
        if (assignment is null) return;
        try
        {
            await Api.RemoveTopicAssignmentAsync(assignment.AssignmentId);
            if (_disposed) return;
            await ReloadAssignedTopicsAsync();
            Toast.ShowSuccess($"Subject '{assignment.Name}' removed from grade.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _topicsError = $"Could not unassign topic: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ReloadAssignedTopicsAsync()
    {
        var assignments = await Api.ListGradeTopicsByGradeAsync(Id) ?? [];
        _assignedTopics = assignments
            .Select(a => new AssignedTopic
            {
                TopicId = a.TopicId,
                AssignmentId = a.Id,
                Name = _catalog.TryGetValue(a.TopicId, out var t) ? t.Name : a.TopicId.ToString()[..8],
                Code = _catalog.TryGetValue(a.TopicId, out var tc) ? tc.Code : null,
            })
            .OrderBy(t => t.Name)
            .ToList();
        _curriculum = await Api.ListGradeTopicCurriculumByGradeAsync(Id) ?? [];

        // This is invoked from child components (the kebab menu, the grade topics
        // dialog) whose events re-render THEMSELVES, not this page. Without this,
        // the SectionCard never receives the refreshed Items after an add/remove.
        if (!_disposed) StateHasChanged();
    }

    private async Task OpenStrandsAsync(GradeTopicCurriculumDto topic)
    {
        // The unified Strands editor shows root strands AND their lessons (lessons
        // are parented strands — strand-lesson-unification-plan.md), so this dialog
        // is the single place to manage a topic's curriculum.
        await DialogService.ShowReadonlyDialogAsync<TopicStrandsDialog>(
            $"Strands · {topic.Name}",
            new Dictionary<string, object?>
            {
                { nameof(TopicStrandsDialog.TopicId), topic.TopicId },
                { nameof(TopicStrandsDialog.TopicName), topic.Name },
            },
            DialogSize.Medium);
        if (_disposed) return;
        await ReloadAssignedTopicsAsync();
    }

    // Open the topic edit dialog (rename / display order). Reload the
    // curriculum on a non-null result so the card reflects the new name.
    private async Task OpenTopicEditAsync(GradeTopicCurriculumDto topic)
    {
        var updated = await DialogService.ShowShellDialogAsync<
            TopicEditDialog,
            TopicEditDialog.TopicEditModel,
            TopicDto>(
            new TopicEditDialog.TopicEditModel { Id = topic.TopicId, Name = topic.Name },
