    private async Task OpenTopicsDialogAsync()
    {
        await DialogService.ShowReadonlyDialogAsync<GradeTopicsDialog>(
            $"Subjects · {_grade!.Name}",
            new Dictionary<string, object?>
            {
                { GradeTopicsDialog.TopicsKey, _curriculum ?? [] },
                { GradeTopicsDialog.UnassignedTopicsKey, _unassignedTopics },
                { GradeTopicsDialog.OpenStrandsKey, new Func<GradeTopicCurriculumDto, Task>(OpenStrandsAsync) },
                { GradeTopicsDialog.RemoveKey, new Func<Guid, Task>(RemoveTopicAsync) },
                { GradeTopicsDialog.AssignKey, new Func<Guid, Task>(AssignTopicAsync) },
                { GradeTopicsDialog.OnChangedKey, new Func<Task>(ReloadAssignedTopicsAsync) },
                { GradeTopicsDialog.OpenEnrollmentExceptionsKey, new Func<Guid, Task>(OpenEnrollmentExceptionsForTopicAsync) },
                // Per-topic exception COUNTS, not lists: the dialog renders a count
                // badge only, and a count map cannot collide on a repeated topic key.
                { GradeTopicsDialog.ExceptionCountsByTopicKey, _exceptions
                    .GroupBy(x => x.TopicId)
                    .ToDictionary(g => g.Key, g => g.Count()) },
            },
            DialogSize.Medium);
        if (_disposed) return;
        await ReloadAssignedTopicsAsync();
    }

    /// <summary>
    /// Reloads the grade's enrollment exceptions. The Subjects card's name BADGE and
    /// the "View all subjects" dialog both render them as a read-only count.
    /// Best-effort: a failure leaves the card with no exception badge rather than
    /// breaking the page.
    /// </summary>
    private async Task ReloadExceptionsAsync(CancellationToken ct = default)
    {
        try
        {
            _exceptions = await Api.ListSubjectEnrollmentExceptionsAsync(gradeLevelId: Id, ct: ct) ?? [];
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Could not load enrollment exceptions for grade level {Id}", Id);
            _exceptions = [];
        }
        // Invoked from child components (the Subjects card and the exceptions dialog)
        // whose events re-render THEMSELVES, not this page.
        if (!_disposed) StateHasChanged();
    }

    private async Task RemoveTopicAsync(Guid topicId)
    {
        if (_disposed) return;
        var assignment = _assignedTopics.FirstOrDefault(a => a.TopicId == topicId);
        if (assignment is null) return;
        try
        {
            await Api.RemoveTopicAssignmentAsync(assignment.AssignmentId);
            if (_disposed) return;
            await ReloadAssignedTopicsAsync();
            Toast.ShowSuccess($"Subject '{assignment.Name}' removed from grade.");
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _topicsError = $"Could not unassign topic: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ReloadAssignedTopicsAsync()
    {
        var assignments = await Api.ListGradeTopicsByGradeAsync(Id) ?? [];
        _assignedTopics = assignments
            .Select(a => new AssignedTopic
            {
                TopicId = a.TopicId,
                AssignmentId = a.Id,
                Name = _catalog.TryGetValue(a.TopicId, out var t) ? t.Name : a.TopicId.ToString()[..8],
                Code = _catalog.TryGetValue(a.TopicId, out var tc) ? tc.Code : null,
            })
            .OrderBy(t => t.Name)
            .ToList();
        // The card's meta line is derived from the exceptions, and the Subjects landing
        // can add/remove them — refresh so the card is never half-stale.
        await ReloadExceptionsAsync();
        // Same date-only/period-blind duplication as the initial load — dedupe so
        // the card never shows a subject twice after a mutation.
        _curriculum = (await Api.ListGradeTopicCurriculumByGradeAsync(Id) ?? [])
            .GroupBy(t => t.TopicId)
            .Select(g => g.First())
            .ToArray();

        // This is invoked from child components (the kebab menu, the grade topics
        // dialog) whose events re-render THEMSELVES, not this page. Without this,
        // the SectionCard never receives the refreshed Items after an add/remove.
        if (!_disposed) StateHasChanged();
    }

    private async Task OpenStrandsAsync(GradeTopicCurriculumDto topic)
    {
        // The unified Strands editor shows root strands AND their lessons (lessons
        // are parented strands — strand-lesson-unification-plan.md), so this dialog
        // is the single place to manage a topic's curriculum.
        var dialog = await DialogService.ShowReadonlyDialogAsync<TopicStrandsDialog>(
            $"Strands · {topic.Name}",
            new Dictionary<string, object?>
            {
                { TopicStrandsDialog.TopicIdKey, topic.TopicId },
                { TopicStrandsDialog.TopicNameKey, topic.Name },
                // The editor mutates strands/lessons; refresh the card once it closes.
                { TopicStrandsDialog.OnChangedKey, new Func<Task>(ReloadAssignedTopicsAsync) },
            },
            DialogSize.Medium);
        if (_disposed) return;
        await dialog.Result;
    }

