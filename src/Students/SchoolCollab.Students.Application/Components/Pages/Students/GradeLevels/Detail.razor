            RowAction.Callback("Teachers", () => OpenTopicTeachersAsync(topic), FluentIcons.People),
            RowAction.Separator(),
            RowAction.Callback(
                "Remove",
                () => RemoveTopicAsync(topic.TopicId),
                FluentIcons.Delete,
                destructive: true,
                confirmMessage: $"Remove subject '{topic.Name}' from this grade? The subject stays in the catalog; only this grade's assignment is removed."),
        };

    // Open the topic-teachers dialog (assign teachers + their per-topic roles,
    // grade-detail-rich-grids-plan.md §5). Await the reference so we refresh the
    // Teachers tab (Assigned Topics chips) once the dialog closes.
