@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Constants
@inject StudentsApiClient Api
@inject ConfigFlagsApiClient FlagsApi
@inject NavigationManager Nav
@inject ILogger<PeriodForm> Logger
@implements IDisposable

<div class="period-form">
    @if (ShowHeader)
    {
        <div class="form-section-header">
            <div>
                <h3>@HeaderText</h3>
                <p class="form-hint">@(PeriodId.HasValue ? EditHint : CreateHint)</p>
            </div>
        </div>
    }

    @if (!PeriodId.HasValue && ShowTip)
    {
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalGap="8"
                     VerticalAlignment="VerticalAlignment.Top"
                     class="form-tip">
            <FluentIcon Icon="@(Icons.Regular.Size20.Calendar)" />
            <span>@CreateHint</span>
        </FluentStack>
    }

    <FluentStack Orientation="Orientation.Vertical" Spacing="4">
        @* Period name + the Suggest/Backfill buttons. The row contains
           three controls (text field + two icon buttons) so the label
           is top-aligned (AlignTop) to sit naturally against the taller
           cell — matches the pre-FormRow visual. *@
        <FormRow Label="Period name *" AlignTop For="periodName">
            <FluentTextField Id="periodName" @bind-Value="_name"
                             Label=""
                             Placeholder="e.g. 2025–2026 Academic Year"
                             Style="flex:1; min-width:0" />
            <FluentButton IconStart="@FluentIcons.Calendar"
                          Title="Fill the form with the current academic year (editable template)"
                          OnClick="SuggestAcademicYearAsync" />
            <FluentButton IconStart="@FluentIcons.ArrowClockwise"
                          Title="Fill the form with the next academic year after the latest period"
                          OnClick="BackfillAsync" />
        </FormRow>

        @* Period type + parent academic year. The type selector is always
           shown; the parent dropdown appears only for Term/Semester. *@
        <FormRow Label="Period type *" AlignTop>
            <FluentSelect TOption="string" @bind-Value="_periodTypeText" Label="" Style="flex:1; min-width:0">
                <FluentOption Value="AcademicYear">Academic Year</FluentOption>
                @if (AllowTerm)
                {
                    <FluentOption Value="Term">Term</FluentOption>
                }
                @if (AllowSemester)
                {
                    <FluentOption Value="Semester">Semester</FluentOption>
                }
            </FluentSelect>
        </FormRow>
        @if (_division is not null)
        {
            <div class="form-hint">@DivisionHint</div>
        }

        @if (_periodTypeText != "AcademicYear")
        {
            <FormRow Label="Parent academic year *" AlignTop>
                <FluentSelect TOption="string" @bind-Value="_parentPeriodIdText" Label="" Style="flex:1; min-width:0">
                    <FluentOption Value="">— Select academic year —</FluentOption>
                    @foreach (var ay in _academicYears)
                    {
                        <FluentOption Value="@ay.Id.ToString()">@ay.Name</FluentOption>
                    }
                </FluentSelect>
            </FormRow>
        }

        @* Two date pickers side-by-side. AlignTop so the "Dates *" label
           sits at the top of the row (top-align reads better against a
           two-input cell than centering). *@
        <FormRow Label="Dates *" AlignTop>
            <FluentDatePicker @bind-Value="_start" Label="" Style="flex:1; min-width:0" />
            <FluentDatePicker @bind-Value="_end"   Label="" Style="flex:1; min-width:0" />
        </FormRow>
    </FluentStack>

    <div class="form-actions">
        @if (ShowCancel)
        {
            <FluentButton Appearance="Appearance.Outline" OnClick="CancelAsync">Cancel</FluentButton>
        }
        <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync" Disabled="@(_saving)">
            @(_saving ? "Saving…" : SubmitLabel)
        </FluentButton>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
    }
</div>

@code {
    /// <summary>
    /// When set, the form loads this period and switches to <b>edit</b> mode
    /// (PUT instead of POST). When null, the form creates a new Draft period.
    /// </summary>
    [Parameter] public Guid? PeriodId { get; set; }

    /// <summary>
    /// After creating, also activate the period (the grade-level wizard's
    /// "Open a term" gate uses this so a single click both creates and opens
    /// the term for the tenant).
    /// </summary>
    [Parameter] public bool AutoActivateOnCreate { get; set; }

    /// <summary>Label of the submit button. Defaults to "Create period".</summary>
    [Parameter] public string? SubmitLabel { get; set; } = "Create period";

    /// <summary>Route to navigate to when the user cancels (if no <see cref="OnCancel"/> delegate).</summary>
    [Parameter] public string? CancelRoute { get; set; }

    /// <summary>Fired when the user cancels. Takes precedence over <see cref="CancelRoute"/>.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Fired after a successful create or update, with the resolved <see cref="PeriodDto"/>.</summary>
    [Parameter] public EventCallback<PeriodDto> OnSaved { get; set; }

    /// <summary>Show the "New period" / "Edit period" header. The wizard's "Open a term" gate hides it.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Show the cancel button. Defaults to true.</summary>
    [Parameter] public bool ShowCancel { get; set; } = true;

    /// <summary>Show the academic-year tip under the header (create mode only). Defaults to true.</summary>
    [Parameter] public bool ShowTip { get; set; } = true;

    /// <summary>
    /// Pre-fill the form with the current academic year when creating and the
    /// name is still empty. Defaults to true.
    /// </summary>
    [Parameter] public bool PrefillAcademicYear { get; set; } = true;

    /// <summary>
    /// Optional pre-loaded period list used by the Backfill action. When null
    /// the form fetches it itself from the API. Lets callers (e.g. the wizard,
    /// which already loaded periods) avoid a duplicate request.
    /// </summary>
    [Parameter] public IEnumerable<PeriodDto>? ExistingPeriods { get; set; }

    /// <summary>
    /// When creating a sub-period, pre-selects this parent academic year and
    /// switches the type selector to Term. Used by the sub-period list's
    /// "+ New Sub-period" action (route query <c>?parent=…</c>).
    /// </summary>
    [Parameter] public Guid? InitialParentPeriodId { get; set; }

    private string _name = string.Empty;
    private DateTime? _start;
    private DateTime? _end;
    private string _periodTypeText = "AcademicYear";
    private string? _division;
    private string _parentPeriodIdText = "";
    private PeriodDto[] _academicYears = [];
    private bool _saving;
    private string? _error;
    private CancellationTokenSource? _cts;
    private volatile bool _disposed;
    private PeriodDto[]? _loadedPeriods;

    private string HeaderText => PeriodId.HasValue ? "Edit period" : "New period";

    private const string CreateHint =
        "Pre-filled with the current academic year (1 Sep – 31 Aug) as an editable template. " +
        "Use the buttons to suggest or backfill, then adjust as needed.";

    private const string EditHint = "Update the period name and date range.";

    /// <summary>
    /// Whether the Term option is offered. Null division (flag not loaded / error)
    /// falls back to allowing both sub-period types so the form is never broken by
    /// a failed flag read; a known division gates to the matching type only.
    /// </summary>
    private bool AllowTerm => _division is null or "Terms";

    private bool AllowSemester => _division is null or "Semesters";

    private string DivisionHint => _division switch
    {
        "Terms" => "This tenant's academic year division is Terms — only Term sub-periods are allowed.",
        "Semesters" => "This tenant's academic year division is Semesters — only Semester sub-periods are allowed.",
        // Unreachable in practice: the hint renders only when _division is not null;
        // default kept for switch exhaustiveness.
        _ => "This tenant's academic year division is None — only Academic Year periods are allowed."
    };

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        try
        {
            _loadedPeriods = await Api.ListPeriodsAsync(ct) ?? [];
            _academicYears = _loadedPeriods.Where(p => p.PeriodType == "AcademicYear").ToArray();

            // G4: load the tenant's academic-year division to gate the sub-period
            // type options, keeping client-side validation in sync with the server's
            // PeriodFrameworkMismatchException 422 gate.
            var division = await FlagsApi.GetAcademicYearDivisionAsync(ct);
            if (_disposed) return;
            _division = division?.Value;

            if (!PeriodId.HasValue && InitialParentPeriodId.HasValue)
            {
                _parentPeriodIdText = InitialParentPeriodId.Value.ToString();
                _periodTypeText = "Term";
            }

            if (PeriodId.HasValue)
            {
                var p = await Api.GetPeriodByIdAsync(PeriodId.Value, ct);
                if (p is not null)
                {
                    _name = p.Name;
                    _start = p.StartDate.ToDateTime(TimeOnly.MinValue);
                    _end = p.EndDate.ToDateTime(TimeOnly.MinValue);
                    _periodTypeText = p.PeriodType;
                    _parentPeriodIdText = p.ParentPeriodId?.ToString() ?? "";
                }
            }
            else if (PrefillAcademicYear && string.IsNullOrWhiteSpace(_name))
            {
                SuggestAcademicYearAsync();
            }

            // G4: if the current sub-period type is disallowed by the division
            // (e.g. editing a Semester under a Terms division, or a sub-period
            // under a None division), fall back to AcademicYear. An AcademicYear
            // must not carry a ParentPeriodId, or the server rejects the save.
            if ((_periodTypeText == "Term" && !AllowTerm)
                || (_periodTypeText == "Semester" && !AllowSemester))
            {
                _periodTypeText = "AcademicYear";
                _parentPeriodIdText = "";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to initialize period form");
            _error = ex.Message;
        }
    }

    private static PeriodType ParsePeriodType(string value) => value switch
    {
        "Term" => PeriodType.Term,
        "Semester" => PeriodType.Semester,
        _ => PeriodType.AcademicYear
    };

    private void SuggestAcademicYearAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        ApplySuggestion(AcademicYearSuggestion.ForDate(today));
    }

    private void BackfillAsync()
    {
        ApplySuggestion(AcademicYearSuggestion.BackfillFrom(ExistingPeriods ?? _loadedPeriods));
    }

    private void ApplySuggestion((string Name, DateOnly StartDate, DateOnly EndDate) suggestion)
    {
        _name = suggestion.Name;
        _start = suggestion.StartDate.ToDateTime(TimeOnly.MinValue);
        _end = suggestion.EndDate.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SubmitAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Enter a period name.";
            return;
        }
        if (_start is null || _end is null)
        {
            _error = "Enter a start and end date.";
            return;
        }
        if (_end.Value.Date < _start.Value.Date)
        {
            _error = "End date must be on or after the start date.";
            return;
        }
        if (_periodTypeText != "AcademicYear" && !Guid.TryParse(_parentPeriodIdText, out _))
        {
            _error = "Select a parent academic year for this period.";
            return;
        }

        _saving = true;
        try
        {
            var startDate = DateOnly.FromDateTime(_start.Value.Date);
            var endDate = DateOnly.FromDateTime(_end.Value.Date);
            var periodType = ParsePeriodType(_periodTypeText);
            Guid? parentId = Guid.TryParse(_parentPeriodIdText, out var pid) ? pid : null;
            PeriodDto? saved = null;

            if (PeriodId.HasValue)
            {
                await Api.UpdatePeriodAsync(PeriodId.Value, new UpdatePeriodRequest(_name.Trim(), startDate, endDate, periodType, parentId));
                saved = await Api.GetPeriodByIdAsync(PeriodId.Value);
            }
            else
            {
                var id = await Api.CreatePeriodAsync(new CreatePeriodRequest(_name.Trim(), startDate, endDate, periodType, parentId));
                if (AutoActivateOnCreate)
                {
                    await Api.ActivatePeriodAsync(id);
                }
                saved = await Api.GetPeriodByIdAsync(id);
            }

            if (_disposed) return;

            Logger.LogInformation("Period saved {Id} (edit={IsEdit})", saved?.Id, PeriodId.HasValue);
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to save period");
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private Task CancelAsync()
    {
        if (OnCancel.HasDelegate)
            return OnCancel.InvokeAsync();
        if (!string.IsNullOrEmpty(CancelRoute))
            Nav.NavigateTo(CancelRoute);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
