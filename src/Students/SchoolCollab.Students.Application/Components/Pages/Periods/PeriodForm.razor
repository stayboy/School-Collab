@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Students.Core.Domain
@using SchoolCollab.Admin.Shared.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Constants
@inject StudentsApiClient Api
@inject NavigationManager Nav
@inject ILogger<PeriodForm> Logger
@implements IDisposable

<div class="period-form">
    @if (ShowHeader)
    {
        <div class="form-section-header">
            <div>
                <h3>@HeaderText</h3>
                @if (!ShowBlockedPanel)
                {
                    <p class="form-hint">@(PeriodId.HasValue ? EditHint : CreateHint)</p>
                }
            </div>
        </div>
    }

    @if (ShowBlockedPanel)
    {
        @* P2-5: a None-division parent year cannot host sub-periods. Render an
           inline warning + a working back affordance instead of the dead-end
           form (the editable fields and submit row are hidden). *@
        <FluentMessageBar Intent="MessageIntent.Warning" class="mt-3">@BlockedParentMessage</FluentMessageBar>
        <div class="mt-3">
            <FluentButton Appearance="Appearance.Accent" Autofocus="true" OnClick="CancelAsync">Back to periods</FluentButton>
        </div>
    }
    else
    {
        @if (!PeriodId.HasValue && ShowTip)
        {
            <FluentStack Orientation="Orientation.Horizontal"
                         HorizontalGap="8"
                         VerticalAlignment="VerticalAlignment.Top"
                         class="form-tip">
                <FluentIcon Icon="@(Icons.Regular.Size20.Calendar)" />
                <span>@CreateHint</span>
            </FluentStack>
        }

        @* Shared field set (PeriodFormFields) — identical rows for create and
           edit. The create-only Suggest/Backfill buttons ride along via the
           NameActions fragment; the create-only sub-periods section renders
           below the shared fields. *@
        <PeriodFormFields Model="_model"
                          IsSubPeriod="_isSubPeriod"
                          DivisionLocked="_isSubPeriod"
                          AcademicYears="_academicYears"
                          DivisionChanged="OnDivisionChangedAsync">
            <NameActions>
                <FluentButton IconStart="@FluentIcons.Calendar"
                              Title="Fill the form with the current academic year (editable template)"
                              OnClick="SuggestAcademicYearAsync" />
                <FluentButton IconStart="@FluentIcons.ArrowClockwise"
                              Title="Fill the form with the next academic year after the latest period"
                              OnClick="BackfillAsync" />
            </NameActions>
        </PeriodFormFields>

        @* Sub-periods section (FR-C5) — shown only when creating a TOP-LEVEL
           Terms/Semesters academic year so the year and its sub-periods persist
           atomically in one create. Hidden for None division, for sub-period
           create (?parent=), and in edit mode. *@
        @if (ShowSubPeriodsSection)
        {
            <div class="sub-periods-section">
                <div class="sub-periods-header">
                    <h4>Sub-periods</h4>
                    <div class="sub-periods-actions">
                        <FluentButton Appearance="Appearance.Accent"
                                      OnClick="AutoSplitSubPeriodsAsync"
                                      Disabled="@(!_hasYearRange)"
                                      Title="@AutoSplitTitle">
                            @AutoSplitLabel
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="AddSubPeriodAsync">
                            + Add sub-period
                        </FluentButton>
                    </div>
                </div>
                <p class="form-hint">Terms/Semesters are created together with this year in a single operation.</p>
                @if (_subPeriodRows.Count == 0)
                {
                    <p class="muted">No sub-periods yet — add rows or use Auto-split.</p>
                }
                else
                {
                    @for (var rowIndex = 0; rowIndex < _subPeriodRows.Count; rowIndex++)
                    {
                        var row = _subPeriodRows[rowIndex];
                        <div class="sub-period-row">
                            <FluentTextField Label="" @bind-Value="row.Name"
                                             Placeholder="Name"
                                             Style="flex:1; min-width:0" />
                            <FluentDatePicker Label="" @bind-Value="row.Start" Style="flex:1; min-width:0" />
                            <FluentDatePicker Label="" @bind-Value="row.End"   Style="flex:1; min-width:0" />
                            <FluentButton IconStart="@FluentIcons.Dismiss"
                                          Title="Remove this sub-period"
                                          OnClick="@(() => RemoveSubPeriodAsync(rowIndex))" />
                        </div>
                    }
                }
            </div>
        }

        <div class="form-actions">
            @if (ShowCancel)
            {
                <FluentButton Appearance="Appearance.Outline" OnClick="CancelAsync">Cancel</FluentButton>
            }
            <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync" Disabled="@(_saving)">
                @(_saving ? "Saving…" : SubmitLabel)
            </FluentButton>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
    }
</div>

@code {
    /// <summary>
    /// When set, the form loads this period and switches to <b>edit</b> mode
    /// (PUT instead of POST). When null, the form creates a new Draft period.
    /// </summary>
    [Parameter] public Guid? PeriodId { get; set; }

    /// <summary>
    /// After creating, also activate the period (the grade-level wizard's
    /// "Open a term" gate uses this so a single click both creates and opens
    /// the term for the tenant).
    /// </summary>
    [Parameter] public bool AutoActivateOnCreate { get; set; }

    /// <summary>Label of the submit button. Defaults to "Create period".</summary>
    [Parameter] public string? SubmitLabel { get; set; } = "Create period";

    /// <summary>Route to navigate to when the user cancels (if no <see cref="OnCancel"/> delegate).</summary>
    [Parameter] public string? CancelRoute { get; set; }

    /// <summary>Fired when the user cancels. Takes precedence over <see cref="CancelRoute"/>.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Fired after a successful create or update, with the resolved <see cref="PeriodDto"/>.</summary>
    [Parameter] public EventCallback<PeriodDto> OnSaved { get; set; }

    /// <summary>Show the "New period" / "Edit period" header. The wizard's "Open a term" gate hides it.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Show the cancel button. Defaults to true.</summary>
    [Parameter] public bool ShowCancel { get; set; } = true;

    /// <summary>Show the academic-year tip under the header (create mode only). Defaults to true.</summary>
    [Parameter] public bool ShowTip { get; set; } = true;

    /// <summary>
    /// Pre-fill the form with the current academic year when creating and the
    /// name is still empty. Defaults to true.
    /// </summary>
    [Parameter] public bool PrefillAcademicYear { get; set; } = true;

    /// <summary>
    /// Optional pre-loaded period list used by the Backfill action. When null
    /// the form fetches it itself from the API. Lets callers (e.g. the wizard,
    /// which already loaded periods) avoid a duplicate request.
    /// </summary>
    [Parameter] public IEnumerable<PeriodDto>? ExistingPeriods { get; set; }

    /// <summary>
    /// When creating a sub-period, pre-selects this parent academic year and
    /// locks the division to the parent's division. Used by the sub-period
    /// list's "+ New Sub-period" action (route query <c>?parent=…</c>).
    /// </summary>
    [Parameter] public Guid? InitialParentPeriodId { get; set; }

    /// <summary>Form field state shared by the create and edit flows. Bound to
    /// <see cref="PeriodFormFields"/> via <see cref="PeriodFormFields.IPeriodFormModel"/>
    /// so both flows render identical fields backed by one model.</summary>
    private sealed class PeriodFormModel : PeriodFormFields.IPeriodFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string DivisionSelect { get; set; } = "None";
        public string ParentPeriodIdText { get; set; } = "";
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
    }

    private readonly PeriodFormModel _model = new();
    private bool _saving;
    private string? _error;
    private CancellationTokenSource? _cts;
    private volatile bool _disposed;
    private PeriodDto[]? _loadedPeriods;

    /// <summary>Sub-period definition rows for the atomic-create section (FR-C5).
    /// Only populated/shown in top-level Terms/Semesters create mode. Mutable so
    /// the two-way <c>@bind-Value</c> on the row's fields can write back.</summary>
    private sealed class SubPeriodRow
    {
        public string Name { get; set; } = "";
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
    }

    private readonly List<SubPeriodRow> _subPeriodRows = new();

    /// <summary>True when a valid year range is entered, enabling Auto-split (FR-C5).</summary>
    private bool _hasYearRange => _model.Start is not null && _model.End is not null && _model.End.Value.Date >= _model.Start.Value.Date;

    /// <summary>The Sub-periods section renders only in top-level Terms/Semesters
    /// create mode (FR-C5): not for None, not for sub-period create (?parent=), and
    /// not in edit mode (FR-C6).</summary>
    private bool ShowSubPeriodsSection =>
        !PeriodId.HasValue && !_isSubPeriod && !ShowBlockedPanel
        && (_model.DivisionSelect == nameof(AcademicYearDivision.Terms)
            || _model.DivisionSelect == nameof(AcademicYearDivision.Semesters)
            || _model.DivisionSelect == "Terms" || _model.DivisionSelect == "Semesters");

    /// <summary>True when the current period is a sub-period (has a parent). The
    /// division is locked to the parent's division and the parent dropdown is
    /// shown.</summary>
    private bool _isSubPeriod;

    /// <summary>True when a create-from-?parent= intent resolved to a None-division
    /// parent year, which cannot host sub-periods. The blocked panel replaces the
    /// editable form (P2-5).</summary>
    private bool _parentBlocked;

    private string HeaderText => PeriodId.HasValue ? "Edit period" : "New period";

    /// <summary>True when a create-from-?parent= intent resolved to a None-division
    /// parent year, which cannot host sub-periods. The blocked panel replaces the
    /// editable form (P2-5).</summary>
    private bool ShowBlockedPanel => !PeriodId.HasValue && _parentBlocked;

    private const string CreateHint =
        "Pre-filled with the current academic year (1 Sep – 31 Aug) as an editable template. " +
        "Use the buttons to suggest or backfill, then adjust as needed.";

    private const string EditHint = "Update the period name and date range.";

    /// <summary>Shown in the blocked panel when a None-division parent year cannot
    /// host sub-periods (P2-5).</summary>
    private const string BlockedParentMessage =
        "This academic year's division is 'None' — sub-periods are not allowed. " +
        "Create an Academic Year instead, or change the year's division.";

    /// <summary>Top-level academic years whose division matches the selected
    /// division — the valid parents for a sub-period of that kind.</summary>
    private PeriodDto[] _academicYears =>
        _loadedPeriods?.Where(p => p.ParentPeriodId is null && p.Division == _model.DivisionSelect).ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        try
        {
            _loadedPeriods = await Api.ListPeriodsAsync(ct) ?? [];

            // Pre-set the parent + lock the division to the parent year's division
            // when the user came here via ?parent=... (an explicit sub-period
            // intent). A None-division year cannot host sub-periods — surface that
            // as an error instead of silently falling back to a top-level year.
            if (!PeriodId.HasValue && InitialParentPeriodId.HasValue)
            {
                _model.ParentPeriodIdText = InitialParentPeriodId.Value.ToString();
                var parent = _loadedPeriods.FirstOrDefault(p => p.Id == InitialParentPeriodId.Value);
                _model.DivisionSelect = parent?.Division ?? "None";
                _isSubPeriod = true;
                if (_model.DivisionSelect == "None")
                {
                    // A None-division year cannot host sub-periods — block the form
                    // (P2-5) instead of surfacing a bottom-bar error with no escape.
                    _parentBlocked = true;
                }
            }

            if (PeriodId.HasValue)
            {
                var p = await Api.GetPeriodByIdAsync(PeriodId.Value, ct);
                if (p is not null)
                {
                    _model.Name = p.Name;
                    _model.Start = p.StartDate.ToDateTime(TimeOnly.MinValue);
                    _model.End = p.EndDate.ToDateTime(TimeOnly.MinValue);
                    _model.DivisionSelect = p.Division;
                    _model.ParentPeriodIdText = p.ParentPeriodId?.ToString() ?? "";
                    _isSubPeriod = p.ParentPeriodId.HasValue;
                }
            }
            else if (PrefillAcademicYear && string.IsNullOrWhiteSpace(_model.Name) && !_parentBlocked)
            {
                // P2-6: prefill is intentionally skipped in the blocked state (a
                // None-division parent cannot host sub-periods); the blocked panel
                // replaces the form.
                SuggestAcademicYearAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to initialize period form");
            _error = ex.Message;
        }
    }

    private static AcademicYearDivision ParseDivision(string value) =>
        Enum.TryParse<AcademicYearDivision>(value, out var division) ? division : AcademicYearDivision.None;

    /// <summary>Receives the shared field set's Division change so THIS component
    /// re-renders and re-evaluates ShowSubPeriodsSection (the binding writes into
    /// <see cref="_model"/> from inside <see cref="PeriodFormFields"/>, which alone
    /// would only re-render the child).</summary>
    private Task OnDivisionChangedAsync(string _) => Task.CompletedTask;

    private void SuggestAcademicYearAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        ApplySuggestion(AcademicYearSuggestion.ForDate(today));
    }

    private void BackfillAsync()
    {
        ApplySuggestion(AcademicYearSuggestion.BackfillFrom(ExistingPeriods ?? _loadedPeriods));
    }

    private void ApplySuggestion((string Name, DateOnly StartDate, DateOnly EndDate) suggestion)
    {
        _model.Name = suggestion.Name;
        _model.Start = suggestion.StartDate.ToDateTime(TimeOnly.MinValue);
        _model.End = suggestion.EndDate.ToDateTime(TimeOnly.MinValue);
    }

    // ── Sub-periods section (FR-C5) ──────────────────────────────────────────

    private void AddSubPeriodAsync()
        => _subPeriodRows.Add(new SubPeriodRow());

    private void RemoveSubPeriodAsync(int index)
    {
        if (index >= 0 && index < _subPeriodRows.Count)
            _subPeriodRows.RemoveAt(index);
    }

    /// <summary>The number of equal spans Auto-split produces for the selected
    /// division: 2 for Semesters, 3 for Terms (FR-C5). None never shows the
    /// sub-periods section, so it never reaches the split.</summary>
    private int AutoSplitCount
        => ParseDivision(_model.DivisionSelect) == AcademicYearDivision.Semesters ? 2 : 3;

    private string AutoSplitLabel => $"Auto-split into {AutoSplitCount}";

    private string AutoSplitTitle
        => $"Split the year range into {AutoSplitCount} equal spans";

    /// <summary>Splits the year range into the division-appropriate number of
    /// equal spans (2 for Semesters, 3 for Terms, within one day of each other)
    /// and replaces the rows, ready to be edited (FR-C5). Guards against ranges
    /// too short to split without producing an invalid (inverted) span.</summary>
    private void AutoSplitSubPeriodsAsync()
    {
        if (!_hasYearRange) return;
        var start = DateOnly.FromDateTime(_model.Start!.Value.Date);
        var end = DateOnly.FromDateTime(_model.End!.Value.Date);
        var dayCount = end.DayNumber - start.DayNumber + 1;
        var splitCount = AutoSplitCount;
        if (dayCount < splitCount) return;

        var kindName = ParseDivision(_model.DivisionSelect) == AcademicYearDivision.Semesters
            ? "Semester" : "Term";

        _subPeriodRows.Clear();
        for (var i = 0; i < splitCount; i++)
        {
            var spanStartDay = start.DayNumber + i * dayCount / splitCount;
            var spanEndDay = start.DayNumber + (i + 1) * dayCount / splitCount - 1;
            _subPeriodRows.Add(new SubPeriodRow
            {
                Name = $"{kindName} {i + 1}",
                Start = DateOnly.FromDayNumber(spanStartDay).ToDateTime(TimeOnly.MinValue),
                End = DateOnly.FromDayNumber(spanEndDay).ToDateTime(TimeOnly.MinValue),
            });
        }
    }

    /// <summary>Validates the sub-period rows against FR-C2 and materializes them
    /// into request definitions. Returns <c>false</c> with an inline error on the
    /// first violation (whole-request rejection, mirroring the server).</summary>
    private bool TryBuildSubPeriods(DateOnly startDate, DateOnly endDate, out IReadOnlyList<SubPeriodDefinitionRequest>? definitions, out string error)
    {
        definitions = null;
        error = "";
        var result = new List<SubPeriodDefinitionRequest>();
        foreach (var row in _subPeriodRows)
        {
            if (string.IsNullOrWhiteSpace(row.Name))
            {
                error = "Every sub-period needs a name.";
                return false;
            }
            if (row.Start is null || row.End is null)
            {
                error = $"Sub-period '{row.Name}' needs a start and end date.";
                return false;
            }
            var s = DateOnly.FromDateTime(row.Start.Value.Date);
            var e = DateOnly.FromDateTime(row.End.Value.Date);
            if (e < s)
            {
                error = $"Sub-period '{row.Name}' end date must be on or after its start date.";
                return false;
            }
            if (s < startDate || e > endDate)
            {
                error = $"Sub-period '{row.Name}' must be contained within the year range.";
                return false;
            }
            foreach (var other in result)
            {
                if (s <= other.EndDate && e >= other.StartDate)
                {
                    error = $"Sub-period '{row.Name}' overlaps sibling sub-period '{other.Name}'.";
                    return false;
                }
            }
            result.Add(new SubPeriodDefinitionRequest(row.Name.Trim(), s, e));
        }
        definitions = result;
        return true;
    }

    private async Task SubmitAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _error = "Enter a period name.";
            return;
        }
        if (_model.Start is null || _model.End is null)
        {
            _error = "Enter a start and end date.";
            return;
        }
        if (_model.End.Value.Date < _model.Start.Value.Date)
        {
            _error = "End date must be on or after the start date.";
            return;
        }

        var division = ParseDivision(_model.DivisionSelect);
        Guid? parentId = Guid.TryParse(_model.ParentPeriodIdText, out var pid) ? pid : null;

        if (_isSubPeriod && !parentId.HasValue)
        {
            _error = "Select a parent academic year for this period.";
            return;
        }
        if (division == AcademicYearDivision.None && parentId.HasValue)
        {
            _error = "A None-division period is a top-level academic year and must not have a parent.";
            return;
        }

        // ── Client-side sub-period validation mirrors FR-C2: every row needs a
        //    name + start/end, end >= start, containment in the year range, and no
        //    sibling overlap — before the submit is sent.
        IReadOnlyList<SubPeriodDefinitionRequest>? subPeriods = null;
        if (ShowSubPeriodsSection)
        {
            if (!TryBuildSubPeriods(startDate: DateOnly.FromDateTime(_model.Start.Value.Date), endDate: DateOnly.FromDateTime(_model.End.Value.Date), out subPeriods, out var subError))
            {
                _error = subError;
                return;
            }
        }

        _saving = true;
        try
        {
            var startDate = DateOnly.FromDateTime(_model.Start.Value.Date);
            var endDate = DateOnly.FromDateTime(_model.End.Value.Date);
            PeriodDto? saved = null;

            if (PeriodId.HasValue)
            {
                await Api.UpdatePeriodAsync(PeriodId.Value, new UpdatePeriodRequest(_model.Name.Trim(), startDate, endDate, division, parentId));
                saved = await Api.GetPeriodByIdAsync(PeriodId.Value);
            }
            else
            {
                var id = await Api.CreatePeriodAsync(new CreatePeriodRequest(_model.Name.Trim(), startDate, endDate, division, parentId, subPeriods));
                if (AutoActivateOnCreate)
                {
                    await Api.ActivatePeriodAsync(id);
                }
                saved = await Api.GetPeriodByIdAsync(id);
            }

            if (_disposed) return;

            Logger.LogInformation("Period saved {Id} (edit={IsEdit})", saved?.Id, PeriodId.HasValue);
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to save period");
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private Task CancelAsync()
    {
        if (OnCancel.HasDelegate)
            return OnCancel.InvokeAsync();
        if (!string.IsNullOrEmpty(CancelRoute))
            Nav.NavigateTo(CancelRoute);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
