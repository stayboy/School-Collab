@page "/students/periods"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Components.Landing
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Periods> Logger
@inject VisibleTenantService VisibleTenant
@inject IToastService Toast
@implements IDisposable

@if (_isRealTenant)
{
    <div class="period-active-chip" role="status">
        <span class="period-active-chip__label">Active tenant period:</span>
        @if (_activeYear is null)
        {
            <FluentBadge Appearance="Appearance.Neutral">None — no active academic year</FluentBadge>
        }
        else
        {
            <FluentBadge Appearance="Appearance.Accent">@_activeYear.Name</FluentBadge>
        }
    </div>
}

<LandingPage TItem="PeriodLandingDto"
             Title="Periods"
             CreateLabel="+ New Period"
             CreateRoute="/students/periods/create"
             CreateEnabled="@_isRealTenant"
             SearchEnabled="false"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_items"
             Loading="@_loading"
             GridSettings="@_gridSettings"
             Error="@_error"
             RowActions="@BuildPeriodActions"
             RowActionsUseMenuService="false"
             RowActionsAriaLabel="Period actions">
    <Columns>
        <TemplateColumn TGridItem="PeriodLandingDto" Title="Name" Sortable="true" SortBy="@_sortByName">
            <FluentAnchor Appearance="Appearance.Lightweight"
                          Href="@($"/students/periods/{context.Id}/edit")"
                          title="Edit period">@context.Name</FluentAnchor>
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodLandingDto" Title="Academic Division">
            <FluentBadge Appearance="Appearance.Neutral">@GetDivisionLabel(context)</FluentBadge>
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodLandingDto" Title="Sub-periods">
            @if (context.SubPeriodCount > 0)
            {
                @* Worded link ("2 sub-periods") rather than a bare count: the
                   bare digit is a tiny click target in a dense grid. *@
                <FluentAnchor Appearance="Appearance.Lightweight"
                              OnClick="@(() => OpenSubPeriodsDialogAsync(context.Id, context.Name))"
                              title="View sub-periods">@context.SubPeriodCount sub-period@(context.SubPeriodCount == 1 ? "" : "s")</FluentAnchor>
            }
            else
            {
                <span class="muted">None</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodLandingDto" Title="Start Date">
            @context.StartDate.ToString("d")
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodLandingDto" Title="End Date">
            @context.EndDate.ToString("d")
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodLandingDto" Title="Status">
            <FluentBadge Appearance="@GetStatusAppearance(context.Status)">@context.Status</FluentBadge>
        </TemplateColumn>
    </Columns>
</LandingPage>

@code {
    private PeriodLandingDto[]? _items;
    private string? _error;
    private bool _loading = true;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    /// <summary>The tenant's currently-active academic year, resolved from the
    /// <c>GET /students/periods/active-academic-year</c> endpoint (NOT derived
    /// from the grid's top-level snapshot) so it stays authoritative after an
    /// activation/completion — the "Activate/Complete" force a re-query via
    /// <see cref="RefreshActiveAsync"/>.</summary>
    private PeriodDto? _activeYear;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "minmax(160px,2fr) 140px 180px 180px 190px 110px auto"
    };

    private static readonly GridSort<PeriodLandingDto> _sortByName =
        GridSort<PeriodLandingDto>.ByAscending(x => x.Name);

    /// <summary>Top-level periods only. The backing endpoint
    /// (<c>GET /students/periods/top-level</c>) returns academic years with
    /// server-computed sub-period counts; sub-period rows never reach the UI,
    /// and no client-side memoization is needed.</summary>
    private string CurrentEmptyMessage =>
        !_isRealTenant
            ? "Select a tenant to manage periods."
            : "No periods yet. Create one to get started.";

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            _loading = false;
            return;
        }

        Logger.LogInformation("Loading top-level periods list");
        try
        {
            _items = await Api.ListTopLevelPeriodsAsync(token);
            if (_disposed) return;
            Logger.LogInformation("Loaded {Count} top-level periods", _items?.Length ?? 0);
            await RefreshActiveAsync(token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load top-level periods");
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    /// <summary>Renders the academic division for the landing grid column:
    /// "None" is shown as "—" since a standalone year has no division.</summary>
    private static string GetDivisionLabel(PeriodLandingDto period)
        => string.IsNullOrEmpty(period.Division) || period.Division == "None" ? "—" : period.Division;

    /// <summary>Re-queries the tenant's active academic year via the dedicated
    /// endpoint. Called on load and after Activate/Complete so the chip tracks
    /// the authoritative server state (never a stale list-derived pointer).</summary>
    private async Task RefreshActiveAsync(CancellationToken ct = default)
    {
        if (_disposed) return;
        try
        {
            _activeYear = await Api.GetActiveAcademicYearAsync(ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to refresh active academic year indicator");
        }
        finally
        {
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task OnActivateAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            "Activate this period? Once active, enrollments can begin.",
            "Activate",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Activating period {Id}", id);
        try
        {
            await Api.ActivatePeriodAsync(id);
            _error = null;
            Toast.ShowSuccess($"Period '{_periodName(id)}' activated.");
            // Re-fetch the list so server-side cascade completions (the prior
            // active year/siblings are closed by ActivatePeriodHandler) are
            // reflected without a manual refresh.

            await ReloadAsync();
            await RefreshActiveAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to activate period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnCompleteAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            "Complete this period? This will finalize the period.",
            "Complete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Completing period {Id}", id);
        try
        {
            await Api.CompletePeriodAsync(id);
            _error = null;
            Toast.ShowSuccess($"Period '{_periodName(id)}' completed.");
            await ReloadAsync();
            await RefreshActiveAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to complete period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnDeleteAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var period = _items.First(p => p.Id == id);
        // FR-D9: every landing row is a top-level year, so the confirmation
        // names its server-computed Draft sub-period count.
        var message = PeriodDeletePrompts.YearMessage(period.Name, period.DraftSubPeriodCount);

        var dialog = await DialogService.ShowConfirmationAsync(message, "Delete", "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Deleting period {Id}", id);
        try
        {
            await Api.DeletePeriodAsync(id);
            _error = null;
            Toast.ShowSuccess($"Period '{_periodName(id)}' deleted.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>FR-X9: deactivates an Active period, freeing its date range so a
    /// corrected period can be created. Confirmation wording shared via
    /// <see cref="PeriodDeactivatePrompts"/> (FR-X9/X10).</summary>
    private async Task OnDeactivateAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var period = _items.First(p => p.Id == id);
        var dialog = await DialogService.ShowConfirmationAsync(
            PeriodDeactivatePrompts.DeactivateMessage(period.Name),
            "Deactivate",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Deactivating period {Id}", id);
        try
        {
            await Api.DeactivatePeriodAsync(id);
            _error = null;
Toast.ShowSuccess($"Period '{_periodName(id)}' deactivated.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to deactivate period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>FR-X5/X9: archives a Deactivated row (cleanup path).</summary>
    private async Task OnArchiveAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var period = _items.First(p => p.Id == id);
        var dialog = await DialogService.ShowConfirmationAsync(
            PeriodDeactivatePrompts.ArchiveMessage(period.Name),
            "Archive",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Archiving period {Id}", id);
        try
        {
            await Api.ArchivePeriodAsync(id);
            _error = null;
Toast.ShowSuccess($"Period '{_periodName(id)}' archived.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to archive period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Re-fetches the top-level period list after a successful activate/complete
    /// so the server-side cascade (prior active year/siblings closed by the
    /// handler) is reflected without a manual refresh.
    /// </summary>
    private async Task ReloadAsync()
    {
        if (_disposed) return;
        try
        {
            _items = await Api.ListTopLevelPeriodsAsync(_loadCts?.Token ?? CancellationToken.None);
            if (_disposed) return;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload top-level periods");
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>Resolves a period's display name for the success toasts, using
    /// the in-memory list (single source so all actions share one lookup).</summary>
    private string _periodName(Guid id)
        => _items?.FirstOrDefault(p => p.Id == id)?.Name ?? "this period";

    private IReadOnlyList<RowAction> BuildPeriodActions(PeriodLandingDto period)
    {
        var actions = new List<RowAction>();
        if (period.Status == "Draft")
        {
            // FR-G6: activating a top-level Terms/Semesters year requires at least
            // one Draft sub-period (hard guard, FR-G1). When none exist, disable the
            // Activate action and use the explanatory label as the tooltip.
            var guarded =
                (period.Division == "Terms" || period.Division == "Semesters")
                && period.DraftSubPeriodCount == 0;
            if (guarded)
            {
                actions.Add(RowAction.Callback(
                    "Add a draft Term/Semester to activate",
                    () => OnActivateAsync(period.Id),
                    FluentIcons.ArrowExportUp,
                    disabled: true));
            }
            else
            {
                actions.Add(RowAction.Callback("Activate", () => OnActivateAsync(period.Id), FluentIcons.ArrowExportUp));
            }

            // FR-D9: Draft rows offer Delete. Draft rows have two actions (Activate +
            // Delete), so the shared RowActionsMenu renders them as a kebab menu; the
            // Delete item keeps its Title and is reachable via the kebab trigger's tab
            // stop + menu keyboard navigation (NFR-D3, AC-D9). Non-Draft statuses never
            // reach this branch (AC-D8).
            actions.Add(RowAction.Callback("Delete", () => OnDeleteAsync(period.Id), FluentIcons.Delete));
        }
        else if (period.Status == "Active")
        {
            // FR-X9: Active rows offer Complete AND Deactivate — the shared
            // RowActionsMenu renders them as a kebab (2+ actions).
            actions.Add(RowAction.Callback("Complete", () => OnCompleteAsync(period.Id), FluentIcons.Checkmark));
            actions.Add(RowAction.Callback("Deactivate", () => OnDeactivateAsync(period.Id), FluentIcons.Dismiss));
        }
        else if (period.Status == "Deactivated")
        {
            // FR-X5/X9: Deactivated rows are not deletable and not re-activatable, but
            // they can be archived (cleanup path). Single action → labeled button.
            actions.Add(RowAction.Callback("Archive", () => OnArchiveAsync(period.Id), FluentIcons.Book));
        }
        return actions;
    }

    /// <summary>
    /// Opens the read-only sub-periods list for an academic year in a dialog
    /// (FR-4). The dialog mutations re-fetch its own list AND invoke
    /// <see cref="ReloadAsync"/> so the landing grid stays in sync.
    /// </summary>
    private async Task OpenSubPeriodsDialogAsync(Guid yearId, string yearName)
    {
        if (_disposed) return;
        await DialogService.ShowReadonlyDialogAsync<SubPeriodsListDialog>(
            $"Sub-periods — {yearName}",
            new Dictionary<string, object?>
            {
                { SubPeriodsListDialog.YearIdKey, yearId },
                { SubPeriodsListDialog.YearNameKey, yearName },
                { SubPeriodsListDialog.OnChangedKey, new Func<Task>(ReloadAsync) },
            },
            DialogSize.Large);
    }

    private static Appearance GetStatusAppearance(string status) => status switch
    {
        "Draft"     => Appearance.Neutral,
        "Active"    => Appearance.Accent,
        "Completed" => Appearance.Lightweight,
        "Archived"  => Appearance.Neutral,
        "Deactivated" => Appearance.Neutral,
        _           => Appearance.Neutral
    };

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
