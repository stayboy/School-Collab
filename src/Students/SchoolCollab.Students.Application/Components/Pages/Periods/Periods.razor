@page "/students/periods"
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Components.Landing
@using Microsoft.FluentUI.AspNetCore.Components
@inject StudentsApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Periods> Logger
@inject VisibleTenantService VisibleTenant
@implements IDisposable

<LandingPage TItem="PeriodDto"
             Title="Periods"
             CreateLabel="+ New Period"
             CreateRoute="/students/periods/create"
             CreateEnabled="@_isRealTenant"
             SearchEnabled="false"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@_items"
             Loading="@_loading"
             GridSettings="@_gridSettings"
             Error="@_error"
             RowActions="@BuildPeriodActions"
             RowActionsUseMenuService="false"
             RowActionsAriaLabel="Period actions">
    <Columns>
        <TemplateColumn TGridItem="PeriodDto" Title="Name" Sortable="true" SortBy="@_sortByName">
            <FluentAnchor Appearance="Appearance.Lightweight"
                          Href="@($"/students/periods/{context.Id}/edit")"
                          title="Edit period">@GetDisplayName(context)</FluentAnchor>
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodDto" Title="Type">
            <FluentBadge Appearance="Appearance.Neutral">@GetKindLabel(context)</FluentBadge>
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodDto" Title="Sub-periods">
            @if (context.ParentPeriodId is null)
            {
                var count = GetSubPeriodCount(context.Id);
                if (count > 0)
                {
                    <FluentAnchor Appearance="Appearance.Lightweight"
                                  OnClick="@(() => OpenSubPeriodsDialogAsync(context.Id, context.Name))"
                                  title="View sub-periods">@count</FluentAnchor>
                }
                else
                {
                    <span class="muted">0</span>
                }
            }
            else
            {
                <span aria-hidden="true">—</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodDto" Title="Start Date">
            @context.StartDate.ToString("d")
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodDto" Title="End Date">
            @context.EndDate.ToString("d")
        </TemplateColumn>
        <TemplateColumn TGridItem="PeriodDto" Title="Status">
            <FluentBadge Appearance="@GetStatusAppearance(context.Status)">@context.Status</FluentBadge>
        </TemplateColumn>
    </Columns>
</LandingPage>

@code {
    private PeriodDto[]? _items;
    private string? _error;
    private bool _loading = true;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _isRealTenant;

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "minmax(160px,2fr) 140px 180px 180px 190px 110px auto"
    };

    private static readonly GridSort<PeriodDto> _sortByName =
        GridSort<PeriodDto>.ByAscending(x => x.Name);

    /// <summary>Parent-year → number of sub-period rows, memoized on load from
    /// the flat list (years AND sub-periods) returned by <see cref="ListPeriodsAsync"/>
    /// so no per-row fetch is needed for the count column.</summary>
    private Dictionary<Guid, int> _subPeriodCounts = new();

    /// <summary>Parent-year → number of <b>Draft</b> sub-period rows, memoized on
    /// load from the flat list. Used by <see cref="BuildPeriodActions"/> to disable
    /// Activate for a Terms/Semesters year with zero Draft sub-periods (FR-G6).</summary>
    private Dictionary<Guid, int> _draftSubPeriodCounts = new();

    /// <summary>Parent-year → comma-delimited sub-period names, memoized on load
    /// from the flat list so no per-row fetch is needed for the name column.</summary>
    private Dictionary<Guid, string> _subPeriodNames = new();

    private string CurrentEmptyMessage =>
        !_isRealTenant
            ? "Select a tenant to manage periods."
            : "No periods yet. Create one to get started.";

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        var scope = await VisibleTenant.GetScopeAsync();
        _isRealTenant = scope.IsRealTenant;
        if (!_isRealTenant)
        {
            _items = [];
            _loading = false;
            return;
        }

        Logger.LogInformation("Loading periods list");
        try
        {
            _items = await Api.ListPeriodsAsync(token);
            if (_disposed) return;
            Logger.LogInformation("Loaded {Count} periods", _items?.Length ?? 0);
            _subPeriodCounts = BuildSubPeriodCounts(_items);
            _subPeriodNames = BuildSubPeriodNames(_items);
            _draftSubPeriodCounts = BuildDraftSubPeriodCounts(_items);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load periods");
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    /// <summary>Renders the period kind label from its division + parent: a
    /// top-level year is "Academic Year"; a Terms/Semesters sub-period is
    /// "Term"/"Semester".</summary>
    private static string GetKindLabel(PeriodDto period)
        => period.ParentPeriodId is null ? "Academic Year" : period.Division == "Terms" ? "Term" : "Semester";

    /// <summary>Renders "PeriodName (sub1, sub2)" for academic years with
    /// sub-periods; the plain name otherwise.</summary>
    private string GetDisplayName(PeriodDto period)
        => period.ParentPeriodId is null
            && _subPeriodNames.TryGetValue(period.Id, out var subs)
            && !string.IsNullOrEmpty(subs)
            ? $"{period.Name} ({subs})"
            : period.Name;

    private static Dictionary<Guid, string> BuildSubPeriodNames(PeriodDto[]? items)
    {
        var names = new Dictionary<Guid, string>();
        if (items is null) return names;
        foreach (var p in items)
        {
            if (p.ParentPeriodId is null) continue;
            if (p.ParentPeriodId is not { } parentId) continue;
            names[parentId] = names.TryGetValue(parentId, out var existing)
                ? $"{existing}, {p.Name}"
                : p.Name;
        }
        return names;
    }

    private async Task OnActivateAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            "Activate this period? Once active, enrollments can begin.",
            "Activate",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Activating period {Id}", id);
        try
        {
            await Api.ActivatePeriodAsync(id);
            _error = null;
            // Re-fetch the list so server-side cascade completions (the prior
            // active year/siblings are closed by ActivatePeriodHandler) are
            // reflected without a manual refresh.
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to activate period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnCompleteAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            "Complete this period? This will finalize the period.",
            "Complete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Completing period {Id}", id);
        try
        {
            await Api.CompletePeriodAsync(id);
            _error = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to complete period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnDeleteAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var period = _items.First(p => p.Id == id);
        // FR-D9: a top-level year names the memoized Draft sub-period count; a
        // sub-period names its kind. GetDraftSubPeriodCount counts only Draft subs,
        // exactly the confirmation semantics.
        var message = period.ParentPeriodId is null
            ? PeriodDeletePrompts.YearMessage(period.Name, GetDraftSubPeriodCount(period.Id))
            : PeriodDeletePrompts.SubPeriodMessage(period.Name, GetKindLabel(period));

        var dialog = await DialogService.ShowConfirmationAsync(message, "Delete", "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Deleting period {Id}", id);
        try
        {
            await Api.DeletePeriodAsync(id);
            _error = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>FR-X9: deactivates an Active period, freeing its date range so a
    /// corrected period can be created. Confirmation wording shared via
    /// <see cref="PeriodDeactivatePrompts"/> (FR-X9/X10).</summary>
    private async Task OnDeactivateAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var period = _items.First(p => p.Id == id);
        var dialog = await DialogService.ShowConfirmationAsync(
            PeriodDeactivatePrompts.DeactivateMessage(period.Name),
            "Deactivate",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Deactivating period {Id}", id);
        try
        {
            await Api.DeactivatePeriodAsync(id);
            _error = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to deactivate period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>FR-X5/X9: archives a Deactivated row (cleanup path).</summary>
    private async Task OnArchiveAsync(Guid id)
    {
        if (_disposed || _items is null) return;

        var period = _items.First(p => p.Id == id);
        var dialog = await DialogService.ShowConfirmationAsync(
            PeriodDeactivatePrompts.ArchiveMessage(period.Name),
            "Archive",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        Logger.LogInformation("Archiving period {Id}", id);
        try
        {
            await Api.ArchivePeriodAsync(id);
            _error = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to archive period {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Re-fetches the period list after a successful activate/complete so the
    /// server-side cascade (prior active year/siblings closed by the handler) is
    /// reflected without a manual refresh.
    /// </summary>
    private async Task ReloadAsync()
    {
        if (_disposed) return;
        try
        {
            _items = await Api.ListPeriodsAsync(_loadCts?.Token ?? CancellationToken.None);
            if (_disposed) return;
            _subPeriodCounts = BuildSubPeriodCounts(_items);
            _subPeriodNames = BuildSubPeriodNames(_items);
            _draftSubPeriodCounts = BuildDraftSubPeriodCounts(_items);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to reload periods");
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private IReadOnlyList<RowAction> BuildPeriodActions(PeriodDto period)
    {
        var actions = new List<RowAction>();
        if (period.Status == "Draft")
        {
            // FR-G6: activating a top-level Terms/Semesters year requires at least
            // one Draft sub-period (hard guard, FR-G1). When none exist, disable the
            // Activate action and use the explanatory label as the tooltip.
            var guarded =
                period.ParentPeriodId is null
                && (period.Division == "Terms" || period.Division == "Semesters")
                && GetDraftSubPeriodCount(period.Id) == 0;
            if (guarded)
            {
                actions.Add(RowAction.Callback(
                    "Add a draft Term/Semester to activate",
                    () => OnActivateAsync(period.Id),
                    FluentIcons.ArrowExportUp,
                    disabled: true));
            }
            else
            {
                actions.Add(RowAction.Callback("Activate", () => OnActivateAsync(period.Id), FluentIcons.ArrowExportUp));
            }

            // FR-D9: Draft rows offer Delete. Draft rows have two actions (Activate +
            // Delete), so the shared RowActionsMenu renders them as a kebab menu; the
            // Delete item keeps its Title and is reachable via the kebab trigger's tab
            // stop + menu keyboard navigation (NFR-D3, AC-D9). Non-Draft statuses never
            // reach this branch (AC-D8).
            actions.Add(RowAction.Callback("Delete", () => OnDeleteAsync(period.Id), FluentIcons.Delete));
        }
        else if (period.Status == "Active")
        {
            // FR-X9: Active rows offer Complete AND Deactivate — the shared
            // RowActionsMenu renders them as a kebab (2+ actions).
            actions.Add(RowAction.Callback("Complete", () => OnCompleteAsync(period.Id), FluentIcons.Checkmark));
            actions.Add(RowAction.Callback("Deactivate", () => OnDeactivateAsync(period.Id), FluentIcons.Dismiss));
        }
        else if (period.Status == "Deactivated")
        {
            // FR-X5/X9: Deactivated rows are not deletable and not re-activatable, but
            // they can be archived (cleanup path). Single action → labeled button.
            actions.Add(RowAction.Callback("Archive", () => OnArchiveAsync(period.Id), FluentIcons.Book));
        }
        return actions;
    }

    private int GetSubPeriodCount(Guid yearId)
        => _subPeriodCounts.TryGetValue(yearId, out var count) ? count : 0;

    private int GetDraftSubPeriodCount(Guid yearId)
        => _draftSubPeriodCounts.TryGetValue(yearId, out var count) ? count : 0;

    private static Dictionary<Guid, int> BuildDraftSubPeriodCounts(PeriodDto[]? items)
    {
        var counts = new Dictionary<Guid, int>();
        if (items is null) return counts;
        foreach (var p in items)
        {
            if (p.ParentPeriodId is not { } parentId || p.Status != "Draft") continue;
            counts[parentId] = counts.TryGetValue(parentId, out var n) ? n + 1 : 1;
        }
        return counts;
    }

    private static Dictionary<Guid, int> BuildSubPeriodCounts(PeriodDto[]? items)
    {
        var counts = new Dictionary<Guid, int>();
        if (items is null) return counts;
        foreach (var p in items)
        {
            if (p.ParentPeriodId is null) continue;
            if (p.ParentPeriodId is not { } parentId) continue;
            counts[parentId] = counts.TryGetValue(parentId, out var n) ? n + 1 : 1;
        }
        return counts;
    }

    /// <summary>
    /// Opens the read-only sub-periods list for an academic year in a dialog
    /// (FR-4). The dialog mutations re-fetch its own list AND invoke
    /// <see cref="ReloadAsync"/> so the landing grid stays in sync.
    /// </summary>
    private async Task OpenSubPeriodsDialogAsync(Guid yearId, string yearName)
    {
        if (_disposed) return;
        await DialogService.ShowReadonlyDialogAsync<SubPeriodsListDialog>(
            $"Sub-periods — {yearName}",
            new Dictionary<string, object?>
            {
                { SubPeriodsListDialog.YearIdKey, yearId },
                { SubPeriodsListDialog.YearNameKey, yearName },
                { SubPeriodsListDialog.OnChangedKey, new Func<Task>(ReloadAsync) },
            },
            DialogSize.Medium);
    }

    private static Appearance GetStatusAppearance(string status) => status switch
    {
        "Draft"     => Appearance.Neutral,
        "Active"    => Appearance.Accent,
        "Completed" => Appearance.Lightweight,
        "Archived"  => Appearance.Neutral,
        "Deactivated" => Appearance.Neutral,
        _           => Appearance.Neutral
    };

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
