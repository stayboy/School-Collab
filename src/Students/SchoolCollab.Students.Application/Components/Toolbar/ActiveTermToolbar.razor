@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.Extensions.Logging
@using SchoolCollab.Students.Application.Services
@using SchoolCollab.Admin.Shared.Services
@inject StudentsApiClient Api
@inject NavigationManager Nav
@inject VisibleTenantService VisibleTenant
@inject ILogger<ActiveTermToolbar> Logger
@implements IDisposable

@if (_isRealTenant)
{
    <span class="active-term-link">
        <FluentAnchor Href="/students/periods"
                      Appearance="Appearance.Hypertext"
                      IconStart="@(new Icons.Regular.Size20.Calendar())"
                      Title="@_title">
            @if (_loading)
            {
                <span class="active-term-muted">Loading term…</span>
            }
            else if (DisplayName is not null)
            {
                <span class="active-term-name">@DisplayName</span>
            }
            else
            {
                <span class="active-term-muted">No active period</span>
            }
        </FluentAnchor>
    </span>
}
else
{
    @* No real (non-default) tenant is in scope. The per-tenant UI is hidden
       by design (TestAuthHandler defaults to Guid.Empty until a tenant is
       picked) so we surface a compact, non-clickable hint in the toolbar slot
       instead of leaving the area blank — the user can then see the dev
       tenant switcher next to it and select a tenant to unlock the
       active-term view. *@
    <span class="active-term-link active-term-link--muted"
          title="Select a tenant (dev switcher on the right) to view the active academic period.">
        <FluentIcon Value="@(new Icons.Regular.Size20.Calendar())" />
        <span class="active-term-muted">No tenant</span>
    </span>
}

@code {
    private PeriodDto? _activeYear;
    private PeriodDto? _activeSubPeriod;
    private bool _loading = true;
    private bool _isRealTenant;
    private CancellationTokenSource? _cts;
    private volatile bool _disposed;
    private string _title = "View academic periods";

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync(_cts.Token);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = LoadAsync(_cts?.Token ?? CancellationToken.None);

    private async Task LoadAsync(CancellationToken ct)
    {
        try
        {
            // Only surface the active term when a real (non-default) tenant
            // is in scope; with no tenancy there is nothing tenant-scoped to show.
            var scope = await VisibleTenant.GetScopeAsync();
            if (_disposed) return;
            _isRealTenant = scope.IsRealTenant;
            if (!_isRealTenant)
            {
                _activeYear = null;
                _activeSubPeriod = null;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var year = await Api.GetActiveAcademicYearAsync(ct);
            var sub = await Api.GetActiveSubPeriodAsync(ct);
            if (_disposed) return;
            _activeYear = year;
            _activeSubPeriod = sub;
            _title = DisplayName is not null
                ? $"Active period: {DisplayName}. View, open or close periods."
                : "No active academic period. View or open a period.";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to load active period for toolbar");
            _activeYear = null;
            _activeSubPeriod = null;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    /// <summary>
    /// Renders both hierarchy layers: the active AcademicYear plus the optional
    /// active sub-period (Term/Semester), e.g. "2025–2026 · Term 1". Falls back
    /// to whichever layer is present when the other is null.
    /// </summary>
    private string? DisplayName
    {
        get
        {
            if (_activeYear is null && _activeSubPeriod is null) return null;
            if (_activeYear is null) return _activeSubPeriod!.Name;
            if (_activeSubPeriod is null) return _activeYear.Name;
            return $"{_activeYear.Name} · {_activeSubPeriod.Name}";
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
