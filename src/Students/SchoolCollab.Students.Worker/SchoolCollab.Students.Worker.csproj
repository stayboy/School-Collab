<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ServiceDefaults\SchoolCollab.ServiceDefaults\SchoolCollab.ServiceDefaults.csproj" />
    <ProjectReference Include="..\SchoolCollab.Students.Core\SchoolCollab.Students.Core.csproj" />
    <!-- Settings.Core: ITenantDirectory (FR-16) — the tenant registry lives in the
         Settings DB; the worker needs read-only tenant enumeration for the
         per-tenant PromotionService loop. Registered via AddTenantDirectory(). -->
    <ProjectReference Include="..\..\Settings\SchoolCollab.Settings.Core\SchoolCollab.Settings.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.RabbitMQ.Client" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The Worker uses Microsoft.NET.Sdk (not Microsoft.NET.Sdk.Web), so
      appsettings*.json are NOT auto-copied to the output directory. Without
      this Content element, the Outbox.ExchangeName configuration (and any other
      values in appsettings.json) silently disappear at runtime, producing
      OptionsValidationException: "ExchangeName must be set in the 'Outbox'
      configuration section." in any deployment scenario where the content
      root is the published bin/ directory rather than the source tree.
      See https://learn.microsoft.com/dotnet/core/extensions/configuration
    -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>