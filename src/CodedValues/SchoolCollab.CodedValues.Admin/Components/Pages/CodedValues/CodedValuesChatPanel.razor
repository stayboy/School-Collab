@implements IDisposable

@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesChatHub ChatHub

@* Side-drawer surface for the AI assistant chat. The page toggles
   <see cref="Open"/>; this component renders the drawer shell, hosts a
   single read-only <see cref="CodedValuesChat"/> bound to
   <see cref="CodedValuesChatHub"/>, and forwards close requests back to
   the page via <see cref="OpenChanged"/>.

   The drawer is read-only: users prompt from the inline chat on the page;
   the drawer surfaces the responses. There is no second input area here. *@

<SideDrawer @bind-Open="Open"
            Title="✨ AI Assistant"
            Width="420px">
    <div class="chat-panel">
        <CodedValuesChat Mode="CodedValuesChat.CodedValuesChatMode.DisplayOnly"
                        HideHeader="true"
                        ExternalMessages="@_mirroredMessages"
                        ExternalStreamingState="@_mirroredStreamingState" />
    </div>
</SideDrawer>

@code {
    /// <summary>Whether the drawer is visible. Two-way bindable.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Fires when the drawer requests to close (× button, backdrop, Esc).</summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    private IReadOnlyList<CodedValuesChat.ChatMessageItem> _mirroredMessages = [];
    private CodedValuesChat.ChatStreamingState _mirroredStreamingState =
        new(IsStreaming: false, StreamingText: string.Empty, ActiveToolCalls: null);

    protected override void OnInitialized()
    {
        _mirroredMessages = ChatHub.Messages;
        _mirroredStreamingState = ChatHub.StreamingState;
        ChatHub.Changed += HandleHubChanged;
    }

    private void HandleHubChanged()
    {
        _ = InvokeAsync(() =>
        {
            _mirroredMessages = ChatHub.Messages;
            _mirroredStreamingState = ChatHub.StreamingState;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ChatHub.Changed -= HandleHubChanged;
    }
}