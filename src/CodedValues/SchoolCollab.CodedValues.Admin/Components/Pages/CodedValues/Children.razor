@page "/coded-values/{ParentId:guid}/children"
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Children of @_parent?.Name</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/coded-values">Categories</a></li>
        <li class="breadcrumb-item active">@_parent?.Name</li>
    </ol>
</nav>

<h2>@_parent?.Code — @_parent?.Name</h2>

<button class="btn btn-primary mb-3"
        @onclick='() => Nav.NavigateTo($"/coded-values/{ParentId}/children/new")'>
    + Add Child Value
</button>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_children is { Length: 0 })
{
    <p>No child values yet.</p>
}
else if (_children is not null)
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Order</th>
                <th>Status</th>
                <th>Attributes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _children)
            {
                <tr class="@(item.IsDisabled ? "table-secondary text-muted" : string.Empty)">
                    <td><code>@item.Code</code></td>
                    <td>@item.Name</td>
                    <td>@item.DisplayOrder</td>
                    <td>
                        @if (item.IsDisabled)
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        @foreach (var attr in item.Attributes)
                        {
                            <span class="badge bg-info text-dark me-1">@attr.Key=@attr.Value</span>
                        }
                    </td>
                    <td>
                        <a href="/coded-values/@item.Id/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                        @if (item.IsDisabled)
                        {
                            <button class="btn btn-sm btn-outline-success ms-1"
                                    @onclick="() => ToggleAsync(item.Id, false)">Enable</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger ms-1"
                                    @onclick="() => ToggleAsync(item.Id, true)">Disable</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@code {
    [Parameter] public Guid ParentId { get; set; }

    private CodedValueDto? _parent;
    private CodedValueDto[]? _children;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _parent = await Api.GetByIdAsync(ParentId);
            _children = await Api.GetChildrenAsync(ParentId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleAsync(Guid id, bool disable)
    {
        try
        {
            if (disable)
            {
                await Api.DisableAsync(id);
            }
            else
            {
                await Api.EnableAsync(id);
            }

            _children = await Api.GetChildrenAsync(ParentId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
