@using Microsoft.Extensions.AI
@using SchoolCollab.AI
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.CodedValues.Admin.Services
@implements IAsyncDisposable

@inject AiChatClient AiChatClient
@inject CodedValuesApiClient Api
@inject ILogger<CodedValuesChat> Logger
@inject NavigationManager Nav

<div class="chat-container">
    <h3 class="chat-heading">✨ AI Assistant</h3>
    <p class="chat-intro">
        Ask me to create or explore coded values. I'll guide you through picking a parent, setting codes &amp; descriptions, and optionally adding attributes.
        Try: "Create a Country coded value with code CNTRY" or "Add countries to CNTRY"
    </p>

    <ErrorBoundary>
        <ChildContent>
            <div class="chat-messages">
                @foreach (var msg in _messages)
                {
                    <div class="chat-message @GetMessageClass(msg.Role)">
                        @if (msg.Role == ChatRole.User)
                        {
                            <strong>You:</strong>
                        }
                        else
                        {
                            <strong>AI:</strong>
                        }
                        <div class="message-text">@msg.Text</div>
                        @if (msg.ToolCalls is { Count: > 0 })
                        {
                            <div class="tool-call-summary">
                                @GetToolCallSummary(msg.ToolCalls)
                            </div>
                        }
                    </div>
                }
                @if (_isStreaming)
                {
                    <div class="chat-message streaming-container">
                        <strong>AI:</strong>
                        @if (!string.IsNullOrEmpty(_streamingText))
                        {
                            <div class="streaming-text">@_streamingText</div>
                        }
                        @if (_activeToolCalls is { Count: > 0 })
                        {
                            <div class="tool-call-summary tool-call-progress">
                                <FluentProgressRing class="progress-ring-small" />
                                <span>Working…</span>
                            </div>
                        }
                        @if (string.IsNullOrEmpty(_streamingText) && (_activeToolCalls is null || _activeToolCalls.Count == 0))
                        {
                            <FluentProgressRing class="progress-ring-small" />
                        }
                    </div>
                }
            </div>

            <ul class="input-area">
                <li>
                    <FluentSelect Items="@_models"
                                 @bind-SelectedOption="@_selectedModel"
                                 OptionText="@(m => $"{m!.Label} (w:{m!.Weight})")"
                                 OptionValue="@(m => m!.Value)"
                                 class="model-label"
                                 aria-label="AI model" />
                </li>
                <li>
                    <div class="input-row">
                        <div class="input-field-wrapper">
                            <FluentTextArea @ref="_inputRef"
                                           @bind-Value="_inputText"
                                           Placeholder="Ask me to create coded values..."
                                           class="full-width"
                                           Rows="2"
                                           aria-label="Chat input"
                                           OnKeyDown="HandleKeyDown" />
                        </div>
                        <FluentButton Appearance="Appearance.Accent"
                                     OnClick="SendAsync"
                                     Disabled="@_isStreaming"
                                     aria-label="Send message">
                            ➤
                        </FluentButton>
                    </div>
                </li>
            </ul>
            <div class="model-info">
                <span class="model-label-text">Model: @_selectedModel?.Value</span>
            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            <FluentMessageBar Intent="MessageIntent.Error">
                Chat error: @ex.Message
            </FluentMessageBar>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private record ToolCallDisplay(string CallId, string FriendlyName, string ArgsSummary, string? ResultSummary = null, bool? Success = null);

    private record ChatMessageItem(ChatRole Role, string Text, List<ToolCallDisplay>? ToolCalls = null);

    private readonly List<ChatMessageItem> _messages = [];
    private string _inputText = string.Empty;
    private bool _isStreaming;
    private string _streamingText = string.Empty;
    private List<ToolCallDisplay>? _activeToolCalls;
    private FluentTextArea? _inputRef;
    private CancellationTokenSource? _sendCts;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private record ModelOption(string Value, string Label, decimal Weight = 0m);

    private static readonly ModelOption[] _fallbackModels =
    [
        new("llama3.1:8b", "Llama 3.1 8B", 1.0m),
        new("llama3.2:3b", "Llama 3.2 3B", 0.4m),
        new("phi3.5:3.8b", "Phi 3.5 3.8B", 0.5m),
        new("mistral:7b", "Mistral 7B", 0.9m),
        new("qwen2.5:7b", "Qwen 2.5 7B", 0.9m),
        new("gemma2:9b", "Gemma 2 9B", 1.2m),
        new("openai/gpt-4o-mini", "GPT-4o Mini", 1.5m),
        new("openai/gpt-4o", "GPT-4o", 2.0m),
        new("anthropic/claude-3.5-haiku", "Claude 3.5 Haiku", 1.5m),
        new("anthropic/claude-sonnet-4", "Claude Sonnet 4", 2.5m),
        new("google/gemini-2.0-flash-001", "Gemini 2.0 Flash", 1.3m),
        new("deepseek/deepseek-chat", "DeepSeek V3", 1.0m)
    ];

    private ModelOption[] _models = [];
    private ModelOption? _selectedModel;
    private string _defaultProvider = "ollama";

    private static string GetMessageClass(ChatRole role) =>
        role == ChatRole.User ? "message-user" : "message-assistant";

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        try
        {
            // Fetch default provider and model list in parallel
            var providerTask = AiChatClient.GetDefaultProviderAsync(_loadCts.Token);
            var parentTask = Api.GetByCodeAsync("AI-MODELS", ct: _loadCts.Token);
            await Task.WhenAll(providerTask, parentTask);

            if (_disposed) return;

            _defaultProvider = await providerTask;
            var parent = await parentTask;
            if (parent is null)
            {
                ApplyFallbackModels();
                return;
            }

            var children = await Api.GetChildrenAsync(parent.Id, _loadCts.Token);
            if (_disposed || children is null || children.Length == 0)
            {
                ApplyFallbackModels();
                return;
            }

            // Determine the model-name attribute key based on the default provider
            var modelNameKey = _defaultProvider.Equals("openrouter", StringComparison.OrdinalIgnoreCase)
                ? "openrouterModelName"
                : "ollamaModelName";

            var models = children
                .Where(c => !c.IsDisabled && !c.IsDeleted)
                .OrderBy(c => c.Attributes.FirstOrDefault(a => a.Key == "weight") is { } wAttr
                    ? decimal.TryParse(wAttr.Value, out var w) ? w : decimal.MaxValue
                    : decimal.MaxValue)
                .ThenBy(c => c.DisplayOrder)
                .Select(c =>
                {
                    var weightAttr = c.Attributes.FirstOrDefault(a => a.Key == "weight");
                    var weight = weightAttr is not null && decimal.TryParse(weightAttr.Value, out var w) ? w : 0m;
                    var modelName = c.Attributes.FirstOrDefault(a => a.Key == modelNameKey)?.Value
                                     ?? c.Name;
                    return new ModelOption(modelName, c.Name, weight);
                })
                .ToArray();

            if (models.Length > 0)
            {
                _models = models;
                _selectedModel = models[0];
                Logger.LogInformation("Loaded {Count} AI models from coded values (provider: {Provider}, attribute: {Attr})",
                    models.Length, _defaultProvider, modelNameKey);
            }
            else
            {
                ApplyFallbackModels();
            }
        }
        catch (OperationCanceledException) { /* user navigated away */ }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to load AI models from API, using fallback list");
            ApplyFallbackModels();
        }
    }

    private void ApplyFallbackModels()
    {
        _models = _fallbackModels;
        _selectedModel = _fallbackModels[0];
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _disposed) return;

        var prompt = _inputText.Trim();
        _inputText = string.Empty;
        StateHasChanged();

        _messages.Add(new(ChatRole.User, prompt));
        _isStreaming = true;
        _streamingText = string.Empty;
        _activeToolCalls = null;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();

        // Build conversation history for multi-turn context
        var history = _messages
            .Select(m => new ChatMessage(m.Role, m.Text))
            .ToList();

        var toolCalls = new List<ToolCallDisplay>();

        try
        {
            await foreach (var update in AiChatClient.ChatAsync(history, _selectedModel?.Value ?? _fallbackModels[0].Value, _sendCts.Token))
            {
                if (_disposed) return;

                switch (update)
                {
                    case ChatUpdate.TextChunk tc:
                        _streamingText += tc.Text;
                        break;

                    case ChatUpdate.ToolCallStart tcs:
                        toolCalls.Add(new(tcs.CallId, tcs.FriendlyName, tcs.ArgsSummary));
                        _activeToolCalls = new List<ToolCallDisplay>(toolCalls);
                        break;

                    case ChatUpdate.ToolCallEnd tce:
                        var idx = toolCalls.FindIndex(tc => tc.CallId == tce.CallId);
                        if (idx >= 0)
                            toolCalls[idx] = toolCalls[idx] with { ResultSummary = tce.ResultSummary, Success = tce.Success };
                        else
                            toolCalls.Add(new(tce.CallId, tce.FriendlyName, "", tce.ResultSummary, tce.Success));
                        _activeToolCalls = new List<ToolCallDisplay>(toolCalls);
                        break;

                    case ChatUpdate.Error err:
                        _streamingText += $"\n⚠️ {err.Message}";
                        break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // user navigated away or cancelled
        }
        catch (IOException) when (_sendCts?.Token.IsCancellationRequested == true)
        {
            // I/O aborted due to cancellation — not an error
        }
        catch (HttpRequestException) when (_sendCts?.Token.IsCancellationRequested == true)
        {
            // HttpClient wraps I/O errors in HttpRequestException during cancellation
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "AI chat error");
            _streamingText = $"Error: {ex.Message}";
        }

        if (!_disposed)
        {
            _messages.Add(new(ChatRole.Assistant, _streamingText, toolCalls.Count > 0 ? toolCalls : null));

            // Navigate to children page after successful bulk creation
            var bulkCall = toolCalls.FirstOrDefault(tc =>
                tc.FriendlyName == "Create Bulk Values" && tc.Success == true);
            if (bulkCall is not null)
            {
                var parentCode = ExtractParentCode(bulkCall.ArgsSummary);
                if (parentCode is not null)
                {
                    Nav.NavigateTo($"/coded-values/{Uri.EscapeDataString(parentCode)}/children");
                }
            }
        }

        _streamingText = string.Empty;
        _activeToolCalls = null;
        _isStreaming = false;
        if (!_disposed) StateHasChanged();
    }

    private async Task HandleKeyDown(FluentKeyCodeEventArgs e)
    {
        if (e.Key == KeyCode.Enter && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = null;
    }

    /// <summary>
    /// Extracts the parent code from a bulk-create args summary like "parent: CNTRY".
    /// </summary>
    private static string? ExtractParentCode(string? argsSummary)
    {
        if (string.IsNullOrWhiteSpace(argsSummary)) return null;
        var prefix = "parent: ";
        var idx = argsSummary.IndexOf(prefix, StringComparison.Ordinal);
        if (idx < 0) return null;
        var code = argsSummary[(idx + prefix.Length)..].Trim();
        return string.IsNullOrEmpty(code) ? null : code;
    }

    /// <summary>
    /// Produces a compact one-line summary of tool calls for a completed message.
    /// </summary>
    private static string GetToolCallSummary(List<ToolCallDisplay> toolCalls)
    {
        if (toolCalls.Count == 0) return string.Empty;
        var succeeded = toolCalls.Count(tc => tc.Success is true);
        var failed = toolCalls.Count(tc => tc.Success is false);
        var parts = new List<string>();
        if (succeeded > 0) parts.Add($"✅ {succeeded} succeeded");
        if (failed > 0) parts.Add($"❌ {failed} failed");
        return parts.Count > 0 ? string.Join(" · ", parts) : $"⏳ {toolCalls.Count} tool call{(toolCalls.Count > 1 ? "s" : "")}";
    }
}