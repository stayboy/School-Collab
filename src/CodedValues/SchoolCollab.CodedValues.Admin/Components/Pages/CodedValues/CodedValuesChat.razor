@using Microsoft.Extensions.AI
@using SchoolCollab.CodedValues.AI
@using SchoolCollab.CodedValues.Admin.Services
@implements IAsyncDisposable

@inject AiChatClient AiChatClient
@inject CodedValuesApiClient Api
@inject ILogger<CodedValuesChat> Logger
@inject NavigationManager Nav

<div class="chat-container" style="border-top: 2px solid var(--neutral-stroke-rest, #d1d1d1); margin-top: 2rem; padding-top: 1rem;">
    <h3 style="margin-bottom: 0.5rem;">✨ AI Assistant</h3>
    <p style="color: var(--neutral-foreground-3, #616161); margin-bottom: 1rem; font-size: 0.875rem;">
        Ask me to create or explore coded values. I'll guide you through picking a parent, setting codes &amp; descriptions, and optionally adding attributes.
        Try: "Create a Country coded value with code CNTRY" or "Add countries to CNTRY"
    </p>

    <ErrorBoundary>
        <ChildContent>
            <div class="chat-messages" style="max-height: 400px; overflow-y: auto; margin-bottom: 1rem; padding: 0.5rem;">
                @foreach (var msg in _messages)
                {
                    <div class="chat-message @msg.Role.ToString().ToLowerInvariant()" style="margin-bottom: 0.75rem; @GetMessageStyle(msg.Role)">
                        @if (msg.Role == ChatRole.User)
                        {
                            <strong>You:</strong>
                        }
                        else
                        {
                            <strong>AI:</strong>
                        }
                        <div style="white-space: pre-wrap; margin-top: 0.25rem;">@msg.Text</div>
                        @if (msg.ToolCalls is { Count: > 0 })
                        {
                            <div style="margin-top: 0.35rem; font-size: 0.8rem; color: var(--neutral-foreground-3, #616161);">
                                @GetToolCallSummary(msg.ToolCalls)
                            </div>
                        }
                    </div>
                }
                @if (_isStreaming)
                {
                    <div style="margin-bottom: 0.75rem;">
                        <strong>AI:</strong>
                        @if (!string.IsNullOrEmpty(_streamingText))
                        {
                            <div style="white-space: pre-wrap; margin-top: 0.25rem;">@_streamingText</div>
                        }
                        @if (_activeToolCalls is { Count: > 0 })
                        {
                            <div style="margin-top: 0.25rem; font-size: 0.8rem; color: var(--neutral-foreground-3, #616161); display: flex; align-items: center; gap: 0.35rem;">
                                <FluentProgressRing style="width: 12px; height: 12px; vertical-align: middle;" />
                                <span>Working…</span>
                            </div>
                        }
                        @if (string.IsNullOrEmpty(_streamingText) && (_activeToolCalls is null || _activeToolCalls.Count == 0))
                        {
                            <FluentProgressRing style="width: 16px; height: 16px; vertical-align: middle; margin-left: 4px;" />
                        }
                    </div>
                }
            </div>

            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                <li>
                    <FluentSelect Items="@_models"
                                 @bind-SelectedOption="@_selectedModel"
                                 OptionText="@(m => $"{m!.Label} (w:{m!.Weight}, {(m!.Cloud ? "☁️ cloud" : "🖥️ local")})")"
                                 OptionValue="@(m => m!.Value)"
                                 Style="width: 100%; max-width: 520px;"
                                 aria-label="AI model" />
                </li>
                <li>
                    <div style="display: flex; gap: 0.5rem; align-items: flex-start;">
                        <div style="flex: 1;">
                            <FluentTextArea @ref="_inputRef"
                                           @bind-Value="_inputText"
                                           Placeholder="Ask me to create coded values..."
                                           Style="width: 100%;"
                                           Rows="2"
                                           aria-label="Chat input"
                                           OnKeyDown="HandleKeyDown" />
                        </div>
                        <FluentButton Appearance="Appearance.Accent"
                                     OnClick="SendAsync"
                                     Disabled="@_isStreaming"
                                     aria-label="Send message">
                            ➤
                        </FluentButton>
                    </div>
                </li>
            </ul>
            <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 0.25rem;">
                <span style="color: var(--neutral-foreground-3, #616161); font-size: 0.75rem; font-family: monospace;">Model: @_selectedModel.Value</span>
            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            <FluentMessageBar Intent="MessageIntent.Error">
                Chat error: @ex.Message
            </FluentMessageBar>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private record ToolCallDisplay(string CallId, string FriendlyName, string ArgsSummary, string? ResultSummary = null, bool? Success = null);

    private record ChatMessageItem(ChatRole Role, string Text, List<ToolCallDisplay>? ToolCalls = null);

    private readonly List<ChatMessageItem> _messages = [];
    private string _inputText = string.Empty;
    private bool _isStreaming;
    private string _streamingText = string.Empty;
    private List<ToolCallDisplay>? _activeToolCalls;
    private FluentTextArea? _inputRef;
    private CancellationTokenSource? _sendCts;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private record ModelOption(string Value, string Label, decimal Weight = 0m, bool Cloud = false);

    private static readonly ModelOption[] _fallbackModels =
    [
        new("llama3.1:8b", "Llama 3.1 8B", 1.0m, false),
        new("llama3.2:3b", "Llama 3.2 3B", 0.4m, false),
        new("phi3.5:3.8b", "Phi 3.5 3.8B", 0.5m, false),
        new("mistral:7b", "Mistral 7B", 0.9m, false),
        new("qwen2.5:7b", "Qwen 2.5 7B", 0.9m, false),
        new("gemma2:9b", "Gemma 2 9B", 1.2m, false),
        new("openai/gpt-4o-mini", "GPT-4o Mini", 1.5m, true),
        new("openai/gpt-4o", "GPT-4o", 2.0m, true),
        new("anthropic/claude-3.5-haiku", "Claude 3.5 Haiku", 1.5m, true),
        new("anthropic/claude-sonnet-4", "Claude Sonnet 4", 2.5m, true),
        new("google/gemini-2.0-flash-001", "Gemini 2.0 Flash", 1.3m, true),
        new("deepseek/deepseek-chat", "DeepSeek V3", 1.0m, true)
    ];

    private ModelOption[] _models = _fallbackModels;
    private ModelOption _selectedModel = _fallbackModels[0];

    private static string GetMessageStyle(ChatRole role) =>
        role == ChatRole.User
            ? "background: var(--neutral-fill-layer-rest, #f5f5f5); padding: 0.5rem 0.75rem; border-radius: 8px;"
            : "padding: 0.5rem 0.75rem;";

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        try
        {
            var parent = await Api.GetByCodeAsync("AI-MODELS", _loadCts.Token);
            if (_disposed || parent is null) return;

            var children = await Api.GetChildrenAsync(parent.Id, _loadCts.Token);
            if (_disposed || children is null || children.Length == 0) return;

            var models = children
                .Where(c => !c.IsDisabled && !c.IsDeleted && c.Description is not null)
                .OrderBy(c => c.Attributes.FirstOrDefault(a => a.Key == "weight") is { } wAttr
                    ? decimal.TryParse(wAttr.Value, out var w) ? w : decimal.MaxValue
                    : decimal.MaxValue)
                .ThenBy(c => c.DisplayOrder)
                .Select(c =>
                {
                    var weightAttr = c.Attributes.FirstOrDefault(a => a.Key == "weight");
                    var weight = weightAttr is not null && decimal.TryParse(weightAttr.Value, out var w) ? w : 0m;
                    var cloudAttr = c.Attributes.FirstOrDefault(a => a.Key == "cloud");
                    var cloud = cloudAttr is not null && bool.TryParse(cloudAttr.Value, out var b) && b;
                    // Prefer modelName attribute (use as-is, includes :cloud suffix if needed)
                    // Fall back to Description + :cloud suffix for cloud models
                    var modelNameAttr = c.Attributes.FirstOrDefault(a => a.Key == "modelName");
                    string ollamaTag;
                    if (modelNameAttr is not null && !string.IsNullOrWhiteSpace(modelNameAttr.Value))
                    {
                        ollamaTag = modelNameAttr.Value;
                    }
                    else
                    {
                        ollamaTag = cloud && !c.Description!.EndsWith(":cloud") ? $"{c.Description}:cloud" : c.Description!;
                    }
                    return new ModelOption(ollamaTag, c.Name, weight, cloud);
                })
                .ToArray();

            if (models.Length > 0)
            {
                _models = models;
                _selectedModel = models[0];
                Logger.LogInformation("Loaded {Count} AI models from coded values", models.Length);
            }
        }
        catch (OperationCanceledException) { /* user navigated away */ }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "Failed to load AI models from API, using fallback list");
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _disposed) return;

        var prompt = _inputText.Trim();
        _inputText = string.Empty;
        StateHasChanged();

        _messages.Add(new(ChatRole.User, prompt));
        _isStreaming = true;
        _streamingText = string.Empty;
        _activeToolCalls = null;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();

        // Build conversation history for multi-turn context
        var history = _messages
            .Select(m => new ChatMessage(m.Role, m.Text))
            .ToList();

        var toolCalls = new List<ToolCallDisplay>();

        try
        {
            await foreach (var update in AiChatClient.ChatAsync(history, _selectedModel.Value, _sendCts.Token))
            {
                if (_disposed) return;

                switch (update)
                {
                    case ChatUpdate.TextChunk tc:
                        _streamingText += tc.Text;
                        break;

                    case ChatUpdate.ToolCallStart tcs:
                        toolCalls.Add(new(tcs.CallId, tcs.FriendlyName, tcs.ArgsSummary));
                        _activeToolCalls = new List<ToolCallDisplay>(toolCalls);
                        break;

                    case ChatUpdate.ToolCallEnd tce:
                        var idx = toolCalls.FindIndex(tc => tc.CallId == tce.CallId);
                        if (idx >= 0)
                            toolCalls[idx] = toolCalls[idx] with { ResultSummary = tce.ResultSummary, Success = tce.Success };
                        else
                            toolCalls.Add(new(tce.CallId, tce.FriendlyName, "", tce.ResultSummary, tce.Success));
                        _activeToolCalls = new List<ToolCallDisplay>(toolCalls);
                        break;

                    case ChatUpdate.Error err:
                        _streamingText += $"\n⚠️ {err.Message}";
                        break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // user navigated away or cancelled
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "AI chat error");
            _streamingText = $"Error: {ex.Message}";
        }

        if (!_disposed)
        {
            _messages.Add(new(ChatRole.Assistant, _streamingText, toolCalls.Count > 0 ? toolCalls : null));

            // Navigate to children page after successful bulk creation
            var bulkCall = toolCalls.FirstOrDefault(tc =>
                tc.FriendlyName == "Create Bulk Values" && tc.Success == true);
            if (bulkCall is not null)
            {
                var parentCode = ExtractParentCode(bulkCall.ArgsSummary);
                if (parentCode is not null)
                {
                    Nav.NavigateTo($"/coded-values/{Uri.EscapeDataString(parentCode)}/children");
                }
            }
        }

        _streamingText = string.Empty;
        _activeToolCalls = null;
        _isStreaming = false;
        if (!_disposed) StateHasChanged();
    }

    private async Task HandleKeyDown(FluentKeyCodeEventArgs e)
    {
        if (e.Key == KeyCode.Enter && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = null;
    }

    /// <summary>
    /// Extracts the parent code from a bulk-create args summary like "parent: CNTRY".
    /// </summary>
    private static string? ExtractParentCode(string? argsSummary)
    {
        if (string.IsNullOrWhiteSpace(argsSummary)) return null;
        var prefix = "parent: ";
        var idx = argsSummary.IndexOf(prefix, StringComparison.Ordinal);
        if (idx < 0) return null;
        var code = argsSummary[(idx + prefix.Length)..].Trim();
        return string.IsNullOrEmpty(code) ? null : code;
    }

    /// <summary>
    /// Produces a compact one-line summary of tool calls for a completed message.
    /// </summary>
    private static string GetToolCallSummary(List<ToolCallDisplay> toolCalls)
    {
        if (toolCalls.Count == 0) return string.Empty;
        var succeeded = toolCalls.Count(tc => tc.Success is true);
        var failed = toolCalls.Count(tc => tc.Success is false);
        var parts = new List<string>();
        if (succeeded > 0) parts.Add($"✅ {succeeded} succeeded");
        if (failed > 0) parts.Add($"❌ {failed} failed");
        return parts.Count > 0 ? string.Join(" · ", parts) : $"⏳ {toolCalls.Count} tool call{(toolCalls.Count > 1 ? "s" : "")}";
    }
}