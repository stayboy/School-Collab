@using Microsoft.Extensions.AI
@using Microsoft.JSInterop
@using SchoolCollab.AI
@using SchoolCollab.CodedValues.Admin.Services
@implements IAsyncDisposable

@inject AiChatClient AiChatClient
@inject ILogger<CodedValuesChat> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS
@* The shared CodedValuesChatHub is the single source of truth for the
   conversation across BOTH chat surfaces (the inline InputOnly chat on the
   page and the Full-mode chat inside the drawer). Each surface mirrors its
   turns into the hub via OnMessageAdded; the AI history is built from the hub
   so a follow-up sent from the drawer still carries the full context of the
   inline chat's earlier turns (and vice-versa). Without this, the drawer
   chat's own _messages started empty, so a "yes" confirmation sent from the
   drawer reached the AI with no prior proposal — "AI has no idea of the
   results." *@
@inject CodedValuesChatHub ChatHub

@*
    Three render modes:
    - Full (default):  Header + scrollable messages + input + action bar + model info.
                       Used inline on the landing page.
    - DisplayOnly:     Header + scrollable messages (no input). Used inside the
                       drawer to show chat responses above the input bar.
    - InputOnly:       Just the input area + model info (no header, no messages).
                       Used inside the drawer, absolutely positioned at the
                       bottom, for follow-up prompts.
*@

<div class="chat-container chat-container-@Mode.ToString().ToLowerInvariant()">
    @if (Mode != CodedValuesChatMode.InputOnly && !HideHeader)
    {
        <h3 class="chat-heading">✨ AI Assistant</h3>
    }

    @* Intro is decoupled from the header block so ShowIntro can surface the
       hint in any non-header context (InputOnly inline bar, or the drawer's
       DisplayOnly chat which supplies its own header via the SideDrawer).
       Full mode shows it by default unless HideHeader is set (HideHeader
       suppresses both the heading and the intro in Full mode). *@
    @if ((Mode == CodedValuesChatMode.Full && !HideHeader) || ShowIntro)
    {
        <p class="chat-intro">
            Ask me to create or explore coded values. I'll guide you through picking a parent, setting codes &amp; descriptions, and optionally adding attributes.
            Try: "Create a Country coded value with code CNTRY" or "Add countries to CNTRY"
        </p>
    }

    <ErrorBoundary>
        <ChildContent>
            @if (Mode != CodedValuesChatMode.InputOnly && !SuppressResponseDisplay)
            {
                <div class="chat-messages">
                    @foreach (var msg in RenderMessages)
                    {
                        <div class="chat-message @GetMessageClass(msg.Role)">
                            @if (msg.Role == ChatRole.User)
                            {
                                <strong>You:</strong>
                            }
                            else
                            {
                                <strong>AI:</strong>
                            }
                            <div class="message-text">@msg.Text</div>
                            @if (msg.ToolCalls is { Count: > 0 })
                            {
                                <div class="tool-call-summary">
                                    @GetToolCallSummary(msg.ToolCalls)
                                </div>
                            }
                        </div>
                    }
                    @if (IsStreaming)
                    {
                        <div class="chat-message streaming-container">
                            <strong>AI:</strong>
                            @if (!string.IsNullOrEmpty(StreamingText))
                            {
                                <div class="streaming-text">@StreamingText</div>
                            }
                            @if (ActiveToolCalls is { Count: > 0 })
                            {
                                <div class="tool-call-summary tool-call-progress">
                                    <FluentProgressRing class="progress-ring-small" />
                                    <span>Working…</span>
                                </div>
                            }
                            @if (string.IsNullOrEmpty(StreamingText) && (ActiveToolCalls is null || ActiveToolCalls.Count == 0))
                            {
                                <FluentProgressRing class="progress-ring-small" />
                            }
                        </div>
                    }
                </div>
            }

            @* The model-info row sits directly above the input area. In
               non-InputOnly modes the Clear control lives here too, on the
               left edge, so it reads as a header for the input area rather
               than a footer below it. The model name stays pinned right.
               FluentAnchor (Hypertext) is used instead of a button so the
               control reads as a lightweight inline link, matching the rest
               of the admin UI's link styling. *@
            <div class="chat-input-block chat-input-block-@Mode.ToString().ToLowerInvariant()">
            <div class="model-info">
                @if (Mode != CodedValuesChatMode.InputOnly)
                {
                    <FluentAnchor Appearance="Appearance.Hypertext"
                                 Href="#"
                                 OnClick="ClearAsync"
                                 Disabled="@_isStreaming"
                                 aria-label="Clear chat">
                        Clear
                    </FluentAnchor>
                }
                <span class="model-label-text">@EffectiveModel (@_provider)</span>
            </div>
            @* The input area is gated out of DisplayOnly mode. DisplayOnly is
               used by the CodedValuesChatPanel drawer to surface the mirrored
               conversation read-only; rendering an input + Send button there
               produced a dead textbox whose SendAsync wrote to the child's
               own (never-rendered) _messages and fired none of the mirror
               callbacks, so typing into the drawer appeared to do nothing.
               Users prompt from the inline InputOnly chat on the page; the
               drawer only displays responses. Full and InputOnly modes keep
               the input. *@
            @if (Mode != CodedValuesChatMode.DisplayOnly)
            {
            <div class="input-area">
                <div class="input-row">
                    <div class="input-field-wrapper">
                        <FluentTextArea @ref="_inputRef"
                                       @bind-Value="_inputText"
                                       @bind-Value:after="OnInputChanged"
                                       Id="@_inputId"
                                       Placeholder="Ask me to create coded values..."
                                       class="full-width"
                                       Rows="2"
                                       Immediate="true"
                                       aria-label="Chat input" />
                        @* Key handling is wired from JS (chatInput.js#attachKeydownHandler)
                           because FluentTextArea has no OnKeyDown EventCallback and wraps
                           the <fluent-text-area> web component — a Blazor @onkeydown
                           handler can't be wired reliably, and conditional preventDefault
                           (only on plain Enter / history-nav arrows) isn't possible with
                           the static @onkeydown:preventDefault directive. The JS listener
                           forwards actions to the DotNetObjectReference below. *@
                    </div>
                    <FluentButton Appearance="Appearance.Accent"
                                 OnClick="SendAsync"
                                 Disabled="@_isStreaming"
                                 aria-label="Send message">
                        Send
                    </FluentButton>
                </div>
            </div>
            }
            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            <FluentMessageBar Intent="MessageIntent.Error">
                Chat error: @ex.Message
            </FluentMessageBar>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    /// <summary>
    /// Controls which parts of the chat UI are rendered. Used to embed the chat
    /// in different layouts (inline on a page, split between display + input
    /// areas inside a drawer, etc.).
    /// </summary>
    public enum CodedValuesChatMode
    {
        /// <summary>Header + messages + input — the full standalone chat.</summary>
        Full,

        /// <summary>Header + messages only — read-only view of the conversation.</summary>
        DisplayOnly,

        /// <summary>Just the input area — no header, no message history.</summary>
        InputOnly,
    }

    [Parameter] public CodedValuesChatMode Mode { get; set; } = CodedValuesChatMode.Full;

    /// <summary>
    /// When true, the inner header (the "✨ AI Assistant" heading and the
    /// intro paragraph) is not rendered. Use this when the chat is hosted
    /// inside a container that already supplies its own title — e.g. a
    /// <c>SideDrawer</c> whose header carries the same text. The
    /// <see cref="CodedValuesChatMode.InputOnly"/> mode already hides the
    /// header; this flag additionally suppresses it in
    /// <see cref="CodedValuesChatMode.Full"/> and
    /// <see cref="CodedValuesChatMode.DisplayOnly"/>.
    /// </summary>
    [Parameter] public bool HideHeader { get; set; }

    /// <summary>
    /// When true (and the header is visible), renders the introductory
    /// paragraph that explains what the AI assistant can do. By default
    /// the intro only appears in <see cref="CodedValuesChatMode.Full"/>;
    /// set this flag to also surface it in <see cref="CodedValuesChatMode.DisplayOnly"/>
    /// — useful for the drawer panel where the header is supplied by the
    /// outer <c>SideDrawer</c> but the chat still benefits from the hint.
    /// </summary>
    [Parameter] public bool ShowIntro { get; set; }

    /// <summary>
    /// When true, the chat does not render messages locally. Useful when this
    /// chat is the "launcher" surface (e.g. inline on a page) and the response
    /// should appear in another surface such as a drawer. The AI request still
    /// fires and <see cref="_messages"/> is still populated (so the AI sees the
    /// full conversation history); only the local render is suppressed.
    /// Pair with <see cref="OnMessageAdded"/> to mirror the conversation into
    /// the drawer.
    /// </summary>
    [Parameter] public bool SuppressResponseDisplay { get; set; }

    /// <summary>
    /// Fires after a new message is added to the conversation. Use this to
    /// mirror the conversation into another <see cref="CodedValuesChat"/>
    /// instance (e.g. the display-only chat inside a drawer) or to open the
    /// drawer on the first prompt. The payload is the freshly-added
    /// <see cref="ChatMessageItem"/> — both user prompts and assistant
    /// responses are emitted, in order.
    /// </summary>
    [Parameter] public EventCallback<ChatMessageItem> OnMessageAdded { get; set; }

    /// <summary>
    /// Fires after the user clears the conversation (via the "Clear" button).
    /// Use this to mirror the clear into another surface — e.g. the drawer
    /// chat — so all visible surfaces reset together. Cleared <see cref="_messages"/>
    /// locally first; the callback fires after the local state is updated.
    /// </summary>
    [Parameter] public EventCallback OnCleared { get; set; }

    /// <summary>
    /// Fires whenever the streaming state changes — once when streaming starts
    /// (IsStreaming=true, empty text), on every chunk / tool-call update while
    /// streaming, and once when streaming ends (IsStreaming=false). Use this to
    /// mirror the live streaming indicator into another surface (e.g. the
    /// drawer chat), so users see the same "AI is typing…" progress as the
    /// inline chat.
    /// </summary>
    [Parameter] public EventCallback<ChatStreamingState> OnStreamingStateChanged { get; set; }

    /// <summary>
    /// Fires at the very start of <see cref="SendAsync"/>, before the prompt
    /// is added and before the AI history is snapshotted from the shared
    /// <see cref="Services.CodedValuesChatHub"/>. Hosts use this to clear the
    /// hub for a fresh conversation (e.g. when a new prompt opens the drawer),
    /// so both the mirrored display and the AI history start clean. Without
    /// this, the hub accumulated every turn forever and the confirmation turn
    /// sent the entire session history to the AI — the cause of the long
    /// delays/timeouts on "yes". Follow-ups sent while the drawer is already
    /// open do not clear the hub, so the current conversation (prompt +
    /// proposal) is preserved for the AI.
    /// </summary>
    [Parameter] public EventCallback OnPromptSending { get; set; }

    /// <summary>
    /// Fires after a prompt is successfully sent (i.e. the chat request was
    /// dispatched to the AI service). The landing page uses this to open the
    /// side drawer so the user can follow the response without losing context.
    /// </summary>
    [Parameter] public EventCallback OnPromptSent { get; set; }

    /// <summary>
    /// Fires with the user's text when this chat is in
    /// <see cref="CodedValuesChatMode.InputOnly"/> mode and the user submits a
    /// prompt. An InputOnly chat never calls the AI itself — it is a pure
    /// launcher. The host is expected to feed this text to a Full-mode chat
    /// (via <see cref="Prompt"/>) that performs the actual ChatAsync call.
    /// This keeps a single AI-calling surface and a single conversation history.
    /// </summary>
    [Parameter] public EventCallback<string> OnPromptSubmitted { get; set; }

    /// <summary>
    /// A prompt forwarded into this chat (e.g. from an InputOnly launcher on
    /// the page). When set to a new non-empty value, the chat runs one AI turn
    /// with that text via <see cref="RunAiTurnAsync"/>. Only Full/Display chats
    /// drive the AI; InputOnly chats ignore this (they only forward text out
    /// via <see cref="OnPromptSubmitted"/>). The last consumed value is tracked
    /// so a re-render with the same <see cref="Prompt"/> does not re-fire.
    /// </summary>
    [Parameter] public string? Prompt { get; set; }

    /// <summary>
    /// Optional external message list. When set, the chat renders from this
    /// list instead of its internal <see cref="_messages"/>. Used by the
    /// drawer to display the conversation mirrored from the inline chat via
    /// <see cref="CodedValuesChatHub"/>.
    ///
    /// When set, the AI-request history and Clear behaviour still operate on
    /// <see cref="_messages"/>; the inline chat uses its own internal state
    /// for AI history while the drawer chat uses this parameter for rendering
    /// only.
    /// </summary>
    [Parameter] public IReadOnlyList<ChatMessageItem>? ExternalMessages { get; set; }

    /// <summary>
    /// Optional external streaming state. When set, the chat renders the
    /// streaming indicator (typing progress, partial text, in-flight tool
    /// calls) from this state instead of its internal fields. Used by the
    /// drawer to display the same live progress the inline chat sees.
    /// </summary>
    [Parameter] public ChatStreamingState? ExternalStreamingState { get; set; }

    /// <summary>
    /// The list the UI iterates over. Falls back to the internal message list
    /// when no external source has been supplied.
    /// </summary>
    private IReadOnlyList<ChatMessageItem> RenderMessages =>
        ExternalMessages ?? _messages;

    /// <summary>Effective streaming flag — external source wins when set.</summary>
    private bool IsStreaming => ExternalStreamingState?.IsStreaming ?? _isStreaming;

    /// <summary>Effective streaming text — external source wins when set.</summary>
    private string StreamingText => ExternalStreamingState?.StreamingText ?? _streamingText;

    /// <summary>Effective active tool calls — external source wins when set.</summary>
    private IReadOnlyList<ToolCallDisplay>? ActiveToolCalls =>
        ExternalStreamingState?.ActiveToolCalls ?? _activeToolCalls;

    /// <summary>
    /// Compact display of a tool call. Public so it can be embedded in the
    /// public <see cref="ChatMessageItem"/> record.
    /// </summary>
    public record ToolCallDisplay(string CallId, string FriendlyName, string ArgsSummary, string? ResultSummary = null, bool? Success = null);

    /// <summary>
    /// One turn in the conversation. Public so it can be the payload of the
    /// public <see cref="OnMessageAdded"/> event callback.
    /// </summary>
    public record ChatMessageItem(ChatRole Role, string Text, List<ToolCallDisplay>? ToolCalls = null);

    /// <summary>
    /// Live snapshot of the AI streaming state. Bundles the is-streaming flag,
    /// the partial text emitted so far, and the in-flight tool calls so they
    /// can travel together through one event/parameter rather than three.
    /// </summary>
    public record ChatStreamingState(
        bool IsStreaming,
        string StreamingText,
        IReadOnlyList<ToolCallDisplay>? ActiveToolCalls);

    private readonly List<ChatMessageItem> _messages = [];
    private string _inputText = string.Empty;
    private bool _isStreaming;
    private string _streamingText = string.Empty;
    private List<ToolCallDisplay>? _activeToolCalls;
    private FluentTextArea? _inputRef;
    private CancellationTokenSource? _sendCts;
    private volatile bool _disposed;

    private string _provider = "ollama";
    private string _effectiveModel = string.Empty;

    // History navigation for ArrowUp / ArrowDown through previously-sent
    // prompts. _historyIndex = -1 means "the user is editing a fresh draft";
    // >= 0 means "showing _promptHistory[index]". While navigating, we stash
    // whatever the user had typed before pressing Up so they can recover it
    // by pressing Down past the newest entry.
    private readonly List<string> _promptHistory = [];
    private int _historyIndex = -1;
    private string _draftBeforeHistory = string.Empty;

    private readonly string _inputId = $"chat-input-{Guid.NewGuid():N}";

    // JS module imported lazily on first render. The module is shipped as a
    // static asset of the CodedValues.Admin RCL and loaded via the standard
    // Blazor "import" pattern — see OnAfterRenderAsync. Cached so subsequent
    // calls don't re-fetch the module on every keystroke.
    private IJSObjectReference? _chatInputModule;

    // Reference to this component instance handed to chatInput.js so the JS
    // keydown listener can call back into .NET (SubmitFromKeyAsync /
    // NavigateHistoryFromKeyAsync). Created on first render and disposed in
    // DisposeAsync to avoid leaking the circuit-pinned reference.
    private DotNetObjectReference<CodedValuesChat>? _dotNetRef;

    /// <summary>
    /// The model that will actually be sent to the AI API, resolved from configuration.
    /// </summary>
    private string EffectiveModel => _effectiveModel;

    private static string GetMessageClass(ChatRole role) =>
        role == ChatRole.User ? "message-user" : "message-assistant";

    protected override async Task OnInitializedAsync()
    {
        // Ask the AI API for its active provider/model rather than re-implementing
        // resolution locally. Keeps the modular boundary intact: the AI service
        // is the single source of truth for its own configuration.
        try
        {
            var config = await AiChatClient.GetConfigurationAsync();
            _provider = config.DefaultProvider;
            _effectiveModel = config.DefaultModel;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read AI configuration; displaying placeholder values.");
        }

        Logger.LogInformation("AI chat configured with provider {Provider} and model {Model}", _provider, _effectiveModel);
    }

    /// <summary>
    /// Lazily imports the chatInput JS module on first render, then attaches a
    /// native keydown listener that forwards Enter / ArrowUp / ArrowDown actions
    /// back to this component via a DotNetObjectReference (see SubmitFromKeyAsync
    /// / NavigateHistoryFromKeyAsync). FluentTextArea has no OnKeyDown parameter
    /// and wraps the <fluent-text-area> web component, so a Blazor @onkeydown handler
    /// can't be wired reliably and conditional preventDefault isn't possible —
    /// hence the JS listener. The module is owned by the CodedValues.Admin RCL
    /// and served as a static asset at
    /// <c>_content/SchoolCollab.CodedValues.Admin/js/chatInput.js</c>. JS interop
    /// calls during the brief window before first render fall through silently
    /// (the user can't type before the textarea exists anyway).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed || _chatInputModule is not null) return;
        try
        {
            _chatInputModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/SchoolCollab.CodedValues.Admin/js/chatInput.js");

            // Wire the keydown listener. The DotNetObjectReference lets the
            // JS handler call back into this component instance. Keep the ref
            // so we can dispose it (and detach the listener) in DisposeAsync.
            _dotNetRef = DotNetObjectReference.Create(this);
            await _chatInputModule.InvokeVoidAsync("attachKeydownHandler", _inputId, _dotNetRef);
        }
        catch (Exception ex)
        {
            // Module load failed — the Enter-to-submit + history-nav shortcuts
            // will be no-ops, but the rest of the chat (the Send button, basic
            // send) keeps working. Log so the regression is visible.
            Logger.LogError(ex, "Failed to load chatInput JS module");
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _disposed) return;

        var prompt = _inputText.Trim();
        _inputText = string.Empty;
        StateHasChanged();

        // Record the prompt in history. Skip duplicates of the most recent
        // entry so the user doesn't have to press Down through repeats.
        if (_promptHistory.Count == 0 || _promptHistory[^1] != prompt)
        {
            _promptHistory.Add(prompt);
        }
        _historyIndex = -1;
        _draftBeforeHistory = string.Empty;

        // InputOnly mode is a pure launcher: it never calls the AI itself.
        // It forwards the user's text to the host via OnPromptSubmitted; the
        // host feeds it to a Full-mode chat (via the Prompt parameter) that
        // performs the actual ChatAsync. This keeps a single AI-calling
        // surface and a single conversation history.
        if (Mode == CodedValuesChatMode.InputOnly)
        {
            if (OnPromptSubmitted.HasDelegate)
            {
                await OnPromptSubmitted.InvokeAsync(prompt);
            }
            return;
        }

        await RunAiTurnAsync(prompt);
    }

    /// <summary>
    /// Tracks the last prompt consumed via the <see cref="Prompt"/> parameter
    /// so a re-render with the same value does not re-fire the AI turn.
    /// </summary>
    private string? _consumedPrompt;

    /// <summary>
    /// When a prompt is supplied via the <see cref="Prompt"/> parameter (e.g.
    /// forwarded from an InputOnly launcher), run one AI turn with it. Only
    /// Full/Display chats drive the AI; InputOnly chats only forward text out.
    /// We track the last consumed value so repeated renders with the same
    /// Prompt don't re-fire, and guard against re-entry while streaming. The
    /// turn is dispatched via <see cref="InvokeAsync"/> because
    /// <see cref="OnParametersSet"/> is synchronous.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Mode != CodedValuesChatMode.InputOnly
            && !string.IsNullOrWhiteSpace(Prompt)
            && Prompt != _consumedPrompt
            && !_disposed)
        {
            // Mark consumed immediately so a re-render during streaming doesn't
            // re-queue / re-fire the same prompt.
            _consumedPrompt = Prompt;

            if (_isStreaming)
            {
                // A follow-up arrived while a turn is still streaming. Don't drop
                // it (the user's "yes" would vanish silently — the most common
                // cause of "history missing / AI ignored my follow-up" with slow
                // models). Queue it and run it when the current turn finishes.
                _queuedPrompt = Prompt;
            }
            else
            {
                _ = InvokeAsync(() => RunAiTurnAsync(Prompt!));
            }
        }
    }

    /// <summary>
    /// A prompt that arrived via <see cref="Prompt"/> while a turn was still
    /// streaming. Drained at the end of <see cref="RunAiTurnAsync"/> so the
    /// follow-up is processed once the current turn (and its history) completes.
    /// </summary>
    private string? _queuedPrompt;

    /// <summary>
    /// Runs one AI turn for the supplied prompt: snapshots the shared
    /// conversation history, mirrors the prompt in, streams the AI response,
    /// and records the assistant reply. Used both by <see cref="SendAsync"/>
    /// (when the user types into this Full-mode chat) and by the
    /// <see cref="Prompt"/> parameter path (when a prompt is forwarded in,
    /// e.g. from the inline InputOnly chat).
    /// </summary>
    private async Task RunAiTurnAsync(string prompt)
    {
        // Let mirror surfaces reset BEFORE we snapshot the AI history. The
        // host page clears the shared hub when a new prompt opens the drawer
        // (a fresh conversation), so the AI history must be snapshotted AFTER
        // that reset — otherwise stale, accumulated history would be sent
        // (the cause of long delays/timeouts on the confirmation turn).
        // Follow-ups sent while the drawer is already open do not clear the
        // hub, so the current conversation (prompt + proposal) is preserved.
        if (OnPromptSending.HasDelegate)
        {
            await OnPromptSending.InvokeAsync();
        }

        // Snapshot the SHARED conversation (CodedValuesChatHub) AFTER any
        // reset, so a fresh start yields an empty history and a follow-up
        // retains the current conversation. We snapshot before mirroring the
        // current prompt in so it is never double-counted; the current prompt
        // is appended below. This is what lets a follow-up sent from the
        // drawer carry the inline chat's earlier proposal.
        var history = ChatHub.Messages
            .Select(m => new ChatMessage(m.Role, m.Text))
            .ToList();

        _messages.Add(new(ChatRole.User, prompt));
        await NotifyMessageAddedAsync(_messages[^1]);
        _isStreaming = true;
        _streamingText = string.Empty;
        _activeToolCalls = null;
        await NotifyStreamingStateChangedAsync();
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();

        // Append the current prompt to the shared-conversation history
        // (snapshotted above, before it was mirrored into the hub).
        history.Add(new ChatMessage(ChatRole.User, prompt));

        // Notify the host page (e.g. landing page) that a prompt was sent so it
        // can surface the drawer. The drawer hosts its own chat instance for
        // follow-up prompts, so this event is purely about UX feedback.
        if (OnPromptSent.HasDelegate)
        {
            await OnPromptSent.InvokeAsync();
        }

        var toolCalls = new List<ToolCallDisplay>();

        try
        {
            Logger.LogInformation("Sending AI prompt with provider {Provider} and model {Model}", _provider, EffectiveModel);

            await foreach (var update in AiChatClient.ChatAsync(history, model: null, _sendCts.Token))
            {
                if (_disposed) return;

                switch (update)
                {
                    case ChatUpdate.TextChunk tc:
                        _streamingText += tc.Text;
                        break;

                    case ChatUpdate.ToolCallStart tcs:
                        toolCalls.Add(new(tcs.CallId, tcs.FriendlyName, tcs.ArgsSummary));
                        _activeToolCalls = new List<ToolCallDisplay>(toolCalls);
                        break;

                    case ChatUpdate.ToolCallEnd tce:
                        var idx = toolCalls.FindIndex(tc => tc.CallId == tce.CallId);
                        if (idx >= 0)
                            toolCalls[idx] = toolCalls[idx] with { ResultSummary = tce.ResultSummary, Success = tce.Success };
                        else
                            toolCalls.Add(new(tce.CallId, tce.FriendlyName, "", tce.ResultSummary, tce.Success));
                        _activeToolCalls = new List<ToolCallDisplay>(toolCalls);
                        break;

                    case ChatUpdate.Error err:
                        _streamingText += $"\n⚠️ {err.Message}";
                        break;
                }

                await InvokeAsync(StateHasChanged);
                // Mirror the live streaming state to the drawer (and any other
                // mirror surface) so the user sees the same progress indicator.
                await NotifyStreamingStateChangedAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // user navigated away or cancelled
        }
        catch (IOException) when (_sendCts?.Token.IsCancellationRequested == true)
        {
            // I/O aborted due to cancellation — not an error
        }
        catch (HttpRequestException) when (_sendCts?.Token.IsCancellationRequested == true)
        {
            // HttpClient wraps I/O errors in HttpRequestException during cancellation
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "AI chat error");
            _streamingText = $"Error: {ex.Message}";
        }

        if (!_disposed)
        {
            _messages.Add(new(ChatRole.Assistant, _streamingText, toolCalls.Count > 0 ? toolCalls : null));
            await NotifyMessageAddedAsync(_messages[^1]);

            // Navigate to children page after successful bulk creation
            var bulkCall = toolCalls.FirstOrDefault(tc =>
                tc.FriendlyName == "Create Bulk Values" && tc.Success == true);
            if (bulkCall is not null)
            {
                var parentCode = ExtractParentCode(bulkCall.ArgsSummary);
                if (parentCode is not null)
                {
                    Nav.NavigateTo($"/coded-values/{Uri.EscapeDataString(parentCode)}/children");
                }
            }
        }

        _streamingText = string.Empty;
        _activeToolCalls = null;
        _isStreaming = false;
        await NotifyStreamingStateChangedAsync();
        if (!_disposed) StateHasChanged();

        // Drain a follow-up that was queued while this turn was streaming.
        // The hub now contains this turn's prompt + assistant response, so the
        // queued follow-up will carry the full conversation history.
        var queued = _queuedPrompt;
        _queuedPrompt = null;
        if (!_disposed && !string.IsNullOrWhiteSpace(queued))
        {
            await RunAiTurnAsync(queued!);
        }
    }

    /// <summary>
    /// JS-invokable entry point called by chatInput.js when the user presses
    /// plain Enter (no Shift/Ctrl/Alt/Meta). Forwards to <see cref="SendAsync"/>,
    /// which dispatches the prompt to the AI. The JS listener already called
    /// preventDefault so no newline is inserted.
    /// </summary>
    [JSInvokable]
    public Task SubmitFromKeyAsync() => SendAsync();

    /// <summary>
    /// JS-invokable entry point called by chatInput.js when the user presses
    /// ArrowUp (-1) or ArrowDown (+1) from the top/bottom edge (or an empty
    /// input). The caret-edge condition is checked in JS so preventDefault is
    /// applied synchronously; here we just apply the history navigation.
    /// </summary>
    [JSInvokable]
    public Task NavigateHistoryFromKeyAsync(int delta) => ApplyHistoryNavigationAsync(delta);

    /// <summary>
    /// Fires after Blazor updates <see cref="_inputText"/> from the textarea's
    /// value. Tracks the in-progress draft so a Down press past the newest
    /// history entry can restore it.
    /// </summary>
    private void OnInputChanged()
    {
        if (_historyIndex == -1)
        {
            _draftBeforeHistory = _inputText;
        }
    }

    /// <summary>
    /// Walks the prompt history by <paramref name="delta"/> positions and updates
    /// <see cref="_inputText"/> to the selected entry (or restores the saved
    /// draft when navigating past the newest entry). The caret-edge guard is
    /// performed in JS (see attachKeydownHandler) before this is called, so the
    /// in-draft editing case never reaches here.
    /// </summary>
    private Task ApplyHistoryNavigationAsync(int delta)
    {
        if (_promptHistory.Count == 0 || _disposed) return Task.CompletedTask;

        var next = _historyIndex + delta;
        if (next < -1 || next >= _promptHistory.Count) return Task.CompletedTask;

        _historyIndex = next;

        if (_historyIndex == -1)
        {
            // Past the newest entry — restore whatever the user had typed
            // before they started scrolling through history.
            _inputText = _draftBeforeHistory;
        }
        else
        {
            _inputText = _promptHistory[_historyIndex];
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Raises <see cref="OnMessageAdded"/> for the just-added message so the
    /// host page can mirror the conversation into another surface (e.g. a
    /// drawer). Silently no-ops when no delegate is bound.
    /// </summary>
    private async Task NotifyMessageAddedAsync(ChatMessageItem msg)
    {
        if (_disposed) return;
        if (OnMessageAdded.HasDelegate)
        {
            await OnMessageAdded.InvokeAsync(msg);
        }
    }

    /// <summary>
    /// Raises <see cref="OnStreamingStateChanged"/> with a fresh snapshot of
    /// <see cref="_isStreaming"/>, <see cref="_streamingText"/>, and
    /// <see cref="_activeToolCalls"/>. Called at streaming start, after every
    /// streamed chunk / tool-call event, and at streaming end. Mirrored surfaces
    /// (drawer) use this to render the live "AI is typing…" progress.
    /// </summary>
    private async Task NotifyStreamingStateChangedAsync()
    {
        if (_disposed) return;
        if (OnStreamingStateChanged.HasDelegate)
        {
            await OnStreamingStateChanged.InvokeAsync(
                new ChatStreamingState(_isStreaming, _streamingText, _activeToolCalls));
        }
    }

    private async Task ClearAsync()
    {
        if (_isStreaming || _disposed) return;

        _messages.Clear();
        _streamingText = string.Empty;
        _activeToolCalls = null;
        await InvokeAsync(StateHasChanged);
        Logger.LogInformation("Coded-values AI chat cleared");

        // Notify mirror surfaces (drawer) so they reset in lockstep.
        if (OnCleared.HasDelegate)
        {
            await OnCleared.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = null;

        if (_chatInputModule is not null)
        {
            try
            {
                // Detach the JS keydown listener before releasing the module
                // and the .NET reference so a stale listener can't call back
                // into a disposed component.
                await _chatInputModule.InvokeVoidAsync("detachKeydownHandler", _inputId);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }

            try
            {
                await _chatInputModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Server-side Blazor: circuit can be lost between the dispose
                // call and the awaited disposal — safe to swallow.
            }
            catch (TaskCanceledException)
            {
                // Disposal in flight when the circuit closed — same deal.
            }
            _chatInputModule = null;
        }

        // Release the .NET reference handed to chatInput.js so the circuit
        // can be collected and the JS listener (already detached above)
        // can't call back into this component.
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    /// <summary>
    /// Extracts the parent code from a bulk-create args summary like "parent: CNTRY".
    /// </summary>
    private static string? ExtractParentCode(string? argsSummary)
    {
        if (string.IsNullOrWhiteSpace(argsSummary)) return null;
        var prefix = "parent: ";
        var idx = argsSummary.IndexOf(prefix, StringComparison.Ordinal);
        if (idx < 0) return null;
        var code = argsSummary[(idx + prefix.Length)..].Trim();
        return string.IsNullOrEmpty(code) ? null : code;
    }

    /// <summary>
    /// Produces a compact one-line summary of tool calls for a completed message.
    /// </summary>
    private static string GetToolCallSummary(List<ToolCallDisplay> toolCalls)
    {
        if (toolCalls.Count == 0) return string.Empty;
        var succeeded = toolCalls.Count(tc => tc.Success is true);
        var failed = toolCalls.Count(tc => tc.Success is false);
        var parts = new List<string>();
        if (succeeded > 0) parts.Add($"✅ {succeeded} succeeded");
        if (failed > 0) parts.Add($"❌ {failed} failed");
        return parts.Count > 0 ? string.Join(" · ", parts) : $"⏳ {toolCalls.Count} tool call{(toolCalls.Count > 1 ? "s" : "")}";
    }
}