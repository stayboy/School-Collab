@page "/coded-values/{Id:guid}/edit"
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@inject ILogger<Edit> Logger

<PageTitle>Edit @_item?.Name</PageTitle>
<h2>Edit: @_item?.Code</h2>

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (_item is not null)
        {
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" style="max-width:600px">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <FluentTextField Value="@_item.Code" Disabled="true" Label="Code" style="width:100%" class="mb-3" />
                <FluentTextField @bind-Value="_model.Name" Label="Name *" style="width:100%" class="mb-3" />
                <FluentTextArea @bind-Value="_model.Description" Label="Description" Rows="2" style="width:100%" class="mb-3" />
                <FluentNumberField @bind-Value="_model.DisplayOrder" Label="Display Order" style="width:200px" class="mb-3" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_error</FluentMessageBar>
                }

                <div>
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="ms-2">Cancel</FluentButton>
                </div>
            </EditForm>

            <hr class="my-4" />
            <h5>Attributes</h5>
            @if (_item.Attributes.Count > 0)
            {
                <FluentDataGrid Items="@_item.Attributes.AsQueryable()" GridTemplateColumns="1fr 1fr auto" TGridItem="CodedValueAttributeDto" style="max-width:520px">
                    <PropertyColumn Property="@(a => a.Key)" />
                    <PropertyColumn Property="@(a => a.Value)" />
                    <TemplateColumn Title="">
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@(() => RemoveAttributeAsync(context.Key))">Remove</FluentButton>
                    </TemplateColumn>
                </FluentDataGrid>
            }

            <div class="row g-2 mt-2" style="max-width:520px">
                <div class="col-5"><FluentTextField @bind-Value="_attrKey" Placeholder="key" style="width:100%" /></div>
                <div class="col-5"><FluentTextField @bind-Value="_attrValue" Placeholder="value" style="width:100%" /></div>
                <div class="col-2">
                    <FluentButton Appearance="Appearance.Outline" OnClick="AddAttributeAsync" style="width:100%">Add</FluentButton>
                </div>
            </div>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public Guid Id { get; set; }

    private CodedValueDto? _item;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _attrKey;
    private string? _attrValue;
    private readonly EditModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Loading coded value {Id} for edit", Id);
        try
        {
            _item = await Api.GetByIdAsync(Id);
            if (_item is not null)
            {
                _model.Name = _item.Name;
                _model.Description = _item.Description;
                _model.DisplayOrder = _item.DisplayOrder;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load coded value {Id}", Id);
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            Logger.LogInformation("User initiated update for coded value {Id}", Id);
            await Api.UpdateAsync(Id, new UpdateCodedValueRequest(_model.Name!, _model.Description, _model.DisplayOrder));
            Nav.NavigateTo(_item?.ParentId.HasValue == true
                ? $"/coded-values/{_item.ParentId}/children"
                : "/coded-values");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save coded value {Id}", Id);
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddAttributeAsync()
    {
        if (string.IsNullOrWhiteSpace(_attrKey) || string.IsNullOrWhiteSpace(_attrValue))
        {
            return;
        }

        try
        {
            await Api.SetAttributeAsync(Id, _attrKey.Trim(), _attrValue.Trim());
            _item = await Api.GetByIdAsync(Id);
            _attrKey = _attrValue = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add attribute {Key} to coded value {Id}", _attrKey, Id);
            _error = ex.Message;
        }
    }

    private async Task RemoveAttributeAsync(string key)
    {
        try
        {
            await Api.RemoveAttributeAsync(Id, key);
            _item = await Api.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove attribute {Key} from coded value {Id}", key, Id);
            _error = ex.Message;
        }
    }

    private void Cancel() =>
        Nav.NavigateTo(_item?.ParentId.HasValue == true
            ? $"/coded-values/{_item.ParentId}/children"
            : "/coded-values");

    private sealed class EditModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Name { get; set; }

        public string? Description { get; set; }

        public int DisplayOrder { get; set; }
    }
}
