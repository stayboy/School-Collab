@page "/coded-values/new"
@page "/coded-values/{ParentCode}/children/new"
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@inject ILogger<Create> Logger
@implements IDisposable

<PageTitle>@(_parentCode != null ? "Add Child Value" : "New Category")</PageTitle>
<h2>@(_parentCode != null ? "Add Child Value" : "New Coded Value Category")</h2>

<ErrorBoundary>
    <ChildContent>
        <EditForm Model="_model" OnValidSubmit="SubmitAsync" style="max-width:600px">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <FluentTextField @bind-Value="_model.Code" Label="Code *" Placeholder="e.g. GENDER" style="width:100%" class="mb-3" />
            <FluentTextField @bind-Value="_model.Name" Label="Name *" style="width:100%" class="mb-3" />
            <FluentTextArea @bind-Value="_model.Description" Label="Description" Rows="2" style="width:100%" class="mb-3" />
            <FluentNumberField @bind-Value="_model.DisplayOrder" Label="Display Order" style="width:200px" class="mb-3" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_error</FluentMessageBar>
            }

            <div>
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="ms-2">Cancel</FluentButton>
            </div>
        </EditForm>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public string? ParentCode { get; set; }

    private Guid? _parentId;
    private string? _parentCode;
    private readonly FormModel _model = new();
    private bool _saving;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (ParentCode != _parentCode)
        {
            _parentCode = ParentCode;
            _parentId = null;
            if (!string.IsNullOrEmpty(ParentCode))
            {
                _loadCts?.Cancel();
                _loadCts?.Dispose();
                _loadCts = new CancellationTokenSource();
                var ct = _loadCts.Token;
                try
                {
                    var parent = await Api.GetByCodeAsync(ParentCode, ct);
                    if (_disposed) return;
                    _parentId = parent?.Id;
                }
                catch (OperationCanceledException) { }
                catch (Exception ex)
                {
                    if (_disposed) return;
                    Logger.LogError(ex, "Failed to resolve parent for code {ParentCode}", ParentCode);
                }
            }
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        var ct = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            Logger.LogInformation("User initiated create for code {Code}", _model.Code);
            await Api.CreateAsync(new CreateCodedValueRequest(
                _model.Code!,
                _model.Name!,
                _model.Description,
                _parentId,
                _model.DisplayOrder), ct);

            Nav.NavigateTo(_parentCode != null
                ? $"/coded-values/{Uri.EscapeDataString(_parentCode)}/children"
                : "/coded-values");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to save coded value {Code}", _model.Code);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    private void Cancel() =>
        Nav.NavigateTo(_parentCode != null
            ? $"/coded-values/{Uri.EscapeDataString(_parentCode)}/children"
            : "/coded-values");

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Code { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? Name { get; set; }

        public string? Description { get; set; }

        public int DisplayOrder { get; set; }
    }
}
