@page "/"
@page "/coded-values"
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@inject ILogger<Index> Logger
@implements IDisposable
@attribute [StreamRendering(true)]

<PageTitle>Coded Values</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <h1 class="mb-4">Coded Values</h1>

        <FluentButton Appearance="Appearance.Accent" OnClick='() => Nav.NavigateTo("/coded-values/new")' class="mb-3">
            + New Category
        </FluentButton>

        @if (_items is null)
        {
            <FluentProgressRing />
        }
        else if (_items.Length == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">No coded value categories yet.</FluentMessageBar>
        }
        else
        {
            <FluentDataGrid Items="@_items.AsQueryable()" GridTemplateColumns="1fr 2fr 1fr 1fr 2fr" TGridItem="CodedValueDto">
                <TemplateColumn Title="Code" SortBy="@_sortByCode" Sortable="true">
                    <code>@context.Code</code>
                </TemplateColumn>
                <PropertyColumn Property="@(x => x.Name)" Sortable="true" />
                <TemplateColumn Title="Status">
                    @if (context.IsDisabled)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">Disabled</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Children">
                    <FluentAnchor Href="@($"/coded-values/{context.Id}/children")">View children</FluentAnchor>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => Nav.NavigateTo($"/coded-values/{context.Id}/edit"))">Edit</FluentButton>
                    @if (context.IsDisabled)
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => OnToggleAsync(context.Id, disable: false))" class="ms-1">Enable</FluentButton>
                    }
                    else
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => OnToggleAsync(context.Id, disable: true))" class="ms-1">Disable</FluentButton>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private CodedValueDto[]? _items;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private readonly GridSort<CodedValueDto> _sortByCode =
        GridSort<CodedValueDto>.ByAscending(x => x.Code);

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        Logger.LogInformation("Loading coded values list");
        try
        {
            _items = await Api.GetRootValuesAsync(token);

            // Guard: the streaming renderer may have been torn down while we
            // were awaiting (page navigated away, response cancelled, etc.).
            // Mutating state on a detached component throws
            // "The renderer does not have a component with ID {N}."
            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} coded values", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away — leave _items null, no UI update
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load coded values");
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Optimistic toggle: flip the in-memory DTO, render immediately, dispatch the
    /// API call in the background, and roll back on failure. Avoids a full re-fetch
    /// of the root list for a one-bit change.
    /// </summary>
    private async Task OnToggleAsync(Guid id, bool disable)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { IsDisabled = disable };
        StateHasChanged();

        try
        {
            if (disable) await Api.DisableAsync(id);
            else         await Api.EnableAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to toggle coded value {Id}", id);
            // rollback
            if (_items is not null)
            {
                var i = Array.FindIndex(_items, x => x.Id == id);
                if (i >= 0) _items[i] = previous;
            }
            _error = ex.Message;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
