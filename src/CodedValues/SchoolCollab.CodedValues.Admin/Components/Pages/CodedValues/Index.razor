@page "/coded-values"
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Coded Values</PageTitle>

<h1 class="mb-4">Coded Values</h1>

<button class="btn btn-primary mb-3" @onclick='() => Nav.NavigateTo("/coded-values/new")'>
    + New Category
</button>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_items is { Length: 0 })
{
    <p>No coded value categories yet.</p>
}
else if (_items is not null)
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Status</th>
                <th>Children</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr class="@(item.IsDisabled ? "table-secondary text-muted" : string.Empty)">
                    <td><code>@item.Code</code></td>
                    <td>@item.Name</td>
                    <td>
                        @if (item.IsDisabled)
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <a href="/coded-values/@item.Id/children">View children</a>
                    </td>
                    <td>
                        <a href="/coded-values/@item.Id/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                        @if (item.IsDisabled)
                        {
                            <button class="btn btn-sm btn-outline-success ms-1"
                                    @onclick="() => ToggleAsync(item.Id, false)">Enable</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger ms-1"
                                    @onclick="() => ToggleAsync(item.Id, true)">Disable</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@code {
    private CodedValueDto[]? _items;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = await Api.GetRootValuesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleAsync(Guid id, bool disable)
    {
        try
        {
            if (disable)
            {
                await Api.DisableAsync(id);
            }
            else
            {
                await Api.EnableAsync(id);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
