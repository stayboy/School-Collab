@page "/coded-values"
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.CodedValues.Admin.Components.Pages.CodedValues
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@inject CodedValuesChatHub ChatHub
@implements IDisposable

<PageTitle>Coded Values</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" class="page-container">
            <div class="title-row">
                <h1 class="page-title">Coded Values</h1>
            </div>
            <div class="action-bar">
                <FluentButton Appearance="Appearance.Accent" OnClick='() => Nav.NavigateTo("/coded-values/new")'>
                    + New Category
                </FluentButton>
                <FluentCheckbox @bind-Checked="@_showDeleted" Label="Show deleted" OnCheckedChanged="@((bool v) => OnShowDeletedChanged(v))" />
                <div class="spacer"></div>
                <div class="action-bar-right">
                    <FluentTextField Id="search-root"
                                    Placeholder="Search categories…"
                                    class="search-box"
                                    Immediate="true"
                                    ImmediateDelay="300"
                                    ValueChanged="@OnSearchValueChanged"
                                    OnClear="@(() => OnSearchClear())" />
                    @* Opens the AI assistant side drawer without sending a prompt,
                       so users can re-read prior responses or follow an ongoing
                       stream. Mirrors the drawer-open path used by OnPromptSent. *@
                    <FluentButton Appearance="Appearance.Neutral"
                                  Title="Open AI assistant"
                                  OnClick="OpenChatDrawerAsync">
                        ✨ Chat
                    </FluentButton>
                </div>
            </div>
            @if (_showDeleted && _deletedItems is not null)
            {
                @if (_deletedItems.Length == 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Info" class="mb-3">No deleted coded values.</FluentMessageBar>
                }
                else
                {
                    <h3>Deleted Values</h3>
                    <FluentDataGrid Items="@_deletedItems.AsQueryable()" GridTemplateColumns="1fr 2fr 1fr 2fr" TGridItem="CodedValueDto" MultiLine="true" class="mb-4">
                        <TemplateColumn Title="Code" SortBy="@_sortByCode" Sortable="true">
                            <code>@context.Code</code>
                        </TemplateColumn>
                        <PropertyColumn Property="@(x => x.Name)" Sortable="true" />
                        <TemplateColumn Title="Deleted At">
                            @(context.DeletedAt?.ToLocalTime().ToString("g") ?? "—")
                        </TemplateColumn>
                        <TemplateColumn Title="Actions">
                            <FluentAnchor Href="#" OnClick="@(() => OnRecoverAsync(context.Id, context.Code))">Recover</FluentAnchor>
                                <FluentAnchor Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/children")" class="ms-2">View</FluentAnchor>
                        </TemplateColumn>
                    </FluentDataGrid>
                }
            }

            @* -- Grid fills remaining vertical space -- *@
            @if (_isSearching && _searchResults is null)
            {
                <div class="spinner-container">
                    <FluentProgressRing />
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_searchText) && _searchResults is not null)
            {
                @* Search results view *@
                if (_searchResults.Length == 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Info">No categories match '@_searchText'.</FluentMessageBar>
                }
                else
                {
                    <div class="grid-container">
                        <FluentDataGrid Items="@_searchResults.AsQueryable()"
                                        GridTemplateColumns="150px minmax(200px,2fr) minmax(180px,2fr) minmax(80px,1fr) minmax(180px,2fr) auto"
                                        MultiLine="true"
                                        TGridItem="CodedValueDto">
                            <TemplateColumn Title="Code" SortBy="@_sortByCode" Sortable="true" TooltipText="@(x => x.Code)">
                                <code>@context.Code</code>
                            </TemplateColumn>
                            <TemplateColumn Title="Name" SortBy="@_sortByName" Sortable="true" TooltipText="@(x => x.Name)">
                                <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/children")">
                                    @context.Name (@context.ChildrenCount)
                                </FluentAnchor>
                            </TemplateColumn>
                            <PropertyColumn Property="@(x => x.Description)" Title="Description" />
                            <TemplateColumn Title="Status">
                                @if (context.IsDisabled)
                                {
                                    <FluentBadge Appearance="Appearance.Neutral">Disabled</FluentBadge>
                                }
                                else
                                {
                                    <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Definitions" TooltipText="@(x => x.AttributeDefinitions.Count > 0 ? string.Join(", ", x.AttributeDefinitions.Select(d => d.Key)) : null)">
                                @if (context.AttributeDefinitions.Count > 0)
                                {
                                    @string.Join(", ", context.AttributeDefinitions.Select(d => d.Key))
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Actions">
                                @if (context.IsDisabled)
                                {
                                    <FluentAnchor Href="#" OnClick="@(() => OnToggleAsync(context.Id, disable: false))">Enable</FluentAnchor>
                                }
                                else
                                {
                                    <FluentAnchor Href="#" OnClick="@(() => OnToggleAsync(context.Id, disable: true))">Disable</FluentAnchor>
                                }
                                <FluentAnchor Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/edit")" class="ms-2">Edit</FluentAnchor>
                                <FluentAnchor Href="#" OnClick="@(() => OnDeleteAsync(context.Id, context.Code))" class="ms-2">Delete</FluentAnchor>
                            </TemplateColumn>
                        </FluentDataGrid>
                    </div>
                }
            }
            else if (_items is null)
            {
                <div class="spinner-container">
                    <FluentProgressRing />
                </div>
            }
            else if (_items.Length == 0)
            {
                <FluentMessageBar Intent="MessageIntent.Info">No coded value categories yet.</FluentMessageBar>
            }
            else
            {
                <div class="grid-container">
                    <FluentDataGrid Items="@_items.AsQueryable()"
                                   GridTemplateColumns="150px minmax(200px,2fr) minmax(180px,2fr) minmax(80px,1fr) minmax(180px,2fr) auto"
                                    MultiLine="true"
                                    TGridItem="CodedValueDto">
                        <TemplateColumn Title="Code" SortBy="@_sortByCode" Sortable="true" TooltipText="@(x => x.Code)">
                            <code>@context.Code</code>
                        </TemplateColumn>
                        <TemplateColumn Title="Name" SortBy="@_sortByName" Sortable="true" TooltipText="@(x => x.Name)">
                            <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/children")">
                                @context.Name (@context.ChildrenCount)
                            </FluentAnchor>
                        </TemplateColumn>
                        <PropertyColumn Property="@(x => x.Description)" Title="Description" />
                        <TemplateColumn Title="Status">
                            @if (context.IsDisabled)
                            {
                                <FluentBadge Appearance="Appearance.Neutral">Disabled</FluentBadge>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Definitions" TooltipText="@(x => x.AttributeDefinitions.Count > 0 ? string.Join(", ", x.AttributeDefinitions.Select(d => d.Key)) : null)">
                            @if (context.AttributeDefinitions.Count > 0)
                            {
                                @string.Join(", ", context.AttributeDefinitions.Select(d => d.Key))
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Actions">
                            @if (context.IsDisabled)
                            {
                                <FluentAnchor Href="#" OnClick="@(() => OnToggleAsync(context.Id, disable: false))">Enable</FluentAnchor>
                            }
                            else
                            {
                                <FluentAnchor Href="#" OnClick="@(() => OnToggleAsync(context.Id, disable: true))">Disable</FluentAnchor>
                            }
                            <FluentAnchor Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/edit")" class="ms-2">Edit</FluentAnchor>
                            <FluentAnchor Href="#" OnClick="@(() => OnDeleteAsync(context.Id, context.Code))" class="ms-2">Delete</FluentAnchor>
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
            }

            @* -- Chat pinned to bottom. InputOnly keeps just the input bar on the
               page; the conversation and streaming responses are mirrored into the
               shared CodedValuesChatHub and read by the drawer's display-only chat,
               so the page stays compact while the drawer is the place to read
               responses.
               OnMessageAdded mirrors every prompt and response into the shared
               CodedValuesChatHub so the drawer chat stays in sync.
               OnStreamingStateChanged mirrors the live typing progress.
               OnPromptSent opens the drawer on the first send.
               (OnCleared is not wired here: InputOnly hides the inline Clear
               button, so clearing is handled inside the drawer panel via the
               hub.) -- *@
            <CodedValuesChat Mode="CodedValuesChat.CodedValuesChatMode.InputOnly"
                             ShowIntro="true"
                             OnPromptSent="@OpenChatDrawerAsync"
                             OnMessageAdded="@OnMessageAddedAsync"
                             OnStreamingStateChanged="@OnStreamingStateChangedAsync" />

            <CodedValuesChatPanel @bind-Open="_chatDrawerOpen" />
        </FluentStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private CodedValueDto[]? _items;
    private CodedValueDto[]? _deletedItems;
    private bool _showDeleted;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _chatDrawerOpen;

    // Search state
    private string _searchText = string.Empty;
    private CodedValueDto[]? _searchResults;
    private bool _isSearching;
    private CancellationTokenSource? _searchCts;

    private readonly GridSort<CodedValueDto> _sortByCode =
        GridSort<CodedValueDto>.ByAscending(x => x.Code);

    private readonly GridSort<CodedValueDto> _sortByName =
        GridSort<CodedValueDto>.ByAscending(x => x.Name);

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        Logger.LogInformation("Loading coded values list");
        try
        {
            _items = await Api.GetRootValuesAsync(token);

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} coded values", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load coded values");
            _error = ex.Message;
        }
    }

    private async Task OnShowDeletedChanged(bool isChecked)
    {
        _showDeleted = isChecked;
        if (_showDeleted && _deletedItems is null)
        {
            try
            {
                _deletedItems = await Api.GetDeletedAsync();
                if (_disposed) return;
            }
            catch (Exception ex)
            {
                if (_disposed) return;
                Logger.LogError(ex, "Failed to load deleted coded values");
                _error = ex.Message;
            }
        }
    }

    /// <summary>
    /// Opens the side drawer that hosts the AI assistant chat. Wired to the inline
    /// chat's <see cref="CodedValuesChat.OnPromptSent"/> event so the drawer
    /// surfaces whenever the user sends a prompt from the page.
    ///
    /// The drawer is owned by <see cref="CodedValuesChatPanel"/> via the shared
    /// <see cref="SideDrawer"/> component: it renders a right-anchored panel
    /// with a header (title + dismiss button), a backdrop, and Escape-to-close,
    /// hosting a single read-only <see cref="CodedValuesChat"/> bound to
    /// <see cref="CodedValuesChatHub"/>. The drawer is read-only: the user
    /// prompts from the inline chat on the page and the drawer surfaces the
    /// streamed responses and final messages.
    /// </summary>
    private Task OpenChatDrawerAsync()
    {
        if (_disposed) return Task.CompletedTask;
        Logger.LogInformation("OpenChatDrawerAsync fired — opening drawer (was open={WasOpen})", _chatDrawerOpen);
        _chatDrawerOpen = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Mirror handler for the inline chat's <see cref="CodedValuesChat.OnMessageAdded"/> event. Each
    /// new prompt and AI response is appended to <see cref="CodedValuesChatHub"/>, which the drawer
    /// panel's chat reads via its <see cref="CodedValuesChat.ExternalMessages"/> parameter. Both the
    /// inline page chat and the drawer chat push into the same hub so the conversation stays in
    /// sync regardless of which surface the user prompts from.
    /// </summary>
    private Task OnMessageAddedAsync(CodedValuesChat.ChatMessageItem message)
    {
        if (_disposed) return Task.CompletedTask;
        ChatHub.AddMessage(message);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Mirror handler for the inline chat's <c>OnStreamingStateChanged</c>
    /// event. Pushes the live streaming snapshot into the hub on every chunk
    /// so the drawer's display chat renders the same "AI is typing…" indicator
    /// and the partial response text as the inline chat.
    /// </summary>
    private Task OnStreamingStateChangedAsync(CodedValuesChat.ChatStreamingState state)
    {
        if (_disposed) return Task.CompletedTask;
        ChatHub.SetStreamingState(state);
        return Task.CompletedTask;
    }

    private async Task OnRecoverAsync(Guid id, string code)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Recover '{code}'? This will restore the item to the active list.",
            "Recover",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.RecoverAsync(id);
            if (_disposed) return;
            // Remove from deleted list, re-fetch active list
            _deletedItems = _deletedItems?.Where(x => x.Id != id).ToArray();
            _items = await Api.GetRootValuesAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to recover coded value {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Optimistic toggle: flip the in-memory DTO, render immediately, dispatch the
    /// API call in the background, and roll back on failure.
    /// </summary>
    private async Task OnToggleAsync(Guid id, bool disable)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { IsDisabled = disable };
        StateHasChanged();

        try
        {
            if (disable) await Api.DisableAsync(id);
            else         await Api.EnableAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to toggle coded value {Id}", id);
            if (_items is not null)
            {
                var i = Array.FindIndex(_items, x => x.Id == id);
                if (i >= 0) _items[i] = previous;
            }
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnDeleteAsync(Guid id, string code)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete '{code}'? This will soft-delete the item. Items with children or SourceCode references cannot be deleted.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.DeleteAsync(id);
            if (_disposed) return;
            if (_items is not null)
            {
                _items = _items.Where(x => x.Id != id).ToArray();
                StateHasChanged();
            }
            // If showing deleted, refresh the deleted list too
            if (_showDeleted)
            {
                _deletedItems = await Api.GetDeletedAsync();
                if (_disposed) return;
                StateHasChanged();
            }
        }
        catch (InvalidOperationException ex)
        {
            if (_disposed) return;
            _error = ex.Message;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete coded value {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _searchResults = null;
            _isSearching = false;
            StateHasChanged();
            return;
        }

        // Cancel previous in-flight search request
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        _isSearching = true;
        try
        {
            _searchResults = await Api.SearchAsync(_searchText, parentId: null, includeDisabled: _showDeleted, ct);
            if (_disposed) return;
            _isSearching = false;
            Logger.LogInformation("Search returned {Count} results for '{SearchText}'", _searchResults.Length, _searchText);
        }
        catch (OperationCanceledException)
        {
            // previous search cancelled — new one already started
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Search failed for '{SearchText}'", _searchText);
            _error = ex.Message;
            _isSearching = false;
        }

        StateHasChanged();
    }

    private void OnSearchClear()
    {
        _searchText = string.Empty;
        _searchResults = null;
        _isSearching = false;
        _searchCts?.Cancel();
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }
}
