@page "/coded-values"
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Landing
@using SchoolCollab.CodedValues.Admin.Components.Pages.CodedValues
@using SchoolCollab.CodedValues.Admin.Services
@inject CodedValuesApiClient Api
@inject ILogger<Index> Logger
@inject IDialogService DialogService
@inject CodedValuesChatHub ChatHub
@inject IFeatureFlagService FeatureFlags
@implements IDisposable

<LandingPage TItem="CodedValueDto"
             Title="Coded Values"
             CreateLabel="+ New Category"
             CreateRoute="/coded-values/new"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@DisplayItems"
             Error="@_error"
             Loading="@_isSearching"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchValueChanged"
             SearchPlaceholder="Search categories…">
    <ToolbarFilters>
        <FluentCheckbox @bind-Value="@_showDeleted" @bind-Value:after="OnShowDeletedChanged"
                        Label="Show deleted" />
    </ToolbarFilters>
    <ToolbarActions>
        @* Opens the AI assistant side drawer without sending a prompt, so users
           can re-read prior responses or follow an ongoing stream. (Sending a
           prompt opens the drawer via OnPromptSubmittedAsync instead.) Gated by
           the runtime, tenant-overridable FEATURE:EnableCodedValuesAiChat flag
           resolved via the central Config service. *@
        @if (_aiChatEnabled == true)
        {
            <FluentButton Appearance="Appearance.Neutral"
                          Title="Open AI assistant"
                          OnClick="OpenChatDrawerAsync">
                ✨ Chat
            </FluentButton>
        }
    </ToolbarActions>
    <Columns>
        <TemplateColumn TGridItem="CodedValueDto" Title="Code" SortBy="@_sortByCode" Sortable="true" TooltipText="@(x => x.Code)">
            <code>@context.Code</code>
        </TemplateColumn>
        <TemplateColumn TGridItem="CodedValueDto" Title="Name" SortBy="@_sortByName" Sortable="true" TooltipText="@(x => x.Name)">
            <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/children")">
                @context.Name (@context.ChildrenCount)
            </FluentAnchor>
        </TemplateColumn>
        <PropertyColumn TGridItem="CodedValueDto" TProp="string" Property="@(x => x.Description)" Title="Description" />
        <TemplateColumn TGridItem="CodedValueDto" Title="Status">
            @if (context.IsDeleted)
            {
                <FluentBadge Appearance="Appearance.Neutral">Deleted</FluentBadge>
            }
            else if (context.IsDisabled)
            {
                <FluentBadge Appearance="Appearance.Neutral">Disabled</FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="CodedValueDto" Title="Definitions" TooltipText="@(x => x.AttributeDefinitions.Count > 0 ? string.Join(", ", x.AttributeDefinitions.Select(d => d.Key)) : null)">
            @if (context.AttributeDefinitions.Count > 0)
            {
                @string.Join(", ", context.AttributeDefinitions.Select(d => d.Key))
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="CodedValueDto" Title="Actions">
            @if (context.IsDeleted)
            {
                <FluentAnchor Href="#" OnClick="@(() => OnRecoverAsync(context.Id, context.Code))">Recover</FluentAnchor>
                <FluentAnchor Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/children")" class="ms-2">View</FluentAnchor>
            }
            else
            {
                @if (context.IsDisabled)
                {
                    <FluentAnchor Href="#" OnClick="@(() => OnToggleAsync(context.Id, disable: false))">Enable</FluentAnchor>
                }
                else
                {
                    <FluentAnchor Href="#" OnClick="@(() => OnToggleAsync(context.Id, disable: true))">Disable</FluentAnchor>
                }
                <FluentAnchor Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/edit")" class="ms-2">Edit</FluentAnchor>
                <FluentAnchor Href="#" OnClick="@(() => OnDeleteAsync(context.Id, context.Code))" class="ms-2">Delete</FluentAnchor>
            }
        </TemplateColumn>
    </Columns>
    <Footer>
        @* -- Chat pinned to bottom. The inline chat is InputOnly: a pure
           launcher that never calls the AI. It forwards the user's text via
           OnPromptSubmitted; this handler clears the shared hub for a fresh
           conversation (when the drawer is closed), opens the drawer, and
           feeds the text to the drawer's Full-mode chat via the Prompt
           parameter. The drawer is the single AI-calling surface and owns
           the conversation history. -- *@
        @if (_aiChatEnabled == true)
        {
            <CodedValuesChat Mode="CodedValuesChat.CodedValuesChatMode.InputOnly"
                             ShowIntro="true"
                             OnPromptSubmitted="@OnPromptSubmittedAsync" />
        }
    </Footer>
    <ChildContent>
        @if (_aiChatEnabled == true)
        {
            <CodedValuesChatPanel Open="_chatDrawerOpen"
                                   OpenChanged="@OnDrawerOpenChangedAsync"
                                   Prompt="@_pendingPrompt" />
        }
    </ChildContent>
</LandingPage>

@code {
    private CodedValueDto[]? _items;
    private CodedValueDto[]? _deletedItems;
    private bool _showDeleted;
    private string? _error;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;
    private bool _chatDrawerOpen;
    // Tri-state so the page can render the chat only when the feature flag has
    // actually been resolved. Defaulting to `true` caused a visible flash on the
    // landing page: the chat button + inline input appeared on first paint, then
    // hid a tick later when OnInitializedAsync awaited the flag and discovered
    // the flag was off. Defaulting to `null` (unresolved) keeps both render
    // branches inactive until the flag is known, so the disabled state never
    // leaks into the first frame.
    private bool? _aiChatEnabled;

    // Search state
    private string _searchText = string.Empty;
    private CodedValueDto[]? _searchResults;
    private bool _isSearching;
    private CancellationTokenSource? _searchCts;

    // The array currently shown: search results while searching, otherwise the
    // loaded active list merged with the deleted list when "Show deleted" is on
    // (deleted rows render with a Deleted status badge and a Recover action via
    // the per-row column templates). Null while the relevant fetch is in flight
    // (the wrapper turns that into the spinner via Items=null or Loading=_isSearching).
    private CodedValueDto[]? DisplayItems
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_searchText))
                return _searchResults;

            return _showDeleted
                ? (_items ?? []).Concat(_deletedItems ?? []).ToArray()
                : _items;
        }
    }

    private string CurrentEmptyMessage =>
        !string.IsNullOrWhiteSpace(_searchText)
            ? $"No categories match '{_searchText}'."
            : "No coded value categories yet.";

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "150px minmax(200px,2fr) minmax(180px,2fr) minmax(80px,1fr) minmax(180px,2fr) auto"
    };

    private readonly GridSort<CodedValueDto> _sortByCode =
        GridSort<CodedValueDto>.ByAscending(x => x.Code);

    private readonly GridSort<CodedValueDto> _sortByName =
        GridSort<CodedValueDto>.ByAscending(x => x.Name);

    protected override async Task OnInitializedAsync()
    {
        _aiChatEnabled = await FeatureFlags.IsEnabledAsync("FEATURE:EnableCodedValuesAiChat");
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        Logger.LogInformation("Loading coded values list");
        try
        {
            _items = await Api.GetRootValuesAsync(token);

            if (_disposed) return;

            Logger.LogInformation("Loaded {Count} coded values", _items?.Length ?? 0);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load coded values");
            _error = ex.Message;
        }
    }

    private async Task OnShowDeletedChanged()
    {
        if (_showDeleted && _deletedItems is null)
        {
            try
            {
                _deletedItems = await Api.GetDeletedAsync();
                if (_disposed) return;
            }
            catch (Exception ex)
            {
                if (_disposed) return;
                Logger.LogError(ex, "Failed to load deleted coded values");
                _error = ex.Message;
            }
        }
    }

    /// <summary>
    /// Opens the side drawer that hosts the AI assistant chat. Wired to the
    /// page's ✨ Chat button so users can re-read prior responses or follow an
    /// ongoing stream without sending a new prompt.
    ///
    /// The drawer is owned by <see cref="CodedValuesChatPanel"/> via the shared
    /// <see cref="SideDrawer"/> component. Its inner Full-mode
    /// <see cref="CodedValuesChat"/> is the single AI-calling surface; the inline
    /// InputOnly chat on the page only forwards text to it (see
    /// <see cref="OnPromptSubmittedAsync"/>).
    /// </summary>
    private Task OpenChatDrawerAsync()
    {
        if (_disposed) return Task.CompletedTask;
        Logger.LogInformation("OpenChatDrawerAsync fired — opening drawer (was open={WasOpen})", _chatDrawerOpen);
        _chatDrawerOpen = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The prompt forwarded from the inline InputOnly chat, passed down to the
    /// drawer's chat via <see cref="CodedValuesChatPanel.Prompt"/>. When the drawer's
    /// inner chat receives a new value it runs one AI turn with it.
    /// </summary>
    private string? _pendingPrompt;

    /// <summary>
    /// Handler for the inline InputOnly chat's <see cref="CodedValuesChat.OnPromptSubmitted"/>
    /// callback. The inline chat never calls the AI — it only forwards the user's
    /// text here. When the drawer is closed this is a new conversation, so clear
    /// the shared <see cref="CodedValuesChatHub"/> (fresh message list + fresh AI
    /// history; the prior accumulation caused long delays/timeouts on the
    /// confirmation turn). Then open the drawer and feed the text to the drawer's
    /// Full-mode chat via <see cref="_pendingPrompt"/>, which triggers the actual
    /// ChatAsync. Follow-ups sent while the drawer is already open keep the
    /// current conversation (prompt + proposal) for the AI.
    /// </summary>
    private Task OnPromptSubmittedAsync(string prompt)
    {
        if (_disposed) return Task.CompletedTask;
        if (!_chatDrawerOpen)
        {
            ChatHub.Clear();
        }
        _pendingPrompt = prompt;
        _chatDrawerOpen = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles the drawer's open/close transitions. On close, drops the stale
    /// forwarded prompt (<see cref="_pendingPrompt"/>) so that re-opening the
    /// drawer via the ✨ Chat button does NOT re-fire the last prompt. The
    /// <see cref="SideDrawer"/> unmounts the inner chat on close (resetting its
    /// consumed-prompt tracker), so a stale <see cref="_pendingPrompt"/> would
    /// otherwise be treated as a brand-new prompt on remount.
    /// </summary>
    private Task OnDrawerOpenChangedAsync(bool open)
    {
        if (_disposed) return Task.CompletedTask;
        _chatDrawerOpen = open;
        if (!open)
        {
            _pendingPrompt = null;
        }
        return Task.CompletedTask;
    }

    private async Task OnRecoverAsync(Guid id, string code)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Recover '{code}'? This will restore the item to the active list.",
            "Recover",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.RecoverAsync(id);
            if (_disposed) return;
            // Remove from deleted list, re-fetch active list
            _deletedItems = _deletedItems?.Where(x => x.Id != id).ToArray();
            _items = await Api.GetRootValuesAsync();
            if (_disposed) return;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to recover coded value {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Optimistic toggle: flip the in-memory DTO, render immediately, dispatch the
    /// API call in the background, and roll back on failure.
    /// </summary>
    private async Task OnToggleAsync(Guid id, bool disable)
    {
        if (_disposed || _items is null) return;
        var idx = Array.FindIndex(_items, x => x.Id == id);
        if (idx < 0) return;

        var previous = _items[idx];
        _items[idx] = previous with { IsDisabled = disable };
        StateHasChanged();

        try
        {
            if (disable) await Api.DisableAsync(id);
            else         await Api.EnableAsync(id);
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to toggle coded value {Id}", id);
            if (_items is not null)
            {
                var i = Array.FindIndex(_items, x => x.Id == id);
                if (i >= 0) _items[i] = previous;
            }
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnDeleteAsync(Guid id, string code)
    {
        if (_disposed) return;
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete '{code}'? This will soft-delete the item. Items with children or SourceCode references cannot be deleted.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.DeleteAsync(id);
            if (_disposed) return;
            if (_items is not null)
            {
                _items = _items.Where(x => x.Id != id).ToArray();
                StateHasChanged();
            }
            // If showing deleted, refresh the deleted list too
            if (_showDeleted)
            {
                _deletedItems = await Api.GetDeletedAsync();
                if (_disposed) return;
                StateHasChanged();
            }
        }
        catch (InvalidOperationException ex)
        {
            if (_disposed) return;
            _error = ex.Message;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete coded value {Id}", id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnSearchValueChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _searchResults = null;
            _isSearching = false;
            StateHasChanged();
            return;
        }

        // Cancel previous in-flight search request
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        _isSearching = true;
        try
        {
            _searchResults = await Api.SearchAsync(_searchText, parentId: null, includeDisabled: _showDeleted, ct);
            if (_disposed) return;
            _isSearching = false;
            Logger.LogInformation("Search returned {Count} results for '{SearchText}'", _searchResults.Length, _searchText);
        }
        catch (OperationCanceledException)
        {
            // previous search cancelled — new one already started
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Search failed for '{SearchText}'", _searchText);
            _error = ex.Message;
            _isSearching = false;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }
}