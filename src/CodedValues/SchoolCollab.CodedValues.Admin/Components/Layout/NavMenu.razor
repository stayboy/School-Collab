<FluentNavMenu Width="250"
               Collapsible="true"
               @bind-Expanded="Expanded"
               Title="Main navigation">
    <FluentNavLink Href="/"
                   Match="NavLinkMatch.All">
        Home
    </FluentNavLink>

    <FluentNavGroup Title="Coded Values">
        <FluentNavLink Href="/coded-values"
                       Match="NavLinkMatch.Prefix">
            All categories
        </FluentNavLink>
        <FluentNavLink Href="/coded-values/new">
            New category
        </FluentNavLink>
        <FluentNavLink Href="/Error">
            Error page
        </FluentNavLink>
    </FluentNavGroup>
</FluentNavMenu>

@code {
    [Parameter] public bool Expanded { get; set; } = true;
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
}
