@inherits LayoutComponentBase
@using SchoolCollab.CodedValues.Admin.Services
@implements IDisposable
@inject CodedValuesApiClient Api

<FluentDesignTheme @bind-Mode="@_mode"
                   @bind-OfficeColor="@_officeColor"
                   StorageName="theme"
                   OnLuminanceChanged="OnLuminanceChanged" />

<FluentToastProvider />
<FluentDialogProvider />
<FluentMessageBarProvider />
<FluentTooltipProvider />
<FluentKeyCodeProvider />

<FluentLayout>
    <FluentHeader Height="50">
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="12"
                     Style="height:100%;padding-left:1rem;padding-right:1rem;">

            <span class="brand">School Collab</span>
            <span class="brand-sep" aria-hidden="true">·</span>
            <span class="brand-page">@(_pageTitle ?? "Coded Values")</span>

            <FluentSpacer />

            <ThemeSwitcher @bind-Mode="@_mode"
                           @bind-Accent="@_officeColor" />
        </FluentStack>
    </FluentHeader>

    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalGap="0"
                 Style="height: calc(100vh - 50px); width: 100%;">

        <NavMenu ParentValues="@_parentValues" Loading="@_loadingParents" />

        <FluentBodyContent Style="flex:1; min-width:0; overflow:hidden;">
            <article class="content">
                @Body
            </article>
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private DesignThemeModes _mode = DesignThemeModes.System;
    private OfficeColor? _officeColor = OfficeColor.Teams;
    private string? _pageTitle;
    private string? _lastPath;
    private CodedValueDto[]? _parentValues;
    private bool _loadingParents = true;

    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ILogger<MainLayout> Logger { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdatePageTitle(new Uri(Nav.Uri).AbsolutePath);

        try
        {
            _parentValues = await Api.GetRootValuesAsync();
            Logger.LogInformation("Loaded {Count} parent coded values for sidebar", _parentValues?.Length ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load parent coded values for sidebar");
        }
        finally
        {
            _loadingParents = false;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => UpdatePageTitle(new Uri(e.Location).AbsolutePath);

    private void UpdatePageTitle(string path)
    {
        if (string.Equals(path, _lastPath, StringComparison.OrdinalIgnoreCase)) return;
        _lastPath = path;

        _pageTitle = path switch
        {
            "/" or "/coded-values"                                  => "Coded Values",
            var p when p.StartsWith("/coded-values/new", StringComparison.OrdinalIgnoreCase) => "New Category",
            var p when p.EndsWith("/children/new", StringComparison.OrdinalIgnoreCase)     => "New Child",
            var p when p.EndsWith("/children", StringComparison.OrdinalIgnoreCase)         => "Children",
            var p when p.Contains("/edit", StringComparison.OrdinalIgnoreCase)            => "Edit Category",
            "/Error"                                               => "Error",
            _                                                      => null
        };

        InvokeAsync(StateHasChanged);
    }

    private void OnLuminanceChanged(LuminanceChangedEventArgs args)
    {
        Logger.LogInformation("Theme luminance changed to {Mode}", args.Mode);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
