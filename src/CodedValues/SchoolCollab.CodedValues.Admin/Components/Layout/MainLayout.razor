@inherits LayoutComponentBase
@using SchoolCollab.Admin.Shared.Components.Layout
@using SchoolCollab.Admin.Shared.Components.Theme
@using SchoolCollab.CodedValues.Admin.Services
@implements IDisposable
@inject CodedValuesApiClient Api
@inject ILogger<MainLayout> Logger

<SchoolCollabLayout Body="@Body"
                   DefaultTitle="Coded Values"
                   HeaderExtras="@HeaderExtras"
                   SidebarContent="@SidebarContent"
                   TitleResolver="@ResolveTitle" />

@code {
    private CodedValueDto[]? _parentValues;
    private bool _loadingParents = true;
    private DesignThemeModes _mode = DesignThemeModes.System;
    private OfficeColor? _officeColor = OfficeColor.Teams;

    private RenderFragment HeaderExtras => __builder => {
        <ThemeSwitcher @bind-Mode="_mode" @bind-Accent="_officeColor" />
    };

    private RenderFragment SidebarContent => __builder => {
        <NavMenu ParentValues="@_parentValues" Loading="@_loadingParents" />
    };

    private static string? ResolveTitle(string path) => path switch
    {
        "/" or "/coded-values"                                                              => "Coded Values",
        var p when p.StartsWith("/coded-values/new", StringComparison.OrdinalIgnoreCase)     => "New Category",
        var p when p.EndsWith("/children/new", StringComparison.OrdinalIgnoreCase)          => "New Child",
        var p when p.EndsWith("/children", StringComparison.OrdinalIgnoreCase)              => "Children",
        var p when p.Contains("/edit", StringComparison.OrdinalIgnoreCase)                   => "Edit Category",
        "/Error"                                                                            => "Error",
        _                                                                                   => null
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _parentValues = await Api.GetRootValuesAsync();
            Logger.LogInformation("Loaded {Count} parent coded values for sidebar", _parentValues?.Length ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load parent coded values for sidebar");
        }
        finally
        {
            _loadingParents = false;
            StateHasChanged();
        }
    }

    public void Dispose() { }
}
