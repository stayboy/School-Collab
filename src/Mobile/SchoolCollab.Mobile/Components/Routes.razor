@* v5 requires this cascade at the app root: it supplies LibraryConfiguration to every
   FluentUI component in the tree (layouts, pages, providers). Wrapping the Router also covers
   Router's NotFoundPage path, which renders outside the <RouteView>. *@
<FluentProviders>
    <Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</FluentProviders>
