<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The plain `net10.0` TFM is load-bearing, not cosmetic: the MAUI head's TFMs
       (android/ios/maccatalyst/windows) cannot build or test on the ubuntu runners, so
       everything CI has to see lives here and only host wiring stays in the head. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <!-- `AddHttpClient` / `AddHttpMessageHandler` for the client-side registration path. FluentUI
         already pulls this in transitively, but a compile-time API this library's public
         extensions call must be a declared dependency, not a transitive accident. No Version
         attribute — CPM (Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Admin.Shared design-system RCL: the clients (and VisibleTenantService) this project
         registers client-side. The same edge the server-side module Application projects carry. -->
    <ProjectReference Include="..\..\SchoolCollab.Admin.Shared\SchoolCollab.Admin.Shared.csproj" />
    <!-- The assignments slice's DTOs. Contracts only, never Assignments.Application: that project's
         closure carries a Microsoft.AspNetCore.App FrameworkReference (through Students.Application),
         which is the carrier that broke the head's net10.0-android build before L2 removed it. This
         project is net10.0 with no packages and no framework references. -->
    <ProjectReference Include="..\..\Assignments\SchoolCollab.Assignments.Contracts\SchoolCollab.Assignments.Contracts.csproj" />
  </ItemGroup>

</Project>
