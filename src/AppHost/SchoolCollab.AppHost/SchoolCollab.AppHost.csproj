<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>71bc1e6c-899e-4131-98f2-60199f7d3ba2</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Python" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>
  <ItemGroup>
    <!-- ar-21: Ship the committed Keycloak realm import next to the AppHost dll so the
         container bind mount resolves it at launch (Program.cs WithBindMount). The file
         is DEV-ONLY (see the AppHost Keycloak block comment + configuration.md §4 for the
         dev credential warning). Named <realm>-realm.json per Keycloak's convention — the
         AppHostRealmImportArchitectureTests guard asserts this name agrees with the
         keycloakRealmPath variable and the bind-mount target. -->
    <None Include="school-collab-realm.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Settings\SchoolCollab.Settings.Contracts\SchoolCollab.Settings.Contracts.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Settings\SchoolCollab.Settings.Core\SchoolCollab.Settings.Core.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Settings\SchoolCollab.Settings.Api\SchoolCollab.Settings.Api.csproj" />
    <ProjectReference Include="..\..\SchoolCollab.Admin\SchoolCollab.Admin.csproj" />
    <ProjectReference Include="..\..\AI\SchoolCollab.AI.Server\SchoolCollab.AI.Server.csproj" />
    <ProjectReference Include="..\..\SchoolCollab.MigrationService\SchoolCollab.MigrationService.csproj" />
    <ProjectReference Include="..\..\Assignments\SchoolCollab.Assignments.Contracts\SchoolCollab.Assignments.Contracts.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Assignments\SchoolCollab.Assignments.Core\SchoolCollab.Assignments.Core.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Assignments\SchoolCollab.Assignments.Api\SchoolCollab.Assignments.Api.csproj" />
    <ProjectReference Include="..\..\Assignments\SchoolCollab.Assignments.Worker\SchoolCollab.Assignments.Worker.csproj" />
    <ProjectReference Include="..\..\Students\SchoolCollab.Students.Contracts\SchoolCollab.Students.Contracts.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Students\SchoolCollab.Students.Core\SchoolCollab.Students.Core.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Students\SchoolCollab.Students.Api\SchoolCollab.Students.Api.csproj" />
    <ProjectReference Include="..\..\Students\SchoolCollab.Students.Worker\SchoolCollab.Students.Worker.csproj" />
    <ProjectReference Include="..\..\SchoolCollab.Families\SchoolCollab.Families.csproj" />
    <!-- Round A pass 2: the ProjectReference is what makes the generated
         Projects.SchoolCollab_Auth constant exist for the AddProject call in
         Program.cs (plan-review P1-1) — a resource, not IsAspireProjectResource="false". -->
    <ProjectReference Include="..\..\SchoolCollab.Auth\SchoolCollab.Auth.csproj" />
  </ItemGroup>
</Project>
