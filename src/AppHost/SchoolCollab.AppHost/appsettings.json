{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Parameters": {
    "outbox-exchange-settings": "settings",
    "outbox-exchange-assignments": "assignments",
    "outbox-exchange-students": "students",
    "ai-default-provider": "openrouter",
    "ollama-endpoint": "http://localhost:11434/v1",
    "ollama-default-model": "gemma4:31b-cloud",
    "openrouter-endpoint": "https://openrouter.ai/api/v1",
    "openrouter-default-model": "google/gemma-4-31b-it",
    "use-local-coded-value-projection": "false",
    "period-activation-tolerance-days": "10",
    "assignment-file-store-root": "assignment-files",
    "assignment-upload-max-file-bytes": "26214400",
    "assignment-upload-max-total-bytes": "104857600",
    "assignment-upload-allowed-extensions": ".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.webp,.txt,.md,.csv"
  }
}
