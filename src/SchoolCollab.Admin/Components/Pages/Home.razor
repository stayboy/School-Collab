@page "/"
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<PageTitle>Home</PageTitle>

<DashboardSection Title="Welcome to School Collab"
                  Subtitle="A collaborative platform for managing educational data."
                  Items="homeItems" />

@code {
    @* Settings is a sub-page of the platform admin surface (its DashboardCard
       entries live at /settings). The other three — Assignments, Students,
       and the Settings landing page — sit at the top level because they
       each own their own bounded context. *@
    private static readonly IReadOnlyList<DashboardItem> homeItems =
    [
        new(Href: "/settings",
            Title: "Settings",
            Description: "Platform-level configuration: coded values and runtime feature flags.",
            Icon: new Icons.Regular.Size24.Settings()),

        new(Href: "/assignments",
            Title: "Assignments",
            Description: "Create, publish, and review assignments and homework.",
            Icon: new Icons.Regular.Size24.ClipboardCheckmark()),

        new(Href: "/students",
            Title: "Students",
            Description: "Manage student records, enrollments, grade levels, subjects, and periods.",
            Icon: new Icons.Regular.Size24.People()),
    ];
}
