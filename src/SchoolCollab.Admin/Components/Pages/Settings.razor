@page "/settings"
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<PageTitle>Settings</PageTitle>

<DashboardSection Title="Settings"
                  Subtitle="Platform-level configuration and administration."
                  Items="settingsItems" />

@code {
    private static readonly IReadOnlyList<DashboardItem> settingsItems =
    [
        new(Href: "/coded-values",
            Title: "Coded Values",
            Description: "Manage categories, subjects, grades, and other reference data.",
            Icon: new Icons.Regular.Size24.Tag()),

        new(Href: "/tenants",
            Title: "Tenants",
            Description: "Review the tenant registry and choose which tenant the admin portal opens on by default.",
            Icon: new Icons.Regular.Size24.Building()),

        new(Href: "/entity-code-rules",
            Title: "Generation Rules",
            Description: "Auto-generated codes for students, staff, and assignments.",
            Icon: new Icons.Regular.Size24.Tag()),

        new(Href: "/config-flags",
            Title: "Config Flags",
            Description: "Manage runtime feature flags — global defaults and per-tenant overrides.",
            Icon: new Icons.Regular.Size24.SlideText()),

        new(Href: "/notification-templates",
            Title: "Notification Templates",
            Description: "Email and SMS templates for assignment notifications, scoped by grade, stream, activity group, subject or assignment type.",
            Icon: new Icons.Regular.Size24.Document()),

        new(Href: "/signature-consent-text",
            Title: "Sign-off Consent Text",
            Description: "Tenant-level consent language shown when guardians sign off assignments.",
            Icon: new Icons.Regular.Size24.ClipboardCheckmark()),

        new(Href: "/assignment-ai-prompt",
            Title: "Assignment AI Prompt",
            Description: "Organization-level AI prompt and teacher-override lock for question generation.",
            Icon: new Icons.Regular.Size24.Sparkle()),
    ];

    @* Future settings (integrations, audit retention, …) will land here as additional
       DashboardItem entries. Keeping the surface area small until a real consumer needs
       the entry avoids dead navigation. *@
}
