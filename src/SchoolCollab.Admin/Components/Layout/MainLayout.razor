@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Sections
@using SchoolCollab.Admin.Components.Layout
@using SchoolCollab.Students.Application.Components.Toolbar
@implements IDisposable
@inject NavigationManager Nav

<FluentProviders />
<FluentMessageBarProvider />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header" Height="50">
        <div class="layout-header-stack">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12">

                @* One flex child, so the bar has an explicit priority order: the brand and its
                   separator never yield, the page title yields before anything on the right does.
                   An unmapped route renders neither the separator nor a title, instead of the
                   brand a second time. *@
                <div class="app-bar-title-cluster">
                    <span class="brand">School Collab</span>
                    @if (_pageTitle is not null)
                    {
                        <span class="brand-sep" aria-hidden="true">&#183;</span>
                        <span class="brand-page">@_pageTitle</span>
                    }
                </div>

                <FluentSpacer />

                @* Context only: the active term and the dev tenant switcher. The theme menu and
                   the settings shortcut moved to the sidebar's utility row (owner, 2026-10-24) —
                   their fixed width (120px accent select + two 96px buttons) is what used to
                   squeeze the page title into an ellipsis (#402). *@
                <div class="header-actions-trailing">
                    @HeaderActionsLeading
                </div>
            </FluentStack>
        </div>
    </FluentLayoutItem>

    @if (_showSidebar)
    {
        <FluentLayoutItem Area="LayoutArea.Navigation">
            <NavMenu />
        </FluentLayoutItem>
    }

    <FluentLayoutItem Area="LayoutArea.Content">
        <article class="content">
            <div class="page-toolbar-slot">
                <SectionOutlet SectionName="page-toolbar" />
            </div>
            <div class="page-scroll">
                @Body
            </div>
            <div class="page-footer-slot">
                <SectionOutlet SectionName="page-footer" />
            </div>
        </article>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#10060;</span>
</div>

@code {
    private RenderFragment? HeaderActionsLeading => __builder => {
        <ActiveTermToolbar />
        <DevTenantSwitcher />
    };

    private bool _showSidebar = true;

    /// <summary>
    /// The static route title shown after the brand, or <see langword="null"/> when the route has no
    /// entry — an unmapped route renders no title and no separator, never the brand a second time.
    /// </summary>
    /// <remarks>
    /// One arm per route shape the Admin <c>Router</c> serves: the host assembly plus the
    /// Settings / Assignments / Students <c>Application</c> assemblies it adds in
    /// <c>Components/Routes.razor</c>. <c>MainLayoutAppBarTests</c> scans those four assemblies'
    /// <c>@page</c> templates and fails when a shape resolves to nothing, so a new page cannot
    /// silently fall back to a blank bar. The literal routes come first: the prefix/suffix arms
    /// under them are the parameterised shapes (<c>{id}</c>, <c>{Id:guid}</c>, …), whose segment
    /// shapes are what matter — parameter name and case vary between pages.
    /// </remarks>
    public static string? ResolveTitle(string path) => path switch
    {
        "/"                                                    => "Home",
        "/settings"                                           => "Settings",
        "/assignment-ai-prompt"                               => "Assignment AI Prompt",
        "/signature-consent-text"                             => "Sign-off Consent Text",

        "/coded-values"                                       => "Coded Values",
        "/coded-values/new"                                   => "New Category",
        "/coded-values/approvals"                             => "Pending Approvals",

        "/config-flags"                                       => "Feature Flags",
        "/config-flags/new"                                   => "New Flag",

        "/entity-code-rules"                                  => "Code Generation Rules",
        "/entity-code-rules/new"                              => "New Generation Rule",

        "/notification-templates"                             => "Notification Templates",
        "/notification-templates/create"                      => "New Notification Template",

        "/tenants"                                            => "Tenants",

        "/assignments"                                        => "Assignments",
        "/assignments/create"                                 => "New Assignment",

        "/activity-groups"                                    => "Activity Groups",

        "/students"                                           => "Students",
        "/students/create"                                    => "New Student",
        "/students/grade-levels"                              => "Grade Levels",
        "/students/grade-levels/create"                       => "New Grade Level",
        "/students/guardians"                                 => "Guardians",
        "/students/guardians/create"                          => "New Guardian",
        "/students/periods"                                   => "Periods",
        "/students/periods/create"                            => "New Period",
        "/students/subjects"                                  => "Topics",
        "/students/teachers"                                  => "Teachers",

        "/Error"                                              => "Error",

        // Parameterised shapes — most specific suffix first, then each module's own prefix.
        var p when p.StartsWith("/coded-values/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/children/new", StringComparison.OrdinalIgnoreCase)  => "New Child",
        var p when p.StartsWith("/coded-values/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/children", StringComparison.OrdinalIgnoreCase)      => "Children",
        var p when p.StartsWith("/coded-values/", StringComparison.OrdinalIgnoreCase) => "Edit Coded Value",
        var p when p.StartsWith("/config-flags/", StringComparison.OrdinalIgnoreCase) => "Feature Flag",
        var p when p.StartsWith("/entity-code-rules/", StringComparison.OrdinalIgnoreCase) => "Edit Generation Rule",
        var p when p.StartsWith("/notification-templates/", StringComparison.OrdinalIgnoreCase) => "Notification Template",
        var p when p.StartsWith("/activity-groups/", StringComparison.OrdinalIgnoreCase) => "Activity Group",
        var p when p.StartsWith("/assignments/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/sign-off", StringComparison.OrdinalIgnoreCase)      => "Sign Off",
        var p when p.StartsWith("/assignments/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/edit", StringComparison.OrdinalIgnoreCase)          => "Edit Assignment",
        var p when p.StartsWith("/assignments/", StringComparison.OrdinalIgnoreCase) => "Assignment",
        var p when p.StartsWith("/students/guardians/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/edit", StringComparison.OrdinalIgnoreCase)          => "Edit Guardian",
        var p when p.StartsWith("/students/guardians/", StringComparison.OrdinalIgnoreCase) => "Guardian",
        var p when p.StartsWith("/students/grade-levels/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/edit", StringComparison.OrdinalIgnoreCase)          => "Edit Grade Level",
        var p when p.StartsWith("/students/grade-levels/", StringComparison.OrdinalIgnoreCase) => "Grade Level",
        var p when p.StartsWith("/students/periods/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/sub-periods", StringComparison.OrdinalIgnoreCase)    => "Sub-periods",
        var p when p.StartsWith("/students/periods/", StringComparison.OrdinalIgnoreCase) => "Edit Period",
        var p when p.StartsWith("/students/teachers/", StringComparison.OrdinalIgnoreCase) => "Teacher",
        var p when p.StartsWith("/students/", StringComparison.OrdinalIgnoreCase)
                && p.EndsWith("/edit", StringComparison.OrdinalIgnoreCase)          => "Edit Student",
        var p when p.StartsWith("/students/", StringComparison.OrdinalIgnoreCase)  => "Student",
        _                                                                       => null
    };

    private string? _pageTitle;
    private string? _lastPath;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateSidebarVisibility(new Uri(Nav.Uri).AbsolutePath);
        UpdatePageTitle(new Uri(Nav.Uri).AbsolutePath);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateSidebarVisibility(new Uri(e.Location).AbsolutePath);
        UpdatePageTitle(new Uri(e.Location).AbsolutePath);
    }

    private void UpdateSidebarVisibility(string path)
    {
        var showSidebar = path is not ("/" or "");
        if (showSidebar != _showSidebar)
        {
            _showSidebar = showSidebar;
            StateHasChanged();
        }
    }

    private void UpdatePageTitle(string path)
    {
        if (string.Equals(path, _lastPath, StringComparison.OrdinalIgnoreCase)) return;
        _lastPath = path;
        _pageTitle = ResolveTitle(path);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
