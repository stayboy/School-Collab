@using Microsoft.Extensions.Configuration
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using SchoolCollab.Admin.Services
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Core.Auth
@using SchoolCollab.Core.Features
@inject TenantsApiClient TenantsApi
@inject AdminDefaultTenantResolver DefaultTenant
@inject IDevTenantSelection DevTenant
@inject VisibleTenantService VisibleTenant
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IDialogService DialogService
@inject ILogger<DevTenantSwitcher> Logger

@if (!_show)
{
    return;
}

<div class="dev-tenant-switcher">
    @if (_tenants is null)
    {
        <span class="dev-tenant-loading">Loading tenants…</span>
    }
    else if (_tenants.Length == 0)
    {
        @* Empty state: either no tenants are seeded, or the Settings API
           was unreachable. Show a diagnostic so the user can tell the
           two apart and act (run migrations / start the AppHost). *@
        var message = _error ?? "No tenants seeded yet. Run the migration service to seed 'Hydeson School' and 'Little Legends'.";
        <span class="dev-tenant-empty @(string.IsNullOrEmpty(_error) ? string.Empty : "dev-tenant-error")"
              title="@message">
            @if (string.IsNullOrEmpty(_error))
            {
                <text>No tenants</text>
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" />
                <text> Tenants API</text>
            }
        </span>
    }
    else
    {
        @* A raw FluentSelect rather than a shared key-value dropdown wrapper: this is the
           header's three-state tenant switcher and its self-service action lives INSIDE the
           option list (a decorative disabled separator plus a never-selectable "Set as default"
           entry), which the wrappers cannot express. See
           documents/specs/tenant-default-dropdown-action.md (FR-1…FR-6).

           @key re-creates the select after an action-zone entry is rejected: FluentSelect
           records the clicked entry as its own internal selection and only re-reads
           the bound Value when that parameter's value actually changes, so the entry the
           operator clicked has to be reset away from by identity, not by value. *@
        <FluentSelect @key="_selectionEpoch"
                      TOption="TenantOption"
                      TValue="TenantOption"
                      Items="@_options"
                      Value="@_selectedOption"
                      ValueChanged="@OnSelectionChanged"
                      OptionText="@(o => o?.Label ?? string.Empty)"
                      OptionValueToString="@(o => o?.Value ?? string.Empty)"
                      OptionDisabled="@(o => o?.IsSeparator ?? false)"
                      AriaLabel="Switch the dev tenant (auth disabled)"
                      Width="180px" />
    }
</div>

@code {
    // Only shown when OIDC auth is disabled (dev / TestAuth mode). With real auth
    // the tenant arrives via the tenant_id claim from Keycloak, so the switcher is
    // meaningless. The key matches AuthTenancyExtensions / the startup auth-mode
    // switch (NOT a runtime feature flag).
    private bool _show;

    private TenantDto[]? _tenants;
    private TenantOption[] _options = [];
    private TenantOption? _selectedOption;
    private string? _error;

    /// <summary>The operator's explicit switcher pick. <c>null</c> = none; <see cref="Guid.Empty"/> = the system context.</summary>
    private Guid? _explicitSelection;

    /// <summary>The tenant the portal resolved for this load (preference → platform default), published to the shared store.</summary>
    private Guid? _effective;

    /// <summary>The operator's recorded preference, or null when none is recorded.</summary>
    private Guid? _preference;

    /// <summary>
    /// Identity epoch for the <c>@key</c> on the select. Bumped when an action-zone entry is
    /// rejected so the select is re-created and re-applies the still-current tenant selection
    /// (FR-6) — FluentSelect does not re-read an unchanged <c>SelectedOption</c> parameter.
    /// </summary>
    private int _selectionEpoch;

    /// <summary>
    /// Guards the one permitted reconciliation reload. Belt-and-braces: <see cref="AdminDefaultTenantResolver.NeedsReload"/> is
    /// already a fixed point, so a second pass would not ask for a reload anyway.
    /// </summary>
    private bool _reloadRequested;

    /// <summary>
    /// True once the portal has finished resolving its default tenant (the async
    /// preference → platform-default chain). The reconciliation in <see cref="OnAfterRenderAsync"/>
    /// waits for this: it must not read <c>_effective</c> while the resolve is still in flight.
    /// Stays false when the tenant registry could not be loaded, so a failed load never triggers a
    /// reload loop against a stale claim.
    /// </summary>
    private bool _defaultsResolved;

    /// <summary>Sentinel for the explicit "system / no-tenant" entry — never parseable as a tenant id.</summary>
    private const string SystemOptionValue = "system";

    /// <summary>Sentinel for the decorative separator that opens the action zone — never selectable.</summary>
    private const string SetDefaultSeparatorValue = "__set-default-separator__";

    /// <summary>Sentinel for the "Set as default" action entry — never parseable as a tenant id.</summary>
    private const string SetDefaultActionValue = "__set-default-action__";

    // Bound on the Settings API round-trip. Without this, a missing or
    // unreachable Settings API (e.g. the AppHost's infrastructure failed to
    // start, or the Admin is running standalone without the backend) leaves
    // the switcher stuck on "Loading tenants…" indefinitely and the user
    // can't tell whether the seed is missing or the backend is down.
    private static readonly TimeSpan TenantsLoadTimeout = TimeSpan.FromSeconds(8);

    protected override async Task OnInitializedAsync()
    {
        var disabled = bool.TryParse(
            Config[$"FeatureFlags:{FeatureFlagKeys.DisableOIDCAuth}"], out var d) && d;
        _show = disabled;

        if (!_show)
            return;

        try
        {
            using var cts = new CancellationTokenSource(TenantsLoadTimeout);
            _tenants = await TenantsApi.ListTenantsAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            _tenants = [];
            _error = "Settings API did not respond in time. Start the AppHost (it brings up the Settings API and the migration service).";
        }
        catch (Exception ex)
        {
            _tenants = [];
            _error = $"Settings API unreachable: {ex.Message}. Start the AppHost or the Settings API directly.";
        }

        if (_tenants.Length > 0)
        {
            _defaultsResolved = await ResolveDefaultsAsync();
        }

        BuildOptions();
    }

    /// <summary>
    /// Applies the freshly-resolved default to this circuit by reloading once when the claim and
    /// the applied default disagree. Done here rather than in
    /// <see cref="OnInitializedAsync"/> because navigation during the initial (synchronous)
    /// render phase is not legal; after a render it is.
    /// </summary>
    /// <remarks>
    /// The check runs on <em>every</em> render once <see cref="_defaultsResolved"/> is set, not only
    /// on the first. <c>_effective</c> is populated by an async Settings API round-trip, and Blazor
    /// renders the loading state before <see cref="OnInitializedAsync"/> completes — so a
    /// <c>firstRender</c>-only check always reads <c>_effective == null</c> in production and never
    /// requests the reload (it passed in bUnit only because the scripted handler completed
    /// synchronously). <see cref="_reloadRequested"/> still caps this at one reload per circuit.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_defaultsResolved || !_show || _reloadRequested)
            return;

        var scope = await VisibleTenant.GetScopeAsync();
        var claimTenant = scope.IsRealTenant ? scope.TenantId!.Value : Guid.Empty;

        if (!AdminDefaultTenantResolver.NeedsReload(_explicitSelection, _effective, claimTenant))
            return;

        _reloadRequested = true;
        Logger.LogInformation(
            "Admin portal default tenant {AppliedDefault} differs from this circuit's claim {ClaimTenant}; reloading once so tenant-scoped pages pick it up",
            _effective, claimTenant);

        Nav.Refresh(forceReload: true);
    }

    /// <summary>
    /// Resolves and publishes the portal's default (preference → platform default), then reads
    /// the explicit pick so the dropdown reflects the truth for this load. Failures here are
    /// non-fatal: a portal that cannot reach the Settings API still renders, showing the pick
    /// state it can determine.
    /// </summary>
    /// <returns>
    /// <see langword="true"/> when the resolve+apply chain completed (so the caller may reconcile
    /// the circuit's claim against <see cref="_effective"/>); <see langword="false"/> when it timed
    /// out or failed, so the caller must not reconcile against a value that was never applied.
    /// </returns>
    private async Task<bool> ResolveDefaultsAsync()
    {
        var resolved = false;
        try
        {
            using var cts = new CancellationTokenSource(TenantsLoadTimeout);
            _effective = await DefaultTenant.ResolveAndApplyAsync(
                AdminDefaultTenantResolver.PlatformDefaultOf(_tenants!), cts.Token);
            _preference = await DefaultTenant.GetPreferenceAsync(cts.Token);
            resolved = true;
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Default-tenant resolution timed out; the switcher will show no resolved default");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Default-tenant resolution failed; the switcher will show no resolved default");
        }

        _explicitSelection = await DevTenant.GetSelectedTenantIdAsync();
        return resolved;
    }

    /// <summary>
    /// Rebuilds the dropdown: the system / no-tenant context (what shared-blueprint editing
    /// needs), then every real tenant. The action zone — a decorative disabled separator plus the
    /// <c>Set as default</c> entry — is appended only for a real-tenant selection that is not
    /// already the recorded preference (FR-2/FR-3).
    /// </summary>
    private void BuildOptions()
    {
        var options = new List<TenantOption>
        {
            new("(system / no tenant)", SystemOptionValue),
        };
        options.AddRange(_tenants!.Select(t => new TenantOption(t.Name, t.Id.ToString())));

        var selected = ResolveSelectedRow(options);

        // FR-3: only a real tenant (not the system context, which is unparseable as a tenant id)
        // that differs from the recorded preference gets the action zone. A null preference means
        // "none recorded", so any real tenant qualifies; an explicit Guid.Empty preference is a
        // real value every tenant differs from.
        if (Guid.TryParse(selected.Value, out var selectedTenantId)
            && selectedTenantId != _preference)
        {
            options.Add(new TenantOption("──── my default ────", SetDefaultSeparatorValue, IsSeparator: true));
            options.Add(new TenantOption("Set as default", SetDefaultActionValue, IsAction: true));
        }

        _options = [.. options];
        _selectedOption = selected;
    }

    /// <summary>
    /// The row the select shows as selected. Its selected value IS the tenant the portal is
    /// operating under: the explicit pick's row when there is one, otherwise the row of the
    /// resolved default (<see cref="_effective"/>). Never <see langword="null"/> — a null
    /// <c>Value</c> leaves the select blank.
    /// </summary>
    /// <remarks>
    /// Display-only: this method never writes the selection slot. Showing the resolved default as
    /// the selection must not turn "nothing picked" into "the operator picked this tenant" — the
    /// distinction the resolver's separate applied-default slot exists to preserve.
    /// </remarks>
    private TenantOption ResolveSelectedRow(List<TenantOption> options)
    {
        var systemRow = options.First(o => o.Value == SystemOptionValue);

        if (_explicitSelection == Guid.Empty)
            return systemRow;

        if (_explicitSelection is { } pick
            && options.FirstOrDefault(o => o.Value == pick.ToString()) is { } picked)
        {
            return picked;
        }

        if (_effective is { } effective && effective != Guid.Empty
            && options.FirstOrDefault(o => o.Value == effective.ToString()) is { } resolved)
        {
            return resolved;
        }

        return systemRow;
    }

    private string? TenantNameOf(Guid? tenantId)
    {
        if (tenantId is null)
            return null;

        if (tenantId.Value == Guid.Empty)
            return "system / no tenant";

        return _tenants?.FirstOrDefault(t => t.Id == tenantId.Value)?.Name;
    }

    private async Task OnSelectionChanged(TenantOption? option)
    {
        // FR-4/FR-6: an action-zone entry is never the bound selection. Restore the tenant entry
        // synchronously — before any await — then (for the action entry only) run the confirm
        // flow. The separator cannot normally arrive here: it renders disabled, and FluentOption
        // short-circuits a disabled option's click handler.
        if (option is { IsSeparator: true } or { IsAction: true })
        {
            RestoreTenantSelection();

            if (option is { IsAction: true })
            {
                await SetSelectedTenantAsDefaultAsync();
            }

            return;
        }

        _selectedOption = option;

        var value = option?.Value;
        var tenantId = value switch
        {
            // Explicit system / no-tenant context (Guid.Empty is meaningful, not "cleared").
            SystemOptionValue => (Guid?)Guid.Empty,
            _ => Guid.TryParse(value, out var parsed) ? parsed : null,
        };

        try
        {
            await DevTenant.SetSelectedTenantIdAsync(tenantId);

            // No pick in force: re-publish the resolved default, so this load's API calls carry
            // the right tenant header rather than a stale one.
            if (tenantId is null)
            {
                await DefaultTenant.ResolveAndApplyAsync(
                    AdminDefaultTenantResolver.PlatformDefaultOf(_tenants!), CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to set dev tenant selection");
            return;
        }

        // Force a full reload so every page re-fetches data under the new tenant: each API's
        // TestAuthHandler reads the new selection from the shared distributed cache (Redis) on its
        // next request. Refresh(forceReload: true) is a real document load — a forceLoad navigation
        // is not, so the circuit would keep the tenant claim it read at circuit start.
        Nav.Refresh(forceReload: true);
    }

    /// <summary>
    /// Re-applies the tenant entry the operator still has selected after clicking an action-zone
    /// entry (FR-6). Bumping the <c>@key</c> epoch re-creates the FluentSelect, which is the only
    /// way to make it re-read its <c>Value</c>: the bound value never changed, so the
    /// normal parameter diff would leave the select pointing at the entry just rejected.
    /// </summary>
    private void RestoreTenantSelection()
    {
        _selectionEpoch++;
        BuildOptions();
        StateHasChanged();
    }

    /// <summary>
    /// Asks the operator to confirm, then records the selected tenant as their preference
    /// (FR-4/FR-5). Cancel and dismissal write nothing and leave the selection untouched; a
    /// failed write is logged and non-fatal — the dropdown keeps its state. No success toast:
    /// the forced reload supersedes it, matching the removed button's behaviour.
    /// </summary>
    private async Task SetSelectedTenantAsDefaultAsync()
    {
        if (_selectedOption is not { } selected || !Guid.TryParse(selected.Value, out var tenantId))
            return;

        var confirmed = await DialogService.ShowConfirmDialogAsync(
            $"Open the admin portal on '{TenantNameOf(tenantId)}' by default from now on?",
            primaryText: "Set as default",
            title: "Set default tenant");

        if (!confirmed)
            return;

        try
        {
            await TenantsApi.SetMyDefaultTenantAsync(tenantId);

            // Re-publish so the rest of this load already speaks for the new default.
            await DefaultTenant.ResolveAndApplyAsync(
                AdminDefaultTenantResolver.PlatformDefaultOf(_tenants!), CancellationToken.None);

            Nav.Refresh(forceReload: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to record the default tenant preference");
        }
    }

    /// <summary>
    /// Internal option type for the FluentSelect. The action zone's entries carry
    /// <paramref name="IsSeparator"/> / <paramref name="IsAction"/>; their values are sentinels
    /// that are never guid-parseable and differ from the "system" option value.
    /// </summary>
    /// <param name="Label">Text shown in the dropdown.</param>
    /// <param name="Value">Stable option value used for the FluentSelect binding.</param>
    /// <param name="IsSeparator">True for the decorative, disabled separator entry.</param>
    /// <param name="IsAction">True for the enabled "Set as default" action entry.</param>
    public sealed record TenantOption(
        string Label,
        string Value,
        bool IsSeparator = false,
        bool IsAction = false);
}
