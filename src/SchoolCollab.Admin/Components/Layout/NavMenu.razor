@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Core.Features
@implements IAsyncDisposable
@inject CodedValuesApiClient Api
@inject ILogger<NavMenu> Logger
@inject NavigationManager Nav
@inject IFeatureFlagService FeatureFlags

<FluentNav Width="250"
               aria-label="@(_currentModule == "settings" ? "Settings" : _currentModule == "assignments" ? "Assignments" : _currentModule == "students" ? "Students" : "Navigation")">

    <FluentNavItem Href="/"
                 IconRest="@FluentIcons.Home"
                 Match="NavLinkMatch.All">
        Home
    </FluentNavItem>

    <FluentNavCategory Title="Admin Modules" Expanded="false">
        <FluentNavItem Href="/settings"
                        IconRest="@FluentIcons.Settings">
            Settings
        </FluentNavItem>
        <FluentNavItem Href="/assignments"
                        IconRest="@FluentIcons.ClipboardCheckmark">
            Assignments
        </FluentNavItem>
        <FluentNavItem Href="/students"
                        IconRest="@FluentIcons.People">
            Students
        </FluentNavItem>
    </FluentNavCategory>

    @* When the user is on a Coded Values page, show the Coded Values sub-nav
       (parent categories + AI Assistant) regardless of whether they arrived
       via /settings → /coded-values or directly via the /coded-values URL.
       The Coded Values landing page is hosted in the Settings Admin module
       (see /settings) but the sub-nav still belongs here in the host shell
       so the drawer is available from any Coded Values page. *@
    @if (_currentModule == "settings" || _currentModule == "coded-values" || _currentModule == "entity-code-rules")
    {
        <FluentNavCategory Title="Settings"
                       Expanded="true">
            <FluentNavItem Href="/settings"
                          IconRest="@FluentIcons.Home">
                Settings Home
            </FluentNavItem>

            <FluentNavItem Href="/coded-values"
                          IconRest="@FluentIcons.TextBulletList">
                Coded Values
            </FluentNavItem>

            <FluentNavItem Href="/entity-code-rules"
                          IconRest="@FluentIcons.Tag">
                Generation Rules
            </FluentNavItem>

            <FluentNavCategory Title="Coded Values"
                           Expanded="true"
                           IconRest="@FluentIcons.Tag">
                @if (_loadingParents)
                {
                   <FluentNavItem Href="#" Disabled="true">
                      <FluentSpinner class="progress-ring-small" />
                   </FluentNavItem>
                }
                else if (_parentValues is { Length: > 0 })
                {
                   foreach (var cv in _parentValues.Take(20))
                   {
                      <FluentNavItem Href="@($"/coded-values/{Uri.EscapeDataString(cv.Code)}/children")"
                                    IconRest="@FluentIcons.Tag"
                                    Tooltip="@cv.Name">
                          @Truncate(cv.Name, 22)
                      </FluentNavItem>
                   }

                   if (_parentValues.Length > 20)
                   {
                      <FluentNavItem Href="/coded-values"
                                    IconRest="@FluentIcons.ArrowExportUp">
                          <i>Show More …</i>
                      </FluentNavItem>
                   }
                }
                else
                {
                   <FluentNavItem Href="/coded-values"
                                IconRest="@FluentIcons.TextBulletList">
                      All Categories
                   </FluentNavItem>
                }

                <hr class="nav-separator" />

                <FluentNavItem Href="/coded-values/chat"
                              IconRest="@FluentIcons.Bot">
                   AI Assistant
                </FluentNavItem>

                <FluentNavItem Href="/coded-values/approvals"
                              IconRest="@FluentIcons.CheckmarkCircleFilled">
                   Approvals
                </FluentNavItem>
            </FluentNavCategory>

            <FluentNavItem Href="/config-flags"
                          IconRest="@FluentIcons.SlideText">
                Config Flags
            </FluentNavItem>

            <FluentNavItem Href="/notification-templates"
                          IconRest="@FluentIcons.Document">
                Notification Templates
            </FluentNavItem>
        </FluentNavCategory>
    }

    @if (_currentModule == "assignments")
    {
        <FluentNavCategory Title="Assignments"
                       Expanded="true">
            <FluentNavItem Href="/assignments"
                         IconRest="@FluentIcons.TextBulletList">
               All Assignments
            </FluentNavItem>
            <FluentNavItem Href="/assignments/create"
                         IconRest="@FluentIcons.Add">
               New Assignment
            </FluentNavItem>
        </FluentNavCategory>
    }

    @if (_currentModule == "students")
    {
        <FluentNavCategory Title="Students"
                       Expanded="true">
            <FluentNavItem Href="/students"
                         IconRest="@FluentIcons.People">
               All Students
            </FluentNavItem>
            <FluentNavItem Href="/students/create"
                         IconRest="@FluentIcons.PersonAdd">
               New Student
            </FluentNavItem>
            <FluentNavItem Href="/students/guardians"
                         IconRest="@FluentIcons.People">
               Guardians
            </FluentNavItem>
            <FluentNavItem Href="/students/teachers"
                         IconRest="@FluentIcons.Person">
               Teachers
            </FluentNavItem>
            <hr class="nav-separator" />
            <FluentNavItem Href="/students/grade-levels"
                         IconRest="@FluentIcons.SlideText">
               Grade Levels
            </FluentNavItem>
            <FluentNavItem Href="/students/subjects"
                         IconRest="@FluentIcons.Book">
               Subjects
            </FluentNavItem>
            <FluentNavItem Href="/students/periods"
                         IconRest="@FluentIcons.Calendar">
               Periods
            </FluentNavItem>
            <FeatureFlagGate Key="@FeatureFlagKeys.EnableActivityGroups">
                <FluentNavItem Href="/activity-groups"
                             IconRest="@FluentIcons.People">
                   Activity Groups
                </FluentNavItem>
            </FeatureFlagGate>
        </FluentNavCategory>
    }

</FluentNav>

@code {
    private CodedValueDto[]? _parentValues;
    private bool _loadingParents;
    private volatile bool _disposed;
    private CancellationTokenSource? _loadCts;
    private string _currentModule = "";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _currentModule = DetermineModule(new Uri(Nav.Uri).AbsolutePath);
    }

    protected override async Task OnInitializedAsync()
    {
        if (_currentModule is "settings" or "coded-values")
        {
            await LoadParentValuesAsync();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var newModule = DetermineModule(new Uri(e.Location).AbsolutePath);
        if (newModule != _currentModule)
        {
            _currentModule = newModule;
            StateHasChanged();

            if ((_currentModule is "settings" or "coded-values") && _parentValues is null && !_loadingParents)
            {
               _ = LoadParentValuesAsync();
            }
        }
    }

    private static string DetermineModule(string path) => path switch
    {
        // /settings and any of its sub-pages → "settings"
        var p when p.Equals("/settings", StringComparison.OrdinalIgnoreCase) => "settings",
        // /coded-values and its sub-pages → "coded-values" (a sub-module of Settings)
        var p when p.StartsWith("/coded-values", StringComparison.OrdinalIgnoreCase) => "coded-values",
        // /entity-code-rules → "entity-code-rules" (a sub-module of Settings)
        var p when p.StartsWith("/entity-code-rules", StringComparison.OrdinalIgnoreCase) => "entity-code-rules",
        var p when p.StartsWith("/assignments", StringComparison.OrdinalIgnoreCase) => "assignments",
        var p when p.StartsWith("/students", StringComparison.OrdinalIgnoreCase) => "students",
        _ => ""
    };

    private async Task LoadParentValuesAsync()
    {
        if (_loadingParents || _parentValues is not null) return;

        // Capture the token in a local: DisposeAsync cancels AND nulls _loadCts, so the
        // catch filters must not dereference the field.
        var cts = new CancellationTokenSource();
        _loadCts = cts;
        var ct = cts.Token;
        _loadingParents = true;
        try
        {
            _parentValues = await Api.GetRootValuesAsync(ct);
            if (_disposed) return;
            Logger.LogInformation("Loaded {Count} parent coded values for sidebar", _parentValues?.Length ?? 0);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested || _disposed)
        {
            // Circuit torn down, or a newer load superseded this one — nothing to report.
        }
        catch (Exception ex)
        {
            if (_disposed || ct.IsCancellationRequested) return;
            Logger.LogError(ex, "Failed to load parent coded values for sidebar");
        }
        finally
        {
            _loadingParents = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private static string Truncate(string value, int maxLength)
        => value.Length <= maxLength ? value : string.Concat(value.AsSpan(0, maxLength - 1), "…");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
