@using Microsoft.FluentUI.AspNetCore.Components
@implements IAsyncDisposable
@inject CodedValuesApiClient Api
@inject ILogger<NavMenu> Logger
@inject NavigationManager Nav

<FluentNavMenu Width="250"
               Title="@(_currentModule == "settings" ? "Settings" : _currentModule == "assignments" ? "Assignments" : _currentModule == "students" ? "Students" : "Navigation")">

    <FluentNavLink Href="/"
                 Icon="@FluentIcons.Home"
                 Match="NavLinkMatch.All">
        Home
    </FluentNavLink>

    <FluentNavGroup Title="Admin Modules" Expanded="false">
        <FluentNavLink Href="/settings"
                        Icon="@FluentIcons.Settings">
            Settings
        </FluentNavLink>
        <FluentNavLink Href="/assignments"
                        Icon="@FluentIcons.ClipboardCheckmark">
            Assignments
        </FluentNavLink>
        <FluentNavLink Href="/students"
                        Icon="@FluentIcons.People">
            Students
        </FluentNavLink>
    </FluentNavGroup>

    @* When the user is on a Coded Values page, show the Coded Values sub-nav
       (parent categories + AI Assistant) regardless of whether they arrived
       via /settings → /coded-values or directly via the /coded-values URL.
       The Coded Values landing page is hosted in the Settings Admin module
       (see /settings) but the sub-nav still belongs here in the host shell
       so the drawer is available from any Coded Values page. *@
    @if (_currentModule == "settings" || _currentModule == "coded-values")
    {
        <FluentNavGroup Title="Settings"
                       Expanded="true">
            <FluentNavLink Href="/settings"
                          Icon="@FluentIcons.Home">
                Settings Home
            </FluentNavLink>

            <FluentNavLink Href="/coded-values"
                          Icon="@FluentIcons.TextBulletList">
                Coded Values
            </FluentNavLink>
            <FluentNavGroup Title="Coded Values"
                           Expanded="true"
                           Icon="@FluentIcons.Tag">
                @if (_loadingParents)
                {
                   <FluentNavLink Href="#" Disabled="true">
                      <FluentProgressRing class="progress-ring-small" />
                   </FluentNavLink>
                }
                else if (_parentValues is { Length: > 0 })
                {
                   foreach (var cv in _parentValues.Take(20))
                   {
                      <FluentNavLink Href="@($"/coded-values/{Uri.EscapeDataString(cv.Code)}/children")"
                                    Icon="@FluentIcons.Tag"
                                    Tooltip="@cv.Name">
                          @Truncate(cv.Name, 22)
                      </FluentNavLink>
                   }

                   if (_parentValues.Length > 20)
                   {
                      <FluentNavLink Href="/coded-values"
                                    Icon="@FluentIcons.ArrowExportUp">
                          <i>Show More …</i>
                      </FluentNavLink>
                   }
                }
                else
                {
                   <FluentNavLink Href="/coded-values"
                                Icon="@FluentIcons.TextBulletList">
                      All Categories
                   </FluentNavLink>
                }

                <hr class="nav-separator" />

                <FluentNavLink Href="/coded-values/chat"
                              Icon="@FluentIcons.Bot">
                   AI Assistant
                </FluentNavLink>
            </FluentNavGroup>

            <FluentNavLink Href="/config-flags"
                          Icon="@FluentIcons.SlideText">
                Config Flags
            </FluentNavLink>
        </FluentNavGroup>
    }

    @if (_currentModule == "assignments")
    {
        <FluentNavGroup Title="Assignments"
                       Expanded="true">
            <FluentNavLink Href="/assignments"
                         Icon="@FluentIcons.TextBulletList">
               All Assignments
            </FluentNavLink>
            <FluentNavLink Href="/assignments/create"
                         Icon="@FluentIcons.Add">
               New Assignment
            </FluentNavLink>
        </FluentNavGroup>
    }

    @if (_currentModule == "students")
    {
        <FluentNavGroup Title="Students"
                       Expanded="true">
            <FluentNavLink Href="/students"
                         Icon="@FluentIcons.People">
               All Students
            </FluentNavLink>
            <FluentNavLink Href="/students/create"
                         Icon="@FluentIcons.PersonAdd">
               New Student
            </FluentNavLink>
            <FluentNavLink Href="/students/guardians"
                         Icon="@FluentIcons.People">
               Guardians
            </FluentNavLink>
            <FluentNavLink Href="/students/teachers"
                         Icon="@FluentIcons.Person">
               Teachers
            </FluentNavLink>
            <hr class="nav-separator" />
            <FluentNavLink Href="/students/grade-levels"
                         Icon="@FluentIcons.SlideText">
               Grade Levels
            </FluentNavLink>
            <FluentNavLink Href="/students/subjects"
                         Icon="@FluentIcons.Book">
               Subjects
            </FluentNavLink>
            <FluentNavLink Href="/students/periods"
                         Icon="@FluentIcons.Calendar">
               Periods
            </FluentNavLink>
        </FluentNavGroup>
    }

</FluentNavMenu>

@code {
    private CodedValueDto[]? _parentValues;
    private bool _loadingParents;
    private volatile bool _disposed;
    private CancellationTokenSource? _loadCts;
    private string _currentModule = "";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _currentModule = DetermineModule(new Uri(Nav.Uri).AbsolutePath);
    }

    protected override async Task OnInitializedAsync()
    {
        if (_currentModule is "settings" or "coded-values")
        {
            await LoadParentValuesAsync();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var newModule = DetermineModule(new Uri(e.Location).AbsolutePath);
        if (newModule != _currentModule)
        {
            _currentModule = newModule;
            StateHasChanged();

            if ((_currentModule is "settings" or "coded-values") && _parentValues is null && !_loadingParents)
            {
               _ = LoadParentValuesAsync();
            }
        }
    }

    private static string DetermineModule(string path) => path switch
    {
        // /settings and any of its sub-pages → "settings"
        var p when p.Equals("/settings", StringComparison.OrdinalIgnoreCase) => "settings",
        // /coded-values and its sub-pages → "coded-values" (a sub-module of Settings)
        var p when p.StartsWith("/coded-values", StringComparison.OrdinalIgnoreCase) => "coded-values",
        var p when p.StartsWith("/assignments", StringComparison.OrdinalIgnoreCase) => "assignments",
        var p when p.StartsWith("/students", StringComparison.OrdinalIgnoreCase) => "students",
        _ => ""
    };

    private async Task LoadParentValuesAsync()
    {
        if (_loadingParents || _parentValues is not null) return;

        _loadCts = new CancellationTokenSource();
        _loadingParents = true;
        try
        {
            _parentValues = await Api.GetRootValuesAsync(_loadCts.Token);
            if (_disposed) return;
            Logger.LogInformation("Loaded {Count} parent coded values for sidebar", _parentValues?.Length ?? 0);
        }
        catch (OperationCanceledException) { /* user navigated away */ }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load parent coded values for sidebar");
        }
        finally
        {
            _loadingParents = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private static string Truncate(string value, int maxLength)
        => value.Length <= maxLength ? value : string.Concat(value.AsSpan(0, maxLength - 1), "…");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
