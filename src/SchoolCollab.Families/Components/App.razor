<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* FluentUI v5 dark-theme flash mitigation — see the Admin host's App.razor for the full
       note; the snippet is the guide's "Flash effect (optional)" one, verbatim, and lives in
       css/app.css (linked below) so no inline <style> is needed. *@
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    @* Host (SchoolCollab.Families) scoped-CSS bundle — see the Admin host
       convention: the host's own *.razor.css files compile into
       SchoolCollab.Families.styles.css and must be linked here. *@
    <link rel="stylesheet" href="@Assets["SchoolCollab.Families.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
