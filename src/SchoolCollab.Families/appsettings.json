{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // F1 (slice 2b) — the Families host mirrors Admin's startup auth-mode switch:
  // FEATURE:DisableOIDCAuth is a *startup* switch (auth schemes are registered
  // once at process start and cannot be flipped at runtime). Dev default "true"
  // runs TestAuth; production overrides via FeatureFlags__FEATURE__DisableOIDCAuth.
  "FeatureFlags": {
    "FEATURE": {
      "DisableOIDCAuth": "true",
      // WS-E1 (ar-14-deep-links): cold-start dev fallback for the runtime public
      // deep-link landing flag (the DB-backed /config-flags row is authoritative; this
      // only covers the case where the Settings API is unreachable). Default OFF.
      "EnableDeepLinks": "false"
    }
  }
}
