{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "FEATURE": {
      // WS-E1 (ar-14-deep-links): cold-start dev fallback for the runtime public
      // deep-link landing flag (the DB-backed /config-flags row is authoritative; this
      // only covers the case where the Settings API is unreachable). Default OFF.
      "EnableDeepLinks": "false"
    }
  }
}
