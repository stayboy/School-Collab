@* Add / Edit attribute-definition dialog. Consolidated onto DialogShellBase:
   the saving/error/Cancel/Close boilerplate and the Cancel/Save footer live
   in the base + DialogShellFooter; this component contributes only the form
   fields and the SubmitAsync side effect (which is purely local — it builds
   an AttributeDefinitionResult from the bound model + the two FluentSelect
   selections; the caller persists it). *@
@inherits DialogShellBase<AttributeDefinitionFormModel, AttributeDefinitionResult>
@using SchoolCollab.Admin.Shared.Components.Dialogs
@using Microsoft.FluentUI.AspNetCore.Components

<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <ul class="form-list">
            <li class="form-row">
                <label class="form-label form-label-required" for="def-key">Key *</label>
                <FluentTextField id="def-key" @bind-Value="Model.Key"
                                 Placeholder="e.g. color"
                                 Required
                                 class="form-field" />
            </li>
            <li class="form-row">
                <label class="form-label form-label-required" for="def-displayname">Display Name *</label>
                <FluentTextField id="def-displayname" @bind-Value="Model.DisplayName"
                                 Placeholder="e.g. Color"
                                 class="form-field" />
            </li>
            <li class="form-row">
                <label class="form-label form-label-required" for="def-datatype">Data Type *</label>
                <FluentSelect id="def-datatype" TOption="DataTypeOption"
                              Items="_dataTypes"
                              OptionText="@(dt => dt.Label)"
                              OptionValue="@(dt => ((int)dt.Value).ToString())"
                              @bind-SelectedOption="_selectedDataType"
                              class="form-field" />
            </li>
            <li class="form-row">
                <label class="form-label" for="def-sourcecode">Source Code</label>
                <FluentSelect id="def-sourcecode" TOption="ParentCodedValueOption"
                              Items="_parentCodedValues"
                              OptionText="@(cv => cv.Code + " -- " + cv.Name)"
                              OptionValue="@(cv => cv.Code)"
                              @bind-SelectedOption="_selectedSourceCode"
                              Placeholder="(none)"
                              class="form-field" />
            </li>
            <li class="form-row">
                <label class="form-label">Required</label>
                <FluentCheckbox @bind-Value="Model.IsRequired" />
            </li>
            <li class="form-row">
                <label class="form-label">Allow Multiple</label>
                <FluentCheckbox @bind-Value="Model.AllowMultiple" />
            </li>
            <li class="form-row">
                <label class="form-label" for="def-minlen">Min Length</label>
                <FluentNumberField id="def-minlen" @bind-Value="Model.MinLength" class="form-field" />
            </li>
            <li class="form-row">
                <label class="form-label" for="def-maxlen">Max Length</label>
                <FluentNumberField id="def-maxlen" @bind-Value="Model.MaxLength" class="form-field" />
            </li>
            <li class="form-row">
                <label class="form-label" for="def-regex">Regex Pattern</label>
                <FluentTextField id="def-regex" @bind-Value="Model.RegexPattern" class="form-field" />
            </li>
        </ul>

        <DialogShellFooter Saving="@Saving"
                           Error="@Error"
                           SubmitText="@SubmitText"
                           OnCancel="HandleCancelAsync" />
    </EditForm>
</div>

@code {
    protected override string SubmitText => "Save Definition";

    private DataTypeOption? _selectedDataType = new("Text", AttributeDataType.Text);
    private ParentCodedValueOption? _selectedSourceCode;

    private readonly DataTypeOption[] _dataTypes =
    [
        new("Text", AttributeDataType.Text),
        new("Integer", AttributeDataType.Integer),
        new("Decimal", AttributeDataType.Decimal),
        new("Boolean", AttributeDataType.Boolean),
        new("Date", AttributeDataType.Date),
        new("DateTime", AttributeDataType.DateTime),
        new("Time", AttributeDataType.Time),
        new("CodedValue", AttributeDataType.CodedValue),
    ];

    private IReadOnlyList<ParentCodedValueOption> _parentCodedValues = [];

    protected override void OnModelInitialized(AttributeDefinitionFormModel model)
    {
        _parentCodedValues = (model.ParentValues ?? [])
            .Select(pv => new ParentCodedValueOption(pv.Id, pv.Code, pv.Name))
            .ToList();

        if (model.ExistingDefinition is not null)
        {
            var def = model.ExistingDefinition;
            model.Key = def.Key;
            model.DisplayName = def.DisplayName;
            model.IsRequired = def.IsRequired;
            model.AllowMultiple = def.AllowMultiple;
            model.MinLength = def.MinLength;
            model.MaxLength = def.MaxLength;
            model.RegexPattern = def.RegexPattern;
            _selectedDataType = _dataTypes.FirstOrDefault(d => d.Value == def.DataType)
                                ?? new("Text", AttributeDataType.Text);
            _selectedSourceCode = _parentCodedValues.FirstOrDefault(p => p.Code == def.SourceCode);
        }
    }

    protected override Task<AttributeDefinitionResult?> SubmitAsync(AttributeDefinitionFormModel model)
    {
        // [Required] on Key lets whitespace through, so re-check here (the
        // pre-consolidation dialog did the same).
        if (string.IsNullOrWhiteSpace(model.Key))
        {
            Error = "Key is required.";
            return Task.FromResult<AttributeDefinitionResult?>(null);
        }

        var dataType = _selectedDataType?.Value ?? AttributeDataType.Text;
        var sourceCode = _selectedSourceCode?.Code;
        return Task.FromResult<AttributeDefinitionResult?>(new AttributeDefinitionResult(
            model.Key.Trim(),
            model.DisplayName,
            dataType,
            sourceCode,
            model.IsRequired,
            model.AllowMultiple,
            model.MinLength,
            model.MaxLength,
            model.RegexPattern));
    }
}
