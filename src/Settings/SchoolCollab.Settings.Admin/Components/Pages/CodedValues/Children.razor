@page "/coded-values/{ParentCode}/children"
@inject CodedValuesApiClient Api
@inject NavigationManager Nav
@inject ILogger<Children> Logger
@inject IDialogService DialogService
@implements IDisposable

<LandingPage TItem="CodedValueDto"
             Title="@Title"
             CreateLabel="+ Add Child Value"
             CreateRoute="@CreateRoute"
             EmptyMessage="@EmptyMessage"
             Items="@_items"
             Loading="_isSearching"
             Error="@_error"
             GridSettings="@_gridSettings"
             SearchText="@_searchText"
             SearchTextChanged="@OnSearchChanged"
             SearchPlaceholder="Search children…">
    <Columns>
        <TemplateColumn TGridItem="CodedValueDto" Title="Code" SortBy="@_sortByCode" Sortable="true" TooltipText="@(x => x.Code)">
            <code>@context.Code</code>
        </TemplateColumn>
        <TemplateColumn TGridItem="CodedValueDto" Title="Name" SortBy="@_sortByName" Sortable="true" TooltipText="@(x => x.Name)">
            <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/coded-values/{Uri.EscapeDataString(context.Code)}/edit")">
                @context.Name
            </FluentAnchor>
        </TemplateColumn>
        <PropertyColumn TGridItem="CodedValueDto" TProp="string" Property="@(x => x.Description)" Title="Description" />
        <PropertyColumn TGridItem="CodedValueDto" TProp="int" Property="@(x => x.DisplayOrder)" Title="Order" Sortable="true" />
        <TemplateColumn TGridItem="CodedValueDto" Title="Status">
            @if (context.IsDisabled)
            {
                <FluentBadge Appearance="Appearance.Neutral">Disabled</FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="CodedValueDto" Title="Attributes" TooltipText="@(x => string.Join(", ", x.Attributes.Select(a => $"{a.Key}={a.Value}")))">
            @foreach (var attr in context.Attributes)
            {
                var def = _parent?.AttributeDefinitions.FirstOrDefault(d => d.Key == attr.Key);
                <FluentBadge @key="attr.Key" Appearance="Appearance.Lightweight" class="me-1">
                    @attr.Key=@attr.Value
                    @if (def?.IsRequired == true)
                    {
                        <span class="required-marker">*</span>
                    }
                </FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="CodedValueDto" Title="Actions">
            @if (context.IsDisabled)
            {
                <FluentAnchor Href="#" OnClick="@(() => ToggleAsync(context.Id, false))">Enable</FluentAnchor>
            }
            else
            {
                <FluentAnchor Href="#" OnClick="@(() => ToggleAsync(context.Id, true))">Disable</FluentAnchor>
            }
            <FluentAnchor Href="#" OnClick="@(() => OnDeleteAsync(context.Id, context.Code))" class="ms-2">Delete</FluentAnchor>
        </TemplateColumn>
    </Columns>
    <ChildContent>
        @if (_parent?.AttributeDefinitions.Count > 0)
        {
            <div class="mb-3">
                <h6>Expected Attributes</h6>
                <div class="attr-list">
                    @foreach (var def in _parent.AttributeDefinitions)
                    {
                        <FluentBadge @key="def.Key" Appearance="Appearance.Lightweight">
                            @def.Key
                            @if (!string.IsNullOrEmpty(def.DisplayName))
                            {
                                <span class="text-muted">(@def.DisplayName)</span>
                            }
                            @if (def.IsRequired)
                            {
                                <span class="required-marker"> *</span>
                            }
                            <span class="data-type">:@FormatDataType(def.DataType)</span>
                        </FluentBadge>
                    }
                </div>
            </div>
        }
    </ChildContent>
</LandingPage>

@code {
    [Parameter] public string? ParentCode { get; set; }

    private CodedValueDto? _parent;
    private CodedValueDto[]? _children;
    private CodedValueDto[]? _searchResults;
    private string? _error;
    private string? _loadedParentCode;
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _mutationCts = new();
    private volatile bool _disposed;
    private CancellationToken MutationToken => _mutationCts?.Token ?? CancellationToken.None;

    // Search state
    private string _searchText = string.Empty;
    private bool _isSearching;
    private CancellationTokenSource? _searchCts;

    // The collection rendered by LandingPage. Swaps between search results
    // and the full child list depending on whether a search is active.
    private CodedValueDto[]? _items => string.IsNullOrWhiteSpace(_searchText) ? _children : _searchResults;

    private string Title => _parent is null ? "Children" : $"{_parent.Code} — {_parent.Name}";
    private string CreateRoute => $"/coded-values/{Uri.EscapeDataString(ParentCode ?? string.Empty)}/children/new";
    private string EmptyMessage => string.IsNullOrWhiteSpace(_searchText)
        ? "No child values yet."
        : $"No children match '{_searchText}'.";

    private static readonly LandingGridSettings _gridSettings = new()
    {
        GridTemplateColumns = "120px minmax(160px,2fr) minmax(140px,2fr) minmax(50px,0.5fr) minmax(70px,1fr) minmax(140px,2fr) auto",
        MultiLine = true
    };

    private readonly GridSort<CodedValueDto> _sortByCode =
        GridSort<CodedValueDto>.ByAscending(x => x.Code);

    private readonly GridSort<CodedValueDto> _sortByName =
        GridSort<CodedValueDto>.ByAscending(x => x.Name);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ParentCode != _loadedParentCode && !_disposed)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        _children = null;
        _searchResults = null;
        _parent = null;
        _error = null;
        StateHasChanged();

        Logger.LogInformation("Loading children for parent {ParentCode}", ParentCode);
        try
        {
            _parent = await Api.GetByCodeAsync(ParentCode!, ct: ct);
            if (_parent is null)
            {
                _error = $"Coded value '{ParentCode}' not found.";
                _children = Array.Empty<CodedValueDto>();
                return;
            }
            _children = await Api.GetChildrenAsync(_parent.Id, ct) ?? Array.Empty<CodedValueDto>();
            _loadedParentCode = ParentCode;
            if (_disposed) return;
            Logger.LogInformation("Loaded parent {ParentCode} with {Count} children", ParentCode, _children.Length);
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load children for parent {ParentCode}", ParentCode);
            _error = ex.Message;
            _children = Array.Empty<CodedValueDto>();
        }
    }

    private async Task ToggleAsync(Guid id, bool disable)
    {
        if (_children is null || _parent is null) return;
        var idx = Array.FindIndex(_children, x => x.Id == id);
        if (idx < 0) return;
        var previous = _children[idx];
        _children[idx] = previous with { IsDisabled = disable };
        StateHasChanged();

        try
        {
            if (disable)
                await Api.DisableAsync(id, MutationToken);
            else
                await Api.EnableAsync(id, MutationToken);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to toggle coded value {Id}", id);
            var i = Array.FindIndex(_children, x => x.Id == id);
            if (i >= 0) _children[i] = previous; // rollback
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private static string FormatDataType(AttributeDataType dt) => dt switch
    {
        AttributeDataType.Text => "Text",
        AttributeDataType.Integer => "Integer",
        AttributeDataType.Decimal => "Decimal",
        AttributeDataType.Boolean => "Boolean",
        AttributeDataType.Date => "Date",
        AttributeDataType.DateTime => "DateTime",
        AttributeDataType.Time => "Time",
        AttributeDataType.CodedValue => "CodedValue",
        _ => dt.ToString()
    };

    private async Task OnDeleteAsync(Guid id, string code)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Are you sure you want to delete '{code}'? Items with children or SourceCode references cannot be deleted.",
            "Delete",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.DeleteAsync(id, MutationToken);
            if (_parent is not null && _children is not null)
            {
                _children = _children.Where(c => c.Id != id).ToArray();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
        catch (InvalidOperationException ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to delete coded value {Id}", id);
            _error = ex.Message;
        }
    }

    private async Task OnSearchChanged(string? text)
    {
        _searchText = text?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_searchText) || _parent is null)
        {
            _searchResults = null;
            _isSearching = false;
            StateHasChanged();
            return;
        }

        // Cancel previous in-flight search request
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        _isSearching = true;
        _searchResults = null;
        StateHasChanged();
        try
        {
            _searchResults = await Api.SearchAsync(_searchText, parentId: _parent.Id, includeDisabled: false, ct);
            if (_disposed) return;
            _isSearching = false;
            Logger.LogInformation("Search returned {Count} children for '{SearchText}'", _searchResults.Length, _searchText);
        }
        catch (OperationCanceledException)
        {
            // previous search cancelled — new one already started
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Search failed for '{SearchText}'", _searchText);
            _error = ex.Message;
            _isSearching = false;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _mutationCts?.Cancel();
        _mutationCts?.Dispose();
        _mutationCts = null;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
    }
}
