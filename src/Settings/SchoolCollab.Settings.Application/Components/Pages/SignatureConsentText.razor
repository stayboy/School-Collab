@page "/signature-consent-text"
@using SchoolCollab.Admin.Shared.Services
@inject SignatureConsentTextApiClient Api
@inject ILogger<SignatureConsentText> Logger

<PageTitle>Sign-off Consent Text</PageTitle>

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (!string.IsNullOrEmpty(_loadError))
        {
            <FluentMessageBar Intent="MessageIntent.Error">@_loadError</FluentMessageBar>
        }
        else
        {
            <FluentCard class="pa-4 mt-3">
                <h2>Guardian sign-off consent text</h2>
                <p class="text-muted">
                    Shown when guardians sign off their ward's completed assignment (WS-C2).
                    @(string.IsNullOrWhiteSpace(_consentText)
                        ? $"The built-in default consent text is currently in use: “{EmbeddedDefaultHint}”"
                        : "A tenant override is in effect — clear the text and save to restore the built-in default.")
                </p>
                <FluentTextArea Label="Consent text"
                                Placeholder="Leave empty to use the built-in default consent text"
                                MaxLength="4000"
                                Rows="6"
                                class="full-width"
                                @bind-Value="_consentText" />
                <div class="mt-3">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@_busy" OnClick="SaveAsync">
                        @(_busy ? "Saving…" : "Save")
                    </FluentButton>
                </div>
                @if (_saved)
                {
                    <FluentMessageBar Intent="MessageIntent.Success" class="mt-2">Consent text saved.</FluentMessageBar>
                }
                @if (!string.IsNullOrEmpty(_saveError))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" class="mt-2">@_saveError</FluentMessageBar>
                }
            </FluentCard>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>Local re-declaration of the embedded default (the Assignments
    /// context owns the constant — Settings.Application must not reference it).
    /// Rendered in the empty-state hint so admins know what guardians see.</summary>
    private const string EmbeddedDefaultHint =
        "By signing below I confirm I have reviewed my ward's completed work for this assignment and consent to it being recorded and finalized.";

    private bool _loading = true;
    private bool _busy;
    private bool _saved;
    private string? _loadError;
    private string? _saveError;
    private string? _consentText;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _consentText = (await Api.GetAsync())?.ConsentText ?? string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the tenant sign-off consent text");
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        _saveError = null;
        try
        {
            var text = string.IsNullOrWhiteSpace(_consentText) ? null : _consentText;
            var saved = await Api.UpsertAsync(text);
            _consentText = saved.ConsentText ?? string.Empty;
            _saved = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save the tenant sign-off consent text");
            _saveError = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }
}
