@page "/coded-values/approvals"
@using SchoolCollab.Admin.Shared.Services
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Constants
@inject CodedValuesApiClient Api
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Pending Approvals · Coded Values</PageTitle>

<div class="approvals-header">
    <h2>Pending coded-value approvals</h2>
    <p class="text-muted">
        Tenant-created provisional coded values awaiting system-wide approval. Approving
        promotes the value to a shared global blueprint (visible to all tenants); rejecting
        keeps it scoped to the requesting tenant.
    </p>
    <FluentButton Appearance="Appearance.Neutral" OnClick="ReloadAsync">Refresh</FluentButton>
</div>

@if (_error is not null)
{
    <FluentMessageBar Intent="@MessageIntent.Error">@_error</FluentMessageBar>
}

@if (_loading)
{
    <FluentProgressRing />
}
else if (_items.Length == 0)
{
    <div class="text-muted">No provisional coded values are pending approval.</div>
}
else
{
    <FluentDataGrid TGridItem="CodedValueDto" Items="@_items.AsQueryable()" GridTemplateColumns="120px 2fr 2fr 1.4fr 1fr auto">
        <TemplateColumn Title="Code">
            <code>@context.Code</code>
        </TemplateColumn>
        <TemplateColumn Title="Name">
            @context.Name
        </TemplateColumn>
        <TemplateColumn Title="Description">
            @FormatDescription(context)
        </TemplateColumn>
        <TemplateColumn Title="Requesting tenant">
            @TenantHint(context)
        </TemplateColumn>
        <TemplateColumn Title="Created">
            @context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </TemplateColumn>
        <TemplateColumn Title="Actions">
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" OnClick="@(() => OnApproveAsync(context))">Approve</FluentButton>
            <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" OnClick="@(() => OnRejectAsync(context))">Reject</FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    private CodedValueDto[] _items = Array.Empty<CodedValueDto>();
    private bool _loading = true;
    private string? _error;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Api.ListProvisionalCodedValuesAsync();
            if (_disposed) return;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task OnApproveAsync(CodedValueDto item)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Approve '{item.Code}' ({item.Name}) as a global coded value? It becomes visible to all tenants.",
            "Approve",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.ApproveProvisionalCodedValueAsync(item.Id);
            if (_disposed) return;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnRejectAsync(CodedValueDto item)
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            $"Reject '{item.Code}' ({item.Name})? It stays scoped to its requesting tenant (not deleted).",
            "Reject",
            "Cancel");
        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            await Api.RejectProvisionalCodedValueAsync(item.Id);
            if (_disposed) return;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _disposed = true;
    }

    private static string FormatDescription(CodedValueDto item) =>
        string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description;

    private static string TenantHint(CodedValueDto item) =>
        item.TenantId.HasValue ? item.TenantId.Value.ToString("N")[..8] : "—";
}
