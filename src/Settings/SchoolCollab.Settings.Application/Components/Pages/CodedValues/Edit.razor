@page "/coded-values/{Code}/edit"
@using Microsoft.FluentUI.AspNetCore.Components
@inject CodedValuesApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<Edit> Logger
@implements IDisposable

<PageTitle>Edit @_item?.Name</PageTitle>
<h2>Edit: @_item?.Code</h2>

<ErrorBoundary>
    <ChildContent>
        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (_item is not null)
        {
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form-container">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-fields">
                    <div class="form-field">
                        <FluentTextField Value="@_item.Code" Disabled="true" Label="Code" class="full-width" />
                    </div>
                    <div class="form-field required-field">
                        <FluentTextField @bind-Value="_model.Name" Label="Name *" class="full-width" />
                    </div>
                    <div class="form-field">
                        <FluentTextArea @bind-Value="_model.Description" Label="Description" Rows="2" class="full-width" />
                    </div>
                    <div class="form-field">
                        <FluentNumberField @bind-Value="_model.DisplayOrder" Label="Display Order" class="narrow-field" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error" class="mb-3">@_error</FluentMessageBar>
                }

                <div>
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" @onclick="Cancel" class="ms-2">Cancel</FluentButton>
                </div>
            </EditForm>

            @if (_item.ParentId is null)
            {
                <hr class="my-4" />
                <div class="section-header">
                    <h5 class="section-title">Attribute Definitions</h5>
                    <FluentButton Appearance="Appearance.Accent" OnClick="OpenAddDefinitionDialog">
                        + Add Definition
                    </FluentButton>
                </div>
                <p class="section-note">
                    Define metadata that child values should supply. Children inherit these definitions as their attribute schema.
                </p>

                @if (_item.AttributeDefinitions.Count > 0)
                {
                    <FluentDataGrid Items="@_item.AttributeDefinitions.AsQueryable()"
                                    GridTemplateColumns="1.2fr 1.5fr 1fr 1fr auto auto"
                                    TGridItem="CodedValueAttributeDefinitionDto"
                                    class="attr-grid">
                        <PropertyColumn Property="@(d => d.Key)" Title="Key" />
                        <PropertyColumn Property="@(d => d.DisplayName)" Title="Display Name" />
                        <TemplateColumn Title="Type">
                            @FormatDataType(context.DataType)@(context.AllowMultiple ? " (multi)" : "")
                        </TemplateColumn>
                        <TemplateColumn Title="Required">
                            @(context.IsRequired ? "Yes" : "No")
                        </TemplateColumn>
                        <TemplateColumn Title="Source">
                            @context.SourceCode
                        </TemplateColumn>
                        <TemplateColumn Title="">
                            <FluentAnchor Href="#" OnClick="@(() => EditDefinitionDialog(context))">Edit</FluentAnchor>
                            <FluentAnchor Href="#" OnClick="@(() => RemoveDefinitionAsync(context.Key))" class="ms-2">Remove</FluentAnchor>
                        </TemplateColumn>
                    </FluentDataGrid>
                }
                else
                {
                    <FluentMessageBar Intent="MessageIntent.Info" class="mt-2">No attribute definitions yet. Click "+ Add Definition" to create one.</FluentMessageBar>
                }
            }

            @if (_item.ParentId is not null)
            {
                <hr class="my-4" />
                <h5>Attributes</h5>
                @if (_item.Attributes.Count > 0)
                {
                    <FluentDataGrid Items="@_item.Attributes.AsQueryable()" GridTemplateColumns="1fr 1.5fr auto" TGridItem="CodedValueAttributeDto" class="attr-grid">
                        <PropertyColumn Property="@(a => a.Key)" />
                        <TemplateColumn Title="Value">
                            @context.Value
                        </TemplateColumn>
                        <TemplateColumn Title="">
                            @if (_editingAttrKey == context.Key)
                            {
                                <FluentAnchor Href="#" OnClick="CancelAttributeEdit">Cancel</FluentAnchor>
                            }
                            else
                            {
                                <FluentAnchor Href="#" OnClick="@(() => StartEditAttribute(context))">Edit</FluentAnchor>
                                <FluentAnchor Href="#" OnClick="@(() => RemoveAttributeAsync(context.Key))" class="ms-2">Remove</FluentAnchor>
                            }
                        </TemplateColumn>
                    </FluentDataGrid>
                }

                @if (_editingAttrKey is not null)
                {
                    var editDef = GetDefinitionForKey(_editingAttrKey);
                    <div class="attr-form-narrow">
                        <div class="attr-row">
                            <FluentTextField Value="@_editingAttrKey" ReadOnly class="flex-field" aria-label="Attribute key" />
                            @if (editDef?.DataType == AttributeDataType.Boolean)
                            {
                                <FluentSelect TOption="string"
                                              Items="@_boolOptions"
                                              @bind-SelectedOption="_editAttrValue"
                                              OptionText="@(v => v)"
                                              OptionValue="@(v => v)"
                                              class="flex-field"
                                              aria-label="Attribute value" />
                            }
                            else
                            {
                                <FluentTextField @bind-Value="_editAttrValue" class="flex-field" aria-label="Attribute value" />
                            }
                            <FluentButton Appearance="Appearance.Accent" OnClick="SaveAttributeEditAsync" Disabled="@_savingAttr">Save</FluentButton>
                        </div>
                    </div>
                }

                @if (_parent is not null && AvailableDefinitions.Count > 0)
                {
                    <div class="attr-form-narrow">
                        <div class="attr-row">
                            <FluentSelect TOption="CodedValueAttributeDefinitionDto"
                                         Items="@AvailableDefinitions"
                                         @bind-SelectedOption="_selectedAttrDef"
                                         OptionText="@(d => $"{d.Key} ({d.DisplayName ?? d.Key}: {FormatDataType(d.DataType)})")"
                                         OptionValue="@(d => d.Key)"
                                         Placeholder="Select attribute…"
                                         class="flex-field"
                                         aria-label="Attribute key" />
                            @if (_selectedAttrDef?.DataType == AttributeDataType.Boolean)
                            {
                                <FluentSelect TOption="string"
                                              Items="@_boolOptions"
                                              @bind-SelectedOption="_attrValue"
                                              OptionText="@(v => v)"
                                              OptionValue="@(v => v)"
                                              Placeholder="Value"
                                              class="flex-field"
                                              aria-label="Attribute value" />
                            }
                            else
                            {
                                <FluentTextField @bind-Value="_attrValue" Placeholder="Value" class="flex-field" aria-label="Attribute value" />
                            }
                            <FluentButton Appearance="Appearance.Outline" OnClick="AddAttributeAsync" Disabled="@(_selectedAttrDef is null)">Add</FluentButton>
                        </div>
                    </div>
                }
                else if (_parent is not null && AvailableDefinitions.Count == 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Success" class="mt-2">
                        All attribute definitions from @_parent.Code have been set.
                    </FluentMessageBar>
                }
                else if (_parent is not null)
                {
                    <FluentMessageBar Intent="MessageIntent.Info" class="mt-2">
                        No attribute definitions on parent. Define attributes on @_parent.Code first.
                    </FluentMessageBar>
                }
            }
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public string? Code { get; set; }

    private CodedValueDto? _item;
    private CodedValueDto? _parent;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private CodedValueAttributeDefinitionDto? _selectedAttrDef;
    private string? _attrValue;
    private string? _loadedCode;
    private string? _editingAttrKey;
    private string? _editAttrValue;
    private bool _savingAttr;
    private readonly CodedValueEditModel _model = new();
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _mutationCts = new();
    private volatile bool _disposed;
    private CancellationToken MutationToken => _mutationCts?.Token ?? CancellationToken.None;

    private async Task OpenAddDefinitionDialog()
    {
        if (_item is null || _mutationCts is null) return;
        var ct = MutationToken;
        var parentValues = await Api.GetRootValuesAsync(ct) ?? Array.Empty<CodedValueDto>();
        var defResult = await DialogService.ShowShellDialogAsync<AttributeDefinitionDialog, AttributeDefinitionFormModel, AttributeDefinitionResult>(
            AttributeDefinitionFormModel.ForCreate(parentValues.Where(p => p.Id != _item.Id).ToArray()),
            title: "Add Attribute Definition",
            size: DialogSize.Medium);

        if (defResult is not null)
        {
            await SaveDefinitionFromResultAsync(defResult, ct);
        }
    }

    private async Task EditDefinitionDialog(CodedValueAttributeDefinitionDto existing)
    {
        if (_item is null || _mutationCts is null) return;
        var ct = MutationToken;
        var parentValues = await Api.GetRootValuesAsync(ct) ?? Array.Empty<CodedValueDto>();
        var defResult = await DialogService.ShowShellDialogAsync<AttributeDefinitionDialog, AttributeDefinitionFormModel, AttributeDefinitionResult>(
            AttributeDefinitionFormModel.ForEdit(existing, parentValues.Where(p => p.Id != _item.Id).ToArray()),
            title: "Edit Attribute Definition",
            size: DialogSize.Medium);

        if (defResult is not null)
        {
            await SaveDefinitionFromResultAsync(defResult, ct);
        }
    }

    private async Task SaveDefinitionFromResultAsync(AttributeDefinitionResult defResult, CancellationToken ct)
    {
        if (_item is null) return;
        try
        {
            Logger.LogInformation("Saving attribute definition {Key} on coded value {Id}", defResult.Key, _item.Id);
            var req = new AttributeDefinitionRequest(
                defResult.DisplayName,
                defResult.DataType,
                defResult.SourceCode,
                defResult.IsRequired,
                defResult.AllowMultiple,
                defResult.MinLength,
                defResult.MaxLength,
                defResult.RegexPattern);

            await Api.SetAttributeDefinitionAsync(_item.Id, defResult.Key, req, ct);
            _item = await Api.GetByCodeAsync(Code!, ct: ct);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to save attribute definition {Key} on coded value {Code}", defResult.Key, Code);
            _error = ex.Message;
        }
    }

    private async Task RemoveDefinitionAsync(string key)
    {
        if (_item is null || _mutationCts is null) return;
        var ct = MutationToken;
        try
        {
            Logger.LogInformation("Removing attribute definition {Key} from coded value {Id}", key, _item.Id);
            await Api.RemoveAttributeDefinitionAsync(_item.Id, key, ct);
            _item = await Api.GetByCodeAsync(Code!, ct: ct);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to remove attribute definition {Key} from coded value {Code}", key, Code);
            _error = ex.Message;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        await LoadItemAsync(_loadCts.Token);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Code != _loadedCode && !_disposed)
        {
            _loadCts?.Cancel();
            _loadCts?.Dispose();
            _loadCts = new CancellationTokenSource();
            await LoadItemAsync(_loadCts.Token);
        }
    }

    private async Task LoadItemAsync(CancellationToken ct)
    {
        _loading = true;
        _error = null;
        _parent = null;
        Logger.LogInformation("Loading coded value {Code} for edit", Code);
        try
        {
            _item = await Api.GetByCodeAsync(Code!, ct: ct);
            _loadedCode = Code;
            if (_disposed) return;
            if (_item is not null)
            {
                // Project the DTO into the shared form model via the tested
                // on-model mapping (CodedValueEditModel.LoadFrom).
                _model.LoadFrom(_item);

                // Load parent for attribute definitions dropdown
                if (_item.ParentId.HasValue && _item.ParentCode is not null)
                {
                    _parent = await Api.GetByCodeAsync(_item.ParentCode, ct: ct);
                    if (_disposed) return;
                    // Pre-select first available definition not already set on the child
                    _selectedAttrDef = _parent?.AttributeDefinitions
                        .FirstOrDefault(d => !_item!.Attributes.Any(a => a.Key.Equals(d.Key, StringComparison.OrdinalIgnoreCase)));
                }
            }
        }
        catch (OperationCanceledException)
        {
            // user navigated away
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load coded value {Code}", Code);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed)
            {
                _loading = false;
            }
        }
    }

    private async Task SubmitAsync()
    {
        if (_item is null || _mutationCts is null) return;
        var ct = MutationToken;
        _saving = true;
        _error = null;

        try
        {
            Logger.LogInformation("User initiated update for coded value {Code}", Code);
            await Api.UpdateAsync(_item.Id, new UpdateCodedValueRequest(_model.Name!, _model.Description, _model.DisplayOrder), ct);
            Nav.NavigateTo(_item.ParentId.HasValue
                ? $"/coded-values/{Uri.EscapeDataString(_item.ParentCode ?? Code!)}/children"
                : "/coded-values");
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to save coded value {Code}", Code);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private static readonly string[] _boolOptions = ["True", "False"];

    private CodedValueAttributeDefinitionDto? GetDefinitionForKey(string key) =>
        _parent?.AttributeDefinitions.FirstOrDefault(d =>
            d.Key.Equals(key, StringComparison.OrdinalIgnoreCase));

    private void StartEditAttribute(CodedValueAttributeDto attr)
    {
        _editingAttrKey = attr.Key;
        _editAttrValue = attr.Value;
        _error = null;
    }

    private void CancelAttributeEdit()
    {
        _editingAttrKey = null;
        _editAttrValue = null;
    }

    private async Task SaveAttributeEditAsync()
    {
        if (_item is null || _editingAttrKey is null || string.IsNullOrWhiteSpace(_editAttrValue) || _mutationCts is null)
            return;
        var ct = MutationToken;
        _savingAttr = true;

        try
        {
            Logger.LogInformation("Updating attribute {Key} on coded value {Code}", _editingAttrKey, Code);
            await Api.SetAttributeAsync(_item.Id, _editingAttrKey, _editAttrValue.Trim(), ct);
            _item = await Api.GetByCodeAsync(Code!, ct: ct);
            if (_disposed) return;
            _editingAttrKey = null;
            _editAttrValue = null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to update attribute {Key} on coded value {Code}", _editingAttrKey, Code);
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _savingAttr = false;
        }
    }

    private async Task AddAttributeAsync()
    {
        if (_item is null || _selectedAttrDef is null || string.IsNullOrWhiteSpace(_attrValue) || _mutationCts is null)
            return;
        var ct = MutationToken;

        try
        {
            await Api.SetAttributeAsync(_item.Id, _selectedAttrDef.Key.Trim(), _attrValue.Trim(), ct);
            _item = await Api.GetByCodeAsync(Code!, ct: ct);
            if (_disposed) return;
            // Reset selection — pick next available definition
            _selectedAttrDef = _parent?.AttributeDefinitions
                .FirstOrDefault(d => !_item!.Attributes.Any(a => a.Key.Equals(d.Key, StringComparison.OrdinalIgnoreCase)));
            _attrValue = null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to add attribute {Key} to coded value {Code}", _selectedAttrDef?.Key, Code);
            _error = ex.Message;
        }
    }

    private async Task RemoveAttributeAsync(string key)
    {
        if (_item is null || _mutationCts is null) return;
        var ct = MutationToken;
        try
        {
            await Api.RemoveAttributeAsync(_item.Id, key, ct);
            _item = await Api.GetByCodeAsync(Code!, ct: ct);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to remove attribute {Key} from coded value {Code}", key, Code);
            _error = ex.Message;
        }
    }

    private IReadOnlyList<CodedValueAttributeDefinitionDto> AvailableDefinitions =>
        _parent?.AttributeDefinitions
            .Where(d => !(_item?.Attributes.Any(a => a.Key.Equals(d.Key, StringComparison.OrdinalIgnoreCase)) ?? false))
            .ToList() ?? [];

    private static string FormatDataType(AttributeDataType dt) => dt switch
    {
        AttributeDataType.Text => "Text",
        AttributeDataType.Integer => "Integer",
        AttributeDataType.Decimal => "Decimal",
        AttributeDataType.Boolean => "Boolean",
        AttributeDataType.Date => "Date",
        AttributeDataType.DateTime => "DateTime",
        AttributeDataType.Time => "Time",
        AttributeDataType.CodedValue => "CodedValue",
        _ => dt.ToString()
    };

    private void Cancel() =>
        Nav.NavigateTo(_item?.ParentId.HasValue == true
            ? $"/coded-values/{Uri.EscapeDataString(_item!.ParentCode ?? Code!)}/children"
            : "/coded-values");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _mutationCts?.Cancel();
        _mutationCts?.Dispose();
        _mutationCts = null;
    }

}
