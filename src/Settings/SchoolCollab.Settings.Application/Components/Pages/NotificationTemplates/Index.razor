@page "/notification-templates"
@using SchoolCollab.Admin.Shared.Components.Landing
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Core.Notifications
@inject NotificationTemplateApiClient Api
@inject VisibleTenantService Tenants
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ILogger<Index> Logger
@implements IDisposable

@*
   Notification-template landing (redesign spec 3.2): the repo's landing shape - the shared wrapper (which
   IS the entity grid), a create action in the standard place, and a row kebab for secondary actions.

   Columns: the kind banner, the OWNER (System badge or the tenant's name - spec 3.7), the preferred mode
   of contact, the generated CODE (a dash when a pre-upgrade row has none, naming spec D7), the template
   itself — the TITLE as the link, the description as a muted second line (D3/D4) — the constraint count (a
   link opening the ONE read-only constraints dialog; the scope's default badge at zero) and the last change.

   Scope: a tenant session sees its own rows plus the system blueprint, and may adopt a system row. A
   system-scope session sees the blueprint plus - through includeTenantOwned - every tenant's rows, and
   may publish one portal-wide (spec 3.6/3.8). Row actions are therefore scope-gated, not hidden by luck.
*@
<PageTitle>Notification Templates</PageTitle>

<LandingPage TItem="TenantNotificationTemplateDto"
             Title="Notification Templates"
             CreateLabel="+ New Template"
             CreateRoute="@CreateHref"
             EmptyMessage="@CurrentEmptyMessage"
             Items="@DisplayItems"
             Error="@_error"
             Loading="@_loading"
             GridSettings="@_gridSettings"
             SearchText="@_search"
             SearchTextChanged="@OnSearchChanged"
             SearchPlaceholder="Search templates..."
             RowActions="@BuildRowActions"
             RowActionsAriaLabel="Template actions"
             RowActionsUseMenuService="false">
    @* Spec 3.2: an arrival through the grade-detail deep link is a FILTERED landing, and a filter with
       no name is indistinguishable from missing rows. The bar names it; the button widens the view
       again. It rides the wrapper's ContextBar so the wrapper keeps owning its chrome. *@
    <ContextBar>
        @if (_gradeFilter is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Info" class="mb-2" id="template-grade-filter-bar">
                <span>
                    Filtered to one grade level — only templates whose constraints can apply to that grade
                    are listed.
                </span>
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              Id="template-grade-filter-clear"
                              OnClick="ClearGradeFilter">
                    Show all templates
                </FluentButton>
            </FluentMessageBar>
        }
    </ContextBar>
    <ToolbarFilters>
        <span class="template-filter">
            <DropdownComponent TItem="FilterOption" TValue="string"
                               Items="KindFilterOptions"
                               SelectedValue="@_kindFilter"
                               SelectedValueChanged="OnKindFilterChanged"
                               OptionText="@(o => o.Label)"
                               OptionValue="@(o => o.Value)"
                               AriaLabel="Filter by type" />
        </span>
        <span class="template-filter">
            <DropdownComponent TItem="FilterOption" TValue="string"
                               Items="ModeFilterOptions"
                               SelectedValue="@_modeFilter"
                               SelectedValueChanged="OnModeFilterChanged"
                               OptionText="@(o => o.Label)"
                               OptionValue="@(o => o.Value)"
                               AriaLabel="Filter by contact mode" />
        </span>
        <span class="template-filter">
            <DropdownComponent TItem="FilterOption" TValue="string"
                               Items="OwnerFilterOptions"
                               SelectedValue="@_ownerFilter"
                               SelectedValueChanged="OnOwnerFilterChanged"
                               OptionText="@(o => o.Label)"
                               OptionValue="@(o => o.Value)"
                               AriaLabel="Filter by owner" />
        </span>
    </ToolbarFilters>
    <Columns>
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Type" SortBy="@_sortByKind" Sortable="true">
            <NotificationTemplateKindBanner Kind="context.Kind" />
        </TemplateColumn>
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Owner" SortBy="@_sortByOwner" Sortable="true">
            @if (context.IsSystem)
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative">System</FluentBadge>
            }
            else
            {
                <span class="template-owner">@context.OwnerName</span>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Contact mode" SortBy="@_sortByChannel" Sortable="true">
            @EnumLabels.For(context.Channel)
        </TemplateColumn>
        @* Naming spec D7: the generated reference, shown read-only — a dash where a pre-upgrade row has none. *@
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Code" SortBy="@_sortByCode" Sortable="true">
            <span class="template-code">@CodeOf(context)</span>
        </TemplateColumn>
        @* D3/D4: the template cell is the TITLE (the row's identity), with the description as a muted
           second line so the grid can be scanned for meaning rather than guessed at. *@
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Template" SortBy="@_sortByTitle" Sortable="true">
            <div class="template-cell">
                <FluentLink Appearance="LinkAppearance.Default" Href="@($"/notification-templates/{context.Id:D}")">
                    @TitleOf(context)
                </FluentLink>
                @if (!string.IsNullOrWhiteSpace(context.Description))
                {
                    <span class="template-cell__description">@context.Description</span>
                }
            </div>
        </TemplateColumn>
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Constraints" SortBy="@_sortByConstraintCount" Sortable="true">
            @if (context.Constraints.Count == 0)
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">@DefaultBadgeLabel(context)</FluentBadge>
            }
            else
            {
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              Class="template-constraints-link"
                              Title="View every constraint on this template"
                              OnClick="@(() => OpenConstraintsAsync(context))">
                    @ConstraintCountLabel(context)
                </FluentButton>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="TenantNotificationTemplateDto" Title="Updated" SortBy="@_sortByUpdatedAt" Sortable="true">
            @context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </TemplateColumn>
    </Columns>
</LandingPage>
@code {
    private static readonly LandingGridSettings _gridSettings = new()
    {
        // One track per rendered column, INCLUDING the Actions column LandingPage appends
        // (blazor-components.md rule 7 / adr-authoring-surface-pattern decision 2).
        GridTemplateColumns =
            "minmax(110px,1fr) minmax(110px,1fr) 110px 90px minmax(200px,2fr) minmax(120px,1fr) 150px auto",
    };

    private readonly GridSort<TenantNotificationTemplateDto> _sortByKind =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.Kind);
    private readonly GridSort<TenantNotificationTemplateDto> _sortByOwner =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.OwnerName);
    private readonly GridSort<TenantNotificationTemplateDto> _sortByChannel =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.Channel);
    private readonly GridSort<TenantNotificationTemplateDto> _sortByCode =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.Code);
    private readonly GridSort<TenantNotificationTemplateDto> _sortByTitle =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.Title);
    private readonly GridSort<TenantNotificationTemplateDto> _sortByConstraintCount =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.Constraints.Count);
    private readonly GridSort<TenantNotificationTemplateDto> _sortByUpdatedAt =
        GridSort<TenantNotificationTemplateDto>.ByAscending(t => t.UpdatedAt);

    public sealed record FilterOption(string Value, string Label);

    private static readonly FilterOption[] KindFilterOptions =
    [
        new(string.Empty, "All types"),
        .. Enum.GetValues<NotificationTemplateKind>().Select(k => new FilterOption(k.ToString(), k.ToString())),
    ];

    private static readonly FilterOption[] ModeFilterOptions =
    [
        new(string.Empty, "All contact modes"),
        new(NotificationChannel.Email.ToString(), "Email"),
        new(NotificationChannel.SMS.ToString(), "SMS"),
        new(NotificationChannel.WhatsApp.ToString(), "WhatsApp"),
    ];

    private static readonly FilterOption[] OwnerFilterOptions =
    [
        new(string.Empty, "All owners"),
        new(TemplateLandingFilter.SystemOwner, "System"),
        new(TemplateLandingFilter.TenantOwner, "This tenant"),
    ];

    /// <summary>The grade-detail deep link (spec 3.11): filters the rows and travels into Create.</summary>
    [SupplyParameterFromQuery(Name = "grade")]
    public string? Grade { get; set; }

    private TenantNotificationTemplateDto[]? _items;
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private string _kindFilter = string.Empty;
    private string _modeFilter = string.Empty;
    private string _ownerFilter = string.Empty;
    private Guid? _gradeFilter;

    /// <summary>
    /// Aborts the in-flight list read when the circuit navigates away (blazor-components.md
    /// § "Landing-page performance pattern", rule 3).
    /// </summary>
    private CancellationTokenSource? _loadCts;

    /// <summary>Set FIRST in <see cref="Dispose"/> so a racing continuation sees it before it writes state.</summary>
    private volatile bool _disposed;

    /// <summary>
    /// The token every dispatched mutation carries (blazor-components.md, "Mutations take a token too"):
    /// a delete/adopt/promote must not outlive the circuit that asked for it.
    /// </summary>
    private CancellationToken MutationToken => _loadCts?.Token ?? CancellationToken.None;

    /// <summary>True when the session has no real tenant - it edits the system blueprint (spec 3.7).</summary>
    private bool _sessionIsSystem = true;

    private string CreateHref => _gradeFilter is { } grade
        ? $"/notification-templates/create?grade={grade:D}"
        : "/notification-templates/create";

    private string CurrentEmptyMessage =>
        _items is { Length: > 0 }
            ? "No templates match the current filter."
            : "No notification templates. The built-in defaults apply until one is created.";

    /// <summary>The rows after the filters and the search - the grid's source (the pure filter seam).</summary>
    private TenantNotificationTemplateDto[] DisplayItems =>
        _items is null
            ? []
            : TemplateLandingFilter.Apply(
                _items, _gradeFilter, _kindFilter, _modeFilter, _ownerFilter, _search);
    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();

        if (Guid.TryParse(Grade, out var grade) && grade != Guid.Empty)
            _gradeFilter = grade;

        // The session scope decides what this page may DO (adopt vs publish portal-wide, spec 3.2);
        // it comes from the tenant_id claim, not from the rows themselves.
        var scope = await Tenants.GetScopeAsync();
        if (_disposed)
            return;

        _sessionIsSystem = !scope.IsRealTenant;

        await ReloadAsync();
    }

    /// <summary>
    /// Re-reads the list. In system scope the read asks for tenant-owned rows too (spec 3.6) - that is
    /// what gives "Publish portal-wide" a source row; a tenant session never sees another tenant's row.
    /// <para>
    /// The token is the page's own: navigating away cancels the HTTP read, and every post-await write is
    /// guarded by <see cref="_disposed"/> (blazor-components.md, rule 3).
    /// </para>
    /// </summary>
    private async Task ReloadAsync()
    {
        var token = _loadCts?.Token ?? CancellationToken.None;

        try
        {
            var rows = await Api.ListAsync(_sessionIsSystem, token);
            if (_disposed)
                return;

            _items = rows.ToArray();
            _error = null;
        }
        catch (OperationCanceledException)
        {
            // The circuit navigated away — the CTS, not a failure.
        }
        catch (Exception ex)
        {
            if (_disposed)
                return;

            Logger.LogError(ex, "Failed to load notification templates");
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed)
                _loading = false;
        }
    }

    /// <summary>Releases the load token when the circuit unmounts (rule 3).</summary>
    public void Dispose()
    {
        _disposed = true;          // FIRST: a racing continuation checks it before writing state.
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }

    private void OnKindFilterChanged(string? value)
    {
        _kindFilter = value ?? string.Empty;
        StateHasChanged();
    }

    private void OnModeFilterChanged(string? value)
    {
        _modeFilter = value ?? string.Empty;
        StateHasChanged();
    }

    private void OnOwnerFilterChanged(string? value)
    {
        _ownerFilter = value ?? string.Empty;
        StateHasChanged();
    }

    private void OnSearchChanged(string? value)
    {
        _search = value?.Trim() ?? string.Empty;
        StateHasChanged();
    }

    /// <summary>
    /// Widens the grade-filtered view again (spec 3.2). The query string keeps <c>?grade=</c> — that is
    /// what the deep link is — but the page stops applying it, which is what the click promises.
    /// </summary>
    private void ClearGradeFilter()
    {
        _gradeFilter = null;
        StateHasChanged();
    }

    /// <summary>
    /// Opens the row a copy action returned. <see cref="NavigationManager.NavigateTo(string)"/> is void,
    /// so this is the <see cref="Task"/> the shared error wrapper awaits.
    /// </summary>
    private Task NavigateToRowAsync(Guid id)
    {
        Navigation.NavigateTo($"/notification-templates/{id:D}");
        return Task.CompletedTask;
    }

    /// <summary>
    /// The row kebab (spec 3.2). Scope gates every action: a tenant session may adopt a system row and
    /// reset its OWN rows; a system session may publish a tenant row portal-wide and reset blueprint
    /// rows. An action that the server would 403 is never offered.
    /// </summary>
    private IReadOnlyList<RowAction> BuildRowActions(TenantNotificationTemplateDto row)
    {
        var actions = new List<RowAction>
        {
            RowAction.Navigate("Open", $"/notification-templates/{row.Id:D}"),
        };

        if (row.IsSystem && !_sessionIsSystem)
        {
            actions.Add(RowAction.Callback("Adopt to this tenant", () => AdoptAsync(row)));
        }

        if (!row.IsSystem && _sessionIsSystem)
        {
            actions.Add(RowAction.Callback("Publish portal-wide...", () => PromoteAsync(row)));
        }

        if (row.IsSystem == _sessionIsSystem)
        {
            actions.Add(RowAction.Separator());
            // Not flagged Destructive: the kebab would then ask for confirmation twice (its own prompt,
            // then the reason dialog), and the reason dialog IS the destructive confirmation.
            actions.Add(RowAction.Callback("Reset to built-in default...", () => ResetAsync(row)));
        }

        return actions;
    }

    /// <summary>The zero-constraint badge names the SCOPE, not just "tenant" (spec 3.2).</summary>
    private static string DefaultBadgeLabel(TenantNotificationTemplateDto row) =>
        row.IsSystem ? "System default" : "Tenant default";

    /// <summary>
    /// The row's identity label (naming spec D3): its title, with the pre-naming chain kept only as a last
    /// resort so a payload that omits the field never renders an empty cell.
    /// </summary>
    private static string TitleOf(TenantNotificationTemplateDto row) => TemplateTitles.For(
        row.Title, row.Subject, row.Body, $"{row.Kind} · {EnumLabels.For(row.Channel)}");

    /// <summary>The generated reference (D7), or the dash that marks a row which predates the code column.</summary>
    private static string CodeOf(TenantNotificationTemplateDto row) =>
        string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code!;

    private static string ConstraintCountLabel(TenantNotificationTemplateDto row) =>
        row.Constraints.Count == 1 ? "1 constraint" : $"{row.Constraints.Count} constraints";

    /// <summary>The ONE read-only constraints dialog (spec 3.6/3.8), shared with the detail panel.</summary>
    private async Task OpenConstraintsAsync(TenantNotificationTemplateDto row)
    {
        await DialogService.ShowReadonlyDialogAsync<TemplateConstraintsDialog>(
            $"{row.Kind} - {EnumLabels.For(row.Channel)}",
            new Dictionary<string, object?>
            {
                [TemplateConstraintsDialog.ConstraintsKey] = row.Constraints,
                [TemplateConstraintsDialog.TemplateLabelKey] = TitleOf(row),
            });
    }

    /// <summary>
    /// Adopt (spec 3.8): copies the system row into this tenant, then opens the copy - the operator
    /// lands on the row they now own instead of the read-only blueprint row they came from.
    /// </summary>
    private async Task AdoptAsync(TenantNotificationTemplateDto row)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            $"Adopt '{TitleOf(row)}' into this tenant? The copy is independent of the system blueprint: "
            + "later blueprint edits do not reach it.",
            "Adopt",
            title: "Adopt template");

        if (!confirmed)
            return;

        await RunAsync(
            () => Api.AdoptAsync(row.Id, $"Adopted from the system blueprint: {TitleOf(row)}", MutationToken),
            copy => NavigateToRowAsync(copy.Id),
            "adopt");
    }

    /// <summary>Publish portal-wide (spec 3.8): copies a tenant row into the blueprint, then opens it.</summary>
    private async Task PromoteAsync(TenantNotificationTemplateDto row)
    {
        var confirmed = await DialogService.ShowConfirmDialogAsync(
            $"Publish '{TitleOf(row)}' portal-wide? Every tenant will see it unless it owns an override; "
            + $"the Copy stays owned by {row.OwnerName} and is not modified.",
            "Publish",
            title: "Publish portal-wide");

        if (!confirmed)
            return;

        await RunAsync(
            () => Api.PromoteAsync(row.Id, $"Published portal-wide from {row.OwnerName}: {TitleOf(row)}", MutationToken),
            copy => NavigateToRowAsync(copy.Id),
            "publish portal-wide");
    }

    /// <summary>
    /// Reset (spec 3.2/3.5): the reason dialog is the confirmation - resetting removes the row and the
    /// built-in default applies again, and the operator's own words land in the audit trail.
    /// <para>
    /// Optimistic (blazor-components.md § "Landing-page performance pattern", rule 2): the row leaves
    /// the in-memory list and the grid re-renders, then the delete is dispatched. A failure restores the
    /// previous array. It never re-reads the list, which would reset the operator's sort and scroll.
    /// </para>
    /// </summary>
    private async Task ResetAsync(TenantNotificationTemplateDto row)
    {
        // D11: the shared reason dialog replaces the retired single-purpose reset prompt — the same dialog
        // the editor opens on save, and the reset's only confirmation.
        var reason = await DialogService.ShowReasonDialogAsync(
            new ReasonDialog.ReasonFormModel(
                "Resetting removes this template: the built-in default applies again. The reason is "
                + "recorded in the audit trail.",
                "Reset",
                "Resetting..."),
            $"Reset '{TitleOf(row)}'");

        if (reason is null)
            return;

        var previous = _items;
        if (_items is not null)
        {
            _items = TemplateLandingRows.WithoutReset(_items, row.Id);
            StateHasChanged();
        }

        try
        {
            await Api.DeleteAsync(row.Id, reason, MutationToken);
        }
        catch (OperationCanceledException)
        {
            // The circuit navigated away.
        }
        catch (Exception ex)
        {
            if (_disposed)
                return;

            _items = previous;   // rollback: the server still has the row.
            Logger.LogError(ex, "Failed to reset notification template {TemplateId}", row.Id);
            _error = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Shared error posture: the operator sees the server's message, never a silent no-op.
    /// <para>
    /// <paramref name="onSuccess"/> is a <see cref="Func{T, Task}"/>, not an <see cref="Action{T}"/>: an
    /// async lambda converted to <c>Action&lt;T&gt;</c> is <c>async void</c>, so its exception would be
    /// unobservable here and the follow-up work would not be awaited before the action reported done.
    /// </para>
    /// </summary>
    private async Task RunAsync<T>(
        Func<Task<T>> action, Func<T, Task> onSuccess, string verb)
    {
        try
        {
            var result = await action();
            await onSuccess(result);
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to {Verb} notification template", verb);
            _error = ex.Message;
        }
    }
}
