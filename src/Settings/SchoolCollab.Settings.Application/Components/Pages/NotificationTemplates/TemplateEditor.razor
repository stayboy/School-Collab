@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Authoring
@using SchoolCollab.Admin.Shared.Components.RichText
@using SchoolCollab.Admin.Shared.Constants
@using SchoolCollab.Core.Notifications
@using SchoolCollab.Core.RichText
@inject NotificationTemplateApiClient Api
@inject NotificationTemplatePreviewClient Preview
@inject StudentsLookupClient Students
@inject CodedValuesApiClient CodedValues
@inject VisibleTenantService Tenants
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ILogger<TemplateEditor> Logger
@implements IDisposable
@*
   The shared template editor (redesign spec §3.3–§3.6; naming spec D9–D12). One component, two modes —
   Create and Edit — so the two surfaces cannot drift (the AssignmentAuthoring precedent).

   Composition (naming spec D10): the LEFT column is a titled panel too, so the surface now has three
   bounded panels — **Message** on the left, **Constraints** and **Preview** stacked in the rail — all
   wearing the shared PanelSection chrome. The audit trail (edit mode) keeps its own plain heading BELOW
   the grid: it is a section, not a panel.

   Staging contract (Q9): the title, description, type, subject, body and chips only mutate the draft; ONE
   Save persists them with one audited reason — asked for in the shared reason dialog when editing a row,
   and never sent on create, where a first write has no "why" (naming spec D11). Resetting is the detail
   page's separate audited action and uses the same dialog.
*@
<ErrorBoundary>
    <ChildContent>
        <AuthoringShell Crumbs="@ShellCrumbs"
                       TitleContent="@ShellTitle"
                       PrimaryId="@(ReadOnly ? "template-adopt" : "template-save")"
                       PrimaryLabel="@ShellPrimaryLabel"
                       PrimaryDisabled="@ShellPrimaryDisabled"
                       OnPrimaryAction="OnShellPrimaryAsync"
                       SecondaryActions="@ShellSecondaryActions">
        @if (_loading)
        {
            <div class="template-editor__loading"><FluentSpinner /></div>
        }
        else if (_notFound)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">Template not found.</FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Outline" class="mt-2" OnClick="BackToListAsync">Back</FluentButton>
        }
        else
        {
            @if (ReadOnly)
            {
                <FluentMessageBar Intent="MessageBarIntent.Info" class="mb-2" id="template-editor-readonly">
                    @ReadOnlyReason
                </FluentMessageBar>
            }

            @if (_lookups?.Error is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2" id="template-lookup-warning">
                    Constraint names are unavailable (@_lookups.Error) — stored values are shown instead.
                </FluentMessageBar>
            }

            <div class="template-editor-layout">
                <div class="template-editor-message-panel">
                    <PanelSection Title="Message"
                                  Id="template-editor-message"
                                  TitleId="template-editor-message-title">
                        <ChildContent>
                            <FormRow Label="Title" Required For="template-title">
                                <FluentTextInput Id="template-title"
                                                 Class="w-9"
                                                 MaxLength="120"
                                                 Value="@_model.Title"
                                                 ValueChanged="OnTitleChanged"
                                                 Immediate="true"
                                                 Disabled="@ReadOnly"
                                                 Placeholder="A name you will recognise — e.g. Grade 8 Science reminder" />
                            </FormRow>

                            @* Naming spec D6/D7, stories 10–12: the generated reference, shown read-only beside
                               the name it belongs to. It is minted on save, so a create draft shows a dash
                               and says where the code comes from — the field is never an input. *@
                            <FormRow Label="Code" For="template-code">
                                <FluentTextInput Id="template-code"
                                                 Class="w-4"
                                                 Value="@CodeDisplay"
                                                 Disabled="true"
                                                 ReadOnly="true"
                                                 AriaLabel="Template code (generated)" />
                                <p class="template-editor-hint" id="template-code-hint">@CodeHint</p>
                            </FormRow>

                            <FormRow Label="Description" For="template-description">
                                <FluentTextArea Id="template-description"
                                                Class="w-9"
                                                MaxLength="500"
                                                Value="@_model.Description"
                                                ValueChanged="OnDescriptionChanged"
                                                Immediate="true"
                                                Disabled="@ReadOnly"
                                                Placeholder="What this template is for (optional)" />
                            </FormRow>

                            @* D9: type and preferred mode of contact are ONE decision, so they share one
                               labelled row; the "fixed per template" rule moved from a paragraph into the
                               row label's help hint. *@
                            <FormRow Label="Template Type" Required Help="@TemplateTypeHelp">
                                <DropdownComponent TItem="KindOption" TValue="NotificationTemplateKind"
                                                   Items="KindOptions"
                                                   SelectedValue="@_model.Kind"
                                                   SelectedValueChanged="OnKindChanged"
                                                   OptionText="@(o => o.Label)"
                                                   OptionValue="@(o => o.Value)"
                                                   AriaLabel="Template type"
                                                   Disabled="@LockedMeta"
                                                   Width="FieldWidth.W4" />
                                <DropdownComponent TItem="ChannelOption" TValue="NotificationChannel"
                                                   Items="ChannelOptions"
                                                   SelectedValue="@_model.Channel"
                                                   SelectedValueChanged="OnChannelChanged"
                                                   OptionText="@(o => o.Label)"
                                                   OptionValue="@(o => o.Value)"
                                                   AriaLabel="Preferred mode of contact"
                                                   Disabled="@LockedMeta"
                                                   Width="FieldWidth.W4" />
                            </FormRow>

                            @if (_model.Channel == NotificationChannel.Email)
                            {
                                <FormRow Label="Subject" For="template-subject">
                                    <FluentTextInput Id="template-subject"
                                                     Class="w-9"
                                                     Value="@_model.Subject"
                                                     ValueChanged="OnSubjectChanged"
                                                     Immediate="true"
                                                     Disabled="@ReadOnly"
                                                     Placeholder="Subject line (tags allowed)" />
                                </FormRow>
                            }

                            <FormRow Label="Body" Required For="@BodyInputId" AlignTop>
                                @if (_model.Channel == NotificationChannel.Email)
                                {
                                    <RichInstructionEditor @ref="_editor"
                                                           Id="template-body-editor"
                                                           Value="@_model.Body"
                                                           ReadOnly="@ReadOnly"
                                                           MinHeight="@BodyEditorMinHeight"
                                                           Placeholder="Write the message body..." />
                                }
                                else
                                {
                                    <FluentTextArea Id="template-body-text"
                                                    Label="Message"
                                                    Class="w-9 ta-lines-8"
                                                    Value="@_model.Body"
                                                    ValueChanged="OnBodyChanged"
                                                    Immediate="true"
                                                    Disabled="@ReadOnly" />
                                }
                            </FormRow>

                            <div class="template-editor-tags" id="template-tag-chips">
                                @foreach (var tag in NotificationTemplateTags.All)
                                {
                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                  Disabled="@ReadOnly"
                                                  Title="@($"Insert {{{{{tag}}}}}")"
                                                  OnClick="@(() => InsertTag(tag))">
                                        @($"{{{tag}}}")
                                    </FluentButton>
                                }
                            </div>

                            @if (_model.Channel != NotificationChannel.Email)
                            {
                                <p class="template-editor-hint" id="template-length-hint">@LengthHint</p>
                            }
                        </ChildContent>
                    </PanelSection>
                </div>

                <div class="template-editor-rail" id="template-editor-rail">
                    <PanelSection Title="Constraints" TitleId="template-constraints-title">
                        <HeaderActions>
                            @if (!ReadOnly)
                            {
                                <RowActionsMenu UseMenuService="false"
                                                ForceKebab="true"
                                                Actions="@ConstraintActions"
                                                AriaLabel="Add a constraint" />
                            }
                        </HeaderActions>

                        <ChildContent>
                            @if (_model.Constraints.Count == 0)
                            {
                                <p class="template-editor-panel__empty" id="template-constraints-empty">
                                    No constraints — this template is the default for its type and contact mode.
                                </p>
                            }
                            else
                            {
                                <div class="entity-grid-chips" id="template-constraints-chips">
                                    @foreach (var constraint in _model.Constraints.ToArray())
                                    {
                                        <Chip Label="@Display(constraint)"
                                              Subtitle="@TemplateConstraintLookups.DimensionLabel(constraint.Dimension)"
                                              DismissTitle="Remove this constraint"
                                              OnDismiss="@(ReadOnly
                                                  ? default(EventCallback)
                                                  : EventCallback.Factory.Create(this, () => RemoveConstraint(constraint)))" />
                                    }
                                </div>
                            }

                            @if (ConflictWarning is not null)
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mt-2" id="template-conflict-warning">
                                    @ConflictWarning
                                </FluentMessageBar>
                            }

                            @* D12: past this many constraints the chip row stops being scannable, so the
                               full list earns its one link. The chips themselves stay unbounded. *@
                            @if (_model.Constraints.Count > ConstraintViewAllThreshold)
                            {
                                <div class="template-editor-panel__actions">
                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                  Id="template-constraints-view-all"
                                                  OnClick="OpenConstraintListAsync">
                                        View all constraints
                                    </FluentButton>
                                </div>
                            }
                        </ChildContent>
                    </PanelSection>

                    <PanelSection Title="Preview" TitleId="template-preview-title">
                        <ChildContent>
                            <div class="template-editor-preview" id="template-preview-body">
                                @if (_previewUnavailable)
                                {
                                    <p class="template-editor-hint" id="template-preview-note">
                                        Preview unavailable (@_previewError). Saving still works.
                                    </p>
                                }
                                else
                                {
                                    @if (_model.Channel == NotificationChannel.Email && !string.IsNullOrWhiteSpace(_previewSubject))
                                    {
                                        <p class="template-editor-preview__subject" id="template-preview-subject">@_previewSubject</p>
                                    }
                                    @if (_model.Channel == NotificationChannel.Email)
                                    {
                                        <RichInstruction Value="@_previewBody" Id="template-preview-rendered" />
                                    }
                                    else
                                    {
                                        <p class="template-editor-preview__plain" id="template-preview-rendered">@_previewBody</p>
                                    }
                                }
                            </div>
                            <div class="template-editor-preview__actions">
                                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="OnRefreshPreviewAsync" id="template-preview-refresh">
                                    Refresh
                                </FluentButton>
                            </div>
                        </ChildContent>
                    </PanelSection>
                </div>
            </div>

            @if (Mode == TemplateEditorMode.Edit)
            {
                <section class="template-editor-audit" id="template-audit-section">
                    <h2 class="template-editor-audit__title">Audit trail</h2>
                    @if (_audit.Count == 0)
                    {
                        <p class="template-editor-hint" id="template-audit-empty">No changes recorded for this template yet.</p>
                    }
                    else
                    {
                        <div id="template-audit-grid">
                            <FluentDataGrid Items="@_audit.AsQueryable()"
                                            GridTemplateColumns="150px minmax(120px,1fr) 110px minmax(180px,2fr)"
                                            TGridItem="NotificationTemplateAuditEntryDto">
                                <TemplateColumn TGridItem="NotificationTemplateAuditEntryDto" Title="When">
                                    @context.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </TemplateColumn>
                                <TemplateColumn TGridItem="NotificationTemplateAuditEntryDto" Title="Actor">
                                    @context.ActorDisplayName
                                </TemplateColumn>
                                <TemplateColumn TGridItem="NotificationTemplateAuditEntryDto" Title="Change">
                                    @context.ChangeKind
                                </TemplateColumn>
                                <TemplateColumn TGridItem="NotificationTemplateAuditEntryDto" Title="Reason">
                                    @context.Reason
                                </TemplateColumn>
                            </FluentDataGrid>
                        </div>
                    }
                </section>
            }
            @if (_error is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-2" id="template-editor-error">@_error</FluentMessageBar>
            }
            @if (_message is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Success" class="mt-2" id="template-editor-message-bar">@_message</FluentMessageBar>
            }
        }
        </AuthoringShell>
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageBarIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>


@code {
    private const int SmsWarnLength = 140;
    private const int SmsLimit = 160;

    /// <summary>
    /// D12: "View all constraints" earns its place only past this many constraints — below it the link
    /// would only duplicate the chip row beside it.
    /// </summary>
    private const int ConstraintViewAllThreshold = 5;

    /// <summary>
    /// D10: the message editor's minimum height. Tall enough that the largest input on the page is not the
    /// smallest box on it, and short enough that the message panel stays level with the
    /// Constraints/Preview rail on a 1920×1080 screen and still stacks sensibly once the two columns become
    /// one below 1400px.
    /// </summary>
    private const string BodyEditorMinHeight = "22rem";

    /// <summary>D9: the row label's help hint — the "fixed per template" rule, without the paragraph.</summary>
    private const string TemplateTypeHelp =
        "Type and contact mode are fixed per template — create a new template to change them.";

    private static readonly TimeSpan PreviewDebounce = TimeSpan.FromMilliseconds(300);

    /// <summary>One option of the Type dropdown. The label is the enum member name (Title Case).</summary>
    public sealed record KindOption(NotificationTemplateKind Value, string Label);

    /// <summary>One option of the Preferred-mode-of-contact dropdown.</summary>
    public sealed record ChannelOption(NotificationChannel Value, string Label);

    private static readonly KindOption[] KindOptions =
        Enum.GetValues<NotificationTemplateKind>().Select(k => new KindOption(k, k.ToString())).ToArray();

    private static readonly ChannelOption[] ChannelOptions =
    [
        new(NotificationChannel.Email, "Email"),
        new(NotificationChannel.SMS, "SMS"),
        new(NotificationChannel.WhatsApp, "WhatsApp"),
    ];

    /// <summary>Create or Edit (spec §3.3).</summary>
    [Parameter] public TemplateEditorMode Mode { get; set; } = TemplateEditorMode.Create;

    /// <summary>The row being edited; required in Edit mode.</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>The grade-detail deep link's prefill (spec §3.4/§3.11): a GradeLevel constraint on create.</summary>
    [Parameter] public Guid? PrefillGradeLevelId { get; set; }

    /// <summary>Raised after a successful create or replace, with the saved row.</summary>
    [Parameter] public EventCallback<TenantNotificationTemplateDto> Saved { get; set; }

    private readonly TemplateFormModel _model = new();
    private TemplateConstraintLookups? _lookups;
    private RichInstructionEditor? _editor;
    private bool _loading = true;
    private bool _saving;
    private bool _notFound;
    private string? _error;
    private string? _message;
    private string? _previewSubject;
    private string? _previewBody;
    private bool _previewUnavailable;
    private string? _previewError;
    private CancellationTokenSource? _previewDebounce;
    private bool _disposed;

    /// <summary>
    /// The load token (blazor-components.md rule 3, scoped to every data-loading page by
    /// adr-authoring-surface-pattern decision 1): navigating away cancels the by-id read instead of
    /// letting it land on an unmounted component.
    /// </summary>
    private CancellationTokenSource? _loadCts;

    /// <summary>
    /// The token every dispatched mutation carries (blazor-components.md, "Mutations take a token
    /// too"): Save, Reset and the copy action must not outlive the circuit that asked for them.
    /// </summary>
    private CancellationToken MutationToken => _loadCts?.Token ?? CancellationToken.None;
    private bool _resetting;
    private bool _adopting;
    private bool _sessionIsSystem = true;
    private TenantNotificationTemplateDto[] _siblings = [];
    private List<NotificationTemplateAuditEntryDto> _audit = [];

    private bool LockedMeta => Mode == TemplateEditorMode.Edit;

    /// <summary>
    /// True when the row is visible but not writable by this session (redesign spec §3.5/§3.7): a
    /// tenant session opening a system-blueprint row, or a system session opening a tenant's row from
    /// the portal-wide picker. Both are read-only, and each offers the copy action that turns the row
    /// into one it owns.
    /// </summary>
    private bool ReadOnly => Mode == TemplateEditorMode.Edit && _sessionIsSystem != _model.IsSystem;

    private bool CanAdopt => ReadOnly && _model.IsSystem;

    private string AdoptLabel => CanAdopt ? "Adopt to this tenant" : "Publish portal-wide";

    private string ReadOnlyReason => CanAdopt
        ? "This is a system-blueprint template: a tenant session cannot edit it. Adopt it to get an "
          + "editable copy owned by this tenant."
        : $"This template belongs to {_model.OwnerName}: it can only be edited in that tenant's "
          + "session. Publish it portal-wide to get an editable blueprint copy.";

    private string SaveLabel => Mode == TemplateEditorMode.Create ? "Create template" : "Save";

    // ── Shell slots (ADR adr-authoring-surface-pattern, decision 1) ──────────────
    // The breadcrumb and the sticky action bar live in the shared AuthoringShell; this page supplies
    // the trail, the title content, the primary action and the reset control, so the ids the detail suite
    // pins (`#template-save`, `#template-reset`, `#template-adopt`, `#template-editor-owner`) stay exactly
    // where they were. The reason input is NOT here any more (naming spec D11): it is asked for in the
    // shared dialog at the two moments it means something — saving an edit and resetting a row.

    private IReadOnlyList<AuthoringCrumb> ShellCrumbs =>
        Mode == TemplateEditorMode.Create
            ? [new AuthoringCrumb("Notification templates", "/notification-templates"),
               new AuthoringCrumb("New template")]
            : [new AuthoringCrumb("Notification templates", "/notification-templates"),
               new AuthoringCrumb(ShellCrumbTitle)];

    /// <summary>The current crumb — and the action bar's heading — is the template's TITLE (naming spec D3).</summary>
    private string ShellCrumbTitle =>
        _loading ? "…" : _notFound ? "Not found" : TemplateTitle;

    /// <summary>
    /// The action bar's title content (naming spec D9): the template's own TITLE on Edit, nothing at all on
    /// Create — the breadcrumb already says "New template", and the form below shows the kind, so neither a
    /// caption nor a kind banner belongs here. The owner chip stays on Edit, where it says whose row this is.
    /// </summary>
    private RenderFragment? ShellTitle => Mode == TemplateEditorMode.Create
        ? null
        : @<text>@ShellCrumbTitle
        @if (!_loading && !_notFound)
        {
            @if (_model.IsSystem)
            {
                <FluentBadge Id="template-editor-owner"
                             Appearance="BadgeAppearance.Filled"
                             Color="BadgeColor.Informative">System</FluentBadge>
            }
            else
            {
                <span class="template-editor__owner" id="template-editor-owner">@_model.OwnerName</span>
            }
        }</text>;

    private string? ShellPrimaryLabel =>
        _loading || _notFound
            ? null
            : ReadOnly
                ? (_adopting ? "Adopting..." : AdoptLabel)
                : (_saving ? "Saving..." : SaveLabel);

    private bool ShellPrimaryDisabled => _adopting || _saving;

    /// <summary>Reset is the bar's secondary action on a writable Edit row (spec §3.2/§3.5).</summary>
    private RenderFragment ShellSecondaryActions => @<text>@if (Mode == TemplateEditorMode.Edit
        && !ReadOnly && !_loading && !_notFound)
        {
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Id="template-reset"
                          Disabled="@(_saving || _resetting)"
                          OnClick="ResetAsync">
                @(_resetting ? "Resetting..." : "Reset to built-in default")
            </FluentButton>
        }</text>;

    /// <summary>The bar's one primary action: the copy action while read-only, Save otherwise.</summary>
    private Task OnShellPrimaryAsync() => ReadOnly ? AdoptAsync() : SaveAsync();

    private string BodyInputId => _model.Channel == NotificationChannel.Email ? "template-body-editor" : "template-body-text";

    /// <summary>
    /// The generated code, read-only (naming spec D6/D7, stories 10 and 12): a create draft has not been
    /// minted yet, so it shows a dash rather than an empty box the operator would read as a required input.
    /// </summary>
    private string CodeDisplay => string.IsNullOrWhiteSpace(_model.Code) ? "—" : _model.Code!;

    /// <summary>Where the code in the row above comes from.</summary>
    private string CodeHint => string.IsNullOrWhiteSpace(_model.Code)
        ? "Generated when the template is saved."
        : "Generated on save. A code is never typed, and never changes.";

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();

        // The session scope decides whether this row is editable (spec §3.7): the claim, not the row.
        var scope = await Tenants.GetScopeAsync();
        _sessionIsSystem = !scope.IsRealTenant;

        _lookups = new TemplateConstraintLookups(Students, CodedValues);
        await _lookups.LoadAsync();

        if (Mode == TemplateEditorMode.Edit)
        {
            if (Id is not { } id)
            {
                _notFound = true;
                _loading = false;
                return;
            }

            try
            {
                var row = await Api.GetByIdAsync(id, _loadCts?.Token ?? CancellationToken.None);
                if (row is null)
                {
                    _notFound = true;
                    _loading = false;
                    return;
                }

                _model.Id = row.Id;
                _model.Kind = row.Kind;
                _model.Channel = row.Channel;
                _model.Title = row.Title ?? string.Empty;
                _model.Description = row.Description;
                _model.Code = row.Code;
                _model.Subject = row.Subject;
                _model.Body = row.Body;
                _model.CreatedAt = row.CreatedAt;
                _model.UpdatedAt = row.UpdatedAt;
                _model.TenantId = row.TenantId;
                _model.OwnerName = row.OwnerName;
                _model.Constraints.Clear();
                _model.Constraints.AddRange(row.Constraints);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load notification template {TemplateId}", id);
                _error = ex.Message;
            }
        }
        else if (PrefillGradeLevelId is { } grade)
        {
            _model.Constraints.Add(new TemplateConstraintDto(
                Guid.Empty, TemplateConstraintDimension.GradeLevel, grade.ToString("D")));
        }

        _loading = false;
        await LoadSiblingsAsync();
        await LoadAuditAsync();
        QueuePreview();
    }

    /// <summary>A kind change resets the preview: the renderer's sample data is kind-sensitive.</summary>
    private void OnKindChanged(NotificationTemplateKind kind)
    {
        _model.Kind = kind;
        QueuePreview();
    }

    /// <summary>
    /// A mode change swaps the body control, so the previous body cannot simply carry over: the domain
    /// drops the subject for every non-email channel, and this keeps the draft honest about that.
    /// </summary>
    private void OnChannelChanged(NotificationChannel channel)
    {
        _model.Channel = channel;
        if (channel != NotificationChannel.Email && _model.Subject is not null)
        {
            // Captured into the body only when the authored text was a subject line; the stored text is
            // never silently moved by the server, so neither is it here.
            _model.Subject = null;
        }

        QueuePreview();
    }

    private void OnSubjectChanged(string? value)
    {
        _model.Subject = value;
        QueuePreview();
    }

    /// <summary>
    /// The naming fields (D1) are content edits like any other: they stage on the draft and one Save
    /// persists them. The title is also the page's identity (D3), so the breadcrumb and the heading follow
    /// it as the operator types.
    /// </summary>
    private void OnTitleChanged(string? value) => _model.Title = value ?? string.Empty;

    private void OnDescriptionChanged(string? value) => _model.Description = value;

    private void OnBodyChanged(string? value)
    {
        _model.Body = value ?? string.Empty;
        QueuePreview();
    }

    /// <summary>Appends a tag at the end of the authored text (email: subject; plain text: body).</summary>
    private void InsertTag(string tag)
    {
        var token = "{{" + tag + "}}";
        if (_model.Channel == NotificationChannel.Email)
            _model.Subject = (_model.Subject ?? string.Empty) + token;
        else
            _model.Body += token;

        QueuePreview();
    }

    /// <summary>Dismisses one staged constraint (nothing is persisted until Save).</summary>
    private void RemoveConstraint(TemplateConstraintDto constraint) => _model.Constraints.Remove(constraint);

    private string Display(TemplateConstraintDto constraint) =>
        _lookups?.DisplayFor(constraint.Dimension, constraint.Value) ?? constraint.Value;

    /// <summary>
    /// SMS/WhatsApp length guidance: warn near/over the 160-character limit, never block. When the
    /// preview is degraded the hint falls back to the RAW authored length and says so.
    /// </summary>
    private string LengthHint
    {
        get
        {
            var rendered = !_previewUnavailable && _previewBody is not null;
            var length = rendered ? _previewBody!.Length : _model.Body.Length;
            var basis = rendered ? "rendered length" : "authored length — rendered length unavailable";

            if (length > SmsLimit)
            {
                return $"{length} characters ({basis}). Over {SmsLimit} characters — the carrier may split "
                    + "this message. A warning only; it still saves.";
            }

            if (length >= SmsWarnLength)
            {
                return $"{length} characters ({basis}). Approaching the {SmsLimit}-character SMS limit.";
            }

            return $"{length} characters ({basis}).";
        }
    }

    private async Task<string?> ReadEditorHtmlAsync() =>
        _editor is null ? null : await _editor.GetHtmlAsync();

    private void QueuePreview()
    {
        if (_disposed)
            return;

        _previewDebounce?.Cancel();
        _previewDebounce?.Dispose();
        var cts = new CancellationTokenSource();
        _previewDebounce = cts;
        _ = DebouncedPreviewAsync(cts.Token);
    }

    private async Task DebouncedPreviewAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(PreviewDebounce, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await RefreshPreviewAsync(ct);
    }

    private Task OnRefreshPreviewAsync() => RefreshPreviewAsync();

    /// <summary>
    /// Runs the Assignments host's exact render path over the authored pair. A failure is the documented
    /// degradation: an inline note, and the save path is untouched.
    /// </summary>
    private async Task RefreshPreviewAsync(CancellationToken ct = default)
    {
        var body = _model.Channel == NotificationChannel.Email
            ? await ReadEditorHtmlAsync() ?? string.Empty
            : _model.Body;

        NotificationTemplatePreviewDto? rendered = null;
        string? error = null;
        try
        {
            rendered = await Preview.PreviewAsync(_model.Kind, _model.Channel, _model.Subject, body, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Template preview failed for {Kind}/{Channel}", _model.Kind, _model.Channel);
            error = ex.Message;
        }

        if (_disposed)
            return;

        await InvokeAsync(() =>
        {
            if (rendered is not null)
            {
                _previewSubject = rendered.Subject;
                _previewBody = rendered.Body;
                _previewUnavailable = false;
                _previewError = null;
            }
            else
            {
                _previewUnavailable = true;
                _previewError = error;
            }

            StateHasChanged();
        });
    }

    /// <summary>
    /// Persists the whole draft in one call (Q9). Email bodies are sanitized with the ONE instruction
    /// sanitizer; the plain-text modes are NOT sanitized, because HTML-encoding a plain-text channel
    /// would corrupt it (the old page's rule, kept).
    /// </summary>
    private async Task SaveAsync()
    {
        // A read-only row (the other scope's) never writes: its action is the Copy button instead.
        if (_saving || ReadOnly)
            return;

        _error = null;
        _message = null;

        // D1: the title is the row's identity, so a blank one is refused here exactly as the domain refuses
        // it — checked BEFORE the reason dialog, so the operator is never asked "why" for a draft that cannot
        // be saved.
        var title = _model.Title?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(title))
        {
            _error = "A title is required.";
            return;
        }

        _saving = true;
        try
        {
            var body = _model.Channel == NotificationChannel.Email
                ? RichInstructionSanitizer.Sanitize(await ReadEditorHtmlAsync() ?? string.Empty)
                : _model.Body;

            if (string.IsNullOrWhiteSpace(body))
            {
                _error = "A message body is required.";
                return;
            }

            var constraints = _model.Constraints
                .Select(c => new TemplateConstraintRequest(c.Dimension, c.Value))
                .ToList();
            var description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description!.Trim();

            TenantNotificationTemplateDto saved;
            if (Mode == TemplateEditorMode.Edit && _model.Id is { } id)
            {
                // D11: the audit reason is the shared dialog, opened immediately before the write, and it is
                // the save's ONLY interruption. Cancelling it abandons the save — nothing is written and the
                // draft stays exactly as the operator left it.
                var reason = await DialogService.ShowReasonDialogAsync(
                    new ReasonDialog.ReasonFormModel($"Save changes to '{title}'", "Save"),
                    $"Save '{title}'");
                if (reason is null)
                    return;

                saved = await Api.UpdateAsync(id,
                    new UpdateNotificationTemplateRequest(title, description, _model.Subject, body, constraints, reason),
                    MutationToken);
            }
            else
            {
                // D11: a first write has no "why" — the audit entry records the actor, the time and the
                // created values — so the create sends no reason at all.
                saved = await Api.CreateAsync(
                    new CreateNotificationTemplateRequest(
                        _model.Kind, _model.Channel, title, description, _model.Subject, body, constraints),
                    MutationToken);
            }

            _model.Id = saved.Id;
            _model.Title = string.IsNullOrWhiteSpace(saved.Title) ? title : saved.Title;
            _model.Description = saved.Description ?? description;
            _model.Code = saved.Code;
            _model.Subject = saved.Subject;
            _model.Body = saved.Body;
            _model.UpdatedAt = saved.UpdatedAt;
            _message = "Template saved.";
            await LoadSiblingsAsync();
            await LoadAuditAsync();
            await Saved.InvokeAsync(saved);
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save the notification template");
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>The add-constraint menu (redesign spec §3.6): one item per dimension, verb-first labels,
    /// every item carrying the shared Add glyph — the Targets &amp; Audience kebab treatment.</summary>
    private IReadOnlyList<RowAction> ConstraintActions =>
    [
        ConstraintAction(TemplateConstraintDimension.GradeLevel, "Add grade levels"),
        ConstraintAction(TemplateConstraintDimension.Stream, "Add streams"),
        ConstraintAction(TemplateConstraintDimension.ActivityGroup, "Add activity groups"),
        ConstraintAction(TemplateConstraintDimension.Subject, "Add subjects"),
        ConstraintAction(TemplateConstraintDimension.AssignmentType, "Add assignment types"),
    ];

    private RowAction ConstraintAction(TemplateConstraintDimension dimension, string label) =>
        new()
        {
            Label = label,
            Icon = FluentIcons.Add,
            Disabled = _lookups?.Loaded != true,
            DisabledReason = _lookups?.Loaded == true
                ? null
                : $"Constraint lookups are unavailable ({_lookups?.Error}) — adding is disabled until they return.",
            OnClick = () => OpenConstraintDialogAsync(dimension),
        };

    /// <summary>Opens the add dialog PRESET to one dimension and merges its picks into the draft.</summary>
    private async Task OpenConstraintDialogAsync(TemplateConstraintDimension dimension)
    {
        if (_lookups is null)
            return;

        var model = new ConstraintEditModel
        {
            Dimension = dimension,
            TemplateLabel = TemplateTitle,
            Options = _lookups.OptionsFor(dimension)
                .Select(o => new ConstraintOption(o.Value, o.Text))
                .ToList(),
            ExistingValues = _model.Constraints
                .Where(c => c.Dimension == dimension)
                .Select(c => c.Value)
                .ToList(),
        };

        var result = await DialogService
            .ShowShellDialogAsync<ConstraintEditDialog, ConstraintEditModel, ConstraintEditResult>(
                model, DimensionTitle(dimension), DialogWidth.Medium);
        if (result is null)
            return;

        foreach (var value in result.Values)
        {
            if (_model.Constraints.Any(c =>
                    c.Dimension == dimension
                    && string.Equals(c.Value, value, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            _model.Constraints.Add(new TemplateConstraintDto(Guid.Empty, dimension, value));
        }
    }

    /// <summary>The read-only list, shared with the landing grid's constraint-count link.</summary>
    private Task OpenConstraintListAsync() =>
        DialogService.ShowReadonlyDialogAsync<TemplateConstraintsDialog>(
            $"{_model.Kind} · {EnumLabels.For(_model.Channel)}",
            new Dictionary<string, object?>
            {
                [TemplateConstraintsDialog.ConstraintsKey] = _model.Constraints.ToList(),
                [TemplateConstraintsDialog.TemplateLabelKey] = TemplateTitle,
            });

    /// <summary>
    /// The draft's identity label (naming spec D3): its title, falling back to the pre-naming chain only if
    /// the title is somehow blank. The fallback names the kind × contact mode, so this is never an empty
    /// string — it is what the breadcrumb, the heading and every dialog that names this template reads.
    /// </summary>
    private string TemplateTitle => TemplateTitles.For(
        _model.Title, _model.Subject, _model.Body, $"{_model.Kind} · {EnumLabels.For(_model.Channel)}");

    private static string DimensionTitle(TemplateConstraintDimension dimension) => dimension switch
    {
        TemplateConstraintDimension.GradeLevel => "Add grade levels",
        TemplateConstraintDimension.Stream => "Add streams",
        TemplateConstraintDimension.ActivityGroup => "Add activity groups",
        TemplateConstraintDimension.Subject => "Add subjects",
        TemplateConstraintDimension.AssignmentType => "Add assignment types",
        _ => "Add constraint",
    };

    /// <summary>
    /// The §3.7 conflict warning: another template of the SAME kind × channel **in the same scope**
    /// carries the identical constraint set, so publish-time selection could not tell them apart. A
    /// warning, never a block — the server stays the authority.
    /// <para>
    /// Scope is part of the comparison because the sibling read is wider than the draft's scope: a
    /// tenant session reads the system blueprint too (that is what makes adopt possible, §3.7), and
    /// §3.9 makes a tenant row <b>shadow</b> an identical blueprint row. Warning there would call the
    /// designed outcome ambiguous.
    /// </para>
    /// </summary>
    private string? ConflictWarning
    {
        get
        {
            var draft = NormalizeConstraintSet(_model.Constraints.Select(c => (c.Dimension, c.Value)));

            // The DRAFT's scope, not the DTO's: a create draft carries no TenantId yet, so the model's
            // IsSystem is true by construction there and would compare the wrong side. The session's
            // scope is the scope a create writes into (spec §3.7/§5); on Edit the row's own scope is.
            var draftIsSystem = Mode == TemplateEditorMode.Create ? _sessionIsSystem : _model.IsSystem;

            foreach (var row in _siblings)
            {
                if (row.Id == _model.Id
                    || row.Kind != _model.Kind
                    || row.Channel != _model.Channel
                    || row.IsSystem != draftIsSystem)
                {
                    continue;
                }

                var candidate = NormalizeConstraintSet(row.Constraints.Select(c => (c.Dimension, c.Value)));
                if (string.Equals(candidate, draft, StringComparison.Ordinal))
                {
                    // D3: the warning names the other row by its TITLE, so the operator can go and find it.
                    var other = TemplateTitles.For(row.Title, row.Subject, row.Body,
                        $"{row.Kind} · {EnumLabels.For(row.Channel)}");
                    return $"'{other}' has the identical constraint set in this type and contact mode — "
                        + "publish-time selection cannot tell them apart.";
                }
            }

            return null;
        }
    }

    private static string NormalizeConstraintSet(
        IEnumerable<(TemplateConstraintDimension Dimension, string Value)> constraints) =>
        string.Join(
            "|",
            constraints
                .Select(c => $"{c.Dimension}={c.Value.Trim()}")
                .OrderBy(p => p, StringComparer.Ordinal)
                .Select(p => p.ToLowerInvariant()));

    private async Task LoadSiblingsAsync()
    {
        try
        {
            _siblings = (await Api.ListAsync()).ToArray();
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load sibling templates for the conflict warning");
        }
    }

    private async Task LoadAuditAsync()
    {
        if (Mode != TemplateEditorMode.Edit || _model.Id is not { } id)
            return;

        try
        {
            _audit = (await Api.GetAuditAsync(_model.Kind, _model.Channel, id)).ToList();
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the audit trail for template {TemplateId}", id);
        }
    }

    /// <summary>
    /// The read-only row's primary action (spec §3.5/§3.8): copy a system-blueprint row into this
    /// tenant, or publish a tenant row portal-wide. Either way the operator lands on the COPY - the
    /// editable row they now own - and the source is never modified.
    /// </summary>
    private async Task AdoptAsync()
    {
        if (_model.Id is not { } id)
            return;

        var adopt = CanAdopt;
        var source = $"'{TemplateTitle}'";

        var confirmed = await DialogService.ShowConfirmDialogAsync(
            adopt
                ? $"Adopt {source} into this tenant? The copy is independent of the system blueprint."
                : $"Publish {source} portal-wide? Every tenant will see it unless it owns an override.",
            adopt ? "Adopt" : "Publish",
            title: adopt ? "Adopt template" : "Publish portal-wide");

        if (!confirmed)
            return;

        _adopting = true;
        _error = null;

        try
        {
            var copy = adopt
                ? await Api.AdoptAsync(id, $"Adopted from the system blueprint: {TemplateTitle}", MutationToken)
                : await Api.PromoteAsync(id, $"Published portal-wide from {_model.OwnerName}: {TemplateTitle}", MutationToken);

            Nav.NavigateTo($"/notification-templates/{copy.Id:D}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to copy notification template {TemplateId}", id);
            _error = ex.Message;
        }
        finally
        {
            _adopting = false;
        }
    }

    /// <summary>
    /// Edit-mode reset (spec §3.2/§3.5; naming spec D11): the shared reason dialog IS the destructive
    /// confirmation — the operator is not asked twice for one act — and it is the only place the reason is
    /// asked for. Cancelling it abandons the reset.
    /// </summary>
    private async Task ResetAsync()
    {
        if (_saving || _resetting || _model.Id is not { } id)
            return;

        var reason = await DialogService.ShowReasonDialogAsync(
            new ReasonDialog.ReasonFormModel(
                "Resetting removes this template: the built-in default applies again. The reason is "
                + "recorded in the audit trail.",
                "Reset",
                "Resetting..."),
            $"Reset '{TemplateTitle}'");
        if (reason is null)
            return;

        _resetting = true;
        _error = null;
        _message = null;
        try
        {
            await Api.DeleteAsync(id, reason, MutationToken);
            Nav.NavigateTo("/notification-templates");
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset notification template {TemplateId}", id);
            _error = ex.Message;
        }
        finally
        {
            _resetting = false;
        }
    }
    private void BackToListAsync() => Nav.NavigateTo("/notification-templates");

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        _previewDebounce?.Cancel();
        _previewDebounce?.Dispose();
        _previewDebounce = null;
    }
}
