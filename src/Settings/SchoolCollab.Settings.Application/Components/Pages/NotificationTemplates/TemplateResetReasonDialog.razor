@* Redesign spec 3.2/3.5 - the landing's audited reset prompt. The reason is REQUIRED (a reset is
   recorded in the audit trail, so the row must carry the operator's own words); an empty box keeps the
   dialog open with an error instead of submitting. Dumb dialog: the hosting page issues the DELETE.
   The dialog is also the destructive confirmation - the kebab item is not flagged Destructive, so the
   operator is not asked twice. *@
@inherits DialogShellBase<TemplateResetReasonDialog.ReasonFormModel, TemplateResetReasonDialog.ReasonResult>
@namespace SchoolCollab.Settings.Application.Components.Pages.NotificationTemplates
@using Microsoft.FluentUI.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components
@using SchoolCollab.Admin.Shared.Components.Dialogs

<DialogShellBody>
<div class="dialog-container">
    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync">
        <p class="dialog-hint">
            @Model.Prompt
        </p>

        <FormRow Label="Reason" Help="Required - recorded in the audit trail.">
            <FluentTextArea @bind-Value="Model.Reason" class="full-width ta-lines-3"
                            Placeholder="Why is this template being reset?" />
        </FormRow>

        <DialogShellFooter Saving="@Saving" Error="@Error" SubmitText="Reset"
                           SavingText="Resetting..." OnCancel="HandleCancelAsync" />
    </EditForm>
</div>
</DialogShellBody>

@code {
    /// <summary>Dialog inputs: the row being reset (title for the prompt) and the explanatory copy.</summary>
    public sealed class ReasonFormModel(string title, string prompt)
    {
        public string Title { get; } = title;
        public string Prompt { get; } = prompt;

        /// <summary>The operator's reason. Required: whitespace is rejected, not submitted.</summary>
        public string? Reason { get; set; }
    }

    /// <summary>The trimmed reason the DELETE travels with.</summary>
    public sealed record ReasonResult(string Reason);

    protected override Task<ReasonResult?> SubmitAsync(ReasonFormModel model)
    {
        var reason = model.Reason?.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            Error = "A reason is required to reset a template.";
            return Task.FromResult<ReasonResult?>(null);
        }

        return Task.FromResult<ReasonResult?>(new ReasonResult(reason));
    }
}