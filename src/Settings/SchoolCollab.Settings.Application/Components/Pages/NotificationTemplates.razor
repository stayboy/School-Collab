@page "/notification-templates"
@using Microsoft.AspNetCore.Components
@using SchoolCollab.Admin.Shared.Components.RichText
@using SchoolCollab.Core.Notifications
@using SchoolCollab.Core.RichText
@inject NotificationTemplateApiClient Api
@inject NotificationTemplatePreviewClient Preview
@inject StudentsLookupClient Lookups
@inject CodedValuesApiClient CodedValuesApi
@inject ILogger<NotificationTemplates> Logger
@implements IDisposable

@* The ONE editing surface for tenant notification templates (spec §3.10, round
   notification-templates-b3b). Shell posture mirrors ConfigFlagDetail (save / reset / reason /
   audit) — this is not a list, so it is not a LandingPage. Authorization is the host's: no page
   policy, exactly like /config-flags.

   Master–detail per slot, because a slot is a SET (round b2c relaxed the store to several rows per
   kind × channel): the row inventory on the left, one editing pane for the selected row, an
   "+ add template" that creates, and a per-row reset that tombstones by id with the operator's
   reason. Selection contract: on entering a tab the slot's default row (no constraints) is
   selected when one exists, otherwise the add state; an empty slot says the built-in default
   applies; a slot whose rows are all constrained says there is no tenant default. *@

<PageTitle>Notification templates</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <div class="title-row">
            <h1 class="page-title">Notification templates</h1>
        </div>
        <p class="text-muted">
            Email and SMS overrides for assignment notifications. Where no tenant template exists the
            built-in default applies. Constraints narrow a template to an audience or assignment type;
            the tenant default is the row with none.
        </p>

        @if (_loading)
        {
            <FluentSpinner />
        }
        else if (!string.IsNullOrEmpty(_loadError))
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@_loadError</FluentMessageBar>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_gradeFilterText))
            {
                <FluentMessageBar Intent="MessageBarIntent.Info" class="mb-2">
                    Showing the templates that can apply to one grade level — every kind × channel tab
                    stays reachable; new templates start with that grade's constraint.
                </FluentMessageBar>
            }

            @if (_lookupError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2">
                    Constraint lookups are unavailable (@_lookupError). Existing constraints keep their
                    stored values so an edit round-trips, but adding constraints is disabled until the
                    lookups return.
                </FluentMessageBar>
            }

            <FluentTabStrip ActiveTabId="@_activeKindTabId" ActiveTabIdChanged="OnKindTabChangedAsync">
                @foreach (var kind in Kinds)
                {
                    <FluentTab Id="@KindTabId(kind)" Header="@kind.ToString()">
                        <FluentTabStrip ActiveTabId="@_activeChannelTabId" ActiveTabIdChanged="OnChannelTabChangedAsync">
                            @foreach (var channel in Channels)
                            {
                                <FluentTab Id="@ChannelTabId(channel)" Header="@ChannelLabel(channel)">
                                    @{
                                        var slot = Slot(kind, channel);
                                    }
                                    @if (kind == _activeKind && channel == _activeChannel)
                                    {
                                        @* ── Slot state notes ───────────────────────────────── *@
                                        @if (slot.Rows.Count == 0)
                                        {
                                            <FluentMessageBar Intent="MessageBarIntent.Info" class="mb-2">
                                                No tenant template for @kind.ToString() · @ChannelLabel(channel) —
                                                the built-in default applies.
                                            </FluentMessageBar>
                                        }
                                        else if (slot.Rows.All(r => r.Constraints.Count > 0))
                                        {
                                            <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2">
                                                No tenant default — the built-in default applies to unconstrained sends.
                                            </FluentMessageBar>
                                        }

                                        @* ── Row inventory (master) ────────────────────────── *@
                                        <FluentCard class="pa-4 mt-3">
                                            <h2>Templates in this slot (@slot.Rows.Count)</h2>
                                            <FluentStack Orientation="Orientation.Vertical">
                                                @foreach (var row in slot.Rows)
                                                {
                                                    <div data-row="@row.Id">
                                                        <FluentStack Orientation="Orientation.Horizontal">
                                                            <FluentButton Appearance="@(slot.SelectedId == row.Id ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                                                          OnClick="@(() => SelectRow(slot, row))">
                                                                @SlotRowTitle(row)
                                                            </FluentButton>
                                                            @if (row.Constraints.Count == 0)
                                                            {
                                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Default</FluentBadge>
                                                            }
                                                            @if (slot.SelectedId == row.Id)
                                                            {
                                                                <FluentBadge Appearance="BadgeAppearance.Outline">Editing</FluentBadge>
                                                            }
                                                            <span class="text-muted">@ConstraintSummary(row)</span>
                                                            <FluentButton Appearance="ButtonAppearance.Transparent"
                                                                          Disabled="@_busy"
                                                                          OnClick="@(() => ResetAsync(slot, row))">Reset</FluentButton>
                                                        </FluentStack>
                                                    </div>
                                                }
                                            </FluentStack>
                                            <div class="mt-3">
                                                <FluentButton Appearance="ButtonAppearance.Outline"
                                                              IconStart="@FluentIcons.Add"
                                                              OnClick="@(() => BeginAdd(slot))">Add template</FluentButton>
                                            </div>
                                        </FluentCard>

                                        @* ── Editor (detail) ─────────────────────────────── *@
                                        <FluentCard class="pa-4 mt-3">
                                            <h2>@(slot.SelectedId is null ? "New template" : "Edit template")</h2>

                                            @if (ConflictWarning(slot) is { } warning)
                                            {
                                                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mb-2">@warning</FluentMessageBar>
                                            }

                                            @if (channel == NotificationChannel.Email)
                                            {
                                                <FluentTextInput Label="Subject"
                                                                 Class="full-width"
                                                                 Placeholder="New assignment: {{Title}}"
                                                                 @bind-Value="slot.Subject"
                                                                 @bind-Value:after="QueuePreview" />
                                            }

                                            <div class="mt-3">
                                                @if (channel == NotificationChannel.Email)
                                                {
                                                    @* Only the ACTIVE slot's pane renders, so one editor ref covers
                                                       every email slot: switching slots unmounts and remounts it. *@
                                                    <label class="text-muted">Body</label>
                                                    <RichInstructionEditor @ref="_activeEditor"
                                                                           Id="@($"template-body-{slot.Kind}-{slot.Channel}")"
                                                                           Value="@slot.Body"
                                                                           Placeholder="Write the email body…" />
                                                    <p class="text-muted">
                                                        Tags typed into the body render on send; the chips below insert
                                                        into the subject (the body is a rich editor, inserted at the caret
                                                        by the browser).
                                                    </p>
                                                }
                                                else
                                                {
                                                    <FluentTextArea Label="Message"
                                                                    Class="full-width ta-lines-6"
                                                                    Placeholder="Reminder: {{Title}} is due {{DueDate}}. {{Link}}"
                                                                    @bind-Value="slot.Body"
                                                                    @bind-Value:after="QueuePreview" />
                                                    <p class="text-muted">@SmsLengthHint(slot)</p>
                                                }
                                            </div>

                                            @* ── Tag chips (spec §3.2 vocabulary) ────────────── *@
                                            <div class="mt-3">
                                                <span class="text-muted">Insert a tag:</span>
                                                @foreach (var tag in NotificationTemplateTags.All)
                                                {
                                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                                  OnClick="@(() => InsertTag(slot, tag))">@($"{{{{{tag}}}}}")</FluentButton>
                                                }
                                            </div>

                                            @* ── Constraints ────────────────────────────────── *@
                                            <h3 class="mt-3">Constraints</h3>
                                            <p class="text-muted">
                                                A template applies when every dimension below matches the
                                                assignment. No constraints = the tenant default.
                                            </p>
                                            @foreach (var constraint in slot.Constraints)
                                            {
                                                <FluentStack Orientation="Orientation.Horizontal">
                                                    <DropdownForEnum TEnum="TemplateConstraintDimension"
                                                                     @bind-SelectedValue="constraint.Dimension"
                                                                     @bind-SelectedValue:after="() => OnDimensionChanged(constraint)"
                                                                     Width="FieldWidth.W3" />
                                                    <DropdownComponent TItem="OptionItem" TValue="string"
                                                                       Items="@OptionsFor(constraint.Dimension)"
                                                                       @bind-SelectedValue="constraint.Value"
                                                                       OptionText="@(o => o.Text)"
                                                                       OptionValue="@(o => o.Value)"
                                                                       Placeholder="Value"
                                                                       Width="FieldWidth.W5" />
                                                    <span class="text-muted">
                                                        @($"{DimensionLabel(constraint.Dimension)}: {DisplayFor(constraint.Dimension, constraint.Value)}")
                                                    </span>
                                                    <FluentButton Appearance="ButtonAppearance.Transparent"
                                                                  OnClick="@(() => RemoveConstraint(slot, constraint))">Remove</FluentButton>
                                                </FluentStack>
                                            }
                                            <div class="mt-3">
                                                <FluentButton Appearance="ButtonAppearance.Outline"
                                                              IconStart="@FluentIcons.Add"
                                                              Disabled="@(!LookupsAvailable)"
                                                              OnClick="@(() => AddConstraint(slot))">Add constraint</FluentButton>
                                            </div>

                                            @* ── Save + reason ──────────────────────────────── *@
                                            <div class="mt-3">
                                                <FluentTextInput Label="Reason (recorded in the audit trail)"
                                                                 Class="full-width"
                                                                 @bind-Value="slot.Reason" />
                                                <FluentButton Appearance="ButtonAppearance.Primary"
                                                              Disabled="@_busy"
                                                              OnClick="@(() => SaveAsync(slot))">Save</FluentButton>
                                            </div>

                                            @if (!string.IsNullOrEmpty(slot.Message))
                                            {
                                                <FluentMessageBar Intent="MessageBarIntent.Success" class="mt-2">@slot.Message</FluentMessageBar>
                                            }
                                            @if (!string.IsNullOrEmpty(slot.Error))
                                            {
                                                <FluentMessageBar Intent="MessageBarIntent.Error" class="mt-2">@slot.Error</FluentMessageBar>
                                            }
                                        </FluentCard>

                                        @* ── Live preview (the exact render path, sample data) ── *@
                                        <FluentCard class="pa-4 mt-3">
                                            <h2>Preview (sample data)</h2>
                                            <p class="text-muted">
                                                Rendered by the Assignments service with the sample assignment,
                                                guardian and @LinkDescription(channel) sample link.
                                            </p>
                                            <FluentButton Appearance="ButtonAppearance.Outline"
                                                          OnClick="@(() => OnRefreshPreviewAsync(slot))">Refresh preview</FluentButton>
                                            @if (slot.PreviewUnavailable)
                                            {
                                                <FluentMessageBar Intent="MessageBarIntent.Warning" class="mt-2">
                                                    Preview unavailable — the template still saves. @slot.PreviewError
                                                </FluentMessageBar>
                                            }
                                            else if (slot.PreviewBody is not null)
                                            {
                                                @if (channel == NotificationChannel.Email)
                                                {
                                                    <p class="text-muted">Subject: @slot.PreviewSubject</p>
                                                    <RichInstruction Value="@slot.PreviewBody"
                                                                     Id="@($"template-preview-{slot.Kind}-{slot.Channel}")" />
                                                }
                                                else
                                                {
                                                    <p>@slot.PreviewBody</p>
                                                }
                                            }
                                        </FluentCard>

                                        @* ── Audit trail (spec §3.9) ────────────────────── *@
                                        <FluentCard class="pa-4 mt-3">
                                            <h2>Audit trail — @kind.ToString() · @ChannelLabel(channel)</h2>
                                            @if (!string.IsNullOrEmpty(slot.AuditError))
                                            {
                                                <FluentMessageBar Intent="MessageBarIntent.Error">@slot.AuditError</FluentMessageBar>
                                            }
                                            else if (slot.Audit.Count == 0)
                                            {
                                                <p class="text-muted">No changes recorded for this slot yet.</p>
                                            }
                                            else
                                            {
                                                <FluentDataGrid Items="@slot.Audit.AsQueryable()">
                                                    <PropertyColumn Title="When" Property="@(a => a.OccurredAt)" Format="yyyy-MM-dd HH:mm" />
                                                    <PropertyColumn Title="Actor" Property="@(a => a.ActorDisplayName)" />
                                                    <PropertyColumn Title="Change" Property="@(a => a.ChangeKind)" />
                                                    <PropertyColumn Title="Reason" Property="@(a => a.Reason)" />
                                                </FluentDataGrid>
                                            }
                                        </FluentCard>
                                    }
                                </FluentTab>
                            }
                        </FluentTabStrip>
                    </FluentTab>
                }
            </FluentTabStrip>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageBarIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>The four authorable kinds, in spec order.</summary>
    private static readonly NotificationTemplateKind[] Kinds =
    [
        NotificationTemplateKind.Publish,
        NotificationTemplateKind.Reminder,
        NotificationTemplateKind.Completion,
        NotificationTemplateKind.Overdue,
    ];

    /// <summary>The two authorable channels (WhatsApp recipients use the SMS body — spec §2).</summary>
    private static readonly NotificationChannel[] Channels =
    [
        NotificationChannel.Email,
        NotificationChannel.SMS,
    ];

    /// <summary>
    /// The assignment-type constraint values, exactly as the matcher stores/compares them
    /// (<c>AssignmentType.ToString()</c> — Assignments.Core.Domain.AssignmentType). Settings may not
    /// reference that enum, so the three names are mirrored here with their friendly labels; the
    /// VALUE is the enum name, never the label.
    /// </summary>
    private static readonly OptionItem[] AssignmentTypeOptions =
    [
        new("Digital", "Online"),
        new("SemiManual", "Hybrid"),
        new("Manual", "Offline"),
    ];

    /// <summary>Preview refresh debounce — per-keystroke HTTP against a cross-context read is not free.</summary>
    private static readonly TimeSpan PreviewDebounce = TimeSpan.FromMilliseconds(300);

    /// <summary>Warn when the SMS body approaches the single-segment limit.</summary>
    private const int SmsWarnLength = 140;

    /// <summary>The single-segment SMS limit. A warning only — never a hard block (tags expand at render time).</summary>
    private const int SmsLimit = 160;

    /// <summary>
    /// The <c>?grade=</c> receiving end of the grade card's deep link (spec §3.11): each tab's row
    /// inventory is filtered to the templates that can apply to that grade. String, not Guid, so a
    /// malformed link degrades to "no filter" instead of failing the page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "grade")]
    public string? Grade { get; set; }

    private readonly Dictionary<(NotificationTemplateKind Kind, NotificationChannel Channel), SlotState> _slots = [];

    private bool _loading = true;
    private bool _busy;
    private string? _loadError;
    private string? _lookupError;
    private string? _gradeFilterText;
    private Guid? _gradeFilter;
    private bool _disposed;

    private NotificationTemplateKind _activeKind = NotificationTemplateKind.Publish;
    private NotificationChannel _activeChannel = NotificationChannel.Email;
    private string _activeKindTabId = KindTabId(NotificationTemplateKind.Publish);
    private string _activeChannelTabId = ChannelTabId(NotificationChannel.Email);

    private OptionItem[] _gradeOptions = [];
    private OptionItem[] _streamOptions = [];
    private OptionItem[] _topicOptions = [];
    private OptionItem[] _groupOptions = [];

    /// <summary>The one mounted rich editor (only the active slot's pane renders).</summary>
    private RichInstructionEditor? _activeEditor;

    private CancellationTokenSource? _previewDebounce;

    private bool LookupsAvailable => _lookupError is null;

    private SlotState ActiveSlot => Slot(_activeKind, _activeChannel);

    protected override async Task OnInitializedAsync()
    {
        if (Guid.TryParse(Grade, out var grade))
        {
            _gradeFilter = grade;
            _gradeFilterText = grade.ToString("D");
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            // The lookups degrade; they never fail the page.
            await LoadLookupsAsync();

            ApplyRows(await Api.ListAsync());
            foreach (var slot in _slots.Values)
                InitializeSelection(slot);

            await LoadAuditAsync(ActiveSlot);
            QueuePreview();
        }
        catch (OperationCanceledException)
        {
            // Navigated away / prerender circuit gone: not a load error.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load notification templates");
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Loads the four constraint option sources. One failure marks the whole picker set unavailable:
    /// the editor then shows existing values raw and disables ADDING a constraint (never a silently
    /// empty dropdown, never a save that drops constraints because the picker had no options).
    /// </summary>
    private async Task LoadLookupsAsync()
    {
        try
        {
            var gradeLevels = Lookups.ListGradeLevelsAsync();
            var topics = Lookups.ListTopicsAsync();
            var groups = Lookups.ListActivityGroupsAsync();
            await Task.WhenAll(gradeLevels, topics, groups);

            _gradeOptions = ToOptions(gradeLevels.Result);
            _topicOptions = ToOptions(topics.Result);
            _groupOptions = ToOptions(groups.Result.Where(g => g.IsActive is not false));

            // Streams are coded values in this store, and the matcher compares their coded-value id
            // (AssignmentTarget.RefId = StreamCodedValueId) — the codebook IS the correct source here.
            var streams = await CodedValuesApi.GetChildrenByParentCodeAsync(CodedValueParent.Streams.ToCode());
            _streamOptions = (streams ?? [])
                .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .Select(c => new OptionItem(c.Id.ToString("D"), c.Name))
                .ToArray();

            _lookupError = null;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Constraint lookups are unavailable; adding constraints is disabled");
            _lookupError = ex.Message;
        }
    }

    private static OptionItem[] ToOptions(IEnumerable<LookupOptionDto> options) =>
        options
            .OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase)
            .Select(o => new OptionItem(o.Id.ToString("D"), o.Name))
            .ToArray();

    /// <summary>
    /// Re-groups the tenant's rows into the eight slots, applying the §3.11 grade filter to every
    /// slot's inventory (every tab stays reachable; the filter narrows rows, never tabs).
    /// </summary>
    private void ApplyRows(IReadOnlyList<TenantNotificationTemplateDto> rows)
    {
        foreach (var kind in Kinds)
        {
            foreach (var channel in Channels)
            {
                var slot = Slot(kind, channel);
                slot.Rows = rows
                    .Where(r => r.Kind == kind && r.Channel == channel)
                    .Where(r => _gradeFilter is not { } grade || AppliesToGrade(r, grade))
                    // Default (no constraints) first, then the constrained candidates by creation.
                    .OrderBy(r => r.Constraints.Count == 0 ? 0 : 1)
                    .ThenBy(r => r.CreatedAt)
                    .ThenBy(r => r.Id)
                    .ToList();
            }
        }
    }

    /// <summary>
    /// B3a's applicability rule, read-side identical to <c>GetApplicableNotificationTemplatesHandler.
    /// AppliesToGrade</c>: a template can apply when it carries no GradeLevel constraint, or one of
    /// them is this grade — compared trimmed and case-insensitively (the matcher's own comparison).
    /// </summary>
    private static bool AppliesToGrade(TenantNotificationTemplateDto row, Guid gradeLevelId)
    {
        var grade = gradeLevelId.ToString("D");
        var gradeConstraints = row.Constraints
            .Where(c => c.Dimension == TemplateConstraintDimension.GradeLevel)
            .ToList();

        return gradeConstraints.Count == 0
            || gradeConstraints.Any(c =>
                string.Equals(c.Value.Trim(), grade, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// The selection contract: the slot's default row (no constraints) when one exists, otherwise
    /// the add state (no row selected, empty draft).
    /// </summary>
    private void InitializeSelection(SlotState slot)
    {
        slot.SelectionInitialized = true;
        var defaultRow = slot.Rows.FirstOrDefault(r => r.Constraints.Count == 0);
        if (defaultRow is not null)
            LoadDraft(slot, defaultRow);
        else
            BeginAdd(slot);
    }

    private void LoadDraft(SlotState slot, TenantNotificationTemplateDto row)
    {
        slot.SelectedId = row.Id;
        slot.Subject = row.Subject;
        slot.Body = row.Body;
        slot.Constraints.Clear();
        foreach (var constraint in row.Constraints)
        {
            slot.Constraints.Add(new ConstraintDraft
            {
                Dimension = constraint.Dimension,
                Value = constraint.Value,
            });
        }

        slot.Message = null;
        slot.Error = null;
    }

    /// <summary>
    /// The add state. When the page was reached through the grade card's deep link, the GradeLevel
    /// constraint is pre-filled with that grade — creating a grade-specific template is one click.
    /// </summary>
    private void BeginAdd(SlotState slot)
    {
        slot.SelectedId = null;
        slot.Subject = null;
        slot.Body = string.Empty;
        slot.Constraints.Clear();
        if (_gradeFilter is { } grade)
        {
            slot.Constraints.Add(new ConstraintDraft
            {
                Dimension = TemplateConstraintDimension.GradeLevel,
                Value = grade.ToString("D"),
            });
        }

        slot.Message = null;
        slot.Error = null;
        QueuePreview();
    }

    private void SelectRow(SlotState slot, TenantNotificationTemplateDto row)
    {
        LoadDraft(slot, row);
        QueuePreview();
    }

    private void AddConstraint(SlotState slot)
    {
        if (!LookupsAvailable)
            return;

        slot.Constraints.Add(new ConstraintDraft { Dimension = TemplateConstraintDimension.GradeLevel });
    }

    private void RemoveConstraint(SlotState slot, ConstraintDraft constraint)
    {
        slot.Constraints.Remove(constraint);
    }

    private static void OnDimensionChanged(ConstraintDraft constraint) =>
        // A value from one dimension is meaningless in another — clear it rather than carry it.
        constraint.Value = string.Empty;

    private async Task OnKindTabChangedAsync(string? tabId)
    {
        if (string.IsNullOrEmpty(tabId) || tabId == _activeKindTabId)
            return;

        _activeKindTabId = tabId;
        if (tabId.StartsWith("nt-kind-", StringComparison.Ordinal)
            && Enum.TryParse<NotificationTemplateKind>(tabId["nt-kind-".Length..], out var kind))
        {
            _activeKind = kind;
        }

        await OnActiveSlotChangedAsync();
    }

    private async Task OnChannelTabChangedAsync(string? tabId)
    {
        if (string.IsNullOrEmpty(tabId) || tabId == _activeChannelTabId)
            return;

        _activeChannelTabId = tabId;
        if (tabId.StartsWith("nt-channel-", StringComparison.Ordinal)
            && Enum.TryParse<NotificationChannel>(tabId["nt-channel-".Length..], out var channel))
        {
            _activeChannel = channel;
        }

        await OnActiveSlotChangedAsync();
    }

    private async Task OnActiveSlotChangedAsync()
    {
        var slot = ActiveSlot;
        if (!slot.SelectionInitialized)
            InitializeSelection(slot);

        await LoadAuditAsync(slot);
        QueuePreview();
    }

    private async Task LoadAuditAsync(SlotState slot)
    {
        try
        {
            slot.Audit = [.. await Api.GetAuditAsync(slot.Kind, slot.Channel)];
            slot.AuditError = null;
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load the audit trail for {Kind}/{Channel}", slot.Kind, slot.Channel);
            slot.AuditError = ex.Message;
        }
    }

    /// <summary>
    /// Saves the active slot's draft. The email body is read from the editor at submit (the wrapper
    /// has no change callback) and sanitized with the ONE instruction sanitizer (§3.12); the SMS body
    /// is plain text and is NOT sanitized, because HTML-encoding a plain-text channel would corrupt
    /// it. An existing row updates by id; the add state creates.
    /// </summary>
    private async Task SaveAsync(SlotState slot)
    {
        if (_busy)
            return;

        slot.Message = null;
        slot.Error = null;

        var authoredBody = slot.Channel == NotificationChannel.Email
            ? await ReadEditorHtmlAsync() ?? slot.Body
            : slot.Body;

        if (string.IsNullOrWhiteSpace(authoredBody))
        {
            slot.Error = "A template body is required.";
            return;
        }

        var body = slot.Channel == NotificationChannel.Email
            ? RichInstructionSanitizer.Sanitize(authoredBody)
            : authoredBody;

        var constraints = slot.Constraints
            .Where(c => !string.IsNullOrWhiteSpace(c.Value))
            .Select(c => new TemplateConstraintRequest(c.Dimension, c.Value.Trim()))
            .ToList();

        var subject = slot.Channel == NotificationChannel.Email ? slot.Subject : null;
        var reason = string.IsNullOrWhiteSpace(slot.Reason) ? null : slot.Reason.Trim();

        _busy = true;
        try
        {
            TenantNotificationTemplateDto saved;
            if (slot.SelectedId is { } id)
            {
                saved = await Api.UpdateAsync(id, new UpdateNotificationTemplateRequest(
                    subject, body, constraints, reason));
            }
            else
            {
                saved = await Api.CreateAsync(new CreateNotificationTemplateRequest(
                    slot.Kind, slot.Channel, subject, body, constraints, reason));
            }

            slot.Reason = string.Empty;
            await ReloadAsync();

            var reloaded = slot.Rows.FirstOrDefault(r => r.Id == saved.Id);
            if (reloaded is not null)
            {
                LoadDraft(slot, reloaded);
                slot.Message = "Template saved.";
            }
            else
            {
                // The saved row is outside this grade filter — the selection cannot point at it.
                InitializeSelection(slot);
                slot.Message = "Template saved.";
            }

            await LoadAuditAsync(slot);
            QueuePreview();
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save the notification template for {Kind}/{Channel}", slot.Kind, slot.Channel);
            slot.Error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> ReadEditorHtmlAsync() =>
        _activeEditor is null ? null : await _activeEditor.GetHtmlAsync();

    /// <summary>
    /// Tombstones one row by id (spec §3.10's reset — revert to the built-in default, audited). The
    /// reason is required: the endpoint refuses an unaudited reset, so the UI asks first instead of
    /// letting the request fail.
    /// </summary>
    private async Task ResetAsync(SlotState slot, TenantNotificationTemplateDto row)
    {
        if (_busy)
            return;

        if (string.IsNullOrWhiteSpace(slot.Reason))
        {
            slot.Error = "A reason is required to reset a template — the reset is recorded in the audit trail.";
            return;
        }

        _busy = true;
        slot.Message = null;
        slot.Error = null;
        try
        {
            await Api.DeleteAsync(row.Id, slot.Reason.Trim());
            slot.Reason = string.Empty;
            await ReloadAsync();
            InitializeSelection(slot);
            slot.Message = "Template reset — the built-in default applies again.";
            await LoadAuditAsync(slot);
            QueuePreview();
        }
        catch (OperationCanceledException)
        {
            // Navigated away.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset notification template {TemplateId}", row.Id);
            slot.Error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Re-reads the tenant's rows and repairs selections whose row disappeared.</summary>
    private async Task ReloadAsync()
    {
        ApplyRows(await Api.ListAsync());

        foreach (var slot in _slots.Values)
        {
            if (!slot.SelectionInitialized)
                InitializeSelection(slot);
            else if (slot.SelectedId is { } id && slot.Rows.All(r => r.Id != id))
                InitializeSelection(slot);
        }
    }

    /// <summary>
    /// The §3.7 conflict warning: another row in the SAME kind × channel carries the identical
    /// constraint set, so publish-time selection could not tell them apart. A warning, never a
    /// block. Both negatives matter: a different set (or an identical set in another slot) is not a
    /// conflict.
    /// </summary>
    private static string? ConflictWarning(SlotState slot)
    {
        var draft = NormalizeConstraintSet(slot.Constraints
            .Where(c => !string.IsNullOrWhiteSpace(c.Value))
            .Select(c => (c.Dimension, c.Value)));

        foreach (var row in slot.Rows)
        {
            if (row.Id == slot.SelectedId)
                continue;

            var candidate = NormalizeConstraintSet(row.Constraints.Select(c => (c.Dimension, c.Value)));
            if (string.Equals(candidate, draft, StringComparison.Ordinal))
            {
                return "Another template in this slot has the identical constraint set — publish-time "
                    + "selection cannot tell them apart (spec §3.7).";
            }
        }

        return null;
    }

    /// <summary>Order-insensitive, trimmed, case-folded set — the matcher compares values case-insensitively.</summary>
    private static string NormalizeConstraintSet(IEnumerable<(TemplateConstraintDimension Dimension, string Value)> constraints) =>
        string.Join(
            "|",
            constraints
                .Select(c => $"{c.Dimension}={c.Value.Trim()}")
                .OrderBy(p => p, StringComparer.Ordinal)
                .Select(p => p.ToLowerInvariant()));

    private static string SlotRowTitle(TenantNotificationTemplateDto row)
    {
        if (!string.IsNullOrWhiteSpace(row.Subject))
            return row.Subject!;

        var plain = RichInstructionSanitizer.ToPlainText(row.Body);
        if (string.IsNullOrWhiteSpace(plain))
            return "(empty body)";

        return plain.Length <= 80 ? plain : plain[..80] + "…";
    }

    private string ConstraintSummary(TenantNotificationTemplateDto row)
    {
        if (row.Constraints.Count == 0)
            return "No constraints — tenant default";

        return string.Join(" · ", row.Constraints
            .OrderBy(c => c.Dimension)
            .Select(c => $"{DimensionLabel(c.Dimension)}: {DisplayFor(c.Dimension, c.Value)}"));
    }

    private string DisplayFor(TemplateConstraintDimension dimension, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "(not set)";

        var option = OptionsFor(dimension)
            .FirstOrDefault(o => string.Equals(o.Value, value.Trim(), StringComparison.OrdinalIgnoreCase));
        return option?.Text ?? value.Trim();
    }

    private OptionItem[] OptionsFor(TemplateConstraintDimension dimension) => dimension switch
    {
        TemplateConstraintDimension.GradeLevel => _gradeOptions,
        TemplateConstraintDimension.Stream => _streamOptions,
        TemplateConstraintDimension.ActivityGroup => _groupOptions,
        TemplateConstraintDimension.Subject => _topicOptions,
        TemplateConstraintDimension.AssignmentType => AssignmentTypeOptions,
        _ => [],
    };

    private static string DimensionLabel(TemplateConstraintDimension dimension) => dimension switch
    {
        TemplateConstraintDimension.GradeLevel => "Grade level",
        TemplateConstraintDimension.Stream => "Stream",
        TemplateConstraintDimension.ActivityGroup => "Activity group",
        TemplateConstraintDimension.Subject => "Subject",
        TemplateConstraintDimension.AssignmentType => "Assignment type",
        _ => dimension.ToString(),
    };

    private static string ChannelLabel(NotificationChannel channel) => channel switch
    {
        NotificationChannel.Email => "Email",
        NotificationChannel.SMS => "SMS",
        _ => channel.ToString(),
    };

    private static string LinkDescription(NotificationChannel channel) =>
        channel == NotificationChannel.Email ? "long email" : "short SMS";

    /// <summary>
    /// The SMS length guidance: warn near/over the 160-character limit without ever blocking the
    /// save (tags expand at render time). When the preview is degraded the hint falls back to the
    /// RAW authored length and says the rendered length is unavailable, rather than disappearing.
    /// </summary>
    private static string SmsLengthHint(SlotState slot)
    {
        var renderedAvailable = !slot.PreviewUnavailable && slot.PreviewBody is not null;
        var length = renderedAvailable ? slot.PreviewBody!.Length : slot.Body.Length;
        var basis = renderedAvailable ? "rendered length" : "authored length — rendered length unavailable";

        if (length > SmsLimit)
        {
            return $"{length} characters ({basis}). Over {SmsLimit} characters — the carrier may split "
                + "this message. A warning only; it still saves.";
        }

        if (length >= SmsWarnLength)
        {
            return $"{length} characters ({basis}). Approaching the {SmsLimit}-character SMS limit.";
        }

        return $"{length} characters ({basis}).";
    }

    private void InsertTag(SlotState slot, string tag)
    {
        var token = $"{{{{{tag}}}}}";
        if (slot.Channel == NotificationChannel.Email)
            slot.Subject = (slot.Subject ?? string.Empty) + token;
        else
            slot.Body += token;

        QueuePreview();
    }

    /// <summary>Debounced preview refresh for the active slot (the subject / SMS body change per keystroke).</summary>
    private void QueuePreview()
    {
        if (_disposed)
            return;

        _previewDebounce?.Cancel();
        _previewDebounce?.Dispose();
        var cts = new CancellationTokenSource();
        _previewDebounce = cts;
        _ = DebouncedPreviewAsync(ActiveSlot, cts.Token);
    }

    private async Task DebouncedPreviewAsync(SlotState slot, CancellationToken ct)
    {
        try
        {
            await Task.Delay(PreviewDebounce, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await RefreshPreviewAsync(slot, ct);
    }

    private Task OnRefreshPreviewAsync(SlotState slot) => RefreshPreviewAsync(slot);

    /// <summary>
    /// Runs the Assignments host's exact render path over the authored pair. A failure is the
    /// documented degradation: an inline "preview unavailable" note, and the save path is untouched.
    /// </summary>
    private async Task RefreshPreviewAsync(SlotState slot, CancellationToken ct = default)
    {
        NotificationTemplatePreviewDto? rendered = null;
        string? error = null;
        try
        {
            rendered = await Preview.PreviewAsync(slot.Kind, slot.Channel, slot.Subject, slot.Body, ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Template preview failed for {Kind}/{Channel}", slot.Kind, slot.Channel);
            error = ex.Message;
        }

        if (_disposed)
            return;

        await InvokeAsync(() =>
        {
            if (rendered is not null)
            {
                slot.PreviewSubject = rendered.Subject;
                slot.PreviewBody = rendered.Body;
                slot.PreviewUnavailable = false;
                slot.PreviewError = null;
            }
            else
            {
                slot.PreviewUnavailable = true;
                slot.PreviewError = error;
            }

            StateHasChanged();
        });
    }

    private SlotState Slot(NotificationTemplateKind kind, NotificationChannel channel)
    {
        var key = (kind, channel);
        if (!_slots.TryGetValue(key, out var slot))
        {
            slot = new SlotState(kind, channel);
            _slots[key] = slot;
        }

        return slot;
    }

    private static string KindTabId(NotificationTemplateKind kind) => $"nt-kind-{kind}";

    private static string ChannelTabId(NotificationChannel channel) => $"nt-channel-{channel}";

    public void Dispose()
    {
        _disposed = true;
        _previewDebounce?.Cancel();
        _previewDebounce?.Dispose();
    }

    /// <summary>One picker option: the stored VALUE (the matcher's encoding) plus its display text.</summary>
    private sealed record OptionItem(string Value, string Text);

    /// <summary>One constraint being edited: the dimension plus its stored value.</summary>
    private sealed class ConstraintDraft
    {
        public TemplateConstraintDimension Dimension { get; set; }

        public string Value { get; set; } = string.Empty;
    }

    /// <summary>One kind × channel slot's master–detail state.</summary>
    private sealed class SlotState(NotificationTemplateKind kind, NotificationChannel channel)
    {
        public NotificationTemplateKind Kind { get; } = kind;

        public NotificationChannel Channel { get; } = channel;

        /// <summary>The slot's rows, grade-filtered when the page was opened from a grade card.</summary>
        public List<TenantNotificationTemplateDto> Rows { get; set; } = [];

        /// <summary>Whether the selection contract has been applied to this slot.</summary>
        public bool SelectionInitialized { get; set; }

        /// <summary>The row being edited; <see langword="null"/> = the add state.</summary>
        public Guid? SelectedId { get; set; }

        public string? Subject { get; set; }

        public string Body { get; set; } = string.Empty;

        public List<ConstraintDraft> Constraints { get; } = [];

        public string Reason { get; set; } = string.Empty;

        public List<NotificationTemplateAuditEntryDto> Audit { get; set; } = [];

        public string? AuditError { get; set; }

        public string? PreviewSubject { get; set; }

        public string? PreviewBody { get; set; }

        public bool PreviewUnavailable { get; set; }

        public string? PreviewError { get; set; }

        public string? Message { get; set; }

        public string? Error { get; set; }
    }
}
