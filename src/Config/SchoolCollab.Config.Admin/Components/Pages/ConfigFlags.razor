@page "/config-flags"
@inject ConfigFlagsApiClient Api
@inject NavigationManager Nav
@inject ILogger<ConfigFlags> Logger
@implements IDisposable

<PageTitle>Config Flags</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <SectionContent SectionName="page-toolbar">
            <div class="title-row">
                <h1 class="page-title">Feature Flags</h1>
            </div>
            <div class="action-bar">
                <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Nav.NavigateTo("/config-flags/new"))">+ New Flag</FluentButton>
                <FluentCheckbox @bind-Value="@_showArchived" @bind-Value:after="OnFilterChanged" Label="Show archived" />
                <div class="spacer"></div>
                <FluentTextField Placeholder="Search flags…"
                                 class="search-box"
                                 Immediate="true"
                                 ImmediateDelay="300"
                                 ValueChanged="@OnSearchValueChanged" />
            </div>
        </SectionContent>

        @if (_loading)
        {
            <FluentProgressRing />
        }
        else if (_items.Length > 0)
        {
            <FluentDataGrid Items="@_items.AsQueryable()">
                <PropertyColumn Property="@(f => f.Key)" />
                <PropertyColumn Property="@(f => f.Name)" />
                <TemplateColumn Title="Enabled">
                    <FluentBadge Appearance="@(context.IsEnabled ? Appearance.Accent : Appearance.Neutral)">
                        @(context.IsEnabled ? "On" : "Off")
                    </FluentBadge>
                </TemplateColumn>
                <PropertyColumn Title="Overrides" Property="@(f => f.OverrideCount)" />
                <PropertyColumn Title="Last changed" Property="@(f => f.UpdatedAt)" Format="yyyy-MM-dd HH:mm" />
                <TemplateColumn Title="Actions">
                    <FluentButton Appearance="Appearance.Neutral"
                                  OnClick="@(() => Nav.NavigateTo($"/config-flags/{Uri.EscapeDataString(context.Key)}"))">
                        Open
                    </FluentButton>
                </TemplateColumn>
            </FluentDataGrid>
        }
        else
        {
            <FluentMessageBar Intent="MessageIntent.Info">No feature flags. Create one to get started.</FluentMessageBar>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Failed to load flags: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private FeatureFlagDto[] _items = Array.Empty<FeatureFlagDto>();
    private bool _loading = true;
    private bool _showArchived;
    private string? _search;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        try
        {
            _loading = true;
            _items = await Api.ListAsync(_search, _showArchived, ct);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load feature flags");
            _items = Array.Empty<FeatureFlagDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnFilterChanged() => LoadAsync();

    private Task OnSearchValueChanged(string value)
    {
        _search = value;
        return LoadAsync();
    }

    public void Dispose() => _loadCts?.Cancel();
}