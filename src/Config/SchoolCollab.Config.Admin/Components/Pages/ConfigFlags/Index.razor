@page "/config-flags"
@inject ConfigFlagsApiClient Api
@inject NavigationManager Nav
@inject ILogger<Index> Logger
@implements IDisposable

<PageTitle>Config Flags</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <SectionContent SectionName="page-toolbar">
            <div class="title-row">
                <h1 class="page-title">Feature Flags</h1>
            </div>
            <div class="action-bar">
                <FluentButton Appearance="Appearance.Accent" OnClick='() => Nav.NavigateTo("/config-flags/new")'>
                    + New Flag
                </FluentButton>
                <FluentCheckbox @bind-Value="_showArchived"
                                @bind-Value:after="OnFilterChanged"
                                Label="Show archived" />
                <div class="spacer"></div>
                <FluentTextField Placeholder="Search flags…"
                                 class="search-box"
                                 Immediate="true"
                                 ImmediateDelay="300"
                                 @bind-Value="_search"
                                 @bind-Value:after="OnSearchChanged" />
            </div>
        </SectionContent>

        @* -- Loading state: fill the scroll region and center the spinner. -- *@
        @if (_items is null)
        {
            <div class="spinner-container">
                <FluentProgressRing />
            </div>
        }
        else if (_items.Length == 0 && !_showArchived && string.IsNullOrEmpty(_search))
        {
            <FluentMessageBar Intent="MessageIntent.Info">No feature flags. Create one to get started.</FluentMessageBar>
        }
        else if (_items.Length == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">No feature flags match the current filter.</FluentMessageBar>
        }
        else
        {
            @* -- Grid fills remaining vertical space -- *@
            <div class="grid-container">
                <FluentDataGrid Items="@_items.AsQueryable()"
                                GridTemplateColumns="minmax(240px,2fr) minmax(220px,2fr) 100px 100px minmax(160px,1fr)"
                                GenerateHeader="GenerateHeaderOption.Sticky"
                                MultiLine="true"
                                TGridItem="FeatureFlagDto">
                    <TemplateColumn Title="Key" Sortable="true" SortBy="@_sortByKey" TooltipText="@(f => f.Key)">
                        <FluentAnchor Appearance="Appearance.Hypertext"
                                     Href="@($"/config-flags/{Uri.EscapeDataString(context.Key)}")"
                                     title="@context.Key">
                            @HumanizeKey(context.Key)
                        </FluentAnchor>
                    </TemplateColumn>
                    <PropertyColumn Property="@(f => f.Name)" Title="Name" Sortable="true" />
                    <TemplateColumn Title="Enabled" Sortable="true" SortBy="@_sortByEnabled">
                        <FluentBadge Appearance="@(context.IsEnabled ? Appearance.Accent : Appearance.Neutral)">
                            @(context.IsEnabled ? "On" : "Off")
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="Overrides" Sortable="true" SortBy="@_sortByOverrides">
                        @context.OverrideCount
                    </TemplateColumn>
                    <TemplateColumn Title="Last changed" Sortable="true" SortBy="@_sortByUpdatedAt">
                        @(context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" class="mt-3">@_error</FluentMessageBar>
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <FluentMessageBar Intent="MessageIntent.Error">Something went wrong: @ex.Message</FluentMessageBar>
    </ErrorContent>
</ErrorBoundary>

@code {
    private FeatureFlagDto[]? _items;
    private bool _showArchived;
    private string? _search;
    private string? _error;
    private bool _initialLoadDone;
    private CancellationTokenSource? _loadCts;
    private volatile bool _disposed;

    private readonly GridSort<FeatureFlagDto> _sortByKey =
        GridSort<FeatureFlagDto>.ByAscending(f => f.Key);

    private readonly GridSort<FeatureFlagDto> _sortByEnabled =
        GridSort<FeatureFlagDto>.ByAscending(f => f.IsEnabled);

    private readonly GridSort<FeatureFlagDto> _sortByOverrides =
        GridSort<FeatureFlagDto>.ByAscending(f => f.OverrideCount);

    private readonly GridSort<FeatureFlagDto> _sortByUpdatedAt =
        GridSort<FeatureFlagDto>.ByAscending(f => f.UpdatedAt);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(includeArchived: _showArchived, search: null, isUserDriven: false);
        _initialLoadDone = true;
    }

    /// <summary>
    /// Loads the flag list. Each call gets its own <see cref="CancellationTokenSource"/>
    /// so a superseding call only cancels itself, not a still-pending earlier load.
    /// The spinner condition is <c>_items is null</c>; this method always assigns
    /// <c>_items</c> (to an empty array on cancellation, not just on error), so the
    /// spinner can never get stuck.
    /// </summary>
    private async Task LoadAsync(bool includeArchived, string? search, bool isUserDriven)
    {
        // Cancel any in-flight load. The just-canceled task will set _items
        // (to an empty array) on its way out; the new task then overwrites
        // _items. We do not leave _items = null between the two — see the
        // null-coalesce below for the cold-start case.
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        var cts = new CancellationTokenSource();
        _loadCts = cts;
        var ct = cts.Token;

        try
        {
            var result = await Api.ListAsync(search, includeArchived, ct);
            if (_disposed || ct.IsCancellationRequested) return;
            _items = result;
            _error = null;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer load, prerender disposal, or user navigation.
            // Don't surface "A task was canceled." in the UI. Only release the
            // spinner if THIS was the very first load and nothing is coming after us.
            if (!isUserDriven && !_initialLoadDone && _items is null)
            {
                _items = Array.Empty<FeatureFlagDto>();
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogError(ex, "Failed to load feature flags");
            _items = Array.Empty<FeatureFlagDto>();
            _error = ex.Message;
        }
    }

    private Task OnFilterChanged()
    {
        if (!_initialLoadDone) return Task.CompletedTask;
        return LoadAsync(_showArchived, _search, isUserDriven: true);
    }

    private Task OnSearchChanged()
    {
        if (!_initialLoadDone) return Task.CompletedTask;
        return LoadAsync(_showArchived, _search, isUserDriven: true);
    }

    private static string HumanizeKey(string key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return key;

        var parts = key.Split(':', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return key;

        return string.Join(": ", parts.Select(p =>
        {
            var humanized = p.Humanize();
            // All-caps words (e.g. the FEATURE prefix or acronyms) are not split
            // by Humanizer. Lowercase first so Titleize produces a friendly
            // "Feature" / "Xml" style result instead of leaving them shouting.
            if (humanized == humanized.ToUpperInvariant())
                return humanized.ToLowerInvariant().Titleize();
            return humanized.Titleize();
        }));
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
