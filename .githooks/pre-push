#!/usr/bin/env bash
set -euo pipefail

remote="$1"
url="$2"

blocked=false

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/main" ]]; then
        cat >&2 <<'EOF'
error: direct pushes to 'main' are blocked.

SchoolCollab requires changes to land on main through a pull request:
  1. create a feature/fix branch
  2. push the branch and open a PR targeting main
  3. wait for Build & Test CI to pass
  4. squash-merge the PR

To bypass this local hook for an emergency, run:
  git push --no-verify origin main

EOF
        blocked=true
    fi
done

if [[ "$blocked" == true ]]; then
    exit 1
fi

exit 0
