#!/usr/bin/env bash
set -euo pipefail

remote="$1"
url="$2"

if [[ "${SCHOOLCOLLAB_ALLOW_PUSH:-}" != "1" ]]; then
    cat >&2 <<'EOF'
error: local pushes are held until the user explicitly allows them.

SchoolCollab requires an explicit user instruction before pushing local commits.
To allow this push, rerun it with:

  SCHOOLCOLLAB_ALLOW_PUSH=1 git push <remote> <branch>

Windows PowerShell example:

  $env:SCHOOLCOLLAB_ALLOW_PUSH='1'; git push <remote> <branch>; Remove-Item Env:SCHOOLCOLLAB_ALLOW_PUSH

After pushing, create/open a PR targeting main, wait for Build & Test CI to pass,
then squash-merge the PR.
EOF
    exit 1
fi

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/main" ]]; then
        cat >&2 <<'EOF'
error: direct pushes to 'main' are still blocked.

SchoolCollab requires changes to land on main through a pull request:
  1. create a feature/fix branch
  2. push the branch and open a PR targeting main
  3. wait for Build & Test CI to pass
  4. squash-merge the PR
EOF
        exit 1
    fi
done

exit 0
